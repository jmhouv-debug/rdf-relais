{
  "name": "rdf-relais",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",
  "assets": { "directory": "./public" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
