  /* zone de preparation : racks + bacs a commandes */
  [57,62,67].forEach(function(x){box(g,4.2,2.4,1,0x7c8794,x,1.2,-14.5,true);[.5,1.2,1.9].forEach(function(y){box(g,4,.06,.9,0xaeb7c2,x,y,-14.5,false);for(let k=0;k<4;k++)box(g,.7,.4,.6,[0x6a4c93,0xf4a261,0x2a9d8f,0xe9c46a][(k+y*3)%4|0],x-1.4+k*.9,y+.22,-14.5,false);});obs(D,x,-14.5,4.4,1.2);});
  ORD.bins=[];for(let j=0;j<14;j++){const b=box(g,.55,.35,.5,[0xe63946,0x2f80ed,0x2a9d8f,0xf4a261][j%4],54.6+(j%7)*.75,.2+Math.floor(j/7)*.4,-9.2,false);ORD.bins.push(b);}
  box(g,6,.9,1.4,0xd6dbe2,58,.45,-9.2,true);box(g,5.8,.06,1.2,0xc9a26b,58,.93,-9.2,false);obs(D,58,-9.2,6.2,1.6);
