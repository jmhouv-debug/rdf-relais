    P:QM.REP.map(function(p){return [p.id,r1(p.x),r1(p.z),p.zn,p.g,Math.round(p.prog*100)];}),O:QM.HS.map(function(h){return h.occ?1:0;}).join('')});}
/* ---------- en partie : client ---------- */
function qnClientRecv(ev,d){QN.lastSnap=Date.now();const me=QM.me;
  if(ev==='s'){QM.t=d.t;QM.j=d.j;QM.decoy=d.dc?1:0;QM.meetUsed=!!d.mu;QM.firstTeam=!!d.ft;
    d.H.forEach(function(v,i){const h=QM.H[i];if(!h)return;h.tx=v[0];h.tz=v[1];h.th=v[2];if(h.zn!==v[3]){h.zn=v[3];h.x=v[0];h.z=v[1];}h.st=v[4]===1?'chase':v[4]===2?'alert':'patrol';h.spot=v[5]?1:0;h.stun=v[6]?1:0;h.blind=v[7]?1:0;});
    d.A.forEach(function(v,i){const a=QM.A[i];if(!a)return;if(v.length>6){a.hp=v[6];a.down=v[7];a.zomb=v[8];a.rev=v[9]/100;a.cure=v[10]/100;a.item=v[12]||'';a.pts=v[13]||0;if(v[14])a.sc={sab:v[14][0],rev:v[14][1],mgr:v[14][2]};if(a!==me)a.cv=v[15]?{k:v[15]}:null;a.wl=v[16]||1;a.toysN=v[17]||0;a.ult=v[18]||0;a.cons=String(v[19]||',').split(',').slice(0,2).map(function(t){if(!t)return null;const q=t.split(':');return {k:q[0],n:+q[1]||1};});while(a.cons.length<2)a.cons.push(null);}
      if(a===me){if(me.caught>0&&!v[11]&&v[8]>0)qmRelease(me);return;}a.tx=v[0];a.tz=v[1];a.th=v[2];if(a.zn!==v[3]){a.zn=v[3];a.x=v[0];a.z=v[1];}a.caught=v[4]&1?1:0;a.hide=v[4]&2?{}:null;a.out=!!(v[4]&4);a.inv=v[4]&8?1:0;a.mv=v[5];});
    if(d.A[me.id]&&(d.A[me.id][4]&4)&&!me.out){me.out=true;}
    d.R.forEach(function(v,i){const r=QM.R[i];if(!r)return;r.cd=v[0];const lk=v[1];if((lk>0)!==(r.lk>0))r.m.lb.draw(lk>0?'⚠️ '+r.n+' : en panne':qmRingTxt(r),hex6(lk>0?QRC.rep:QRC[r.k])+'f2');r.lk=lk;r.prog=v[2]/100;if(r.k==='team'&&r.cnt!==v[3]){r.cnt=v[3];if(!(r.lk>0))r.m.lb.draw(qmRingTxt(r),hex6(QRC.team)+'f2');}r.done=!!v[4];r.both=!!v[5];});
    const k=d.k;if(k.st==='held'){const by=QM.A[k.by];if(QM.key.st!=='held'||QM.key.by!==by)QM.key={st:'held',by:by,room:k.room};}else if(k.st==='ground'){if(QM.key.st!=='ground'||QM.key.room!==k.room)QM.keyM.lb.draw('🔑 Clé : '+(QM.RM[k.room]?QM.RM[k.room].n:''),'#ffd21ff2');QM.key={st:'ground',zn:k.zn,x:k.x,z:k.z,room:k.room};}else QM.key={st:k.st};
    if(d.C){const seen={};d.C.forEach(function(v){if(v.length>4){seen[v[4]]=1;if(!QM.CE.some(function(n){return n.cid===v[4];}))qmCliMake(v[4],v[5],v[0],v[1],v[6],60);}});for(let i=QM.CE.length-1;i>=0;i--){const n=QM.CE[i];if(n.tmp!==undefined&&!seen[n.cid])qmCliDel(n);}}
    if(d.QS){const ids={};d.QS.forEach(function(v){ids[v[0]]=1;if(QM.QS.some(function(q){return q.id===v[0];}))return;const q={id:v[0],t:v[1],ids:v[2]?v[2].split('|'):[],room:v[3],nm:v[4],zn:v[5],own:v[6],n:v[7],d:{},done:false};QM.QS.push(q);
        q.ids.forEach(function(id,j){const r=QM.R.find(function(x){return x.id===id;});const sp=v[8][j];if(r&&sp)qmRingQ(r,sp[0],{need:sp[1],pair:sp[2],dur:sp[3],qn:q.n,own:q.own});});});
      QM.QS.slice().forEach(function(q){if(!ids[q.id])qmQuestEnd(q);});}
    QM.insp=d.IN||0;if(!QM.CV)qmCvInit();
    (d.CV||[]).forEach(function(v){QM.CV[v[0]]={seed:v[1],t0:v[2]};if(QM.CVg[v[0]]!==v[1])qmCvGen(v[0],v[1]);});
    if(d.CN&&Z.cv_arch.cv&&Z.cv_arch.cv.npc)d.CN.forEach(function(v,i){const n=Z.cv_arch.cv.npc[i];if(!n)return;n.tx=v[0];n.tz=v[1];n.st=v[2]?'chase':'wander';n.stun=v[3]?1:0;});
    if(d.FR&&QM.freeR){QM.freeR.prog=d.FR[0]/100;QM.freeR.n=d.FR[1];}
    (d.C||[]).forEach(function(v,i){const n=v.length>4?QM.CE.find(function(x){return x.cid===v[4];}):QM.CE[i];if(!n)return;if(v[7]){n.gone=1;n.g.visible=false;n.bub.visible=false;return;}else if(n.gone){n.gone=0;n.g.visible=true;n.g.rotation.z=0;n.x=v[0];n.z=v[1];n._sy=0;}const dx=v[0]-n.x,dz=v[1]-n.z,dd=Math.hypot(dx,dz);if(dd>4||!n._sy){n.x=v[0];n.z=v[1];n._sy=1;}else{n.x+=dx*.5;n.z+=dz*.5;}if(dd>.02)n.g.rotation.y=Math.atan2(dx,dz);n.ph=(n.ph||0)+(dd>.02?.5:0);walkAnim(n.g,n.ph,dd>.02?1.1:0);n.g.position.set(n.x,0,n.z);if(v[2]>0&&!(n.ko>0))n.ko=v[2];n.chase=v[3];});
    (d.F||[]).forEach(function(v,i){const f=QM.FY[i];if(!f)return;f.tx=v[0];f.tz=v[1];f.th=v[2];if(v[3]>0&&!(f.ko>0))f.ko=v[3];});
    if(typeof d.LZ==='string'){const lz=d.LZ?d.LZ.split(','):[];Object.keys(QM.lockZ).forEach(function(z){if(lz.indexOf(z)<0)delete QM.lockZ[z];});}
    if(d.S){if(d.S[0]!==QM.stg.i)QM.stg={i:d.S[0],n:d.S[1]};else QM.stg.n=d.S[1];}
    if(typeof d.M==='string')d.M.split('').forEach(function(c,i){const r=QM.R[i];if(!r)return;const du=c==='2'?1:0,db=c==='3'?1:0;r.act=c!=='0'?1:0;if(r.duo!==du||(r.dbl|0)!==db){r.duo=du;r.dbl=db;r.m.lb.draw(qmRingTxt(r),hex6(QRC[r.k])+'f2');}});
    if(!Z.ar_pat)qmArenaInit();if(!QM.WP){QM.WP=[];QM.BX=[];QM.BZ=[];}
    if(d.B){const v=d.B;if(QM.boss&&QM.boss.i!==v[0])qmBossKill();if(!QM.boss){const m=qmBossMesh(v[0]);QM.boss={i:v[0],d:QBOSS[v[0]],g:m.g,bar:m.bar,shM:qmBossShM(m.g),zn:v[9],x:v[1],z:v[2],h:0,hp:v[4],max:v[5],ph:0,hitF:0,dead:0,mins:[],stun:0,intro:0,sh:0,shMax:100,tired:0,air:0};}
      const B=QM.boss;B.tx=v[1];B.tz=v[2];B.th=v[3];if(v[4]<B.hp)B.hitF=.18;B.hp=v[4];B.max=v[5];if(v[6]&&!B.dead)B.dead=3;B.stun=v[7]?1:0;B.intro=v[8]?1:0;B.zn=v[9];B.shMax=100;B.sh=v[12]||0;B.tired=v[13]?1:0;B.air=v[14]?1:0;
      (v[11]||[]).forEach(function(mv,i){let m=B.mins[i];if(!m){const g=makeChar({shirt:0x1f3a5f,pants:0x1b1b1b,hair:0x2b1d14,hs:'court'});scene.add(g);m={g:g,x:mv[0],z:mv[1],zn:B.zn,ph:0,ko:0};B.mins.push(m);}m.tx=mv[0];m.tz=mv[1];m.th=mv[2];m.ko=mv[3]===2?99:mv[3]?1:0;});}
    else if(QM.boss&&!QM.boss.dead)qmBossKill();else if(QM.boss&&QM.boss.dead&&!d.B)qmBossKill();
    if(d.BZ){const ids={};d.BZ.forEach(function(v){ids[v[0]]=1;let z=QM.BZ.find(function(x){return x.id===v[0];});if(!z){z={id:v[0],k:v[1],x:v[2],z:v[3],r:v[4],h:v[5],len:v[6],w:v[7],a:v[8],t:v[9],t0:v[10]||1,life:99};QM.BZ.push(z);}else if(z.k!=='ice')z.t=v[9];});
      for(let i=QM.BZ.length-1;i>=0;i--)if(!ids[QM.BZ[i].id]){if(QM.BZ[i].m)scene.remove(QM.BZ[i].m);QM.BZ.splice(i,1);}}
    if(d.WP){const ids={};d.WP.forEach(function(v){ids[v[0]]=1;if(!QM.WP.some(function(w){return w.id===v[0];}))qmWpAdd(v[1],v[2],v[3],v[4],v[0]);});QM.WP.slice().forEach(function(w){if(!ids[w.id])qmWpDel(w);});}
    if(d.BX){const ids={};d.BX.forEach(function(v){ids[v[0]]=1;if(!QM.BX.some(function(b){return b.id===v[0];}))qmBxAdd(v[1],v[2],v[3],v[0],v[4]);});QM.BX.slice().forEach(function(b){if(!ids[b.id])qmBxDel(b);});}
    if(d.TR){QM.TR=QM.TR||[];d.TR.forEach(function(v){let t=QM.TR.find(function(x){return x.id===v[0];});if(!t)t=qmTrapAdd(v[1],v[2],v[3],v[4],v[0]);t.cd=v[5]?(t.cd>0?t.cd:45):0;});}
    if(d.DG){if(!QM.dog)QM.dog={g:qmDogMesh(),zn:'store',x:d.DG[0],z:d.DG[1],h:0};QM.dog.tx=d.DG[0];QM.dog.tz=d.DG[1];const zz=QZ.find(function(z){const b=Z[z].bounds;return d.DG[0]>=b.x[0]&&d.DG[0]<=b.x[1]&&d.DG[1]>=b.z[0]&&d.DG[1]<=b.z[1];});if(zz)QM.dog.zn=zz;}else if(QM.dog){scene.remove(QM.dog.g);QM.dog=null;}
    QM.bossN=d.BN||0;QM.dmgT=d.DT||0;
    QM.arena=d.AR?{zid:d.AR[0],kind:d.AR[1],ph:d.AR[2]?'loot':'fight',t:d.AR[3],wave:d.AR[4],nw:d.AR[5],wk:d.AR[6],wsz:d.AR[7]}:null;
    if(d.HZ){QM.HZ=QM.HZ||[];const ids={};d.HZ.forEach(function(v){ids[v[0]]=1;let e=QM.HZ.find(function(x){return x.id===v[0];});if(!e){QM.HZ=QM.HZ||[];e=qmHzAdd(v[3],v[1],v[2],QM.arena?QM.arena.zid:'ar_hor',v[0]);}e.tx=v[1];e.tz=v[2];if(v[4]&&!(e.ko>0))e.ko=1;});QM.HZ.slice().forEach(function(e){if(!ids[e.id])qmHzDel(e);});}
    if(typeof d.L==='string'){const lk=d.L?d.L.split(','):[];Object.keys(QM.lockR).forEach(function(id){if(lk.indexOf(id)<0)qmOpenRoom(id,true);});}
    {const si={};(d.I||[]).forEach(function(v){si[v[0]]=1;if(!QM.IT.some(function(x){return x.id===v[0];}))qmItemAdd(v[0],v[1],v[2],v[3],v[4]);});for(let i=QM.IT.length-1;i>=0;i--){if(!si[QM.IT[i].id])qmItemDel(QM.IT[i]);}}
    QM.pup.prog=d.pu/100;QM.pup.touch=QM.clk;
    const seen={};d.P.forEach(function(v){seen[v[0]]=1;let p=QM.REP.find(function(x){return x.id===v[0];});if(!p){p={id:v[0],x:v[1],z:v[2],zn:v[3],g:v[4],prog:0,t:99,touch:0};p.m=qmRingMesh(QRC.rep,'🔧 Réparer (−'+p.g+' %)',360);p.m.g.position.set(p.x,0,p.z);p.m.g.visible=false;QM.REP.push(p);}p.prog=v[5]/100;});
    for(let i=QM.REP.length-1;i>=0;i--){if(!seen[QM.REP[i].id]){scene.remove(QM.REP[i].m.g);QM.REP.splice(i,1);}}
    {const sn={};(d.T||[]).forEach(function(v){sn[v[0]]=1;let p=QM.PT.find(function(x){return x.id===v[0];});if(!p){p={id:v[0],a:{zn:v[1],x:v[2],z:v[3]},b:{zn:v[4],x:v[5],z:v[6]}};qmPortalMesh(p);QM.PT.push(p);}p.t=v[7];p.bub=v[8];});
      for(let i=QM.PT.length-1;i>=0;i--){if(!sn[QM.PT[i].id]){qmPortalKill(QM.PT[i]);QM.PT.splice(i,1);}}
      QM.dark=d.dk?{zn:d.dk[0],t:d.dk[1]}:null;}
    (d.O||'').split('').forEach(function(c,i){const h=QM.HS[i];if(!h)return;if(c==='1'){if(!h.occ)h.occ=me.hide===h?me:{};}else if(h.occ&&h.occ!==me)h.occ=null;});}
  else if(ev==='msg'){qmMsg(d.t,d.k);}
  else if(ev==='big'){qmBig(d.t,d.c);}
  else if(ev==='caught'&&d.id===me.id){me.caught=QCFG.jail;me.grab=null;me.down=0;qmUnhide(me);me.x=d.x;me.z=d.z;qmPlayerTo('office',d.x,d.z);qmMsg('🚔 Bureau de la directrice : 20 s, et tu en ressors… zombie 🧟','bad');}
  else if(ev==='hit'&&d.id===me.id){qmUnhide(me);const nx=pp.x+(+d.kx||0),nz=pp.z+(+d.kz||0);if(!hit(nx,nz,.38,Z[cur])){pp.x=nx;pp.z=nz;}me.imm=2.5;if(me.hp-(d.q|0)>0)qmMsg('💔 Tu perds un cœur !','bad');}
  else if(ev==='grab'&&d.id===me.id){qmUnhide(me);me.grab={h:{name:d.n},t:QCFG.grab};qmMsg('😱 '+d.n+' t\'agrippe : cours pour te dégager !','bad');}
  else if(ev==='ungrab'&&d.id===me.id){if(me.grab&&!me.caught)qmMsg('💨 Tu t\'es dégagé !','good');me.grab=null;}
  else if(ev==='seen'&&d.id===me.id){me.seenBy={name:d.n};qmMsg('😬 '+d.n+' t\'a vu te cacher !','bad');}
  else if(ev==='jam'&&(d.ids||[]).indexOf(me.id)>=0){me.jam=5;if(QM.map){QM.map=false;$('qmMapT').hidden=true;$('qmMapAll').hidden=true;}}
  else if(ev==='inv'&&d.id===me.id){me.inv=d.t||5;}
  else if(ev==='slow'&&d.id===me.id){me.slowT=d.t||2;}
  else if(ev==='buff'&&d.id===me.id){if(d.k==='cafe')QM.cafe=30;else if(d.k==='choco')me.boost=20;else{me.boost=5;QM.st=100;QM.stx=false;}}
  else if(ev==='fx'){qnFxShow(d);}
  else if(ev==='cv'&&d.id===me.id){if(!QM.CV)qmCvInit();QM.CV[d.k]={seed:d.s,t0:QM.t};if(QM.CVg[d.k]!==d.s)qmCvGen(d.k,d.s);me.cv={k:d.k,t:0};me.cvD=null;me.caught=0;me.down=0;me.grab=null;qmUnhide(me);me.x=d.x;me.z=d.z;qmCvEnterMe(d.k);}
  else if(ev==='cvout'&&d.id===me.id){if(me.cv){me.cv=null;me.cvD=null;me.x=d.x;me.z=d.z;if(d.w==='free')qmMsg('🔓 Tes collègues t\'ont libéré !','good');else if(d.w==='time')qmMsg('⏱️ La direction te relâche.','');qmCvLeaveMe(me);}}
  else if(ev==='cvback'&&d.id===me.id){const X=Z.cv_arch.cv;if(X&&cur==='cv_arch'){pp.x=X.start[0];pp.z=X.start[1];qmBig('👻 BOUH ! Retour au début…','zomb');QM.shake=.4;}}
  else if(ev==='help'){QM.help={rid:d.rid,by:d.by,until:QM.clk+20};}
  else if(ev==='fx2'){if(d.k==='sab'){qmBurst(d.zn,d.x,d.z,24);qmDebris(d.zn,d.x,d.z,10,2.5);}}
  else if(ev==='wcine'){if(!Z.ar_pat)qmArenaInit();qmWaveCine(d.k);}
  else if(ev==='bcine'){if(!Z.ar_pat)qmArenaInit();qmBossCine(d.i);}
  else if(ev==='arena'&&d.id===me.id){if(!Z.ar_pat)qmArenaInit();me.zn=d.zn;me.x=d.x;me.z=d.z;me.grab=null;qmPlayerTo(d.zn,d.x,d.z);pp.face=Math.PI;}
  else if(ev==='arenaOut'&&d.id===me.id){me.x=d.x;me.z=d.z;qmArenaLeaveMe(d.zn,d.x,d.z,d.w);}
  else if(ev==='bfx'&&d.id===me.id){qmBFxMe(d.k,d.d);}
  else if(ev==='meet'){const by=QM.A[d.by];if(by&&!QM.meet)qmMeeting(by,true);}
  else if(ev==='mv'&&QM.meet){QM.meet.v=d.v||{};QM.meet.t=d.t;qmVoteUI();}
  else if(ev==='vres'){qmVoteResolve(d,true);}
  else if(ev==='end'){if(d.why==='close')qmClose(true);else qmFinish(d.why,d.tid>=0?QM.A[d.tid]:null,false,true);}}
function qnClientTick(dt){const me=QM.me;
  if(Date.now()-QN.lastSnap>8000&&!QM.end){QM.end='host';QM.paused=true;qmOv('<h2 class="qmimp">Connexion perdue</h2><p class="qmd">L\'hôte de la partie a quitté ou la connexion au serveur est coupée.</p><button class="abtn full" id="qmMenu3">Retour aux salles</button>');$('qmMenu3').onclick=qmToRooms;return;}
  const mv=function(o,dt2,hunter){if(o.tx===undefined)return false;const dx=o.tx-o.x,dz=o.tz-o.z,d=Math.hypot(dx,dz);if(d>6){o.x=o.tx;o.z=o.tz;}else if(d>.001){const st=Math.min(d,dt2*(hunter?7:8));o.x+=dx/d*st;o.z+=dz/d*st;}o.hd=o.th;o.ph=(o.ph||0)+(d>.04?dt2*7:0);return d>.04;};
  QM.H.forEach(function(h){const m=mv(h,dt,1);h.ex.visible=h.spot>0&&h.zn===cur;h.ex.position.set(h.x,3.55,h.z);qmPose(h,dt,m,h.st==='chase');});
  QM.A.forEach(function(a){if(a===me)return;const m=mv(a,dt);a.g.userData.cuff=a.caught>0;qmPose(a,dt,m||a.mv);});
  QN.tx-=dt;if(QN.tx<=0){QN.tx=.2;
    const at=me.at===QM.pup?'pup':me.at&&QM.REP.indexOf(me.at)>=0?'#'+me.at.id:me.at?me.at.id:'';
    qnS('p',{pid:QN.pid,x:Math.round(pp.x*100)/100,z:Math.round(pp.z*100)/100,h:Math.round(pp.face*100)/100,zn:cur,mv:moving?1:0,at:at,hd:me.hide?QM.HS.indexOf(me.hide):-1});}}
function qnFxShow(d){const a=QM.A[d.id];if(!a)return;if(d.at&&a===QM.me)return;try{qmPowFx(a,d.k,d);}catch(e){console.error(e);}}
function qmToRooms(){try{sessionStorage.setItem('edm_auto',JSON.stringify({ch:QM.ch||QN.ch||0,qm:1,salle:QN.salle||0}));}catch(_){}location.reload();}

function frame(now){if(QM.on){const dt=Math.min(.05,(now-last)/1000);last=now;try{qmUpdate(dt);}catch(e){console.error(e);}renderer.render(scene,camera);requestAnimationFrame(frame);return;}if(BR){BR.t-=Math.min(.05,(now-last)/1000);if(BR.t<=0)resolveBribe(0);}const dt=Math.min(.05,(now-last)/1000);last=now;if(CREATING){if(DKC&&!DKC.hidden)DKC.hidden=true;pvFrame(dt);}else{autoT+=dt;if(autoT>15){autoT=0;saveGame();}try{nightTick(dt);}catch(_){}update(dt);renderer.render(scene,camera);try{dkPosts();darkDraw();}catch(_){}}requestAnimationFrame(frame);}
/* ---------- U5 : CSE des joueurs (election chaque nuit), missions syndicales, managers de garde la nuit, objets de nuit, fin de saison ---------- */
MK.cstract=['rest','Poser des tracts CSE',1.5];MK.csplainte=['rest','CSE : parler au collègue',1.5];MK.csfin=['boss','CSE : panneau syndical',1.5];
function BLMX(){return isCseMe()?5:3;}
const CSEV={day:'',vote:'',my:0,seen:{},el:[],eDay:'',lost:'',ld:0};
function cseDay(){const g=pariz();if(!g)return new Date().toISOString().slice(0,10);return g.year+'-'+('0'+g.month).slice(-2)+'-'+('0'+g.day).slice(-2);}
function cseLoad(){CSEV.ld=1;try{const v=JSON.parse(localStorage.getItem(CK('edm_cse2'))||'null');if(v){['day','vote','my','seen','el','eDay','lost'].forEach(function(k){if(v[k]!==undefined)CSEV[k]=v[k];});}}catch(_){}}
function cseSave(){try{localStorage.setItem(CK('edm_cse2'),JSON.stringify({day:CSEV.day,vote:CSEV.vote,my:CSEV.my,seen:CSEV.seen,el:CSEV.el,eDay:CSEV.eDay,lost:CSEV.lost}));}catch(_){}}
function cseTask(){if(rank!==0||SEC)return;CSEV.my=(CSEV.my||0)+1;}
function cseElect(){const S=CSEV.seen||{},L=Object.keys(S),cnt={};L.forEach(function(n){cnt[n]=0;});let nv=0;L.forEach(function(n){const v=S[n].v;if(v&&v!==n&&cnt[v]!==undefined){cnt[v]++;nv++;}});
  const ord=L.slice().sort(function(a,b){return (cnt[b]-cnt[a])||((S[b].cw||0)-(S[a].cw||0))||(proHash(a+CSEV.day)-proHash(b+CSEV.day));});return {el:ord.slice(0,2),nv:nv};}
function cseApply(){const d=cseDay();CSE.m=(CSEV.eDay===d?CSEV.el:[]).filter(function(n){return !(n===PNAME&&CSEV.lost===d);}).map(function(n){return n===PNAME?'@me':n;});if(!isCseMe()&&blames>=3&&!FIREW)blames=2;try{cseVests();}catch(_){}}
function cseDaily(){if(CREATING||!PNAME||PNAME==='Toi')return;if(!CSEV.ld)cseLoad();const d=cseDay();
  if(CSEV.day!==d){const prev=CSEV.day;let yest='';try{yest=new Date(Date.parse(d+'T12:00:00Z')-864e5).toISOString().slice(0,10);}catch(_){}
    if(prev&&prev===yest&&Object.keys(CSEV.seen||{}).length){const r=cseElect();CSEV.el=r.el;CSEV.eDay=d;CSEV.lost='';const nm=r.el.map(function(n){return n===PNAME?'toi':n;});
      if(nm.length)pop('📮 CSE du jour : '+nm.join(' et ')+(r.nv?'':' (désignés faute de votes)'),'good');if(r.el.indexOf(PNAME)>=0)setTimeout(function(){toast('Tu es élu au CSE pour la journée : 5 cartons au lieu de 3, bouton ✊ Grève et missions syndicales.',1);},2500);}
    CSEV.day=d;CSEV.vote='';CSEV.my=0;CSEV.seen={};}
  CSEV.seen[PNAME]={cw:CSEV.my||0,v:CSEV.vote||''};
  if(NET.on&&NET.joined)Object.keys(NET.players).forEach(function(pid){if(pid===NET.pid)return;const p=NET.players[pid];if(!p||!p.nm||p.dk!==d||p.nm===PNAME)return;const o=CSEV.seen[p.nm]||{cw:0,v:''};CSEV.seen[p.nm]={cw:Math.max(o.cw||0,p.cw||0),v:p.cv||o.v||''};});
  cseApply();cseSave();}
function openVote(){if(!CSEV.ld)cseLoad();const d=cseDay(),el=(CSEV.eDay===d?CSEV.el:[]).map(function(n){return n===PNAME?'toi':n;}).join(', ')||'personne';
  if(CSEV.vote){toast('📮 Tu as déjà voté aujourd\'hui pour '+CSEV.vote+'. Résultat à minuit.');return;}
  const L=Object.keys(CSEV.seen||{}).filter(function(n){return n!==PNAME;});
  if(!L.length){toast('📮 Aucun autre joueur vu aujourd\'hui : reviens quand des collègues sont en ligne. CSE du jour : '+el+'.');return;}
  dlg('📮 Vote du CSE de demain','Élus aujourd\'hui : '+el+'. Vote pour un collègue (pas pour toi). Résultat à minuit ; sans vote, les plus actifs sont désignés.',L.slice(0,8).map(function(n){return {t:n,f:function(){CSEV.vote=n;cseSave();toast('Bulletin glissé dans l\'urne pour '+n+'.');}};}).concat([{t:'Annuler'}]));}
/* missions syndicales (reservees aux elus) */
const CSQ={k:'',mk:[],cd:40,i:0,fin:0};
const CSQD={tracts:{n:'Distribuer des tracts',pts:15},dol:{n:'Cahier de doléances',pts:20},greve:{n:'Préparer une grève',pts:25}};
function csqPos(obj){const ks=Object.keys(Z);for(let i=0;i<ks.length;i++){const m=Z[ks[i]].markers.find(function(x){return x.obj===obj;});if(m)return {zn:ks[i],x:m.x,z:m.z};}return null;}
function csqClear(){CSQ.mk.forEach(function(m){try{m.zone.g.remove(m.g);const q=m.zone.markers.indexOf(m);if(q>=0)m.zone.markers.splice(q,1);}catch(_){}});CSQ.mk=[];}
function csqAdd(p,obj,txt){if(!p||!Z[p.zn])return;const zn=Z[p.zn],O=[[1.5,0],[-1.5,0],[0,1.5],[0,-1.5],[1.5,1.5],[-1.5,-1.5]];let x=p.x,z=p.z;for(let i=0;i<O.length;i++){const a=p.x+O[i][0],b=p.z+O[i][1];if(a>zn.bounds.x[0]+.6&&a<zn.bounds.x[1]-.6&&b>zn.bounds.z[0]+.6&&b<zn.bounds.z[1]-.6&&!hit(a,b,.45,zn)){x=a;z=b;break;}}
  const m=marker(zn,obj,x,z,txt);CSQ.mk.push(m);return m;}
function csqStart(k){csqClear();CSQ.k=k;CSQ.fin=0;
  if(k==='tracts'){[['cafep','Tracts : salle de pause'],['palvide','Tracts : réserve'],['aidecaisse','Tracts : caisses']].forEach(function(q){csqAdd(csqPos(q[0]),'cstract',q[1]);});}
  else{const E=EMP.filter(function(e){return !(e.out>0)&&['store','reserve','office'].indexOf(e.zn)>=0;});for(let i=0;i<3&&E.length;i++){const e=E.splice((Math.random()*E.length)|0,1)[0];csqAdd({zn:e.zn,x:e.x,z:e.z},'csplainte',(k==='dol'?'Plainte de ':'Convaincre ')+e.name);}}
  if(!CSQ.mk.length){CSQ.k='';CSQ.cd=60;return;}
  pop('✊ Mission syndicale : '+CSQD[k].n,'good');toast(k==='tracts'?'Pose des tracts à 3 endroits (salle de pause, réserve, caisses).':k==='dol'?'Recueille 3 plaintes de collègues, puis affiche le cahier au panneau syndical.':'Convaincs 3 collègues, puis lance la grève générale au panneau syndical.',1);}
function csqTxt(){const left=CSQ.mk.length,D=CSQD[CSQ.k];if(!D)return '';if(CSQ.fin)return D.n+' : va au panneau syndical';return D.n+' : '+(3-left)+'/3';}
function csqDone(){const k=CSQ.k,D=CSQD[k];csqClear();CSQ.k='';CSQ.cd=60;addB(D.pts);
  if(k==='dol'){const L=MGR.filter(function(m){return !m.fired;}).sort(function(a,b){return a.stand-b.stand;});if(L[0]){L[0].stand=Math.max(0,L[0].stand-10);drawM(L[0]);if(L[0].stand<=0)fireMgr(L[0]);}pop('📋 Cahier de doléances affiché'+(L[0]?' : '+L[0].name+' perd 10 de réputation':'')+' ! +'+D.pts+' branleur','good');}
  else if(k==='greve'){EMP.forEach(function(e){if(e.out>0)return;e.gs=45;try{strikeLabel(e.g,true);}catch(_){}});MGR.forEach(function(m){if(!m.fired){m.stand=Math.max(0,m.stand-5);drawM(m);}});STRK.t=45;PIMM=Math.max(PIMM||0,45);try{strikeLabel(pl,true);}catch(_){}pop('✊ GRÈVE GÉNÉRALE ! 45 s, tous les managers perdent 5 de réputation. +'+D.pts+' branleur','good');}
  else pop('📢 Tracts distribués ! +'+D.pts+' branleur','good');}
function csqStep(m){const i=CSQ.mk.indexOf(m);m.cool=2;
  if(m.obj==='csfin'){csqDone();return;}
  if(i>=0){try{m.zone.g.remove(m.g);const q=m.zone.markers.indexOf(m);if(q>=0)m.zone.markers.splice(q,1);}catch(_){}CSQ.mk.splice(i,1);}
  if(m.obj==='csplainte'){try{const e=EMP.find(function(x){return x.zn&&Z[x.zn]===m.zone&&Math.hypot(x.x-m.x,x.z-m.z)<2.5;});if(e)say(e.g,CSQ.k==='dol'?['On est trop peu en caisse !','Les plannings, c\'est n\'importe quoi.','Le café est payant, c\'est honteux.'][(Math.random()*3)|0]:'Je suis avec toi !');}catch(_){}}
  toast(CSQ.k==='tracts'?'📢 Tracts posés ('+(3-CSQ.mk.length)+'/3).':CSQ.k==='dol'?'📋 Plainte notée ('+(3-CSQ.mk.length)+'/3).':'✊ Collègue convaincu ('+(3-CSQ.mk.length)+'/3).');
  if(!CSQ.mk.length){if(CSQ.k==='tracts')csqDone();else{CSQ.fin=1;csqAdd(csqPos('cse'),'csfin',CSQ.k==='dol'?'Afficher le cahier de doléances':'Lancer la grève générale');}}}
function csqTick(dt){EMP.forEach(function(e){if(e.gs>0){e.gs-=dt;e.noF=Math.max(e.noF||0,2);if(e.gs<=0){e.gs=0;try{strikeLabel(e.g,false);}catch(_){}}}});
  if(!isCseMe()||CREATING){if(CSQ.k){csqClear();CSQ.k='';}return;}
  if(!CSQ.k&&mode==='zone'){CSQ.cd-=dt;if(CSQ.cd<=0){const K=['tracts','dol','greve'];csqStart(K[CSQ.i++%3]);}}}
/* la nuit, les managers de garde poursuivent aussi */
function mgrNight(dt){if(NK<=.5||mode!=='zone'||rank!==0||SEC||CREATING||uiOpen){MGR.forEach(function(m){m.nfx=0;});return;}
  MGR.forEach(function(m){if(m.fired||m.zn!==cur||m.stun>0||m.task||m.state!=='patrol'){m.nfx=0;return;}
    const dx=pp.x-m.x,dz=pp.z-m.z,d=Math.hypot(dx,dz),h=m.g.rotation.y;
    if(m.ncd>0)m.ncd-=dt;if(!(m.nfx>0)){if(!(m.ncd>0)&&HID<=0&&DISG<=0&&d>.3&&d<6.5*detM()&&(Math.sin(h)*dx+Math.cos(h)*dz)/d>Math.cos(.7)&&!blocked(Z[cur],m.x,m.z,pp.x,pp.z)){m.nfx=18;try{say(m.g,'Toi ! Qu\'est-ce que tu fais là à cette heure ?');}catch(_){}pop('🔦 Un manager de garde t\'a vu : cours ou cache-toi !','warn');}return;}
    m.nfx-=dt;if(HID>0&&d>2.2){m.nfx=0;m.path=null;try{say(m.g,'Il s\'est volatilisé…');}catch(_){}return;}
    if(d>1.1){m.nrp=(m.nrp||0)-dt;if(m.nrp<=0||!m.path||m.pi>=m.path.length){m.nrp=.8;m.path=path(Z[cur],m.x,m.z,pp.x,pp.z);m.pi=0;}follow(m,dt,5.2);m.wait=.25;m.g.rotation.y=angLerp(m.g.rotation.y,Math.atan2(dx,dz),.3);m.ph=(m.ph||0)+dt*8;walkAnim(m.g,m.ph,1.3);m.g.position.set(m.x,0,m.z);m.ncs=0;}
    else{m.ncs=(m.ncs||0)+dt;m.wait=.25;if(m.ncs>=.45){m.ncs=0;m.nfx=0;m.ncd=25;m.wait=3;m.path=null;try{say(m.g,'Je t\'ai eu !');}catch(_){}pop('🚨 Un manager de garde t\'a attrapé !','bad');if(LOOT.length){try{caughtLoot(m,'Je t\'ai eu, voleur !');}catch(_){giveBlame('un manager t\'a attrapé de nuit !',0);}}else giveBlame('un manager t\'a attrapé de nuit !',0);}}
    if(m.nfx<=0){m.path=null;m.wait=1.2;}});}
/* objets de nuit */
ITEMS.push({id:'frontale',n:'Lampe frontale',ic:'⛑️',p:25,t:'b',th:0,lv:1,fin:1,passive:1,d:'La nuit, éclaire plus large et plus loin que la lampe torche, mains libres. Mais on te voit de plus loin. S\'allume avec le bouton de la lampe.'},
  {id:'brouin',n:'Brouilleur de nuit',ic:'📡',p:15,t:'b',th:0,lv:1,fin:1,fx:'brouin',d:'Les caméras ne te voient plus pendant 60 s (une utilisation).'},
  {id:'chauss',n:'Chaussons silencieux',ic:'🥿',p:12,t:'b',th:0,lv:1,fin:1,fx:'chauss',d:'Pendant 2 min, vigiles et managers te repèrent de moins loin (une utilisation).'});
ICAT.frontale='acc';ICAT.brouin='acc';ICAT.chauss='acc';
FX.brouin=function(){JAM=60;return 'Brouilleur de nuit branché : les caméras ne te voient plus pendant 60 s.';};
FX.chauss=function(){SILT=120;return 'Chaussons silencieux enfilés : on te repère de moins loin pendant 2 min.';};
/* fin de saison : tout le monde repart niveau 1, 0 pièce, objets gardés (verrouillés par niveau), 4e coeur pour le gagnant (jamais plus de 4) */
function seasonApply(){if(CREATING||!STARTED)return;let c=null;try{c=accChars()[PLAY_CH];}catch(_){}if(!c||!c.srs||c.srd===c.srs)return;
  Object.keys(LT).forEach(function(k){if(LT[k]){LT[k].b=1;LT[k].w=1;}});lvSync();SB=0;SW=0;coins=0;blames=0;WN=0;FIREW=null;lives=(c.hb===SEASON.n)?4:3;PRO.psc=0;PRO.pn=0;PRO.pw=0;
  c.srd=c.srs;try{accSave();saveGame();renderQI();}catch(_){}pop('🗓 Saison '+SEASON.n+' : tout le monde repart niveau 1 !','good');toast('Nouvelle saison : niveaux remis à 1 et pièces à 0. Tes objets sont gardés mais verrouillés selon ton niveau.',1);}

/* ---------- U6 : postes joueurs et PNJ (le serveur fait le tirage), remplacants PNJ des managers absents, conge ---------- */
function sBeatRes(row){try{if(!row||!row.role)return;const c=accChars()[PLAY_CH];if(!c||CREATING)return;
  if(row.role===SRV.role||(SRV.rlT&&Date.now()-SRV.rlT<45000))return;const was=SRV.role;SRV.role=row.role;SRV.pm=!!row.promoted;
  SRV.mq=0;if(row.role==='m'&&rank===0&&!SEC){promote('Un manager PNJ',' cède son poste (tirage de promotion)');pop('🎉 Tu as gagné le tirage : tu es promu manager !','good');}
  else if(row.role==='e'&&rank>=1){chRole('e',0);LK.role='e';try{applyLook(lookOpts(),PNAME);startRole('e');}catch(_){}SB=lvBase(LT.e.b,false);SW=lvBase(LT.e.w,false);try{saveGame();}catch(_){}
    pop('⬇ Tu redeviens employé','warn');toast('Au tirage de promotion, ta barre était la plus basse (ou tu n\'es pas venu dans les 12 h) : un autre joueur prend ton poste. Tu gardes ton niveau d\'employé.',1);}
  else if(was!==row.role){c.rl=row.role;accSave();}}catch(_){}}
/* managers joueurs absents : un PNJ joue a leur place, sous leur nom, et les crasses comptent (a moitie) */
function sMgrs(){if(SRV.mq&&Date.now()-SRV.mq<55000)return;SRV.mq=Date.now();sRpc('edm_managers',{}).then(function(L){if(!Array.isArray(L))return;SRV.mgrs=L;mgrDoubles();});}
/* 6 postes de manager : les PNJ laissent la place aux managers joueurs connectes */
function npcBars(){try{return JSON.stringify(MGR.filter(function(m){return !m.dis&&!m.fired&&!m.pn;}).map(function(m){return {n:m.name,s:Math.round(m.stand)};}));}catch(_){return '';}}
function mgrPosts(){if(!SRV.on)return;const on=(SRV.mgrs||[]).filter(function(p){return p.online;}).length,tgt=Math.max(0,6-on);
  let L=MGR.filter(function(m){return !m.dis;});
  while(L.length>tgt){const c=L.filter(function(m){return !m.pn&&!m.task;}).sort(function(a,b){return (b.fired?1:0)-(a.fired?1:0)||a.stand-b.stand;})[0];if(!c)break;try{releaseTask(c);}catch(_){}c.fired=true;c.respawn=-1;c.dis=true;c.g.visible=c.gs.visible=c.gp.visible=c.gi.visible=false;L=MGR.filter(function(m){return !m.dis;});}
  while(L.length<tgt){const c=MGR.find(function(m){return m.dis;});if(!c)break;c.dis=false;c.fired=false;c.respawn=0;c.stand=100;try{backToPatrol(c,60);}catch(_){}drawM(c);L=MGR.filter(function(m){return !m.dis;});}}
function mgrDoubles(){mgrPosts();const L=(SRV.mgrs||[]).filter(function(p){return !p.online&&!p.mine;});const act=MGR.filter(function(m){return !m.fired;});
  act.forEach(function(m,i){const p=L[i];const pn=p?String(p.name).slice(0,20):'';if(m.pn!==pn){m.pn=pn||undefined;if(p){m.stand=Math.max(1,Math.min(100,p.reputation));m.pprot=!!p.prot;}drawM(m);}else if(p){m.stand=Math.max(1,Math.min(100,p.reputation));m.pprot=!!p.prot;drawM(m);}});}
/* conge : un par saison, couvre une journee sans connexion ; regle : se connecter au moins une fois par jour */
function cgChar(){try{return accChars()[PLAY_CH]||null;}catch(_){return null;}}
function cgLabel(){const c=cgChar();if(!c)return 'Congé';if(c.cg===SEASON.n)return c.cgArm?'Congé posé : il couvre ta prochaine absence':'Congé déjà pris cette saison';return 'Poser mon jour de congé (1 par saison)';}
function cgPose(){const c=cgChar();if(!c)return;if(c.cg===SEASON.n){toast(c.cgArm?'🏖️ Ton congé est déjà posé : il couvrira ta prochaine journée d\'absence.':'🏖️ Tu as déjà pris ton congé cette saison.');return;}
  c.cg=SEASON.n;c.cgArm=1;accSave();try{sRpc('edm_day_off',{p_slot:PLAY_CH});}catch(_){}pop('🏖️ Congé posé !','good');toast('Tu peux t\'absenter une journée entière sans perdre tes points (un seul congé par saison).',1);}
const ABS={done:0};
function absCheck(){if(CREATING||!STARTED)return;const d=cseDay();let ld='';try{ld=localStorage.getItem(CK('edm_lday'))||'';}catch(_){}
  if(!ABS.done){ABS.done=1;if(ld&&rank===0&&!SEC){let yest='';try{yest=new Date(Date.parse(d+'T12:00:00Z')-864e5).toISOString().slice(0,10);}catch(_){}
      if(yest&&ld<yest){const c=cgChar()||{},miss=Math.round((Date.parse(yest+'T12:00:00Z')-Date.parse(ld+'T12:00:00Z'))/864e5),base=lvBase(LT.e.b,false);
        const pen=function(t){const lost=Math.max(0,Math.round(SB-base));SB=Math.min(SB,base);try{saveGame();}catch(_){}toast(t+(lost?' Tes points retombent au début de ton niveau (−'+lost+').':''),1);};
        if(c.cgArm&&miss<=1){c.cgArm=0;accSave();toast('🏖️ Ton jour de congé a couvert ton absence : tu gardes tous tes points.',1);}
        else if(c.cg!==SEASON.n&&miss<=1){setTimeout(function(){dlg('🏖️ Tu as été absent plus de 24 h','Tu ne t\'es pas connecté pendant une journée entière. Veux-tu prendre ton jour de congé de la saison ? Oui : tu gardes tous tes points. Non : tes points retombent au début de ton niveau (tu gardes ton congé).',[
            {t:'Oui, je prends mon congé',f:function(){c.cg=SEASON.n;c.cgArm=0;accSave();try{sRpc('edm_day_off',{p_slot:PLAY_CH});}catch(_){}toast('🏖️ Congé pris : tu gardes tous tes points.',1);}},
            {t:'Non',f:function(){pen('Pas de congé.');}}]);},1500);}
        else pen(miss>1?'Tu as été absent plus d\'une journée.':'Tu as été absent une journée entière et ton congé est déjà pris.');}}}
  if(ld!==d){try{localStorage.setItem(CK('edm_lday'),d);}catch(_){}}}

/*NET-BEGIN*/
/* ---------- multijoueur en ligne (connexion directe PeerJS ; l'hote est le plus ancien joueur) ---------- */
const NET={on:false,role:'none',players:{},seq:1,hostPid:null,code:'',pid:Math.random().toString(36).slice(2,9),peers:[],conns:{},hostConn:null,myPeer:null,lastState:0,joined:false,attempts:0,creating:false,leaving:false,recon:0,av:{},known:null,tm:0};
const SB_URL='https://rdf-relais.jmhouv.workers.dev',SB_KEY='cf';/* comptes, sauvegardes et saisons : serveur Cloudflare rdf-relais (base D1) */
const NET_URL='';const CF_URL='wss://rdf-relais.jmhouv.workers.dev';/* relais Cloudflare commun aux deux jeux *//* adresse du relais Cloudflare, ex. wss://edm-relais.TON-COMPTE.workers.dev (vide = connexion directe PeerJS) */
const NROOM=(/^#[a-z0-9]{3,16}$/i.test(location.hash||'')?location.hash.slice(1).toLowerCase():'mag-q7x4m2');
function netMine(){return {sb:Math.round(SB),sw:Math.round(SW),im:Math.round(image),lv:Math.max(LVL,LVM),nm:PNAME,zn:cur,x:+pp.x.toFixed(2),z:+pp.z.toFixed(2),f:+pp.face.toFixed(2),in:mode==='zone'?1:0,ky:KEY?+KEYT.toFixed(1):0,lk:{g:LK.g,build:LK.build,tall:LK.tall,hs:LK.hs,hc:LK.hc,beard:LK.beard,cap:LK.cap,skin:LK.skin,top:LK.top,pant:LK.pant,ic:LK.ic||'⭐',role:myRole(),pm:pmF()?1:0,cw:LK.crown?1:0},cd:cfCd(),ps:proMine(),sl:PRO.sl,pvs:(PRO.pv&&PRO.pv.sl===PRO.sl-1)?PRO.pv.sc:0,cv:CSEV.vote||'',cw:CSEV.my||0,dk:CSEV.day||''};}
function netNextHost(pl,exclude){let b=null;Object.keys(pl||{}).forEach(function(id){if(id===exclude)return;const p=pl[id];if(!p||typeof p.joined!=='number')return;if(!b||p.joined<pl[b].joined)b=id;});return b;}
function netStart(){
  if(NET.on)return;
  if(NET_URL){netWsStart();return;}
  if(CF_URL&&!NET.sbFail){netSbStart();return;}
  if(typeof Peer==='undefined'){toast('Mode en ligne indisponible ici (connexion directe bloquée). Joue en solo, ou depuis la version itch.io.');return;}
  NET.on=true;NET.roleChk=false;NET.code=NROOM;NET.attempts=0;NET.creating=false;NET.leaving=false;NET.joined=false;
  toast('En ligne : recherche de la partie…');netClient();
  if(!NET.tm)NET.tm=setInterval(netTick,100);
  setTimeout(function(){if(NET.on&&!NET.joined){toast('En ligne : connexion impossible (ton réseau bloque peut-être les connexions directes). Joue en solo.');}},15000);
}

/* ---------- transport par relais (WebSocket, Cloudflare Durable Object) : le serveur tient la liste des joueurs et choisit l'hote ---------- */
function netWsStart(){
  NET.on=true;NET.roleChk=false;NET.code=NROOM;NET.leaving=false;NET.joined=false;NET.role='client';NET.wsTry=0;
  toast('En ligne : connexion au serveur…');netWsOpen();
  if(!NET.tm)NET.tm=setInterval(netTick,100);
  setTimeout(function(){if(NET.on&&!NET.joined)toast('En ligne : serveur injoignable. Joue en solo ou réessaie plus tard.');},15000);
}
function netWsOpen(){
  if(NET.leaving)return;let ws;
  try{ws=new WebSocket(NET_URL.replace(/\/$/,'')+'/room/'+encodeURIComponent(NET.code));}catch(_){NET.wsTry++;if(NET.wsTry<30)NET.recon=setTimeout(netWsOpen,3000);return;}
  NET.ws=ws;
  ws.onopen=function(){NET.wsTry=0;NET.lastState=Date.now();try{ws.send(JSON.stringify(Object.assign({t:'hello',pid:NET.pid},netMine())));}catch(_){}};
  ws.onmessage=function(e){let m=null;try{m=JSON.parse(e.data);}catch(_){return;}netData(m);};
  ws.onclose=function(){if(NET.ws===ws)NET.ws=null;if(NET.leaving||!NET.on)return;if(NET.joined)toast('En ligne : connexion perdue, reconnexion…');NET.wsTry++;if(NET.wsTry<40)NET.recon=setTimeout(netWsOpen,2000);};
  ws.onerror=function(){};
}
function netWsSend(m){try{if(NET.ws&&NET.ws.readyState===1){NET.ws.send(JSON.stringify(m));return true;}}catch(_){}return false;}

/* ---------- transport Supabase Realtime (Broadcast, protocole Phoenix en WebSocket brut) : pas de serveur a ecrire.
   Chaque joueur diffuse son etat ; l'ordre d'arrivee (joined) = l'heure d'arrivee de chacun ; l'hote = le plus ancien. ---------- */
function sbClean(d){const num=function(v,x){v=+v;return isFinite(v)?v:x;};let lk=null;try{if(d.lk&&typeof d.lk==='object'){const j=JSON.stringify(d.lk);if(j.length<700)lk=JSON.parse(j);}}catch(_){}
  return {nm:String(d.nm||'').slice(0,20),zn:String(d.zn||'').slice(0,16),x:num(d.x,0),z:num(d.z,0),f:num(d.f,0),in:d.in?1:0,ky:num(d.ky,0),im:num(d.im,0),lv:num(d.lv,1),sb:num(d.sb,0),sw:num(d.sw,0),lk:lk,cd:String(d.cd||'').slice(0,12),ps:num(d.ps,0),sl:num(d.sl,0),pvs:num(d.pvs,0),joined:num(d.joined,Date.now()),cv:String(d.cv||'').slice(0,24),cw:num(d.cw,0),dk:String(d.dk||'').slice(0,10)};}
function netSbStart(){
  NET.on=true;NET.roleChk=false;NET.code=NROOM;NET.leaving=false;NET.joined=false;NET.role='client';NET.sb=1;NET.sbJoined=false;NET.wsTry=0;NET.myJoined=0;NET.sbLast=0;
  toast('En ligne : connexion au serveur…');netSbOpen();
  if(!NET.tm)NET.tm=setInterval(netTick,40);
  setTimeout(function(){if(NET.on&&NET.sb&&!NET.joined){NET.sbFail=1;NET.sb=0;try{if(NET.ws)NET.ws.close();}catch(_){}NET.on=false;NET.ws=null;if(typeof Peer!=='undefined'){toast('Serveur injoignable : essai en connexion directe…');netStart();}else toast('En ligne : serveur injoignable. Joue en solo ou réessaie plus tard.');}},10000);
}
function netSbOpen(){
  if(NET.leaving||!NET.sb)return;let ws;
  try{ws=new WebSocket(CF_URL+'/room/edm-'+NET.code);}catch(_){NET.wsTry++;if(NET.wsTry<40)NET.recon=setTimeout(netSbOpen,3000);return;}
  NET.ws=ws;NET.sbJoined=false;
  ws.onopen=function(){NET.wsTry=0;NET.lastState=Date.now();NET.sbJoined=true;if(NET.lostMsg){NET.lostMsg=0;toast('En ligne : reconnecté.');}if(!NET.myJoined){NET.myJoined=Date.now();setTimeout(netSbFinishJoin,1300);}netSbSendPos(true);};
  ws.onmessage=function(e){let m=null;try{m=JSON.parse(e.data);}catch(_){return;}if(!m||typeof m.e!=='string')return;NET.lastState=Date.now();
    {const ev=m.e,d=m.d;if(!d||typeof d!=='object')return;
      if(ev==='pos'&&typeof d.pid==='string'&&d.pid!==NET.pid&&/^[a-z0-9]{3,24}$/i.test(d.pid)){if(!NET.players[d.pid]&&Object.keys(NET.players).length>=14)return;{const nw=Date.now(),old=NET.players[d.pid],np=Object.assign(sbClean(d),{seen:nw,rt:nw,vx:0,vz:0});if(old&&old.zn===np.zn&&old.rt){const dtm=(nw-old.rt)/1000;if(dtm>.02&&dtm<1){const vx=(np.x-old.x)/dtm,vz=(np.z-old.z)/dtm;np.vx=Math.hypot(vx,vz)>7?0:vx*.7+(old.vx||0)*.3;np.vz=Math.hypot(vx,vz)>7?0:vz*.7+(old.vz||0)*.3;}}NET.players[d.pid]=np;}}
      else if(ev==='npc'&&d.from!==NET.pid&&d.from===NET.hostPid)netNpcIn(d);
      else if(ev==='mh'&&d.from!==NET.pid&&netNpcIsHost()){const mm=MGR[d.i|0];if(mm&&isFinite(d.dmg))hitMgr(mm,Math.max(0,Math.min(60,+d.dmg)),d.from);}
      else if(ev==='wfx')wfxRecv(d);
