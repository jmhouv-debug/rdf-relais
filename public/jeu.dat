const QZ=['store','reserve','office','salle','boulangerie','poissonnerie'];
const QZN={store:'Magasin',reserve:'Réserve',office:'Bureaux',salle:'Salle de réunion',boulangerie:'Labo boulangerie',poissonnerie:'Labo poissonnerie'};
const QNAMES=['Karim','Inès','Léa','Tom','Nina','Hugo','Sofia','Yanis','Chloé','Mehdi','Jade','Lucas','Manon','Bilal','Zoé','Enzo','Sarah','Kévin'];
const QPOW={
  kit:{ic:'🩹',b:'Trousse',d:'Rend 1 cœur à toi et aux collègues à moins de 5 m.'},
  shield:{ic:'🛡️',b:'Bouclier',d:'Un dôme de 4 m pendant 6 s : personne dedans ne peut être repéré ni attrapé.'},
  portal:{ic:'🌀',b:'Portail',d:'Ouvre un portail vers la zone de ton choix pendant 1 min, pour toute l\'équipe. À la sortie, une bulle repousse les managers pendant 10 s.'},
  cart:{ic:'🛒',b:'Caddie',d:'Tu lances un caddie vers le manager le plus proche ; il assomme celui qui le percute.'},
  disc:{ic:'👻',b:'Invisible',d:'Les managers ne te voient plus pendant 5 s.'},
  info:{ic:'📢',b:'Annonce',d:'Fausse annonce : directrice et managers filent à l\'accueil pendant 8 s.'},
  taser:{ic:'🔫',b:'Paralyser',d:'Tir paralysant automatique (jusqu\'à 14 m) vers le manager devant toi, directrice comprise : KO 8 s.'},
  toys:{ic:'🤖',b:'Jouets',d:'3 jouets te protègent pendant 30 s : dès qu\'un ennemi approche, un jouet fonce dessus (1 coup chacun).'},
  blackout:{ic:'⚡',b:'Coupure',d:'Coupure de courant dans ta zone pendant 8 s : les managers n\'y voient presque plus et sont ralentis.'},
  hype:{ic:'🎤',b:'Motivation',d:'Endurance pleine pour toute l\'équipe et coup de vitesse pendant 5 s.'}};
const QCL={
  sst:{n:'Secouriste (SST)',ic:'💚',pw:'kit',pas:'Relève un collègue en 1 s au lieu de 3.'},
  rec:{n:'Réceptionnaire',ic:'🛡️',pw:'shield',pas:'5 cœurs au lieu de 3.'},
  drv:{n:'Driver',ic:'🌀',pw:'portal',pas:'Radar : des arcs autour de toi montrent les managers proches (vert loin, orange, rouge tout près).'},
  stg:{n:'Stagiaire',ic:'🔧',pw:'cart',pas:'Tes sabotages vont 2 fois plus vite.'},
  ent:{n:'Agent d\'entretien',ic:'🧹',pw:'disc',pas:'Personne ne fait attention à toi : les managers te repèrent de moins loin.'},
  inf:{n:'Informaticien',ic:'💻',pw:'info',pas:'Tu peux pirater seul la caisse centrale.'},
  sec:{n:'Agent de sécurité',ic:'🔫',pw:'taser',pas:'Bientôt : met les clients énervés KO en 1 coup, sans être ralenti par eux.'},
