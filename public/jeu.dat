function mkCone(g,r,half,color,op){const grp=new T.Group();g.add(grp);const mt=new T.MeshBasicMaterial({color:color,transparent:true,opacity:op,side:T.DoubleSide,depthWrite:false});
  const m=new T.Mesh(new T.CircleGeometry(r,28,Math.PI/2-half,half*2),mt);m.rotation.x=Math.PI/2;m.position.y=.07;grp.add(m);return {grp:grp,mat:mt,op:op};}
function tintCone(c,seen,col){c.mat.color.setHex(col);c.mat.opacity=seen?c.op*2.2:c.op;}

