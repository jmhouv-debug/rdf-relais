/* ---------- en partie : hôte ---------- */
function qnAgentByPid(pid){return QM.A.find(function(a){return a.pid===pid;});}
function qnRingById(id){return QM.R.find(function(r){return r.id===id;});}
function qnHostRecv(ev,d){const a=qnAgentByPid(d.pid);if(!a||!a.remote)return;a.seen=Date.now();
  if(ev==='p'){if(a.caught>0||QM.meet)return;if(a.cv?d.zn!=='cv_'+a.cv.k:qmIsCv(d.zn))return;if(qmIsAr(a.zn)!==qmIsAr(d.zn)||(qmIsAr(d.zn)&&d.zn!==a.zn))return;a.tx=+d.x;a.tz=+d.z;a.th=+d.h;if(d.zn!==a.zn&&(QZ.indexOf(d.zn)>=0||(a.cv&&d.zn==='cv_'+a.cv.k))){a.zn=d.zn;a.x=a.tx;a.z=a.tz;}a.mv=d.mv;
