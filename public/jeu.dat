/* ----- Labos : boulangerie (angle bas gauche) et poissonnerie (angle haut gauche) ----- */
(function(){
  function mkLab(id,name,x0,x1,z0,z1,ta,tb){const cx=(x0+x1)/2,cz=(z0+z1)/2;const L=zone(id,name,cz,{x:[x0+.5,x1-.5],z:[z0+.5,z1-.5]},{x:x1-2.5,z:cz});const g=L.g;
    floor(L,x1-x0,z1-z0,cx,cz,tileTex(ta,tb,8,6));
    box(g,x1-x0+.4,5,.4,0xe9e4d8,cx,2.5,z0-.2,true);box(g,x1-x0+.4,1.4,.4,0xe9e4d8,cx,.7,z1+.2,true);box(g,.4,5,z1-z0,0xe9e4d8,x0-.2,2.5,cz,true);
    box(g,.4,5,3.6,0xe9e4d8,x1+.2,2.5,z0+1.8,true);box(g,.4,5,3.6,0xe9e4d8,x1+.2,2.5,z1-1.8,true);
    const ll=label(name,{sx:3.6,sy:.8,w:384,h:72,size:36});ll.position.set(cx,4.2,z0+.5);g.add(ll);
    return L;}
  function chef(L,x,z,name,shirt,pre){const c=makeChar({shirt:shirt,pants:0x444b57,hair:0x333333,badge:1,cap:0xffffff});c.position.set(x,0,z);c.rotation.y=Math.PI/2;L.g.add(c);empTag(c,name,pre);EMP.push({g:c,x:x,z:z,name:name,cd:0,zn:L.id});}
  function cam(L,c){c.lz=c.z;RCAM.push(c);buildCam(L.g,c,L.id,11);}
  /* boulangerie (v198 : doublee vers le haut) */
  const B=mkLab('boulangerie','Labo boulangerie',-48,-32,-4,20,'#f1e3c8','#dccaa6'),g=B.g;
  B.spawn={x:-34.5,z:14};
