ITEMS.push({id:'torche',n:'Lampe torche',ic:'🔦',p:5,t:'w',th:0,lv:0,fin:1,passive:1,d:'Achetée une fois, gardée pour toujours. La nuit, un bouton apparaît pour l\'allumer ou l\'éteindre.'},{id:'torchem',n:'Lampe torche',ic:'🔦',p:5,t:'m',tr:'w',th:0,lv:0,fin:1,passive:1,d:'Achetée une fois, gardée pour toujours. La nuit, un bouton apparaît pour l\'allumer ou l\'éteindre.'});
ICAT.torche='acc';ICAT.torchem='surv';
function catOf(it){if(ICAT[it.id])return ICAT[it.id];if(it.t==='m')return 'perso';return itemTr(it)==='w'?'val':'sab';}
let PCT={shop:'all',inv:'all'};
function catView(kind,L,inv){const C=rank>=1?CATM:CATE;let c0=PCT[kind]||'all';if(!C.some(function(c){return c[0]===c0;}))c0='all';
  const cnt=function(k){return L.filter(function(i){return k==='all'||catOf(i)===k;}).reduce(function(a,i){return a+(inv?(INV[i.id]||0):1);},0);};
  const tabs='<div class="ctabs">'+C.map(function(c){const n=cnt(c[0]);if(!inv&&n===0&&c[0]!=='all')return '';return '<button class="ctab'+(c[0]===c0?' on':'')+(n?'':' z')+'" data-c="'+c[0]+'">'+c[2]+' '+c[1]+' <b>'+n+'</b></button>';}).join('')+'</div>';
  const items=L.filter(function(i){return c0==='all'||catOf(i)===c0;}).sort(function(a,b){return a.p-b.p||a.n.localeCompare(b.n);});
  return {tabs:tabs,items:items};}
function renderPhone(){const b=$('phBody');$('phTabA').hidden=!(rank>=1);$('phTabA').classList.toggle('on',PHN==='auth');$('phTabM').hidden=rank<1&&!SEC;$('phTabM').classList.toggle('on',PHN==='msg');$('phTabS').classList.toggle('on',PHN==='shop');$('phTabI').classList.toggle('on',PHN==='inv');
  const T0=rank>=1?LT.m:LT.e,head='<div class="phh"><span><b>'+Math.floor(coins)+'</b> pièces</span><span>Niv. <b>'+(rank>=1?LVM:LVL)+'</b></span><span>Branleur <b>'+SB+'</b>/'+lvNeed(T0.b)+' (niv. '+T0.b+')</span><span>Bosseur <b>'+SW+'</b>/'+lvNeed(T0.w)+' (niv. '+T0.w+')</span></div><p class="mtxt balt">'+balInfo().t+'</p>';
  const row=function(it,inv){const n=INV[it.id]||0,ok=itemOK(it);
    return '<div class="it'+(!inv&&!ok?' lk':'')+'"><span class="ic">'+it.ic+'</span><div class="tx"><b>'+(rank>=1?({b:'🎭 ',w:'💼 ',x:'⚖️ '}[itemTr(it)]||''):'')+it.n+(inv?' ×'+n:(n?' (tu en as '+n+')':''))+(FLASH.id===it.id&&clk-FLASH.t<2?'<i class="plus">+1</i>':'')+'</b><small>'+itDesc(it)+'</small></div>'+
      (inv?(it.passive?'<small>auto</small>':it.pc?'<small>sur un PC</small>':'<button data-u="'+it.id+'">Utiliser</button>'):((it.id==='torche'||it.id==='torchem')&&n>0?'<small>✔ Possédée</small>':ok?'<button data-b="'+it.id+'"'+(coins<it.p||(rank<1&&!WCIN)?' disabled':'')+'>Acheter · '+it.p+' 🪙</button>':'<small>'+lockTxt(it)+'</small>'))+'</div>';};
  if(PHN==='auth'&&rank>=1){b.innerHTML=head+authHTML(PA,'');}
  else if(PHN==='msg'){b.innerHTML=(MSG.length?MSG.map(function(m,i){const age=Math.round(clk-m.t),old=age>m.life||(m.kind==='e'&&!m.e.f)||(m.kind==='cafe'&&!COF.grp.length);return '<div class="it'+(old?' lk':'')+'"><span class="ic">'+(m.kind==='m'?'🚬':'📣')+'</span><div class="tx"><b>'+(m.seen?'':'● ')+m.from+'</b><small>'+m.txt+' • il y a '+age+' s</small></div>'+(old?'<small>terminé</small>':'<button data-g="'+i+'">Y aller</button>')+'</div>';}).join(''):'<p class="mtxt">Aucun message pour l\'instant. Tes collègues te signaleront ici les infractions, en direct.</p>');}
  else if(PHN==='shop'&&rank>=1){const V=catView('shop',ITEMS.filter(function(i){return i.t==='m'&&!i.dir;}),false);b.innerHTML=head+V.tabs+V.items.map(function(i){return row(i,false);}).join('');}
  else if(PHN==='shop'){const V=catView('shop',ITEMS.filter(function(i){return i.t!=='m';}),false);b.innerHTML=head+(WCIN?'<p class="mtxt">🚽 Tu es aux toilettes : tu peux acheter.</p>':'<p class="mtxt">🚽 Pour acheter un item, il faut aller aux toilettes (verrouille la porte d\'une cabine).</p>')+V.tabs+V.items.map(function(i){return row(i,false);}).join('');}
  else{const L=ITEMS.filter(function(i){return INV[i.id]>0&&((i.t==='m')===(rank>=1));});const V=catView('inv',L,true);b.innerHTML=head+(L.length?V.tabs+(V.items.length?V.items.map(function(i){return row(i,true);}).join(''):'<p class="mtxt">Rien dans cette catégorie.</p>'):'<p class="mtxt">Inventaire vide. Fais des bêtises ou monte de niveau pour débloquer des objets, puis achète-les aux toilettes (boutique du téléphone).</p>');}}
