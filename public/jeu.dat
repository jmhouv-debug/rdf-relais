function mgFace(x,cx,cy,r,mood){x.fillStyle='#f1c9a5';x.beginPath();x.arc(cx,cy,r,0,7);x.fill();x.fillStyle='#4a2c1a';x.beginPath();x.arc(cx,cy-r*.35,r,Math.PI,0);x.fill();
  x.fillStyle='#222';if(mood==='sleep'){x.fillRect(cx-r*.5,cy-4,r*.3,4);x.fillRect(cx+r*.2,cy-4,r*.3,4);}else{x.beginPath();x.arc(cx-r*.3,cy-3,4,0,7);x.arc(cx+r*.3,cy-3,4,0,7);x.fill();}
  x.strokeStyle='#222';x.lineWidth=3;x.strokeRect(cx-r*.5,cy-r*.18,r*.4,r*.3);x.strokeRect(cx+r*.1,cy-r*.18,r*.4,r*.3);
  x.beginPath();if(mood==='smile'||mood==='smoke'){x.arc(cx,cy+r*.3,r*.3,0,Math.PI);}else if(mood==='sleep'){x.ellipse(cx,cy+r*.42,r*.14,r*.1,0,0,7);}else{x.moveTo(cx-r*.3,cy+r*.5);x.lineTo(cx+r*.3,cy+r*.5);}x.stroke();}
function funnyShow(by){if(MX.funny)return;const k=(Math.random()*FUNNY.length)|0;MX.funny={t:6,prev:{m:SCR.mode,d:SCR.d}};scrMode('funny',{k:k});MEETCH.slice(0,4).forEach(function(d){say(d,'😂');});MX.clap=2;
  if(MEET.by==='me'){RESULT=Math.max(0,RESULT-5);toast('😳 Une image gênante de toi s\'affiche à l\'écran devant tout le monde ! Résultats −5.');}
  else{const L=MGR.filter(function(m){return !m.fired;});if(L.length)hitMgr(L[(Math.random()*L.length)|0],10);}
  if(by==='me'){addB(10);coins+=5;toast('😈 Ta clé USB a frappé : image gênante du manager devant tout le monde ! +10 branleur, +5 pièces.');}
  else if(SAL.cam&&SEC){coins+=8;toast('📹 Ta caméra cachée a filmé le coupable : +8 pièces.');}}
function salCamCheck(){if(SAL.cam&&rank===0&&Math.random()<.7){giveBlame('la caméra cachée de la salle t\'a filmé en train de piéger la réunion.',0);return true;}return false;}
function salTrap(id,sp){
  if(id==='coussin'&&sp&&sp.ci!==undefined){const c=CHR[sp.ci];if(SAL.cush[sp.ci]){toast('Il y a déjà un coussin sur ce siège.');return null;}SAL.cush[sp.ci]=8;SAL.cushBy='me';const m=new T.Mesh(new T.CircleGeometry(.4,20),new T.MeshBasicMaterial({color:0xff8fb1}));m.rotation.x=-Math.PI/2;m.position.y=.58;c.g.add(m);SAL.cushM[sp.ci]=m;toast('💨 Coussin posé sur le siège. 15 s après que quelqu\'un s\'y assoit en réunion : POUET.');salCamCheck();return true;}
  if(id==='petard'&&sp&&cur==='salle'){if(SAL.fire){toast('La poubelle est déjà piégée.');return null;}SAL.fire=true;SAL.fireBy='me';addB(4);toast('🔥 Pétard glissé dans la poubelle : elle s\'enflammera pendant la prochaine réunion. +4 branleur');salCamCheck();return true;}
  if(id==='cle'){if(SAL.hack){toast('Une clé truquée est déjà branchée.');return null;}SAL.hack=true;SAL.hackBy='me';toast('💾 Clé branchée. À la prochaine réunion, une image gênante du manager s\'affichera.');salCamCheck();return true;}
  if(id==='strobo'){if(SAL.strobe){toast('Le stroboscope est déjà branché.');return null;}SAL.strobe=true;SAL.strobeBy='me';toast('🪩 Stroboscope branché : les lumières clignoteront pendant la prochaine réunion.');salCamCheck();return true;}
  return false;}
function salStart(by){SAL.camX=0;
  if(by==='me'&&!globalThis.__noplot&&Math.random()<.3){const r=Math.random();if(r<.34&&!SAL.hack){SAL.hack=true;SAL.hackBy='npc';}else if(r<.67&&!SAL.strobe){SAL.strobe=true;SAL.strobeBy='npc';}else if(!SAL.fire){SAL.fire=true;SAL.fireBy='npc';}}
  MEETCH.forEach(function(d){const ci=CHR.indexOf(d.userData.seat);d.userData.cush=SAL.cush[ci]?15:0;d.userData.cdm=SAL.cush[ci]||8;});
  if(SAL.strobe){MX.strobe=40;$('strobeFx').classList.add('on');if(SAL.strobeBy==='me'){addB(6);toast('🪩 Le stroboscope s\'allume : ambiance boîte de nuit ! +6 branleur');}else toast('🪩 Quelqu\'un a branché un stroboscope dans la salle !');}
  if(SAL.fire){SAL.fireT=25;SAL.fireM.visible=true;MX.fire=1;MEETCH.slice(0,3).forEach(function(d){say(d,'🔥 AU FEU !');});toast('🔥 La poubelle de la salle est en feu ! Éteins-la vite (près de la poubelle, à droite).');}}
function salTick(dt){
  MEETCH.forEach(function(d){const u=d.userData;if(u.cush>0){u.cush-=dt;if(u.cush<=0){u.cush=0;const e=u.e;say(d,'💨 POUET !');beep(160,.3,.08);if(e){empS(e);e.im=Math.max(0,e.im-(u.cdm||8));}MX.clap=Math.max(MX.clap||0,2);if(SAL.cushBy==='me'){addB(7);toast('💨 '+(e?e.name:'Un employé')+' s\'assoit sur ton coussin péteur : POUET ! −'+(u.cdm||8)+' Sérieux pour lui, +7 branleur.');}else toast('💨 POUET ! '+(e?e.name:'Quelqu\'un')+' perd '+(u.cdm||8)+' de Sérieux.');}}});
  if(MX.strobe>0){MX.strobe-=dt;if(MEET.by==='me'&&rank>=1)RESULT=Math.max(0,RESULT-dt*.07);if(MX.strobe<=0){MX.strobe=0;$('strobeFx').classList.remove('on');}}
  if(MX.funny){MX.funny.t-=dt;if(MX.funny.t<=0){const pv=MX.funny.prev;MX.funny=null;scrMode(pv.m==='funny'?'res':pv.m,pv.d);}}
  if(SAL.draw&&!MX.drawDone&&MEET.t>5){MX.drawDone=1;SAL.draw=false;MEETCH.slice(0,4).forEach(function(d){say(d,'😂');});MX.clap=2;if(MEET.by==='me'){RESULT=Math.max(0,RESULT-3);toast('😳 Quelqu\'un a dessiné une moustache sur le tableau. Résultats −3.');}else{const L=MGR.filter(function(m){return !m.fired;});if(L.length)hitMgr(L[(Math.random()*L.length)|0],6);addB(4);toast('🖍️ Le manager découvre la moustache sur le tableau devant tout le monde. +4 branleur.');}}
  if(SAL.hack&&!MX.hackDone&&MEET.t>3){MX.hackDone=1;SAL.hack=false;funnyShow(SAL.hackBy);}
  if(MX.fire){SAL.fireT-=dt;if(SAL.fireT<=0){MX.fire=0;SAL.fire=false;SAL.fireM.visible=false;if(MEET.by==='me')RESULT=Math.max(0,RESULT-6);if(SAL.fireBy==='me'){addB(8);coins+=3;toast('🔥 La poubelle a cramé : +8 branleur.');}else toast('🔥 La poubelle a cramé : la réunion est ruinée'+(MEET.by==='me'?' (Résultats −6).':'.'));}}}
function salEnd(){SAL.draw=false;SAL.hack=false;SAL.strobe=false;SAL.fire=false;SAL.fireM.visible=false;$('strobeFx').classList.remove('on');Object.keys(SAL.cushM).forEach(function(k){const m=SAL.cushM[k];if(m&&m.parent)m.parent.remove(m);});SAL.cush={};SAL.cushM={};}
/* machine à café : groupe d'employés, caméra, café en main */
function cafeGroupEnd(why){COF.grp.forEach(function(d){d.visible=false;const e=d.userData.e;if(e){e.g.visible=!e.cap;e.cafe=0;e.noF=Math.max(e.noF||0,12);}});COF.grp.length=0;COF.t=0;COF.rep=false;COF.pb=false;COF.next=clk+90+Math.random()*70;if(why)toast(why);}
function cafeTick(dt){if(CINE||mode!=='zone')return;
  if(MEET.on){if(COF.grp.length)cafeGroupEnd();return;}
  if(!COF.grp.length){if(clk<COF.next||globalThis.__nocafe)return;const L=EMP.filter(function(e){return !(e.out>0)&&e.zn==='store'&&!e.f&&!e.corner;});if(L.length<4){COF.next=clk+40;return;}
    const n=3+(Math.random()<.4?1:0),P=[[MCX-1.3,MCZ-1.6],[MCX,MCZ-2.1],[MCX+1.4,MCZ-1.6],[MCX+2.1,MCZ-.2]];
    for(let i=0;i<n;i++){const e=L.splice((Math.random()*L.length)|0,1)[0];const d=getDouble(e);d.userData.e=e;d.visible=true;standOne(d);d.position.set(P[i][0],0,P[i][1]);d.rotation.y=Math.atan2(MCX-P[i][0],MCZ-P[i][1]);e.cafe=1;COF.grp.push(d);}
    COF.t=0;COF.life=55+Math.random()*25;return;}
  COF.t+=dt;COF.grp.forEach(function(d){d.userData.e.g.visible=false;});
  if(COF.t>8&&!COF.rep&&COF.grp.length>=3){COF.rep=true;if(rank>=1)pushMsg({from:'Caméra',kind:'cafe',zn:'salle',txt:'La caméra de la salle de réunion détecte '+COF.grp.length+' employés agglutinés autour de la machine à café.',life:60});}
  if(COF.t>8&&!COF.pb&&rank===0&&cur==='salle'&&Math.hypot(pp.x-MCX,pp.z-MCZ)<4.5){COF.pb=true;giveBlame('la caméra de la salle t\'a repéré dans l\'attroupement autour de la machine à café.',0);}
  if(COF.t>COF.life||(rank===0&&COF.t>28)){cafeGroupEnd(rank===0?'Un manager rappelle tout le monde à l\'ordre : fin de la pause café.':'');}}
function getDouble(e){let d=MEETD[e.name];if(!d){d=makeChar((e.g.userData&&e.g.userData.o)||{shirt:0x2f6fd0,pants:0x3d405b,hair:0x222222,badge:1});empTag(d,e.name);SL.g.add(d);MEETD[e.name]=d;}return d;}
function dropCup(msg){if(CUP.m&&CUP.m.parent)CUP.m.parent.remove(CUP.m);CUP.on=false;CUP.m=null;if(msg)toast(msg);}
function takeCup(){if(CUP.on){toast('Tu as déjà un café en main.');return;}CUP.on=true;CUP.t=0;CUP.last=clk;hunger=Math.min(100,hunger+12);addW(2);try{CUP.m=cyl(pl.userData.arms[1],.1,.08,.2,0xf5f0e6,0,-.6,.12,false);}catch(_){CUP.m=null;}toast('☕ Tu prends un café. Évite de te balader avec en plein service : si un manager, un vigile ou la directrice te voit, c\'est un blâme.');}
function cupTick(dt){if(!CUP.on||mode!=='zone')return;CUP.t+=dt;if(CUP.t>100){dropCup('Ton café est froid : tu le jettes.');return;}
  if(rank===0&&cur==='store'&&CUP.t>12&&clk-CUP.last>12){const near=function(o){return o.zn===cur&&!o.fired&&Math.hypot(o.x-pp.x,o.z-pp.z)<7;};const w=MGR.some(near)||GUARDS.some(near)||(D.zn===cur&&Math.hypot(D.x-pp.x,D.z-pp.z)<7);if(w){CUP.last=clk;if(Math.random()<.65||globalThis.__cupsure){dropCup();giveBlame('tu te balades avec un café en main pendant le service.',0);{const mm=MGR.find(near);if(mm)say(mm.g,phrase('cafe'));else if(D.zn===cur)say(dirc,phrase('cafe'));}}}}}
