  QM.CL=QM.MAP.cli?(QM.CLH||(QM.CLH=qmMapClients())):NPC.filter(function(n){return !n.name&&!n.off;});
  {const nh=Math.max(1,R.filter(function(r){return r.pid;}).length);QM.CE=QM.CL.slice(0,Math.min(QM.CL.length,2+Math.ceil(nh/3)));QM.CE.forEach(function(n,i){try{qmAccCli(n.g,i);}catch(_){}n.ang=1;n.ko=0;n.cd=0;n.hits=0;n.ci=i;n.cid=i;n.zn='store';n.ty=1;n.bub=label('😠',{sx:.75,sy:.75,w:96,h:96,size:66,bg:'rgba(229,72,77,.92)'});scene.add(n.bub);});}
  QM.FY=[];(QM.MAP.fy||[['reserve',-30,-45],['reserve',0,-55],['office',30,-34],['office',52,-30]]).forEach(function(q,i){const o={shirt:[0x3b82f6,0x10b981,0x8b5cf6,0xf59e0b][i],pants:0x334155,hair:[0x2b1d14,0xc9a227,0x1b1b1b,0x6b3a2a][i],fem:i%2===1,hs:i%2?'long':'court'};const g=makeChar(o);
    const tg=label('🙄 Fayot',{sx:1.7,sy:.45,w:220,h:58,size:28,bg:'rgba(90,90,110,.93)'});tg.position.y=2.6;g.add(tg);scene.add(g);const p=qmFree(q[0],q[1],q[2]);QM.FY.push({id:i,g:g,zn:q[0],x:p[0],z:p[1],h:0,hd:0,ph:0,ko:0,hits:0,cd:0,gzn:null,wait:1+Math.random()*3});});
  qmTrapInit();document.body.dataset.mode='qm';qmHudBuild();qmIntro();if(QM.mp)QM.paused=false;}
const QNUM=['','①','②','③','★','📣'];
function qmRingTxt(r){return (r.qn?QNUM[r.qn]+' ':'')+qmRingTxt0(r);}
function qmRingTxt0(r){if(r.k==='mini')return (r.dbl?'×2 ':'')+(r.duo?'👥2 ':'')+r.n;if(r.k==='team')return '👥 '+r.n+' · '+(r.cnt||0)+'/'+r.need;if(r.k==='pair')return '⏱️ '+r.n+' (à 2 endroits)';if(r.k==='spec')return '⚡ '+r.n;return r.n;}
function qmRingOn(r){if(r.cd>0)return false;if(!r.qa&&!(r.k==='mini'&&r.act))return false;if(QM.lockZ&&(QM.lockZ[r.zn]||(r.room&&QM.lockR[r.room])))return false;if(r.lock){const L=QM.R.find(function(x){return x.id===r.lock;});if(!L||!L.done)return false;}return true;}
/* ---------- interface ---------- */
function qmHudBuild(){if($('qmHud'))return;const d=document.createElement('div');d.id='qmHud';
  d.innerHTML='<div id="qmBadge"></div><div id="qmTop"><div id="qmTime">10:00</div><div id="qmBarW"><div id="qmBarL">Rideau de fer <b id="qmPct">0 %</b></div><div class="qmbar"><i id="qmBar"></i></div></div></div>'
    +'<div id="qmHearts"></div><div id="qmStaW"><b id="qmStaF"></b></div><div id="qmRole"></div><div id="qmMsg"></div><div id="qmCaught" hidden></div>'
    +'<div id="qmTR"><button id="qmMenuB" aria-label="Menu">≡</button></div><button id="qmMapB" aria-label="Carte">🗺️</button><button id="qmMapAll" hidden>⬅ Toute la carte</button><div id="qmBig" hidden></div><div id="qmJamFx" hidden></div><div id="qmDark" hidden></div><div id="qmCine" hidden></div>'
    +'<button class="btn" id="qmIt" hidden></button><button class="btn" id="qmUlt" hidden></button><div id="qmInv" hidden></div><button class="btn" id="qmHit" hidden></button><div id="qmObj"></div><div id="qmArr"></div><div id="qmPowB"><button class="btn" id="qmHelpB" hidden></button><button class="btn" id="qmP1" hidden></button><button class="btn" id="qmJm" hidden></button><button class="btn" id="qmAl" hidden></button><button class="btn" id="qmLk" hidden></button></div>'
    +'<div id="qmMapT" hidden>🗺️ Touche une zone pour zoomer · 🗺️ pour revenir au jeu</div>'
    +'<div id="qmOv" hidden><div class="qmbox" id="qmBox"></div></div>';
  $('app').appendChild(d);
  $('qmMenuB').addEventListener('click',qmMenu);$('qmMapB').addEventListener('click',qmMapToggle);
  $('qmP1').addEventListener('click',function(){qmUsePow(QM.me,QM.me.pw[0]);});$('qmUlt').addEventListener('pointerdown',function(e){e.preventDefault();e.stopPropagation();if(QM.on&&!QM.paused&&!QM.uiOpen)qmUlt(QM.me);});$('qmIt').addEventListener('click',function(){if(QM.on&&!QM.paused)qmUseItem(QM.me);});$('qmHelpB').addEventListener('click',function(){if(!QM.on||QM.paused)return;const me=QM.me;if((me.helpCd||0)>QM.clk)return;if(QM.mp&&QN.client){me.helpCd=QM.clk+20;qnS('a',{pid:QN.pid,k:'help'});qmMsg('📣 Appel à l\'aide envoyé !','good');}else qmHelpCall(me);});
  $('qmObj').addEventListener('pointerdown',function(e){e.preventDefault();e.stopPropagation();QM.qBig=QM.qBig>QM.clk?0:QM.clk+6;});
  canvas.addEventListener('pointerdown',function(e){if(!QM.on||QM.paused||QM.uiOpen||mode!=='zone'||QM.auto)return;if(sp&&sp.id!==e.pointerId){qmMelee(QM.me);return;}QM._tp={id:e.pointerId,x:e.clientX,y:e.clientY,t:performance.now()};});
  canvas.addEventListener('pointerup',function(e){const t=QM._tp;QM._tp=null;if(!t||t.id!==e.pointerId||!QM.on||QM.paused||QM.uiOpen||mode!=='zone'||QM.auto)return;if(performance.now()-t.t<260&&Math.hypot(e.clientX-t.x,e.clientY-t.y)<14)qmMelee(QM.me);});
  $('qmHit').addEventListener('pointerdown',function(e){e.preventDefault();if(QM.on&&!QM.paused&&!QM.uiOpen)qmMelee(QM.me);});
  $('qmAl').addEventListener('click',function(){qmAlert(QM.me);});$('qmLk').addEventListener('click',function(){qmLock(QM.me);});$('qmJm').addEventListener('click',function(){qmJam(QM.me);});
  $('qmMapAll').addEventListener('click',function(){QM.mapZ=null;$('qmMapAll').hidden=true;});
  try{renderer.domElement.addEventListener('pointerdown',function(e){if(!QM.on||!QM.map)return;try{const v=new T.Vector2((e.clientX/window.innerWidth)*2-1,-(e.clientY/window.innerHeight)*2+1);const rc=new T.Raycaster();rc.setFromCamera(v,camera);const pt=new T.Vector3();if(!rc.ray.intersectPlane(new T.Plane(new T.Vector3(0,1,0),0),pt))return;qmMapPick(pt.x,pt.z);}catch(_){}});}catch(_){}}
function qmMapPick(x,z){let best=null,ba=1e12;QZ.forEach(function(id){const b=Z[id].bounds;if(x<b.x[0]||x>b.x[1]||z<b.z[0]||z>b.z[1])return;const a=(b.x[1]-b.x[0])*(b.z[1]-b.z[0]);if(a<ba){ba=a;best=id;}});if(best&&best!==QM.mapZ){QM.mapZ=best;$('qmMapAll').hidden=false;}}
function qmBig(t,cls,all){if(all&&QM.mp&&QN.host)qnS('big',{t:t,c:cls||''});const b=$('qmBig');if(!b)return;b.textContent=t;b.className=cls||'';b.hidden=false;b.style.animation='none';void b.offsetWidth;b.style.animation='';clearTimeout(QM._bigT);QM._bigT=setTimeout(function(){b.hidden=true;},2800);}
function qmMapToggle(){if(QM.meet||QM.uiOpen||QM.cine)return;if(QM.me.jam>0&&!QM.map){qmMsg('📡 Brouillage : la carte ne répond plus !','bad');return;}QM.map=!QM.map;QM.mapZ=null;$('qmMapAll').hidden=true;if(!QM.map)QM.mapOut=1.2;$('qmMapT').hidden=!QM.map;$('qmMapB').classList.toggle('on',QM.map);}
function qmOv(html){$('qmBox').innerHTML=html;$('qmOv').hidden=false;QM.uiOpen=true;}
function qmOvClose(){$('qmOv').hidden=true;QM.uiOpen=false;}
function qmPowTxt(a){const c=QCL[a.cls];return c.ic+' '+c.n+' · '+QPOW[c.pw].ic+' '+QPOW[c.pw].b;}
function qmClsGrid(sel,tk){return '<div class="qmcls">'+QCK.map(function(k){const c=QCL[k],p=QPOW[c.pw],t=tk&&tk[k];return '<button class="qmcl'+(sel===k?' on':'')+'" data-c="'+k+'"'+(t?' disabled':'')+'><b>'+c.ic+' '+c.n+'</b><span>'+p.ic+' '+p.b+'</span>'+(t?'<i>'+esc(t)+'</i>':'')+'</button>';}).join('')+'</div>';}
function qmClsInfo(k){const c=QCL[k],p=QPOW[c.pw];return '<div class="qmpw"><b>'+c.ic+' '+c.n+'</b><div>⭐ Passif : '+c.pas+'</div><div>'+p.ic+' <b>'+p.b+'</b> : '+p.d+' Recharge 30 s.</div></div>';}
function qmIntro(pick){const me=QM.me;if(pick===undefined)pick=!QM.mp&&!QM.picked;
  const team=QM.A.map(function(a){return '<span class="qmn">'+QCL[a.cls].ic+' '+esc(a.name)+(a.human?' (toi)':'')+'</span>';}).join('');
  qmOv('<div class="qmk">OPÉRATION RIDEAU DE FER · MODE COOP</div>'
    +(pick?'<h2 class="qmemp" style="margin:4px 0">Choisis ta classe</h2>'+qmClsGrid(QM.picked?me.cls:'')+'<div id="qmClI">'+(QM.picked?qmClsInfo(me.cls):'<p class="qmsm">Touche une classe pour voir son passif et son pouvoir.</p>')+'</div>':qmClsInfo(me.cls))
    +'<p class="qmd">Faites descendre le rideau jusqu\'à <b>100 %</b> en <b>15 minutes</b> maximum (une équipe efficace y arrive en 10-12 min). Petits sabotages partout (👥2 = à deux). <b>2 quêtes d\'équipe</b> ①② (à 2 ou 3, ou 🔑 trouver une clé) et <b>ta quête perso ★</b> rapportent beaucoup plus : suis les faisceaux et les flèches. Chacun marque des ⭐ : victoire ×1,5, défaite ×0,5, et le meilleur est sacré <b>Employé du mois</b> !<br>'
    +'❤️ Un manager qui t\'attrape t\'enlève un cœur. À 0, tu tombes <b>à terre</b> : un collègue doit rester <b>3 s à côté de toi</b>.<br>'
    +'🚔 Pas relevé en 30 s, ou attrapé par la <b>directrice</b> : <b>convoqué</b> dans une pièce secrète (labyrinthe dans le noir, cadenas, conduits piégés, classement). Évade-toi, ou que <b>2 collègues</b> te libèrent sur le rond 🔓 devant son bureau (sinon tu sors au bout de 2 min). 📣 <b>À l\'aide</b> : appelle du renfort sur une quête à plusieurs. ⚔️ Bouton <b>Frapper</b> (ou une tape sur l\'écran) : tu attaques avec l\'arme de ta classe, si l\'ennemi est à portée et en vue (rien à travers les gondoles). 📦 Ouvre les <b>cartons</b> (objets, améliorations… ou pièges). En ouvrant une salle, un <b>boss</b> peut surgir : 4 boss dans l\'ordre, chacun laisse des armes meilleures.<br>'
    +'🏃 Joystick <b>à fond pour courir</b>, à moitié pour marcher.<br>🤜 <b>Agir</b> : frapper un manager <b>dans le dos</b> (3 coups = KO 5 s), <b>bousculer</b> celui qui te fonce dessus, frapper les clients 😠 et les fayots 🙄 qui te balancent. Face à un rayon : attraper un objet à lancer.</p>'
    +'<div class="qmteam"><small>Équipe :</small>'+team+'</div>'
    +'<p class="qmd">⚡ <b>Ultime</b> : chaque ⭐ charge le bouton doré ; à 100 %, touche-le pour l\'effet de ta classe. 🎒 Tes objets sont sur le bord droit : touche une icône pour l\'utiliser.</p><button class="abtn2 full" id="qmGuideI">📖 Guide : objets, pièges, classes, boss</button><button class="abtn full" id="qmGo"'+(pick&&!QM.picked?' disabled':'')+'>C\'est parti !</button>');
  Array.prototype.forEach.call(document.querySelectorAll('.qmcl'),function(b){b.onclick=function(){const k=b.dataset.c,o=QM.A.find(function(a){return a!==me&&a.cls===k;});if(o)qmSetCls(o,me.cls);qmSetCls(me,k);QM.picked=1;qmIntro(true);};});
  $('qmGuideI').onclick=function(){QM._gInt=pick;qmGuide();};$('qmGo').onclick=function(){if(pick&&!QM.picked)return;qmOvClose();QM.paused=false;qmMsg('💥 Sabote le magasin ! Ta classe : '+QCL[me.cls].ic+' '+QCL[me.cls].n,'good');};}
function qmMenu(){if(QM.meet)return;if(!QM.mp)QM.paused=true;qmOv('<h2 class="qmemp">≡ Menu <small style="font-size:11px;opacity:.6">version U6b</small></h2><p class="qmd">'+QM.MAP.ic+' '+esc(QM.MAP.n)+(QM.park?' · 🅿️ parking ouvert':'')+'</p><p class="qmd">Ton pouvoir : '+qmPowTxt(QM.me)+'</p>'
  +'<button class="abtn2 full" id="qmCam">🎥 Caméra : '+(QM.camNear?'rapprochée':'classique')+'</button><button class="abtn2 full" id="qmAuto">⚔️ Attaque auto : '+(QM.auto?'oui':'non')+'</button><button class="abtn full" id="qmRes">Reprendre</button>'+(QM.mp?'':'<button class="abtn2 full" id="qmTest">🧪 Tester (solo)</button>')+'<button class="abtn2 full" id="qmGuideB">📖 Guide</button><button class="abtn2 full" id="qmRul">Règles</button><button class="abtn2 full" id="qmQuit" style="margin-top:8px">Quitter la partie (menu principal)</button>');
  $('qmGuideB').onclick=function(){qmGuide();};$('qmAuto').onclick=function(){QM.auto=!QM.auto;try{localStorage.setItem('edm_qmauto2',QM.auto?'1':'0');}catch(_){}qmMenu();};
  $('qmCam').onclick=function(){QM.camNear=!QM.camNear;try{localStorage.setItem('edm_qmcam',QM.camNear?'1':'0');}catch(_){}qmMenu();};
  $('qmRes').onclick=function(){qmOvClose();if(!QM.end)QM.paused=false;};$('qmRul').onclick=function(){qmIntro();};$('qmQuit').onclick=qmToMenu;if($('qmTest'))$('qmTest').onclick=qmTestMenu;}
function qmTestMenu(){const b=function(id,t){return '<button class="abtn2" style="margin:3px;min-width:46%" data-t="'+id+'">'+t+'</button>';};
  qmOv('<h2 class="qmemp">🧪 Tester</h2><p class="qmd">Lance directement ce que tu veux voir (partie solo seulement).</p><div class="qmk">BOSS</div><div>'+QBOSS.map(function(B,i){return b('b'+i,B.ic+' '+B.n);}).join('')+'</div>'
    +'<div class="qmk">ARÈNE DES VAGUES</div><div>'+b('wz','🧟 Horde de zombies')+b('wc','🛍️ Meute de clients')+'</div>'
    +'<div class="qmk">SALLE</div><div>'+b('room','🔑 Ouvrir une salle (surprise au hasard)')+b('roomb','🔑 Ouvrir une salle + boss')+'</div>'
    +'<div class="qmk">CONVOCATION</div><div>'+QCVK.map(function(k){return b('c'+k,QCV[k].ic+' '+QCV[k].n);}).join('')+'</div>'
    +'<div class="qmk">ARMES</div><div>'+Object.keys(QWP).map(function(k){return b('w'+k,QWP[k].ic+' '+QWP[k].n);}).join('')+b('box','📦 Carton à mes pieds')+'</div>'
    +'<div class="qmk">ULTIME ET OBJETS</div><div>'+b('ult','⚡ Ultime à 100 %')+b('inv','🎒 Objets de coffre à mes pieds')+'</div>'
    +'<div class="qmk">CARTE (relance la partie)</div><div>'+b('mclassic','🏪 Super du Centre')+b('mhyper','🏬 Hypermarché')+b('mrand','🎲 Au hasard')+b('mpark','🅿️ Parking : '+(QM.park?'ouvert':'fermé'))+'</div>'+'<button class="abtn full" id="qmTBack" style="margin-top:8px">⬅ Retour</button>');
  $('qmTBack').onclick=qmMenu;
  Array.prototype.forEach.call(document.querySelectorAll('[data-t]'),function(el){el.onclick=function(){const t=el.dataset.t,me=QM.me;
    if(t[0]==='m'&&t!=='mpark'){try{if(t==='mrand')localStorage.removeItem('edm_qmmap');else localStorage.setItem('edm_qmmap',t.slice(1));}catch(_){}qmReplay();return;}if(t==='mpark'){try{localStorage.setItem('edm_qmpark',QM.park?'0':'1');}catch(_){}qmReplay();return;}
    if(t==='ult'||t==='inv'){qmOvClose();QM.paused=false;if(t==='ult'){me.ult=100;}else{const p=qmP(me);['coeur','coeur','pile','passe','croissant','gilet'].forEach(function(k,i){const q=qmFree(p[2],p[0]+(i%3-1)*1.2,p[1]+(i<3?1.4:2.6));qmItemAdd(++QM.itN,k,p[2],q[0],q[1]);});}return;}const busy=QM.arena||QM.boss||me.cv;if(busy&&!/^w|^box/.test(t)){qmMsg('🧪 Termine d\'abord l\'arène ou la convocation en cours.','bad');return;}
    qmOvClose();QM.paused=false;
    if(t[0]==='b'&&t!=='box'){QM.bossN=+t[1];qmBossStart(null);}
    else if(t==='wz'||t==='wc')qmWaveStart(t==='wz'?'zomb':'cli',null);
    else if(t==='room'||t==='roomb'){const L=QROOM.filter(function(r){return QM.lockR[r.id];});if(!L.length){qmMsg('🧪 Toutes les salles sont déjà ouvertes.','bad');return;}const r=L[(Math.random()*L.length)|0];
      if(t==='roomb'){if(QM.bossN>3)QM.bossN=0;QM.forceBoss=1;try{qmOpenRoom(r.id);}finally{QM.forceBoss=0;}}else qmOpenRoom(r.id);}
    else if(t[0]==='c'){QM.cvForce=t.slice(1);qmCvSend(me);QM.cvForce=null;}
    else if(t==='box'){qmBxAdd(cur,pp.x+1.2,pp.z);}
    else if(t[0]==='w'){qmWpAdd(t.slice(1),cur,pp.x+1,pp.z);qmMsg('🧪 Arme posée à côté de toi : marche dessus (ou Agir pour échanger).','good');}};});}
function qmBtn(b,ic,txt,cd,dis){b.hidden=false;const h='<span style="font-size:22px;line-height:1">'+ic+'</span><span>'+(cd>0?Math.ceil(cd)+' s':txt)+'</span>';if(b._h!==h){b._h=h;b.innerHTML=h;}b.classList.toggle('cd',cd>0||!!dis);}
function qmLayout(){const ba=$('bAct'),p1=$('qmP1'),pb=$('qmPowB'),bt=$('btns');if(!ba||!p1||!pb)return;
  const por=window.innerWidth<window.innerHeight,B='calc(max(16px,env(safe-area-inset-bottom,0px)) + 4px)';
  if(por){[[p1,'calc(50% - 32px - 86px)','auto'],[ba,'calc(50% - 32px)','auto']].forEach(function(q){const e=q[0];e.style.position='fixed';e.style.bottom=B;e.style.left=q[1];e.style.right=q[2];e.style.margin='0';e.style.zIndex='6';});
    if(p1.parentNode!==pb)pb.insertBefore(p1,pb.firstChild);}
  else{[p1,ba].forEach(function(e){e.style.position='';e.style.bottom='';e.style.left='';e.style.right='';e.style.margin='';e.style.zIndex='';});
    if(p1.parentNode!==bt||p1.nextSibling!==ba){bt.insertBefore(p1,ba);}}
  {const hb=$('qmHit'),ib=$('qmUlt'),r3=ba.getBoundingClientRect();if(hb&&ib&&r3.height){[hb,ib].forEach(function(e){e.style.position='fixed';e.style.zIndex='6';});const W=window.innerWidth,H=window.innerHeight;
    {const hp=$('qmHelpB');if(hp){if(H>W){if(hp.parentNode!==document.body)document.body.appendChild(hp);hp.style.position='fixed';hp.style.zIndex='6';hp.style.left='max(12px,env(safe-area-inset-left,0px))';hp.style.bottom=Math.round(H-r3.top+24)+'px';hp.style.right='auto';}else{if(hp.parentNode!==pb)pb.insertBefore(hp,pb.firstChild);hp.style.position='';hp.style.left='';hp.style.bottom='';}}}
    if(H>W){hb.style.left=Math.round(W/2-33)+'px';hb.style.bottom=Math.round(Math.max(H-r3.top+70,H*.28)+7)+'px';ib.style.left=Math.round(r3.right+20)+'px';ib.style.bottom=Math.round(H-r3.top+24)+'px';}
    else if(r3.right+100<W){hb.style.left=Math.round(r3.right+12)+'px';hb.style.bottom=Math.round(H-r3.bottom-8)+'px';ib.style.left=Math.round(Math.min(r3.right+20,W-84))+'px';ib.style.bottom=Math.round(H-r3.top+24)+'px';}
    else{hb.style.left=Math.round(r3.left-96)+'px';hb.style.bottom=Math.round(H-r3.top+14)+'px';ib.style.left=Math.round(Math.min(r3.left,W-84))+'px';ib.style.bottom=Math.round(H-r3.top+14)+'px';}}}
  const r=ba.getBoundingClientRect();if(r.height){pb.style.left='auto';pb.style.right=por?'calc(50% - 32px - 76px)':'max(12px,env(safe-area-inset-right,0px))';pb.style.bottom=Math.round(window.innerHeight-r.top+10)+'px';}}
function qmHud(){QM.lt=(QM.lt||0)-1;if(QM.lt<=0){QM.lt=15;qmLayout();}const me=QM.me,t=Math.max(0,Math.ceil(QM.t)),s=String(Math.floor(t/60)).padStart(2,'0')+':'+String(t%60).padStart(2,'0');
  if(QM._t!==s){QM._t=s;$('qmTime').textContent=s;$('qmTime').classList.toggle('low',t<=60);}
  const pc=Math.min(100,Math.floor(QM.j));if(QM._p!==pc){QM._p=pc;$('qmPct').textContent=pc+' %';$('qmBar').style.width=pc+'%';}
  const imp=false,bd=me.cv?'🚔 CONVOQUÉ':me.caught>0?'🚔 AU BUREAU':me.down>0?'🆘 À TERRE · '+Math.ceil(me.down)+' s':me.zomb>0?'🧟 ZOMBIE · '+Math.floor(Math.ceil(me.zomb)/60)+':'+String(Math.ceil(me.zomb)%60).padStart(2,'0'):'👷 ÉQUIPE';if(QM._b!==bd){QM._b=bd;const B=$('qmBadge');B.textContent=bd;B.className=me.down>0||me.caught>0||me.cv?'imp':me.zomb>0?'zomb':'emp';}
  {const hh=me.zomb>0?'z':me.hp+'|'+(me.down>0)+'|'+me.hpMax+'|'+(me.hp>me.hpMax);if(QM._hh!==hh){QM._hh=hh;let h='';if(me.zomb>0)h='<span class="qmzh">🧟 pas de cœurs : intouchable</span>';else for(let i=0;i<Math.max(me.hpMax,Math.ceil(me.hp/4)*4)/4;i++){const f=clamp(me.hp-i*4,0,4)/4;h+='<span class="qmh'+(i>=me.hpMax/4?' bonus':'')+'"><i style="width:'+(f*100)+'%"></i></span>';}$('qmHearts').innerHTML=h;}
    const sf=$('qmStaF');if(sf){const w=me.zomb>0?100:Math.round(QM.st===undefined?100:QM.st);if(QM._sw!==w+''+QM.stx){QM._sw=w+''+QM.stx;sf.style.width=w+'%';sf.style.background=me.zomb>0?'#2e8c46':QM.stx?'#e5484d':w<35?'#ffb020':'#46d17a';}}}
  const tasks=QM.R.filter(function(r){return false&&qmRingOn(r)&&!(r.lk>0)&&(r.k!=='spec'||me.cls==='ele');}).slice(0,3).map(function(r){return (r.k==='team'?'👥':r.k==='pair'?'⏱️':'⚡')+' '+r.n+' <small>('+QZN[r.zn]+')</small>';});
  let kl='';if(QM.key.st==='held'&&QM.RM[QM.key.room])kl='🔑 '+(QM.key.by===me?'Tu as':esc(QM.key.by.name)+' a')+' la clé : '+QM.RM[QM.key.room].n+' ('+QZN[QM.RM[QM.key.room].door.zn]+')';else if(QM.key.st==='ground'&&QM.RM[QM.key.room])kl='🔑 Clé '+QM.RM[QM.key.room].n+' : '+QZN[QM.key.zn];if(false)kl='🔑 La clé est apparue : '+QZN[QM.key.zn];else if(QM.key.st==='held')kl='🔑 '+(QM.key.by===me?'Tu as la clé : va au pupitre (salle de réunion) !':esc(QM.key.by.name)+' a la clé');
  const rl=QCL[me.cls].ic+' '+QCL[me.cls].n+'<br><span class="qmz">📍 '+QZN[cur]+'</span>'+(kl?'<br><span class="qmkey">'+kl+'</span>':'')+(tasks.length&&!imp?'<div class="qmt">'+tasks.join('<br>')+'</div>':'')+(imp&&QM.REP.length?'<div class="qmt">🔧 '+QM.REP.length+' sabotage'+(QM.REP.length>1?'s':'')+' à réparer</div>':'');
  if(QM._r!==rl){QM._r=rl;$('qmRole').innerHTML=rl;}
  const cg=$('qmCaught');if(me.out){cg.hidden=false;cg.textContent='Tu as été viré par l\'équipe : tu regardes la fin de la partie.';}else if(me.caught>0){cg.hidden=false;cg.textContent='🚔 Bureau de la directrice : tu en ressors zombie dans '+Math.ceil(me.caught)+' s';}else cg.hidden=true;
  {const HB=$('qmHelpB');const need=!me.cv&&!me.out&&qmHelpNeed(me);if(need)qmBtn(HB,'📣','À l\'aide',Math.max(0,(me.helpCd||0)-QM.clk),false);else HB.hidden=true;}
  $('qmIt').hidden=true;qmInvHud();
  const pk=me.pw[0],P1=$('qmP1');if(QACT.indexOf(pk)>=0&&!me.out)qmBtn(P1,QPOW[pk].ic,QPOW[pk].b,me.cd[pk],me.zomb>0||me.down>0);else P1.hidden=true;
  const al=$('qmAl'),lk=$('qmLk'),jb=$('qmJm');if(imp&&!me.out){qmBtn(jb,'📡','Brouiller',me.cd.jam);qmBtn(al,'📞','Balancer',me.cd.alert);
    const onR=QM.R.some(function(x){return x.zn===cur&&qmRingOn(x)&&!(x.lk>0)&&Math.hypot(x.x-pp.x,x.z-pp.z)<1.4;});qmBtn(lk,'🔒','Verrouiller',me.cd.lock,!onR);}else{al.hidden=true;lk.hidden=true;jb.hidden=true;}}
/* ---------- pouvoirs de classe (recharge commune : 30 s) ---------- */
function qmNearH(a,R,front){let best=null,bd=R;QM.H.forEach(function(h){if(h.zn!==a.zn)return;const dx=h.x-a.x,dz=h.z-a.z,d=Math.hypot(dx,dz);if(d>=bd)return;if(front&&d>1.5&&(Math.sin(a.h)*dx+Math.cos(a.h)*dz)/d<Math.cos(1.05))return;bd=d;best=h;});return best;}
function qmPortalMenu(){const me=QM.me;qmOv('<div class="qmk">🌀 PORTAIL</div><h2 class="qmemp" style="margin:4px 0">Où ouvrir le portail ?</h2><p class="qmsm">Il s\'ouvre à tes pieds pendant 1 min, pour toute l\'équipe. À la sortie, une bulle repousse les managers pendant 10 s.</p><div class="qmpt">'
  +['store','reserve','office','boulangerie','salle'].map(function(zn){return '<button class="abtn" data-z="'+zn+'"'+(zn===cur||QM.lockZ[zn]?' disabled':'')+'>'+(QM.lockZ[zn]?'🔒':{store:'🏬',reserve:'📦',office:'🏢',boulangerie:'🥖',salle:'🗳️'}[zn])+' '+(zn==='boulangerie'?'Labos':QZN[zn])+'</button>';}).join('')+'</div><button class="abtn2 full" id="qmPtX">Annuler</button>');
  Array.prototype.forEach.call(document.querySelectorAll('.qmpt [data-z]'),function(b){b.onclick=function(){qmOvClose();me.ptDest=b.dataset.z;qmUsePow(me,'portal');};});$('qmPtX').onclick=function(){qmOvClose();};}
function qmUsePow(a,k,fxo){if(fxo){qmPowFx(a,k,fxo);return;}if((a.down>0||a.zomb>0)){if(a.human)qmMsg(a.zomb>0?'🧟 Pas de pouvoir quand tu es zombie.':'🆘 À terre : impossible.');return;}if(!k||a.out||a.caught>0||QM.paused||QM.uiOpen&&a.human)return;if(QACT.indexOf(k)<0)return;if(a.cd[k]>0){if(a.human)qmMsg('Pouvoir en recharge : '+Math.ceil(a.cd[k])+' s');return;}
  if(k==='portal'&&a.human&&!a.ptDest&&!qmIsAr(cur)){qmPortalMenu();return;}
  if((QM.mp&&QN.client)&&a.human){a.cd[k]=QCFG.cd;qnS('a',{pid:QN.pid,k:'pow',p:k,z:a.ptDest||''});a.ptDest=null;
    if(k==='disc'){a.inv=5;qmMsg('👻 Invisible pendant 5 s !','good');}else if(k==='hype'){QM.st=100;QM.stx=false;a.boost=5;}else qmMsg(QPOW[k].ic+' '+QPOW[k].b+' !','good');return;}
  a.cd[k]=QCFG.cd;const vis=a.zn===cur;const nm=a.human?'Tu':a.name;
  const fx=function(o){o=Object.assign({id:a.id,k:k,zn:a.zn,x:a.x,z:a.z,h:a.h},o||{});qmPowFx(a,k,o);if(QM.mp&&QN.host)qnS('fx',o);};
  if(qmIsAr(a.human?cur:a.zn)&&qmArenaPow(a,k,fx))return;
  if(k==='disc'){a.inv=5;QM.H.forEach(function(h){if(h.tg===a){qmLose(h,'Il est passé où ?');}});if(a.human)qmMsg('👻 Invisible pendant 5 s !','good');else if(a.remote)qnS('inv',{id:a.id});}
  else if(k==='info'){QM.decoy=8;QM.H.forEach(function(h){h.st='decoy';h.tg=null;h.dg=false;h.spot=0;if(h.grabT){qmUngrab(h);}});qmMsg('📢 « La direction est attendue d\'urgence à l\'accueil ! » Les managers filent pendant 8 s.','good',1);}
  else if(k==='shield'){fx();QM.H.forEach(function(h){if(h.tg&&qmDome(h.tg))qmLose(h,'Mais… je le vois plus !');});
    if(a.human)qmMsg('🛡️ Bouclier posé pendant 6 s : à l\'intérieur, personne ne peut vous repérer.','good');else if(vis)qmMsg('🛡️ '+a.name+' a posé un bouclier.');}
  else if(k==='cart'){const tg=qmNearH(a,12),ang=tg?Math.atan2(tg.x-a.x,tg.z-a.z):a.h,run=Math.min(6,tg?Math.hypot(tg.x-a.x,tg.z-a.z):6);fx({h:ang,r:run});if(a.human)qmMsg('🛒 Caddie lancé !','good');else if(vis)say(a.g,'Attention, caddie !');}
  else if(k==='kit'){let n=0;QM.A.forEach(function(b){if(b.out||b.down>0||b.zomb>0||b.caught>0||b.zn!==a.zn||Math.hypot(b.x-a.x,b.z-a.z)>5)return;if(b.hp<b.hpMax){b.hp=Math.min(b.hpMax,b.hp+4);n++;if(b.human&&b!==a)qmMsg('🩹 '+a.name+' te soigne : +1 cœur','good');}});fx();
    if(a.human)qmMsg(n?'🩹 +1 cœur pour '+n+' personne'+(n>1?'s':''):'🩹 Personne n\'était blessé près de toi.',n?'good':'');else if(vis)say(a.g,'Trousse de secours !');}
  else if(k==='taser'){if(QM.boss&&!QM.boss.dead&&QM.boss.zn===a.zn&&Math.hypot(QM.boss.x-a.x,QM.boss.z-a.z)<14){qmBossHit(5,a);fx({tx:QM.boss.x,tz:QM.boss.z});return;}const h=qmNearH(a,14,true)||qmNearH(a,6);if(h){h.stun=8;if(h.tg)qmLose(h,null);if(h.grabT)qmUngrab(h);if(h.zn===cur)say(h.g,'Bzzzt… !');}fx({tx:h?h.x:a.x+Math.sin(a.h)*8,tz:h?h.z:a.z+Math.cos(a.h)*8});
    if(a.human)qmMsg(h?'🔫 '+(h.dir?'La directrice':h.name)+' est KO pendant 8 s !':'🔫 Raté : aucun manager devant toi.',h?'good':'');}
  else if(k==='toys'){a.toys={n:3,t:30,cd:.5};if(a.human)qmMsg('🤖 3 jouets te protègent pendant 30 s !','good');else if(vis)say(a.g,'À l\'attaque, les jouets !');}
  else if(k==='blackout'){QM.dark={zn:a.zn,t:8};QM.H.forEach(function(h){if(h.zn===a.zn){h.dark=8;if(h.tg)qmLose(h,h.zn===cur?'Qui a éteint la lumière ?!':null);}});fx();qmMsg('⚡ Coupure de courant : '+QZN[a.zn]+' plongé dans le noir pendant 8 s !','good',1);}
  else if(k==='hype'){QM.A.forEach(function(b){if(b.out)return;b.boost=5;if(b.human){QM.st=100;QM.stx=false;}else if(b.remote)qnS('buff',{id:b.id});});fx();qmMsg('🎤 '+a.name+' motive l\'équipe : endurance pleine et coup de vitesse !','good',1);}
  else if(k==='portal'){const dz=a.ptDest||QZ.filter(function(z){return z!==a.zn&&z!=='poissonnerie'&&!QM.lockZ[z];})[0];a.ptDest=null;if(!dz||dz===a.zn||QM.lockZ[dz]){a.cd[k]=0;return;}
    const ex=QM.PEX[dz],p={id:(QM.ptN=(QM.ptN||0)+1),a:{zn:a.zn,x:a.x,z:a.z},b:{zn:dz,x:ex[0],z:ex[1]},t:60,bub:10};qmPortalMesh(p);QM.PT.push(p);a.ptCd=1.5;
    qmMsg('🌀 '+(a.human?'Tu as ouvert':a.name+' a ouvert')+' un portail '+QZN[a.zn]+' ⇄ '+(dz==='boulangerie'?'Labos':QZN[dz])+' pendant 1 min !','good',1);}}
function qmPowFx(a,k,o){o=o||{};
  if(k==='shield'){const m=new T.Mesh(new T.SphereGeometry(4,28,14,0,Math.PI*2,0,Math.PI/2),new T.MeshBasicMaterial({color:0x6fd3ff,transparent:true,opacity:.2,depthWrite:false,side:T.DoubleSide}));m.position.set(o.x,0,o.z);scene.add(m);
    const rg=new T.Mesh(ringG,new T.MeshBasicMaterial({color:0x6fd3ff,transparent:true,opacity:.8,depthWrite:false}));rg.rotation.x=-Math.PI/2;rg.position.set(o.x,.06,o.z);rg.scale.setScalar(4/.62);scene.add(rg);QM.D.push({zn:o.zn,x:o.x,z:o.z,t:6,m:m,rg:rg});}
  else if(k==='kit'||k==='hype'){const m=new T.Mesh(new T.SphereGeometry(1,16,10),new T.MeshBasicMaterial({color:k==='kit'?0x46d17a:0xffc23d,transparent:true,opacity:.6,depthWrite:false}));m.position.set(o.x,1,o.z);scene.add(m);QM.FX.push({zn:o.zn,m:m,t:1.2,k:'puff'});}
  else if(k==='taser'){const dx=o.tx-o.x,dz=o.tz-o.z,L=Math.max(.5,Math.hypot(dx,dz));const m=new T.Mesh(new T.CylinderGeometry(.06,.06,L,6),new T.MeshBasicMaterial({color:0xffe14d,transparent:true,opacity:.95,depthWrite:false}));m.position.set(o.x+dx/2,1.2,o.z+dz/2);m.rotation.x=Math.PI/2;m.rotation.z=0;m.lookAt(o.tx,1.2,o.tz);m.rotateX(Math.PI/2);scene.add(m);QM.FX.push({zn:o.zn,m:m,t:.35,k:'zap'});}
  else if(k==='toys'){(o.tg||[]).forEach(function(ti,i){const g=new T.Group();box(g,.42,.22,.5,[0xff4d6d,0x4dabf7,0xffd43b][i],0,.2,0,true);box(g,.3,.12,.22,0x222222,0,.36,-.05,false);const ang=o.h+(i-1)*.7,x=o.x+Math.sin(ang)*.8,z=o.z+Math.cos(ang)*.8;g.position.set(x,0,z);scene.add(g);QM.FX.push({zn:o.zn,m:g,t:6,k:'toy',x:x,z:z,ti:ti,own:o.id,done:false});});}
  else if(k==='blackout'){QM.dark={zn:o.zn,t:8};}
  else if(k==='punch'){const b=QM.A[o.id];if(b&&b.g)qmPunch(b);}
  else if(k==='throw'){const sp=label(o.ic||'🥫',{sx:.8,sy:.8,w:96,h:96,size:70,bg:'rgba(255,255,255,.0)'});sp.position.set(o.x,1.3,o.z);scene.add(sp);QM.FX.push({zn:o.zn,m:sp,t:.4,k:'proj',x0:o.x,z0:o.z,x1:o.tx,z1:o.tz});}
  else if(k==='cart'){const ang=o.h,run=o.r===undefined?6:o.r;const dx=Math.sin(ang),dz=Math.cos(ang);let x=o.x+dx*1,z=o.z+dz*1;const Zn=Z[o.zn];if(hit(x,z,.5,Zn)){x=o.x;z=o.z;}
    const g=new T.Group();box(g,.9,.55,1.2,0xc7ccd6,0,.75,0,true);box(g,.95,.06,1.25,0x8b93a1,0,1.04,0,false);box(g,.06,.6,.06,0x8b93a1,-.4,1.2,.55,false);box(g,.06,.6,.06,0x8b93a1,.4,1.2,.55,false);box(g,.9,.06,.06,0xd62839,0,1.5,.55,false);
    [[-.38,-.5],[.38,-.5],[-.38,.5],[.38,.5]].forEach(function(w){box(g,.1,.22,.22,0x222222,w[0],.11,w[1],false);});g.rotation.y=ang;g.position.set(x,0,z);scene.add(g);
    QM.FX.push({zn:o.zn,m:g,t:7,k:'cart',x:x,z:z,dx:dx,dz:dz,run:run,hit:[]});}}
function qmPortalMesh(p){const mk=function(e,o){const m=qmRingMesh(0x9b5cff,'🌀 Portail',360);m.g.position.set(e.x,0,e.z);const c=new T.Mesh(new T.CylinderGeometry(.75,.75,3.2,20,1,true),new T.MeshBasicMaterial({color:0xb98cff,transparent:true,opacity:.35,depthWrite:false,side:T.DoubleSide}));c.position.set(e.x,1.6,e.z);scene.add(c);m.cyl=c;m.to=o;return m;};
  p.m1=mk(p.a,p.b.zn);p.m2=mk(p.b,p.a.zn);const d=new T.Mesh(new T.SphereGeometry(3,24,12,0,Math.PI*2,0,Math.PI/2),new T.MeshBasicMaterial({color:0x6fd3ff,transparent:true,opacity:.18,depthWrite:false,side:T.DoubleSide}));d.position.set(p.b.x,0,p.b.z);scene.add(d);p.dome=d;}
function qmPortalKill(p){[p.m1,p.m2].forEach(function(m){scene.remove(m.g);scene.remove(m.cyl);});scene.remove(p.dome);}
function qmInBubble(a){return QM.PT&&QM.PT.some(function(p){return p.bub>0&&a.zn===p.b.zn&&Math.hypot(a.x-p.b.x,a.z-p.b.z)<3;});}
function qmPortals(dt){const host=!(QM.mp&&QN.client);
  for(let i=QM.PT.length-1;i>=0;i--){const p=QM.PT[i];if(host){p.t-=dt;if(p.bub>0)p.bub-=dt;}
    [[p.m1,p.a],[p.m2,p.b]].forEach(function(q){const m=q[0],e=q[1],v=e.zn===cur||QM.map;m.g.visible=v;m.cyl.visible=v&&!QM.map;m.lb.sp.visible=!QM.map;m.ring.rotation.z+=dt*3;m.cyl.material.opacity=.25+.12*Math.sin(QM.clk*6);m.g.scale.setScalar(QM.map?3:1);m.lb.draw('🌀 → '+(m.to==='boulangerie'?'Labos':QZN[m.to])+' · '+Math.max(0,Math.ceil(p.t))+' s','#9b5cfff2');});
    p.dome.visible=p.bub>0&&(p.b.zn===cur)&&!QM.map;p.dome.material.opacity=.12+.08*Math.sin(QM.clk*5);
    if(host){QM.H.forEach(function(h){if(p.bub>0&&h.zn===p.b.zn){const dx=h.x-p.b.x,dz=h.z-p.b.z,d=Math.hypot(dx,dz);if(d<3.1){const k=d>.01?3.2/d:1;const nx=p.b.x+dx*k,nz=p.b.z+(d>.01?dz*k:3.2);if(!hit(nx,nz,.4,Z[h.zn])){h.x=nx;h.z=nz;}h.path=null;if(h.tg&&qmInBubble(h.tg))qmLose(h,null);}}});}
    if(p.t<=0){qmPortalKill(p);QM.PT.splice(i,1);}}
  /* traversee : joueur local, et PNJ cote hote */
  QM.A.forEach(function(a){if(a.ptCd>0)a.ptCd-=dt;if(a.out||a.caught>0||a.down>0||(a.ptCd>0))return;if(a.remote)return;if(!a.human&&!host)return;
    const x=a.human?pp.x:a.x,z=a.human?pp.z:a.z,zn=a.human?cur:a.zn;
    QM.PT.forEach(function(p){if(a.ptCd>0)return;[[p.a,p.b],[p.b,p.a]].forEach(function(q){if(a.ptCd>0)return;const e=q[0],o=q[1];if(e.zn===zn&&Math.hypot(x-e.x,z-e.z)<.8){a.ptCd=2.5;a.imm=Math.max(a.imm||0,3);const ox=o.x+1.3,oz=o.z+.4,np=hit(ox,oz,.4,Z[o.zn])?[o.x,o.z+1.2]:[ox,oz];
      if(a.human){qmPlayerTo(o.zn,np[0],np[1]);qmMsg('🌀 Téléporté : '+(o.zn==='boulangerie'?'Labos':QZN[o.zn])+' (3 s de protection)','good');}else{a.zn=o.zn;a.x=np[0];a.z=np[1];a.path=null;a.leg=null;}}});});});}
/* radar du Driver */
function qmRadar(){const me=QM.me,on=me.cls==='drv'&&!(me.zomb>0)&&!me.out&&!(me.caught>0)&&!QM.map&&!QM.cine;let n=0;
  if(on)QM.H.filter(function(h){return h.zn===cur&&Math.hypot(h.x-pp.x,h.z-pp.z)<18;}).sort(function(p,q){return Math.hypot(p.x-pp.x,p.z-pp.z)-Math.hypot(q.x-pp.x,q.z-pp.z);}).slice(0,5).forEach(function(h){const m=QM.RAD[n++];const dx=h.x-pp.x,dz=h.z-pp.z,d=Math.hypot(dx,dz);
    m.visible=true;m.position.set(pp.x,.12,pp.z);m.rotation.z=Math.atan2(-dz,dx);const col=h.dir?0xb15cff:d<6?0xe5484d:d<12?0xff9f1c:0x46d17a;m.material.color.setHex(col);m.material.opacity=d<6?.22+.25*Math.abs(Math.sin(QM.clk*9)):.33;m.scale.setScalar(h.dir?1.12:1);});
  for(;n<QM.RAD.length;n++)QM.RAD[n].visible=false;}
function qmAniNear(a){return QM.A.some(function(b){return b!==a&&b.cls==='ani'&&!(b.zomb>0)&&!(b.down>0)&&!b.out&&!(b.caught>0)&&b.zn===a.zn&&Math.hypot((b.human?pp.x:b.x)-(a.human?pp.x:a.x),(b.human?pp.z:b.z)-(a.human?pp.z:a.z))<6;});}
function qmDome(a){return qmInBubble(a)||QM.D&&QM.D.some(function(d){return d.zn===a.zn&&Math.hypot(d.x-a.x,d.z-a.z)<4;})&&a.role!==undefined;}
function qmFX(dt){for(let i=QM.D.length-1;i>=0;i--){const d=QM.D[i];d.t-=dt;d.m.visible=d.rg.visible=d.zn===cur||QM.map;d.m.material.opacity=.14+.08*Math.sin(QM.clk*5)+(d.t<1.5?-.1:0);if(d.t<=0){scene.remove(d.m);scene.remove(d.rg);QM.D.splice(i,1);}}
  for(let i=QM.FX.length-1;i>=0;i--){const f=QM.FX[i];f.t-=dt;f.m.visible=f.zn===cur;
    if(f.k==='puff'){const k=1.4-f.t;f.m.scale.setScalar(1+k*5);f.m.material.opacity=Math.max(0,.7-k*.5);}
    else if(f.k==='swing'){f.m.material.opacity=Math.max(0,f.t/.22*.75);f.m.scale.setScalar(1+(.22-f.t)*2);}
    else if(f.k==='pow'){const k=.55-f.t;f.m.position.y=2.8+k*1.2;f.m.material.opacity=Math.min(1,f.t/.2);const sc=1+Math.min(.4,k*3);f.m.scale.set(2.4*sc,1.1*sc,1);}
    else if(f.k==='zap'){f.m.material.opacity=Math.max(0,f.t/.35);}
    else if(f.k==='proj'){const k=1-f.t/.4;f.m.position.set(f.x0+(f.x1-f.x0)*k,1.3+Math.sin(k*Math.PI)*1.2,f.z0+(f.z1-f.z0)*k);}
    else if(f.k==='toy'){const h=QM.H[f.ti];if(h&&!f.done&&h.zn===f.zn){const dx=h.x-f.x,dz=h.z-f.z,d=Math.hypot(dx,dz);if(d>.7){const st=Math.min(d,dt*7.5);f.x+=dx/d*st;f.z+=dz/d*st;f.m.rotation.y=Math.atan2(dx,dz);}else{f.done=true;f.t=Math.min(f.t,.5);
        if(!(QM.mp&&QN.client)){h.slow=6;if(h.tg)qmLose(h,null);if(h.zn===cur)say(h.g,'Qu\'est-ce que… des jouets ?!');const ow=QM.A[f.own];if(ow&&ow.cls==='toy'&&ow.cd.toys>0)ow.cd.toys=Math.max(0,ow.cd.toys-3);}}}
      f.m.position.set(f.x,Math.abs(Math.sin(QM.clk*18))*.06,f.z);if(f.done)f.m.position.y=-(.5-f.t);}
    else if(f.k==='cart'){if(f.run>0){const st=Math.min(f.run,dt*9);const nx=f.x+f.dx*st,nz=f.z+f.dz*st;if(hit(nx,nz,.45,Z[f.zn]))f.run=0;else{f.x=nx;f.z=nz;f.run-=st;f.m.position.set(f.x,0,f.z);}}
      if(!(QM.mp&&QN.client))QM.H.forEach(function(h){if(h.zn===f.zn&&f.hit.indexOf(h)<0&&Math.hypot(h.x-f.x,h.z-f.z)<1.3){f.hit.push(h);h.stun=3;if(h.tg)qmLose(h,null);if(h.grabT)qmUngrab(h);if(h.zn===cur)say(h.g,'Aïe ! Qui a lancé ce caddie ?!');}});
      if(f.t<.6)f.m.position.y=-(.6-f.t);}
    if(f.t<=0){scene.remove(f.m);QM.FX.splice(i,1);}}}
function qmJam(a){if(a.role!=='imp'||a.out||a.caught>0||QM.paused)return;if(a.cd.jam>0){if(a.human)qmMsg('Recharge : '+Math.ceil(a.cd.jam)+' s');return;}
  if((QM.mp&&QN.client)&&a.human){a.cd.jam=QCFG.cd;qnS('a',{pid:QN.pid,k:'jam'});qmMsg('📡 Brouillage envoyé.','good');return;}
  a.cd.jam=QCFG.cd;let n=0;QM.A.forEach(function(b){if(b.role==='emp'&&!b.out&&b.zn===a.zn){b.jam=5;n++;if(!b.human&&b.zn===cur)say(b.g,'??? Je vois plus rien !');}});
  if(QM.mp&&QN.host)qnS('jam',{ids:QM.A.filter(function(b){return b.remote&&b.jam>4.9;}).map(function(b){return b.id;})});
  qmMsg('📡 Brouillage dans la zone '+QZN[a.zn]+' !','bad',1);if(a.human)qmMsg(n?'📡 '+n+' collègue'+(n>1?'s':'')+' brouillé'+(n>1?'s':'')+' pendant 5 s.':'📡 Personne à brouiller ici.','good');if(QM.me.jam>0&&QM.map){QM.map=false;$('qmMapT').hidden=true;$('qmMapAll').hidden=true;}}
function qmLock(a){if(a.role!=='imp'||a.out||a.caught>0||QM.paused)return;if(a.cd.lock>0){if(a.human)qmMsg('Recharge : '+Math.ceil(a.cd.lock)+' s');return;}
  if((QM.mp&&QN.client)&&a.human){if(!QM.R.some(function(x){return x.zn===cur&&qmRingOn(x)&&!(x.lk>0)&&Math.hypot(x.x-pp.x,x.z-pp.z)<1.4;})){qmMsg('Mets-toi sur un rond de sabotage pour le verrouiller.');return;}a.cd.lock=QCFG.cd;qnS('a',{pid:QN.pid,k:'lock'});qmMsg('🔒 Verrouillé en douce.','good');return;}
  const r=QM.R.find(function(x){return x.zn===a.zn&&qmRingOn(x)&&Math.hypot(x.x-a.x,x.z-a.z)<1.4;});if(!r){if(a.human)qmMsg('Mets-toi sur un rond de sabotage pour le verrouiller.');return;}
  r.lk=30;r.prog=0;a.cd.lock=QCFG.cd;r.m.lb.draw('⚠️ '+r.n+' : en panne',hex6(QRC.rep)+'f2');qmMsg('⚠️ Panne : « '+r.n+' » ('+QZN[r.zn]+') est bloqué 30 s.','bad',1);if(a.human)qmMsg('🔒 Verrouillé en douce.','good');}
function qmAlert(a){if(a.role!=='imp'||a.out||a.caught>0||QM.paused)return;if(a.cd.alert>0){if(a.human)qmMsg('Recharge : '+Math.ceil(a.cd.alert)+' s');return;}
  if((QM.mp&&QN.client)&&a.human){a.cd.alert=QCFG.cd;qnS('a',{pid:QN.pid,k:'alert'});qmMsg('📞 Tu as balancé un collègue à la direction.','good');return;}
  const E=QM.A.filter(function(e){return e!==a&&e.role==='emp'&&!e.out&&e.caught<=0;});if(!E.length)return;
  E.sort(function(p,q){return ((p.zn===a.zn?0:60)+Math.hypot(p.x-a.x,p.z-a.z))-((q.zn===a.zn?0:60)+Math.hypot(q.x-a.x,q.z-a.z));});const v=E[0];
  const H=QM.H.slice().sort(function(p,q){return ((p.zn===v.zn?0:60)+Math.hypot(p.x-v.x,p.z-v.z))-((q.zn===v.zn?0:60)+Math.hypot(q.x-v.x,q.z-v.z));});const h=H[0];
  h.st='alert';h.tg=v;h.gzn=null;h.wait=0;a.cd.alert=QCFG.cd;qmMsg('📞 Quelqu\'un a balancé '+v.name+' à la direction !','bad',1);if(a.human)qmMsg('Tu as envoyé '+(h.dir?'la directrice':h.name)+' sur '+v.name+'.','good');}
/* ---------- deplacements des PNJ (avec changement de zone par les portes) ---------- */
function qmGoal(a,zn,x,z){a.gzn=zn;a.gx=x;a.gz=z;a.path=null;a.pi=0;a.leg=null;}
function qmStep(a,dt,spd){if(a.gzn==null)return true;
  if(a.zn!==a.gzn){if(!a.leg||a.leg.zn!==a.zn){a.leg=qmZoneNext(a.zn,a.gzn,a.hun);a.path=null;}if(!a.leg){a.gzn=a.zn;return true;}
    if(!a.path){a.path=path(Z[a.zn],a.x,a.z,a.leg.x,a.leg.z);a.pi=0;}
    const dn=follow(a,dt,spd);if(dn||Math.hypot(a.x-a.leg.x,a.z-a.leg.z)<.7){a.zn=a.leg.to;a.x=a.leg.tx;a.z=a.leg.tz;a.hd=a.leg.face||0;a.leg=null;a.path=null;}return false;}
  if(!a.path){a.path=path(Z[a.zn],a.x,a.z,a.gx,a.gz);a.pi=0;}
  return follow(a,dt,spd)||Math.hypot(a.x-a.gx,a.z-a.gz)<.3;}
function qmPose(a,dt,mv,run){a.h=angLerp(a.h,a.hd!==undefined?a.hd:a.h,1-Math.exp(-dt*8));a.g.position.set(a.x,0,a.z);a.g.rotation.y=a.h;walkAnim(a.g,a.ph||0,mv?(run?1.5:1):0);}
function qmSees(h,a,R){if(a.zn!==h.zn)return false;const dx=a.x-h.x,dz=a.z-h.z,d=Math.hypot(dx,dz);if(d>R)return false;if(d<1.6)return true;
  if((Math.sin(h.h)*dx+Math.cos(h.h)*dz)/d<=Math.cos(.75))return false;return !blocked(Z[h.zn],h.x,h.z,a.x,a.z);}
function qmLive(a){return !a.out&&a.caught<=0&&!a.cv;}
/* ---------- chasseurs : directrice et managers ---------- */
function qmHuntable(a,h){return qmLive(a)&&!(a.down>0)&&!(a.zomb>0)&&a.imm<=0&&a.inv<=0&&!(a.ultInv>0)&&!(QM.hackT>0)&&!qmDome(a)&&(!a.hide||(h&&a.seenBy===h));}
function qmLose(h,txt){h.st='patrol';h.tg=null;h.gzn=null;h.wait=Math.max(h.wait||0,1.2);h.spot=0;h.ex.visible=false;if(txt&&h.zn===cur)say(h.g,txt);}
function qmUngrab(h){const t=h.grabT;if(t){if(t.remote&&t.grab)qnS('ungrab',{id:t.id});t.grab=null;t.imm=Math.max(t.imm,2);}h.grabT=null;}
function qmHunter(h,dt){const iF=QM.insp>0?1.3:1;if(h.tg&&!h.dir){const tz=h.tg.human?cur:h.tg.zn;if(QSAFE.indexOf(tz)>=0||qmIsAr(tz)||qmIsCv(tz)){qmLose(h,null);h.gzn=null;}}if(h.turnT>0){h.turnT-=dt;if(h.turnT<=0&&!(h.stun>0)&&h.turnTg&&qmHuntable(h.turnTg,h)&&h.turnTg.zn===h.zn){h.tg=h.turnTg;h.spot=.25;h.ex.visible=true;h.hits=0;if(h.zn===cur)say(h.g,'C\'est TOI !');if(h.turnTg.human)qmMsg('❗ '+h.name+' t\'a reconnu : cours !','bad');}}if(h.slow>0)h.slow-=dt;if(h.dark>0)h.dark-=dt;const sF=(h.slow>0?.4:1)*(h.dark>0?.6:1)*iF;h.ex.position.set(h.x,3.55+Math.sin(QM.clk*12)*.05,h.z);h.ex.visible=h.spot>0&&h.zn===cur;
  if(h.stun>0){h.stun-=dt;h.g.rotation.z=Math.sin(QM.clk*8)*.12;qmPose(h,dt,false);if(h.stun<=0)h.g.rotation.z=0;return;}
  if(h.blind>0){h.blind-=dt;qmPose(h,dt,false);return;}
  if(h.wait>0){h.wait-=dt;qmPose(h,dt,false);return;}
  if(QM.decoy>0){if(!h.dg){h.dg=true;qmGoal(h,'store',28,13);}if(!qmStep(h,dt,4.4*sF))qmPose(h,dt,true,true);else qmPose(h,dt,false);return;}
  if(h.st==='decoy'){h.st='patrol';h.gzn=null;h.dg=false;}
  /* il agrippe quelqu'un (managers seulement) */
  if(h.grabT){const t=h.grabT;if(!qmLive(t)||t.zn!==h.zn||!t.grab){qmUngrab(h);qmLose(h,null);return;}
    const d=Math.hypot(t.x-h.x,t.z-h.z);t.grab.t-=dt;
    if(d>1.5){qmUngrab(h);h.st='patrol';h.tg=null;h.gzn=null;h.wait=1;if(h.zn===cur)say(h.g,'Reviens ici !');if(t.human)qmMsg('💨 Tu t\'es dégagé !','good');return;}
    if(t.grab.t<=0){qmUngrab(h);qmCatch(h,t);return;}
    h.path=[[t.x,t.z]];h.pi=0;follow(h,dt,2.2);h.hd=Math.atan2(t.x-h.x,t.z-h.z);qmPose(h,dt,true);return;}
  h.look-=dt;
  /* il vient de repérer quelqu'un : point d'exclamation avant de courir */
  if(h.spot>0){h.spot-=dt;const t=h.tg;if(t)h.hd=Math.atan2(t.x-h.x,t.z-h.z);qmPose(h,dt,false);
    if(!t||!qmHuntable(t,h)||t.zn!==h.zn){qmLose(h,null);return;}if(h.spot<=0){h.ex.visible=false;h.st='chase';h.lost=0;h.rp=0;}return;}
  if(h.st!=='chase'&&h.look<=0){h.look=.15;let best=null,bd=1e9;
    QM.A.forEach(function(a){if(!qmHuntable(a,h)||a.zn!==h.zn)return;const R=(h.dark>0?3:8.5)*iF*(a.cls==='ent'&&!(a.zomb>0)?.62:1);if(!qmSees(h,a,R))return;const d=Math.hypot(a.x-h.x,a.z-h.z)-(h.tg===a?5:0);if(d<bd){bd=d;best=a;}});
    if(best){h.tg=best;h.spot=QCFG.react;h.ex.visible=true;if(h.zn===cur)say(h.g,h.dir?['TOI ! Viens ici !','Je t\'ai vu !','Halte !'][(Math.random()*3)|0]:['Hé ! Stop !','Reviens ici !','Je te tiens !'][(Math.random()*3)|0]);if(best.human)qmMsg('❗ '+(h.dir?'La directrice':h.name)+' t\'a repéré : cours !','bad');return;}}
  if(h.st==='chase'){const t=h.tg;
    if(!t||!qmHuntable(t,h)||t.zn!==h.zn){qmLose(h,null);qmPose(h,dt,false);return;}
    const d=Math.hypot(t.x-h.x,t.z-h.z);if(qmSees(h,t,15))h.lost=0;else{h.lost+=dt;if(h.lost>3){qmLose(h,'Il m\'a semé…');qmPose(h,dt,false);return;}}
    h.rp-=dt;if(h.rp<=0||!h.path||h.pi>=h.path.length){h.rp=.4;h.path=path(Z[h.zn],h.x,h.z,t.x,t.z);h.pi=0;}
    follow(h,dt,h.cs*sF);h.hd=Math.atan2(t.x-h.x,t.z-h.z);qmPose(h,dt,true,true);
    if(d<.95){if(h.dir)qmCatch(h,t);else qmHit(h,t);}return;}
  if(h.st==='alert'&&QM.hackT>0){h.st='patrol';h.tg=null;h.gzn=null;}if(h.st==='alert'){const t=h.tg;if(!t||!qmLive(t)){h.st='patrol';h.gzn=null;return;}
    h.rp=(h.rp||0)-dt;if(h.rp<=0||h.gzn==null){h.rp=1;qmGoal(h,t.zn,t.x,t.z);}
    const ar=qmStep(h,dt,4.2*sF);qmPose(h,dt,!ar,true);if(ar){h.st='patrol';h.gzn=null;}return;}
  /* patrouille */
  h.hop-=dt;
  if(h.gzn==null){if(h.hop<=0&&QM.hackT>0)h.hop=2;if(h.hop<=0){h.hop=h.dir?18+Math.random()*14:35+Math.random()*30;const zs=QZ.filter(function(z){return ['store','reserve','office','parking'].indexOf(z)>=0&&!QM.lockZ[z];});if(h.home&&Math.random()<.75){const p=qmRand(h.home);qmGoal(h,h.home,p[0],p[1]);}else{const z=h.dir?zs[(Math.random()*zs.length)|0]:(QZ.filter(function(z2){return QPORT.some(function(q){return q.zn===h.zn&&q.to===z2;});})[0]||h.zn);const nz0=Math.random()<.6?z:zs[(Math.random()*zs.length)|0];const nz=QM.lockZ[nz0]?h.zn:nz0;const p=qmRand(nz);qmGoal(h,nz,p[0],p[1]);}}
    else{const p=qmRand(h.zn);qmGoal(h,h.zn,p[0],p[1]);}}
  if(qmStep(h,dt,h.ps*sF)){h.gzn=null;h.wait=.6+Math.random()*1.6;qmPose(h,dt,false);}else qmPose(h,dt,true);}
function qmCatch(h,t,quiet){if(t.ultInv>0){if(h){qmUngrab(h);qmLose(h,null);}return;}qmUnhide(t);t.down=0;t.rev=0;const jp=QM.jail[(QM.jn=(QM.jn||0)+1)%QM.jail.length];
  if(QM.key.st==='held'&&QM.key.by===t){QM.key={st:'ground',zn:t.zn,x:t.x,z:t.z,room:QM.key.room};qmMsg('🔑 '+t.name+' a lâché la clé en se faisant attraper !','warn');}
  if(h.zn===cur&&!quiet)say(h.g,h.dir?'Dans mon bureau. TOUT DE SUITE.':'Attrapé ! Au bureau !');
  t.grab=null;t.job=null;t.path=null;t.gzn=null;t.st='idle';t.at=null;if(h){h.st='patrol';h.tg=null;h.gzn=null;h.wait=2.5;h.spot=0;h.ex.visible=false;if(h.grabT===t)h.grabT=null;}
  qmCvSend(t);
  QM.A.forEach(function(b){if(b.st==='flee'&&!QM.H.some(function(x){return x.st==='chase'&&x.tg===b;}))b.st='idle';});}
/* ---------- corps a corps : frapper dans le dos, bousculer, frapper clients et fayots ---------- */
function qmMeleeTg(a){const x=a.human?pp.x:a.x,z=a.human?pp.z:a.z,zn=a.human?cur:a.zn;
  const vis=function(tx,tz){return !blocked(Z[zn],x,z,tx,tz);};
  const ch=QM.H.find(function(h){return h.zn===zn&&!(h.stun>0)&&((h.st==='chase'||h.spot>0)&&h.tg===a)&&Math.hypot(h.x-x,h.z-z)<2.3&&vis(h.x,h.z);});if(ch)return {k:'shove',h:ch};
  const B=QM.boss;if(B&&!B.dead&&B.zn===zn&&Math.hypot(B.x-x,B.z-z)<3&&vis(B.x,B.z))return {k:'boss'};
  const c=QM.CE.find(function(n){return n.zn===zn&&!(n.ko>0)&&!(n.gone>0)&&Math.hypot(n.x-x,n.z-z)<2&&vis(n.x,n.z);});if(c)return {k:'cli',n:c};
  const f=QM.FY.find(function(n){return n.zn===zn&&!(n.ko>0)&&Math.hypot(n.x-x,n.z-z)<2&&vis(n.x,n.z);});if(f)return {k:'fay',n:f};
  const bk=QM.H.find(function(h){return h.zn===zn&&!(h.stun>0)&&!h.dir&&Math.hypot(h.x-x,h.z-z)<2&&vis(h.x,h.z)&&!(h.tg===a&&(h.st==='chase'||h.spot>0));});if(bk)return {k:'back',h:bk};return null;}
function qmNoise(a,R){const x=a.human?pp.x:a.x,z=a.human?pp.z:a.z,zn=a.human?cur:a.zn;QM.H.forEach(function(h){if(h.zn===zn&&!(h.stun>0)&&h.st!=='chase'&&Math.hypot(h.x-x,h.z-z)<R){h.st='alert';h.tg=a;h.gzn=null;h.wait=0;if(h.zn===cur)say(h.g,'C\'est quoi ce bruit ?!');}});}
function qmMelee(a){return qmAtk(a);}
function qmMeleeOld(a){if(a.down>0||a.zomb>0||a.caught>0||a.out)return false;const t=qmMeleeTg(a);if(!t)return false;
  if((QM.mp&&QN.client)&&a.human){if(t.k==='shove'&&(a.shCd||0)>0){qmMsg('🛡️ Bousculade en recharge : '+Math.ceil(a.shCd)+' s');return true;}if(t.k==='shove')a.shCd=15;qnS('a',{pid:QN.pid,k:'melee'});qmPunch(a);return true;}
  const x=a.human?pp.x:a.x,z=a.human?pp.z:a.z;qmPunch(a);if(QM.mp&&QN.host&&!a.human)qnS('fx',{id:a.id,k:'punch',zn:a.zn,x:a.x,z:a.z});
  if(t.k==='boss'){qmBossHit(a.cls==='rec'?2:1,a);return true;}
  {const tx=t.h?t.h.x:t.n.x,tz=t.h?t.h.z:t.n.z;if((a.human?cur:a.zn)===cur)qmPow(tx,tz,t.k==='shove'?'BOUM !':'POW !');if(t.n&&t.k!=='shove'){const d=Math.max(.3,Math.hypot(tx-x,tz-z));for(const L of [1.2,.8,.4]){const nx=tx+(tx-x)/d*L,nz=tz+(tz-z)/d*L;if(!hit(nx,nz,.35,Z[a.human?cur:a.zn])){t.n.x=nx;t.n.z=nz;break;}}}}
  if(t.k==='shove'){if((a.shCd||0)>0){if(a.human)qmMsg('🛡️ Bousculade en recharge : '+Math.ceil(a.shCd)+' s');return true;}a.shCd=15;const h=t.h,d=Math.max(.3,Math.hypot(h.x-x,h.z-z)),ux=(h.x-x)/d,uz=(h.z-z)/d;for(const L of [2,1.6,1.2,.8,.5]){const nx=h.x+ux*L,nz=h.z+uz*L;if(!hit(nx,nz,.4,Z[h.zn])){h.x=nx;h.z=nz;break;}}h.path=null;h.stun=Math.max(h.stun||0,1);qmPts(a,1,'mgr');
    if(h.zn===cur)say(h.g,'Hé ! Ne me bouscule pas !');if(a.human)qmMsg('🛡️ Bousculé ! File, il revient dans 1 s.','good');return true;}
  if(t.k==='back'){const h=t.h;h.hits=(QM.clk-(h.hitT||-9)<1.3?(h.hits||0):0)+(QWP[a.wp]?(QWP[a.wp].m>=3?3:QWP[a.wp].m>=2?2:1):1);h.hitT=QM.clk;h.hd=Math.atan2(x-h.x,z-h.z);
    if(h.hits>=3){h.hits=0;h.stun=5;h.turnT=0;qmPts(a,3,'mgr');if(h.tg)qmLose(h,null);if(h.zn===cur)say(h.g,'Ouille… 💫');if(a.human)qmMsg('🤜 '+h.name+' est KO pendant 5 s !','good');qmNoise(a,8);}
    else{h.turnT=1.3;h.turnTg=a;h.wait=Math.max(h.wait||0,.3);if(h.zn===cur)say(h.g,h.hits===1?'Hein ?!':'Aïe !');if(a.human)qmMsg('🤜 Coup '+h.hits+'/3 : vite, encore !','good');}return true;}
  const n=t.n,need=t.k==='cli'||a.wp?1:(a.cls==='sec'&&!(a.zomb>0)?1:2);n.hits=(QM.clk-(n.hitT||-9)<2.5?(n.hits||0):0)+1;n.hitT=QM.clk;
  if(n.hits>=need){n.hits=0;n.ko=t.k==='fay'?8:1.5;if(t.k!=='fay')n.van=1;qmPts(a,1,'mgr');if(a.human)qmMsg(t.k==='fay'?'👊 Le fayot est KO : il ne balancera personne pendant 8 s.':'👊 Client énervé KO : il file se plaindre ailleurs !','good');if(t.k==='fay')qmNoise(a,10);}else if(a.human)qmMsg('🤜 Encore un coup !','good');return true;}
function qmPunch(a){const g=a.human?pl:a.g;if(!g||!g.userData)return;g.userData.push=true;clearTimeout(a._pt);a._pt=setTimeout(function(){g.userData.push=false;},220);
  const x=a.human?pp.x:a.x,z=a.human?pp.z:a.z,f=a.human?pp.face:a.h,zn=a.human?cur:a.zn;if(zn!==cur)return;
  const m=new T.Mesh(new T.RingGeometry(1.1,2.3,22,1,-.9,1.8),new T.MeshBasicMaterial({color:0xffffff,transparent:true,opacity:.75,depthWrite:false,side:T.DoubleSide}));m.rotation.x=-Math.PI/2;m.rotation.z=Math.atan2(-Math.cos(f),Math.sin(f));m.position.set(x,1.0,z);scene.add(m);QM.FX.push({zn:zn,m:m,t:.22,k:'swing'});
  if(a.human){qmThud(.6);QM.shake=.18;}}
function qmPow(x,z,txt){const sp=label(txt,{sx:2.4,sy:1.1,w:240,h:110,size:64,bg:'rgba(255,214,0,.97)',fg:'#c0262d'});sp.position.set(x,2.8,z);scene.add(sp);QM.FX.push({zn:cur,m:sp,t:.55,k:'pow'});qmThud(1);}
function qmThud(v){try{const ac=QM.ac||(QM.ac=new (window.AudioContext||window.webkitAudioContext)());const len=Math.floor(ac.sampleRate*.12),buf=ac.createBuffer(1,len,ac.sampleRate),d=buf.getChannelData(0);for(let i=0;i<len;i++)d[i]=(Math.random()*2-1)*Math.pow(1-i/len,3);
  const src=ac.createBufferSource();src.buffer=buf;const lp=ac.createBiquadFilter();lp.type='lowpass';lp.frequency.value=900;const g=ac.createGain();g.gain.value=.35*v;src.connect(lp);lp.connect(g);g.connect(ac.destination);src.start();
  const o=ac.createOscillator(),g2=ac.createGain();o.type='sine';o.frequency.setValueAtTime(140,ac.currentTime);o.frequency.exponentialRampToValueAtTime(50,ac.currentTime+.12);g2.gain.setValueAtTime(.3*v,ac.currentTime);g2.gain.exponentialRampToValueAtTime(.0001,ac.currentTime+.15);o.connect(g2);g2.connect(ac.destination);o.start();o.stop(ac.currentTime+.16);}catch(_){}}
function qmCliMake(id,zn,x,z,ty,tmp){const lk={shirt:[0xd94841,0x3b82f6,0xf59e0b,0x10b981,0x8b5cf6][id%5],pants:0x334155,hair:[0x2b1d14,0xc9a227,0x1b1b1b,0x6b3a2a][id%4],fem:id%2===1,hs:id%2?'long':'court'};const g=makeChar(lk);if(ty===2)g.traverse(function(o){if(o.material&&o.material.color&&o.material.color.getHex&&(o.material.color.getHex()===0xf2c9a0||o.material.color.getHex()===0xe8b48a||o.material.color.getHex()===0xd9a37a))o.material=o.material.clone(),o.material.color.setHex(0x8fbf7a);});scene.add(g);
  const n={g:g,zn:zn,x:x,z:z,ko:0,cd:0,hits:0,ci:id,cid:id,ang:1,ty:ty,tmp:tmp,ph:0,bub:label(ty===2?'🧟':'😠',{sx:.75,sy:.75,w:96,h:96,size:66,bg:ty===2?'rgba(46,140,70,.92)':'rgba(229,72,77,.92)'})};scene.add(n.bub);QM.CE.push(n);return n;}
function qmCliDel(n){scene.remove(n.g);scene.remove(n.bub);const i=QM.CE.indexOf(n);if(i>=0)QM.CE.splice(i,1);}
/* clients enerves (magasin) et collegues fayots (reserve, bureaux) */
function qmFoes(dt){const host=!(QM.mp&&QN.client);
  for(let ci=QM.CE.length-1;ci>=0;ci--){const n=QM.CE[ci];
    if(n.gone>0){n.g.visible=false;n.bub.visible=false;if(host){n.gone-=dt;if(n.gone<=0){n.gone=0;let p=null;for(let t=0;t<14&&!p;t++){const q=qmRand(n.zn);if(QM.A.every(function(a){const P=a.human?[pp.x,pp.z,cur]:[a.x,a.z,a.zn];return P[2]!==n.zn||Math.hypot(P[0]-q[0],P[1]-q[1])>15;}))p=q;}p=p||qmRand(n.zn);n.x=p[0];n.z=p[1];n.path=null;n.chase=0;n.hits=0;n.g.rotation.z=0;n.g.visible=true;n.g.position.set(n.x,0,n.z);}}continue;}
    if(n.tmp!==undefined&&host){n.tmp-=dt;if(n.tmp<=0){qmCliDel(n);continue;}}if(n.tmp!==undefined)n.g.visible=n.zn===cur&&!QM.cine;
    n.bub.visible=n.zn===cur&&!QM.map&&!QM.cine;n.bub.position.set(n.x,2.75+Math.sin(QM.clk*5+n.ci)*.08,n.z);n.bub.material.opacity=n.ko>0?.35:1;n.bub.scale.setScalar(n.wind>0?1.25+Math.sin(QM.clk*30)*.15:.75);
    if(n.ko>0){n.ko-=dt;if(n.van){n.g.rotation.z=Math.min(1.4,(n.g.rotation.z||0)+dt*4);}else n.g.rotation.z=Math.sin(QM.clk*7)*.15;walkAnim(n.g,0,0);n.g.position.set(n.x,0,n.z);if(n.ko<=0){n.g.rotation.z=0;if(n.van&&host){n.van=0;n.gone=12+Math.random()*6;if(n.zn===cur)qmPow(n.x,n.z,'💨');}}continue;}
    if(!host){continue;}
    if(n.cd>0)n.cd-=dt;
    let tg=null,bd=n.ty===2?9:6;QM.A.forEach(function(a){const x=a.human?pp.x:a.x,z=a.human?pp.z:a.z,zn=a.human?cur:a.zn;if(zn!==n.zn||!qmLive(a)||a.down>0||a.zomb>0||a.hide||a.inv>0)return;const d=Math.hypot(x-n.x,z-n.z);if(d<bd){bd=d;tg=a;}});
    if(tg){const x=tg.human?pp.x:tg.x,z=tg.human?pp.z:tg.z;n.chase=1;n.rp=(n.rp||0)-dt;if(blocked(Z[n.zn],n.x,n.z,x,z)){if(n.rp<=0||!n.path||n.pi>=n.path.length){n.path=path(Z[n.zn],n.x,n.z,x,z);n.pi=0;n.rp=.6;}}else{n.path=[[x,z]];n.pi=0;}follow(n,dt,n.ty===2?1.9:2.3);n.g.rotation.y=angLerp(n.g.rotation.y,Math.atan2(x-n.x,z-n.z),.25);n.ph+=dt*9;walkAnim(n.g,n.ph,1.2);n.g.position.set(n.x,0,n.z);
      if(bd<1.7&&n.cd<=0&&!(n.wind>0)){n.wind=.6;n.wtg=tg;if(n.zn===cur)say(n.g,n.ty===2?'Grrr…':'❗');}
      if(n.wind>0){n.wind-=dt;if(n.wind<=0){const xx=tg.human?pp.x:tg.x,zz=tg.human?pp.z:tg.z;if(Math.hypot(xx-n.x,zz-n.z)<1.25)n.go=1;else n.cd=1;}}
      if(n.go&&n.cd<=0){n.go=0;n.cd=3;qmHurt(tg,1);if(!(tg.cls==='sec'&&!(tg.zomb>0))){tg.slowT=2;if(tg.remote)qnS('slow',{id:tg.id,t:2});}if(tg.human)qmMsg('😠 Un client énervé t\'agrippe : −¼ de cœur'+(tg.cls==='sec'?'':' et tu es ralenti'),'bad');if(n.zn===cur&&n.ty!==2)say(n.g,['C\'est où le rayon des pâtes ?!','Je veux voir un responsable !','Vous allez m\'entendre !'][(Math.random()*3)|0]);}}
    else if(n.chase){n.chase=0;n.path=null;}
    if(n.tmp!==undefined&&!n.chase){n.ph+=0;walkAnim(n.g,0,0);n.g.position.set(n.x,0,n.z);}}
  QM.FY.forEach(function(f){const v=(f.zn===cur||QM.map)&&!QM.cine;f.g.visible=v;
    if(f.ko>0){f.ko-=dt;f.g.rotation.z=Math.sin(QM.clk*7)*.15;walkAnim(f.g,0,0);f.g.position.set(f.x,0,f.z);if(f.ko<=0)f.g.rotation.z=0;return;}
    if(!host){const dx=(f.tx===undefined?f.x:f.tx)-f.x,dz=(f.tz===undefined?f.z:f.tz)-f.z,d=Math.hypot(dx,dz);if(d>4){f.x=f.tx;f.z=f.tz;}else if(d>.01){const st=Math.min(d,dt*3);f.x+=dx/d*st;f.z+=dz/d*st;}f.h=angLerp(f.h,f.th||0,.2);f.ph+=d>.03?dt*7:0;f.g.position.set(f.x,0,f.z);f.g.rotation.y=f.h;walkAnim(f.g,f.ph,d>.03?1:0);return;}
    if(f.cd>0)f.cd-=dt;
    if(f.cd<=0){const sn=QM.A.find(function(a){const x=a.human?pp.x:a.x,z=a.human?pp.z:a.z,zn=a.human?cur:a.zn;return zn===f.zn&&qmLive(a)&&!a.hide&&!(a.inv>0)&&a.at&&a.at.m&&Math.hypot(x-f.x,z-f.z)<8&&!blocked(Z[f.zn],f.x,f.z,x,z);});
      if(sn){f.cd=20;let best=null,bd=1e9;QM.H.forEach(function(h){if(h.dir||h.stun>0)return;const d=(h.zn===f.zn?0:60)+Math.hypot(h.x-f.x,h.z-f.z);if(d<bd){bd=d;best=h;}});
        if(best){best.st='alert';best.tg=sn;best.gzn=null;best.wait=0;}if(f.zn===cur)say(f.g,'CHEEEF ! Il y en a un qui sabote ici !');qmMsg('🙄 Un fayot a balancé '+sn.name+' : un manager arrive !','bad',1);
        if(sn.human)qmMsg('🙄 Le fayot t\'a vu : un manager arrive ! Mets-le KO (2 coups) ou file.','bad');}}
    if(f.wait>0){f.wait-=dt;walkAnim(f.g,0,0);f.g.position.set(f.x,0,f.z);f.g.rotation.y=f.h;return;}
    if(f.gzn==null){const p=qmRand(f.zn);qmGoal(f,f.zn,p[0],p[1]);}
    if(qmStep(f,dt,1.5)){f.gzn=null;f.wait=2+Math.random()*4;}f.h=angLerp(f.h,f.hd||0,.15);f.ph+=dt*6;walkAnim(f.g,f.ph,1);f.g.position.set(f.x,0,f.z);f.g.rotation.y=f.h;});}
/* ---------- coeurs, a terre, zombie ---------- */
function qmHurt(a,q){if(a.ultInv>0)return;if(a.down>0||a.zomb>0||a.caught>0||a.out)return;a.hp=Math.max(0,a.hp-q);if(a.hp<=0)qmDown(a);else if(a.human)qmMsg('💔 Tu perds '+(q>=4?Math.round(q/4)+' cœur'+(q>=8?'s':''):'un quart de cœur')+' !','bad');}
function qmHit(h,t){qmUnhide(t);const ang=Math.atan2(t.x-h.x,t.z-h.z),kx=Math.sin(ang)*1.6,kz=Math.cos(ang)*1.6;
  if(h.zn===cur)say(h.g,['Au travail !','Je t\'ai eu !','Tu vas voir !'][(Math.random()*3)|0]);
  qmHurt(t,QCFG.mgrDmg);t.imm=2.5;qmLose(h,null);h.wait=1.4;
  const Zn=Z[t.zn],nx=t.x+kx,nz=t.z+kz;
  if(t.human){if(!hit(nx,nz,.38,Zn)){pp.x=nx;pp.z=nz;}}else if(t.remote){qnS('hit',{id:t.id,kx:kx,kz:kz,q:QCFG.mgrDmg});}else if(!hit(nx,nz,.38,Zn)){t.x=nx;t.z=nz;t.path=null;}
  if(!t.human&&t.hp>0&&t.zn===cur)say(t.g,'Aïe !');}
function qmDown(a){if(QM.key.st==='held'&&QM.key.by===a){QM.key={st:'ground',zn:a.zn,x:a.x,z:a.z,room:QM.key.room};}a.hp=0;a.down=QCFG.downT;a.rev=0;a.job=null;a.at=null;a.gzn=null;a.path=null;qmUnhide(a);QM.H.forEach(function(h){if(h.tg===a)qmLose(h,null);});
  if(a.human)qmMsg('🆘 Tu es à terre ! Un collègue doit venir te relever (3 s à côté de toi).','bad');qmMsg('🆘 '+a.name+' est à terre ('+QZN[a.zn]+') : va le relever !','warn',1);}
function qmZombEnd(a,how){a.zomb=0;a.cure=0;a.hp=a.hpMax;a.imm=3;if(a.human)qmMsg(how==='auto'?'✨ L\'effet zombie est passé : tu redeviens normal.':'🩺 Soigné ! Tu redeviens normal.','good');else if(how==='inf')qmMsg('🩺 '+a.name+' a été soigné à l\'infirmerie.','good',1);}
function qmGrowl(a){const zh=QM.H.filter(function(h){return h.zn===a.zn&&!h.dir&&h.st!=='chase'&&!(h.stun>0)&&Math.hypot(h.x-a.x,h.z-a.z)<30;});
  zh.forEach(function(h){h.st='alert';h.tg=a;h.gzn=null;h.wait=0;});
  if(a.zn===cur){say(a.g,'GRRRAAAOOO…');qmGrr();}
  if(a.human)qmMsg('🧟 Tu grognes'+(zh.length?' : '+zh.length+' manager'+(zh.length>1?'s arrivent':' arrive')+' !':'…'),'warn');
  else if(a.zn===cur)qmMsg('🧟 '+a.name+' grogne : les managers arrivent par ici !','warn');
  if(QM.mp&&QN.host)QM.A.forEach(function(b){if(b.remote&&b.zn===a.zn&&b!==a)qnS('msg',{t:'🧟 '+a.name+' grogne : les managers arrivent par ici !',k:'warn'});});}
function qmGrr(){try{const ac=QM.ac||(QM.ac=new (window.AudioContext||window.webkitAudioContext)());const t0=ac.currentTime,D=1.5+Math.random()*.5;
  const len=Math.floor(ac.sampleRate*D),buf=ac.createBuffer(1,len,ac.sampleRate),d=buf.getChannelData(0);let last=0;for(let i=0;i<len;i++){last=last*.6+(Math.random()*2-1)*.4;d[i]=last;}
  const src=ac.createBufferSource();src.buffer=buf;const out=ac.createGain();out.gain.setValueAtTime(.0001,t0);out.gain.linearRampToValueAtTime(.55,t0+.18);out.gain.linearRampToValueAtTime(.4,t0+D*.6);out.gain.exponentialRampToValueAtTime(.0001,t0+D);out.connect(ac.destination);
  [[420,6,.9],[950,7,.5],[2300,9,.15]].forEach(function(f){const bp=ac.createBiquadFilter();bp.type='bandpass';bp.Q.value=f[1];bp.frequency.setValueAtTime(f[0]*1.15,t0);bp.frequency.linearRampToValueAtTime(f[0]*.8,t0+D);const g=ac.createGain();g.gain.value=f[2];src.connect(bp);bp.connect(g);g.connect(out);});
  const o=ac.createOscillator();o.type='sawtooth';o.frequency.setValueAtTime(92,t0);o.frequency.linearRampToValueAtTime(68,t0+D);const vib=ac.createOscillator(),vg=ac.createGain();vib.frequency.value=23;vg.gain.value=9;vib.connect(vg);vg.connect(o.frequency);
  const lp=ac.createBiquadFilter();lp.type='lowpass';lp.frequency.value=650;lp.Q.value=4;const og=ac.createGain();og.gain.value=.5;const am=ac.createOscillator(),ag=ac.createGain();am.frequency.value=13;ag.gain.value=.35;am.connect(ag);ag.connect(og.gain);
  o.connect(lp);lp.connect(og);og.connect(out);src.start(t0);o.start(t0);vib.start(t0);am.start(t0);src.stop(t0+D);o.stop(t0+D);vib.stop(t0+D);am.stop(t0+D);}catch(_){}}
/* etats (hote ou solo) : relever, delai a terre, zombie, infirmerie, grognement */
function qmStates(dt){const dirH=QM.H.find(function(h){return h.dir;});
  QM.A.forEach(function(a){if(a.out||a.caught>0)return;
    if(a.down>0){const hl=QM.A.filter(function(b){return b!==a&&qmLive(b)&&!(b.down>0)&&!(b.zomb>0)&&b.zn===a.zn&&Math.hypot(b.x-a.x,b.z-a.z)<1.4;});
      if(hl.length){a.rev+=dt/(hl.some(function(b){return b.cls==='sst';})?1:QCFG.revT);if(a.rev>=1){a.down=0;a.rev=0;a.hp=4;a.imm=3;qmPts(hl[0],5,'rev');qmMsg('💪 '+hl[0].name+' a relevé '+a.name+' !','good',1);if(a.human)qmMsg('💪 Relevé par '+hl[0].name+' ! Il te reste 1 cœur.','good');return;}}else a.rev=Math.max(0,a.rev-dt);
      a.down-=dt;if(qmIsAr(a.zn)&&a.down<1)a.down=1;if(a.down<=0){a.down=0;a.rev=0;qmMsg('🚑 Personne n\'est venu : '+a.name+' est emmené au bureau de la directrice.','warn',1);qmCatch(dirH,a,1);}return;}
    if(a.zomb>0){a.zomb-=dt;if(a.zomb<=0){qmZombEnd(a,'auto');return;}
      {const sst=QM.A.find(function(b){return b!==a&&b.cls==='sst'&&qmLive(b)&&!(b.down>0)&&!(b.zomb>0)&&b.zn===a.zn&&Math.hypot(b.x-a.x,b.z-a.z)<1.4;}),inf=a.zn===QM.inf.zn&&Math.hypot(a.x-QM.inf.x,a.z-QM.inf.z)<1.5;
        if(sst||inf){a.cure+=dt/(sst?3:QCFG.cureT);if(a.cure>=1){qmZombEnd(a,sst?'sst':'inf');if(sst)qmMsg('💚 '+sst.name+' a soigné '+a.name+' !','good',1);return;}}else a.cure=0;}
      a.gr-=dt;if(a.gr<=0){a.gr=QCFG.growl;qmGrowl(a);}}});}
/* posture : a quatre pattes, ou bras tendus du zombie */
function qmBody(g,a,dt){const u=g.userData;if(!u||!u.m)return;
  if(a.down>0&&!(a.caught>0)){u.m.rotation.x=1.2;u.m.position.y=.32;u.arms[0].rotation.x=u.arms[1].rotation.x=-1.25+Math.sin(QM.clk*6)*.12;}
  else{if(u.m.rotation.x)u.m.rotation.x=0;if(a.zomb>0&&!(a.caught>0)){u.arms[0].rotation.x=-1.45+Math.sin(QM.clk*3)*.08;u.arms[1].rotation.x=-1.45-Math.sin(QM.clk*3)*.08;u.m.rotation.z=Math.sin(QM.clk*2.2)*.06;}else if(u.m.rotation.z)u.m.rotation.z=0;}}
function qmTags(){QM.A.forEach(function(a){const t=a.tag;if(!t)return;const v=!a.out&&!a.hide&&!QM.cine&&(a.zn===cur||QM.map)&&(a.down>0||a.zomb>0)&&!(a.caught>0);t.sp.visible=v;if(!v)return;
  const x=a.human?pp.x:a.x,z=a.human?pp.z:a.z;t.sp.position.set(x,QM.map?6:3.35,z);
  if(a.down>0)t.draw('🆘 '+a.name+' · '+Math.ceil(a.down)+' s'+(a.rev>0?' · '+Math.round(a.rev*100)+' %':''),'rgba(229,72,77,.95)');
  else{const s=Math.ceil(a.zomb);t.draw('🧟 '+a.name+' · '+Math.floor(s/60)+':'+String(s%60).padStart(2,'0'),'rgba(46,140,70,.95)');}});}
function qmPlayerTo(zn,x,z){fading=true;$('fade').classList.add('on');setTimeout(function(){cur=zn;pp.x=x;pp.z=z;QM.armed=false;camPos.set(pp.x,CAMH,pp.z+CAMZ);camLook.set(pp.x,.4,pp.z-.6);$('fade').classList.remove('on');setTimeout(function(){fading=false;},220);},280);}
function qmRelease(a){a.caught=0;a.imm=3;a.grab=null;a.down=0;a.hp=a.hpMax;a.zomb=QCFG.zombT;a.gr=QCFG.growl*.5;a.cure=0;if(a.g.userData)a.g.userData.cuff=false;const ex=QM.exit;a.zn='office';a.x=ex[0]+(Math.random()-.5)*1.2;a.z=ex[1]+Math.random()*.6;a.path=null;a.gzn=null;QM.doorT=1.6;try{dirDoor.visible=false;}catch(_){}
  if(a.human){pp.x=a.x;pp.z=a.z;pp.face=0;qmBig('🧟 Tu es ZOMBIE pendant 1 min 30','zomb');qmMsg('🧟 Zombie : personne ne peut t\'attraper, tu casses 2 fois plus vite, mais pas de pouvoir ni de missions d\'équipe. Tu grognes (ça attire les managers). L\'infirmerie (Labo boulangerie) te soigne.','warn');}else qmMsg('🧟 '+a.name+' sort du bureau de la directrice… en zombie !','warn');}
function qmHideIn(a,hs){if(hs.occ||a.hide)return false;hs.occ=a;a.hide=hs;a.at=null;a.x=hs.x;a.z=hs.z;a.seenBy=null;
  QM.H.forEach(function(h){if((h.tg===a)&&(h.st==='chase'||h.spot>0)&&Math.hypot(h.x-a.x,h.z-a.z)<5&&qmSees(h,a,5)){a.seenBy=h;}});
  QM.H.forEach(function(h){if(h.tg===a&&h!==a.seenBy)qmLose(h,['Il est passé où ?','Mais… il a disparu !','Bizarre…'][(Math.random()*3)|0]);});
  if(a.remote&&a.seenBy)qnS('seen',{id:a.id,n:a.seenBy.dir?'La directrice':a.seenBy.name});
  if(a.human){if(a.seenBy)qmMsg('😬 '+(a.seenBy.dir?'La directrice':a.seenBy.name)+' t\'a vu te cacher !','bad');else qmMsg('👀 Caché ! Bouge pour sortir.','good');}return true;}
function qmUnhide(a){if(!a.hide)return;a.hide.occ=null;a.hide=null;a.seenBy=null;}
/* ---------- employes PNJ (et managers infiltres PNJ) ---------- */
function qmCanDo(a,r){if(!qmRingOn(r)||r.lk>0)return false;if(r.own!==undefined&&r.own!==a.id)return false;if(a.zomb>0&&r.k!=='mini'&&r.k!=='solo')return false;if(r.k==='spec')return a.cls==='ele';return true;}
function qmPickJob(a){const imp=a.role==='imp';
  if(imp&&QM.REP.length&&Math.random()<.55){const L=QM.REP.slice().sort(function(p,q){return ((p.zn===a.zn?0:25)+Math.hypot(p.x-a.x,p.z-a.z))-((q.zn===a.zn?0:25)+Math.hypot(q.x-a.x,q.z-a.z));});return {r:L[0],rep:1};}
  let best=null,bs=1e9;QM.R.forEach(function(r){if(!qmCanDo(a,r))return;if(a.avoid&&a.avoid[r.id]>QM.clk)return;
    let s=(r.zn===a.zn?0:28)+Math.hypot(r.x-a.x,r.z-a.z)+Math.random()*14-(r.qa?(r.own===a.id?30:18):0);
    const here=QM.A.filter(function(b){return b!==a&&b.job&&b.job.r===r;}).length;
    if(r.k==='team'||r.duo){const nd=r.duo?2:r.need;if(here>0&&here<nd)s-=30;else if(here>=nd)s+=40;else s+=6;}
    else if(r.k==='team'){if(here>0&&here<r.need)s-=30;else if(here>=r.need)s+=40;else s+=6;}
    else if(r.k==='pair'){const o=QM.R.find(function(x){return x.id===r.pair;});const oh=QM.A.some(function(b){return b.job&&b.job.r===o;})||(QM.me.at===o);if(here>0)s+=45;else if(oh)s-=26;else s+=8;}
    else if(here>0)s+=40;
    if(QM.me.at===r&&r.k==='team')s-=40;
    if(s<bs){bs=s;best=r;}});
  return best?{r:best}:null;}
function qmSlot(a,r){const ang=(a.id*2.1)%6.28,R=.85;const x=r.x+Math.cos(ang)*R,z=r.z+Math.sin(ang)*R;return hit(x,z,.35,Z[r.zn])?[r.x,r.z]:[x,z];}
function qmBot(a,dt){
  if(a.out)return;
  if(a.cv){a.hd=a.h+Math.sin(QM.clk*.7+a.id)*.8;qmPose(a,dt,false);return;}
  if(qmIsAr(a.zn)){qmArenaBot(a,dt);return;}
  if(a.job&&a.job.free){const ar=qmStep(a,dt,4.2);qmPose(a,dt,!ar,true);return;}
  if(a.caught>0){a.caught-=dt;a.g.userData.cuff=true;qmPose(a,dt,false);if(a.caught<=0)qmRelease(a);return;}
  if(a.down>0){a.at=null;qmPose(a,dt,false);qmBody(a.g,a,dt);return;}
  if(!(a.zomb>0)){const dn=QM.A.filter(function(b){return b!==a&&(b.down>0||(a.cls==='sst'&&b.zomb>0&&b.zomb<80))&&!(b.caught>0)&&!b.out;}).sort(function(p,q){return ((p.zn===a.zn?0:40)+Math.hypot(p.x-a.x,p.z-a.z))-((q.zn===a.zn?0:40)+Math.hypot(q.x-a.x,q.z-a.z));})[0];
    const thr=QM.H.some(function(h){return (h.st==='chase'||h.spot>0)&&h.tg===a;});
    if(dn&&!thr&&(dn.zn===a.zn?Math.hypot(dn.x-a.x,dn.z-a.z)<28:(dn.down>12||dn.zomb>20))&&!QM.A.some(function(b){return b!==a&&b.revGo===dn&&!(dn.zomb>0)&&Math.hypot(b.x-dn.x,b.z-dn.z)<Math.hypot(a.x-dn.x,a.z-dn.z);})){a.revGo=dn;a.job=null;a.at=null;
      if(a.gzn!==dn.zn||Math.hypot((a.gx||0)-dn.x,(a.gz||0)-dn.z)>.6)qmGoal(a,dn.zn,dn.x+.5,dn.z+.3);const ar=qmStep(a,dt,4.6);a.hd=Math.atan2(dn.x-a.x,dn.z-a.z);qmPose(a,dt,!ar,true);qmBody(a.g,a,dt);if(ar&&a.zn===dn.zn&&Math.hypot(dn.x-a.x,dn.z-a.z)<1.3&&a.zn===cur&&Math.random()<.01)say(a.g,'Tiens bon !');return;}
    a.revGo=null;}
  a.g.userData.cuff=false;if(a.hcd>0)a.hcd-=dt;
  if(a.hide){a.hideT-=dt;qmPose(a,dt,false);if(a.hideT<=0&&!QM.H.some(function(h){return h.zn===a.zn&&Math.hypot(h.x-a.x,h.z-a.z)<6;})){qmUnhide(a);a.st='idle';a.imm=Math.max(a.imm,.5);}else if(!a.seenBy||a.seenBy.tg!==a)return;}
  const th=QM.H.find(function(h){return (h.st==='chase'||h.spot>0)&&h.tg===a||h.grabT===a;});
  if(a.jam>0&&!th){a.at=null;qmPose(a,dt,false);return;}
  if(th){if((a.shCd||0)<=0&&Math.random()<.35&&Math.hypot(th.x-a.x,th.z-a.z)<1.7)qmMelee(a);a.job=null;a.at=null;const pk=a.pw[0];
    {const dd=Math.hypot(th.x-a.x,th.z-a.z);if(QACT.indexOf(pk)>=0&&pk!=='portal'&&a.cd[pk]<=0&&!(a.zomb>0)&&(pk!=='info'||Math.random()<.03)&&(pk!=='kit'||a.hp<a.hpMax)&&(pk!=='hype'||Math.random()<.02)&&(pk!=='taser'||dd<9)&&(pk!=='toys'||dd<12)&&(pk!=='blackout'||dd<9)&&(pk!=='cart'||dd<9)){a.h=Math.atan2(th.x-a.x,th.z-a.z);qmUsePow(a,pk);}}
    if(a.hide){qmUnhide(a);}
    if(!a.hide&&(a.hcd||0)<=0&&QM.HS){const hs=QM.HS.find(function(x){return x.zn===a.zn&&!x.occ&&Math.hypot(x.x-a.x,x.z-a.z)<7&&Math.hypot(x.x-th.x,x.z-th.z)>Math.hypot(x.x-a.x,x.z-a.z);});if(hs){a.st='hideGo';a.hgo=hs;}}
    if(a.st==='hideGo'&&a.hgo){const hs=a.hgo;if(hs.occ){a.st='idle';a.hgo=null;}else{if(a.gzn!==hs.zn||Math.hypot(a.gx-hs.x,a.gz-hs.z)>.3)qmGoal(a,hs.zn,hs.x,hs.z);const ar=qmStep(a,dt,a.grab?2.4:5.0);qmPose(a,dt,!ar,true);if(ar||Math.hypot(a.x-hs.x,a.z-hs.z)<.5){if(qmHideIn(a,hs)){a.hideT=6+Math.random()*5;a.hcd=25;a.st='hidden';}a.hgo=null;}return;}}
    if(a.st!=='flee'||a.gzn==null){a.st='flee';const P=QPORT.filter(function(q){return q.zn===a.zn;});
      if(P.length&&Math.random()<.55){const q=P[(Math.random()*P.length)|0];const p=qmRand(q.to);qmGoal(a,q.to,p[0],p[1]);}
      else{const L=(QPOOL[a.zn]||[]).slice().sort(function(p,q){return Math.hypot(q[0]-th.x,q[1]-th.z)-Math.hypot(p[0]-th.x,p[1]-th.z);});const p=L[(Math.random()*Math.min(3,L.length))|0]||qmRand(a.zn);qmGoal(a,a.zn,p[0],p[1]);}}
    const ar=qmStep(a,dt,(a.grab?(a.grab.luck?5.2:2.4):5.0)*(a.boost>0?1.3:1));if(ar)a.gzn=null;qmPose(a,dt,!ar,true);return;}
  if(a.st==='flee'||a.st==='hideGo'||(a.st==='hidden'&&!a.hide)){a.st='idle';a.gzn=null;a.hgo=null;}
  a.think-=dt;
  /* cle et pupitre */
  if(QM.key.st==='held'&&QM.key.by===a){
    if(a.role==='imp'){a.kt=(a.kt||0)+dt;if(a.kt>35+a.id*3){QM.key={st:'ground',zn:a.zn,x:a.x,z:a.z};a.kt=0;}}
    else{const rm=QM.RM[QM.key.room];if(rm){if(a.gzn!==rm.door.zn||Math.hypot(a.gx-rm.door.x,a.gz-rm.door.z)>1)qmGoal(a,rm.door.zn,rm.door.x,rm.door.z);const ar=qmStep(a,dt,3.8);qmPose(a,dt,!ar,true);return;}}}
  if(QM.key.st==='ground'&&a.role==='emp'&&QM.keyRun===a.id){if(a.gzn!==QM.key.zn||Math.hypot(a.gx-QM.key.x,a.gz-QM.key.z)>.5)qmGoal(a,QM.key.zn,QM.key.x,QM.key.z);const ar=qmStep(a,dt,3.8);qmPose(a,dt,!ar);return;}
  if(!a.job||(!a.job.rep&&!qmCanDo(a,a.job.r))||(a.job.rep&&QM.REP.indexOf(a.job.r)<0)){a.job=qmPickJob(a);a.at=null;a.wt=0;if(a.job){const s=qmSlot(a,a.job.r);qmGoal(a,a.job.r.zn,s[0],s[1]);}}
  {const B=QM.boss;if(B&&!B.dead&&!(a.zomb>0)&&(a.zn==='boulangerie'||QM.stg.i===1)&&!QM.lockZ.boulangerie){if(a.gzn!=='boulangerie'||Math.hypot((a.gx||0)-B.x,(a.gz||0)-B.z)>1.5)qmGoal(a,'boulangerie',B.x+Math.cos(a.id)*1.6,B.z+Math.sin(a.id)*1.6);const ar=qmStep(a,dt,3.6);a.hd=Math.atan2(B.x-a.x,B.z-a.z);qmPose(a,dt,!ar,true);qmBody(a.g,a,dt);if(a.zn==='boulangerie'&&Math.hypot(B.x-a.x,B.z-a.z)<3){a.bt=(a.bt||0)-dt;if(a.bt<=0){a.bt=1.3+Math.random()*.8;qmMelee(a);}}return;}}
  if(!a.job){qmPose(a,dt,false);qmBody(a.g,a,dt);return;}
  const r=a.job.r;
  if(a.zn===r.zn&&Math.hypot(a.x-r.x,a.z-r.z)<1.05){a.at=r;a.wt+=dt;a.hd=Math.atan2(r.x-a.x,r.z-a.z);qmPose(a,dt,false);
    if(!(a.zomb>0)&&a.pw[0]==='kit'&&a.cd.kit<=0&&QM.A.some(function(b){return !b.out&&!(b.down>0)&&!(b.zomb>0)&&b.zn===a.zn&&b.hp<b.hpMax-3&&Math.hypot(b.x-a.x,b.z-a.z)<5;}))qmUsePow(a,'kit');
    if(!(a.zomb>0)&&a.pw[0]==='hype'&&a.cd.hype<=0&&Math.random()<.004)qmUsePow(a,'hype');
    if(!(a.zomb>0)&&a.pw[0]==='shield'&&a.cd.shield<=0&&QM.H.some(function(h){return h.zn===a.zn&&Math.hypot(h.x-a.x,h.z-a.z)<11;}))qmUsePow(a,'shield');
    if(a.role==='imp'&&!a.job.rep&&a.cd.lock<=0&&!(r.lk>0)&&a.wt>1.5&&(r.prog>.15||r.k==='team')&&Math.random()<.02)qmLock(a);
    if(a.role==='imp'&&!a.job.rep&&(r.k==='solo'||r.k==='mini'||r.k==='pair')&&a.wt>3+Math.random()*2){a.avoid=a.avoid||{};a.avoid[r.id]=QM.clk+40;a.job=null;a.at=null;}
    else if((r.k==='team'&&r.cnt<r.need||r.duo&&qmWorkers(r).length<2)&&a.wt>24){a.avoid=a.avoid||{};a.avoid[r.id]=QM.clk+25;a.job=null;a.at=null;}
    else if(r.k==='pair'&&a.wt>20&&!r.both){a.avoid=a.avoid||{};a.avoid[r.id]=QM.clk+25;a.job=null;a.at=null;}
    return;}
  if(a.slowT>0)a.slowT-=dt;if(a.shCd>0)a.shCd-=dt;a.at=null;const ar=qmStep(a,dt,(a.zomb>0?3.2:3.4)*(a.slowT>0?.5:1));if(ar&&!(a.zn===r.zn&&Math.hypot(a.x-r.x,a.z-r.z)<1.05)){const s=qmSlot(a,r);qmGoal(a,r.zn,s[0],s[1]);}qmPose(a,dt,!ar);
  /* l'infiltre PNJ balance parfois un collegue */
  if(a.role==='imp'&&a.cd.jam<=0&&Math.random()<.01&&QM.A.filter(function(e){return e.role==='emp'&&qmLive(e)&&e.zn===a.zn&&Math.hypot(e.x-a.x,e.z-a.z)<12;}).length>=2)qmJam(a);
  if(a.role==='imp'&&a.cd.alert<=0&&QM.A.some(function(e){return e.role==='emp'&&qmLive(e)&&e.zn===a.zn&&Math.hypot(e.x-a.x,e.z-a.z)<12;}))qmAlert(a);}
/* ---------- ronds de sabotage ---------- */
function qmWorkers(r){return QM.A.filter(function(a){return a.at===r&&(r.own===undefined||a.id===r.own)&&qmLive(a)&&!(a.down>0)&&!(a.zomb>0&&r.k!=='mini'&&r.k!=='solo')&&a.zn===r.zn&&Math.hypot((a.human?pp.x:a.x)-r.x,(a.human?pp.z:a.z)-r.z)<QCFG.ringR+.15;});}
function qmMiniPick(){const by={};QM.R.forEach(function(r){if(r.k!=='mini')return;(by[r.zn]=by[r.zn]||[]).push(r);});
  Object.keys(by).forEach(function(zn){const L=by[zn],on=L.filter(function(r){return r.act;}).length;if(on>=6)return;qmShuffle(L.filter(function(r){return !r.act&&!r.used&&!(r.cd>0);})).slice(0,6-on).forEach(function(r){r.act=1;r.dbl=0;r.duo=Math.random()<.2?1:0;r.m.lb.draw(qmRingTxt(r),hex6(QRC[r.k])+'f2');});});}
const QWAVE=[['solo','solo','solo'],['team2','solo','key'],['pair','team2','key'],['team3','solo','key'],['team2','pair','solo']],QWPCT=[15,20,20,20,25];
const QQIC={perso:'★',solo:'🔨',team2:'👥2',team3:'👥3',pair:'🔗',key:'🔑'};
function qmPts(a,n,c){if(!a||(QM.mp&&QN.client)||a.role!=='emp')return;a.pts=(a.pts||0)+n;qmUltGain(a,n);a.sc=a.sc||{sab:0,rev:0,mgr:0};if(c)a.sc[c]=(a.sc[c]||0)+1;}
function qmRingQ(r,k,o){if(r.k0===undefined){r.k0=r.k;r.dur0=r.dur;r.need0=r.need;r.pair0=r.pair;}r.k=k;r.need=o.need||r.need0;r.pair=o.pair||r.pair0;r.dur=o.dur||r.dur0;r.qa=1;r.qn=o.qn;r.own=o.own>=0?o.own:undefined;r.used=1;r.act=0;r.duo=0;r.cd=0;r.prog=0;r.cnt=0;r.done=false;r.m.lb.draw(qmRingTxt(r),hex6(QRC[r.k])+'f2');}
function qmRingFree(r){if(r.k0!==undefined){r.k=r.k0;r.dur=r.dur0;r.need=r.need0;r.pair=r.pair0;}r.qa=0;r.qn=0;r.own=undefined;r.used=0;r.act=0;r.duo=0;r.prog=0;r.cnt=0;r.cd=40;r.m.lb.draw(qmRingTxt(r),hex6(QRC[r.k])+'f2');}
function qmQMine(q){return q.own<0||q.own===QM.me.id;}
function qmBeam(q){const t=qmQTarget(q);if(!t||q.beam)return;const col={team2:0xff9f1c,team3:0xff9f1c,pair:0x4dabf7,key:0xffd21f,perso:0xc77dff}[q.t]||0xff4d6d;
  const b=new T.Mesh(new T.CylinderGeometry(.45,.45,26,12,1,true),new T.MeshBasicMaterial({color:col,transparent:true,opacity:.22,depthWrite:false,side:T.DoubleSide}));scene.add(b);
  const nb=label(QNUM[q.n],{sx:2.2,sy:2.2,w:128,h:128,size:96,bg:'#'+col.toString(16).padStart(6,'0')});scene.add(nb);q.beam=b;q.nb=nb;}
function qmBeamKill(q){if(q.beam){scene.remove(q.beam);scene.remove(q.nb);q.beam=null;q.nb=null;}}
function qmQTarget(q){if(q.t==='key'){const K=QM.key,D=QM.RM[q.room].door;if(K.room!==q.room)return {zn:D.zn,x:D.x,z:D.z};if(K.st==='ground')return {zn:K.zn,x:K.x,z:K.z};return {zn:D.zn,x:D.x,z:D.z};}
  const L=q.ids.map(function(id){return QM.R.find(function(r){return r.id===id;});}).filter(function(r){return r&&!(q.d&&q.d[r.id]);});if(!L.length)return null;let r=L[0];if(L.length>1){r=L.slice().sort(function(a,b){return ((a.zn===cur?0:50)+Math.hypot(a.x-pp.x,a.z-pp.z))-((b.zn===cur?0:50)+Math.hypot(b.x-pp.x,b.z-pp.z));})[0];}return {zn:r.zn,x:r.x,z:r.z};}
function qmQZ(){const u={};QM.QS.forEach(function(q){if(!q.done)(q.zn||'').split('|').forEach(function(z){if(z)u[z]=(u[z]||0)+1;});});return u;}
function qmQFree(f){return QM.R.filter(function(r){return !r.used&&!r.act&&!(r.cd>0)&&!QM.lockZ[r.zn]&&!(r.room&&QM.lockR[r.room])&&f(r);});}
function qmQSolo(ex){let L=qmQFree(function(r){return r.zn!==ex&&(r.k==='solo'||r.k==='mini'||(r.k==='spec'&&QM.A.some(function(a){return a.cls==='ele';})));});if(!L.length)return null;const u=qmQZ();let m=1e9;L.forEach(function(r){m=Math.min(m,u[r.zn]||0);});L=L.filter(function(r){return (u[r.zn]||0)===m;});return L[(Math.random()*L.length)|0];}
function qmQuestNew(kind,own,slot){if(QM.mp&&QN.client)return null;let q=null;
  if(kind==='perso'){const r=qmQSolo();if(r){qmRingQ(r,r.k==='spec'?'spec':'solo',{qn:4,own:own,dur:r.k==='mini'?6:r.dur});q={t:'perso',ids:[r.id],nm:r.n,zn:r.zn};}}
  else{const n=slot+1;const kq=QM.key.st==='none'&&!QM.QS.some(function(x){return x.t==='key';})&&QROOM.some(function(r){return QM.lockR[r.id];});
    const opts=['team2','team2','team3','pair'];if(kq){opts.push('key','key');}const t=opts[(Math.random()*opts.length)|0];
    if(t==='team2'||t==='team3'){const need=t==='team2'?2:3;let L=qmQFree(function(r){return r.k==='team'&&(r.need0||r.need)===need;});let r=L.length&&Math.random()<.6?L[(Math.random()*L.length)|0]:qmQSolo();if(r){qmRingQ(r,'team',{need:need,qn:n,dur:r.k==='team'?r.dur:7+need*2});q={t:t,ids:[r.id],nm:r.n,zn:r.zn};}}
    else if(t==='pair'){let a=null,b=null;const al=qmQFree(function(r){return r.id==='al1';});const a2=QM.R.find(function(r){return r.id==='al2';});if(al.length&&a2&&!a2.used&&Math.random()<.4){a=al[0];b=a2;}else{a=qmQSolo();if(a){b=qmQSolo(a.zn);}}
      if(a&&b){qmRingQ(a,'pair',{pair:b.id,qn:n,dur:6});qmRingQ(b,'pair',{pair:a.id,qn:n,dur:6});q={t:'pair',ids:[a.id,b.id],nm:a.n+' + '+b.n,zn:a.zn+'|'+b.zn};}}
    else if(t==='key'){const L=QROOM.filter(function(r){return QM.lockR[r.id];});const rm=L[(Math.random()*L.length)|0];q={t:'key',ids:[],room:rm.id,nm:'Trouve la clé : '+rm.n,zn:''};qmSpawnKey(rm.id);}
    if(q)q.n=n;}
  if(!q)return null;q.id=++QM.qid;q.own=own>=0?own:-1;if(q.t==='perso')q.n=4;q.d={};q.done=false;q.pct=q.t==='perso'?QCFG.gP:QCFG.gQ*({team3:1.3,pair:1.15}[q.t]||1);QM.QS.push(q);
  if(q.own<0||q.own===QM.me.id)qmMsg((q.t==='perso'?'★ Nouvelle quête perso : ':'🎯 Nouvelle quête '+QNUM[q.n]+' : ')+q.nm,'warn',q.t!=='perso');return q;}
function qmQuestEnd(q){qmBeamKill(q);q.ids.forEach(function(id){const r=QM.R.find(function(x){return x.id===id;});if(r)qmRingFree(r);});const i=QM.QS.indexOf(q);if(i>=0)QM.QS.splice(i,1);}
function qmQuestDone(q,W){if(q.done)return;try{qmBigSab(q);}catch(_){}q.done=true;QM.stq=QM.stq||{};QM.stq[q.t]=(QM.stq[q.t]||0)+1;QM.j=Math.min(100,QM.j+q.pct);
  if(q.t==='perso'){const a=QM.A[q.own];qmPts(a,6,'sab');if(a&&a.human)qmMsg('★ Quête perso réussie : +'+(Math.round(q.pct*10)/10)+' % · +6 ⭐','good',1);}
  else{(W||[]).forEach(function(a){qmPts(a,10,'sab');});qmMsg('✅ Quête '+QNUM[q.n]+' réussie : '+q.nm+' (+'+Math.round(q.pct)+' %)','good',1);}
  qmQuestEnd(q);if(q.t==='perso'){const a=QM.A[q.own];if(a)a.pqT=QCFG.pRe;}else QM.QSL[q.n-1].t=QCFG.qRe;
  if(QM.j>=100)qmClose();}
function qmQTick(dt){if(QM.mp&&QN.client)return;QM.QSL.forEach(function(sl,i){if(QM.QS.some(function(q){return q.n===i+1&&!q.done;}))return;sl.t-=dt;if(sl.t<=0){if(!qmQuestNew('shared',-1,i))sl.t=3;}});
  QM.A.forEach(function(a){if(a.role!=='emp'||a.out)return;if(QM.QS.some(function(q){return q.own===a.id;}))return;a.pqT=(a.pqT===undefined?1+a.id*.7:a.pqT)-dt;if(a.pqT<=0){if(!qmQuestNew('perso',a.id))a.pqT=3;}});}
function qmStgDo(r){const S=QSTG[QM.stg.i];if(!S)return;if(S.k==='cnt'&&r.zn===S.zn){QM.stg.n++;if(QM.stg.n>=S.need)qmStgNext();}else if(S.k==='rings'&&S.ids.indexOf(r.id)>=0){QM.stg.done=QM.stg.done||{};QM.stg.done[r.id]=1;QM.stg.n=Object.keys(QM.stg.done).length;if(QM.stg.n>=S.ids.length)qmStgNext();}}
function qmStgNext(){return;const S=QSTG[QM.stg.i];if(!S)return;if(S.bon)QM.j=Math.min(100,QM.j+S.bon);qmBig('✅ Étape réussie : '+S.t+(S.bon?' (+'+S.bon+' %)':''),'key',1);
  const i=QM.stg.i;QM.stg={i:i+1,n:0};
  if(i===0){qmSpawnKey('boulangerie','store');}
  else if(i===1){delete QM.lockZ.reserve;qmMsg('🔓 La réserve est ouverte !','good',1);}
  else if(i===2){delete QM.lockZ.office;qmMsg('🔓 Les bureaux sont ouverts !','good',1);}
  if(i>=1)QM.keyNext=QCFG.time-QM.t+50;
  const N=QSTG[i+1];if(N)setTimeout(function(){qmBig('🎯 Étape '+(i+2)+' : '+N.d,'',1);},2600);if(QM.j>=100)qmClose();}
function qmRings(dt){
  QM.R.forEach(function(r){if(r.cd>0)r.cd-=dt;if(r.lk>0){r.lk-=dt;if(r.lk<=0){r.lk=0;r.m.lb.draw(qmRingTxt(r),hex6(QRC[r.k])+'f2');}}const on=qmRingOn(r)&&!(r.lk>0);r.m.ring.material.color.setHex(r.lk>0?QRC.rep:QRC[r.k]);const vis=qmRingOn(r)&&(r.zn===cur||QM.map)&&(r.own===undefined||r.own===QM.me.id);r.m.g.visible=vis;r.m.lb.sp.visible=!QM.map;r.m.g.scale.setScalar((QM.map?3:1)*(r.k==='mini'?.8:1));
    const W=on?qmWorkers(r):[];if(r.own!==undefined&&r.own!==QM.me.id)r.m.g.visible=false;const E=W.filter(function(a){return a.role==='emp';});const nz=E.filter(function(a){return !(a.zomb>0);});const tech=(QM.cafeT>0?3:1)*(nz.some(function(a){return a.cls==='stg';})?2:1)*(QELEC.indexOf(r.id)>=0&&nz.some(function(a){return a.cls==='ele';})?2:1)*(E.some(function(a){return a.zomb>0;})?2:1)*(E.some(function(a){return a.human||a.remote;})?1:QCFG.bot);
    if(W.length)r.touch=QM.clk;let adv=0;
    if(!on){r.prog=0;}
    else if(r.k==='solo'||r.k==='mini'){if(E.length>=(r.duo?2:1))adv=dt/r.dur*tech;}
    else if(r.k==='spec'){if(nz.some(function(a){return a.cls==='ele';}))adv=dt/r.dur*tech;}
    else if(r.k==='team'){const n=E.length,need=(r.solo&&nz.some(function(a){return a.cls===r.solo;}))?1:r.need;if(r.cnt!==n){r.cnt=n;if(!(r.lk>0))r.m.lb.draw(qmRingTxt(r),hex6(QRC.team)+'f2');}if(n>=need)adv=dt/r.dur*tech;}
    else if(r.k==='pair'){const o=QM.R.find(function(x){return x.id===r.pair;});const oE=qmRingOn(o)&&!(o.lk>0)?qmWorkers(o).filter(function(a){return a.role==='emp';}):[];r.both=E.length>0&&oE.length>0;if(r.both)adv=dt/r.dur*tech;}
    if(!(QM.mp&&QN.client)){r.prog=Math.min(1,r.prog+adv);if(!W.length&&QM.clk-r.touch>(r.k==='pair'&&r.prog>=1?25:10))r.prog=0;}
    {const pz=r.prog>0&&!W.length&&!(r.lk>0)&&QM.clk-r.touch<=10;const tx=r.k==='pair'&&r.prog>=1?'⏳ Fini ici ! Il faut l\'autre endroit en même temps':pz?'⏸ '+r.n+' · '+Math.round(r.prog*100)+' %':qmRingTxt(r);if(r.k==='pair'&&r.prog>=1)r._pz=1;if(pz||r._pz){r._pz=pz;if(!(r.lk>0))r.m.lb.draw(tx,hex6(QRC[r.k])+'f2');}}
    r.m.disc.material.opacity=.28+r.prog*.55;r.m.ring.scale.setScalar(1+Math.sin(QM.clk*3+r.x)*.06);
    if(r.prog>=1&&!(QM.mp&&QN.client)){if(r.k==='pair'){const o=QM.R.find(function(x){return x.id===r.pair;});if(o.prog>=.98){qmDone(r,W.concat(qmWorkers(o)));o.prog=0;o.cd=r.cd;}}else qmDone(r,W);}});
  for(let i=QM.REP.length-1;i>=0;i--){const p=QM.REP[i];p.t-=dt;p.m.g.visible=QM.me.role==='imp'&&(p.zn===cur||QM.map);p.m.lb.sp.visible=!QM.map;
    const W=QM.A.filter(function(a){return a.role==='imp'&&qmLive(a)&&a.at===p&&a.zn===p.zn&&Math.hypot(a.x-p.x,a.z-p.z)<1.3;});
    if(W.length&&!(QM.mp&&QN.client)){p.prog+=dt/4;p.touch=QM.clk;W.forEach(function(w){QM.A.forEach(function(b){if(b.role==='emp'&&!b.human&&qmLive(b)&&b.zn===w.zn&&Math.hypot(b.x-w.x,b.z-w.z)<9&&!blocked(Z[w.zn],b.x,b.z,w.x,w.z))w.sus+=dt*.5;});});}
    else if(QM.clk-(p.touch||0)>10&&!(QM.mp&&QN.client))p.prog=0;p.m.disc.material.opacity=.25+p.prog*.55;
    if(p.prog>=1&&!(QM.mp&&QN.client)){QM.j=Math.max(0,QM.j-p.g);qmMsg('🔧 Un sabotage a été réparé ('+QZN[p.zn]+') : −'+p.g+' %','bad',1);if(QM.me.role==='imp'&&W.indexOf(QM.me)>=0)qmMsg('Bien joué, personne n\'a rien vu… normalement.','good');
      QM.A.forEach(function(a){if(a.at===p){a.at=null;a.job=null;}});scene.remove(p.m.g);QM.REP.splice(i,1);continue;}
    if(p.t<=0&&!(QM.mp&&QN.client)){scene.remove(p.m.g);QM.REP.splice(i,1);}}}
function qmDone(r,W){if((QM.mp&&QN.client))return;qmHelpBonus(r,W);
  {const q=QM.QS.find(function(x){return !x.done&&x.ids.indexOf(r.id)>=0;});if(q){r.prog=0;q.d[r.id]=1;if(r.k==='pair')q.d[r.pair]=1;W.forEach(function(a){if(!a.human){a.job=null;}a.at=null;});if(q.ids.every(function(id){return q.d[id];}))qmQuestDone(q,W);return;}}
  if(r.k==='mini'){QM.stm=(QM.stm||0)+1;r.prog=0;r.act=0;r.duo=0;qmMiniPick();r.cd=QCFG.cdM+Math.random()*10;const hu=W.some(function(x){return (x.human||x.remote)&&x.role==='emp';});const dbl=r.dbl?2:1;r.dbl=0;QM.j=Math.min(100,QM.j+(hu?QCFG.gM:QCFG.gM*QCFG.botM)*dbl);W.forEach(function(a){qmPts(a,dbl,'sab');});if(W.some(function(x){return x.human&&x.role==='emp';}))qmMsg('💥 '+r.n+' : +1 ⭐','good');W.forEach(function(a){if(!a.human)a.job=null;a.at=null;});if(QM.j>=100)qmClose();return;}
  r.prog=0;r.cd=r.k==='solo'?QCFG.cdS:QCFG.cdT;r.done=true;const gg=Math.max(1,Math.round(r.g*(W.some(function(x){return (x.human||x.remote)&&x.role==='emp';})?1:QCFG.botG)));QM.j=Math.min(100,QM.j+gg);const who=W.filter(function(a){return a.role==='emp';});
  qmMsg('💥 '+r.n+' : +'+gg+' %'+(who.length?' ('+who.map(function(a){return a.name;}).join(', ')+')':''),'good',1);
  W.forEach(function(a){if(!a.human){a.job=null;}a.at=null;});
  const p={id:(QM.repN=(QM.repN||0)+1),x:r.x,z:r.z,zn:r.zn,g:Math.max(4,Math.round(r.g*.5)),t:45,prog:0,touch:0};p.m=qmRingMesh(QRC.rep,'🔧 Réparer (−'+p.g+' %)',360);p.m.g.position.set(p.x,0,p.z);p.m.g.visible=false;QM.REP.push(p);
  if(r.lock===undefined&&r.id==='elec')qmMsg('🔓 Le tableau est coupé : les chambres froides peuvent être vidées (réserve) !','good',1);
  if((r.k==='team'||r.k==='pair')&&!QM.firstTeam)QM.firstTeam=true;
  if(QM.j>=100)qmClose();}
function qmSpawnKey(rid,zn0){if((QM.mp&&QN.client))return;const L=QROOM.filter(function(r){return QM.lockR[r.id]&&(rid?r.id===rid:true);});if(!L.length)return;const rm=L[(Math.random()*L.length)|0];
  const zs=['store','reserve','office'].filter(function(z){return !QM.lockZ[z];}),zn=zn0||zs[(Math.random()*zs.length)|0],p=qmRand(zn);QM.key={st:'ground',zn:zn,x:p[0],z:p[1],room:rm.id};
  QM.keyM.lb.draw('🔑 Clé : '+rm.n,'#ffd21ff2');qmBig('🔑 Clé '+(rm.id==='wc'?'des':'de la')+' '+rm.n+' : '+QZN[zn]+' !','key',1);qmMsg('🔑 La clé '+(rm.id==='wc'?'des':'de la')+' '+rm.n+' est apparue : '+QZN[zn]+' !','warn',1);}
function qmOpenRoom(id,fromNet){const o=QM.RM[id];if(!o||!QM.lockR[id])return;delete QM.lockR[id];if(o.zn&&!o.spot)delete QM.lockZ[o.zn];o.sign.visible=false;scene.remove(o.sign);
  qmBig('🔓 '+o.n+' ouverte !','key');
  if(!(QM.mp&&QN.client)&&!fromNet){qmRoomFill(id,o);const op=QM.opener;QM.lastOp=op;QM.opener=null;qmPts(op,5,'sab');const q=QM.QS.find(function(x){return x.t==='key'&&x.room===id&&!x.done;});if(q)qmQuestDone(q,op?[op]:[]);qmSurprise(o);return;}}
function qmRoomFill(id,o){const L=qmShuffle(QM.R.filter(function(r){return r.k==='mini'&&!r.qa&&((!o.spot&&r.zn===o.zn)||r.room===id);})).slice(0,3);L.forEach(function(r){r.act=1;r.dbl=1;r.duo=0;r.cd=0;r.m.lb.draw(qmRingTxt(r),hex6(QRC[r.k])+'f2');});
  for(let i=0;i<2;i++){const q=o.spot?qmFree(o.zn,o.door.x+(i?1.5:-1.5),o.door.z+1.2):qmFree(o.zn,Z[o.zn].spawn.x+(i?2.5:-2.5),Z[o.zn].spawn.z+(Math.random()-.5)*3);qmBxAdd(o.zn,q[0],q[1]);}}
function qmSurprise(o){if(QM.bossN<4&&!QM.boss&&!QM.arena&&(QM.forceBoss||(QCFG.time-QM.t)>=90&&Math.random()<.6)){qmBossStart(o);return;}const S=['items','items','jackpot','meute','horde','insp','panne','alarme','chien','livraison'];const k=S[(Math.random()*S.length)|0];
  const pos=function(){return o.spot?qmFree(o.zn,o.door.x+(Math.random()-.5)*3,o.door.z+(Math.random()-.5)*3):qmRand(o.zn);};
  if(k==='items'||k==='jackpot'){const n=k==='jackpot'?5:(o.spot?2:3),pool=qmShuffle(QCONS.concat(QCONS));for(let i=0;i<n;i++){const p=pos();qmItemAdd(++QM.itN,pool[i],o.zn,p[0],p[1]);}
    if(k==='jackpot'){QM.j=Math.min(100,QM.j+5);qmBig('💰 JACKPOT ! Plein d\'objets et +5 %','key',1);}else qmMsg('🎁 '+o.n+' : des objets t\'attendent dedans !','good',1);}
  else if((k==='meute'||k==='horde')&&!QM.arena&&!QM.boss){qmWaveStart(k==='horde'?'zomb':'cli',o);}
  else if(k==='meute'||k==='horde'){const z=k==='horde';const zn=o.spot?o.zn:o.door.zn;for(let i=0;i<5;i++){const p=qmFree(zn,o.door.x+(Math.random()-.5)*4,o.door.z+(Math.random()-.5)*4);qmCliMake(++QM.ceN,zn,p[0],p[1],z?2:1,60);}
    qmBig(z?'🧟 Une horde de clients zombies sort de '+o.n+' !':'🛍️ SOLDES ! Une meute de clients énervés déboule !','zomb',1);}
  else if(k==='alarme'){qmFireAlarm();}
  else if(k==='chien'){if(QM.dog)qmMsg('🎁 Des objets t\'attendent dans '+o.n,'good');else qmDogStart(o);}
  else if(k==='livraison'){if(!qmDelivery())qmFireAlarm();}
  else if(k==='insp'){QM.insp=45;qmBig('🔍 Inspection surprise : les managers sont sur les nerfs (45 s) !','zomb',1);}
  else if(k==='panne'){QM.dark={zn:'*',t:20};QM.H.forEach(function(h){h.dark=20;});qmBig('💡 Panne générale : tout le magasin est dans le noir (20 s) !','zomb',1);}}
function qmOpenRoomOld(id,fromNet){const o=QM.RM[id];
  if(!(QM.mp&&QN.client)&&!fromNet){const n=o.spot?2:3,pool=qmShuffle(QCONS.slice());if(id==='boulangerie'&&pool.indexOf('croissant')>0){pool.splice(pool.indexOf('croissant'),1);pool.unshift('croissant');}
    for(let i=0;i<n;i++){const p=o.spot?qmFree(o.zn,o.door.x+(Math.random()-.5)*3,o.door.z+(Math.random()-.5)*3):qmRand(o.zn);qmItemAdd(++QM.itN,pool[i],o.zn,p[0],p[1]);}
    QM.keyNext=QCFG.time-QM.t+50;}}
function qmQuestHud(dt){const ob=$('qmObj');const me=QM.me;
  const zt=function(q){if(q.t==='key'){const K=QM.key;if(K.room===q.room&&K.st==='held')return '🚪 '+QZN[QM.RM[q.room].door.zn];if(K.room===q.room&&K.st==='ground')return '🔑 '+QZN[K.zn];return '';}return (q.zn||'').split('|').map(function(z){return QZN[z];}).join(' + ');};
  const L=QM.QS.filter(function(q){return !q.done&&qmQMine(q);}).sort(function(a,b){return a.n-b.n;});const HL=QM.help&&QM.help.until>QM.clk&&QM.help.by!==me.id?QM.help:null;
  if(HL){const r=QM.R.find(function(x){return x.id===HL.rid;});if(r&&!L.some(function(q){return q.ids.indexOf(r.id)>=0;}))L.push({t:'help',ids:[r.id],n:5,d:{},zn:r.zn,nm:'Aide demandée : '+r.n});}
  const big=QM.qBig>QM.clk;if(ob)ob.classList.toggle('big',big);
  const h='<b>⭐ '+(me.pts||0)+' · '+qmCW(me).ic+' Nv'+qmWl(me)+'</b>'+L.map(function(q){return '<div class="qmq'+(q.t==='perso'?' me':'')+(HL&&q.ids.indexOf(HL.rid)>=0?' help':'')+'"><span class="qn">'+QNUM[q.n]+'</span><span class="qt">'+(q.t==='perso'||q.t==='help'?'':QQIC[q.t]+' ')+esc(q.nm)+(big?' <small>· '+zt(q)+'</small>':'')+'</span></div>';}).join('');
  if(ob&&ob._h!==h){ob._h=h;ob.innerHTML=h;}
  QM.QS.forEach(function(q){if(!qmQMine(q)){qmBeamKill(q);return;}if(!q.beam)qmBeam(q);const t=qmQTarget(q);if(!t||!q.beam)return;const v=(t.zn===cur||QM.map)&&!QM.cine;q.beam.visible=v&&!QM.map;q.nb.visible=v;q.beam.position.set(t.x,13,t.z);q.beam.material.opacity=.16+.08*Math.sin(QM.clk*3+q.n);const sc=QM.map?6:2.2;q.nb.scale.set(sc,sc,1);q.nb.position.set(t.x,(QM.map?10:6.5)+Math.sin(QM.clk*2.5+q.n)*.25,t.z);});
  const box=$('qmArr');if(!box)return;while(box.children.length<L.length){const d=document.createElement('div');d.className='qmarr';d.innerHTML='<i>➤</i><span></span>';box.appendChild(d);}
  Array.prototype.forEach.call(box.children,function(el,i){const q=L[i];if(!q||QM.map||QM.cine||!QM.on||me.caught>0||me.cv){el.style.display='none';return;}const t=qmQTarget(q);if(!t){el.style.display='none';return;}
    let tx=t.x,tz=t.z,txt='',same=t.zn===cur;if(!same){const lg=qmZoneNext(cur,t.zn);if(!lg){el.style.display='none';return;}tx=lg.x;tz=lg.z;txt=QZN[t.zn];}else txt=Math.round(Math.hypot(t.x-pp.x,t.z-pp.z))+' m';
    const v=new T.Vector3(tx,1,tz).project(camera);let sx=v.x,sy=v.y;if(v.z>1){sx=-sx;sy=-sy;}
    if(same&&Math.abs(sx)<.86&&Math.abs(sy)<.8&&v.z<1){el.style.display='none';return;}
    const a=Math.atan2(sy,sx),m=Math.max(Math.abs(Math.cos(a))/.86,Math.abs(Math.sin(a))/.74),ex=Math.cos(a)/m,ey=Math.sin(a)/m;
    el.style.display='flex';el.className='qmarr'+(q.t==='perso'?' me':'')+(HL&&q.ids.indexOf(HL.rid)>=0?' help':'');el.style.left=((ex+1)/2*100)+'%';el.style.top=((1-ey)/2*100)+'%';el.querySelector('i').style.transform='rotate('+(-a)+'rad)';const s2=QNUM[q.n]+' '+txt;const sp=el.querySelector('span');if(sp.textContent!==s2)sp.textContent=s2;});}
function qmItemAdd(id,k,zn,x,z){const sp=label(QIT[k].ic,{sx:1.2,sy:1.2,w:96,h:96,size:70,bg:'rgba(255,255,255,.92)'});sp.position.set(x,1.1,z);scene.add(sp);const it={id:id,k:k,zn:zn,x:x,z:z,sp:sp};QM.IT.push(it);return it;}
function qmItemDel(it){scene.remove(it.sp);const i=QM.IT.indexOf(it);if(i>=0)QM.IT.splice(i,1);}
function qmKey(dt){const K=QM.key,host=!(QM.mp&&QN.client);

  const kv=K.st==='ground'&&(K.zn===cur||QM.map);QM.keyM.g.visible=kv;QM.keyM.g.scale.setScalar(QM.map?3:1.6);QM.keyM.lb.sp.visible=!QM.map;
  QM.keyBig.visible=kv;QM.keyBeam.visible=kv&&!QM.map;if(kv){const sc=QM.map?7:2.4;QM.keyBig.scale.set(sc,sc,1);QM.keyBig.position.set(K.x,(QM.map?9:2.1)+Math.sin(QM.clk*3)*.25,K.z);QM.keyBig.material.opacity=.55+.45*Math.abs(Math.sin(QM.clk*4));QM.keyBeam.position.set(K.x,7,K.z);QM.keyBeam.material.opacity=.12+.12*Math.abs(Math.sin(QM.clk*4));}
  QM.keyTag.visible=false;const rm=K.room?QM.RM[K.room]:null;
  QM.doorM.g.visible=!!(rm&&K.st==='held'&&(rm.door.zn===cur||QM.map));if(rm){QM.doorM.g.position.set(rm.door.x,0,rm.door.z);QM.doorM.lb.draw('🚪 Ouvrir : '+rm.n,'#ffd21ff2');QM.doorM.ring.rotation.z+=dt*2;QM.doorM.g.scale.setScalar(QM.map?3:1.3);}
  QROOM.forEach(function(r){const o=QM.RM[r.id];if(o.sign.parent)o.sign.visible=o.door.zn===cur&&!QM.map;});
  if(K.st==='ground'){QM.keyM.g.position.set(K.x,0,K.z);QM.keyM.ring.rotation.z+=dt*2;
    if(!host)return;
    const A=QM.A.find(function(a){return qmLive(a)&&!(a.down>0)&&!(a.zomb>0)&&a.zn===K.zn&&Math.hypot((a.human?pp.x:a.x)-K.x,(a.human?pp.z:a.z)-K.z)<1;});
    if(A){QM.key={st:'held',by:A,room:K.room};QM.keyRun=-1;qmBig('🔑 '+(A.human?'Tu as':A.name+' a')+' la clé '+(K.room==='wc'?'des':'de la')+' '+rm.n+' !','key',1);if(A.human)qmMsg('🔑 Va ouvrir : '+rm.n+' ('+QZN[rm.door.zn]+'). Suis le rond 🚪 jaune.','warn');}
    else{let best=null,bd=1e9;QM.A.forEach(function(a){if(a.human||a.remote||!qmLive(a)||a.down>0||a.zomb>0)return;const d=(a.zn===K.zn?0:40)+Math.hypot(a.x-K.x,a.z-K.z);if(d<bd){bd=d;best=a;}});QM.keyRun=best?best.id:-1;}}
  else if(K.st==='held'){const b=K.by;if(!host)return;if(!qmLive(b)||b.down>0||b.zomb>0){QM.key={st:'ground',zn:b.zn,x:b.x,z:b.z,room:K.room};qmMsg('🔑 '+b.name+' a lâché la clé !','warn',1);return;}
    QM.keyTag.visible=b.zn===cur&&!b.human;QM.keyTag.position.set(b.x,3.75+Math.sin(QM.clk*5)*.08,b.z);
    const bx=b.human?pp.x:b.x,bz=b.human?pp.z:b.z,bzn=b.human?cur:b.zn;if(bzn===rm.door.zn&&Math.hypot(bx-rm.door.x,bz-rm.door.z)<1.7){QM.key={st:'none'};QM.opener=b;qmOpenRoom(rm.id);}}}
/* objets : ramasser (marcher dessus), attraper dans un rayon, utiliser ou lancer */
function qmThrowTg(a,R,all){let best=null,bd=R;const h0=a.human?pp.face:(a.th!==undefined&&a.remote?a.th:a.h),x=a.human?pp.x:a.x,z=a.human?pp.z:a.z,zn=a.human?cur:a.zn;
  const L=QM.H.filter(function(h){return !h.dir&&h.zn===zn;}).concat(all?QM.CE.filter(function(n){return n.zn===zn&&!(n.ko>0)&&!(n.gone>0);}).map(function(n){n.foe='cli';return n;}).concat(QM.FY.filter(function(f){f.foe='fay';return f.zn===zn&&!(f.ko>0);})):[]);
  L.forEach(function(h){const dx=h.x-x,dz=h.z-z,d=Math.hypot(dx,dz);if(d>=bd)return;if(d>2&&(Math.sin(h0)*dx+Math.cos(h0)*dz)/d<Math.cos(1.05))return;bd=d;best=h;});return best;}
function qmShelf(a){const x=a.human?pp.x:a.x,z=a.human?pp.z:a.z,zn=a.human?cur:a.zn,f=a.human?pp.face:(a.remote&&a.th!==undefined?a.th:a.h);if(!QTHR[zn])return false;for(let r=.55;r<=1.05;r+=.25){if(hit(x+Math.sin(f)*r,z+Math.cos(f)*r,.18,Z[zn]))return true;}return false;}
function qmGrab(a){if(a.item||a.down>0||a.zomb>0||a.caught>0)return;if((a.grabCd||0)>0){if(a.human)qmMsg('Attends un peu avant d\'attraper autre chose ('+Math.ceil(a.grabCd)+' s).');return;}
  if((QM.mp&&QN.client)&&a.human){a.grabCd=10;qnS('a',{pid:QN.pid,k:'grab'});return;}
  if(!qmShelf(a))return;const L=QTHR[a.zn]||QTHR.store;a.item=L[(Math.random()*L.length)|0];a.grabCd=10;if(a.human)qmMsg(QIT[a.item].ic+' Tu attrapes : '+QIT[a.item].n+'. Vise un manager et lance-le !','good');}
function qmUseItem(a){const k=a.item;if(!k||a.down>0||a.zomb>0||a.caught>0){if(a.human&&a.zomb>0)qmMsg('🧟 Pas d\'objet quand tu es zombie.');return;}
  if((QM.mp&&QN.client)&&a.human){qnS('a',{pid:QN.pid,k:'use'});if(k==='cafe')QM.cafe=30;if(k==='choco')a.boost=20;if(k==='gilet')a.inv=20;return;}
  const it=QIT[k];
  if(k==='pile'||k==='passe'){if(qmUseSp(a,k))a.item='';return;}
  if(it.t){const h=qmThrowTg(a,10,1);const x=a.human?pp.x:a.x,z=a.human?pp.z:a.z,zn=a.human?cur:a.zn,f=a.human?pp.face:(a.remote&&a.th!==undefined?a.th:a.h);
    const tx=h?h.x:x+Math.sin(f)*8,tz=h?h.z:z+Math.cos(f)*8;a.item='';const o={id:a.id,k:'throw',zn:zn,x:x,z:z,tx:tx,tz:tz,ic:it.ic};qmPowFx(a,'throw',o);if(QM.mp&&QN.host)qnS('fx',o);
    {const B=QM.boss;if(B&&!B.dead&&!B.air&&B.zn===zn&&(!h||Math.hypot(B.x-x,B.z-z)<Math.hypot(h.x-x,h.z-z))&&Math.hypot(B.x-x,B.z-z)<12){a.item='';const o2={id:a.id,k:'throw',zn:zn,x:x,z:z,tx:B.x,tz:B.z,ic:it.ic};if(QM.mp&&QN.host)qnS('fx',o2);qmPowFx(a,'throw',o2);qmBossItem(a);return;}}
    if(qmDogHit(a,tx,tz))return;
    if(h&&h.foe&&QM.H.indexOf(h)<0){h.ko=h.foe==='fay'?8:1.5;if(h.foe!=='fay')h.van=1;h.hits=0;qmPts(a,1,'mgr');if(a.human)qmMsg(it.ic+' En plein dans le '+(h.foe==='fay'?'fayot':'client énervé')+' : KO !','good');return;}
    if(h){h.stun=Math.max(h.stun||0,3);qmPts(a,2,'mgr');if(h.tg)qmLose(h,null);if(h.zn===cur)say(h.g,['Aïe !','Hé ! Qui a lancé ça ?!','Ouille !'][(Math.random()*3)|0]);}
    if(a.human)qmMsg(h?it.ic+' En plein dans '+h.name+' : sonné 3 s !':it.ic+' Raté…',h?'good':'');return;}
  if(k==='trousse'){const x=a.human?pp.x:a.x,z=a.human?pp.z:a.z,zn=a.human?cur:a.zn;const t=QM.A.find(function(b){return b!==a&&!(b.caught>0)&&(b.down>0||b.zomb>0)&&b.zn===zn&&Math.hypot(b.x-x,b.z-z)<2.2;});
    if(!t){if(a.human)qmMsg('🩹 Personne à relever ou à soigner à côté de toi : garde ta trousse.');return;}a.item='';
    if(t.down>0){t.down=0;t.rev=0;t.hp=4;t.imm=3;qmMsg('🩹 '+a.name+' a relevé '+t.name+' avec une trousse !','good',1);}else{qmZombEnd(t,'sst');qmMsg('🩹 '+a.name+' a soigné '+t.name+' avec une trousse !','good',1);}return;}
  a.item='';
  if(k==='energy'){a.hp=Math.min(a.hpMax+4,a.hp+4);if(a.human)qmMsg('🥤 Boisson énergisante : +1 cœur bonus !','good');}
  else if(k==='croissant'){a.hp=Math.max(a.hp,Math.min(a.hpMax,a.hp+4));if(a.human)qmMsg('🥐 Croissant : +1 cœur.','good');}
  else if(k==='cafe'){if(a.human)QM.cafe=30;else if(a.remote)qnS('buff',{id:a.id,k:'cafe'});if(a.human)qmMsg('☕ Café serré : endurance infinie pendant 30 s !','good');}
  else if(k==='choco'){a.boost=20;if(a.remote)qnS('buff',{id:a.id,k:'choco'});if(a.human)qmMsg('🍫 Barre chocolatée : tu cours plus vite pendant 20 s !','good');}
  else if(k==='gilet'){a.inv=20;QM.H.forEach(function(h){if(h.tg===a)qmLose(h,'Il est passé où ?');});if(a.remote)qnS('inv',{id:a.id,t:20});if(a.human)qmMsg('🦺 Gilet de sécurité : les managers ne te voient plus pendant 20 s !','good');}}
function qmItems(dt){const host=!(QM.mp&&QN.client);
  QM.IT.forEach(function(it){it.sp.visible=(it.zn===cur||QM.map)&&!QM.cine;const sc=QM.map?3:1.2+Math.sin(QM.clk*4+it.x)*.08;it.sp.scale.set(sc,sc,1);it.sp.position.y=QM.map?6:1.1+Math.sin(QM.clk*3+it.z)*.12;});
  QM.A.forEach(function(a){if(a.grabCd>0)a.grabCd-=dt;});
  if(!host)return;
  for(let i=QM.IT.length-1;i>=0;i--){const it=QM.IT[i];const a=QM.A.find(function(b){return (b.human||b.remote)&&qmCanTake(b,it.k)&&qmLive(b)&&!(b.down>0)&&!(b.zomb>0)&&(b.human?cur:b.zn)===it.zn&&Math.hypot((b.human?pp.x:b.x)-it.x,(b.human?pp.z:b.z)-it.z)<1;});
    if(a){qmTake(a,it.k);qmItemDel(it);}}}
/* ---------- reunion d'urgence (une seule par partie) ---------- */
function qmMeeting(by,fromNet){if(QM.meetUsed&&!fromNet)return;if((QM.mp&&QN.client)&&!fromNet)return;if(QM.mp&&QN.host)qnS('meet',{by:by.id});QM.meetUsed=true;QM.key={st:'used'};QM.pup.prog=0;QM.paused=true;QM.H.forEach(function(h){h.st='patrol';h.tg=null;h.gzn=null;h.wait=4;});
  const live=QM.A.filter(function(a){return !a.out;});
  live.forEach(function(a,i){a.caught=0;a.job=null;a.at=null;a.gzn=null;a.st='idle';const x=25.6+(i%9)*2,z=i<9?-58.7:-53.3;a.zn='salle';a.x=x;a.z=z;a.h=i<9?0:Math.PI;if(!a.human)qmPose(a,0,false);});
  if(!QM.me.out){cur='salle';pp.x=QM.me.x;pp.z=QM.me.z;pp.face=QM.me.h;camPos.set(pp.x,CAMH,pp.z+CAMZ);}
  QM.meet={t:QCFG.tvoteT,v:{},by:by};
  live.forEach(function(a){if(!a.human&&!a.remote)a.vt=3+Math.random()*(QCFG.tvoteT-10);});
  qmMsg('📋 '+(by.human?'Tu lances':by.name+' lance')+' la réunion d\'urgence !','warn');qmVoteUI();}
function qmVoteUI(){const M=QM.meet,me=QM.me;const live=QM.A.filter(function(a){return !a.out;});
  const cnt={};Object.keys(M.v).forEach(function(k){const t=M.v[k];cnt[t]=(cnt[t]||0)+1;});
  const mine=M.v[me.id];
  qmOv('<div class="qmk">RÉUNION D\'URGENCE · '+Math.ceil(M.t)+' s</div><h2 class="qmemp">Qui est le traître ?</h2><p class="qmd">Lancée par '+esc(M.by.human?'toi':M.by.name)+'. Vote pour virer quelqu\'un. Si c\'est un traître, les employés gagnent tout de suite. Si c\'est un innocent : −15 % et −1 min. En cas d\'égalité, personne n\'est viré.</p><div class="qmvote">'
    +live.map(function(a){const n=cnt[a.id]||0;return '<button class="qmvb'+(mine===a.id?' on':'')+'" data-v="'+a.id+'"'+((me.out||mine!==undefined||a===me)?' disabled':'')+'>'+esc(a.name)+(a===me?' (toi)':'')+'<small>'+'🗳️'.repeat(n)+'</small></button>';}).join('')
    +'</div><p class="qmsm">'+(me.out?'Tu as été viré : tu ne votes plus.':mine!==undefined?'Ton vote est enregistré.':'Touche un nom pour voter.')+' Votes : '+Object.keys(M.v).length+'/'+live.length+'</p>');
  Array.prototype.forEach.call(document.querySelectorAll('.qmvb'),function(b){b.onclick=function(){if(M.v[me.id]!==undefined||me.out)return;M.v[me.id]=+b.dataset.v;if((QM.mp&&QN.client))qnS('a',{pid:QN.pid,k:'vote',p:+b.dataset.v});else if(QM.mp)M._ch=1;qmVoteUI();};});}
function qmBotVote(a){const live=QM.A.filter(function(b){return !b.out&&b!==a;});let t=null;
  if(a.role==='emp'){const sus=live.filter(function(b){return b.sus>0;}).sort(function(p,q){return q.sus-p.sus;});
    if(sus.length&&sus[0].sus>1.5&&Math.random()<.6)t=sus[0];else if(Math.random()<.15){const I=live.filter(function(b){return b.role==='imp';});if(I.length)t=I[(Math.random()*I.length)|0];}}
  else{const E=live.filter(function(b){return b.role==='emp';});const cnt={};Object.keys(QM.meet.v).forEach(function(k){cnt[QM.meet.v[k]]=(cnt[QM.meet.v[k]]||0)+1;});
    const top=E.slice().sort(function(p,q){return (cnt[q.id]||0)-(cnt[p.id]||0);})[0];t=(top&&cnt[top.id]&&Math.random()<.6)?top:E[(Math.random()*E.length)|0];}
  if(!t)t=live[(Math.random()*live.length)|0];return t?t.id:a.id;}
function qmMeetTick(dt){const M=QM.meet;M.t-=dt;let ch=false;
  if((QM.mp&&QN.client)){if(Math.ceil(M.t)!==M._s){M._s=Math.ceil(M.t);qmVoteUI();}return;}
  if(M._ch){M._ch=0;ch=true;}
  QM.A.forEach(function(a){if(a.out||a.human||a.remote||M.v[a.id]!==undefined)return;a.vt-=dt;if(a.vt<=0){M.v[a.id]=qmBotVote(a);ch=true;}});
  const live=QM.A.filter(function(a){return !a.out;});const all=live.every(function(a){return M.v[a.id]!==undefined||(a.human&&a.out);});
  if(M.t<=0||all){qmVoteEnd();return;}
  if(ch||Math.ceil(M.t)!==M._s){M._s=Math.ceil(M.t);qmVoteUI();if(QM.mp&&QN.host)qnS('mv',{v:M.v,t:M.t});}}
function qmVoteEnd(){const M=QM.meet;QM.meet=null;const cnt={};Object.keys(M.v).forEach(function(k){const t=M.v[k];cnt[t]=(cnt[t]||0)+1;});
  let top=null,tn=0,tie=false;Object.keys(cnt).forEach(function(k){if(cnt[k]>tn){tn=cnt[k];top=+k;tie=false;}else if(cnt[k]===tn)tie=true;});
  const R0={top:top,tn:tn,tie:tie};if(QM.mp&&QN.host)qnS('vres',R0);qmVoteResolve(R0,false);}
function qmVoteResolve(R0,fromNet){QM.meet=null;if(QM.mp)setTimeout(function(){if(!QM.end){QM.paused=false;QM.A.forEach(function(x){x.imm=5;});}},3500);const top=R0.top,tn=R0.tn,tie=R0.tie;
  const res=function(html,cb){qmOv(html+'<button class="abtn full" id="qmOk">Continuer</button>');$('qmOk').onclick=cb;};
  if(top===null||tie){res('<div class="qmk">RÉSULTAT DU VOTE</div><div class="qmic">🤷</div><h2 class="qmemp">Égalité : personne n\'est viré</h2><p class="qmd">La réunion est finie, il n\'y en aura pas d\'autre. Retour au boulot… et au sabotage.</p>',qmAfterMeet);return;}
  const t=QM.A.find(function(a){return a.id===top;});
  if(t.role==='imp'){if(!fromNet)qmFinish('vote',t);return;}
  t.out=true;t.g.visible=false;if(QM.key.st==='held'&&QM.key.by===t)QM.key={st:'used'};QM.j=Math.max(0,QM.j-15);QM.t=Math.max(5,QM.t-60);
  res('<div class="qmk">RÉSULTAT DU VOTE · '+tn+' voix</div><div class="qmic">😬</div><h2 class="qmimp">'+esc(t.human?'Tu es viré':t.name+' est viré(e)')+'… et c\'était un innocent !</h2><p class="qmd">Le magasin reprend des forces : <b>−15 %</b> de fermeture et <b>−1 min</b> au chrono. Les traîtres sont toujours parmi vous.</p>',qmAfterMeet);}
function qmAfterMeet(){qmOvClose();if(!(QM.mp&&QN.client)||true)QM.paused=false;QM.A.forEach(function(a){a.imm=5;});qmMsg('⏱️ La partie reprend !','warn');}
/* ---------- fin de partie ---------- */
function qmClose(fromNet){if(QM.end)return;if((QM.mp&&QN.client)&&!fromNet)return;if(QM.mp&&QN.host)qnS('end',{why:'close',tid:-1});QM.end='emp';QM.paused=true;qmCineStart('close');return;qmMsg('🔒 Le rideau de fer descend : le magasin ferme !','good');
  QM.CL.forEach(function(n){const ex=QM.MAP.out||[30.45,16.6];n.path=path(Z.store,n.x,n.z,ex[0],ex[1]);n.pi=0;n.leave=1;});
  QM.H.forEach(function(h){if(h.zn===cur)say(h.g,h.dir?'NOOON ! Mon magasin !':'C\'est fini…');setMood(h.g,'sad');});}
function qmCineStart(kind){QM.cine={k:kind,t:0,stamp:false};QM.map=false;$('qmMapT').hidden=true;$('qmMapAll').hidden=true;document.body.classList.add('qmcine');qmOvClose();
  cur='parking';QM.A.forEach(function(a){if(!a.human)a.g.visible=false;});
  const g=new T.Group();g.position.set(0,3.35,23.25);const sl=new T.Group();for(let i=0;i<15;i++){const b=new T.Mesh(gBox,new T.MeshLambertMaterial({color:i%2?0x8b939c:0xa7afb8}));b.scale.set(7.1,.22,.1);b.position.set(0,-.11-i*.22,0);sl.add(b);}
  const bar=new T.Mesh(gBox,new T.MeshLambertMaterial({color:0x4b525a}));bar.scale.set(7.2,.12,.16);bar.position.set(0,-3.3,0);sl.add(bar);g.add(sl);sl.scale.y=kind==='close'?.02:.02;scene.add(g);QM.cine.g=g;QM.cine.sl=sl;
  QM.cine.cl=[];for(let i=0;i<6;i++){const c=makeChar({shirt:[0x3b82f6,0xef4444,0x10b981,0xf59e0b,0x8b5cf6,0x64748b][i],pants:0x334155,hair:[0x2b1d14,0xc9a227,0x1b1b1b][i%3],fem:i%2===0,hs:i%2?'court':'long'});const x=(Math.random()-.5)*4;c.position.set(x,0,kind==='close'?22.2:34+i*1.4);c.rotation.y=kind==='close'?0:Math.PI;scene.add(c);QM.cine.cl.push({g:c,x:x,z:kind==='close'?21.6-i*.9:34+i*1.4,d:i*.35,ph:0});}
  try{const ac=new (window.AudioContext||window.webkitAudioContext)();if(kind==='close'){const o=ac.createOscillator(),gn=ac.createGain();o.type='sawtooth';o.frequency.setValueAtTime(70,ac.currentTime);o.frequency.linearRampToValueAtTime(42,ac.currentTime+3.4);gn.gain.setValueAtTime(.0001,ac.currentTime);gn.gain.linearRampToValueAtTime(.08,ac.currentTime+.3);gn.gain.linearRampToValueAtTime(.06,ac.currentTime+3.2);gn.gain.linearRampToValueAtTime(.0001,ac.currentTime+3.6);o.connect(gn);gn.connect(ac.destination);o.start();o.stop(ac.currentTime+3.7);
    setTimeout(function(){try{const o2=ac.createOscillator(),g2=ac.createGain();o2.type='square';o2.frequency.value=55;g2.gain.setValueAtTime(.12,ac.currentTime);g2.gain.exponentialRampToValueAtTime(.0001,ac.currentTime+.35);o2.connect(g2);g2.connect(ac.destination);o2.start();o2.stop(ac.currentTime+.4);}catch(_){}},4300);}}catch(_){}}
function qmCineTick(dt){const C=QM.cine;C.t+=dt;const close=C.k==='close';
  tPos.set(0,5.2,36.5);tLook.set(0,2.3,22.7);
  C.cl.forEach(function(c){if(C.t<c.d)return;c.ph+=dt*9;if(close){c.z+=dt*5.2;c.g.rotation.y=0;}else{c.z-=dt*1.6;c.g.rotation.y=Math.PI;if(c.z<23.4)c.g.visible=false;}c.g.position.set(c.x,0,c.z);walkAnim(c.g,c.ph,close?1.5:1);});
  if(close){const k=clamp((C.t-1.2)/3.2,0,1);C.sl.scale.y=Math.max(.02,k);if(C.t>4.6&&!C.stamp){C.stamp=true;const el=$('qmCine');el.innerHTML='<div class="stamp">🔒 MAGASIN FERMÉ</div>';el.hidden=false;}if(C.t>7.2){QM.cine=null;qmFinish('close',null,false,true);}}
  else{if(C.t>1.4&&!C.stamp){C.stamp=true;const el=$('qmCine');el.innerHTML='<div class="stamp imp">🏪 LE MAGASIN TIENT BON…</div>';el.hidden=false;}if(C.t>5){QM.cine=null;qmFinish('time',null,true,true);}}}
function qmPodium(win){const k=win?1.5:.5;const L=QM.A.filter(function(a){return a.role==='emp';}).map(function(a){return {a:a,p:Math.round((a.pts||0)*k),sc:a.sc||{}};}).sort(function(x,y){return y.p-x.p;});if(!L.length)return '';
  const best=function(c){let b=null;L.forEach(function(o){if((o.sc[c]||0)>0&&(!b||o.sc[c]>b.sc[c]))b=o;});return b;};const nm=function(o){return esc(o.a.human?o.a.name+' (toi)':o.a.name);};
  const T2=[['rev','🚑 Meilleur sauveteur'],['sab','🔨 Roi du sabotage'],['mgr','🥊 Terreur des managers']].map(function(t){const b=best(t[0]);return b?'<div class="qmtt">'+t[1]+' : <b>'+nm(b)+'</b></div>':'';}).join('');
  return '<div class="qmpod"><div class="qmk">CLASSEMENT · points ×'+(win?'1,5':'0,5')+'</div>'+L.map(function(o,i){return '<div class="qmpr'+(o.a===QM.me?' me':'')+'"><span>'+(i===0?'🏆':i===1?'🥈':i===2?'🥉':(i+1)+'.')+'</span><span>'+nm(o)+(i===0?' <small>Employé du mois</small>':'')+'</span><b>'+o.p+' ⭐</b></div>';}).join('')+T2+'</div>';}
function qmFinish(why,t,noCine,fromNet){if((QM.mp&&QN.client)&&!fromNet)return;if(QM.mp&&QN.host&&!noCine&&!(why==='close'))qnS('end',{why:why,tid:t?t.id:-1});if(why==='time'&&!noCine&&!QM.cine&&!QM.cineDone){QM.cineDone=true;QM.end='imp';QM.paused=true;qmCineStart('hold');return;}
  $('qmCine').hidden=true;document.body.classList.remove('qmcine');QM.end=why==='time'?'imp':'emp';QM.paused=true;const me=QM.me,win=(QM.end==='emp')===(me.role==='emp');
  const ti=why==='vote'?'Le traître '+esc(t.human?'(toi !)':t.name)+' est démasqué !':why==='time'?'Fin du chrono : le magasin tient bon':'Le rideau de fer est tombé : le magasin est fermé !';
  qmOv('<div class="qmk">FIN DE PARTIE</div><div class="qmic">'+(win?'🏆':'💀')+'</div><h2 class="'+(win?'qmemp':'qmimp')+'">'+(win?'VICTOIRE':'DÉFAITE')+'</h2><p class="qmd"><b>'+ti+'</b><br>'+(QM.end==='emp'?'Toute l\'équipe gagne, zombies compris !':'Le chrono est écoulé avant la fermeture.')+'</p><p class="qmd">Fermeture atteinte : <b>'+Math.floor(QM.j)+' %</b>.</p>'
    +qmPodium(QM.end==='emp')+'<button class="abtn full" id="qmAgain">'+(QM.mp?'Retour à la salle':'Rejouer')+'</button><button class="abtn2 full" id="qmMenu2" style="margin-top:8px">Menu principal</button>');
  $('qmAgain').onclick=QM.mp?qmToRooms:qmReplay;$('qmMenu2').onclick=qmToMenu;}
/* ---------- boucle de la partie rapide ---------- */
function qmUpdate(dt){QM.clk=(QM.clk||0)+dt;clk+=dt;const me=QM.me;
  for(let i=floaters.length-1;i>=0;i--){const f=floaters[i];f.t-=dt;if(f.t<=0){f.g.remove(f.s);floaters.splice(i,1);}}
  if(QM.meet)qmMeetTick(dt);
  if(QM.cine)qmCineTick(dt);
  if(QM.closing>0){QM.closing-=dt;QM.CL.forEach(function(n){if(n.leave===2)return;if(follow(n,dt,3.4)){n.leave=2;n.g.visible=false;}else{n.g.rotation.y=angLerp(n.g.rotation.y,n.hd,.2);walkAnim(n.g,n.ph,1.3);n.g.position.set(n.x,0,n.z);}});if(QM.closing<=0)qmFinish('close');}
  const sim=!QM.paused&&(QM.mp||!QM.uiOpen),run=sim&&!QM.uiOpen;
  if(QM.mp){if(QN.host)qnHostTick(dt,sim);else qnClientTick(dt);}
  if(sim){if(!(QM.mp&&QN.client)){QM.t-=dt;if(QM.t<=0){QM.t=0;qmFinish('time');}
    if(QM.decoy>0)QM.decoy-=dt;}
    if(QM.dark){QM.dark.t-=dt;if(QM.dark.t<=0)QM.dark=null;}if(QM.insp>0)QM.insp-=dt;qmUltTick(dt);
    QM.A.forEach(function(a){const cf=(qmAniNear(a)?1.3:1)*(qmIsAr(a.human?cur:a.zn)?2:1);Object.keys(a.cd).forEach(function(k){if(a.cd[k]>0)a.cd[k]-=dt*cf;});if(a.imm>0)a.imm-=dt;if(a.inv>0)a.inv-=dt;if(a.turbo>0)a.turbo-=dt;if(a.boost>0)a.boost-=dt;if(a.jam>0)a.jam-=dt;});
    if(!(QM.mp&&QN.client)){qmStates(dt);QM.H.forEach(function(h){qmHunter(h,dt);});
    QM.A.forEach(function(a){if(!a.human&&!a.remote)qmBot(a,dt);});}
    /* clients */
    QM.CL.forEach(function(n){if(n.ang&&(n.chase||n.ko>0||(QM.mp&&QN.client)))return;if(!n.path||n.pi>=n.path.length){if(n.wait>0){n.wait-=dt;walkAnim(n.g,0,0);return;}n.i=(n.i+1)%n.wp.length;const w=n.wp[n.i];n.path=path(Z.store,n.x,n.z,w[0],w[1]);n.pi=0;n.wait=1+Math.random()*2;return;}
      follow(n,dt,1.3);n.g.rotation.y=angLerp(n.g.rotation.y,n.hd,1-Math.exp(-dt*6));walkAnim(n.g,n.ph,1);n.g.position.set(n.x,0,n.z);});}
  /* joueur */
  let ix=0,iz=0;me.at=null;let actTxt=null,actP=0,actCol='#ff4d6d';
  const ctl=run&&!fading&&!me.out&&me.caught<=0&&!QM.map;const dn=me.down>0,zb=me.zomb>0;
  if(me.caught>0&&run){me.caught-=dt;pl.userData.cuff=true;if(me.caught<=0)qmRelease(me);}else pl.userData.cuff=false;
  if(ctl){
    if(KU.some(function(k){return keys.has(k);}))iz-=1;if(KD.some(function(k){return keys.has(k);}))iz+=1;if(KL.some(function(k){return keys.has(k);}))ix-=1;if(KR.some(function(k){return keys.has(k);}))ix+=1;
    if(Math.hypot(stick.x,stick.y)>.15){ix+=stick.x;iz+=stick.y;}const L=Math.hypot(ix,iz);if(L>1){ix/=L;iz/=L;}
    const hold=(holdB||holdK)&&!dn,tap=hold&&!QM.hold0;QM.hold0=hold;
    if((me.frz||0)>0){ix=iz=0;}QM.bxBusy=false;
    {const wn=!dn&&qmWpNear(me);if(wn&&me.wp){actTxt='🔁 Agir : échanger '+QWP[me.wp].ic+' contre '+QWP[wn.k].ic+' '+QWP[wn.k].n;actCol='#ffd21f';actP=0;if(tap)qmWpSwap(me);}}
    {const tr=!dn&&!actTxt&&!me.cv&&qmTrapNear(me);if(tr){if(hold){QM.bxBusy=true;ix=iz=0;QM.trP=(QM.trId===tr.id?QM.trP||0:0)+dt;QM.trId=tr.id;actTxt=QTRAP[tr.k].ic+' Déclenchement…';actP=QM.trP;actCol='#2ec4b6';if(QM.trP>=1){QM.trP=0;qmTrapFire(me,tr);}}else{QM.trP=0;actTxt=QTRAP[tr.k].ic+' Garde Agir : déclencher '+QTRAP[tr.k].n;actP=0;actCol='#2ec4b6';}}}
    {const bx=!dn&&!actTxt&&QM.BX.find(function(b){return b.zn===cur&&Math.hypot(b.x-pp.x,b.z-pp.z)<1.4;});if(bx){if(hold){QM.bxBusy=true;ix=iz=0;QM.bxP=(QM.bxId===bx.id?QM.bxP||0:0)+dt/(bx.ch?1:2);QM.bxId=bx.id;actTxt=bx.ch?'🧰 Ouverture du coffre…':'📦 Ouverture du carton…';actP=QM.bxP;actCol='#b5874f';if(QM.bxP>=1){QM.bxP=0;if(QM.mp&&QN.client){qnS('a',{pid:QN.pid,k:'boxo',id:bx.id});qmBxDel(bx);}else qmBxOpen(me,bx);}}else{QM.bxP=0;actTxt=bx.ch?'🧰 Garde Agir appuyé pour ouvrir le coffre':'📦 Garde Agir appuyé pour ouvrir le carton';actP=0;actCol='#b5874f';}}}
    {const pl=!dn&&!me.item&&qmIsAr(cur)&&qmPileNear(me);if(pl&&!actTxt){actTxt=QIT[pl.k].ic+' Agir : prendre un projectile';actCol='#ffd21f';actP=0;if(tap)qmPileGrab(me);}}
    if(me.cv){if(tap)qmCvAct();if(me.cv.k==='cad'&&QM.cvSpot>=0&&Z.cv_cad.cv){actTxt='🔍 Agir : fouiller '+Z.cv_cad.cv.spots[QM.cvSpot].n;actCol='#ffd21f';actP=0;}else if(me.cv.k==='cad'&&Z.cv_cad.cv&&Math.hypot(pp.x-Z.cv_cad.cv.door[0],pp.z-Z.cv_cad.cv.door[1])<1.8){actTxt='🔢 Appuie sur Agir : taper le code';actCol='#e5484d';actP=0;}}
    if(me.hide){if(Math.hypot(ix,iz)>.3){qmUnhide(me);qmMsg('Tu sors de ta cachette.');}else{ix=iz=0;actTxt=me.seenBy?'😬 Repéré dans ta cachette : sors et cours !':'👀 Caché : bouge le joystick pour sortir';actP=1;actCol=me.seenBy?'#e5484d':'#2ec4b6';}}
    else if(tap&&!zb&&!me.item&&!QM.R.some(function(r){return r.zn===cur&&qmRingOn(r)&&Math.hypot(r.x-pp.x,r.z-pp.z)<1.15;})&&!(QM.HS&&QM.HS.some(function(x){return x.zn===cur&&Math.hypot(x.x-pp.x,x.z-pp.z)<1&&!x.occ;}))&&qmShelf(me)){qmGrab(me);}
    else if(tap&&QM.HS&&!zb){const hs=QM.HS.find(function(x){return x.zn===cur&&Math.hypot(x.x-pp.x,x.z-pp.z)<1&&!x.occ;});if(hs&&!QM.R.some(function(r){return r.zn===cur&&qmRingOn(r)&&Math.hypot(r.x-pp.x,r.z-pp.z)<Math.hypot(hs.x-pp.x,hs.z-pp.z);})){if(QM.key.st==='held'&&QM.key.by===me){qmMsg('Impossible de te cacher avec la clé !');}else{qmHideIn(me,hs);pp.x=hs.x;pp.z=hs.z;ix=iz=0;}}}
    if(hold&&!me.hide&&!QM.bxBusy){let best=null,bd=QCFG.ringR;
      QM.R.forEach(function(r){if(r.zn!==cur||!qmRingOn(r)||(r.own!==undefined&&r.own!==me.id))return;const d=Math.hypot(r.x-pp.x,r.z-pp.z);if(d<bd){bd=d;best=r;}});
      if(me.role==='imp')QM.REP.forEach(function(p){if(p.zn!==cur)return;const d=Math.hypot(p.x-pp.x,p.z-pp.z);if(d<bd){bd=d;best=p;}});
      if(!QM.meetUsed&&cur==='salle'&&Math.hypot(QM.pup.x-pp.x,QM.pup.z-pp.z)<1.2)best=QM.pup;
      if(best===QM.pup){ix=iz=0;if(QM.key.st==='held'&&QM.key.by===me){me.at=QM.pup;if(!(QM.mp&&QN.client)){QM.pup.prog+=dt/3;QM.pup.touch=QM.clk;}actTxt='Lancer la réunion d\'urgence';actP=QM.pup.prog;actCol='#4fc3f7';if(QM.pup.prog>=1&&!(QM.mp&&QN.client))qmMeeting(me);}else{actTxt='Il faut la clé 🔑 pour lancer la réunion';actP=0;actCol='#8a93a3';}}
      else if(best&&best.m&&QM.REP.indexOf(best)>=0){ix=iz=0;me.at=best;actTxt='Réparer en douce (−'+best.g+' %)';actP=best.prog;actCol='#8a93a3';}
      else if(best){ix=iz=0;me.at=best;const r=best;actP=r.prog;
        if(r.lk>0){actTxt='⚠️ En panne : encore '+Math.ceil(r.lk)+' s';actCol='#8a93a3';actP=0;}
        else if(zb&&r.k!=='mini'&&r.k!=='solo'){actTxt='🧟 Impossible en zombie : seulement les petits sabotages';actCol='#2e8c46';actP=0;}
        else if(r.k==='spec'&&me.cls!=='ele'){actTxt='⚡ Réservé à l\'Électricien';actCol='#8a93a3';}
        else if(me.role==='imp'&&r.k!=='team'){actTxt='Tu fais semblant de saboter…';actCol='#8a93a3';}
        else if(r.k==='team'){const need=(r.solo&&me.cls===r.solo&&!zb)?1:r.need;actTxt=r.n+' · équipe '+r.cnt+'/'+need+(r.cnt<need?' (il faut être '+need+')':'');actCol=r.cnt>=need?'#46d17a':'#ff9f1c';}
        else if(r.k==='pair'){actTxt=r.n+(r.both?' · les 2 alarmes sont tenues !':' · il faut quelqu\'un sur l\'autre alarme');actCol=r.both?'#46d17a':'#ff6a00';}
        else{actTxt=r.n;actCol='#ff4d6d';}}}
    /* course au joystick : pousse a fond = courir (endurance), a moitie = marcher */
    const mv=Math.hypot(ix,iz)>.05,want=(Math.hypot(stick.x,stick.y)>.82||runKey)&&!dn;QM.st=QM.st===undefined?100:QM.st;
    if(QM.stx&&QM.st>=100)QM.stx=false;const running=want&&mv&&(zb||!QM.stx);
    if(QM.cafe>0)QM.cafe-=dt;if(running&&!zb){QM.st-=dt*(me.boost>0||QM.cafe>0?0:100/6);if(QM.st<=0){QM.st=0;QM.stx=true;qmMsg('😮‍💨 Essoufflé ! Tu marches jusqu\'à ce que la barre soit pleine.');}}else if(!running)QM.st=Math.min(100,QM.st+dt*25);
    if(me.slowT>0)me.slowT-=dt;if(me.shCd>0)me.shCd-=dt;const sp2=(me.slowT>0?.5:1)*(dn?1:running?(zb?4.5:6*(me.boost>0?1.3:1)):(zb?2.9:3.6))*(me.jam>0?.7:1)*(!zb&&!dn&&qmAniNear(me)?1.1:1),zn=Z[cur],r0=.38;let nx=pp.x+ix*sp2*dt;if(hit(nx,pp.z,r0,zn))nx=pp.x;let nz=pp.z+iz*sp2*dt;if(hit(nx,nz,r0,zn))nz=pp.z;
    pp.x=clamp(nx,zn.bounds.x[0],zn.bounds.x[1]);pp.z=clamp(nz,zn.bounds.z[0],zn.bounds.z[1]);
    moving=mv;if(mv){pp.face=angLerp(pp.face,Math.atan2(ix,iz),1-Math.exp(-dt*14));pp.ph+=sp2*dt*2.6;}
    walkAnim(pl,pp.ph,Math.min(1,Math.hypot(ix,iz)*1.2)*(running?1.3:1)*(dn?.6:1));
    /* portes */
    let near=false;for(let i=0;i<PORTALS.length;i++){const q=PORTALS[i];if(q.zn!==cur||q.hid)continue;const dd=Math.hypot(pp.x-q.x,pp.z-q.z);if(dd<1.6)near=true;
      if(QM.armed&&dd<.9){QM.armed=false;if(QM.lockZ[q.to]&&QPORT.indexOf(q)>=0){const rm=QROOM.find(function(r){return r.z===q.to;});qmMsg(rm?'🔒 '+rm.n+' : fermé à clé. Trouve la clé 🔑 !':'🔒 '+QZN[q.to]+' : fermé pour l\'instant. Termine l\'objectif en cours 🎯','bad');}else if(QPORT.indexOf(q)<0){qmMsg('🚧 '+(q.label||'Cette zone')+' : fermé pendant la partie rapide.');}else qmPlayerTo(q.to,q.tx,q.tz);break;}}
    if(!near)QM.armed=true;}
  else{walkAnim(pl,0,0);moving=false;}
  {const mt=!QM.auto&&!dn&&!zb&&!me.caught&&!me.hide&&ctl?qmAutoTg(me):null;const HB=$('qmHit');if(mt){const lb='Frapper';const ic=qmCW(me).ic;const h='<span style="font-size:26px;line-height:1">'+ic+'</span><span>'+lb+'</span>';if(HB._h!==h){HB._h=h;HB.innerHTML=h;}HB.hidden=false;HB.classList.toggle('cd',false);}else HB.hidden=true;}
  if(!actTxt&&!dn&&!zb&&!me.caught&&!me.item&&!me.hide&&ctl&&qmShelf(me)){actTxt=(me.grabCd>0?'⏳ Attraper dans '+Math.ceil(me.grabCd)+' s':'🥫 Appuie sur Agir : attraper');actP=0;actCol='#4fc3f7';}
  if(!actTxt&&!dn&&!me.cv&&QM.freeR&&QM.A.some(function(a){return a.cv;})&&cur===QM.freeR.zn&&Math.hypot(pp.x-QM.freeR.x,pp.z-QM.freeR.z)<QCFG.ringR){actTxt='🔓 Libère les convoqués · '+QM.freeR.n+'/2'+(QM.freeR.n<2?' : il faut être 2 !':'');actP=QM.freeR.prog;actCol='#46d17a';}
  if(dn&&!me.caught){actTxt=me.rev>0?'💪 On te relève… '+Math.round(me.rev*100)+' %':'🆘 À terre : un collègue doit venir à côté de toi ('+Math.ceil(me.down)+' s)';actP=me.rev>0?me.rev:me.down/QCFG.downT;actCol=me.rev>0?'#46d17a':'#e5484d';}
  else if(zb&&me.cure>0){actTxt='🩺 Soins… '+Math.round(me.cure*100)+' %';actP=me.cure;actCol='#46d17a';}
  else if(!actTxt&&!dn&&!zb&&!me.caught){const dd=QM.A.find(function(b){return b!==me&&b.down>0&&!(b.caught>0)&&b.zn===cur&&Math.hypot(b.x-pp.x,b.z-pp.z)<1.4;});if(dd){actTxt='🤝 Tu relèves '+dd.name+'… '+Math.round(dd.rev*100)+' %';actP=dd.rev;actCol='#46d17a';}else if(me.cls==='sst'){const zz=QM.A.find(function(b){return b!==me&&b.zomb>0&&!(b.caught>0)&&b.zn===cur&&Math.hypot(b.x-pp.x,b.z-pp.z)<1.4;});if(zz){actTxt='💚 Tu soignes '+zz.name+'… '+Math.round(zz.cure*100)+' %';actP=zz.cure;actCol='#46d17a';}}}
  me.zn=cur;me.x=pp.x;me.z=pp.z;me.h=pp.face;
  if(!QM._mp&&!(QM.mp&&QN.client)){QM._mp=1;qmMiniPick();}if(!(QM.mp&&QN.client)&&!QM.paused){QM._mpt=(QM._mpt||0)-dt;if(QM._mpt<=0){QM._mpt=3;qmMiniPick();}qmQTick(dt);}if(!QM.paused){if(!QM.CV)qmCvInit();qmCvTick(dt);}
  qmRings(run?dt:0);qmKey(dt);qmPortals(run?dt:0);qmRadar();qmItems(run?dt:0);if(run){qmFoes(dt);qmBossTick(dt);qmBxTick(dt);qmAutoTick(dt);qmFunTick(dt);qmToysTick(dt);qmTrapTick(dt);}
  qmQuestHud(dt);{const tgt=me.item&&QIT[me.item].t&&!QM.map&&!zb&&!dn?qmThrowTg(me,10,1):null;QM.aim.visible=!!tgt;if(tgt){QM.aim.position.set(tgt.x,3.6+Math.sin(QM.clk*6)*.1,tgt.z);}}{const dk=$('qmDark');if(dk){const on=!!(QM.dark&&(QM.dark.zn===cur||QM.dark.zn==='*')&&!QM.map);if(dk.hidden===on)dk.hidden=!on;}}QM.inf.m.g.visible=false;QM.inf.m.lb.sp.visible=!QM.map;QM.inf.m.ring.rotation.z+=dt;if(run)qmFX(dt);if(QM.doorT>0){QM.doorT-=dt;if(QM.doorT<=0){try{dirDoor.visible=true;}catch(_){}}}
  /* affichage */
  pl.position.set(pp.x,0,pp.z);pl.rotation.y=pp.face;qmBody(pl,me,dt);qmTags();pl.visible=!me.out&&!me.hide&&!QM.cine;
  ring.visible=arrow.visible=!me.out&&!QM.cine;ring.position.set(pp.x,.05,pp.z);arrow.position.set(pp.x,2.7+Math.sin(clk*4)*.08,pp.z);ring.material.color.setHex(me.down>0?0xe5484d:me.zomb>0?0x2e8c46:me.inv>0?0x9b8cff:0x7ee0a8);
  QM.A.forEach(function(a){if(a.human)return;a.g.visible=!a.out&&!a.hide&&(a.zn===cur||QM.map);qmBody(a.g,a,dt);});
  if(QM.HS)QM.HS.forEach(function(h){h.m.g.visible=h.zn===cur&&!QM.map;h.m.disc.material.opacity=h.occ?.6:.3;});
  QM.H.forEach(function(h){const v=h.zn===cur||QM.map;h.g.visible=v;h.mi.visible=QM.map;h.mi.position.set(h.x,7,h.z);h.cg.visible=v&&QM.decoy<=0&&!(h.blind>0)&&!QM.map;h.cg.position.set(h.x,0,h.z);h.cg.rotation.y=h.h;tintCone(h.cone,h.st==='chase',h.dir?0xe5484d:0xffd84a);setMood(h.g,h.st==='chase'?'angry':'neutral');});
  Object.keys(Z).forEach(function(id){Z[id].g.visible=QM.map?QZ.indexOf(id)>=0:id===cur;});QM.meMi.visible=QM.map&&!me.out;QM.meMi.position.set(pp.x,8,pp.z);QM.ZL.forEach(function(l,i){l.visible=QM.map&&!(QM.lockZ[QZ[i]]&&0);});
  const ab=$('act');if(actTxt){ab.hidden=false;$('actL').textContent=actTxt;$('actF').style.width=Math.round(clamp(actP,0,1)*100)+'%';$('actF').style.background=actCol;}else ab.hidden=true;
  /* camera */
  const asp=camera.aspect,lf=(asp<=.9?1:Math.max(.42,1-(asp-.9)*.46))*1.27;
  if(QM.map){const B=QM.mapZ?{x0:Z[QM.mapZ].bounds.x[0],x1:Z[QM.mapZ].bounds.x[1],z0:Z[QM.mapZ].bounds.z[0],z1:Z[QM.mapZ].bounds.z[1]}:QM.MB,w=(B.x1-B.x0)*1.08,d=(B.z1-B.z0)*1.12,tn=Math.tan(18*Math.PI/180),H=Math.max(d/(2*tn),w/(2*tn*asp));const cx=(B.x0+B.x1)/2,cz=(B.z0+B.z1)/2;tPos.set(cx,H,cz+H*.12);tLook.set(cx,0,cz);}
  else if(!QM.cine){const cn=QM.camNear?1:0;tPos.set(pp.x,.4+(CAMH-.4)*lf*(cn?.42:.98),pp.z-.6+(CAMZ+.6)*lf*(cn?.62:.99));tLook.set(pp.x,cn?1.1:.4,pp.z-(cn?1.6:.6));}
  const k=1-Math.exp(-dt*(QM.map||QM.mapOut>0?6:3.2));if(QM.mapOut>0)QM.mapOut-=dt;camPos.lerp(tPos,k);camLook.lerp(tLook,k);camera.position.copy(camPos);camera.lookAt(camLook);if(QM.shake>0){QM.shake-=dt;camera.position.x+=(Math.random()-.5)*.35;camera.position.y+=(Math.random()-.5)*.25;}
  sun.castShadow=true;sun.position.set(camLook.x+10,26,camLook.z+8);sun.target.position.set(camLook.x,0,camLook.z);
  {const jm=me.jam>0;const fx=$('qmJamFx');if(fx&&fx.hidden===jm)fx.hidden=!jm;const f=jm?'blur(2.5px) contrast(1.35) saturate(.35)':'';if(renderer.domElement.style.filter!==f)renderer.domElement.style.filter=f;
    if(jm){camera.position.x+=(Math.random()-.5)*.5;camera.position.y+=(Math.random()-.5)*.35;}}
  qmHud();}
/* ---------- ecran de choix du jeu (premier menu) ---------- */
function qmGameScreen(){const a=$('acc');a.hidden=false;$('creator').hidden=true;$('crTitle').hidden=true;a.className='menu';
  a.innerHTML='<div class="accw"><h2 class="ttl" style="text-align:center;margin:6px 0 4px">À quoi tu joues ?</h2><div class="gpick">'
    +'<button class="gcard" data-a="gplay" data-g="edm"><b>🏬 Employé du Mois</b><span>Le jeu de carrière : bosse ou fais le branleur, vole, balance tes collègues, deviens manager… Le magasin continue de vivre entre deux connexions.</span></button>'
    +'<button class="gcard rf" data-a="gplay" data-g="fm"><b>⚡ Opération Rideau de fer<i>NOUVEAU</i></b><span>Partie rapide de 10 min à 8 employés : sabotez le magasin jusqu\'à faire tomber le rideau de fer, échappez à la directrice… et démasquez les 2 traîtres cachés parmi vous.</span></button>'
    +'</div>'+qmInstBtn()+'</div>';
  const ib=a.querySelector('#qmInst');if(ib)ib.addEventListener('click',qmInstall);}
/* ---- bouton « Installer l'appli » (version servie par Cloudflare, pas dans itch.io ni l'aperçu) ---- */
try{window.addEventListener('beforeinstallprompt',function(e){e.preventDefault();window.__bip=e;});window.addEventListener('appinstalled',function(){window.__bip=null;window.__inst=1;try{if(ACCST==='game')qmGameScreen();}catch(_){}});}catch(_){}
function qmStandalone(){try{return window.matchMedia('(display-mode: standalone)').matches||window.matchMedia('(display-mode: fullscreen)').matches||navigator.standalone===true;}catch(_){return false;}}
function qmInstOk(){try{if(window.__inst||qmStandalone()||window.top!==window)return false;if(!(location.protocol==='https:'||location.hostname==='localhost'))return false;return !/claude|itch|usercontent|anthropic/i.test(location.hostname);}catch(_){return false;}}
function qmInstBtn(){if(!qmInstOk())return '';return '<button class="ginst" id="qmInst">📲 Installer l\'appli<small>Une icône sur ton écran d\'accueil, comme une vraie appli</small></button><div class="ginsth" id="qmInstH" hidden></div>';}
function qmIOS(){return /iPhone|iPad|iPod/i.test(navigator.userAgent)||(navigator.platform==='MacIntel'&&navigator.maxTouchPoints>1);}
async function qmInstall(){const h=$('qmInstH');
  if(window.__bip){const e=window.__bip;window.__bip=null;try{await e.prompt();const r=await e.userChoice;if(r&&r.outcome==='accepted'){window.__inst=1;if(h){h.hidden=false;h.innerHTML='✅ C\'est installé ! Lance le jeu depuis la nouvelle icône sur ton écran d\'accueil.';}return;}}catch(_){}}
  if(!h)return;h.hidden=false;
  h.innerHTML=qmIOS()?'<b>Sur iPhone :</b><br>1. Appuie sur le bouton <b>Partager</b> <span style="font-size:18px">⬆️</span> en bas de Safari.<br>2. Choisis <b>« Sur l\'écran d\'accueil »</b>, puis <b>Ajouter</b>.'
    :'<b>Pour installer :</b><br>1. Appuie sur les <b>⋮</b> en haut à droite de Chrome.<br>2. Choisis <b>« Installer l\'application »</b> ou <b>« Ajouter à l\'écran d\'accueil »</b>.';}

/* ================= Lot E/F : moteur de cartes + Hyper des Quatre-Chemins ================= */
const QMAPS={classic:{n:'Super du Centre',ic:'🏪'},hyper:{n:'Hyper des Quatre-Chemins',ic:'🏬'}};
Object.assign(QMN,{eteindre:['Éteindre les lampadaires'],caddies:['Disperser les caddies'],pneu:['Dégonfler un pneu'],essence:['Couper la pompe à essence'],nettoyer:['Salir le portique de lavage'],dpanne:['Bloquer la barrière'],coffre:['Ouvrir un coffre de voiture'],loclaver:['Couper le portique de lavage'],
  telv:['Débrancher les téléphones de démo'],telc:['Mélanger les coques'],telf:['Inverser les étiquettes de forfaits'],drivek:['Mélanger les commandes du drive'],lavage:['Couper l\'eau du lavage']});
QHN.parking=['Derrière une voiture','Dans l\'abri à caddies','Derrière la borne'];
function qmPickMap(){try{const f=localStorage.getItem('edm_qmmap');if(f&&QMAPS[f])return f;}catch(_){}const k=Object.keys(QMAPS);return k[(Math.random()*k.length)|0];}
function qmNoPool(id,x,z){const N=QM.MAP&&QM.MAP.noPool;if(N)return id===N.zn&&x>N.x0&&x<N.x1&&z>N.z0&&z<N.z1;return id==='office'&&x>29.3&&x<38.2&&z<-34.1;}
function qmApplyMap(id,opts){if(QM.mapApplied)return;QM.mapApplied=id;QM.MAP={id:id,n:QMAPS[id].n,ic:QMAPS[id].ic};
  /* parking : ouvert a partir de 6 vrais joueurs */
  const nh=opts&&opts.roster?opts.roster.filter(function(r){return r.pid;}).length:1;QM.park=nh>=6||(function(){try{return localStorage.getItem('edm_qmpark')==='1';}catch(_){return false;}})();
  if(id==='hyper')qmBuildHyper();
  if(QM.park&&QZ.indexOf('parking')<0)QZ.push('parking');QZN.parking='🅿️ Parking';}
/* ---------- l'hypermarche ---------- */
function qmBuildHyper(){const OX=2000,X=function(x){return OX+x;};
  ['store','reserve','office','salle','boulangerie','poissonnerie','parking'].forEach(function(id){const o=Z[id];if(o){o.g.visible=false;scene.remove(o.g);}});
  PORTALS.length=0;
  const ZN=function(id,name,b,sp){zone(id,name,0,{x:[X(b[0]),X(b[1])],z:[b[2],b[3]]},{x:X(sp[0]),z:sp[1]});return Z[id];};
  const W=function(zn,x0,x1,z0,z1,h,col,sh){box(zn.g,x1-x0,h,z1-z0,col,X((x0+x1)/2),h/2,(z0+z1)/2,sh!==false);zn.obs.push({a:X(x0),b:X(x1),c:z0,d:z1});};
  const D=function(zn,x,z,w,h,d,col,y){box(zn.g,w,h,d,col,X(x),(y||0)+h/2,z,false);};
  const M=function(zn,obj,x,z){zn.markers.push({obj:obj,x:X(x),z:z,g:{visible:false}});};
  const FLT=function(zn,x0,x1,z0,z1,a,b){floor(zn,x1-x0,z1-z0,X((x0+x1)/2),(z0+z1)/2,tileTex(a,b,x1-x0,z1-z0));};
  const FL=function(zn,x0,x1,z0,z1,col){box(zn.g,x1-x0,.1,z1-z0,col,X((x0+x1)/2),-.05,(z0+z1)/2,false);};
  const TL=function(zn,txt,x,y,z,bg){const l=label(txt,{sx:1.9,sy:.5,w:256,h:68,size:32,depth:true,bg:bg});l.position.set(X(x),y,z);zn.g.add(l);};
  const PC=[0xe5484d,0xf2c230,0x3b82f6,0x10b981,0x8b5cf6,0xf59e0b,0xffffff,0xff7aa8];
  const H1=[0xe63946,0x2f80ed,0x2a9d8f,0xf4a261,0x8e44ad,0xd62839];
  /* gondole verticale (le long de z) et horizontale (le long de x), mêmes que le magasin d'origine */
  const gv=function(zn,x,z0,z1,w,head,title){const g=zn.g,len=z1-z0,cz=(z0+z1)/2,xx=X(x);ao(g,xx,cz,w+2,len+2,.45);
    box(g,.3,2.05,len,0x8b95a1,xx,1.02,cz,true);box(g,w,.2,len,0xe4e7ec,xx,2.12,cz,true);[-1,1].forEach(function(sd){box(g,.14,.22,len+.02,head,xx+sd*(w/2-.07),2.12,cz,false);});box(g,w-.1,.14,len,0x5c6672,xx,.07,cz,true);
    const pw=Math.min(.5,w/2-.1);[-1,1].forEach(function(s){[.42,.88,1.34,1.8].forEach(function(lv){box(g,w/2-.1,.05,len,0xaeb7c2,xx+s*w/4,lv-.28,cz,false);
      for(let zz=z0+.3;zz<z1-.15;zz+=.5){const hh=.24+rnd()*.14;addProd(s>0?0:1,xx+s*(w/4+.02),lv-.25+hh/2,zz,pw,hh,.45);}});});
    zn.obs.push({a:xx-w/2,b:xx+w/2,c:z0,d:z1});if(title){const tl=label(title,{sx:1.9,sy:.5,w:256,h:68,size:32,depth:true});tl.position.set(xx,3.1,z1+.45);g.add(tl);}};
  const gh=function(zn,z,x0,x1,w,head,title){const g=zn.g,len=x1-x0,cx=X((x0+x1)/2);ao(g,cx,z,len+2,w+2,.45);
    box(g,len,2.05,.3,0x8b95a1,cx,1.02,z,true);box(g,len,.2,w,0xe4e7ec,cx,2.12,z,true);[-1,1].forEach(function(sd){box(g,len+.02,.22,.14,head,cx,2.12,z+sd*(w/2-.07),false);});box(g,len,.14,w-.1,0x5c6672,cx,.07,z,true);
    const pw=Math.min(.5,w/2-.1);[-1,1].forEach(function(s){[.42,.88,1.34,1.8].forEach(function(lv){box(g,len,.05,w/2-.1,0xaeb7c2,cx,lv-.28,z+s*w/4,false);
      for(let xx=X(x0)+.3;xx<X(x1)-.15;xx+=.5){const hh=.24+rnd()*.14;addProd(s>0?4:5,xx,lv-.25+hh/2,z+s*(w/4+.02),.45,hh,pw);}});});
    zn.obs.push({a:X(x0),b:X(x1),c:z-w/2,d:z+w/2});if(title){const tl=label(title,{sx:1.9,sy:.5,w:256,h:68,size:32,depth:true});tl.position.set(X(x0)-.9,3.1,z);g.add(tl);}};
  /* gondole adossee au mur (une seule face) */
  const gw=function(zn,z,x0,x1,face,head,title){const g=zn.g,len=x1-x0,cx=X((x0+x1)/2);box(g,len,2.4,.3,0x8b95a1,cx,1.2,z,true);box(g,len,.25,.7,head,cx,2.5,z+face*.2,false);
    [.42,.88,1.34,1.8].forEach(function(lv){box(g,len,.05,.55,0xaeb7c2,cx,lv-.28,z+face*.35,false);for(let xx=X(x0)+.3;xx<X(x1)-.15;xx+=.5){const hh=.26+rnd()*.14;addProd(face>0?4:5,xx,lv-.25+hh/2,z+face*.36,.45,hh,.5);}});
    zn.obs.push({a:X(x0),b:X(x1),c:Math.min(z,z+face*.7),d:Math.max(z,z+face*.7)});if(title)TL(zn,title,(x0+x1)/2,3.2,z+face*.3);};
  /* gondole en epi (en diagonale) : un groupe tourne, collision en marches */
  const ge=function(zn,cx,cz,len,ang,head,title){const sub=new T.Group();sub.position.set(X(cx),0,cz);sub.rotation.y=ang;zn.g.add(sub);const w=1.2;
    box(sub,.3,2.05,len,0x8b95a1,0,1.02,0,true);box(sub,w,.2,len,0xe4e7ec,0,2.12,0,true);[-1,1].forEach(function(sd){box(sub,.14,.22,len+.02,head,sd*(w/2-.07),2.12,0,false);});
    [-1,1].forEach(function(s){[.42,.88,1.34,1.8].forEach(function(lv){box(sub,w/2-.1,.05,len,0xaeb7c2,s*w/4,lv-.28,0,false);for(let zz=-len/2+.3;zz<len/2-.15;zz+=.5){const hh=.24+rnd()*.14;addProd(s>0?0:1,s*(w/4+.02),lv-.25+hh/2,zz,.5,hh,.45);}});});
    flushProd(sub);const n=Math.ceil(len/1.1);for(let i=0;i<n;i++){const t=(i+.5)/n-.5,px=X(cx)+Math.sin(ang)*t*len,pz=cz+Math.cos(ang)*t*len;zn.obs.push({a:px-.55,b:px+.55,c:pz-.55,d:pz+.55});}
    if(title){const tl=label(title,{sx:1.9,sy:.5,w:256,h:68,size:32,depth:true});tl.position.set(X(cx),3.1,cz);zn.g.add(tl);}};
  const crate=function(zn,x,z,w,d,col){W(zn,x-w/2,x+w/2,z-d/2,z+d/2,.75,0xb5835a);for(let i=0;i<Math.round(w/.5);i++)for(let j=0;j<Math.round(d/.5);j++)box(zn.g,.38,.2,.38,col[(i+j)%col.length],X(x-w/2+.25+i*.5),.85,z-d/2+.25+j*.5,false);};
  const pal=function(zn,x,z,n,col,solid){if(solid!==false)zn.obs.push({a:X(x-.65),b:X(x+.65),c:z-.55,d:z+.55});box(zn.g,1.3,.14,1.1,0xb08a5a,X(x),.07,z,true);for(let k=0;k<(n||2);k++)for(let i=0;i<2;i++)for(let j=0;j<2;j++)box(zn.g,.6,.42,.52,col||0xc9a26b,X(x-.32+i*.64),.36+k*.44,z-.27+j*.54,k===0);};
