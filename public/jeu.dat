const OBS0=obs,MARK0=marker;let PZFLOOR=null,PZG=null,PTG=null,PTD=null,ONB=false,PNG=0,PNGCD=0,BRK=0,OVT=0,PCD=0,IMM=false,DVIS=60,OVW=false,PTS=0,SLK=0,SLP=null,WCKT=0,TIPT=30;
(function(){
  const DX=76.4,pg=new T.Group();pg.position.x=DX;O.g.add(pg);PZG=pg;const g=pg;
  function obs(zn,x,z,w,d){return OBS0(O,x+DX,z,w,d);}function marker(zn,o,x,z,t){return MARK0(O,o,x+DX,z,t);}
  const pf=new T.Mesh(new T.PlaneGeometry(22,18),new T.MeshPhongMaterial({map:tileTex('#dccaa5','#c4b28d',11,9),shininess:55,specular:0x3a3a3a}));pf.rotation.x=-Math.PI/2;pf.position.set(-27,0,-34);pf.receiveShadow=true;pf.userData.zone='office';pg.add(pf);PZFLOOR=pf;
  box(g,22.8,5,.4,0xe6dcc8,-27,2.5,-43.2,true);
  box(g,.4,5,8.2,0xdfd5c0,-16.2,2.5,-39.1,true);box(g,.4,5,8.2,0xdfd5c0,-16.2,2.5,-28.9,true);box(g,.4,1.6,1.8,0xdfd5c0,-16.2,4.2,-34,false);
