const CASH={'Léa':1,'Tom':1};
function fidget(e,dt){if(!e.name||e.out>0||e.flee>0||e.help||e.tk||e.zn!==cur||mode!=='zone')return false;
 if(e.hx===undefined){e.hx=e.x;e.hz=e.z;}
 const cash=!!CASH[e.name];
 if(!e.fd){e.fdc=(e.fdc===undefined?Math.random()*2:e.fdc)-dt;if(e.fdc>0)return false;
  if(Math.hypot(e.x-e.hx,e.z-e.hz)>3.5||(cash&&Math.hypot(e.x-e.hx,e.z-e.hz)>.3)){const pa=path(Z[e.zn],e.x,e.z,e.hx,e.hz);if(pa){e.path=pa;e.pi=0;e.fd={x:e.hx,z:e.hz,home:1};e.fdc=.2;}else{e.hx=e.x;e.hz=e.z;}}
  else if(!cash){e.fdc=.3+Math.random()*.9;const a=Math.random()*6.283,r=1+Math.random()*2,tx=e.hx+Math.cos(a)*r,tz=e.hz+Math.sin(a)*r;if(hit(tx,tz,.45,Z[e.zn]))return false;e.fd={x:tx,z:tz};}
  else return false;}
 if(e.fd.home){const done=follow(e,dt,1.6);try{e.g.rotation.y=angLerp(e.g.rotation.y,e.hd,1-Math.exp(-dt*8));walkAnim(e.g,e.ph,1);e.g.position.set(e.x,0,e.z);}catch(_){}if(done){e.fd=null;e.path=null;if(cash){try{e.g.rotation.y=Math.PI;}catch(_){}}}return true;}
 const dx=e.fd.x-e.x,dz=e.fd.z-e.z,d=Math.hypot(dx,dz);if(d<.08){e.fd=null;return false;}
 const st=Math.min(d,1.3*dt);e.x+=dx/d*st;e.z+=dz/d*st;e.ph=(e.ph||0)+dt*6;
 try{e.g.rotation.y=angLerp(e.g.rotation.y,Math.atan2(dx,dz),1-Math.exp(-dt*8));walkAnim(e.g,e.ph,.9);e.g.position.set(e.x,0,e.z);}catch(_){}
 return true;}
function fidgetAll(dt){if(globalThis.__nonpc||mode!=='zone')return;EMP.forEach(function(e){if(e.wp||e.zn!==cur)return;if(evade(e,dt))return;fidget(e,dt);});actLabels(dt);}
