function behindD(maxd){if(cur!==D.zn||D.rage>0||D.stun>0||mode!=='zone')return false;const dx=pp.x-D.x,dz=pp.z-D.z,d=Math.hypot(dx,dz);if(d>maxd||d<.3)return false;return (Math.sin(D.h)*dx+Math.cos(D.h)*dz)/d<-.35;}
const grimS=label('\ud83d\ude1c',{sx:1,sy:1,w:96,h:96,size:62,bg:'rgba(255,236,150,.96)'});grimS.visible=false;scene.add(grimS);let grimT=0,GKB='';
function grimTarget(){if(mode!=='zone'||WCIN)return null;if(rank<1&&!KEY&&KEYCD<=0&&!keyHolder()&&behindD(2.6))return {w:'d',key:1,t:'la directrice'};if(grimCD>0)return null;
  const bh=function(x,z,h,md){const dx=pp.x-x,dz=pp.z-z,d=Math.hypot(dx,dz);if(d>md||d<.3)return false;return (Math.sin(h)*dx+Math.cos(h)*dz)/d<-.35;};
  if(SEC){for(let i=0;i<MGR.length;i++){const m=MGR[i];if(m.zn===cur&&!m.fired&&m.stun<=0&&bh(m.x,m.z,m.g.rotation.y,2.4))return {w:'v',k:'m',o:m,t:m.name};}for(let i=0;i<EMP.length;i++){const e=EMP[i];if((e.out<=0||!e.out)&&e.zn===cur&&bh(e.x,e.z,e.g.rotation.y,2.4))return {w:'v',k:'e',o:e,t:e.name};}return null;}
  if(behindD(2.6)){if(rank<1)return (!KEY&&KEYCD<=0&&!keyHolder())?{w:'d',key:1,t:'la directrice'}:null;return {w:'d',b:6,t:'la directrice'};}
  for(let i=0;i<MGR.length;i++){const m=MGR[i];if(m.zn===cur&&!m.fired&&m.stun<=0&&m.state!=='insp'&&bh(m.x,m.z,m.g.rotation.y,2.4)){if(rank<1)return (LOOT.length&&!m.loot)?{w:'m',plant:1,m:m,t:m.name}:null;return {w:'m',b:4,t:m.name};}}
  if(rank>=1){for(let i=0;i<EMP.length;i++){const e=EMP[i];if(e.out<=0||!e.out){if(e.zn===cur&&bh(e.x,e.z,e.g.rotation.y,2.4))return {w:'e',b:2,t:e.name};}}}
  return null;}
function grimace(){const tg=grimTarget();if(!tg){toast('Il faut être juste derrière quelqu\'un, dans son dos.');return;}
  if(tg.w==='v'){if(VG.tz>0&&!(VG.tzcd>0)){taserHit(tg.o,tg.k);return;}vSurprise(tg);return;}
  if(tg.plant){const m=tg.m;m.loot=LOOT.pop()||{};m.lootG=9;if(!m.lb){m.lb=label('🎁',{sx:.7,sy:.7,w:96,h:96,size:54,bg:'rgba(255,169,77,.96)'});m.lb.position.set(0,2.8,0);m.g.add(m.lb);}addB(10);pop('🎁 Objet glissé sur '+m.name+' !','good');toast('Tu planques ton butin dans la poche de '+m.name+' : il ne s\'est rendu compte de rien. Qu\'un vigile le croise… +10 branleur');return;}
  if(tg.key){setKey(true);KEYT=60;KEYW=false;KEYCD=15;addB(8);pop('🔑 Clé piquée ! 1 min','good');toast('Clé piquée : tu as 1 min pour ouvrir la porte de service ou la sortie de la réserve. +8 branleur');return;}
  grimCD=12;grimT=1.6;addB(tg.b);toast('Grimace dans le dos de '+tg.t+' ! +'+tg.b+' branleur');}
