let CONN=0,WKCD=-99,SEENT=0,WALKT=0,WPX=0,WPZ=0,NOCOIN=0;let LVL=1,LVM=1;const LT={e:{b:1,w:1},m:{b:1,w:1}};let BALK='';
function lvSync(){LVL=LT.e.b;LVM=LT.m.b+LT.m.w-1;}
function balInfo(){const T=rank>=1?LT.m:LT.e,d=T.b-T.w;
  if(globalThis.__nobal||rank<1)return {k:'',f:{b:1,w:1},t:''};
  if(Math.abs(d)<=1&&T.b>=2&&T.w>=2)return {k:'ok',f:{b:1.2,w:1.2},t:'🎭💼 Double jeu : +20 % de points, tes deux côtés sont bien équilibrés.'};
  if(d>=3)return {k:'b',f:{b:.75,w:1},t:'⚠ Trop branleur : −25 % de points de branleur. Bosse aussi un peu !'};
  if(d<=-3)return {k:'w',f:{b:1,w:.75},t:'⚠ Trop bosseur : −25 % de points de bosseur. Fais aussi des conneries !'};
  return {k:'',f:{b:1,w:1},t:'Monte les deux jauges : dès le niveau 2 des deux, bonus « Double jeu » (+20 %). Plus de 2 niveaux d\'écart : −25 % sur le côté dominant.'};}
function balPts(n,tr){if(n<=0)return n;const f=balInfo().f[tr];if(f===1)return n;const v=n*f,b=Math.floor(v);return b+(Math.random()<v-b?1:0);}
function lvCum(l,mg){return Math.round((mg?.6:1)*(50*l*(l+1)));}
function lvNeed(l,mg){return lvCum(l,mg===undefined?rank>=1:mg);}
function lvBase(l,mg){return l<=1?0:lvCum(l-1,mg===undefined?rank>=1:mg);}
function curNeed(){return lvNeed(rank>=1?LVM:LVL);}
function itemTr(it){return it.tr||(it.t==='m'?'w':it.t);}
function itemReq(it){return Math.ceil((it.lv+1)/2);}
function itemOK(it){const T=it.t==='m'?LT.m:LT.e,tr=itemTr(it),q=itemReq(it);if(it.t!=='m')return T.b>=q;return tr==='x'?(T.b>=q&&T.w>=q):(T[tr]||1)>=q;}
function lockTxt(it){const tr=itemTr(it),pr=' · '+it.p+' 🪙';if(it.t!=='m')return '🔒 Niveau '+itemReq(it)+pr;return '🔒 '+(tr==='x'?'Bosseur + Branleur':tr==='b'?'Branleur':'Bosseur')+' niv. '+itemReq(it)+pr;}
function lvCheck(){if(mode!=='zone'&&mode!=='map')return;if(VIGI)return;
  const mg=rank>=1,T=mg?LT.m:LT.e,ups=[];
  while(SB>=lvNeed(T.b)){T.b++;if(ups.indexOf('b')<0)ups.push('b');}
  if(mg)while(SW>=lvNeed(T.w)){T.w++;if(ups.indexOf('w')<0)ups.push('w');}
  const bk=balInfo().k;if(bk!==BALK){const first=BALK==='';BALK=bk;if(!first||bk)toast(balInfo().t);}
  if(!ups.length)return;lvSync();
  const names=[];ups.forEach(function(tr){const lv=T[tr];ITEMS.forEach(function(i){if((i.t==='m')!==mg)return;const it=itemTr(i);if(itemReq(i)!==lv)return;if(!mg||it===tr||(it==='x'&&T.b>=lv&&T.w>=lv))names.push(i.ic+' '+i.n);});});
  pop('⭐ Niveau '+(mg?LVM:LVL)+' !','good');
  toast(ups.map(function(tr){return mg?((tr==='b'?'Branleur':'Bosseur')+' niveau '+T[tr]+' (prochain à '+lvNeed(T[tr])+')'):('Niveau '+T[tr]+' (prochain à '+lvNeed(T[tr])+' points)');}).join(' · ')+(names.length?' · Nouveaux items : '+names.join(', ')+(mg?'':' (à acheter aux toilettes)'):'')+'.');if(PHN)renderPhone();}
function openPhone(tab){if(rank>=1&&(!tab||tab==='shop'))tab='msg';PHN=tab||PHN||(rank<1?'inv':'shop');if(PHN==='msg')MSG.forEach(function(m){m.read=true;});$('phone').querySelector('.sbar').lastElementChild.textContent=rank>=1?'4G':(WCIN?'🔒 Toilettes · 4G':'Achats : toilettes · 4G');$('phTime').textContent=$('clock').textContent;uiOpen=true;$('phone').hidden=false;renderPhone();}
function closePhone(){PHN=null;uiOpen=!!(MG||PAN);$('phone').hidden=true;}
let PA={step:'mauth'};
/* ---------- v227 : onglets de la boutique et de l'inventaire, objets « mise en valeur » en points de branleur ---------- */
const EWP={carnet:1,badge:5,cv:2,relax:3,formation:10,dossier:10,avocat:5,sponsor:17,post:2,cafeine:2,stylo:1,cravate:5,tableau:3,mentor:6,reseau:5,coupe:10,cabinet:15,parrain:20,piston:40,leche:3,cafeboss:2,repos:5,gateau:4,heures:7,rapport:3,alibi:2,doublejeu:5,taupe:8};
function empTxt(m){return m.replace(/\s*,?\s*(?:Sérieux\s*\+\d+(?:\s*\(\+\d+\))?|\+\d+\s*de\s*Sérieux|\+\d+\s*bosseur|\+\d+\s*branleur|:?\s*ton Sérieux passe à 100\s*!?)/g,'').replace(/(?:et|,)\s*(?=[.,!])/g,'').replace(/\s*:\s*(?=[.!])/g,'').replace(/\s*,\s*(?=[.,!])/g,'').replace(/\s+([.!])/g,'$1').replace(/\s{2,}/g,' ').replace(/[.\s]+$/,'');}
const DESCO={piston:'Un coup de pouce monumental : tout le monde te regarde autrement.',avocat:'Annule 1 blâme.',badge:'Tu épingles ton badge d\'employé modèle.',cv:'Tu retouches ton CV : ça se remarque.',formation:'Une formation express : tu en sors plein d\'idées.',dossier:'Un dossier sans la moindre faute.',sponsor:'Un directeur parle de toi en bien.',post:'Un post-it motivant sur l\'écran.',cafeine:'Un double expresso pour carburer.',stylo:'Un beau stylo plume : tu fais très sérieux.',cravate:'La cravate du lundi : on te prend au sérieux.',tableau:'Ton tableau de bord est impeccable.',mentor:'Un mentor te défend.',reseau:'Ton carnet d\'adresses fait des merveilles.',coupe:'Une belle coupe à exposer sur ton bureau.',cabinet:'Un cabinet de coaching t\'accompagne.',parrain:'Un parrain à la direction pousse ton dossier.',leche:'À utiliser près d\'un manager : lèche-cul de compétition (tes collègues lèvent les yeux au ciel).',cafeboss:'À offrir à un manager proche : il remonte un peu en réputation.',repos:'Tu viens bosser ton jour de repos. Personne ne te remerciera.',rapport:'À envoyer depuis un ORDINATEUR : +5 pièces.',doublejeu:'Tu fais semblant de tout faire bien pendant que tu prépares un coup : +15 pièces.'};
function itDesc(it){return noSW(itDesc0(it));}
function itDesc0(it){if(rank>=1||it.t==='m'||EWP[it.id]===undefined)return it.d;const b=DESCO[it.id]||empTxt(it.d);return b+(/[.!]$/.test(b)?' ':'. ')+'+'+EWP[it.id]+' branleur.';}
const CATE=[['all','Tout','🗂️'],['acc','Accessoires','🎒'],['sab','Sabotages','🔧'],['hack','Piratages','💻'],['den','Dénonciations','📣'],['disc','Discrétion','🕴️'],['val','Mise en valeur','💼']];
const CATM=[['all','Tout','🗂️'],['surv','Surveillance','🔭'],['ordre','Ordres d\'équipe','📋'],['emp','Coups aux employés','🎯'],['mgr','Coups aux managers','🗡️'],['perso','Pour soi','💰'],['dir','Directeur','👑']];
