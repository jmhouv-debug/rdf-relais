  box(S.g,.6,.12,.8,0xdfe6ee,-19.4,1.06,-5.9,false);box(S.g,.06,.2,.34,0x2a9d8f,-19.1,1.22,-5.9,false);box(S.g,.4,.16,.5,0xc0c8d2,-19.45,1.16,-5.9,false);marker(S,'tare',-18.5,-6.4,'Balance');
  {const pl=label('Pesée',{sx:1.6,sy:.5,w:200,h:64,size:28,depth:true});pl.position.set(-19.4,2.1,-5.9);S.g.add(pl);}
