function netSbBroadcast(event,payload){try{const ws=NET.ws;if(!ws||ws.readyState!==1||!NET.sbJoined)return false;ws.send(JSON.stringify({e:event,d:payload}));return true;}catch(_){return false;}}
/* ---- synchro PNJ (managers, vigiles, directrice) : l'hote les fait vivre, les autres les voient ---- */
const NETNPC={t:0,m:[],g:[],d:null,last:0};
function netNpcLive(){return !!(NET.on&&NET.sb&&NET.joined&&NET.hostPid&&NET.hostPid!==NET.pid&&Date.now()-NETNPC.t<2500&&NETNPC.m.length);}
function netNpcIsHost(){return !!(NET.on&&NET.sb&&NET.joined&&NET.hostPid===NET.pid);}
function netNpcSend(){const now=Date.now();if(now-NETNPC.last<120)return;NETNPC.last=now;const r=function(v){return Math.round(v*100)/100;};
  netSbBroadcast('npc',{from:NET.pid,
    m:MGR.map(function(m){return [r(m.x),r(m.z),r(m.g.rotation.y),m.state==='smoke'?1:m.state==='insp'?2:0,m.fired?1:0,Math.round(m.stand),m.spot==='pause'?1:0,r(m.t||0),r(m.it||0),m.name];}),
    g:GUARDS.map(function(G){return [r(G.x),r(G.z),r(G.h),G.zn,G.stun>0?1:0];}),
    d:[r(D.x),r(D.z),r(D.th),D.zn,D.rage>0?1:0]});}
function netNpcIn(d){const ok=function(a,n){return Array.isArray(a)&&a.length>=n&&isFinite(a[0])&&isFinite(a[1]);};
  NETNPC.m=(Array.isArray(d.m)?d.m:[]).slice(0,12).map(function(a){return ok(a,10)?[+a[0],+a[1],+a[2]||0,a[3]|0,a[4]|0,+a[5]||0,a[6]|0,+a[7]||0,+a[8]||0,String(a[9]||'').slice(0,20)]:null;});
  NETNPC.g=(Array.isArray(d.g)?d.g:[]).slice(0,12).map(function(a){return ok(a,5)&&Z[a[3]]?[+a[0],+a[1],+a[2]||0,String(a[3]),a[4]|0]:null;});
  NETNPC.d=ok(d.d,5)&&Z[d.d[3]]?[+d.d[0],+d.d[1],+d.d[2]||0,String(d.d[3]),d.d[4]|0]:null;NETNPC.t=Date.now();}
function mirrorMgr(m,dt){
  if(!netNpcLive())return false;const k=MGR.indexOf(m),s=NETNPC.m[k];if(!s)return false;
  if(m.task||(FIREW&&FIREW.m===m)||m.stun>0)return false;
  if(s[4]===1){if(!m.fired){m.fired=true;releaseTask(m);m.g.visible=m.gs.visible=m.gp.visible=m.gi.visible=false;}m.respawn=-1;return false;}
  if(m.fired){if(m.pj||clk-(m._lf||-99)<2)return false;m.fired=false;m.stand=100;m.name=s[9];m.respawn=0;drawM(m);backToPatrol(m,60);}
  if(m.name!==s[9]&&s[9]){m.name=s[9];drawM(m);}
  if(Math.abs(m.stand-s[5])>.5){m.stand=s[5];drawM(m);}
  const st=s[3];
  if(st===1){if(m.state!=='smoke'){releaseTask(m);m.state='smoke';m.spot=s[6]?'pause':'reserve';m.t=s[7];const sp=SPOTS[m.spot][k%4],c=m.spot==='reserve'?m.gs:m.gp;c.position.set(sp[0],0,sp[1]);c.rotation.y=m.spot==='reserve'?Math.PI/2:-Math.PI/2;walkAnim(c,0,0);}return false;}
  if(st===2){if(m.state!=='insp'){releaseTask(m);m.state='insp';m.it=s[8];}return false;}
  if(m.state!=='patrol'){m.state='patrol';m.x=s[0];m.z=s[1];m.path=null;}
  m.gs.visible=m.gp.visible=m.gi.visible=false;m.g.visible=true;m.g.rotation.x=0;
  const dx=s[0]-m.x,dz=s[1]-m.z,d=Math.hypot(dx,dz);
  if(d>5){m.x=s[0];m.z=s[1];}else{const kk=Math.min(1,dt*10);m.x+=dx*kk;m.z+=dz*kk;}
  const mv=d>.03;m.hd=s[2];m.g.rotation.y=angLerp(m.g.rotation.y,s[2],1-Math.exp(-dt*9));
  if(mv)m.ph+=dt*8;walkAnim(m.g,m.ph,mv?1:0);m.g.position.set(m.x,0,m.z);return true;}
function guardMirror(G,dt){
  if(!netNpcLive())return false;const k=GUARDS.indexOf(G),s=NETNPC.g[k];if(!s)return false;
