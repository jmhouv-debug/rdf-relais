function setCab(i,closed){const c=CAB[i];if(c.closed===closed)return;c.closed=closed;c.door.visible=closed;c.fl.visible=!closed;c.fo.visible=closed;c.mk.off=closed;
  const ix=O.obs.indexOf(c.ob);if(closed&&ix<0)O.obs.push(c.ob);else if(!closed&&ix>=0)O.obs.splice(ix,1);}
function enterCabin(mk){const i=CAB.findIndex(function(c){return c.mk===mk;});if(i<0)return;if(WCFL>0){toast('🌊 Toilettes inondées : impossible d\'entrer.');return;}if(WCS[i]>0){WCS[i]=0;setScotch(i,false);toast('Tu arraches le scotch « Hors service » : la cabine est de nouveau libre.');return;}WCIN={i:i,t:0,acc:0,dn:0,pc:0,kt:14,alert:0};setCab(i,true);CAB[i].use.off=false;if(rank===0&&i===1&&LK.g!=='f'){WCIN.alert=6;pop('🚨 Alerte ! Un homme dans les toilettes des femmes !','bad');}else if(WCDIRT[i])toast('🤢 Les toilettes sont sales… tu peux nettoyer ou en profiter.');pp.x=CAB[i].cx;pp.z=-40.3;act=null;
  $('bPhone').hidden=false;$('bExit').hidden=false;toast('Tu verrouilles la porte : OCCUPÉ. Reste le temps que tu veux, sors ton smartphone…');}
function knock(name,mgr){if(!WCIN)return;
  if(mgr){if(WCIN.t>=20){toast(name+' ouvre la porte des toilettes avec son passe : tu es pris !');exitCabin();giveBlame('pris aux toilettes par '+name+' (trop longtemps) !',20);}
    else toast(name+' frappe à la porte : « Y a quelqu\'un ? » Il ne peut pas entrer, pas encore…');return;}
  toast(name+' frappe à la porte : « Y a quelqu\'un ? »');if(WCIN.t>=45&&!WCIN.dn){WCIN.dn=8;toast(name+' trouve que tu t\'éternises : sors de là !');}}
function wcKnock(m){if(WCIN&&cur==='office'){say(m.g,'Contrôle des toilettes !');knock(m.name,true);}}
function exitCabin(){if(PHN)closePhone();if(!WCIN)return;const c=CAB[WCIN.i];c.use.off=true;WCIN=null;setCab(c===CAB[0]?0:1,false);pp.x=c.cx;pp.z=-37.5;$('bPhone').hidden=true;$('bExit').hidden=true;}
function phoneCall(){if(!WCIN)return;if(WCIN.pc>0){toast('Tu as déjà appelé : attends encore '+Math.ceil(WCIN.pc)+' s avant le prochain coup de fil.');return;}WCIN.pc=30;addB(3);toast(WCIN_PH[(Math.random()*WCIN_PH.length)|0]+' +3 branleur');}

