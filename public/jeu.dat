      furn(18,13.5,3.5,2,.75,BR);furn(5,15,3.5,1.2,.8,0x6b3fa0);furn(8.6,13,.9,3,1.2,BR);furn(15,16.7,4,.8,1.8,0xd9d2c3);for(let i=0;i<4;i++)box(zn.g,.3,.4,.3,0xd4af37,o[0]+13.6+i*.95,1.3,o[1]+16.7);
      furn(2,16.5,.8,.8,1.3,0x2f6b3a);box(zn.g,2,1.3,.08,0x3b82f6,o[0]+23.9,1.7,o[1]+15);box(zn.g,1.2,1.4,.06,0xffffff,o[0]+9,1.6,o[1]+.35);
      X.spots=[[4,1.9,'📚 la bibliothèque de gauche'],[12,1.9,'📚 la bibliothèque du milieu'],[20,1.9,'📚 la bibliothèque de droite'],[1.9,6,'🗄️ le classeur métallique'],[1.9,11,'🗄️ les tiroirs du classeur'],[22.1,6,'🚪 l\'armoire'],[21.9,11,'🔒 le coffre-fort'],[12,10.4,'🖥️ le bureau de la directrice'],[9.6,9,'🗂️ le tiroir du bureau'],[18,12,'📋 la table de réunion'],[5,13.9,'🛋️ les coussins du canapé'],[9.7,13,'📗 la petite étagère'],[15,15.8,'🏆 la vitrine des trophées'],[3,16.4,'🪴 le pot de la plante'],[23,14,'🖼️ derrière le tableau'],[12,6.5,'☕ la machine à café']].map(function(s){const x=o[0]+s[0],z=o[1]+s[1];const lb=label('🔍',{sx:.6,sy:.6,w:80,h:80,size:56,bg:'rgba(255,210,31,.8)'});lb.position.set(x,1.9,z);zn.g.add(lb);return {x:x,z:z,n:s[2],lb:lb};});
      const kp=label('🔢 Cadenas',{sx:2,sy:.5,w:256,h:64,size:34,bg:'rgba(229,72,77,.92)'});kp.position.set(X.door[0],2.7,X.door[1]);zn.g.add(kp);}
    else{for(let r=0;r<3;r++)for(let c=0;c<3;c++)furn(3.5+c*5.5,2.8+r*3.4,3.2,.9,1.8,0x8a8f99);
      const ex=qmRingMesh(0x46d17a,'🚪 Sortie (avec les 5 dossiers)',420);ex.g.position.set(X.door[0],0,X.door[1]);scene.remove(ex.g);zn.g.add(ex.g);X.exM=ex;}}
  return X;}
/* donnees perso (meme resultat chez tout le monde : graine + numero du joueur) */
function qmCvMine(a){const X=Z['cv_'+a.cv.k].cv;if(!X)return null;if(a.cvD&&a.cvD.seed===X.seed)return a.cvD;const rnd=qmRng(X.seed^((a.id+1)*2654435761));const D={seed:X.seed};
  if(X.k==='cad'){D.code=[0,0,0,0].map(function(){return (rnd()*10)|0;});const ix=X.spots.map(function(s,i){return i;}).sort(function(){return rnd()-.5;});D.sp=ix.slice(0,4);D.got=[null,null,null,null];}
  if(X.k==='cls'){const o=QCV.cls.o,zn=Z.cv_cls;D.fold=[];D.next=1;for(let n=1;n<=5;n++){let p=null;for(let t=0;t<60&&!p;t++){const x=o[0]+1+rnd()*(X.W-2),z=o[1]+1+rnd()*(X.D-2.4);if(!hit(x,z,.5,zn)&&Math.hypot(x-X.start[0],z-X.start[1])>3)p=[x,z];}p=p||[o[0]+2+n*2,o[1]+5];D.fold.push({n:n,x:p[0],z:p[1],m:null});}}
  a.cvD=D;return D;}
/* ---------- envoyer / sortir ---------- */
function qmCvRoom(k){const occ=QM.A.some(function(b){return b.cv&&b.cv.k===k;});if(!occ||!QM.CV[k]){QM.CV[k]={seed:(Math.random()*1e9)|0,t0:QM.t};}const R=QM.CV[k];if(QM.CVg[k]!==R.seed)qmCvGen(k,R.seed);return R;}
function qmCvSend(a,quiet){if(QM.mp&&QN.client)return;const occ=QCVK.filter(function(k){return QM.A.some(function(b){return b.cv&&b.cv.k===k;});});
  let k;if(QM.cvForce)k=QM.cvForce;else if(occ.length&&Math.random()<.45)k=occ[(Math.random()*occ.length)|0];else{const fr=QCVK.filter(function(k){return occ.indexOf(k)<0;});k=(fr.length?fr:QCVK)[(Math.random()*(fr.length?fr:QCVK).length)|0];}
  const R=qmCvRoom(k),X=Z['cv_'+k].cv;a.cv={k:k,t:0,bt:35+Math.random()*65};a.cvD=null;a.caught=0;a.down=0;a.rev=0;a.zn='cv_'+k;a.x=X.start[0]+(Math.random()-.5)*.8;a.z=X.start[1]+(Math.random()-.5)*.8;a.path=null;a.job=null;a.at=null;a.gzn=null;
  if(a.pts)a.pts=Math.max(0,a.pts-3);
  if(a.human)qmCvEnterMe(k);else if(a.remote)qnS('cv',{id:a.id,k:k,s:R.seed,x:a.x,z:a.z});
  if(!quiet)qmMsg('🚔 '+a.name+' est convoqué par la direction : '+QCV[k].ic+' '+QCV[k].n+'. Allez à 2 sur 🔓 devant le bureau pour le libérer !','warn',1);}
function qmCvEnterMe(k){const me=QM.me,X=Z['cv_'+k].cv;qmPlayerTo('cv_'+k,me.x,me.z);pp.face=Math.PI/4;me.cvLock=0;
  const tips={arch:'Trouve la sortie 🚪 dans le noir. Ta lampe éclaire devant toi. Des employés maudits rôdent : fixe-les avec ta lampe 2 s pour les faire reculer !',
    cad:'Le bureau de la directrice ! Fouille les meubles 🔍 (Agir) : 4 d\'entre eux cachent les chiffres de TON code. Puis tape-le au cadenas 🔢 près de la porte.',
    vent:'Dans le noir complet, avec une toute petite lampe ! Rejoins la sortie 🚪 : la glu ralentit, les ventilateurs repoussent, et des parois bougent.',
    cls:'Ramasse TES dossiers 📁 dans l\'ordre, de 1 à 5, puis file à la sortie 🚪.'};
  qmBig('🚔 CONVOQUÉ ! '+QCV[k].ic+' '+QCV[k].n,'zomb');qmMsg(tips[k],'warn');}
function qmCvOut(a,why){if(!a.cv)return;const t=a.cv.t;a.cv=null;a.cvD=null;a.zn='office';const ex=QM.exit;a.x=ex[0]+(Math.random()-.5)*1.4;a.z=ex[1]+Math.random()*.6;a.imm=3;a.hp=a.hpMax;a.down=0;a.caught=0;a.path=null;a.job=null;
  if(!(QM.mp&&QN.client)){if(why==='esc'){qmPts(a,t<45?8:5,'');qmMsg((t<45?'⚡ Évasion express ! ':'🏃 Évadé ! ')+a.name+' est sorti en '+Math.round(t)+' s','good',1);}else if(why==='time')qmMsg('⏱️ '+a.name+' est relâché par la direction (2 min).','',1);
    if(a.remote)qnS('cvout',{id:a.id,w:why,x:a.x,z:a.z});}
  if(a.human)qmCvLeaveMe(a);}
function qmCvLeaveMe(a){$('qmTorch').hidden=true;$('qmPad').hidden=true;$('qmCvH').hidden=true;QM.cvPend=0;qmPlayerTo('office',a.x,a.z);if(QM.me.cvD)QM.me.cvD=null;}
/* le joueur local reussit son evasion */
function qmCvWin(){const me=QM.me;if(!me.cv||QM.cvPend)return;if(QM.mp&&QN.client){QM.cvPend=1;qnS('a',{pid:QN.pid,k:'cvx'});qmMsg('🏃 Tu t\'es évadé !','good');return;}qmCvOut(me,'esc');}
/* ---------- tick (hote + local) ---------- */
function qmCvTick(dt){const me=QM.me,host=!(QM.mp&&QN.client);
  if(host){QM.A.forEach(function(a){if(!a.cv)return;a.cv.t+=dt;if(a.cv.t>=QCFG.cvMax){qmCvOut(a,'time');return;}if(!a.human&&!a.remote&&a.cv.t>=a.cv.bt)qmCvOut(a,'esc');});
    /* rond de liberation */
    const F=QM.freeR,caps=QM.A.filter(function(a){return a.cv;});const W=QM.A.filter(function(a){if(a.role!=='emp'||!qmLive(a)||a.down>0)return false;const x=a.human?pp.x:a.x,z=a.human?pp.z:a.z,zn=a.human?cur:a.zn;return zn===F.zn&&Math.hypot(x-F.x,z-F.z)<QCFG.ringR;});
    F.n=W.length;if(caps.length&&W.length>=2){F.prog+=dt/QCFG.freeT;if(F.prog>=1){F.prog=0;W.forEach(function(a){qmPts(a,5,'rev');});qmMsg('🔓 '+W.map(function(a){return a.name;}).join(' et ')+' ont libéré '+caps.map(function(a){return a.name;}).join(', ')+' !','good',1);caps.forEach(function(a){qmCvOut(a,'free');});}}else F.prog=Math.max(0,F.prog-dt*.5);
    /* bots : 2 vont liberer si quelqu'un est convoque depuis 25 s */
    if(QM.A.some(function(a){return a.cv&&a.cv.t>25;})){const bs=QM.A.filter(function(a){return !a.human&&!a.remote&&a.role==='emp'&&qmLive(a)&&!(a.down>0);}).sort(function(p,q){return ((p.zn===F.zn?0:40)+Math.hypot(p.x-F.x,p.z-F.z))-((q.zn===F.zn?0:40)+Math.hypot(q.x-F.x,q.z-F.z));}).slice(0,2);
      bs.forEach(function(a){if(a.job&&a.job.free)return;a.job={r:{id:'free',zn:F.zn,x:F.x,z:F.z,k:'free'},free:1};a.at=null;a.wt=0;qmGoal(a,F.zn,F.x+(a.id%2?.5:-.5),F.z);});}
    else QM.A.forEach(function(a){if(a.job&&a.job.free)a.job=null;});}
  {const F=QM.freeR,on=QM.A.some(function(a){return a.cv;});QM.freeM.g.visible=on&&(cur===F.zn||QM.map);if(on){const t='🔓 Libérer ('+QM.A.filter(function(a){return a.cv;}).length+') · '+F.n+'/2'+(F.prog>0?' · '+Math.round(F.prog*100)+' %':'');if(QM.freeM._t!==t){QM.freeM._t=t;QM.freeM.lb.draw(t,'#46d17af2');}QM.freeM.disc.material.opacity=.3+F.prog*.6;}}
  /* employes maudits (archives) */
  const X=Z.cv_arch&&Z.cv_arch.cv;if(X&&X.npc){const occ=QM.A.filter(function(a){return a.cv&&a.cv.k==='arch';});
    X.npc.forEach(function(n){if(!host&&n.tx!==undefined){n.x+=(n.tx-n.x)*Math.min(1,dt*8);n.z+=(n.tz-n.z)*Math.min(1,dt*8);}if(host){if(n.stun>0){n.stun-=dt;const t=occ[0];if(t){const x=t.human?pp.x:t.x,z=t.human?pp.z:t.z,d=Math.max(.3,Math.hypot(n.x-x,n.z-z));const nx=n.x+(n.x-x)/d*dt*2.2,nz=n.z+(n.z-z)/d*dt*2.2;if(!hit(nx,nz,.35,Z.cv_arch)){n.x=nx;n.z=nz;}}}
        else{let tg=null,bd=6.5;occ.forEach(function(a){const x=a.human?pp.x:a.x,z=a.human?pp.z:a.z,d=Math.hypot(x-n.x,z-n.z);if(d<bd&&!blocked(Z.cv_arch,n.x,n.z,x,z)){bd=d;tg=a;}});
          if(tg){const x=tg.human?pp.x:tg.x,z=tg.human?pp.z:tg.z;n.st='chase';n.rp-=dt;if(n.rp<=0||!n.path||n.pi>=n.path.length){n.path=path(Z.cv_arch,n.x,n.z,x,z);n.pi=0;n.rp=.5;}follow(n,dt,2.7);
            if(bd<.85){n.stun=3;n.path=null;if(tg.human){pp.x=X.start[0];pp.z=X.start[1];qmBig('👻 BOUH ! Retour au début…','zomb');QM.shake=.4;}else if(tg.remote){qnS('cvback',{id:tg.id});}else{tg.x=X.start[0];tg.z=X.start[1];}}}
          else{n.st='wander';if(!n.path||n.pi>=n.path.length){const c=[(Math.random()*X.N)|0,(Math.random()*X.N)|0],p=qmCellC(QCV.arch.o,X.C,c[0],c[1]);n.path=path(Z.cv_arch,n.x,n.z,p[0],p[1]);n.pi=0;}follow(n,dt,1.4);}}
        /* eblouissement par les lampes */
        if(!(n.stun>0))occ.forEach(function(a){const x=a.human?pp.x:a.x,z=a.human?pp.z:a.z,f=a.human?pp.face:(a.th!==undefined?a.th:a.h);const d=Math.hypot(n.x-x,n.z-z);if(d>6.5||blocked(Z.cv_arch,x,z,n.x,n.z))return;let df=Math.atan2(n.x-x,n.z-z)-f;df=Math.atan2(Math.sin(df),Math.cos(df));if(Math.abs(df)<.42){n.dz+=dt;if(n.dz>=1.8){n.dz=0;n.stun=4;n.path=null;if(cur==='cv_arch')qmMsg('🔦 Ébloui ! L\'employé maudit recule.','good');}}});
        n.dz=Math.max(0,n.dz-dt*.3);}
      const mv=n._px!==undefined&&Math.hypot(n.x-n._px,n.z-n._pz)>.005;if(mv)n.h=Math.atan2(n.x-n._px,n.z-n._pz);n._px=n.x;n._pz=n.z;n.ph+=mv?dt*6:0;n.g.position.set(n.x,0,n.z);n.g.rotation.y=n.h;walkAnim(n.g,n.ph,mv?1:0);
      if(n.g.userData&&n.g.userData.arms){n.g.userData.arms[0].rotation.x=n.g.userData.arms[1].rotation.x=n.st==='chase'?-1.4:-.3;}
      if(cur==='cv_arch'&&n.st==='chase'&&!(n.stun>0)){n.gr-=dt;if(n.gr<=0){n.gr=3.5;qmGrr();}}});}
  /* conduits : parois qui bougent */
  const V=Z.cv_vent&&Z.cv_vent.cv;if(V&&V.BW&&QM.CV.vent){const el=(QM.CV.vent.t0||0)-QM.t,ph=Math.floor(el/10),nx=10-(el-ph*10);
    const stOf=function(p,i){if(p<=0)return i%3===0;return qmRng(V.seed*31+p*7919+i*104729)()<.45;};
    if(V.ph!==ph){V.ph=ph;V.BW.forEach(function(w,i){w.on=stOf(ph,i);w.m.visible=w.on;});Z.cv_vent.obs=V.base.concat(V.BW.filter(function(w){return w.on;}).map(function(w){return w.o;}));Z.cv_vent.gr=null;
      if(cur==='cv_vent'){qmThud(.5);QM.shake=.15;if(hit(pp.x,pp.z,.38,Z.cv_vent)){const ci=clamp(Math.floor((pp.x-QCV.vent.o[0])/V.C),0,V.N-1),cj=clamp(Math.floor((pp.z-QCV.vent.o[1])/V.C),0,V.N-1),c=qmCellC(QCV.vent.o,V.C,ci,cj);pp.x=c[0];pp.z=c[1];}}}
    V.BW.forEach(function(w,i){const ch=nx<1.6&&stOf(ph+1,i)!==w.on;if(ch){w.m.visible=true;w.m.material.color.setHex(Math.sin(QM.clk*18)>0?0xe5484d:0x9aa7b4);w.m.material.transparent=!w.on;w.m.material.opacity=w.on?1:.45;}else{w.m.visible=w.on;w.m.material.color.setHex(0x9aa7b4);w.m.material.transparent=false;w.m.material.opacity=1;}});
    V.fans.forEach(function(f){const on=((QM.clk+f.ph)%5)<2;f.g.rotation.y+=dt*(on?22:3);f.w.material.opacity=on?.25+Math.sin(QM.clk*20)*.08:0;f.on=on;});}
  /* joueur local convoque */
  if(me.cv&&qmIsCv(cur)){const k=me.cv.k,Xm=Z[cur].cv;me.cv.t=host?me.cv.t:(me.cv.t||0)+dt;if(QM.map){QM.map=false;}
    const D=qmCvMine(me),H=$('qmCvH');let h='🚔 '+QCV[k].ic+' '+QCV[k].n+' · relâché dans '+Math.max(0,Math.ceil(QCFG.cvMax-me.cv.t))+' s';
    if(k==='cad'&&D)h+='<br>Ton code : <b>'+D.got.map(function(g){return g===null?'_':g;}).join(' ')+'</b>';
    if(k==='cls'&&D)h+='<br>Dossiers : <b>'+(D.next-1)+'/5</b>'+(D.next<=5?' · cherche le n°'+D.next:' · file à la sortie !');
    if(H._h!==h){H._h=h;H.innerHTML=h;}H.hidden=false;
    if(Xm&&Xm.exit&&Math.hypot(pp.x-Xm.exit[0],pp.z-Xm.exit[1])<1.2)qmCvWin();
    if(k==='vent'&&Xm){if(Xm.glue.some(function(g){return Math.abs(pp.x-g.x)<g.r&&Math.abs(pp.z-g.z)<g.r;})){me.slowT=Math.max(me.slowT||0,.3);}
      Xm.fans.forEach(function(f){if(f.on&&Math.abs(pp.x-f.x)<f.r&&Math.abs(pp.z-f.z)<f.r){const nx=pp.x+f.dx*3.4*dt,nz=pp.z+f.dz*3.4*dt;if(!hit(nx,nz,.38,Z.cv_vent)){pp.x=nx;pp.z=nz;}}});}
    if(k==='cls'&&D){D.fold.forEach(function(f){if(!f.m){f.m=dynLabel(160,64,1.4,.56);f.m.sp.position.set(f.x,1.1,f.z);Z.cv_cls.g.add(f.m.sp);f.m.box=box(Z.cv_cls.g,.5,.12,.38,0x2f6fd0,f.x,.06,f.z);}
        const near=Math.hypot(pp.x-f.x,pp.z-f.z),t2=f.n<D.next?'':near<4?'📁 '+f.n:'📁 ?';f.m.sp.visible=!!t2;f.m.box.visible=!!t2;if(f.m._t!==t2){f.m._t=t2;if(t2)f.m.draw(t2,f.n===D.next&&near<4?'#2f6fd0f2':'#5b6470f2');}
        if(f.n>=D.next&&near<.9){if(f.n===D.next){D.next++;qmThud(.4);qmMsg('📁 Dossier n°'+f.n+' rangé !','good');}else if(QM.clk-(D.warn||0)>2){D.warn=QM.clk;qmMsg('❌ Pas dans l\'ordre : cherche d\'abord le n°'+D.next,'bad');}}});
      Xm.exM.g.visible=D.next>5;if(D.next>5&&Math.hypot(pp.x-Xm.door[0],pp.z-Xm.door[1])<1.4)qmCvWin();}
    if(k==='cad'&&D){D.seen=D.seen||{};let bi=-1,bd=1.6;Xm.spots.forEach(function(s,i){const d=Math.hypot(pp.x-s.x,pp.z-s.z);if(d<bd){bd=d;bi=i;}s.lb.visible=!D.seen[i];});QM.cvSpot=bi;}else QM.cvSpot=-1;
    qmTorch(k==='arch'||k==='vent',k==='vent');}
  else{if(!$('qmCvH').hidden)$('qmCvH').hidden=true;if(!$('qmTorch').hidden)$('qmTorch').hidden=true;}}
/* agir dans une piece (cadenas) */
function qmCvAct(){const me=QM.me;if(!me.cv||me.cv.k!=='cad')return false;const X=Z.cv_cad.cv;if(QM.cvSpot>=0){const D=qmCvMine(me),i=QM.cvSpot,s=X.spots[i],j=D.sp.indexOf(i);D.seen=D.seen||{};D.seen[i]=1;qmThud(.25);if(j>=0){D.got[j]=D.code[j];qmMsg('🔍 Tu fouilles '+s.n+' : chiffre n°'+(j+1)+' = '+D.code[j]+' !','good');}else qmMsg('🔍 Tu fouilles '+s.n+' : rien pour toi ici…');return true;}if(!X||Math.hypot(pp.x-X.door[0],pp.z-X.door[1])>1.8)return false;qmPadOpen();return true;}
function qmPadOpen(){const me=QM.me,D=qmCvMine(me),P=$('qmPad');if(!D)return;let v='';QM.uiOpen=true;
  const draw=function(msg){P.innerHTML='<div class="qmpadw"><div class="qmpadt">🔢 Cadenas</div><div class="qmpadv">'+[0,1,2,3].map(function(i){return '<span>'+(v[i]||'_')+'</span>';}).join('')+'</div><div class="qmpadm">'+(msg||'Tape les 4 chiffres de TON code')+'</div><div class="qmpadk">'+[1,2,3,4,5,6,7,8,9,'⌫',0,'OK'].map(function(c){return '<button data-c="'+c+'">'+c+'</button>';}).join('')+'</div><button class="qmpadx">Fermer</button></div>';
    Array.prototype.forEach.call(P.querySelectorAll('.qmpadk button'),function(b){b.onclick=function(){const c=b.dataset.c;if(c==='⌫')v=v.slice(0,-1);else if(c==='OK'){if(v===D.code.join('')){P.hidden=true;QM.uiOpen=false;qmMsg('🔓 Clic ! Le cadenas s\'ouvre.','good');qmCvWin();return;}else{v='';draw('❌ Mauvais code !');return;}}else if(v.length<4)v+=c;draw();};});
    P.querySelector('.qmpadx').onclick=function(){P.hidden=true;QM.uiOpen=false;};};
  draw();P.hidden=false;}
/* lampe torche : un voile noir perce autour de chaque lampe */
function qmTorch(on,small){const c=$('qmTorch');if(!on){c.hidden=true;return;}c.hidden=false;const W=innerWidth,H=innerHeight;if(c.width!==W||c.height!==H){c.width=W;c.height=H;}const x=c.getContext('2d');
  x.globalCompositeOperation='source-over';x.fillStyle='rgba(2,3,6,.975)';x.fillRect(0,0,W,H);x.globalCompositeOperation='destination-out';
  const sc=function(px,pz,y){const v=new T.Vector3(px,y||1,pz).project(camera);return [(v.x+1)/2*W,(1-v.y)/2*H];};
  const rk=small?'vent':'arch',RL=small?3:7,R0=small?30:60,R1=small?20:34,AN=small?.34:.45;QM.A.forEach(function(a){if(!a.cv||a.cv.k!==rk)return;const px=a.human?pp.x:a.x,pz=a.human?pp.z:a.z,f=a.human?pp.face:(a.th!==undefined?a.th:a.h);
    const p=sc(px,pz),q=sc(px+Math.sin(f)*RL,pz+Math.cos(f)*RL),ang=Math.atan2(q[1]-p[1],q[0]-p[0]),R=Math.hypot(q[0]-p[0],q[1]-p[1]);
    let g=x.createRadialGradient(p[0],p[1],0,p[0],p[1],a.human?R0:R1);g.addColorStop(0,'rgba(0,0,0,1)');g.addColorStop(1,'rgba(0,0,0,0)');x.fillStyle=g;x.beginPath();x.arc(p[0],p[1],a.human?R0:R1,0,7);x.fill();
    g=x.createRadialGradient(p[0],p[1],10,p[0],p[1],R);g.addColorStop(0,'rgba(0,0,0,1)');g.addColorStop(.75,'rgba(0,0,0,.85)');g.addColorStop(1,'rgba(0,0,0,0)');x.fillStyle=g;x.beginPath();x.moveTo(p[0],p[1]);x.arc(p[0],p[1],R,ang-AN,ang+AN);x.closePath();x.fill();});
  /* la sortie brille un peu */
  const X=Z['cv_'+rk].cv;if(X&&X.exit){const p=sc(X.exit[0],X.exit[1],.2);const g=x.createRadialGradient(p[0],p[1],0,p[0],p[1],26);g.addColorStop(0,'rgba(0,0,0,.7)');g.addColorStop(1,'rgba(0,0,0,0)');x.fillStyle=g;x.beginPath();x.arc(p[0],p[1],26,0,7);x.fill();}}
/* ---------- appel a l'aide ---------- */
function qmHelpNeed(a){const x=a.human?pp.x:a.x,z=a.human?pp.z:a.z,zn=a.human?cur:a.zn;let best=null,bd=QCFG.ringR+.3;
  QM.R.forEach(function(r){if(r.zn!==zn||!qmRingOn(r)||r.lk>0||(r.own!==undefined&&r.own!==a.id))return;if(!(r.k==='team'||r.k==='pair'||(r.k==='mini'&&r.duo)))return;const d=Math.hypot(r.x-x,r.z-z);if(d<bd){bd=d;best=r;}});
  if(!best)return null;const n=qmWorkers(best).filter(function(b){return b!==a;}).length+1;if(best.k==='team'&&n>=best.need)return null;if(best.k==='mini'&&n>=2)return null;if(best.k==='pair'&&best.both)return null;return best;}
function qmHelpCall(a){if(QM.mp&&QN.client)return;const r=qmHelpNeed(a);if(!r||(a.helpCd||0)>QM.clk)return;a.helpCd=QM.clk+20;const q=QM.QS.find(function(x){return x.ids.indexOf(r.id)>=0;});
  QM.help={rid:r.id,by:a.id,until:QM.clk+20};qmMsg('📣 '+a.name+' attend de l\'aide sur '+(q?QNUM[q.n]+' ':'')+r.n+' ('+QZN[r.zn]+') !','warn',1);if(QM.mp&&QN.host)qnS('help',{rid:r.id,by:a.id});
  const tg=r.k==='pair'?QM.R.find(function(x){return x.id===r.pair;}):r;
  QM.A.filter(function(b){return b!==a&&!b.human&&!b.remote&&b.role==='emp'&&qmLive(b)&&!(b.down>0)&&qmCanDo(b,tg);}).sort(function(p,q2){return ((p.zn===tg.zn?0:40)+Math.hypot(p.x-tg.x,p.z-tg.z))-((q2.zn===tg.zn?0:40)+Math.hypot(q2.x-tg.x,q2.z-tg.z));}).slice(0,r.k==='team'?Math.max(1,r.need-1):1)
    .forEach(function(b){b.job={r:tg};b.at=null;b.wt=0;const s=qmSlot(b,tg);qmGoal(b,tg.zn,s[0],s[1]);});}
function qmHelpBonus(r,W){const H=QM.help;if(!H||H.until<QM.clk)return;const q=QM.QS.find(function(x){return x.ids.indexOf(r.id)>=0;});if(H.rid!==r.id&&!(q&&q.ids.indexOf(H.rid)>=0))return;W.forEach(function(a){if(a.id!==H.by){qmPts(a,2,'rev');if(a.human)qmMsg('📣 Merci pour le coup de main : +2 ⭐','good');}});QM.help=null;}

/* ================= Lot B : boss en arènes, armes, cartons ================= */
const QWP={balai:{ic:'🧹',n:'Balai',m:1.5,r:2.9,d:'longue portée'},poele:{ic:'🍳',n:'Poêle',m:2,st:1,d:'sonne 1 s'},raquette:{ic:'🎾',n:'Raquette',m:2,refl:1,d:'renvoie les projectiles du boss'},
  eau:{ic:'💦',n:'Pistolet à eau',m:1,rng:9,slow:1,d:'tire de loin et ralentit'},batte:{ic:'🏏',n:'Batte de baseball',m:3,kb:1,d:'très gros coups'},extinct:{ic:'🧯',n:'Extincteur',m:1.5,rng:5,blind:1,d:'jet qui repousse et aveugle'}};
const QWRK={balai:1,poele:2,raquette:3,eau:3,batte:4,extinct:5};
const QBOSS=[
  {id:'pat',n:'Chef pâtissier',ic:'👨‍🍳',ar:'Fournil géant',hp:100,pj:'🥐',pk:'bread',q:'Personne ne touche à MES croissants !',look:{shirt:0xf5f5f5,pants:0x2b2b2b,hair:0x3a2a1a,hs:'court'},hat:0xffffff,att:['pate','farine'],loot:['poele','balai','raquette','eau'],o:[400,600],fl:0xe8dcc0,wl:0xc9a77a,bar:'#c0392b'},
  {id:'froid',n:'Gardien du froid',ic:'🥶',ar:'Entrepôt frigorifique',hp:130,pj:'🧊',pk:'fish',q:'Ici, tout le monde reste au frais.',look:{shirt:0x5fa8d3,pants:0x23405a,hair:0xe0f2ff,hs:'court'},hat:0x9fd8ff,att:['givre','verglas','givre'],loot:['raquette','eau','batte','batte'],o:[470,600],fl:0xcfe6f2,wl:0x8fb8cf,bar:'#2980b9'},
  {id:'drh',n:'La DRH',ic:'📋',ar:'Open space',hp:160,pj:'📁',pk:'stapler',q:'Vous êtes tous convoqués à un entretien.',look:{shirt:0x6b3fa0,pants:0x2b2b38,hair:0x1b1b1b,fem:true,hs:'long'},att:['dossiers','entretien'],loot:['batte','extinct','extinct','eau'],o:[540,600],fl:0x8a8f99,wl:0xd9d2c3,bar:'#6b3fa0'},
  {id:'dir',n:'La Directrice',ic:'👠',ar:'Grande ligne de caisses',hp:190,pj:'🛒',pk:'roll',q:'Ce magasin ne fermera JAMAIS.',look:{shirt:0xb3122b,pants:0x1b1b1b,hair:0x6b3a2a,fem:true,hs:'long'},att:['charge','dossiers','charge'],loot:[],o:[610,600],fl:0xe9e4da,wl:0x9a3b3b,bar:'#b3122b'}];
const QAW=40,QAD=30;
function qmIsAr(zn){return typeof zn==='string'&&zn.indexOf('ar_')===0;}
function qmP(a){return a.human?[pp.x,pp.z,cur]:[a.x,a.z,a.zn];}
/* ---------- arenes (construites une fois) ---------- */
function qmBInit(){if(!Z.ar_pat)qmArenaInit();QM.bossN=0;QM.arena=null;QM.WP=QM.WP||[];QM.WP.forEach(function(w){if(w.sp)w.sp.parent&&w.sp.parent.remove(w.sp);});QM.WP=[];QM.wpN=0;
  (QM.BX||[]).forEach(function(b){scene.remove(b.g);});QM.BX=[];QM.bxN=0;QM.bxT=20;QM.bxInit=0;QM.dmgT=0;QM.blindT=0;
  if(QM.boss){qmBossKill();}QM.BZ=[];QM.bzN=0;(QM.HZ||[]).forEach(function(e){scene.remove(e.g);});QM.HZ=[];QM.hzN=0;}
/* ---------- maillage du boss ---------- */
function qmBossMesh(i){const B=QBOSS[i];const g=makeChar(B.look);g.scale.setScalar(i===3?1.85:1.7);if(B.hat)box(g,.5,.5,.5,B.hat,0,2.55,0,false);if(B.id==='pat')box(g,.62,.12,.62,0xffffff,0,2.3,0,false);if(B.id==='drh')box(g,.5,.6,.08,0xf4f1ea,.35,1.1,.25,false);if(B.id==='dir')box(g,.7,.1,.7,0xd4af37,0,2.45,0,false);scene.add(g);
  const bar=dynLabel(420,80,4.4,.84);scene.add(bar.sp);return {g:g,bar:bar};}
function qmBossKill(){const B=QM.boss;if(!B)return;scene.remove(B.g);scene.remove(B.bar.sp);(B.mins||[]).forEach(function(m){scene.remove(m.g);});QM.boss=null;(QM.BZ||[]).forEach(function(z){if(z.m)scene.remove(z.m);});QM.BZ=[];}
/* ---------- declenchement ---------- */
function qmArenaGo(zid,room,kind,P0){const zn=Z[zid],P=P0||qmArenaP();QM.arena={zid:zid,t:0,ph:'fight',ret:{},P:P.map(function(a){return a.id;}),room:room||null,kind:kind};
  P.forEach(function(a,k){const p0=qmP(a);QM.arena.ret[a.id]=[p0[2],p0[0],p0[1]];const s=zn.sp[k%zn.sp.length];a.zn=zid;a.x=s[0];a.z=s[1];a.path=null;a.job=null;a.at=null;a.gzn=null;a.grab=null;
    if(a.human){qmPlayerTo(zid,s[0],s[1]);pp.face=Math.PI;}else if(a.remote)qnS('arena',{id:a.id,zn:zid,x:s[0],z:s[1]});});
  QM.H.forEach(function(h){if(h.grabT){qmUngrab(h);}h.tg=null;h.st='patrol';});}
function qmBossCine(i){const D=QBOSS[i];qmCineCard('⚠️ BOSS '+(i+1)+'/4',D.ic,D.n,D.ar,D.q);}
function qmCineCard(t1,ic,n,ar,q){const el=$('qmBossC');el.innerHTML='<div class="qmbc"><div class="qmbc1">'+esc(t1)+'</div><div class="qmbc2">'+ic+'</div><div class="qmbc3">'+esc(n)+'</div><div class="qmbc4">'+esc(ar)+'</div><div class="qmbc5">« '+esc(q)+' »</div></div>';el.hidden=false;el.classList.remove('go');void el.offsetWidth;el.classList.add('go');
  clearTimeout(QM._bct);QM._bct=setTimeout(function(){el.hidden=true;},3300);QM.shake=.5;try{qmGrr();}catch(e){}}
/* ---------- degats ---------- */
function qmBHurt(a,q){if(!a||a.down>0||a.out)return;if((a.shT||0)>0)q=Math.ceil(q/2);qmHurt(a,q);}
function qmBossHit(dmg,a,o){const B=QM.boss;if(!B||B.dead||B.hp<=0||B.intro>0)return;o=o||{};if(QM.dmgT>0)dmg*=2;dmg=Math.max(1,Math.round(dmg));B.hp=Math.max(0,B.hp-dmg);B.hitF=.18;if(a)B.last=a;
  if(B.zn===cur)qmPow(B.x,B.z,dmg>=5?'BAM !!':dmg>=3?'BAM !':'POW !');if(o.st)B.stun=Math.max(B.stun,o.st);if(o.slow)B.slow=Math.max(B.slow,o.slow);
  if(o.kb&&a){const p=qmP(a),d=Math.max(.3,Math.hypot(B.x-p[0],B.z-p[1]));for(const L of [o.kb,o.kb*.6,o.kb*.3]){const nx=B.x+(B.x-p[0])/d*L,nz=B.z+(B.z-p[1])/d*L;if(!hit(nx,nz,.6,Z[B.zn])){B.x=nx;B.z=nz;break;}}}
  if(B.hp<=0)qmBossWin();}
function qmBossWin(){const B=QM.boss,A=QM.arena;B.dead=3;A.ph='loot';A.t=0;QM.BZ.forEach(function(z){if(z.m)scene.remove(z.m);});QM.BZ=[];B.mins.forEach(function(m){m.ko=99;});
  QM.j=Math.min(100,QM.j+10);const P=QM.A.filter(function(a){return a.zn===A.zid;});P.forEach(function(a){qmPts(a,15,'mgr');if(a.down>0){a.down=0;a.rev=0;a.hp=4;a.imm=3;}});if(B.last)qmPts(B.last,5,'mgr');
  QM.bossN++;const fin=B.i===3;qmBig(fin?'👑 LA DIRECTRICE EST VAINCUE ! +10 %':'🏆 '+B.d.n+' K.O. ! +10 % · ouvrez les coffres 🧰 !','key',1);
  if(B.last)qmMsg('🥊 Coup final : '+B.last.name+' (+5 ⭐)','good',1);
  const L=B.d.loot;qmChests(A,B.x,B.z,L.length?L:['batte','extinct'],P.length);
  if(L.length)P.forEach(function(a){if(!a.human&&!a.remote&&(!a.wp||QWRK[a.wp]<QWRK[L[0]]))a.wp=L[(Math.random()*L.length)|0];});
  if(QM.j>=100)setTimeout(function(){if(QM.on&&!QM.end)qmClose();},2500);}
function qmArenaEnd(win){const A=QM.arena;if(!A)return;QM.arena=null;let k0=0;QM.A.forEach(function(a){if(a.zn!==A.zid)return;let r=A.ret[a.id]||['office',QM.exit[0],QM.exit[1]];
    if(win&&A.room){const o=A.room;const q=o.spot?qmFree(o.zn,o.door.x+(k0%3-1)*.9,o.door.z+((k0/3)|0)*.9):qmFree(o.zn,Z[o.zn].spawn.x+(k0%4-1.5)*1.1,Z[o.zn].spawn.z+((k0/4)|0)*1.1);r=[o.zn,q[0],q[1]];k0++;}
    let zn=r[0];if(QM.lockZ[zn]||qmIsAr(zn)||qmIsCv(zn)){zn='office';r[1]=QM.exit[0];r[2]=QM.exit[1];}
    a.zn=zn;a.x=r[1];a.z=r[2];a.imm=3;a.path=null;a.job=null;if(a.down>0){a.down=0;a.rev=0;a.hp=4;}if(a.human)qmArenaLeaveMe(zn,a.x,a.z,win);else if(a.remote)qnS('arenaOut',{id:a.id,zn:zn,x:a.x,z:a.z,w:win?1:0});});
  for(let i=QM.WP.length-1;i>=0;i--)if(QM.WP[i].zn===A.zid)qmWpDel(QM.WP[i]);
  for(let i=QM.BX.length-1;i>=0;i--)if(QM.BX[i].zn===A.zid)qmBxDel(QM.BX[i]);(QM.HZ||[]).forEach(function(e){scene.remove(e.g);});QM.HZ=[];
  if(!win){QM.insp=30;qmBig('💢 Défaite… La direction est furieuse : managers sur les nerfs 30 s !','zomb',1);}
  qmBossKill();}
function qmArenaLeaveMe(zn,x,z,win){qmPlayerTo(zn,x,z);$('qmBossH').hidden=true;$('qmBossC').hidden=true;$('qmBlind').hidden=true;QM.blindT=0;QM.me.frz=0;if(win)qmMsg(QROOM.some(function(r){return QM.RM[r.id].zn===zn&&!QM.RM[r.id].spot;})?'🫧 Ouf ! Une salle tranquille : pas d\'ennemis ici. Les sabotages ×2 et les cartons t\'attendent.':'🏃 Retour au magasin !','good');}
/* ---------- zones d'attaque annoncees ---------- */
function qmBZAdd(o){o.id=++QM.bzN;QM.BZ.push(o);return o;}
function qmBZMesh(z){if(z.m)return;const red=z.k==='ice'?0x9fe3ff:0xe5484d;let geo;
  if(z.k==='circ'||z.k==='ice')geo=new T.CircleGeometry(z.r,28);else if(z.k==='cone')geo=new T.CircleGeometry(z.r,20,-z.a/2,z.a);else geo=new T.PlaneGeometry(z.w,z.len);
  const m=new T.Mesh(geo,new T.MeshBasicMaterial({color:red,transparent:true,opacity:.3,depthWrite:false,side:T.DoubleSide}));m.rotation.x=-Math.PI/2;
  if(z.k==='cone'){m.rotation.z=z.h-Math.PI/2;m.position.set(z.x,.07,z.z);}else if(z.k==='rect'){m.rotation.z=-z.h;m.position.set(z.x+Math.sin(z.h)*z.len/2,.07,z.z+Math.cos(z.h)*z.len/2);}else m.position.set(z.x,.06,z.z);
  scene.add(m);z.m=m;}
function qmInZ(z,x,y){const dx=x-z.x,dz=y-z.z;if(z.k==='circ'||z.k==='ice')return Math.hypot(dx,dz)<=z.r;
  if(z.k==='cone'){const d=Math.hypot(dx,dz);if(d>z.r)return false;let a=Math.atan2(dx,dz)-z.h;a=Math.atan2(Math.sin(a),Math.cos(a));return Math.abs(a)<=z.a/2;}
  const f=dx*Math.sin(z.h)+dz*Math.cos(z.h),s=dx*Math.cos(z.h)-dz*Math.sin(z.h);return f>=0&&f<=z.len&&Math.abs(s)<=z.w/2;}
function qmBZTick(dt,host){for(let i=QM.BZ.length-1;i>=0;i--){const z=QM.BZ[i];qmBZMesh(z);z.m.visible=QM.boss&&QM.boss.zn===cur;
    if(z.k==='ice'){z.life-=dt;z.m.material.opacity=.45;if(z.life<=0&&host){scene.remove(z.m);QM.BZ.splice(i,1);}continue;}
    z.t-=dt;const k=1-Math.max(0,z.t)/z.t0;z.m.material.opacity=.18+.45*k+(z.t<.3?Math.sin(QM.clk*40)*.15:0);
    if(z.t<=0){if(host)qmBZFire(z);scene.remove(z.m);QM.BZ.splice(i,1);}}}
function qmBZFire(z){const B=QM.boss;if(!B)return;const A=QM.A.filter(function(a){return a.zn===B.zn&&!(a.down>0)&&!a.out;});
  if(z.f==='verglas'){qmBZAdd({k:'ice',x:z.x,z:z.z,r:z.r,life:8});return;}
  if(z.f==='land'){const q=qmFree(B.zn,z.x,z.z);B.x=q[0];B.z=q[1];B.air=0;B.path=null;QM.shake=B.zn===cur?.35:0;if(B.zn===cur)qmThud(.7);
    A.forEach(function(a){const p=qmP(a);if(!qmInZ(z,p[0],p[1]))return;qmBHurt(a,3);const d=Math.max(.3,Math.hypot(p[0]-z.x,p[1]-z.z)),kx=(p[0]-z.x)/d*2,kz=(p[1]-z.z)/d*2;if(a.human){const nx=pp.x+kx,nz=pp.z+kz;if(!hit(nx,nz,.38,Z[cur])){pp.x=nx;pp.z=nz;}}else if(a.remote)qnS('hit',{id:a.id,kx:kx,kz:kz,q:3});});
    if(z.bar){B.st='barrage';B.bt=7;B.vt=.6;B.sh=B.shMax;qmBig('🛡️ '+B.d.n+' se protège et bombarde la salle : esquivez ! Pouvoirs et objets cassent son bouclier.','zomb',1);}return;}
  if(z.f==='dash'){B.dash={h:z.h,left:z.len,spd:z.sp||12,f:z.e};}
  A.forEach(function(a){const p=qmP(a);if(!qmInZ(z,p[0],p[1]))return;
    if(a.wp==='raquette'&&(z.f==='pate'||z.f==='dossiers')&&Math.random()<.6){qmBossHit(3,a);if(a.human)qmMsg('🎾 Renvoyé ! Le projectile repart vers le boss.','good');return;}
    const fx=z.e;if(fx==='pate'){qmBHurt(a,2);qmBFx(a,'slow',2);if(a.human)qmMsg('🥐 Pâton collant : ralenti !','bad');}
    else if(fx==='farine'){qmBHurt(a,2);qmBFx(a,'blind',3);}
    else if(fx==='givre'){qmBHurt(a,3);qmBFx(a,'slow',3);if(a.human)qmMsg('❄️ Givre : tu es gelé et ralenti !','bad');}
    else if(fx==='dossiers'){qmBHurt(a,2);if(a.human)qmMsg('📁 Pile de dossiers en pleine tête !','bad');}
    else if(fx==='entretien'){qmBHurt(a,3);qmBFx(a,'frz',3);}
    else if(fx==='rain'){qmBHurt(a,2);if(a.human)qmMsg(B.d.pj+' Touché !','bad');}
    else if(fx==='cart'){qmBHurt(a,3);const kx=Math.sin(z.h)*2,kz=Math.cos(z.h)*2;if(a.human){const nx=pp.x+kx,nz=pp.z+kz;if(!hit(nx,nz,.38,Z[cur])){pp.x=nx;pp.z=nz;}}else if(a.remote)qnS('hit',{id:a.id,kx:kx,kz:kz,q:3});if(a.human)qmMsg('🛒 Percuté par un caddie !','bad');}
    else if(fx==='charge'){qmBHurt(a,6);const kx=Math.sin(z.h)*2.2,kz=Math.cos(z.h)*2.2;if(a.human){const nx=pp.x+kx,nz=pp.z+kz;if(!hit(nx,nz,.38,Z[cur])){pp.x=nx;pp.z=nz;}QM.shake=.4;}else if(a.remote)qnS('hit',{id:a.id,kx:kx,kz:kz,q:6});}});}
function qmBFx(a,k,d){if(a.human)qmBFxMe(k,d);else if(a.remote)qnS('bfx',{id:a.id,k:k,d:d});else if(k==='frz'||k==='slow')a.slowT=d;}
function qmBFxMe(k,d){const me=QM.me;if(k==='slow')me.slowT=Math.max(me.slowT||0,d);else if(k==='blind'){QM.blindT=d;qmMsg('🌫️ Aveuglé par la farine !','bad');}else if(k==='frz'){me.frz=d;qmMsg('📋 Convoqué à un entretien : immobilisé '+d+' s !','bad');}else if(k==='spring'){me.frz=d;qmMsg('🤡 Un ressort te saute au visage !','bad');}}
/* ---------- tick ---------- */
function qmBossAtt(B,tg,x,z){const L=B.d.att,k=L[(Math.random()*L.length)|0];const live=QM.A.filter(function(a){return a.zn===B.zn&&qmLive(a)&&!(a.down>0);});
  if(k==='pate'){qmBZAdd({k:'circ',x:x,z:z,r:1.4,t:1.1,t0:1.1,f:'pate',e:'pate'});const o={id:tg.id,k:'throw',zn:B.zn,x:B.x,z:B.z,tx:x,tz:z,ic:'🥐'};qmPowFx(tg,'throw',o);if(QM.mp&&QN.host)qnS('fx',o);if(B.zn===cur)say(B.g,'Attrape ça !');}
  else if(k==='farine'){qmBZAdd({k:'circ',x:B.x,z:B.z,r:4.2,t:1.3,t0:1.3,f:'farine',e:'farine'});if(B.zn===cur)say(B.g,'Un peu de farine ?!');}
  else if(k==='givre'){qmBZAdd({k:'cone',x:B.x,z:B.z,r:6.5,a:1,h:Math.atan2(x-B.x,z-B.z),t:1.1,t0:1.1,f:'givre',e:'givre'});if(B.zn===cur)say(B.g,'Souffle glacial !');}
  else if(k==='verglas'){qmShuffle(live.slice()).slice(0,3).forEach(function(a){const p=qmP(a);qmBZAdd({k:'circ',x:p[0],z:p[1],r:2,t:1,t0:1,f:'verglas'});});if(B.zn===cur)say(B.g,'Attention, ça glisse !');}
  else if(k==='dossiers'){qmShuffle(live.slice()).slice(0,3).forEach(function(a){const p=qmP(a);qmBZAdd({k:'circ',x:p[0],z:p[1],r:1.3,t:1.1,t0:1.1,f:'dossiers',e:'dossiers'});const o={id:a.id,k:'throw',zn:B.zn,x:B.x,z:B.z,tx:p[0],tz:p[1],ic:'📁'};qmPowFx(a,'throw',o);if(QM.mp&&QN.host)qnS('fx',o);});if(B.zn===cur)say(B.g,'Voici vos dossiers !');}
  else if(k==='entretien'||k==='charge'){const h=Math.atan2(x-B.x,z-B.z),len=k==='charge'?12:9;qmBZAdd({k:'rect',x:B.x,z:B.z,w:k==='charge'?2.2:1.8,len:len,h:h,t:1.1,t0:1.1,f:'dash',e:k,sp:k==='charge'?13:10});B.at+=.6;if(B.zn===cur)say(B.g,k==='charge'?'DÉGAGEZ !':'Entretien individuel !');}}
function qmMinSpawn(B,n){for(let k=0;k<n;k++){const g=makeChar({shirt:0x1f3a5f,pants:0x1b1b1b,hair:0x2b1d14,hs:'court'});scene.add(g);const p=qmFree(B.zn,B.x+(k?2:-2),B.z+1);B.mins.push({g:g,x:p[0],z:p[1],zn:B.zn,h:0,ph:0,ko:0,hits:0,cd:0,path:null,pi:0,rp:0});}qmBig('📞 La directrice appelle des managers en renfort !','zomb',1);}
function qmMinTick(dt){const B=QM.boss;if(!B)return;B.mins.forEach(function(m){if(m.ko>0){m.g.position.set(m.x,0,m.z);return;}if(m.cd>0)m.cd-=dt;let tg=null,bd=1e9;QM.A.forEach(function(a){if(a.zn!==m.zn||!qmLive(a)||a.down>0)return;const p=qmP(a),d=Math.hypot(p[0]-m.x,p[1]-m.z);if(d<bd){bd=d;tg=a;}});
  if(tg){const p=qmP(tg);if(bd>1.1){m.rp-=dt;if(m.rp<=0||!m.path||m.pi>=m.path.length){m.path=path(Z[m.zn],m.x,m.z,p[0],p[1]);m.pi=0;m.rp=.5;}const ox=m.x,oz=m.z;follow(m,dt,3.2);if(Math.hypot(m.x-ox,m.z-oz)>.001)m.h=Math.atan2(m.x-ox,m.z-oz);m.ph+=dt*6;walkAnim(m.g,m.ph,1);}else{walkAnim(m.g,0,0);if(m.cd<=0&&!(tg.imm>0)){m.cd=1.5;qmBHurt(tg,2);tg.imm=1;}}}
  m.g.position.set(m.x,0,m.z);m.g.rotation.y=m.h;});}
/* ---------- corps a corps dans l'arene ---------- */
/* ---------- pouvoirs contre le boss ---------- */
/* ---------- armes au sol ---------- */
function qmWpAdd(k,zn,x,z,id){const sp=label(QWP[k].ic,{sx:1.3,sy:1.3,w:96,h:96,size:70,bg:'rgba(255,210,31,.95)'});sp.position.set(x,1.1,z);scene.add(sp);const w={id:id||++QM.wpN,k:k,zn:zn,x:x,z:z,sp:sp};QM.WP.push(w);return w;}
function qmWpDel(w){scene.remove(w.sp);const i=QM.WP.indexOf(w);if(i>=0)QM.WP.splice(i,1);}
function qmWpTake(a,w){if(a.wp){const p=qmP(a);qmWpAdd(a.wp,w.zn,w.x,w.z);}const old=a.wp;a.wp=w.k;qmWpDel(w);if(a.human)qmMsg(QWP[w.k].ic+' '+(old?'Échangé ! Tu as maintenant : ':'Tu ramasses : ')+QWP[w.k].n+' ('+QWP[w.k].d+'). Tu frappes avec !','good');}
function qmWpNear(a){const p=qmP(a);return QM.WP.find(function(w){return w.zn===p[2]&&Math.hypot(w.x-p[0],w.z-p[1])<1.1&&w.k!==a.wp;});}
function qmWpSwap(a){const w=qmWpNear(a);if(!w)return false;if(QM.mp&&QN.client&&a.human){qnS('a',{pid:QN.pid,k:'wpsw',id:w.id});return true;}qmWpTake(a,w);return true;}
/* ---------- cartons ---------- */
function qmBxMesh(b){const g=new T.Group();if(b.ch){box(g,1.3,.8,.9,0x8a4b1f,0,.4,0);box(g,1.34,.12,.94,0xd4af37,0,.82,0);box(g,.2,.3,.08,0xd4af37,0,.6,.47);}else{box(g,.9,.7,.8,0xb5874f,0,.35,0);box(g,.92,.06,.12,0xd9b27a,0,.71,0);}const lb=label(b.ch?'🧰':'📦',{sx:.8,sy:.8,w:96,h:96,size:64,bg:'rgba(255,255,255,.9)'});lb.position.set(0,1.45,0);g.add(lb);g.position.set(b.x,0,b.z);g.rotation.y=(b.id*1.7)%6.28;scene.add(g);b.g=g;}
function qmBxAdd(zn,x,z,id,ch){const b={id:id||++QM.bxN,zn:zn,x:x,z:z,ch:ch||0};qmBxMesh(b);QM.BX.push(b);return b;}
function qmBxDel(b){scene.remove(b.g);const i=QM.BX.indexOf(b);if(i>=0)QM.BX.splice(i,1);}
function qmBxSpawn(){const zs=QZ.filter(function(z){return !QM.lockZ[z];});const zn=zs[(Math.random()*zs.length)|0];let p=qmRand(zn);p=qmFree(zn,p[0]+(Math.random()-.5)*2,p[1]+(Math.random()-.5)*2);
  if(QM.BX.some(function(b){return b.zn===zn&&Math.hypot(b.x-p[0],b.z-p[1])<4;}))return;if(QM.R.some(function(r){return r.zn===zn&&Math.hypot(r.x-p[0],r.z-p[1])<2.2;}))return;qmBxAdd(zn,p[0],p[1]);}
function qmBxOpen(a,b){if(!b||QM.BX.indexOf(b)<0)return;qmBxDel(b);if(b.ch){qmChestOpen(a,b);return;}qmNoise(a,8);const r=Math.random(),nm=a.human?'Tu':a.name;
  if(r<.4){const k=QCONS[(Math.random()*QCONS.length)|0];qmItemAdd(++QM.itN,k,b.zn,b.x,b.z);if(a.human)qmMsg('📦 Dans le carton : '+QIT[k].ic+' '+QIT[k].n+' !','good');}
  else if(r<.55){const L=QTHR[b.zn]||QTHR.store,k=L[(Math.random()*L.length)|0];if(!a.item){a.item=k;if(a.human)qmMsg('📦 Dans le carton : '+QIT[k].ic+' '+QIT[k].n+' à lancer !','good');}else qmItemAdd(++QM.itN,k,b.zn,b.x,b.z);}
  else if(r<.8){const k=QCONS[(Math.random()*QCONS.length)|0];qmItemAdd(++QM.itN,k,b.zn,b.x,b.z);if(a.human)qmMsg('📦 Dans le carton : '+QIT[k].ic+' '+QIT[k].n+' !','good');}
  else if(r<.9){if(qmWl(a)<3){a.wl=qmWl(a)+1;if(a.human)qmMsg('📦 ⬆️ Amélioration ! '+qmCW(a).ic+' '+qmCW(a).n+' niveau '+a.wl+' !','good');}else{qmPts(a,3,'');if(a.human)qmMsg('📦 Ton arme est déjà au max : +3 ⭐','good');}}
  else{if(Math.random()<.5){qmBFx(a,'spring',1.2);if(a.remote)qnS('bfx',{id:a.id,k:'spring',d:1.2});}else{qmBFx(a,'blind',2);if(a.human)qmMsg('💨 Un nuage de poussière !','bad');}}}
function qmBxTick(dt){if(QM.mp&&QN.client)return;if(!QM.bxInit){QM.bxInit=1;for(let i=0;i<20&&QM.BX.length<7;i++)qmBxSpawn();}QM.bxT-=dt;if(QM.bxT<=0){QM.bxT=QM.BX.length<4?2:20;if(QM.BX.length<9)qmBxSpawn();}
  /* ramassage d'armes par les bots */
  QM.A.forEach(function(a){if(a.human||a.remote||a.wp||!qmLive(a))return;const w=QM.WP.find(function(w){return w.zn===a.zn&&Math.hypot(w.x-a.x,w.z-a.z)<1;});if(w)qmWpTake(a,w);});
  QM.A.forEach(function(a){if(!(a.human||a.remote)||a.wp||!qmLive(a)||a.down>0)return;const p=qmP(a);const w=QM.WP.find(function(w){return w.zn===p[2]&&Math.hypot(w.x-p[0],w.z-p[1])<1;});if(w)qmWpTake(a,w);});}
/* ---------- bots dans l'arene ---------- */
function qmArenaBot(a,dt){if(a.down>0){qmPose(a,dt,false);return;}const B=QM.boss,WV=QM.arena&&QM.arena.kind==='wave';if(!WV&&(!B||B.dead)||WV&&QM.arena.ph!=='fight'){qmPose(a,dt,false);return;}
  const dn=QM.A.find(function(b){return b!==a&&b.zn===a.zn&&b.down>0&&!QM.A.some(function(c){return c!==a&&c!==b&&c.zn===a.zn&&!(c.down>0)&&Math.hypot(c.x-b.x,c.z-b.z)<1.6;});});
  let gx,gz;const inDanger=QM.BZ.find(function(z){return z.k!=='ice'&&qmInZ(z,a.x,a.z);});if(B&&B.air&&!inDanger){}
  if(inDanger){const d=Math.max(.3,Math.hypot(a.x-inDanger.x,a.z-inDanger.z));gx=a.x+(a.x-inDanger.x)/d*3;gz=a.z+(a.z-inDanger.z)/d*3;}
  else if(dn&&a.id%2===0){gx=dn.x;gz=dn.z;}else if(WV){let t=null,bd=1e9;(QM.HZ||[]).forEach(function(e){if(e.ko>0)return;const d=Math.hypot(e.x-a.x,e.z-a.z);if(d<bd){bd=d;t=e;}});if(!t){qmPose(a,dt,false);return;}gx=t.x;gz=t.z;}else{const t=B.mins.find(function(m){return !(m.ko>0);})||B;gx=t.x;gz=t.z;if(B.air||B.st==='barrage'&&B.sh>0&&!a.item){const pl=Z[a.zn].piles;if(pl&&!a.item){const q=pl.slice().sort(function(x,y){return Math.hypot(x.x-a.x,x.z-a.z)-Math.hypot(y.x-a.x,y.z-a.z);})[0];gx=q.x;gz=q.z;if(Math.hypot(q.x-a.x,q.z-a.z)<1.5)a.item=q.k;}}if(a.item&&B.sh>0&&(a.icd||0)<QM.clk&&Math.hypot(B.x-a.x,B.z-a.z)<9){a.icd=QM.clk+2;qmUseItem(a);}}
  const d=Math.hypot(gx-a.x,gz-a.z),rr=Math.max(1.5,qmCW(a).r*.8);a.rp=(a.rp||0)-dt;
  if(d>rr||inDanger||blocked(Z[a.zn],a.x,a.z,gx,gz)){if(a.rp<=0||!a.path||a.pi>=a.path.length){a.path=path(Z[a.zn],a.x,a.z,gx,gz);a.pi=0;a.rp=.5;}const ox=a.x,oz=a.z;follow(a,dt,3.4);if(Math.hypot(a.x-ox,a.z-oz)>.001)a.hd=Math.atan2(a.x-ox,a.z-oz);a.ph=(a.ph||0)+dt*6;qmPose(a,dt,true);}
  else{a.hd=Math.atan2(gx-a.x,gz-a.z);qmPose(a,dt,false);if((WV||!(B.intro>0))&&(a.bac||0)<QM.clk){if(qmAtk(a))a.bac=QM.clk+1.2+Math.random()*.8;}}}

/* ---------- coffres de fin d'arene ---------- */
function qmLootTick(dt){const A=QM.arena;if(!A||A.ph!=='loot')return;A.t+=dt;const left=QM.BX.filter(function(b){return b.zn===A.zid&&b.ch;}).length;if(!left)A.lt+=dt;
  /* les bots ouvrent les coffres si aucun humain ne le fait */
  if(left&&A.t>6){const b=QM.BX.find(function(b){return b.zn===A.zid&&b.ch;});const bot=QM.A.find(function(x){return x.zn===A.zid&&!x.human&&!x.remote&&!(x.down>0);});if(b&&bot&&A.t>9)qmBxOpen(bot,b);}
  if(A.lt>=7||A.t>=20)qmArenaEnd(true);}
/* ---------- arene des vagues (horde de zombies / meute de clients) ---------- */
function qmWaveStart(kind,room){if(QM.mp&&QN.client)return;if(!Z.ar_hor)qmArenaInit();qmArenaGo('ar_hor',room,'wave',qmArenaP(0));const A=QM.arena;A.wk=kind;A.wave=0;A.nw=3;A.wt=3.5;QM.HZ=QM.HZ||[];QM.hzN=QM.hzN||0;
  const n=Math.max(1,A.P.length);A.sz=[6,9,12].map(function(v){return Math.round(v*(.55+.12*n));});
  qmWaveCine(kind);if(QM.mp&&QN.host)qnS('wcine',{k:kind});}
function qmWaveCine(kind){if(kind==='zomb')qmCineCard('⚠️ ALERTE','🧟','La horde !','Réserve des soldes','3 vagues de clients zombies : mettez-les tous K.O. !');else qmCineCard('⚠️ ALERTE','🛍️','La meute des soldes !','Réserve des soldes','3 vagues de clients énervés : tenez bon !');QM.shake=.4;}
function qmHzMesh(e){const lk={shirt:[0xd94841,0x3b82f6,0xf59e0b,0x10b981,0x8b5cf6][e.id%5],pants:0x334155,hair:[0x2b1d14,0xc9a227,0x1b1b1b,0x6b3a2a][e.id%4],fem:e.id%2===1,hs:e.id%2?'long':'court'};if(e.ty===2){lk.skin=0x8fbf7a;lk.shirt=0x5b6b4a;}e.g=makeChar(lk);scene.add(e.g);if(e.ty!==2)try{qmAccCli(e.g,e.id);}catch(_){}}
function qmHzAdd(ty,x,z,zn,id){const e={id:id||++QM.hzN,ty:ty,x:x,z:z,zn:zn,h:0,ph:0,ko:0,hits:0,cd:0,path:null,pi:0,rp:Math.random()*.5};qmHzMesh(e);QM.HZ.push(e);return e;}
function qmHzDel(e){scene.remove(e.g);const i=QM.HZ.indexOf(e);if(i>=0)QM.HZ.splice(i,1);}
function qmWaveTick(dt,host){const A=QM.arena,H=$('qmBossH');const alive=(QM.HZ||[]).filter(function(e){return !(e.ko>0);}).length;
  if(H){const on=cur===A.zid;H.hidden=!on;if(on){const t=A.ph==='loot'?'Victoire ! Ouvrez les coffres 🧰':!A.wave?'Ça arrive… préparez-vous !':'Vague '+Math.max(1,A.wave)+'/'+(A.nw||3)+' · '+alive+' restant'+(alive>1?'s':'');const h='<div class="qmbh1">'+(A.wk==='zomb'?'🧟 La horde':'🛍️ La meute des soldes')+'<small>'+t+'</small></div><div class="qmbh2"><i style="width:'+(A.ph==='loot'?100:Math.round(((A.wave||1)-1)/(A.nw||3)*100+(A.wsz?(1-alive/A.wsz)*100/(A.nw||3):0)))+'%;background:#2e8c46"></i></div>';if(H._h!==h){H._h=h;H.innerHTML=h;}}}
  (QM.HZ||[]).forEach(function(e){e.g.visible=e.zn===cur;if(e.ko>0){e.ko-=dt;e.g.rotation.x=Math.min(1.5,e.g.rotation.x+dt*5);e.g.position.set(e.x,0,e.z);if(e.ko<=0&&host)e.del=1;return;}
    if(!host){const dx=(e.tx===undefined?e.x:e.tx)-e.x,dz=(e.tz===undefined?e.z:e.tz)-e.z,d=Math.hypot(dx,dz);if(d>.01){const st=Math.min(d,dt*Math.max(4,d*6));e.x+=dx/d*st;e.z+=dz/d*st;e.h=Math.atan2(dx,dz);}e.ph+=d>.03?dt*7:0;walkAnim(e.g,e.ph,d>.03?1:0);e.g.position.set(e.x,0,e.z);e.g.rotation.y=e.h;return;}
    if(e.cd>0)e.cd-=dt;let tg=null,bd=1e9;QM.A.forEach(function(a){if(a.zn!==e.zn||!qmLive(a)||a.down>0)return;const p=qmP(a),d=Math.hypot(p[0]-e.x,p[1]-e.z);if(d<bd){bd=d;tg=a;}});
    if(tg){const p=qmP(tg);if(bd>1){e.rp-=dt;if(e.rp<=0||!e.path||e.pi>=e.path.length){e.path=blocked(Z[e.zn],e.x,e.z,p[0],p[1])?path(Z[e.zn],e.x,e.z,p[0],p[1]):[[p[0],p[1]]];e.pi=0;e.rp=.5;}const ox=e.x,oz=e.z;follow(e,dt,e.ty===2?2.1:2.4);if(Math.hypot(e.x-ox,e.z-oz)>.001)e.h=Math.atan2(e.x-ox,e.z-oz);e.ph+=dt*7;walkAnim(e.g,e.ph,1);}
      else{walkAnim(e.g,0,0);if(e.cd<=0&&!(tg.imm>0)){e.cd=1.6;qmBHurt(tg,e.ty===2?2:1);tg.imm=.8;if(e.zn===cur&&Math.random()<.3)say(e.g,e.ty===2?'Grrraaah…':['Je veux un remboursement !','C\'est MON article !','Poussez-vous !'][(Math.random()*3)|0]);}}}
    if(e.ty===2&&e.zn===cur&&Math.random()<dt*.08)try{qmGrr();}catch(_){}
    e.g.position.set(e.x,0,e.z);e.g.rotation.y=e.h;});
  if(!host)return;for(let i=QM.HZ.length-1;i>=0;i--)if(QM.HZ[i].del)qmHzDel(QM.HZ[i]);
  A.t+=dt;if(A.ph==='loot'){qmLootTick(dt);return;}
  const P=QM.A.filter(function(a){return a.zn===A.zid&&!a.out;});if(!P.length||P.every(function(a){return a.down>0;})||A.t>=100){qmArenaEnd(false);return;}
  A.wt-=dt;const left=QM.HZ.filter(function(e){return !(e.ko>0);}).length;
  if(A.wave<A.nw&&(A.wt<=0||(left===0&&A.wave>0&&A.wt<11))){const zn=Z[A.zid],N=A.sz[A.wave];A.wave++;A.wsz=N+left;A.wt=14;for(let k=0;k<N;k++){const d=zn.doors[k%zn.doors.length],q=qmFree(A.zid,d[0]+(Math.random()-.5)*1.6,d[1]+(Math.random()-.5)*1.6);qmHzAdd(A.wk==='zomb'?2:1,q[0],q[1],A.zid);}
    qmBig((A.wk==='zomb'?'🧟':'🛍️')+' Vague '+A.wave+'/'+A.nw+' !','zomb',1);}
  else if(A.wave>=A.nw&&left===0){A.ph='loot';A.t=0;QM.j=Math.min(100,QM.j+5);P.forEach(function(a){qmPts(a,5,'mgr');if(a.down>0){a.down=0;a.rev=0;a.hp=4;a.imm=3;}});
    qmBig('🏆 '+(A.wk==='zomb'?'Horde repoussée':'Meute calmée')+' ! +5 % · ouvrez les coffres 🧰','key',1);qmChests(A,zn0x(A),zn0z(A),['balai','poele','raquette','eau'],P.length);if(QM.j>=100)setTimeout(function(){if(QM.on&&!QM.end)qmClose();},2500);}}
function zn0x(A){return Z[A.zid].bs[0];}function zn0z(A){return Z[A.zid].bs[1];}

/* ---------- arenes donjon (40 x 30) ---------- */
function qmArenaInit(){QBOSS.forEach(function(B,i){const zid='ar_'+B.id;if(Z[zid])return;const o=B.o;zone(zid,B.ar,0,{x:[o[0]-2,o[0]+QAW+2],z:[o[1]-2,o[1]+QAD+2]},{x:o[0]+QAW/2,z:o[1]+QAD-2});
  QZN[zid]=B.ic+' '+B.ar;const zn=Z[zid],g=zn.g;box(g,QAW+2,.1,QAD+2,B.fl,o[0]+QAW/2,-.05,o[1]+QAD/2);
  const W=function(a,b,c,d,h,col){box(g,b-a,h||2.8,d-c,col||B.wl,(a+b)/2,(h||2.8)/2,(c+d)/2);zn.obs.push({a:a,b:b,c:c,d:d});};
  const F=function(x,z,w,d,h,col){W(o[0]+x-w/2,o[0]+x+w/2,o[1]+z-d/2,o[1]+z+d/2,h,col);};const D=function(x,z,w,h,d,col,y){box(g,w,h,d,col,o[0]+x,(y||0)+h/2,o[1]+z);};
