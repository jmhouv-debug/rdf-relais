  box(g,.6,2.4,6,0x8a6a45,-47.2,1.2,14,true);obs(B,-47.2,14,.8,6.2);for(let i=0;i<5;i++)sph(g,.28,0xb9803f,-46.9,.9+((i%3)*.6),11.8+i*1.2,1,.7,1.8);
  box(g,4,1.2,1,0xf4f4f4,-36,.6,18.8,true);box(g,3.8,.7,.9,0xcfe3f2,-36,1.5,18.8,false);obs(B,-36,18.8,4.2,1.2);
