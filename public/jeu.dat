function giveImg(n){image=Math.min(100,image+n);}
Object.assign(FX,{
 leche:function(){const m=nearMgrP(5);if(!m){toast('Aucun manager à portée : colle-toi à un manager pour faire le lèche-cul.');return null;}giveImg(10);addW(6);say(m.g,'Hmm… merci, c\'est gentil.');return '🍯 Lèche-cul de compétition : Sérieux +10, +6 bosseur.';},
 cafeboss:function(){const m=nearMgrP(5);if(!m){toast('Aucun manager à portée pour lui offrir un café.');return null;}giveImg(6);addW(4);m.stand=Math.min(100,m.stand+6);drawM(m);say(m.g,'Oh, un café ! Merci.');return '☕ '+m.name+' apprécie : Sérieux +6, +4 bosseur.';},
 repos:function(){giveImg(8);addW(10);return '📅 Tu viens bosser ton jour de repos. Sérieux +8, +10 bosseur. Tes collègues te regardent bizarrement.';},
 gateau:function(){let n=0;MGR.forEach(function(m){if(!m.fired&&m.zn===cur&&Math.hypot(m.x-pp.x,m.z-pp.z)<9){m.stand=Math.min(100,m.stand+3);drawM(m);say(m.g,'Miam !');n++;}});giveImg(8);addW(8);return '🎂 Gâteau partagé'+(n?' ('+n+' manager'+(n>1?'s':'')+' content'+(n>1?'s':'')+')':'')+' : Sérieux +8, +8 bosseur.';},
 heures:function(){giveImg(16);addW(14);return '🕘 Heures sup « pour le projet » : Sérieux +16, +14 bosseur.';},
 alibi:function(){VEST=Math.max(VEST,60);giveImg(4);addW(4);addB(4);return '🕴️ Alibi en béton : 60 s sans soupçon. Sérieux +4, +4 bosseur, +4 branleur.';},
 doublejeu:function(){giveImg(8);addW(10);addB(10);coins+=15;return '🎭 Double jeu réussi : +10 bosseur, +10 branleur, Sérieux +8, +15 pièces.';},
 taupe:function(){const L=liveMgrs();if(L.length)hitMgr(L[(Math.random()*L.length)|0],10);giveImg(10);addW(15);addB(15);return '🐀 La directrice a reçu un petit mot anonyme : un manager perd 10 de réputation. +15 bosseur, +15 branleur, Sérieux +10.';},
 mdiscours:function(){RESULT=Math.min(100,RESULT+4);giveImg(6);addW(8);return '🎤 Discours motivant : Résultats +4, Sérieux +6, +8 bosseur.';},
 mprime:function(){RESULT=Math.min(100,RESULT+6);giveImg(10);addW(12);return '🎁 Prime d\'équipe : Résultats +6, Sérieux +10, +12 bosseur.';},
 mpause:function(){RESULT=Math.max(0,RESULT-2);addB(8);return '😴 Sieste planquée… personne n\'a rien vu. +8 branleur, Résultats −2.';},
 mfrais:function(){RESULT=Math.max(0,RESULT-3);coins+=25;addB(10);return '🧾 Note de frais bidon validée : +25 pièces, +10 branleur, Résultats −3.';},
 mdouble:function(){RESULT=Math.min(100,RESULT+5);giveImg(8);addW(8);addB(8);return '🎭 Double jeu du manager : Résultats +5, Sérieux +8, +8 bosseur, +8 branleur.';}});
function runFx(it){const f=FX[it.fx];if(!f)return false;const ew=rank<1&&!SEC&&it.t!=='m'&&EWP[it.id]!==undefined,sb0=SB;ITW=ew?1:0;let m;try{m=f();}finally{ITW=0;}if(m===null||m===undefined)return false;if(ew){NOCOIN=1;try{addB(EWP[it.id]);}finally{NOCOIN=0;}const g=SB-sb0;m=empTxt(m)+'.'+(g>0?' +'+g+' branleur.':'');}pop((it.ic||'✅')+' Tu utilises : '+it.n,'good');toast(m);return true;}
function renderQI(){const q=$('qi');let h='';ITEMS.forEach(function(i){if(!i.passive&&!i.pc&&INV[i.id]>0&&((i.t==='m')===(rank>=1)))h+='<button data-u="'+i.id+'" title="'+i.n+'">'+i.ic+'<b>'+INV[i.id]+'</b></button>';});q.innerHTML=h;q.hidden=!h||mode!=='zone';}
let FLASH={id:'',t:-9};
function buyItem(id){const it=ITEMS.find(function(i){return i.id===id;});if(!it||!itemOK(it)||coins<it.p)return;if((id==='torche'||id==='torchem')&&INV[id]>0){toast('Tu as déjà ta lampe torche.');return;}if(rank<1&&!WCIN){toast('Pour acheter un item, il faut aller aux toilettes.');return;}coins-=it.p;INV[id]=(INV[id]||0)+(id==='batte'?3:1);FLASH={id:id,t:clk};toast(it.n+' acheté (×'+INV[id]+').');renderPhone();renderQI();}
function useItem(id){CONN=1;try{return useItem0(id);}finally{CONN=0;}}
function useItem0(id){const it=ITEMS.find(function(i){return i.id===id;});if(!it||!(INV[id]>0))return;
  if(mode!=='zone'){toast('Entre dans une zone pour utiliser un objet.');return;}
  if(it.fx){if(runFx(it)){INV[id]--;renderQI();if(PHN)renderPhone();}return;}
  if(it.t==='m'){const n0=INV[id];useMItem(id);if(INV[id]<n0)pop((it.ic||'✅')+' Tu utilises : '+it.n,'good');return;}
  if(it.pc){toast('Cet objet s\'utilise sur un ordinateur (bureaux).');return;}
  let sp=null;
  if(it.k==='dirback'){if(!behindD(2.6)){toast('Colle-toi juste derrière la directrice, quand elle est de dos, pour lui coller le papier.');return;}}
  else if(it.k==='floor'){if(cur!=='store'){toast('La peau de banane ne se pose que dans les allées du magasin.');return;}}
  else if(it.k){sp=spotNear(it.k);if(!sp){toast('Cet objet ne s\'utilise que sur '+SPL[it.k]+'. Les endroits utiles sont entourés d\'un anneau doré.');return;}}
  let ok=true;const st=(cur==='salle')?salTrap(id,sp):false;if(st===null)return;
  if(st){}
  else if(id==='coussin'){const m=new T.Mesh(new T.CircleGeometry(.4,20),new T.MeshBasicMaterial({color:0xff8fb1,transparent:true,opacity:.95}));m.rotation.x=-Math.PI/2;m.position.set(sp.x,.58,sp.z);Z[cur].g.add(m);puddles.push({x:sp.x,z:sp.z,t:90,mesh:m,k:'coussin',zg:Z[cur].g,zn:cur,r:1.5});toast('Coussin posé sur le siège. Attends qu\'un manager s\'approche…');}
  else if(id==='petard'){let c=0;const hit=function(o){if(o.zn===cur&&!o.fired&&Math.hypot(o.x-sp.x,o.z-sp.z)<9){o.stun=Math.max(o.stun,3);c++;}};MGR.forEach(hit);GUARDS.forEach(hit);if(cur===D.zn&&Math.hypot(D.x-sp.x,D.z-sp.z)<9){D.stun=Math.max(D.stun,3);c++;}addB(4);toast('BOUM dans la poubelle ! '+(c?c+' personne'+(c>1?'s':'')+' sursaute'+(c>1?'nt':'')+'. Cours !':'Personne autour.')+' +4 branleur');}
  else if(id==='brouil'){JAM=20;toast('Brouilleur branché : caméras aveugles 20 s.');}
  else if(id==='deguis'){DISG=25;toast('Tu enfiles le déguisement : managers et directrice ne te voient plus 25 s.');}
  else if(id==='cafe'){const m=new T.Mesh(new T.CircleGeometry(.25,16),new T.MeshBasicMaterial({color:0x3e2723,transparent:true,opacity:.95}));m.rotation.x=-Math.PI/2;m.position.set(sp.x,.05,sp.z-.5);Z[cur].g.add(m);puddles.push({x:sp.x,z:sp.z,t:120,mesh:m,k:'cafe',zg:Z[cur].g,zn:cur,r:2.6});toast('Café piégé. Le prochain manager qui passe à la machine va le regretter…');}
  else if(id==='papier'){dPaper=45;addB(10);toast('Papier « Je suis nulle » collé dans le dos de la directrice ! +10 branleur');}
  else if(id==='banane'){const m=new T.Mesh(new T.CircleGeometry(.4,16),new T.MeshBasicMaterial({color:0xf2d14b,transparent:true,opacity:.95}));m.rotation.x=-Math.PI/2;m.position.set(pp.x,.04,pp.z);Z.store.g.add(m);puddles.push({x:pp.x,z:pp.z,t:70,mesh:m,k:'banane',zg:Z.store.g,zn:'store'});toast('Peau de banane posée. Attends que quelqu\'un passe…');}
  else if(id==='gilet'){VEST=40;if(isCseMe()){PIMM=Math.max(PIMM,20);toast('Gilet syndical enfilé : tu as l\'air débordé et le syndicat te protège 20 s.');}else toast('Gilet enfilé : tu as l\'air débordé pendant 40 s.');}
  else ok=false;
  if(ok){INV[id]--;renderQI();}}
$('phBody').addEventListener('click',function(e){const t=e.target.closest('button');if(!t)return;if(t.dataset.c!==undefined){PCT[PHN==='inv'?'inv':'shop']=t.dataset.c;renderPhone();}else if(t.dataset.b)buyItem(t.dataset.b);else if(t.dataset.u){const id=t.dataset.u;closePhone();useItem(id);}else if(t.dataset.g!==undefined)goMsg(+t.dataset.g);else if(t.dataset.m){if(authAct(t.dataset.m,t,+t.dataset.i,PA,closePhone))return;renderPhone();}});
$('phTabM').addEventListener('click',function(){PHN='msg';renderPhone();});
$('phTabS').addEventListener('click',function(){PHN='shop';renderPhone();});
$('phTabI').addEventListener('click',function(){PHN='inv';renderPhone();});
$('phTabA').addEventListener('click',function(){PHN='auth';PA.step='mauth';renderPhone();});
$('phClose').addEventListener('click',closePhone);$('qi').addEventListener('click',function(e){const t=e.target.closest('button');if(t)useItem(t.dataset.u);});
$('bTel').addEventListener('click',function(){openPhone('shop');});
function drawPhoto(m,spot){const cv=$('phC'),x=cv.getContext('2d'),W=cv.width,H=cv.height;
  const bg=x.createLinearGradient(0,0,0,H);if(spot==='pause'){bg.addColorStop(0,'#6f8f6b');bg.addColorStop(1,'#8d6a45');}else{bg.addColorStop(0,'#aeb1b8');bg.addColorStop(1,'#6e727c');}
  x.fillStyle=bg;x.fillRect(0,0,W,H);
  if(spot==='pause'){x.fillStyle='#3f7a47';[[30,60,34],[200,70,40],[110,40,26]].forEach(function(c){x.beginPath();x.arc(c[0],c[1],c[2],0,7);x.fill();});}
  else{x.fillStyle='#f28c28';[20,90,160,215].forEach(function(px){x.fillRect(px,20,8,100);});x.fillStyle='#2f6fb5';x.fillRect(10,60,230,8);x.fillRect(10,100,230,8);}
  x.fillStyle=hex6(m.look.shirt);rr(x,70,138,100,90,16);x.fill();
  x.fillStyle='#f1c9a5';x.beginPath();x.arc(120,108,38,0,7);x.fill();
  x.fillStyle=hex6(m.look.hair);x.beginPath();x.arc(120,100,40,Math.PI,0);x.fill();
  x.fillStyle='#fff';x.fillRect(100,102,16,10);x.fillRect(126,102,16,10);x.fillStyle='#222';x.fillRect(106,106,6,5);x.fillRect(132,106,6,5);
  x.fillStyle='#8a3b3b';x.fillRect(110,126,22,4);
  x.fillStyle='#fff';x.fillRect(132,124,34,6);x.fillStyle='#ff6a3d';x.fillRect(164,124,6,6);
  x.strokeStyle='rgba(255,255,255,.75)';x.lineWidth=5;x.lineCap='round';[[172,118],[184,104]].forEach(function(p,i){x.beginPath();x.moveTo(p[0],p[1]);x.bezierCurveTo(p[0]+14,p[1]-10,p[0]-10,p[1]-22,p[0]+8,p[1]-34-i*8);x.stroke();});
  if(m.look.glasses){x.strokeStyle='#111';x.lineWidth=3;x.strokeRect(98,100,20,14);x.strokeRect(124,100,20,14);}
  x.fillStyle='rgba(255,60,60,.95)';x.font='600 14px monospace';x.textAlign='left';x.fillText('● REC  '+$('clock').textContent,10,H-10);
  $('phCap').textContent=m.name+' : pause clope !';}
let phT=0;
function showPhoto(m,spot){drawPhoto(m,spot);const p=$('photo');p.hidden=false;p.classList.remove('go');void p.offsetWidth;p.classList.add('go');clearTimeout(phT);phT=setTimeout(function(){p.hidden=true;},3800);}
$('photo').addEventListener('click',function(){$('photo').hidden=true;});

/* ---------- zones et deplacements ---------- */
function resetProg(){Object.keys(Z).forEach(function(k){Z[k].markers.forEach(function(m){m.prog=0;});});EMP.forEach(function(e){e.prog=0;});puddleO.prog=0;}
function enter(id){PSEAT=null;exitCar();if(id!=='parking')NEEDSTAFF=false;cur=id;mode='zone';const zn=Z[id];pp.x=zn.spawn.x;pp.z=zn.spawn.z;susp=0;GR=8;SLP=null;act=null;armed=false;resetProg();document.body.dataset.mode='zone';
  mapLabels.forEach(function(l){l.visible=false;});
  if(!hinted){hinted=true;let seen=false;try{seen=localStorage.getItem('edm_hint')==='1';}catch(_){}if(!seen){openPan('leg');try{localStorage.setItem('edm_hint','1');}catch(_){}}}}
function go(q){if(MEET.on&&q.zn==='salle'){toast('Réunion en cours : tu ne peux pas sortir de la salle.');return;}if(q.zn==='parking'&&(q.to==='office'||q.to==='reserve'))NEEDSTAFF=false;if(q.zn==='store'&&q.to==='parking')portique();fading=true;$('fade').classList.add('on');setTimeout(function(){cur=q.to;pp.x=q.tx;pp.z=q.tz;pp.face=q.face;susp=0;GR=8;SLP=null;act=null;armed=false;resetProg();
  camPos.set(pp.x,CAMH,pp.z+CAMZ);camLook.set(pp.x,.4,pp.z-.6);
  Object.keys(Z).forEach(function(id){Z[id].g.visible=id===cur;});dirc.visible=cur===D.zn;
  $('fade').classList.remove('on');setTimeout(function(){fading=false;},220);toast(Z[cur].name);},300);}
function toMap(f){if(!f&&MEET.on&&mode==='zone'){toast('Réunion en cours : impossible de quitter la salle, la carte est bloquée.');return;}PSEAT=null;exitCar();SLP=null;exitCabin();if(PHN)closePhone();if(MG)closeMail();if(PAN)closePan();mode='map';act=null;pretend=false;document.body.dataset.mode='map';mapLabels.forEach(function(l){l.visible=true;});Object.keys(Z).forEach(function(k){Z[k].g.visible=true;});dirc.visible=true;}

/* ---------- actions (maintenir pour agir) ---------- */
function pickTarget(){const zn=Z[cur];let best=null,bd=1.15;
  zn.markers.forEach(function(m){if(m.off||m.cool>0||m.dup||!roleOK(m)||mkNA(m))return;const d=Math.hypot(m.x-pp.x,m.z-pp.z);if(d<bd){bd=d;best={t:'m',m:m};}});
  if(best)return best;
  {let be=null,ed=rank>=1?3:2.6;EMP.forEach(function(e){if(e.out>0||e.zn!==cur||e.cd>0||(rank<1&&!e.f))return;const dx=pp.x-e.x,dz=pp.z-e.z,d=Math.hypot(dx,dz);if(rank<1&&(d<.3||(Math.sin(e.g.rotation.y)*dx+Math.cos(e.g.rotation.y)*dz)/d>=-.3))return;if(d<ed){ed=d;be=e;}});if(be)return {t:'e',e:be};}
  if(SEC){let fm=null,fd=2.6;MGR.forEach(function(m){if(m.zn!==cur||m.fired||m.stun>0||m.state!=='patrol'||m.fcd>0)return;const d=Math.hypot(m.x-pp.x,m.z-pp.z);if(d<fd){fd=d;fm=m;}});if(fm)return {t:'f',m:fm};}
  {let bm=null,md=2.6;MGR.forEach(function(m){if(m.zn!==cur||m.fired||m.stun>0||m.state!=='patrol'||clk-(m.dnT||-99)<40||!(m.wait>.15||(m.task&&m.task.arr)))return;const dx=pp.x-m.x,dz=pp.z-m.z,d=Math.hypot(dx,dz);if(d<.3||(Math.sin(m.g.rotation.y)*dx+Math.cos(m.g.rotation.y)*dz)/d>=-.3)return;if(d<md){md=d;bm=m;}});if(bm)return {t:'g',m:bm};}
  if(charges>0&&cur==='store')return {t:'p'};
  return null;}
function info(tg){
  if(tg.t==='m'){const m=tg.m,k=MK[m.obj],c=k[0];
    return {key:m.obj,label:((m.obj==='voler'||m.obj==='food'||m.obj==='butin')?m.txt:k[1]),dur:(m.obj==='butin'&&WTAB[m.nm])?WTAB[m.nm][0]:(m.obj==='rayon'&&!globalThis.__fastwalk)?k[2]*(m.dm||(m.dm=[.5,.5,1,1,1.7,3][(Math.random()*6)|0])):(m.obj==='eteindre'&&INV.ext>0)?1.2:(m.obj==='voler'?({'Stock':5,'Vitrine':9,'Tiroir-caisse':13})[m.txt]||k[2]:k[2]),cat:c,illicit:(c==='sabo'||c==='hack'||c==='steal')&&m.obj!=='seau'&&m.obj!=='pc',o:m};}
  if(tg.t==='f')return {key:'fouillem',label:'Fouiller '+tg.m.name,dur:2.2-.3*GRADE,cat:'spy',illicit:false,o:tg.m};
  if(tg.t==='g')return {key:'denmgr',label:'Dénoncer '+tg.m.name+(rank<1?' (il glande)':' à la directrice'),dur:rank<1?.55:.8,cat:'spy',illicit:false,o:tg.m};
  if(tg.t==='e'&&SEC)return {key:'fouille',label:'Fouiller '+tg.e.name,dur:2.2-.3*GRADE,cat:'spy',illicit:false,o:tg.e};
  if(tg.t==='e'){const e=tg.e;if(rank<1)return {key:'denonce',label:'Dénoncer '+e.name,dur:.5,cat:'spy',illicit:false,o:e};if(e.f)return {key:'sanction',label:(e.conf>=(e.f.sev>1?60:100)||TAMP>0)?'Blâmer '+e.name+' (preuve)':'Avertir '+e.name,dur:1.7,cat:'boss',illicit:false,o:e};return {key:'press',label:'Mettre la pression',dur:1.8,cat:'boss',illicit:false,o:e};}
  return {key:'puddle',label:'Poser la flaque',dur:.7,cat:'sabo',illicit:true,o:puddleO};}
function canUse(inf){FORCEM=true;try{return canUse0(inf);}finally{FORCEM=false;}}
function canUse0(inf){const o=inf.o;
  if(!cfCan(inf,o))return false;
  const rq=o&&o.obj?reqOf(o):null;if(rq&&(rq[0]==='b'?SB:SW)<rq[1]){toast('Il faut '+rq[1]+' points de '+(rq[0]==='b'?'branleur':'bosseur')+' pour ça (tu en as '+(rq[0]==='b'?SB:SW)+').');o.cool=2;return false;}
  if(inf.key==='rayon'&&o&&o.stock>=85){toast('Ce rayon est plein.');o.cool=2;return false;}
  if(inf.key==='ranger'&&!BAYS.some(function(b){return b.pile>0;})){toast('Rien à ranger : le quai est vide.');o.cool=2;return false;}
  if(inf.key==='palvide'&&RES.pv<=0){toast('Aucune palette vide à ranger pour l\'instant.');o.cool=2;return false;}
  if(inf.key==='jeter'&&BAL.full){toast('La balle est pleine : il faut charger les balles dans un camion avant de jeter.');o.cool=3;return false;}
  if(inf.key==='jeter'&&BAL.broken){toast('La balle est en panne : un manager doit la débloquer.');o.cool=3;return false;}
  if(inf.key==='jeter'&&RES.ct<=0){toast('Pas de carton à jeter pour l\'instant : ils arrivent au hasard, repasse plus tard.');o.cool=4;return false;}
  if(inf.key==='panne'&&BAL.broken){toast('La balle est déjà en panne.');o.cool=3;return false;}
  if(inf.key==='depointer'&&PTS>0){toast('Tu viens de pointer : attends encore '+Math.ceil(PTS)+' s avant de dépointer.');o.cool=2;return false;}
  if(inf.key==='pointeuse'&&PCD>0){toast('Tu viens de finir ta pause : reviens pointer dans '+Math.ceil(PCD)+' s.');o.cool=2;return false;}
  if(inf.key==='food'&&coins<5){toast('Il te faut 5 pièces pour te servir ici. Va plutôt piquer à manger en réserve…');o.cool=2;return false;}
  if(inf.key==='allumer'&&STN.n<1){toast('Répands d\'abord de l\'essence !');o.cool=2;return false;}
  if(inf.key==='butin'&&LOOT.length>=3){toast('Tes poches sont pleines : va ranger ça dans le coffre de ta voiture (parking).');o.cool=2;return false;}
  if(inf.key==='cabine'){if(!LOOT.length){toast('Tu n\'as rien à démagnétiser.');o.cool=2;return false;}if(LOOT.every(function(l){return l.off;})){toast('Les antivols sont déjà retirés.');o.cool=2;return false;}}
  if(inf.key==='alarme'&&(ALM.t>0||ALM.cd>0||(AQ&&SABN<3))){toast(ALM.t>0||ALM.cd>0?'L\'alarme vient de sonner : attends un peu.':'Quête alarme incendie : fais 3 sabotages différents ('+SABN+'/3), puis reviens à une alarme. Pas de limite de temps ; viré, tu repars à 0.');o.cool=2;return false;}
  if(inf.key==='coffre'&&!LOOT.length){toast('Tu n\'as rien à ranger dans ton coffre.');o.cool=2;return false;}
  if(inf.key==='photo'&&!smokerAt(o.spot)){toast('Personne ne fume ici en ce moment…');o.cool=2;return false;}
  if(inf.key==='seau'&&charges>=3){toast('Le seau est déjà plein.');o.cool=2;return false;}
  if(inf.key==='pcfroid'&&FR.on){toast('Les frigos sont déjà en panne.');o.cool=3;return false;}
  if((inf.key==='rat'||inf.key==='perime')&&JOBS.length>=6){toast('Il y a déjà assez de dégâts…');o.cool=3;return false;}
  return true;}
function makeInc(kind,x,z){const g=new T.Group();g.position.set(x,0,z);
  if(kind==='rat'){sph(g,.17,0x8a8f98,0,.15,0,1.7,1,1);sph(g,.1,0x8a8f98,.28,.17,0);sph(g,.04,0xffb3c1,.31,.28,.06);sph(g,.04,0xffb3c1,.31,.28,-.06);sph(g,.025,0x111111,.37,.19,.05);cyl(g,.015,.015,.45,0xe8a0b0,-.4,.1,0,false).rotation.z=Math.PI/2;
    const l=label('Rat !',{sx:1,sy:.3,w:192,h:56,size:30,bg:'rgba(214,40,57,.95)'});l.position.y=.9;g.add(l);}
  else{box(g,.3,.4,.25,0x9ccc65,-.2,.2,0,false);box(g,.3,.4,.25,0xb5a642,.2,.2,.05,false);box(g,.3,.28,.25,0x7cb342,0,.14,.3,false);
    const l=label('Périmé !',{sx:1.2,sy:.3,w:192,h:56,size:28,bg:'rgba(120,150,30,.95)'});l.position.y=.9;g.add(l);}
  S.g.add(g);return g;}
function dropPuddle(){charges--;const m=new T.Mesh(new T.CircleGeometry(.75,20),new T.MeshBasicMaterial({color:0x5aa9e6,transparent:true,opacity:.85}));m.rotation.x=-Math.PI/2;m.position.set(pp.x,.03,pp.z);m.scale.set(1.1,.8,1);S.g.add(m);puddles.push({x:pp.x,z:pp.z,t:45,mesh:m,k:'p'});toast('Flaque posée. Attends qu\'un manager passe…');}
function pressDone(e){if(rank>=1)RESULT=Math.min(100,RESULT+2);coins+=3;addW(2);e.cd=8;say(e.g,['Pitié !','Oui chef…','Je fais des heures sup','Je me dépêche !'][(Math.random()*4)|0]);toast('Tu mets la pression à '+e.name+' : +3');}
function finish(m){const k=MK[m.obj];CONN=(k&&(k[3]||k[0]==='sabo'))?1:0;ACTT=true;try{return finish0(m);}finally{CONN=0;ACTT=false;}}
function finish0(m){const o=m.obj;m.prog=0;if(o==='cstract'||o==='csplainte'||o==='csfin'){csqStep(m);return;}
  if(o==='caddies'){const add=Math.min(CART.max-CART.n,6);m.cool=30;if(add<=0){toast('L\'abri à caddies est déjà plein.');}else{CART.n+=add;cartSend();coins+=3;addW(2);toast('🛒 Tu ranges '+add+' caddies à l\'abri. +3 pièces, +2 bosseur');}return;}
  if(rank>=1&&MK[o]&&MK[o][0]==='work')RESULT=Math.min(100,RESULT+1.8);
  if(WFX[o]&&!(o==='deboucher'&&!(WCFL>0))&&!(o==='dext'&&!DF.on)&&!(o==='dfrit'&&DF.on))wfxSend(o,m);
  if(o==='cache'||o==='cachette'){doHide(m,false);}
  else if(o==='planque'){HID=30;HIDP={x:pp.x,z:pp.z};m.cool=2;toast(o==='cachette'?'Tu te caches entre les voitures : les vigiles te perdent (30 s). Ne bouge pas !':'Tu te planques : les employés ne te voient plus (30 s). Reste immobile et observe.');}
  else if(o==='mfumer'){addW(6);m.cool=20;toast('🚬 Tu grilles une clope : ton stress baisse. +6 bosseur');mgrSlack();}
  else if(o==='mfrigo'){addB(8);m.cool=25;toast('Tu te planques dans la chambre froide… +8 branleur');mgrSlack();}
  else if(o==='mctrl'){RESULT=Math.min(100,RESULT+3.5);addW(1);m.cool=60;toast('Rayon contrôlé : Résultats +3,5');}
  else if(o==='mpcam'){placeCam(m);m.cool=45;}
  else if(o==='mfrap'){const e=EMP.find(function(x){return x.name===WC.who;});WC.busy=false;WC.t=45;RESULT=Math.min(100,RESULT+2);if(e)e.warn=Math.max(e.warn||0,1);m.cool=3;toast(WC.who+' sort des toilettes, gêné(e) : avertissement verbal. Résultats +2');}
  else if(o==='mouvrir'){const e=EMP.find(function(x){return x.name===WC.who;}),long=WCOCC>=20;WC.busy=false;WC.t=45;m.cool=3;
    if(long){RESULT=Math.min(100,RESULT+7);coins+=5;if(e){e.warn=0;addBl(e);}toast('Tu ouvres : '+WC.who+' était là depuis '+Math.round(WCOCC)+' s. Blâme ! +5, Résultats +7');}
    else{RESULT=Math.max(0,RESULT-6);toast('Tu ouvres trop tôt : '+WC.who+' n\'y était que depuis '+Math.round(WCOCC)+' s. Plainte, Résultats -6');}}
  else if(o==='cafep'){m.cool=3;if(CUP.on)toast('Tu as déjà un café en main.');else if(coins<1)toast('Il faut 1 pièce pour prendre un café.');else{coins-=1;takeCup();}}
  else if(o==='wcuse'){m.cool=1;openWcUse();}
  else if(o==='cwc'){m.cool=1;openCwUse();}
  else if(o==='pupitre'){m.cool=1;openPupitre();}
  else if(o==='rd1'||o==='rd2'||o==='rd3'){const i=+o.slice(2)-1;m.off=true;m.cool=1;if(i<2){RD.mk[i+1].off=false;toast('📍 Point '+(i+1)+'/3 contrôlé. Prochain : '+['le parking','la réserve'][i]+' (rond bleu).');}else{RD.cd=120;coins+=12;addW(6);image=Math.min(100,image+3);pop('🛡️ Ronde terminée ! +12 🪙, +6 bosseur, Sérieux +3','good');}}
  else if(o==='micro'){m.cool=40;const MA=['« Attention : un client a perdu son sens de l\'humour au rayon surgelés. »','« Promo flash sur les excuses bidon : une achetée, une offerte. »','« Le personnel est prié de ne surtout pas se dépêcher. »','« Un client demande si on ouvre un jour : réponse dans 3 à 5 semaines. »','« Pause café exceptionnelle pour tout le magasin. Merci de faire semblant d\'être surpris. »'];
    const msg=MA[(Math.random()*MA.length)|0];HOSTS.forEach(function(h){say(h.g,'Pas encore le micro…');});addB(4);addAnger(2);pop('📢 Annonce au micro : '+msg,'good');toast('Tu squattes le micro de l\'accueil : +4 branleur.');}
  else if(o==='vissue'){m.cool=120;coins+=4;addW(3);toast('🚪 Porte de secours vérifiée : +4 🪙, +3 bosseur.');}
  else if(o==='vlocal'){m.cool=120;coins+=4;addW(3);toast('🔧 Local technique contrôlé : +4 🪙, +3 bosseur.');}
  else if(o==='vcaisse'){m.cool=1;if(BOOTH.till>0){coins+=BOOTH.till;toast('💰 Tu relèves la caisse du pupitre : +'+BOOTH.till+' 🪙');BOOTH.till=0;}else toast('La caisse est vide.');}
  else if(o==='vprix'){m.cool=1;BOOTH.mult=BOOTH.mult>=3?1:BOOTH.mult+1;say(pl,'🏷️ Tarif ×'+BOOTH.mult+(BOOTH.mult>1?' : les clients paient plus, certains hésitent.':''));pop('🏷️ Tarif du pupitre : ×'+BOOTH.mult,BOOTH.mult>1?'good':'warn');}
  else if(o==='wcvig'){m.cool=3;const e=EMP.find(function(x){return x.name===WC.who;}),long=WCOCC>=20;WC.busy=false;WC.t=45;if(long){addB(6);coins+=2;if(e)addBl(e);toast('🛡️ Le vigile ouvre : '+WC.who+' était là depuis '+Math.round(WCOCC)+' s. Blâme ! +6 branleur, +2 pièces');}else{image=Math.max(0,image-5);toast('🛡️ Fausse alerte : '+WC.who+' n\'y était que depuis '+Math.round(WCOCC)+' s. Sérieux −5');}}
  else if(o==='wcplan'){m.cool=30;wcPlan();}
  else if(o==='deboucher'){m.cool=1;if(WCFL>0)wcUnclog();}
  else if(o==='lavabo'){m.cool=2;UNW=false;UNWC=0;addW(1);toast('🧼 Tu te laves les mains : propre ! +1 bosseur');}
  else if(o==='urne'){m.cool=2;openVote();}
  else if(o==='cse'){m.cool=2;openBoard();}
  else if(o==='food'){coins-=5;hunger=Math.min(100,hunger+45);addB(2);breakCD('food');toast('Miam ! Faim +45 • +2 branleur • -5 pièces');}
  else if(o==='foodr'){hunger=Math.min(100,hunger+45);m.cool=20;toast('Tu piques un truc en réserve : gratuit ! Faim +45');}
  else if(o==='wc'){m.cool=2;enterCabin(m);}
  else if(o==='eteindre'){if(m.car){const c=m.car;c.burn=0;m.off=true;stopFire(c.x,c.z,4);c.charred=false;c.body.material.color.setHex(c.col);c.win.material.color.setHex(0x080b10);c.mf.off=false;c.mf.cool=120;}else{STN.burn=0;STN.cool=150;STN.mk.ee.off=true;stopFire(19,31.5,14);STN.pat.forEach(function(q){q.visible=false;});}
    coins+=3;image=Math.min(100,image+5);addW(4);ALIBI.t=0;if(INV.ext>0){INV.ext--;coins+=2;toast('Extincteur perso utilisé : feu éteint en un éclair ! +5 pièces, Sérieux +5');}else toast('Bien joué : tu éteins l\'incendie ! +3 pièces, Sérieux +5, bonus bon élève');}
  else if(o==='decharger'){const b=m.bay;if(!b||b.state!=='docked'||b.left<=0){toast('Plus rien à décharger ici.');return;}b.left--;b.pile=Math.min(6,b.pile+1);b.help++;coins+=1;addW(2);m.cool=.2;drawTruck(b);toast('Palette déchargée ('+b.left+' restante'+(b.left>1?'s':'')+').');}
  else if(o==='ranger'){const bb=BAYS.slice().sort(function(a,c){return c.pile-a.pile;})[0];if(!bb||bb.pile<=0){toast('Rien à ranger.');return;}bb.pile--;RES.pv++;coins+=1;addW(3);m.cool=.2;drawTruck(bb);toast('Palette rangée en stock : +1, il reste une palette vide à ranger.');}
  else if(o==='palvide'){if(RES.pv<=0)return;RES.pv--;RES.pvs=Math.min(16,RES.pvs+1);coins+=1;addW(1);m.cool=.2;if(RES.pvs>10){addB(2);if(RES.pvs>=12&&Math.random()<.4){RES.pvs=0;addB(15);addAnger(15);const e=EMP[(Math.random()*EMP.length)|0];if(e)say(e.g,'Aïe, ma jambe !');toast('La pile de palettes s\'écroule et blesse un collègue ! +15 branleur');}else toast('La pile tangue dangereusement ('+RES.pvs+' palettes) : +2 branleur');}else toast('Palette vide rangée : +1');}
  else if(o==='jeter'){if(RES.ct<=0)return;RES.ct--;pressOne();coins+=1;addW(1);m.cool=.2;toast('Cartons jetés dans la balle : +1');}
  else if(o==='charger'){if(RES.bal<5){toast('Il faut 5 balles pressées pour charger.');return;}const bb=m.bay;if(!bb||bb.state!=='docked'){toast('Pas de camion à quai.');return;}RES.bal-=5;coins+=5;addW(5);image=Math.min(100,image+3);bb.dwell=Math.max(bb.dwell,12);m.cool=2;toast('5 balles chargées dans le camion '+(bb.i+1)+' : +5, +5 bosseur');}
  else if(o==='signer'){const b=BAYS.find(function(x){return x.state==='docked'&&x.left===0&&!x.signed;});if(!b){toast('Aucun bon à signer.');return;}b.signed=true;b.dwell=RES.bal>=5?Math.max(b.dwell,25):Math.min(b.dwell,3);coins+=5;addW(8);image=Math.min(100,image+6);m.cool=3;toast('Bon de livraison signé : camion '+(b.i+1)+' bien réceptionné. +5, Sérieux +6, +8 bosseur');}
  else if(o==='inventaire'){coins+=4;addW(6);image=Math.min(100,image+5);m.cool=90;toast('Inventaire du frais terminé : +4, Sérieux +5, +6 bosseur');}
  else if(o==='locrayer'||o==='locfeu'||o==='locpneu'){const c=m.car;if(!c)return;m.cool=9999;
    if(o==='locrayer'){c.sc.visible=true;m.off=true;addB(10);addAnger(8);toast('Carrosserie rayée à la clé : +10 branleur');if(Math.random()<.4)setAlibi(20,'on t\'a vu près d\'un véhicule de location !');}
    else if(o==='locpneu'){crevePneus(c);m.off=true;addB(12);toast('Pneus crevés : +12 branleur');setAlibi(25,'on t\'a vu près d\'un véhicule de location !');}
    else{c.charred=true;c.burn=32;c.me.off=false;c.me.cool=0;c.body.material.color.setHex(0x1b1b1b);if(c.win&&c.win.material&&c.win.material.color)c.win.material.color.setHex(0x333333);startFire(c.x,c.z,6,32,c.isTruck?3:2.2,c.isTruck?1.8:1.1);addAnger(25);addB(30);m.off=true;c.mr.off=true;toast('Le véhicule de location est en feu ! +30 branleur');setAlibi(50,'on t\'a vu près du véhicule de location en flammes !');}}
  else if(o==='compmiss'||o==='compbrib'||o==='compkey'||o==='compcoffre'){cfFinish(o,m);}
  else if(NEWM[o]){const nm=NEWM[o];if(nm.spend){if(coins<nm.spend){toast('Il te faut '+nm.spend+' pièces pour soudoyer.');m.cool=3;return;}coins-=nm.spend;}if(nm.co)coins+=nm.co;if(nm.w)addW(nm.w);if(nm.b)addB(nm.b);m.cool=nm.cool;if(o==='locload'&&m.car){const c=m.car;c.load=Math.min(c.crates.length,c.load+1);c.crates.forEach(function(b,i){b.visible=i<c.load;});}toast(nm.msg);}
  else if(SMALL[o]){const sm=SMALL[o];addB(sm[0]);m.cool=35;if(o==='piles')coins+=4;if(o==='poser'||o==='facing'||o==='jouets'||o==='chariot'){const ms=messAt(m.x,m.z);if(o==='chariot'&&rank===0&&!SEC)mobStart('chariot',m.x,m.z,'store',{ms:ms});if(rank===0)callJob({kind:'mess',x:m.x,z:m.z,ms:ms,claimed:null},'Tu as fait tomber de la marchandise par terre.',true);}toast(sm[2]+' : +'+sm[0]+' branleur'+(o==='piles'?', +4 pièces':''));}
  else if(o==='gouter'){hunger=Math.min(100,hunger+10);addB(2);m.cool=25;toast('Tu goûtes un produit en rayon sans payer : Faim +10, +2 branleur');}
  else if(o==='petrir'){coins+=1;addW(2);m.cool=25;toast('Pâte pétrie : +1');}
  else if(o==='enfourner'){coins+=2;addW(4);image=Math.min(100,image+3);m.cool=60;toast('Fournée enfournée : +2, Sérieux +3, +4 bosseur');}
  else if(o==='volerb'){coins+=2;m.cool=30;toast('Tu pioches dans les viennoiseries : +2 pièces');}
  else if(o==='surchauffe'){addB(20);addAnger(12);MGR.forEach(function(x){if(x.zn==='store')hitMgr(x,3);});m.cool=90;toast('Le four surchauffe : le pain brûle, odeur de fumée dans tout le magasin ! +20 branleur');}
  else if(o==='trier'){coins+=1;addW(2);m.cool=25;toast('Poisson écaillé : +1');}
  else if(o==='glacer'){coins+=2;addW(4);image=Math.min(100,image+3);m.cool=60;toast('Bacs de glace remplis : +2, Sérieux +3, +4 bosseur');}
  else if(o==='volerp'){coins+=3;m.cool=40;toast('Tu embarques un saumon : +3 pièces');}
  else if(o==='planquer'){mgrSlack();addB(15);MGR.forEach(function(x){if(x.zn==='store')hitMgr(x,4);});m.cool=60;toast('Un poisson planqué dans le stock : l\'odeur arrive en magasin, plaintes de clients ! +15 branleur');}
  else if(o==='volerf'){coins+=5;m.cool=45;toast('Tu embarques du frais premium : +5 pièces');}
  else if(o==='viderb'){if(!(BAL.broken||BAL.full)){toast('La balle n\'a pas besoin d\'être vidée.');return;}const was=BAL.broken;BAL.t=0;BAL.broken=false;BAL.hit=false;RES.bal=0;RES.cp=0;RESULT=Math.min(100,RESULT+(was?4:3));coins+=3;addW(2);m.cool=3;toast('Balle à cartons vidée : +3, Résultats +'+(was?4:3));}
  else if(o==='debloquer'){if(!BAL.broken){toast('La balle fonctionne.');return;}BAL.t=0;BAL.broken=false;BAL.hit=false;RESULT=Math.min(100,RESULT+4);coins+=3;m.cool=3;toast('Tu débloques la balle à cartons : +3, Résultats +4');}
  else if(o==='panne'){BAL.broken=true;BAL.t=240+Math.random()*340;BAL.hit=false;addB(25);m.cool=9999;toast('La balle à cartons est en panne ! Les cartons vont s\'accumuler. +25 branleur');}
  else if(o==='wcsig'){addB(10);WC.busy=false;WC.t=45;toast('Le vigile fait sortir '+WC.who+' des toilettes : blâme pour lui ! +10 branleur');}
  else if(o==='pneu'){const c=m.car;crevePneus(c);m.off=true;m.cool=9999;let nm='la directrice';if(c.owner>=0){hitMgr(MGR[c.owner],5);nm=MGR[c.owner].name;addB(8);toast('Pneus de '+nm+' crevés : il va péter un câble. +8 branleur');}else{addB(15);toast('Pneus de la directrice crevés ! +15 branleur');}if(Math.random()<.5)setAlibi(30,'on t\'a vu près de la voiture de '+nm+' !');}
  else if(o==='feu'){const c=m.car;burnCar(c);addAnger(25);m.off=true;m.cool=9999;c.mp.off=true;c.mp.cool=9999;let nm='la directrice';if(c.owner>=0){hitMgr(MGR[c.owner],10);nm=MGR[c.owner].name;addB(25);toast('La voiture de '+nm+' brûle ! Sa réputation s\'effondre. +25 branleur');}else{addB(35);toast('La voiture de la directrice est en feu ! +35 branleur');}setAlibi(50,'on t\'a vu près de la voiture en flammes !');}
  else if(o==='essence'){STN.n=Math.min(3,STN.n+1);m.cool=6;STN.pat.forEach(function(q,i){q.visible=i<STN.n*2+1;});STN.mk.al.off=false;toast('Essence répandue ('+STN.n+'/3). Plus il y en a, plus ça va brûler fort.');}
  else if(o==='allumer'){const n=STN.n;igniteStation();addAnger(50);addB(30+n*20);MGR.forEach(function(x){hitMgr(x,3+n*3);});toast('BOUM ! La station-service part en fumée. +'+(30+n*20)+' branleur');setAlibi(60,'on t\'a vu près de la station en flammes !');}
  else if(o==='pointeuse'){ONB=true;BRK=60;OVT=0;OVW=false;PTS=10;m.cool=1;toast('Pause pointée : 1 minute tranquille dans la salle de pause. Pense à dépointer !');}
  else if(o==='depointer'){ONB=false;BRK=0;OVT=0;OVW=false;PCD=90;m.cool=1;toast('Pause dépointée. Retour au boulot !');}
  else if(o==='sieste'){if(!IMM){SLK=9;toast('Tu n\'as pas pointé ta pause : si un manager te voit, avertissement !');}addB(5);breakCD('sieste');SLP={x:m.x,z:m.z};pp.face=Math.PI/2;toast('Tu t\'endors sur le canapé… +5 branleur. Bouge pour te réveiller.');mgrSlack();}
  else if(o==='babyfoot'){if(!IMM){SLK=7;if(susp<1)toast('Pas de pause pointée : si un manager te voit jouer, avertissement !');}addB(4);breakCD('babyfoot');toast('But ! +4 points de branleur. Baby-foot bloqué 30 s : fais autre chose.');mgrSlack();}
  else if(o==='seau'){charges=3;m.cool=2;toast('Seau rempli : 3 flaques. Maintiens Agir ailleurs pour en poser une.');}
  else if(o==='photo'){const s=smokerAt(m.spot);if(!s){toast('Il est déjà reparti…');return;}if(rank>=1){coins+=4;addW(3);RESULT=Math.min(100,RESULT+6);m.cool=8;showPhoto(s,m.spot);toast('Tu dénonces '+s.name+' à la directrice : +4, Résultats +6');s.t=Math.min(s.t,4);hitMgr(s,18);}
    else{addB(10);m.cool=8;showPhoto(s,m.spot);toast('Photo de '+s.name+' en train de fumer ! +10 branleur');s.t=Math.min(s.t,4);hitMgr(s,15);}}
  else if(o==='vtake'){vhTake(m.vh);m.cool=1;}
  else if(o==='mcarton'){if(WL&&WL.st==='idle'&&WL.lv<3){WL.lv++;wlShow();m.cool=3;toast('Étage '+WL.lv+'/3 monté. Fonce dedans au transpalette ou au Fenwick pour le fracasser (5/10/15 points selon la hauteur).');}}
  else if(CON[o]){const c=CON[o];m.cool=c.cool;if(c.pts)addB(c.pts);if(c.coins)coins+=c.coins;toast(c.msg);if(c.fx)c.fx(m);}
  else if(o==='tare'){m.cool=60;addB(6);pop('⚖️ Tare faussée : les clients vont payer plus cher !','good');toast('Tu changes la tare de la balance : +6 branleur.');if(Math.random()<.3)giveBlame('le vendeur t\'a vu toucher la balance.',2);}
  else if(o==='balance'){m.cool=20;if(Math.random()<.3)giveBlame('un collègue t\'a vu à la boîte à délation.',2);else{addB(6);toast('Collègue dénoncé : +6 branleur');}}
  else if(o==='butin'){LOOT.push({n:m.nm,v:m.val});m.cool=55;toast(m.nm+' dans ta poche ('+LOOT.length+'/3, valeur '+lootVal()+'). Rejoins ta voiture !');pop('🎒 Volé : '+m.nm+' ! Ramène-le à ta voiture, ou planque-le sur un manager pour le faire tomber.','good');}
  else if(o==='cabine'){LOOT.forEach(function(l){l.off=true;});m.cool=3;addB(3);pop('🔓 Antivols retirés : le portique ne sonnera pas','good');toast('Antivols retirés dans la cabine. Tu peux passer le portique tranquille.');}
  else if(o==='monter'){startCar();m.cool=1;}
  else if(o==='coffre'){const v=lootVal(),n=LOOT.length;LOOT.length=0;coins+=v;m.cool=4;pop('🚗 Objet déposé dans ta voiture ! +'+v+' 🪙','good');toast('Butin planqué dans le coffre : '+n+' objet'+(n>1?'s':'')+' revendu'+(n>1?'s':'')+' +'+v+' pièces, +'+Math.max(2,Math.round(v))+' branleur');}
  else if(o==='voler'){const loot=({'Tiroir-caisse':5,'Vitrine':4,'Stock':3})[m.txt]||3;coins+=loot;m.cool=120;toast('Volé ! +'+loot+' pièces');}
  else if(o==='candid'){openCand();m.cool=1;}
  else if(o==='cloturer'){endMeeting(true);}
  else if(o==='sprank1'){m.cool=45;const F=[];CHR.forEach(function(c,i){if(!SAL.cush[i])F.push(i);});if(F.length){SAL.cush[F[(Math.random()*F.length)|0]]=5;}addB(2);toast('🔧 Tu dévisses une chaise au hasard : 15 s après qu\'un employé s\'y assoit en réunion, elle craque (−5 Sérieux). +2 branleur.');salCamCheck();}
  else if(o==='sprank2'){m.cool=60;SAL.draw=true;addB(2);toast('🖍️ Moustache dessinée sur le tableau : le manager va passer pour un clown à la prochaine réunion. +2 branleur.');salCamCheck();}
  else if(o==='cafe'){m.cool=3;if(CUP.on)toast('Tu as déjà un café en main.');else if(coins<1)toast('Il faut 1 pièce pour prendre un café.');else{coins-=1;takeCup();}}
  else if(o==='disperser'){m.cool=3;const n=COF.grp.length;COF.grp.forEach(function(d){const e=d.userData.e;if(e)e.im=Math.max(0,e.im-3);});cafeGroupEnd('Tu renvoies '+n+' employés au travail. Résultats +4, +2 pièces.');RESULT=Math.min(100,RESULT+4);coins+=2;addW(2);}
  else if(o==='binfire'){m.cool=2;SAL.fire=false;MX.fire=0;SAL.fireM.visible=false;coins+=3;addW(3);if(rank>=1)RESULT=Math.min(100,RESULT+2);toast('🧯 Poubelle éteinte ! +3 pièces, +3 bosseur.');}
  else if(o==='vcam'){m.cool=3;SAL.cam=true;SAL.camM.visible=true;toast('📹 Caméra planquée dans la salle : elle filmera les pièges et fera blâmer les coupables.');}
  else if(o==='vsalle'){m.cool=3;LOOT.push({n:'Vidéoprojecteur',v:30});SAL.projGone=240;PROJM.forEach(function(b){b.visible=false;});addB(1);toast('Vidéoprojecteur dans ta poche ('+LOOT.length+'/3). Rejoins ta voiture !');}
  else if(o==='animer'){openMeetMenu();m.cool=1;}
  else if(o==='lancer'){authTick();if(AUTH.re<=0)toast('Tu as déjà fait ta réunion obligatoire aujourd\'hui.');else{AUTH.re--;startMeeting('me');}m.cool=2;}
  else if(o==='autolav'){machToggle();m.cool=1;}
  else if(o==='dpanne'){if(ELEV.t>0){toast('L\'ascenseur est déjà bloqué.');}else{ELEV.t=9999;mobStart('elev',m.x,m.z,cur,{});addB(10);pop('🛗 Ascenseur du Drive bloqué ! Les drivers s\'agglutinent et râlent : seul un manager peut le débloquer','good');toast('Tu bloques l\'ascenseur : +10 branleur. Les commandes vont s\'accumuler.');pickMgr('📞 Appeler un manager','L\'ascenseur du Drive est bloqué.',['parking'],function(k){if(!k)return;ELEV.call={m:k,t:22};toast('Tu appelles '+k.name+' : il va débloquer l\'ascenseur.');},true);}m.cool=30;}
  else if(o==='dechange'){ORD.n=Math.min(14,ORD.n+3);addB(6);m.cool=30;toast('Étiquettes intervertverties : 3 commandes à refaire. +6 branleur');}
  else if(o==='dperime'){SAT=Math.max(0,SAT-8);addB(7);m.cool=35;toast('Du périmé dans les sacs du Drive : clients furieux ! +7 branleur');}
  else if(o==='dpile'){ORD.n=Math.min(14,ORD.n+2);addB(5);m.cool=30;toast('Les colis du Drive sont par terre : +5 branleur');}
  else if(o==='dbip'){SAT=Math.max(0,SAT-5);addB(4);m.cool=30;toast('Fausse alerte « commande prête » : les clients s\'énervent au Drive. +4 branleur');}
  else if(o==='dfrigo'){SAT=Math.max(0,SAT-6);ORD.n=Math.min(14,ORD.n+2);addB(9);m.cool=45;toast('Frigo du Drive débranché : produits frais perdus ! +9 branleur');}
  else if(o==='prepcmd'){
    if(DF.on)toast('Incendie au Drive : impossible de préparer une commande !',1);
    else if(ELEV.t>0)toast('Ascenseur bloqué : aucune commande ne descend.',1);
    else if(!CMD){if(activeQuest()==='alarme')toast('Termine d\'abord ta quête en cours : l\'alarme incendie (ou abandonne-la dans le menu ≡).');else if(activeQuest()==='compta')toast('Termine d\'abord ta quête en cours : les services de la comptable (ou abandonne-la dans le menu ≡).');else if(ORD.n<=0)toast('Aucune commande à préparer pour l\'instant.',1);else{ORD.n--;const nm=['Lait','Pâtes','Yaourts','Café','Biscuits','Eau'].sort(function(){return Math.random()-.5;}).slice(0,3);CMD={need:nm,got:{}};toast('Commande reçue : '+nm.join(', ')+'. Monte par l\'ascenseur et cours les chercher dans le magasin !');}}
    else{const miss=CMD.need.filter(function(n){return !CMD.got[n];});if(miss.length)toast('Il te manque : '+miss.join(', ')+' (dans le magasin).',1);
      else{CMD=null;BAG++;coins+=8;addW(8);if(rank>=1)RESULT=Math.min(100,RESULT+1.5);toast('Commande prête ! +8 pièces, +8 bosseur. Sers le client au retrait.');priHit('cmdok');}}
    m.cool=1.5;}
  else if(o==='cmdpick'){if(!CMD)toast('Aucune commande en cours : prends-en une au Drive.');else if(CMD.need.indexOf(m.nm)<0)toast('« '+m.nm+' » n\'est pas sur ta liste.');else if(CMD.got[m.nm])toast('Déjà pris.');
    else{CMD.got[m.nm]=1;const left=CMD.need.filter(function(n){return !CMD.got[n];});toast(m.nm+' pris.'+(left.length?' Reste : '+left.join(', ')+'.':' Commande complète : retourne au Drive !'));}m.cool=1.5;}
  else if(o==='retrait'){const sl=SLOTS.find(function(x){return x.mk===m;});
    if(!sl||sl.st!=='wait')toast('Pas de client ici.');else if(BAG<=0)toast('Aucun sac prêt : prépare une commande (cours dans le magasin).');
    else{BAG--;const tip=sl.t>sl.max*.5?4:0;coins+=6+tip;addW(5);SAT=Math.min(100,SAT+5);if(rank>=1)RESULT=Math.min(100,RESULT+2);sl.st='idle';sl.c.visible=false;m.off=true;toast('Client servi : +'+(6+tip)+' pièces'+(tip?' (pourboire !)':'')+', satisfaction +5.');}m.cool=.5;}
  else if(o==='dfrit'){if(DF.on)toast('Ça brûle déjà !');else{startDriveFire();addB(20);addAnger(15);pop('🔥 La friteuse du Drive prend feu !','good');toast('Tu surchauffes la friteuse : +20 branleur. Il faut éteindre avant 45 s !');}m.cool=45;}
  else if(o==='dext'){if(!DF.on)toast('Plus rien ne brûle.');else{stopDriveFire();addW(10);coins+=15;if(rank>=1)RESULT=Math.min(100,RESULT+4);pop('🧯 Incendie du Drive éteint !','good');toast('Incendie éteint : +15 pièces, +10 bosseur.');}m.cool=1;}
  else if(o==='mobcode'){mobShowCode();m.cool=2;}else if(o==='mobbox'){mobPad();m.cool=1;}else if(o==='mobfix'){mobFix(m);m.cool=2;}
  else if(o==='alarme'){if(!AQ){AQ=1;SABN=0;SAKEYS=[];PNK=0;pop('🔔 Quête : alarme incendie. Fais 3 sabotages différents (au choix), puis reviens à n\'importe quelle alarme.','warn');toast('Quête lancée : 3 sabotages différents, puis une alarme incendie.');m.cool=3;}else{alarmArm(m);m.cool=6;}}
  else if(o==='repasc'){ELEV.t=0;{const e=MOB.l.find(function(x){return x.k==='elev'&&!x.mine;});if(e)mobSolve(e,PNAME);}RESULT=Math.min(100,RESULT+3);addW(2);m.cool=3;toast('Ascenseur débloqué : les drivers reprennent. Résultats +3.');}
  else if(o==='reparer'){repairTile(m);}
  else if(o==='aidecaisse'){helpCk(m);}
  else if(o==='discuter'){chatCk(m);m.cool=2;}
  else if(o==='convoquer'){coins+=4;m.cool=15;toast(['Convocation pour rien : +4','Réunion de 3 heures sans objet : +4','Blâme distribué à la machine à café : +4'][(Math.random()*3)|0]);}
  else if(o==='planning'){coins+=3;m.cool=15;toast('Nouveau planning cruel : +3');}
  else if(o==='rat'||o==='perime'){m.cool=45;const jb={kind:o,x:m.x,z:m.z,mesh:makeInc(o,m.x,m.z),claimed:null,ph:Math.random()*6};JOBS.push(jb);callJob(jb,o==='rat'?'Un rongeur est lâché !':'Des produits périmés traînent en rayon !');toast(o==='rat'?'Un rongeur est lâché… un manager va le trouver.':'Produits périmés en rayon… un manager va s\'en occuper.');}
  else if(o==='pcfroid'){m.cool=70;FR.on=true;FR.t=120;FR.order=0;FR.assist=false;FR.prog=0;FR.mt=0;FR.n=0;FR.meT=-9;FRIDGE.visible=true;const jf={kind:'fridge',x:-14.6,z:-16.2,claimed:null};JOBS.push(jf);callJob(jf,'Les frigos sont en panne !');toast('Température des frigos piratée : alerte rouge ! Les managers ont 1 minute pour les vider.');}
  else{mailCD=0;m.cool=(o==='rayon'?4:60);if(o==='rayon')m.dm=0;if(o==='rayon'&&m.stock!==undefined)m.stock=Math.min(100,m.stock+50);const ob=OBJ[o];ob.n=Math.min(ob.max,ob.n+1);const gn=rank>=1?2:1;coins+=gn;image=Math.min(100,image+4);addW(o==='rayon'?3:4);toast('Tâche faite : +'+gn+' pièce'+(gn>1?'s':'')+', Sérieux +4');if(o==='nettoyer')puddleMove(m);}}
function complete(a){completeX(a);if(!a.illicit)try{cfHit(a.key);}catch(_){}if(REV&&rank===0&&!a.illicit&&cur==='store')REV.n++;priHit(a.key);if(a.illicit&&a.cat==='sabo'&&rank===0&&a.key!=='alarme'&&AQ&&SABN<3&&SAKEYS.indexOf(a.key)>=0){toast('Déjà fait pour cette alarme : varie les sabotages !');}else if(a.illicit&&a.cat==='sabo'&&rank===0&&a.key!=='alarme'&&AQ&&SABN<3){SAKEYS.push(a.key);SABN++;mkChkAdd();PNK=SABN>=3?100:SABN*33;if(SABN>=3)pop('🔔 3 sabotages faits ! Tu peux tirer une alarme incendie (cercle vert citron : magasin, réserve, drive, bureaux, électro)','good');else toast('🔔 Sabotage '+SABN+'/3 pour l\'alarme incendie');}}
function completeX(a){const tg=a.tg;if(tg.t==='m'){const w0=SW,c0=coins;finish(tg.m);if(rank>=1&&(SW>w0||coins>c0)&&MK[tg.m.obj]&&MK[tg.m.obj][0]==='work'){RESULT=Math.min(100,RESULT+2);toast('Mission faite toi-même : Résultats +2 (mieux vaut la faire faire par un employé !)');}}else if(tg.t==='g'){denounceM(tg.m);}else if(tg.t==='f'){fouilleM(tg.m);}else if(tg.t==='e'){if(rank<1)denounceE(tg.e);else if(SEC)fouilleE(tg.e);else if(tg.e.f)sanctionE(tg.e);else pressDone(tg.e);}else dropPuddle();}
function breakCD(k){Z.office.markers.forEach(function(x){if(x.obj===k)x.cool=30;});}
function caught(w,a){if(LOOT.length){theftFine(lootVal());LOOT.length=0;toast('Ton butin est confisqué !');pop('🚨 Pris sur le fait ! Butin confisqué','bad');}const who=w.k==='dir'?'la directrice':w.k==='guard'?'le vigile':w.k==='cam'?'la caméra de surveillance':w.m.name;
  a.o.prog=0;act=null;lockT=1.4;lockRel=true;const pc=CUP.on?'cafe':a.cat==='steal'||a.key==='vol'?'vol':a.cat==='sabo'?'sabo':a.key==='sieste'?'sieste':'gen';if(w.m)say(w.m.g,phrase(pc));else if(w.k==='guard')say(w.gd.g,'Stop !');else if(w.k==='dir')say(dirc,phrase(pc));
  if(SEC)fireV(who);else if(a.key==='compcoffre'&&cfBust(who)){}else giveBlame('pris en flagrant délit par '+who+' !',a.key==='foodr'?3:a.cat==='steal'?8:3);
  if(w.k==='cam'&&!SEC)camAlert();}
function camAlert(){const E=GUARDS[1];let n=0;GUARDS.forEach(function(G){if(G.zn===cur&&G.stun<=0&&!(G.fx>0)){G.fx=12;G.cd=0;G.wait=0;n++;}});pop('📹 Le vigile de l\'entrée a vu la caméra : il prévient ses collègues !','bad');try{if(E&&E.zn===cur)say(E.g,'Caméra : suspect repéré !');}catch(_){}toast(n?'Un vigile de cette zone arrive sur toi : cache-toi ou éloigne-toi !':'Les vigiles sont prévenus : ils te cherchent.');}

lockOffice();

/* ---------- entrees ---------- */
const KU=['z','w','arrowup'],KD=['s','arrowdown'],KL=['q','a','arrowleft'],KR=['d','arrowright'];
addEventListener('keydown',function(e){const k=e.key.toLowerCase();if(CREATING||(e.target&&e.target.tagName==='INPUT'))return;
  if(QM.on){if(k==='e'||k===' '){e.preventDefault();holdK=true;}else if(k==='escape'){if(!QM.uiOpen)qmMenu();}else keys.add(k);return;}
  if(uiOpen){if(PHN&&(k==='escape'||k==='p'||k==='t')){closePhone();return;}if(k==='escape'){if(PAN)closePan();else closeMail();}else if(MG&&MG.step===2&&!e.repeat)mailTap();return;}
  if(WCIN&&(k==='p'||k==='x'||k==='escape'||k==='t')){if(k==='p')phoneCall();else if(k==='t')openPhone('shop');else exitCabin();return;}
  if(k==='e'||k===' '){e.preventDefault();holdK=true;}
  else if(k==='p'||k==='t'){openPhone('shop');}else if(k==='h'){openPan('leg');}else if(k==='l'){openPan('rank');}
  else if(k==='m'||k==='escape'){if(mode==='zone')toMap();}
  else keys.add(k);});
addEventListener('keyup',function(e){const k=e.key.toLowerCase();if(k==='e'||k===' ')holdK=false;keys.delete(k);});
addEventListener('blur',function(){keys.clear();holdK=false;holdB=false;});
$('bPhone').addEventListener('click',phoneCall);$('bExit').addEventListener('click',exitCabin);
$('bGrim').addEventListener('pointerdown',function(e){e.preventDefault();if(!uiOpen&&!CREATING)grimace();});
const bAct=$('bAct');
bAct.addEventListener('pointerdown',function(e){e.preventDefault();holdB=true;try{bAct.setPointerCapture(e.pointerId);}catch(_){}bAct.classList.add('on');});
['pointerup','pointercancel','lostpointercapture'].forEach(function(t){bAct.addEventListener(t,function(){holdB=false;bAct.classList.remove('on');});});
bAct.addEventListener('contextmenu',function(e){e.preventDefault();});
$('bMap').addEventListener('click',function(){toMap();});


const stk=$('stick'),knob=$('knob');let sp=null,down=null;
const ray=new T.Raycaster();
canvas.addEventListener('pointerdown',function(e){down={x:e.clientX,y:e.clientY};
  if(mode==='zone'&&!sp){sp={id:e.pointerId,x:e.clientX,y:e.clientY};stk.style.left=(e.clientX-55)+'px';stk.style.top=(e.clientY-55)+'px';stk.hidden=false;try{canvas.setPointerCapture(e.pointerId);}catch(_){}}});
canvas.addEventListener('pointermove',function(e){if(sp&&e.pointerId===sp.id){let dx=e.clientX-sp.x,dy=e.clientY-sp.y;const L=Math.hypot(dx,dy),Rr=48;if(L>Rr){dx*=Rr/L;dy*=Rr/L;}stick.x=dx/Rr;stick.y=dy/Rr;knob.style.transform='translate('+dx+'px,'+dy+'px)';}});
function endPtr(e){if(sp&&e.pointerId===sp.id){sp=null;stick.x=stick.y=0;stk.hidden=true;knob.style.transform='';}
  if(mode==='map'&&down&&Math.hypot(e.clientX-down.x,e.clientY-down.y)<10){const r=canvas.getBoundingClientRect();
    ray.setFromCamera(new T.Vector2((e.clientX-r.left)/r.width*2-1,-(e.clientY-r.top)/r.height*2+1),camera);
    const hits=ray.intersectObjects([S.floorMesh,R.floorMesh].concat(R.extra||[],[P.floorMesh,O.floorMesh,SL.floorMesh,PZFLOOR,WCFLOOR],NEWFL));if(hits.length){const zid=hits[0].object.userData.zone;if(zid==='salle'&&!(rank>=1)){toast('Salle de réunion : réservée aux managers.');}else enter(zid);}}
  down=null;}
canvas.addEventListener('pointerup',endPtr);canvas.addEventListener('pointercancel',endPtr);

/* ---------- boucle ---------- */
const CAMH=24,CAMZ=15.8,ZDZ={},ZDZ0=1.07;let CZF=1.07;
const camPos=new V3(0,100,68),camLook=new V3(0,0,0),tPos=new V3(),tLook=new V3();
function resize(){const w=canvas.clientWidth||innerWidth,h=canvas.clientHeight||innerHeight;renderer.setSize(w,h,false);camera.aspect=w/h;camera.updateProjectionMatrix();}
function fsOn(){try{return !!(document.fullscreenElement||document.webkitFullscreenElement)||(screen.height>0&&innerHeight>=screen.height-2&&innerWidth<=screen.width+2&&(screen.height-innerHeight)<3&&matchMedia('(pointer:coarse)').matches);}catch(_){return false;}}
function fsUpd(){const b=$('bFs');if(b)b.hidden=!fsOn();}
try{addEventListener('resize',fsUpd);document.addEventListener('fullscreenchange',fsUpd);setTimeout(fsUpd,800);}catch(_){}
$('bFs').addEventListener('click',function(){let ok=false;try{const f=document.exitFullscreen||document.webkitExitFullscreen;if(f&&(document.fullscreenElement||document.webkitFullscreenElement)){f.call(document);ok=true;}}catch(_){}
  if(!ok){try{if(window.parent!==window&&parent.document.exitFullscreen){parent.document.exitFullscreen();ok=true;}}catch(_){}}
  if(!ok)toast('Pour quitter le plein écran : glisse depuis le haut de l\'écran puis appuie sur Retour.');});
addEventListener('resize',resize);resize();

let last=performance.now(),runKey=false;
addEventListener('keydown',function(e){if(e.key==='Shift')runKey=true;});addEventListener('keyup',function(e){if(e.key==='Shift')runKey=false;});addEventListener('blur',function(){runKey=false;});
function watchers(){const w=[];if(ALM.t>0)return w;
  if(cur===D.zn&&D.stun<=0&&DISG<=0)w.push({k:'dir',x:D.x,z:D.z,h:D.h,r:D.rage>0?14:9.5,a:D.rage>0?.95:.55,s:D.rage>0?90:28});
  if((rank===0||LOOT.length>0)&&DISG<=0)MGR.forEach(function(m){if(m.zn===cur&&!m.fired&&m.state==='patrol'&&m.stun<=0)w.push({k:'mgr',x:m.x,z:m.z,h:m.g.rotation.y,r:6.5,a:.7,s:10,idle:1,m:m});});
  if(rank===0||!VIGI||GRADE>=2)GUARDS.forEach(function(g){if(g.zn===cur&&g.stun<=0)w.push({k:'guard',x:g.x,z:g.z,h:g.h,r:6.5,a:.7,s:34,gd:g});});
  [RCAM,PCAM,SCAM].forEach(function(A){if(JAM<=0)A.forEach(function(c){if(c.zn===cur)w.push({k:'cam',x:c.x,z:c.z,lz:c.lz,h:c.h,r:c.r,a:.5,s:0,c:c});});});
  return w;}
function sees(w){const dx=pp.x-w.x,dz=pp.z-w.z,d=Math.hypot(dx,dz);if(d>w.r*(w.k==='cam'?1:detM())||d<.01)return false;
  if((Math.sin(w.h)*dx+Math.cos(w.h)*dz)/d<=Math.cos(w.a))return false;
  return !blocked(Z[cur],w.x,w.lz!==undefined?w.lz:w.z,pp.x,pp.z);}
function guardHop(G){G.ti=((G.ti||0)+1)%G.tour.length;const T2=G.tour[G.ti];Z[G.zn].g.remove(G.g);Z[G.zn].g.remove(G.cone.grp);G.zn=T2.zn;G.route=T2.route;Z[G.zn].g.add(G.g);Z[G.zn].g.add(G.cone.grp);G.x=T2.route[0][0];G.z=T2.route[0][1];G.ri=0;G.path=null;G.pi=0;G.wait=1+Math.random()*2;G.fx=0;G.fm=null;}
function updGuard(dt){if(GFC>0)GFC-=dt;if(typeof newZTick==='function')newZTick(dt);coldTick(dt);MGR.forEach(function(m){if(m.lootG>0)m.lootG-=dt;});GUARDS.forEach(function(G){
  if(G.stun>0)G.stun-=dt;if(G.cd>0)G.cd-=dt;
  if(G.stun<=0&&!G.fm){MGR.forEach(function(m){if(G.fm||!m.loot||m.fired||m.zn!==G.zn||m.state!=='patrol'||m.stun>0)return;if(m.lootG>0)return;const d=Math.hypot(m.x-G.x,m.z-G.z);if(d<4.5&&!blocked(Z[G.zn],G.x,G.z,m.x,m.z)){G.fm=m;G.fmT=0;say(G.g,'Monsieur, ne bougez pas !');}});}
  if(G.fm){const m=G.fm,d=Math.hypot(m.x-G.x,m.z-G.z);if(!m.loot||m.fired||m.zn!==G.zn||d>10||G.stun>0)G.fm=null;else{G.fmT+=dt;G.wait=Math.max(G.wait,.3);m.wait=Math.max(m.wait||0,.3);G.h=angLerp(G.h,Math.atan2(m.x-G.x,m.z-G.z),.2);if(G.fmT>=2.2){G.fm=null;m.loot=null;G.wait=3;hitMgr(m,22);addB(15);say(G.g,'Je vous ai attrapé, petit saligaud !');say(m.g,'Mais… c\'est pas à moi !');pop('🚨 Un vigile a trouvé un objet volé sur '+m.name+' : sa réputation s\'effondre ! +15 branleur','good');toast(m.name+' s\'est fait fouiller : objet volé trouvé, blâme !');}}}
  if(!G.ex){G.ex=label('❗',{sx:.8,sy:.8,w:96,h:96,size:60,bg:'rgba(214,40,57,.95)'});G.ex.position.set(0,3.3,0);G.g.add(G.ex);}
  G.ex.visible=G.fx>0&&G.zn===cur&&mode==='zone';
  if(G.zn===cur&&mode==='zone'&&G.stun<=0&&(rank===0||(VIGI&&GRADE>=2))&&DISG<=0&&VEST<=0&&HID<=0&&!(G.cd>0)){
    const dx=pp.x-G.x,dz=pp.z-G.z,d=Math.hypot(dx,dz);let nearS=false;
    Z[cur].markers.forEach(function(m){if(!m.off&&MK[m.obj]&&MK[m.obj][0]==='steal'&&Math.hypot(m.x-pp.x,m.z-pp.z)<3.2)nearS=true;});
    const NT=NK>.5,sv=d>.3&&d<(LK.sim?8:6.5)*(NT?detM():1)&&(Math.sin(G.h)*dx+Math.cos(G.h)*dz)/d>Math.cos(.7)&&!blocked(Z[cur],G.x,G.z,pp.x,pp.z);
    const carry=LOOT.length>0&&d<9;
    if(sv&&(nearS||carry||NT)){if(!(G.fx>0)){if(NT){say(G.g,'Hé, toi ! Stop !');pop('🔦 Un vigile t\'a vu dans sa lampe : cours ou cache-toi !','warn');}else{say(G.g,GFC>0?'Je vous ai à l\'œil…':carry?'Vous cachez quoi, là ?':'Hm… Qu\'est-ce que vous faites là ?');if(GFC<=0)pop('👀 Un vigile te soupçonne ! Éloigne-toi','warn');}}G.fx=NT?22:(GFC>0?5:9);}
    if(NT&&G.fx>0){if(d<1.3){G.fs=(G.fs||0)+dt;if(G.fs>=.45){G.fs=0;G.fx=0;G.wait=3;G.path=null;G.cd=25;if(LOOT.length)caughtLoot(G);else{say(G.g,'Je t\'ai eu !');pop('🚨 Un vigile t\'a attrapé de nuit !','bad');giveBlame('un vigile t\'a attrapé de nuit !',0);}}}else G.fs=Math.max(0,(G.fs||0)-dt*2);}
    else if(G.fx>0&&d<2.7&&GFC<=0){G.fs=(G.fs||0)+dt;if(G.fs<dt+.001){say(G.g,'Je vais vous fouiller !');pop('🔎 Fouille en cours… fuis ou reste','warn');}
      if(G.fs>=2.2){G.fs=0;G.fx=0;G.wait=3;G.path=null;G.cd=25;GFC=180;
        if(LOOT.length){if(coins>=1&&!BR&&!LK.sim)startBribe(G);else caughtLoot(G);}
        else{say(G.g,'Oups, désolé, je me suis trompé.');pop('✅ Fouillé : rien sur toi, le vigile s\'excuse','good');}}}
    else G.fs=Math.max(0,(G.fs||0)-dt*2);}
  if(guardMirror(G,dt)){}
  else if(G.stun<=0){
    if(G.fx>0){G.fx-=dt;const dx=pp.x-G.x,dz=pp.z-G.z,d=Math.hypot(dx,dz);
      if(G.zn!==cur||mode!=='zone'||(rank>0&&!(VIGI&&GRADE>=2)))G.fx=0;
      else if(HID>0&&d>2.2){G.fx=0;G.path=null;G.wait=3;say(G.g,'Il est passé où, lui ?');}
      else{G.hd=Math.atan2(dx,dz);G.h=angLerp(G.h,G.hd,1-Math.exp(-dt*8));
        const NC=NK>.5,keep=NC?.9:(GFC>0?4.8:2.4);if(d>keep){G.rp=(G.rp||0)-dt;if(G.rp<=0||!G.path||G.pi>=G.path.length){G.rp=.8;G.path=path(Z[G.zn],G.x,G.z,pp.x,pp.z);G.pi=0;}follow(G,dt,NC?5.7:keep-.1);G.h=angLerp(G.h,Math.atan2(dx,dz),1-Math.exp(-dt*8));walkAnim(G.g,G.ph,1);}
        else walkAnim(G.g,0,0);
        if(G.fx<=0){G.path=null;G.wait=1.2;}}}
    else if(G.wait>0){G.wait-=dt;walkAnim(G.g,0,0);}
    else{const rt=G.route;
      if(G.tour&&G.ri===rt.length-1&&G.path&&G.pi>=G.path.length){guardHop(G);}
      else if(!G.path||G.pi>=G.path.length){G.ri=(G.ri+1)%rt.length;const w=rt[G.ri];G.path=path(Z[G.zn],G.x,G.z,w[0],w[1]);G.pi=0;G.wait=.8+Math.random()*1.2;walkAnim(G.g,0,0);}
      else{follow(G,dt,G.spd);G.h=angLerp(G.h,G.hd,1-Math.exp(-dt*7));walkAnim(G.g,G.ph,1);}}}
  G.g.position.set(G.x,G.stun>0?.35:0,G.z);G.g.rotation.y=G.h;G.g.rotation.x=G.stun>0?-1.35:0;G.cone.grp.position.set(G.x,0,G.z);G.cone.grp.rotation.y=G.h;});}
let pIdleT=0,VBLCD=0;
function dSees(x,z){const dx=x-D.x,dz=z-D.z,d=Math.hypot(dx,dz);if(d>9.5||d<.3)return false;if((Math.sin(D.h)*dx+Math.cos(D.h)*dz)/d<=Math.cos(.55))return false;return !blocked(Z[D.zn],D.x,D.z,x,z);}
function focusTick(dt){
  if(!moving&&!act&&mode==='zone'&&!WCIN&&(!uiOpen||PHN))pIdleT+=dt;else pIdleT=0;
  if(VBLCD>0)VBLCD-=dt;
  if(D.rage>0||D.inv||D.stun>0||CONV){D.fx=null;return;}
  let F=D.fx;
  const pOK=function(){return !IMM&&cur===D.zn&&mode==='zone'&&HID<=0&&pIdleT>0&&!((rank>=1||SEC)&&((LK.sim&&!SEC)||(SEC?VBLCD>0:CONVCD>0)))&&dSees(pp.x,pp.z);};
  const eOK=function(e){return e.zn===D.zn&&!(e.out>0)&&e.f&&dSees(e.x,e.z);};
  if(!F){
    if(pIdleT>(SEC?0:.4)&&pOK())F=D.fx={k:'p',t:0,lost:0};
    else{const e=EMP.find(eOK);if(e)F=D.fx={k:'e',e:e,t:0,lost:0};}
    if(!F)return;
    D.path=null;if(cur===D.zn){say(dirc,F.k==='p'?(SEC?'Bougez, vite !':(rank<1?'Toi, là !':'Hé, vous là-bas !')):'Hé, vous !');if(F.k==='p'&&SEC){pop('🗣️ La directrice te voit immobile : bouge !','warn');beep(500,.12,.06);}}}
  const ok=F.k==='p'?pOK():eOK(F.e);
  const tx=F.k==='p'?pp.x:F.e.x,tz=F.k==='p'?pp.z:F.e.z;
  D.path=null;D.pi=0;D.wait=Math.max(D.wait,.25);D.th=Math.atan2(tx-D.x,tz-D.z);
  if(!ok){F.lost+=dt;if(F.lost>.8){D.fx=null;D.wait=Math.max(D.wait,1.2);}return;}
  F.lost=0;const was=F.t;F.t+=dt;
  if(was<2.5&&F.t>=2.5){if(F.k==='p'){const _ph=rank<1?phrase('idle',cur):'';say(dirc,SEC?'Vous allez vous faire gronder !':(rank<1?_ph:'Bougez, vite !'));if(SEC){pop('⚠️ Bouge, ou tu vas te faire gronder : blâme dans 2 s !','bad');beep(420,.2,.08);}else if(rank<1)pop('🗣️ La directrice : « '+_ph+' »','warn');else toast('La directrice te fixe : bouge, vite !');}else say(dirc,'Au travail, '+F.e.name+' !');}
  if(F.t>=5){D.fx=null;D.wait=1.5;
    if(F.k==='p'){if(SEC){VBLCD=30;say(dirc,'Un vigile qui dort, c\'est un blâme !');giveBlame('la directrice t\'a vu planté là à ne rien faire !',0);if(blames>=3){blames=0;blAge=0;FIREW=null;fireV('la directrice');}}else if(rank>=1)startConv(true);}
    else{const e=F.e;say(e.g,'Pardon !');endFault(e);e.noF=40;e.warn=1;}}}
function inPauseRoom(){return cur==='office'&&pp.x>38.4&&pp.x<60.2&&pp.z>-43.6&&pp.z<-25.2;}
function pauseTick(dt){
  if(PCD>0)PCD-=dt;if(PTS>0)PTS-=dt;if(PNGCD>0)PNGCD-=dt;
  const inR=inPauseRoom();
  if(ONB&&rank===0){if(BRK>0){BRK-=dt;if(BRK<=0){BRK=0;pop('⏱️ Ta pause est finie : va dépointer !','warn');}}else OVT+=dt;}
  else if(rank>=1){ONB=false;BRK=0;OVT=0;}
  IMM=rank===0&&ONB&&BRK>0&&inR&&mode==='zone';
  /* la directrice : pause jamais dépointée */
  if(rank===0&&ONB&&BRK<=0&&!inR&&mode==='zone'&&cur===D.zn&&D.rage<=0&&D.stun<=0&&PNGCD<=0&&OVT>=15&&dSees(pp.x,pp.z)){
    PNGCD=20;say(dirc,'Vous n\'avez pas dépointé votre pause !');
    if(OVT>=60){ONB=false;BRK=0;OVT=0;PCD=90;pop('📋 La directrice : « Pause jamais dépointée ! » Blâme','bad');giveBlame('tu as quitté la pause sans dépointer (plus de 2 minutes) !',0);}
    else pop('📋 La directrice : « Allez dépointer votre pause ! »','warn');}
  /* la directrice monte parfois aux bureaux */
  if(WCIN&&rank===0){if(WCIN.t>=40){WCKT-=dt;if(WCKT<=0){WCKT=20;const wm=MGR.find(function(m){return m.zn==='office'&&!m.fired&&m.state==='patrol'&&m.stun<=0;})||MGR.find(function(m){return !m.fired&&m.stun<=0;});if(wm)wcKnock(wm);}}else WCKT=0;}
  if(D.ov&&D.zn!==D.ov.z)D.ov=null;
  TIPT-=dt;if(TIPT<=0){TIPT=40+Math.random()*35;
    if(mode==='zone'&&rank===0&&!CINE&&!uiOpen){const c=[];
      BAYS.forEach(function(b){if(b.state==='docked'&&b.left>0)c.push('Camion au quai '+(b.i+1)+' : '+b.left+' palette'+(b.left>1?'s':'')+' à décharger');});
      ['rayon','reserve','nettoyer'].forEach(function(k){const o=OBJ[k];if(o&&o.n<o.max)c.push(o.t+' ('+o.n+'/'+o.max+')');});
      if(BAL.broken||BAL.full)c.push('La balle à cartons est '+(BAL.broken?'bloquée':'pleine')+' : vide-la (réserve)');if(RES.bal>=5&&!BAL.full)c.push('Des balles de carton sont à charger dans un camion');else if(RES.ct>=8)c.push('Les cartons s\'accumulent : à jeter');
      if(c.length)toast(c[(Math.random()*c.length)|0]);}}
  DVIS-=dt;
  if(DVIS<=0){DVIS=45+Math.random()*40;
    const vz=DVZ[cur];
    if(mode==='zone'&&vz&&D.zn==='store'&&!D.ov&&D.rage<=0&&!D.inv&&!CONV&&D.stun<=0&&!D.fx&&!CINE){
      const st=vz.s[(Math.random()*vz.s.length)|0];setDZone(cur);D.x=st[0];D.z=st[1];D.path=null;D.wait=.4;D.ov={z:cur,i:-1,w:vz.w};}}
}
const DVZ={office:{s:[[18.8,-34],[33.8,-32.6]],w:[[26,-33],[36,-30],[46,-30],[56,-30],[40,-38],[30,-31],[19,-34]]},reserve:{s:[[8,-27.2]],w:[[-2,-33.5],[-17.5,-31.8],[-25.5,-35.6],[-32,-35.8],[-37.3,-31],[-20,-35.5],[0,-30],[8,-27.2]]},parking:{s:[[0,26]],w:[[0,34],[-18,34],[8,44],[22,33],[0,26]]}};

/* ---------- systemes v95 : autolaveuse, satisfaction, carrelage, caisses ---------- */
var SPT=10,ALT=30,SAT=80,SATT=0,SATLOW=0,TILEN=0,BROKEN=[],CKS=[],MACH={g:null,carry:false,dropT:0,mkz:{},home:{x:9,z:-29.4}},CKT=0,CKHELP=0;
function spillFall(){if(!NPC.some(function(c){return !c.off;}))return;
  SAT=Math.max(0,SAT-10);MGR.forEach(function(m){if(!m.fired)hitMgr(m,4,'auto');});if(rank>=1)RESULT=Math.max(0,RESULT-4);
  addAnger(4);if(rank>=1)toast('Un client a glissé sur un produit ! Résultats en baisse : nettoie vite avec l\'autolaveuse.');}
function mkMini(){const g=new T.Group(),c=[0xe63946,0x2a9d8f,0x9d4edd,0xf4a261,0x457b9d,0x8ac926][(Math.random()*6)|0];
  tube(g,.2,.17,.7,c,0,.55,0,1,.8);ell(g,.17,0xf1c9a5,0,1.0,0);ell(g,.18,[0x222222,0x6b4226,0xb08968,0xdddddd][(Math.random()*4)|0],0,1.06,-.03,1,.6,1);box(g,.3,.2,.22,0x2f80ed,.28,.5,.18,false);return g;}
function buildSys2(){
  /* autolaveuse en reserve */
  const g=new T.Group();box(g,.9,.45,1.3,0xf2c230,0,.4,0,true);box(g,.7,.4,.6,0x2f6fd0,0,.78,-.3,true);box(g,.8,.18,.5,0x23272e,0,.14,.5,false);box(g,.08,.9,.08,0x555e6a,-.3,.95,-.65,false);box(g,.08,.9,.08,.3?0x555e6a:0,.3,.95,-.65,false);box(g,.7,.06,.06,0x555e6a,0,1.4,-.7,false);
  [-.4,.4].forEach(function(a){[-.5,.5].forEach(function(b){tube(g,.09,.09,.08,0x15181d,a,.09,b,1,1,0,Math.PI/2);});});
  const lb=label('Autolaveuse',{sx:1.5,sy:.38,w:256,h:64,size:28,depth:true});lb.position.set(0,1.9,0);g.add(lb);
  g.position.set(MACH.home.x,0,MACH.home.z);Z.reserve.g.add(g);MACH.g=g;MACH.mk=marker(Z.reserve,'autolav',MACH.home.x-1.6,MACH.home.z);
  /* caissieres + files d'attente */
  const xs=[-9.5,-6.4,-3.4,-.3,2.8,5.9].map(function(x){return x<=-14.4?x:-14.4+(x+14.4)*1.5;});
  const nm=['Julie','Léa','Sandra','Chloé','Tom','Yasmine'],hairs=[0x6b3a2a,0x6b4226,0x2a2a2a,0xb5651d,0xf2c96b,0x3a2a1a];
  xs.forEach(function(x,i){let ch=null;const ex=EMP.find(function(e){return e.name===nm[i];});
    if(ex)ch=ex.g;else{ch=makeChar({shirt:0x2f6fd0,pants:0x2b2f36,hair:hairs[i],badge:1,fem:1,hs:i%2?'long':'queue'});empTag(ch,nm[i]);ch.position.set(x,0,17.9);ch.rotation.y=Math.PI;Z.store.g.add(ch);}
    const k={i:i,x:x,name:nm[i],cash:ch,q:Math.floor(Math.random()*2),state:'open',t:0,dist:0,sv:0,minis:[]};
    for(let j=0;j<4;j++){const mn=mkMini();mn.position.set(x,0,13.4-j*.85);mn.rotation.y=Math.PI;mn.visible=false;Z.store.g.add(mn);k.minis.push(mn);}
    k.mc=marker(Z.store,'aidecaisse',x-1.9,17.2,'Aider en caisse');k.mc.off=true;k.mc.ck=k;
    k.md=marker(Z.store,'discuter',x+1.9,17.2,'Caissière '+nm[i]);k.md.ck=k;CKS.push(k);});}
function machHome(){MACH.dropT=0;Z.reserve.g.add(MACH.g);MACH.g.position.set(MACH.home.x,0,MACH.home.z);MACH.g.rotation.y=0;if(MACH.mk){MACH.mk.off=false;MACH.mk.lb.visible=true;}Object.keys(MACH.mkz).forEach(function(k){MACH.mkz[k].off=true;});}
function machDrop(){if(!MACH.carry||mode!=='zone')return;MACH.carry=false;const x=pp.x+Math.sin(pl.rotation.y)*1.2,zz=pp.z+Math.cos(pl.rotation.y)*1.2;Z[cur].g.add(MACH.g);MACH.g.position.set(x,0,zz);MACH.dropT=15;if(MACH.mk)MACH.mk.off=true;const mz=MACH.mkz[cur]||(MACH.mkz[cur]=marker(Z[cur],'autolav',0,0,'Reprendre l\'autolaveuse'));mz.x=x;mz.z=zz;mz.g.position.set(x,0,zz);mz.off=false;toast('Autolaveuse lâchée : elle retourne à sa place dans 15 s si personne ne la reprend.');}
function machToggle(){if(!MACH.carry){MACH.dropT=0;Object.keys(MACH.mkz).forEach(function(k){MACH.mkz[k].off=true;});if(MACH.mk)MACH.mk.off=false;MACH.carry=true;pl.add(MACH.g);MACH.g.position.set(0,0,1.2);MACH.g.rotation.y=0;MACH.mk.lb.visible=false;toast('Tu pousses l\'autolaveuse : amène-la sur les produits tombés dans le magasin (ça ralentit). Reviens la ranger en réserve.');}
  else if(cur==='reserve'){MACH.carry=false;Z.reserve.g.add(MACH.g);MACH.g.position.set(MACH.home.x,0,MACH.home.z);MACH.g.rotation.y=0;MACH.mk.lb.visible=true;toast('Autolaveuse rangée.');}
  else toast('Va la ranger en réserve (rond de l\'autolaveuse).');}
function repairTile(m){const i=BROKEN.findIndex(function(b){return b.m===m;});if(i<0)return;const b=BROKEN[i];Z.store.g.remove(b.d);m.off=true;m.g.visible=false;BROKEN.splice(i,1);RESULT=Math.min(100,RESULT+3);coins+=2;addW(2);SAT=Math.min(100,SAT+4);toast('Carrelage réparé : Résultats +3, +2 pièces.');}
function helpCk(m){const k=m.ck;if(!k)return;k.q=Math.max(0,k.q-3);if(k.state!=='open'){k.state='open';k.t=0;k.cash.visible=true;}RESULT=Math.min(100,RESULT+3);coins+=1;addW(2);m.cool=5;SAT=Math.min(100,SAT+3);toast('Tu aides en caisse à '+k.name+' : la file se vide. Résultats +3.');}
function chatCk(m){const k=m.ck;if(!k)return;
  if(k.state!=='open'){toast('La caisse de '+k.name+' est déjà perturbée.');return;}
  dlg('🛒 '+k.name+' (caisse '+(k.i+1)+')','Tu t\'approches de la caissière. Que fais-tu ? Plus c\'est méchant, plus ça rapporte de points de branleur, mais plus tu risques de te faire dénoncer.',[
   {t:'Discuter pour la distraire (sûr, +4 branleur)',f:function(){k.dist=25;addB(4);sayBig(k.cash,'😵 Distraite ! (25 s)');toast('Tu distrais '+k.name+' : elle encaisse plus lentement (25 s).');}},
   {t:'L\'envoyer en pause (≈ 55 %, +8 branleur)',f:function(){if(Math.random()<.55){k.state='break';k.t=45;k.cash.visible=false;addB(8);pop('☕ '+k.name+' part en pause : caisse fermée !','good');}else{say(k.cash,'Pas maintenant, j\'ai du monde !');toast('Elle refuse.');}}},
   {t:'Fermer la caisse (≈ 70 %, +6 branleur)',f:function(){if(Math.random()<.7){k.state='closed';k.t=40;addB(6);pop('🔒 Caisse '+(k.i+1)+' fermée !','good');}else{say(k.cash,'Non, je reste ouverte.');toast('Elle refuse de fermer.');}}},
   {t:'La faire pleurer (≈ 35 %, +15 branleur, risque de blâme)',f:function(){if(Math.random()<.35){k.state='cry';k.t=70;k.cash.visible=false;addB(15);pop('😭 '+k.name+' fond en larmes et quitte le magasin !','good');}else{say(k.cash,'Je vais le dire au manager !');pop('😠 '+k.name+' te dénonce : blâme !','bad');giveBlame('tu as harcelé une caissière',0);}}},
   {t:'Annuler'}]);}
function elevCall(dt){if(ELEV.call){ELEV.call.t-=dt;if(ELEV.call.t<=0){const k=ELEV.call.m;ELEV.call=null;if(ELEV.t>0&&!k.fired){ELEV.t=0;addB(5);toast(k.name+' débloque l\'ascenseur du Drive : sa réputation en prend un coup. +5 branleur');hitMgr(k,8);}}}}
function sys2(dt){
  /* ascenseur + commandes du drive */
  if(ELEV.t>0){ELEV.t-=dt;if(ELEV.t<=0&&rank<1)toast('L\'ascenseur du Drive est réparé.');}
  ORD.nt-=dt;if(ORD.nt<=0){ORD.nt=(LK.sim?12:26)+Math.random()*10;if(ORD.n<14)ORD.n++;}
  ORD.dt-=dt;if(ORD.dt<=0){ORD.dt=17;if(ELEV.t<=0&&ORD.n>0&&drvAlive()>0)ORD.n--;}
  drvTick(dt);priTick(dt);dxTick(dt);
  if(ORD.bins)ORD.bins.forEach(function(b,j){b.visible=j<ORD.n;});
  elevCall(dt);
  if(ELEV.sign)ELEV.sign.forEach(function(l){l.visible=ELEV.t>0;});
  /* carrelage cassé */
  SPT-=dt;if(LK.sim&&SPT<=0){SPT=22+Math.random()*12;const sx=[-16,-8,-3,2,14,20,26,36];messAt(sx[(Math.random()*sx.length)|0],-9+Math.random()*19);if(rank>=1)toast('Simulation : un produit s\'est cassé dans une allée, va chercher l\'autolaveuse en réserve.');}
  TILEN-=dt;if(TILEN<=0){TILEN=LK.sim?(18+Math.random()*10):(70+Math.random()*60);if(BROKEN.length<4){const xs=[-16,-8,-3,2,14,20,26,36],x=xs[(Math.random()*xs.length)|0],z=-9+Math.random()*19;
    const cv=document.createElement('canvas');cv.width=cv.height=128;const c=cv.getContext('2d');c.strokeStyle='#2b2118';c.lineWidth=5;c.lineCap='round';for(let k=0;k<7;k++){c.beginPath();let px=64,py=64;c.moveTo(px,py);for(let j=0;j<3;j++){px+=(Math.random()-.5)*60;py+=(Math.random()-.5)*60;c.lineTo(px,py);}c.stroke();}
    const d=new T.Mesh(new T.PlaneGeometry(1.8,1.8),new T.MeshBasicMaterial({map:new T.CanvasTexture(cv),transparent:true,depthWrite:false}));d.rotation.x=-Math.PI/2;d.position.set(x,.05,z);Z.store.g.add(d);
    const m=marker(Z.store,'reparer',x,z,'Carrelage cassé');BROKEN.push({d:d,m:m,age:0});if(rank>=1)toast('Du carrelage s\'est cassé dans le magasin : va le réparer.');}}
  for(let i=BROKEN.length-1;i>=0;i--){const b=BROKEN[i];b.age+=dt;if(b.age>(LK.sim?300:150)){Z.store.g.remove(b.d);b.m.off=true;b.m.g.visible=false;BROKEN.splice(i,1);}}
  /* caisses */
  const f=crowd(mins/60);let Q=0,worst=0;
  CKS.forEach(function(k){
    if(k.state!=='open'){k.t-=dt;if(k.t<=0){k.state='open';k.cash.visible=true;}}
    k.dist=Math.max(0,k.dist-dt);
    if(Math.random()<dt*.03*f*(LK.sim?3:1)&&k.q<8)k.q++;
    if(k.state==='open'&&k.q>0){k.sv+=dt*(k.dist>0?.04:.13);if(k.sv>=1){k.sv=0;k.q--;}}
    else if(k.state!=='open'&&k.q>0&&Math.random()<dt*.7){const o=CKS.filter(function(x){return x.state==='open'&&x!==k;});if(o.length){o.sort(function(a,b){return a.q-b.q;})[0].q++;k.q--;}}
    k.mc.off=!(rank>=1&&(k.q>=3||k.state!=='open'));k.md.off=!(rank===0&&k.state==='open');
    for(let j=0;j<4;j++)k.minis[j].visible=j<k.q;Q+=k.q;worst=Math.max(worst,k.q);});
  CKHELP-=dt;if(CKHELP<=0){CKHELP=18;if(Q>=9){const w=CKS.slice().sort(function(a,b){return b.q-a.q;})[0];w.q=Math.max(0,w.q-2);}}
  /* satisfaction */
  let d=0;const em=shEmpty();if(em>=3)d-=.02*Math.min(em,8);if(BROKEN.length)d-=.05*BROKEN.length;if(Q>=9)d-=.25;else if(worst>=5)d-=.1;if(ORD.n>=7)d-=.1;if(d===0&&SAT<80)d=.08;
  SAT=Math.max(0,Math.min(100,SAT+d*dt));
  if(SAT<50){if(rank>=1)RESULT=Math.max(0,RESULT-dt*(50-SAT)/50*.18);addAngerSlow(dt*(50-SAT)/50*.9);}
  ALT-=dt;if(ALT<=0&&SAT<50&&rank>=1){ALT=55+Math.random()*30;toast('Clients non satisfaits : '+(Q>=9||worst>=5?'trop de monde en caisse':(ORD.n>=7?'les commandes du Drive sont en retard'+(ELEV.t>0?' (ascenseur en panne)':''):em>=3?'les rayons sont vides':((BROKEN.length?'carrelage cassé':'le magasin est mal tenu'))))+'. Les Résultats baissent.');}
  if(SAT<30){SATT-=dt;if(SATT<=0){SATT=8;MGR.forEach(function(m){if(!m.fired)hitMgr(m,2,'auto');});if(rank>=1)RESULT=Math.max(0,RESULT-2);addAngerSlow(2);}}else if(SAT>45)SATLOW=0;
  /* autolaveuse : nettoie les produits tombes */
  if(MACH.dropT>0&&!MACH.carry){MACH.dropT-=dt;if(MACH.dropT<=0)machHome();}
  vhInit();vhTick(dt);
  if(MACH.carry&&cur==='store'&&rank>=1){const fx=pp.x+Math.sin(pl.rotation.y)*1.2,fz=pp.z+Math.cos(pl.rotation.y)*1.2;
    for(let i=MESS.length-1;i>=0;i--){const o=MESS[i];if(Math.hypot(o.g.position.x-fx,o.g.position.z-fz)<1.6){S.g.remove(o.g);MESS.splice(i,1);RESULT=Math.min(100,RESULT+3);coins+=1;addW(2);SAT=Math.min(100,SAT+3);toast('✨ Sol nettoyé à l\'autolaveuse : Résultats +3.');}}}}

/* ---------- v221 : vehicules (conduite avant/arriere), palettes, racks dominos, mur de cartons ---------- */
var VZ={x:-36.1,z:-52,w:3,d:7},VH={carry:null,list:[],hc:0,inited:false},PLT=[],RACKS=[],WL=null,RKEV=0;
const FH=[0,1.14,2.28],vwA=function(a){return Math.atan2(Math.sin(a),Math.cos(a));};
const CON={
  filmpal:{pts:3,cool:60,msg:'Tu perces le film de la palette : +3 branleur. Tout va glisser…'},
  perceeau:{pts:6,cool:75,msg:'Bouteille percée : une flaque d\'eau se répand. +6 branleur.',fx:function(m){const g=Z[cur].g,d=new T.Mesh(new T.CircleGeometry(1.6,20),new T.MeshBasicMaterial({color:0x5aaee8,transparent:true,opacity:.6}));d.rotation.x=-Math.PI/2;d.position.set(m.x+1.4,.03,m.z);g.add(d);setTimeout(function(){g.remove(d);},60000);}},
  pyra:{pts:8,cool:120,msg:'Pyramide de packs d\'eau construite… et poussée ! +8 branleur.'},
  bataille:{pts:10,cool:150,msg:'Bataille d\'eau avec les bouteilles : +10 branleur. Tu es trempé !'},
  cachepack:{coins:4,cool:100,msg:'Un pack d\'eau planqué pour le revendre : +4 pièces.'},
  etiq:{pts:6,cool:90,msg:'Étiquettes de prix intervertis : +6 branleur. Bonne chance à la caisse !'},
  frigooff:{pts:10,cool:150,msg:'Frigo débranché : +10 branleur. Les produits vont tiédir…',fx:function(){addAnger(4);}},
  micro:{pts:15,cool:240,msg:'Annonce au micro : +15 branleur !',fx:function(){pop('📢 « Les clients sont priés d\'acheter tout le magasin ! »','good');addAnger(5);}},
  vitre:{pts:3,cool:60,msg:'Dessin sur la vitre : +3 branleur.'}
};
function vhWitness(){return seenList.some(function(w){return w.k==='mgr'||w.k==='guard'||w.k==='dir'||w.k==='cam';});}
function mkVeh(k,x,z,h){const o=new T.Group(),g=new T.Group(),fen=k==='fenwick';o.add(g);let fk=null;
  if(!fen){g.scale.setScalar(.8);g.rotation.y=Math.PI;box(g,.66,.1,.55,0x333a44,0,.2,-1.0,false);box(g,.6,.14,1.5,0xd9534f,0,.22,0,false);box(g,.14,.08,1.3,0x8d949e,-.2,.08,.1,false);box(g,.14,.08,1.3,0x8d949e,.2,.08,.1,false);box(g,.08,.9,.08,0x333a44,0,.7,-.65,false);box(g,.6,.07,.07,0x333a44,0,1.15,-.65,false);}
  else{box(g,1.3,.8,1.9,0xf2b400,0,.65,.2,false);box(g,1.3,.7,.6,0x4b525c,0,.7,1.0,false);box(g,.08,1.3,.08,0x333a44,-.55,1.5,-.1,false);box(g,.08,1.3,.08,0x333a44,.55,1.5,-.1,false);box(g,1.3,.08,1.1,0x333a44,0,2.15,.1,false);box(g,.12,2.6,.12,0x6b7480,-.4,1.3,-1.0,false);box(g,.12,2.6,.12,0x6b7480,.4,1.3,-1.0,false);
    fk=new T.Group();box(fk,.12,.07,1.3,0x8d949e,-.3,.1,-1.7,false);box(fk,.12,.07,1.3,0x8d949e,.3,.1,-1.7,false);box(fk,1.0,.5,.12,0x6b7480,0,.3,-1.05,false);g.add(fk);
    [-.6,.6].forEach(function(a){[-.5,.8].forEach(function(b){tube(g,.18,.18,.2,0x15181d,a,.18,b,1,1,0,Math.PI/2);});});g.rotation.y=Math.PI;}
  const lb=label(fen?'Fenwick':'Transpalette',{sx:1.6,sy:.4,w:256,h:64,size:28,depth:true});lb.position.set(0,fen?2.9:1.6,0);o.add(lb);
  o.position.set(x,0,z);o.rotation.y=h;Z.reserve.g.add(o);
  const v={k:k,o:o,g:g,fk:fk,fy:0,fl:0,load:null,ok:fen?['reserve']:['reserve','store'],home:{x:x,z:z,h:h},s:{x:x,z:z,h:h,v:0,rev:false},zn:'reserve',mkz:{},dropped:false,dropT:0};
  VH.list.push(v);vhMark(v,'reserve');return v;}
function vhMkPos(v){const s=v.s;return v.k==='fenwick'?[s.x+Math.cos(s.h)*1.9,s.z-Math.sin(s.h)*1.9]:[s.x+Math.sin(s.h)*1.35,s.z+Math.cos(s.h)*1.35];}
function vhMark(v,zid){let mk=v.mkz[zid];const q=vhMkPos(v);if(!mk){mk=marker(Z[zid],'vtake',q[0],q[1],v.k==='fenwick'?'Conduire le Fenwick':'Prendre le transpalette');mk.vh=v;v.mkz[zid]=mk;}mk.x=q[0];mk.z=q[1];mk.g.position.set(q[0],0,q[1]);return mk;}
function vhIcon(e){const b=$('bMach');if(b&&b.firstElementChild)b.firstElementChild.textContent=e;}
function vhHideMk(v){Object.keys(v.mkz).forEach(function(k){v.mkz[k].off=true;});}
function vhPts(v){return v.k==='fenwick'?{L:[-1.15,0,1.2,2.0],W:[-.5,0,.5]}:{L:[-.5,-.1,.35,.9],W:[-.2,.2]};}
function vhBlock(v,x,z,h){const zn=Z[cur],P=vhPts(v),sn=Math.sin(h),cs=Math.cos(h),b=zn.bounds;
  for(let i=0;i<P.L.length;i++)for(let j=0;j<P.W.length;j++){const px=x+sn*P.L[i]+cs*P.W[j],pz=z+cs*P.L[i]-sn*P.W[j];
    if(px<b.x[0]+.15||px>b.x[1]-.15||pz<b.z[0]+.15||pz>b.z[1]-.15)return {edge:1};
    for(let k=0;k<zn.obs.length;k++){const o=zn.obs[k];if(px>o.a-.17&&px<o.b+.17&&pz>o.c-.17&&pz<o.d+.17)return o;}}
  return null;}
function vhSync(v){const s=v.s;v.o.position.set(s.x,0,s.z);v.o.rotation.y=s.h;if(VH.carry===v){if(v.k==='fenwick'){pp.x=s.x;pp.z=s.z;}else{pp.x=s.x+Math.sin(s.h)*.8;pp.z=s.z+Math.cos(s.h)*.8;}pp.face=s.h;}}
function vhHome(v,msg){if(v.load){const p=v.load;p.ld=null;v.load=null;Z.reserve.g.add(p.g);p.x=p.hx;p.z=p.hz;p.lv=0;p.top=null;p.under=null;p.g.position.set(p.hx,0,p.hz);p.g.rotation.y=0;}
  if(VH.carry===v)VH.carry=null;Z[v.zn].g.remove(v.o);Z.reserve.g.add(v.o);v.zn='reserve';v.s={x:v.home.x,z:v.home.z,h:v.home.h,v:0,rev:false};v.fl=0;v.fy=0;if(v.fk)v.fk.position.y=0;v.dropped=false;v.dropT=0;vhSync(v);vhHideMk(v);const mk=vhMark(v,'reserve');mk.off=false;vhIcon('🧹');if(msg)toast(msg);}
function vhTake(v){if(!v||VH.carry||MACH.carry||mode!=='zone')return;if(rank>=1||SEC)return;VH.carry=v;VH.tt=v.k==='fenwick'?0:45;VH.tw=0;v.dropped=false;v.dropT=0;v.s.v=0;vhHideMk(v);vhSync(v);vhIcon(v.k==='fenwick'?'🚜':'🛒');
  toast(v.k==='fenwick'?'Tu conduis le Fenwick : pousse le joystick devant toi pour avancer, derrière pour reculer. ⬆️ Fourches pour les lever, Lâcher pour poser la palette puis descendre.':'Tu montes sur le transpalette (45 s) : joystick devant = avancer, derrière = reculer. Écrase les pieds des gens (+5) et fonce dans les managers (KO) ! Bouton Lâcher pour descendre.');}
function vhDrop(){const v=VH.carry;if(!v||mode!=='zone')return;const s=v.s;
  if(v.load){const p=v.load,tx=s.x+Math.sin(s.h)*1.9,tz=s.z+Math.cos(s.h)*1.9;let q=null;PLT.forEach(function(o){if(o!==p&&!o.ld&&!o.top&&Math.hypot(o.x-tx,o.z-tz)<1.3&&(!q||o.lv>q.lv))q=o;});
    const lv=q?q.lv+1:0;if(lv>2){toast('Pile trop haute : 3 palettes maximum.');return;}if(q&&v.fl<lv){toast('Lève davantage les fourches pour poser sur la pile.');return;}
    p.ld=null;v.load=null;Z[cur].g.add(p.g);const px=q?q.x:tx,pz=q?q.z:tz;p.x=px;p.z=pz;p.lv=lv;p.g.position.set(px,lv*1.14,pz);p.g.rotation.y=s.h;p.under=q;p.top=null;if(q)q.top=p;
    if(p.truck&&Math.abs(px-VZ.x)<=VZ.w/2+.6&&Math.abs(pz-VZ.z)<=VZ.d/2+.3){coins+=3;p.dl=10;p.truck=2;pop('📦 Palette livrée au dépôt : +3 pièces','good');toast('Palette de camion rangée : +3 pièces. Un collègue la range, une nouvelle arrive dans 30 s.');return;}
    toast(lv>0?'Palette posée sur la pile ('+(lv+1)+' en hauteur).':(v.fl>0?'La palette retombe au sol.':'Palette posée.'));return;}
  VH.carry=null;v.dropped=true;v.dropT=15;
  if(v.k==='fenwick'){const sd=[1,-1];for(let a=0;a<2;a++){const x=s.x+Math.cos(s.h)*2.0*sd[a],z=s.z-Math.sin(s.h)*2.0*sd[a];if(!hit(x,z,.4,Z[cur])){pp.x=x;pp.z=z;break;}}}
  vhIcon('🧹');vhMark(v,cur).off=false;toast(v.k==='fenwick'?'Fenwick garé : il retourne à sa place dans 15 s.':'Transpalette lâché : il retourne à sa place dans 15 s.');}
function rkTopple(r,dir,chain){if(r.st!=='up')return;if(!chain&&rank===0&&!SEC)mobStart('rack',r.x,r.z,'reserve',{ri:RACKS.indexOf(r)});r.st='fall';r.dir=dir;r.f=0;r.dn=0;const zn=Z.reserve,k=zn.obs.indexOf(r.ob);if(k>=0)zn.obs.splice(k,1);
  r.pv.position.set(r.x,0,r.z+dir*.6);r.g.position.set(0,0,-dir*.6);
  if(!chain){RKEV=1;addB(25);addAnger(35);pop('💥 Le rack s\'effondre dans un fracas !','bad');toast('Racks renversés : +25 branleur. Ça fait du bruit… la directrice s\'énerve.');if(vhWitness())giveBlame('le fracas des racks s\'est entendu jusqu\'au bureau.',4);}
  else{addB(5);}
  const nb=RACKS[RACKS.indexOf(r)+dir];if(nb&&nb.st==='up'){nb.pend=.5;nb.pdir=dir;}}
function rkReset(r){r.st='up';r.f=0;r.pend=0;r.pv.rotation.x=0;r.pv.position.set(r.x,0,r.z);r.g.position.set(0,0,0);if(Z.reserve.obs.indexOf(r.ob)<0)Z.reserve.obs.push(r.ob);}
function wlShow(){if(!WL)return;WL.cu.forEach(function(row,l){row.forEach(function(c){c.m.visible=l<WL.lv;});});const zn=Z.reserve,k=zn.obs.indexOf(WL.ob);if(k>=0)zn.obs.splice(k,1);if(WL.lv>=1&&WL.st==='idle'){WL.ob.d=WL.z+.5;zn.obs.push(WL.ob);}}
function wlSmash(dz){const w=WL;if(!w||w.st!=='idle'||w.lv<1)return;const lv=w.lv,pts=[0,5,10,15][lv];w.st='smash';w.t=0;wlShow();
  w.cu.forEach(function(row,l){row.forEach(function(c){if(l<lv){c.vx=(Math.random()-.5)*4;c.vz=dz*(3+Math.random()*4);c.vy=2+Math.random()*3+l*.8;c.sp=(Math.random()-.5)*8;}});});
  addB(pts);addAnger(3*lv);pop('🧱 Mur de cartons fracassé ! +'+pts+' branleur','bad');toast('Mur de '+lv+' étage'+(lv>1?'s':'')+' fracassé : +'+pts+' branleur. Plus il est haut, plus ça rapporte (max 15).');if(vhWitness())giveBlame('le mur de cartons s\'est effondré devant témoin.',3);}
function wlReset(){if(!WL)return;WL.st='idle';WL.lv=0;WL.t=0;WL.cu.forEach(function(row){row.forEach(function(c){c.m.visible=false;c.x=c.x0;c.y=c.y0;c.z=c.z0;c.m.position.set(c.x0,c.y0,c.z0);c.m.rotation.set(0,0,0);});});wlShow();}
function vhImpact(v,o,sg){const s=v.s,sp=Math.abs(s.v);if(o.rk&&v.k==='fenwick'&&sp>=2.4){rkTopple(o.rk,o.rk.z>=s.z?1:-1,false);s.v*=.7;}else if(o.wl&&sp>=(v.k==='fenwick'?2.4:3)){wlSmash(Math.cos(s.h)*s.v>=0?1:-1);if(Math.cos(s.h)*s.v<0)WL.cu.forEach(function(r){r.forEach(function(c){c.vz=-Math.abs(c.vz);});});else WL.cu.forEach(function(r){r.forEach(function(c){c.vz=Math.abs(c.vz);});});s.v*=.7;}}
function vhFree(v){const s=v.s;for(let r=.25;r<=2;r+=.25)for(let a=0;a<6.28;a+=.4)for(let dh=0;dh<6.28;dh+=.79){const x=s.x+Math.cos(a)*r,z=s.z+Math.sin(a)*r,h=s.h+dh;if(!vhBlock(v,x,z,h)){s.x=x;s.z=z;s.h=h;s.v=0;return true;}}return false;}
function vhDrive(dt,ix,iz){const v=VH.carry,s=v.s,mv=Math.hypot(ix,iz),fen=v.k==='fenwick',x00=(!fen&&vhBlock(v,s.x,s.z,s.h)&&vhFree(v),s.x),z00=s.z,h00=s.h,MX=fen?5.2:9,MR=fen?3:4;let dd=0;
  if(mv>.05){const a=Math.atan2(ix,iz),d1=vwA(a-s.h);if(!fen)s.rev=false;else if(!s.rev&&Math.abs(d1)>2.15)s.rev=true;else if(s.rev&&Math.abs(d1)<1.0)s.rev=false;
    dd=s.rev?vwA(a-s.h-Math.PI):d1;const rate=(.5+Math.min(1,Math.abs(s.v)/3)*.9)*(fen?3:4.2)*dt,nh=s.h+clamp(dd,-rate,rate);if(vhBlock(v,s.x,s.z,s.h)||!vhBlock(v,s.x,s.z,nh))s.h=nh;
    else if(!fen){const px=Math.cos(nh),pz=-Math.sin(nh),fx=Math.sin(nh),fz=Math.cos(nh);const T2=[[.15,0],[-.15,0],[0,.15],[0,-.15],[.3,0],[-.3,0],[0,-.3]];for(let q=0;q<T2.length;q++){const ax=s.x+px*T2[q][0]+fx*T2[q][1],az=s.z+pz*T2[q][0]+fz*T2[q][1];if(!vhBlock(v,ax,az,nh)){s.x=ax;s.z=az;s.h=nh;break;}}}}
  const tgt=mv>.05?(s.rev?-MR:MX)*Math.min(1,mv)*(Math.abs(dd)>1.6?.35:1):0;s.v+=clamp(tgt-s.v,-16*dt,9*dt);
  if(Math.abs(s.v)>.01){const sn=Math.sin(s.h),cs=Math.cos(s.h);let nx=s.x+sn*s.v*dt,nz=s.z+cs*s.v*dt;const stuck=vhBlock(v,s.x,s.z,s.h);
    if(!stuck){let o=vhBlock(v,nx,nz,s.h);if(o&&o!==true){vhImpact(v,o);o=vhBlock(v,nx,nz,s.h);}
      if(o){let ok=false;if(!vhBlock(v,nx,s.z,s.h)){nz=s.z;ok=true;}else if(!vhBlock(v,s.x,nz,s.h)){nx=s.x;ok=true;}
        if(!ok){const dh=[.12,-.12,.25,-.25,.4,-.4];for(let q=0;q<dh.length;q++){if(!vhBlock(v,nx,nz,s.h+dh[q])){s.h+=dh[q];ok=true;break;}}}
        if(!ok&&!fen){const px=Math.cos(s.h),pz=-Math.sin(s.h),OF=[.12,-.12,.24,-.24,.36,-.36];for(let q=0;q<OF.length;q++){const ax=nx+px*OF[q],az=nz+pz*OF[q];if(!vhBlock(v,ax,az,s.h)){nx=ax;nz=az;ok=true;s.v*=.92;break;}}}
        if(!ok){nx=s.x;nz=s.z;s.v=0;}}}
    s.x=nx;s.z=nz;}
  if(!fen){if(mv>.3&&Math.hypot(s.x-x00,s.z-z00)<.004&&Math.abs(s.h-h00)<.002)VH.stk=(VH.stk||0)+dt;else VH.stk=0;if(VH.stk>1.2){VH.stk=0;if(vhFree(v))toast('🛒 Tu te dégages.');}}
  vhSync(v);}
function vhTick(dt){const v=VH.carry;VH.hc=Math.max(0,VH.hc-dt);if(VH.cool>0)VH.cool-=dt;
  if(v){if(v.ok.indexOf(cur)<0)vhHome(v,v.k==='fenwick'?'Le Fenwick ne quitte pas la réserve : il retourne à sa place.':'Le transpalette ne sort pas du magasin ni de la réserve : il retourne à sa place.');
    else if(v.zn!==cur){Z[v.zn].g.remove(v.o);Z[cur].g.add(v.o);v.zn=cur;const s=v.s;if(v.k==='fenwick'){s.x=pp.x;s.z=pp.z;}else{s.x=pp.x-Math.sin(s.h)*.8;s.z=pp.z-Math.cos(s.h)*.8;}s.v=0;vhSync(v);}}
  const w=VH.carry;
  if(w){const s=w.s;
    if(w.k==='fenwick'){w.fy+=(FH[w.fl]-w.fy)*Math.min(1,dt*6);w.fk.position.y=w.fy;
      if(!w.load&&s.v>.3){const tx=s.x+Math.sin(s.h)*1.9,tz=s.z+Math.cos(s.h)*1.9;PLT.forEach(function(p){if(w.load||p.ld||p.top||p.hid||p.lv!==w.fl)return;if(Math.hypot(p.x-tx,p.z-tz)<1.0){p.ld=w;w.load=p;if(p.under){p.under.top=null;p.under=null;}p.lv=0;w.fk.add(p.g);p.g.position.set(0,.05,-1.75);p.g.rotation.y=0;toast('Palette chargée sur les fourches.');}});}}
    else{VH.tt-=dt;if(VH.tt<=10&&!VH.tw){VH.tw=1;toast('🛒 Plus que 10 s sur le transpalette !');}if(VH.tt<=0){VH.cool=2;vhHome(w,'⏱ 45 s : tu sautes du transpalette, il repart tout seul dans la réserve.');}
      else if(Math.abs(s.v)>1.2){const fx=s.x+Math.sin(s.h)*1.25,fz=s.z+Math.cos(s.h)*1.25,seen=new Set();
        NPC.concat(EMP).forEach(function(n){if(seen.has(n))return;seen.add(n);if(n.zn&&n.zn!==cur)return;if(!n.zn&&cur!=='store')return;if(n.fall>0||n.gone>0||n.off||n.hop>0||n.out>0||(n.crT&&clk-n.crT<30))return;
          if(Math.hypot(n.x-fx,n.z-fz)<.8){n.crT=clk;n.hop=1.6;addB(5);try{say(n.g,'AÏE mes pieds !');}catch(_){}pop('🛒 Tu écrases les pieds de '+(n.name||'un client')+' ! +5 branleur','good');if(vhWitness())giveBlame('tu as écrasé les pieds de quelqu\'un devant témoin.',3);}});
        MGR.forEach(function(m){if(m.fired||m.zn!==cur||m.stun>0||(m.vhT&&clk-m.vhT<30))return;if(Math.hypot(m.x-fx,m.z-fz)<1.0){m.vhT=clk;m.stun=Math.max(m.stun||0,5);try{releaseTask(m);}catch(_){}addB(15);try{say(m.g,'Ouille… 💫');}catch(_){}pop('💥 Tu renverses '+m.name+' : KO 5 s ! +15 branleur','good');if(vhWitness())giveBlame('tu as renversé un manager devant témoin.',3);}});}}}
  PLT.forEach(function(p){if(p.truck===2){if(p.dl>0){p.dl-=dt;if(p.dl<=0){p.hid=true;p.g.visible=false;p.rs=20;}}else if(p.rs>0){p.rs-=dt;if(p.rs<=0){p.hid=false;p.truck=1;p.lv=0;p.x=p.hx;p.z=p.hz;p.g.position.set(p.hx,0,p.hz);p.g.rotation.y=0;p.g.visible=true;}}}});
  {const sn=new Set();NPC.concat(EMP).forEach(function(n){if(sn.has(n))return;sn.add(n);if(n.hop>0){n.hop-=dt;try{n.g.position.y=n.hop>0?Math.abs(Math.sin(n.hop*13))*.28:0;}catch(_){}}});}
  /* KO des managers facon Rideau de fer : ils titubent avec des etoiles */
