  QM.lockZ={salle:1,boulangerie:1,poissonnerie:1};QM.stg={i:0,n:0};QM.boss=null;QM.lockR={salle:1,boulangerie:1,poissonnerie:1,froid:1,wc:1};QM.keyNext=9999;QM.wave={i:-1,Q:[]};QM.ceN=100;QM.QS=[];QM.qid=0;QM.QSL=[{t:2},{t:6}];QM.insp=0;QM.IT=[];QM.itN=0;
  QM.RM={};QROOM.forEach(function(r){const o={id:r.id,n:r.n};if(r.z){const q=QPORT.find(function(q){return q.to===r.z&&QZ.indexOf(q.zn)>=0;});o.door={zn:q.zn,x:q.x,z:q.z};o.zn=r.z;}
    else{const M=Z[r.spot].markers.filter(function(m){return r.id==='wc'?['wc','wcplan','lavabo'].indexOf(m.obj)>=0:m.obj==='mfrigo';});const c=M.length?[M.reduce(function(a,m){return a+m.x;},0)/M.length,M.reduce(function(a,m){return a+m.z;},0)/M.length]:qmRand(r.spot);const d=qmFree(r.spot,c[0],c[1]);o.door={zn:r.spot,x:d[0],z:d[1]};o.zn=r.spot;o.spot=1;}
    o.sign=label('🔒 '+r.n,{sx:3.6,sy:.8,w:360,h:80,size:34,bg:'rgba(120,30,30,.93)'});o.sign.position.set(o.door.x,2.4,o.door.z);scene.add(o.sign);QM.RM[r.id]=o;});
  QM.doorM=qmRingMesh(0xffd21f,'🚪 Ouvrir',360);QM.doorM.g.visible=false;
  QM.aim=label('🎯',{sx:1.1,sy:1.1,w:96,h:96,size:72,bg:'rgba(229,72,77,.9)'});QM.aim.visible=false;scene.add(QM.aim);
  QM.PT=[];QM.dark=null;QM.PEX={};QZ.forEach(function(zn){const sp=Z[zn].spawn||{x:(Z[zn].bounds.x[0]+Z[zn].bounds.x[1])/2,z:(Z[zn].bounds.z[0]+Z[zn].bounds.z[1])/2};QM.PEX[zn]=qmFree(zn,sp.x,sp.z);});
