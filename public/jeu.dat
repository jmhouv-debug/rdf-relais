function pop(t,k){t=noSW(t);try{const e=$('pop');e.textContent=t;const d=Math.max(2300,1300+t.length*50);e.className='';e.style.animationDuration=(d/1000)+'s';void e.offsetWidth;e.className='on '+(k||'');clearTimeout(pop.h);pop.h=setTimeout(function(){e.className='';},d);}catch(_){}}
let AC=null;function beep(f,d,v){}/* sons supprimés */
const LOGM=[];let HEADM=null;
const TCRIT=/blâme|sursis|inond|promu|niveau|grève|victoire|arrest|fouill|syndicat|vie perdue|viré|convoq|alarme|alerte|catastroph|licenci|menott|attrap|repéré|danger|trop tard|inquiét|soupçonne|dénonc|panne|feu|perd/i,THEAD=/^(Tu |Ton |Ta |Tes |Pas |Plus |Trop |Il faut|Aucun|Déjà|Rien|Impossible|Pas d|Il n)/;
function headMsg(t){try{if(mode!=='zone'||!pl)return false;
  const W=20,words=t.split(' '),ln=[];let cu='';words.forEach(function(w){if((cu+' '+w).trim().length>W&&cu){ln.push(cu);cu=w;}else cu=(cu+' '+w).trim();});if(cu)ln.push(cu);if(ln.length>3)return false;
  const cv=document.createElement('canvas'),w=340,h=ln.length*38+24;cv.width=w;cv.height=h;const x=cv.getContext('2d');
  x.fillStyle='rgba(18,32,54,.93)';rr(x,3,3,w-6,h-6,16);x.fill();x.strokeStyle='#fff';x.lineWidth=3;x.stroke();x.fillStyle='#fff';x.font='700 27px Fredoka,system-ui,sans-serif';x.textAlign='center';x.textBaseline='middle';ln.forEach(function(l,k){x.fillText(l,w/2,12+19+k*38);});
  const sp=new T.Sprite(new T.SpriteMaterial({map:ctex(cv),transparent:true,toneMapped:false,depthTest:false}));sp.scale.set(2.5,2.5*h/w,1);sp.position.set(0,4.45,0);
  if(HEADM){try{pl.remove(HEADM.s);}catch(_){}const k=floaters.indexOf(HEADM);if(k>=0)floaters.splice(k,1);}
  pl.add(sp);HEADM={s:sp,g:pl,t:2.4};floaters.push(HEADM);return true;}catch(_){return false;}}

/* ----- v178 : vies (cœurs) / blâmes (cartons), puces de gains, messages triés ----- */
const HLV={k:'',bl:0};
function hudLives(){try{const tot=Math.max(3,lives),bl=Math.min(BLMX(),blames),fw=FIREW?Math.max(0,Math.ceil(60-blAge)):-1;
  const k=lives+'|'+bl+'|'+fw+'|'+BLMX();if(k===HLV.k)return;const up=bl>HLV.bl&&HLV.k!=='';HLV.k=k;HLV.bl=bl;
  let h='<div class="lv" title="Vies">';for(let i=0;i<tot;i++)h+='<span class="h'+(i<lives?'':' e')+'">♥</span>';h+='</div><div class="bd" title="Blâmes">';
  {const BM=BLMX();for(let i=0;i<BM;i++)h+='<span class="c'+(i<BM-bl?' on1':'')+(up&&i===BM-bl?' new':'')+'"></span>';}h+='</div>';
  if(fw>=0)h+='<div class="fw">VIRÉ DANS '+fw+' s</div>';
  const e=$('blames');e.innerHTML=h;e.classList.toggle('alert',lives<=1||bl>=2);}catch(_){}}
const GAINQ={p:null,acc:{sb:0,sw:0,c:0,i:0},q:0,w:0};
function gainTick(dt){try{GAINQ.rt=(GAINQ.rt||0)-dt;if(GAINQ.rt<=0){GAINQ.rt=.5;const w=($('tr')||{}).offsetWidth|0;if(w&&w!==GAINQ.tw){GAINQ.tw=w;document.documentElement.style.setProperty('--trw',w+'px');}}
  if(!GAINQ.p){GAINQ.p={sb:SB,sw:SW,c:coins,i:image};return;}
  const P=GAINQ.p;let ch=false;
  if(SB>P.sb){GAINQ.acc.sb+=SB-P.sb;ch=true;}P.sb=SB;
  if(SW>P.sw){GAINQ.acc.sw+=SW-P.sw;ch=true;}P.sw=SW;
  const dc=coins-P.c;if(Math.abs(dc)>=1){GAINQ.acc.c+=dc;ch=true;}P.c=coins;
  const di=image-P.i;if(Math.abs(di)>=1){GAINQ.acc.i+=di;ch=true;}P.i=image;
  if(ch){GAINQ.q=.9;if(!GAINQ.w)GAINQ.w=.01;}
  if(GAINQ.w){GAINQ.w+=dt;GAINQ.q-=dt;if(GAINQ.q<=0||GAINQ.w>2.4){gainFlush();GAINQ.w=0;GAINQ.q=0;}}}catch(_){}}
const GDEF={sw:['💼','bosseur','#8ff0a4'],sb:['🎭','branleur','#ffb86b'],c:['🪙','','#ffd24a'],i:['⭐','Sérieux','#8fd3ff']};
function gainFlush(){const a=GAINQ.acc,L=[];Object.keys(a).forEach(function(k){const v=Math.round(a[k]);if(v!==0)L.push([k,v]);a[k]=0;});
  if(!L.length)return;L.sort(function(x,y){return Math.abs(y[1])-Math.abs(x[1]);});
  const c=$('gains');if(!c)return;L.slice(0,2).forEach(function(x){const g=GDEF[x[0]],d=document.createElement('div');d.className='gn'+(x[1]<0?' neg':'');d.style.color=x[1]<0?'#ff8a8a':g[2];
    d.textContent=(x[1]>0?'+':'−')+Math.abs(x[1])+' '+g[0]+(g[1]?' '+g[1]:'');c.appendChild(d);setTimeout(function(){d.classList.add('off');setTimeout(function(){d.remove();},500);},2300);});
  while(c.children.length>2)c.firstElementChild.remove();}
const TKEEP=/\b(tu|ton|ta|tes|toi|te)\b|\bt'|il faut|^(va|sers|éteins|entre|appuie|reste|sors|pense|maintiens|bouge|rejoins|répands|remplis|pose|ouvre|ferme|prends|utilise)\b/i;
const GSTRIP=/\s*[,.:;]?\s*(?:Sérieux\s*[+−-]\s*\d+(?:[.,]\d+)?|[+−-]\s*\d+(?:[.,]\d+)?\s*(?:branleur|bosseur|pièces?|🪙|Sérieux))/gi;
function toastClean(t){let u=String(t).replace(GSTRIP,'').replace(/\s+([.!,;:])/g,'$1').replace(/[,;:]\s*$/,'.').replace(/\s{2,}/g,' ').trim();
  if(u.replace(/[^A-Za-zÀ-ÿ]/g,'').length<5)return '';if(!TKEEP.test(u))return '';return u;}
let FORCEM=false,ACTT=false;
function noSW(t){if(typeof t!=='string')return t;try{if(rank!==0)return t;}catch(_){return t;}
  return t.replace(/\s*\(?\s*[,.;:•]?\s*(?:Sérieux\s*[+−-]\s*\d+(?:[.,]\d+)?|[+−-]\s*\d+(?:[.,]\d+)?\s*(?:points?\s+de\s+)?(?:bosseur|Sérieux))\s*\)?/gi,'').replace(/,\s*\d+\s+de\s+bosseur/gi,'').replace(/\s*•\s*Sérieux\s*\d+\s*\/\s*\d+/gi,'').replace(/tâches? de bosseur/gi,'tâches').replace(/points? de bosseur/gi,'points').replace(/bosseur\s*×\s*2/gi,'travail ×2').replace(/\s+([.!,;:])/g,'$1').replace(/\(\s*\)/g,'').replace(/\s{2,}/g,' ').trim();}
function tMini(t){try{return typeof t==='string'&&MGR.some(function(m){return !m.fired&&t.indexOf(m.name+' ')===0&&!(m.stand<25);});}catch(_){return false;}}
function toast(t,force){t=noSW(t);if(tMini(t)&&!force){try{const c=$('toasts');const d=document.createElement('div');d.className='tt mini';d.textContent=t.replace(/\s+([.!,;:])/g,'$1');c.appendChild(d);while(c.children.length>2)c.firstElementChild.remove();d._h=setTimeout(function(){d.classList.add('off');setTimeout(function(){d.remove();},650);},2600);LOGM.unshift({t:($('clock')||{}).textContent||'',m:t});if(LOGM.length>40)LOGM.pop();}catch(_){}return;}try{
  const crit=!!force||FORCEM||TCRIT.test(t);
  if(crit)toast.ct=Date.now();else if(ACTT){const u=String(t).replace(GSTRIP,'').replace(/\s+([.!,;:])/g,'$1').replace(/[,;:]\s*$/,'.').trim();if(u.replace(/[^A-Za-zÀ-ÿ]/g,'').length>=3)t=u;}else{t=toastClean(t);if(!t)return;if(Date.now()-(toast.ct||0)<2200)return;}
  try{LOGM.unshift({t:($('clock')||{}).textContent||'',m:t});if(LOGM.length>40)LOGM.pop();}catch(_){}
  if(!crit&&t.length<=70&&THEAD.test(t)&&headMsg(t))return;
  {const lim=crit?84:56;if(t.length>lim)t=t.slice(0,lim-1).replace(/\s+\S*$/,'')+'…';}
  const c=$('toasts');const last=c.lastElementChild;
  if(last&&last.dataset.t===t){clearTimeout(last._h);last.classList.remove('off');last._h=setTimeout(function(){last.classList.add('off');setTimeout(function(){last.remove();},650);},3200);return;}
  const d=document.createElement('div');d.className='tt'+(crit?' warn':'');d.textContent=t;d.dataset.t=t;c.appendChild(d);
  while(c.children.length>1)c.firstElementChild.remove();
  d._h=setTimeout(function(){d.classList.add('off');setTimeout(function(){d.remove();},650);},crit?Math.min(5200,2800+t.length*25):Math.min(3400,1800+t.length*22));}catch(_){}}
function logOpen(){const L=$('logl');const full=(HUDFULL||'').split('</div>').filter(function(x){return x;}).map(function(x){return x.replace(/<div>/,'')}).join('<br>');
  L.innerHTML=(full?'<div class="lgm"><small>📋 Objectifs et infos du moment</small><br>'+full+'</div>':'')+(LOGM.length?LOGM.map(function(m){return '<div class="lgm"><small>'+esc(m.t)+'</small> '+esc(m.m)+'</div>';}).join(''):'<p class="accn">Aucun message pour l\'instant.</p>');$('logp').hidden=false;uiOpen=true;}
function logClose(){$('logp').hidden=true;uiOpen=false;}
function say(g,text){let tx=String(text),two=false;if(tx.length>18){const mid=tx.length/2;let best=-1;for(let i=0;i<tx.length;i++)if(tx[i]===' '&&(best<0||Math.abs(i-mid)<Math.abs(best-mid)))best=i;if(best>0){tx=tx.slice(0,best)+'\n'+tx.slice(best+1);two=true;}}
  const s=two?label(tx,{sx:2.0,sy:.8,w:300,h:116,size:30,bg:'rgba(245,184,46,.96)',fg:'#1b2433'}):label(tx,{sx:2.6,sy:.62,w:288,h:72,size:30,bg:'rgba(245,184,46,.96)',fg:'#1b2433'});s.position.set(0,two?3.55:3.4,0);g.add(s);floaters.push({s:s,g:g,t:1.7+(two?.5:0)});}
function hit(x,z,r,zn){for(let i=0;i<zn.obs.length;i++){const o=zn.obs[i];if(x>o.a-r&&x<o.b+r&&z>o.c-r&&z<o.d+r)return true;}return false;}
function blocked(zn,x1,z1,x2,z2){for(let i=1;i<15;i++){const t=i/15,x=x1+(x2-x1)*t,z=z1+(z2-z1)*t;for(let j=0;j<zn.obs.length;j++){const o=zn.obs[j];if(x>o.a&&x<o.b&&z>o.c&&z<o.d)return true;}}return false;}
const MEET={on:false,by:'me',t:0,max:90};
function startMeeting(by,host){if(MEET.on)return;mxReset();MEET.on=true;MEET.by=by;MEET.t=0;MEET.max=by==='me'?90:25+Math.random()*20;meetSeatAll();salStart(by);EMP.forEach(function(e){e.g.visible=false;if(e.f)endFault(e);});if(cur!=='salle')enter('salle');if(by==='npc')seatCenter();if(by==='npc')hostStart(host||MGR.find(function(m){return !m.fired;}));
  toast(by==='me'?'Tous les employés sont convoqués en salle de réunion. Plus c\'est court, plus ça rapporte : clos la réunion au pupitre (90 s max).':'Réunion obligatoire : installe-toi sur une chaise libre (bouton 🪑 près d\'un siège). Ne sors pas avant la fin.');
  if(by==='npc'&&rank===0){const r=Math.random();if(r<.45){MX.slide={t:0,dur:MEET.max,n:6};scrMode('slide');MOOD.t=MEET.max;MOOD.k='bad';MOOD.img=image;setTimeout(function(){toast('🎞️ Diaporama interminable : aucune progression pendant la réunion.');},2800);}
    else if(r<.8){pp.x=18;pp.z=-63.2;pp.face=Math.PI;MOOD.t=30;MOOD.k='bad';MOOD.img=image;setTimeout(function(){toast('🧱 Tu es mis au coin pendant 30 s, face au mur. Aucune progression.');},2800);}
    else{coins+=6;MOOD.t=60;MOOD.k='good';setTimeout(function(){toast('💰 Le manager distribue une petite prime : +6 pièces, bosseur ×2 pendant 60 s.');},2800);}}}
function endMeeting(manual){if(!MEET.on)return;MEET.on=false;salEnd();MEETCH.forEach(function(c){c.visible=false;});EMP.forEach(function(e){e.g.visible=!e.cap;e.noF=15;});
  if(MEET.by==='me'){const d=manual?clamp(14-MEET.t*.25,-8,14):-4;RESULT=clamp(RESULT+d,0,100);if(d>0)coins+=4;toast(d>0?'Réunion bouclée en '+Math.round(MEET.t)+' s : Résultats +'+Math.round(d)+', +4 pièces.':'Réunion interminable : les employés ont perdu leur temps. Résultats '+Math.round(d)+'.');}
  else{toast('La réunion est terminée. Retour au travail !');if(rank===0){if(PSEAT){image=Math.min(100,image+2);toast('Tu étais bien assis pendant la réunion : Sérieux +2.');}else{image=Math.max(0,image-3);toast('Tu es resté debout pendant la réunion : le manager note ton manque de respect (Sérieux −3).');}}}
  PSEAT=null;hostEnd();mxReset();
  if(cur==='salle')enter(rank>=1?'office':'store');}
function meetTick(dt){if(!MEET.on)return;mxTick(dt);MEET.t+=dt;EMP.forEach(function(e){e.g.visible=false;});addAngerSlow(dt*1.2);if(MEET.t>=MEET.max)endMeeting(false);}

/* ----- animations de la salle de réunion ----- */
let MX={used:{},slide:null,corner:null,seat:null};
const SLIDES=['Les 47 règles du pointage','Optimiser sa pause : mode d\'emploi','Synergies transversales','Objectif : 110 % de plus','Rappel : le sourire est obligatoire','Tableau Excel illisible','Bilan carbone des post-it','Merci de votre attention (suite)'];
function scrDraw(force){if(!SCR.cv)return;const m=SCR.mode;let key=m;
  if(m==='stats')key+=Math.floor(clk*.7);else if(m==='slide'&&MX.slide)key+=Math.floor(MX.slide.t/(MX.slide.dur/MX.slide.n));else if(m==='eom'||m==='poll'||m==='funny')key+=JSON.stringify(SCR.d);
  if(!force&&key===SCR.key)return;SCR.key=key;
  const x=SCR.cv.getContext('2d'),W=512,H=250;x.fillStyle='#f7f9fc';x.fillRect(0,0,W,H);x.strokeStyle='#2b3a55';x.lineWidth=6;x.strokeRect(3,3,W-6,H-6);x.textAlign='center';x.fillStyle='#10213f';
  if(m==='stats'){x.font='700 24px system-ui,sans-serif';x.fillText('📊 STATS EN DIRECT',W/2,34);
    const L=EMP.filter(function(e){return !(e.out>0);}).map(empRec).concat(onlineEmps()).sort(function(a,b){return b.im-a.im;}).slice(0,6);
    L.forEach(function(r,i){const y=62+i*28;x.textAlign='left';x.font='600 17px system-ui,sans-serif';x.fillStyle='#10213f';x.fillText(r.nm.slice(0,12),16,y);x.fillStyle='#d5dbe6';x.fillRect(130,y-14,150,16);x.fillStyle=r.im>=THREAT_IMG?'#e5484d':'#2f6fd0';x.fillRect(130,y-14,150*r.im/100,16);x.fillStyle='#10213f';x.font='600 15px system-ui,sans-serif';x.fillText('Img '+r.im+' • Niv.'+r.lv+' • B'+r.sw+'/'+r.sb,290,y);});}
  else if(m==='slide'&&MX.slide){const k=Math.min(MX.slide.n-1,Math.floor(MX.slide.t/(MX.slide.dur/MX.slide.n)));x.font='700 30px system-ui,sans-serif';x.fillText(SLIDES[k%SLIDES.length],W/2,100);x.font='600 18px system-ui,sans-serif';x.fillStyle='#55627a';x.fillText('• Point '+(k+1)+'.1 • Point '+(k+1)+'.2 • Point '+(k+1)+'.3',W/2,150);x.fillText('Diapositive '+(k+1)+' / '+MX.slide.n+' (suite en page 47)',W/2,205);}
  else if(m==='eom'&&SCR.d){x.font='700 26px system-ui,sans-serif';x.fillStyle='#b8860b';x.fillText('🏆 EMPLOYÉ DU MOIS',W/2,44);let hh=0;for(let q=0;q<SCR.d.nm.length;q++)hh=(hh*31+SCR.d.nm.charCodeAt(q))%360;x.fillStyle='hsl('+hh+',55%,50%)';x.beginPath();x.arc(W/2,112,40,0,7);x.fill();x.fillStyle='#fff';x.font='700 44px system-ui,sans-serif';x.fillText((SCR.d.nm[0]||'?').toUpperCase(),W/2,128);x.fillStyle='#10213f';x.font='700 30px system-ui,sans-serif';x.fillText(SCR.d.nm,W/2,185);x.font='600 18px system-ui,sans-serif';x.fillText('Sérieux '+SCR.d.im+' • Niv. '+SCR.d.lv+' • Bravo !',W/2,222);}
  else if(m==='funny'&&SCR.d){const F=FUNNY[SCR.d.k];F.f(x,W,H);x.fillStyle='rgba(0,0,0,.65)';x.fillRect(0,H-34,W,34);x.fillStyle='#fff';x.font='600 18px system-ui,sans-serif';x.textAlign='center';x.fillText(F.c,W/2,H-11);}
  else if(m==='poll'&&SCR.d){x.font='700 24px system-ui,sans-serif';x.fillText('🗳️ SONDAGE',W/2,40);x.font='600 22px system-ui,sans-serif';x.fillText(SCR.d.q,W/2,100);x.font='700 54px system-ui,sans-serif';x.fillStyle='#12a150';x.fillText(SCR.d.r+' % OUI',W/2,180);x.font='500 16px system-ui,sans-serif';x.fillStyle='#55627a';x.fillText('Résultat certifié conforme',W/2,222);}
  else{x.font='700 26px system-ui,sans-serif';x.fillText('RÉSULTATS DU MOIS',W/2,40);const V=[72,55,88,40,64,91],C=['#2f6fd0','#e5484d','#12a150','#f5b82e','#9b8cff','#4fc3f7'],bw=64;V.forEach(function(v,i){const bh=(H-100)*v/100;x.fillStyle=C[i];x.fillRect(60+i*bw+6,H-26-bh,bw-12,bh);x.fillStyle='#10213f';x.font='600 16px system-ui,sans-serif';x.fillText(v+'%',60+i*bw+bw/2,H-30-bh);});}
  SCR.tex.needsUpdate=true;}
function scrMode(m,d){if(SAL.projGone>0&&m!=='res'){toast('Plus de vidéoprojecteur : il a été volé !');m='res';d=null;}SCR.mode=m;SCR.d=d||null;scrDraw(true);}
let GB=null,TRO=null;const MEETD={};
function dbl(e){return MEETCH.find(function(d){return d.userData.e===e;});}
function sayBig(g,text){const s=label(text,{sx:4.6,sy:1.05,w:480,h:110,size:46,bg:'rgba(245,184,46,.97)',fg:'#1b2433'});s.position.set(0,3.9,0);g.add(s);floaters.push({s:s,g:g,t:3.2});}
function sayM(e,t){say(dbl(e)||e.g,t);}
function seatOrder(){const L=[];[4,3,5,2,6,1,7,0,8].forEach(function(col){[0,1].forEach(function(sd){const c=CHR.find(function(q){return q.i===col&&q.sd===sd;});if(c)L.push(c);});});return L;}
function meetSeatAll(){MEETCH.length=0;let hp=1;try{if(NET.on&&NET.joined)hp+=Object.keys(NET.players).filter(function(id){return id!==NET.pid;}).length;}catch(_){}hp=Math.min(hp,CHR.length);const L=EMP.filter(function(e){return !(e.out>0);}).slice(0,Math.max(0,CHR.length-hp)),od=seatOrder();
  od.sort(function(a,b){return (SAL.cush[CHR.indexOf(b)]?1:0)-(SAL.cush[CHR.indexOf(a)]?1:0);});
  L.forEach(function(e,k){const d=getDouble(e);setVest(d,isCseName(e.name));d.userData.e=e;d.userData.seat=od[k];d.userData.busy=false;MEETCH.push(d);});
  MEETCH.forEach(function(d){d.visible=true;sitOne(d);});}
function sitOne(d){const u=d.userData,s=u.seat;if(!s)return;d.position.set(s.x,-.08,s.z+(s.sd?.1:-.1));d.rotation.x=0;d.rotation.y=s.sd?Math.PI:0;d.rotation.z=0;u.legs[0].rotation.x=-1.5;u.legs[1].rotation.x=-1.5;u.arms[0].rotation.x=-.85;u.arms[1].rotation.x=-.85;u.m.rotation.x=0;u.home=d.position.clone();u.hr=d.rotation.y;}
function standOne(d){const u=d.userData;d.position.y=0;d.rotation.x=0;u.legs[0].rotation.x=0;u.legs[1].rotation.x=0;u.arms[0].rotation.x=0;u.arms[1].rotation.x=0;}
function walkTo(d,tx,tz,dt){if(globalThis.__fastwalk)return true;const dx=tx-d.position.x,dz=tz-d.position.z,dist=Math.hypot(dx,dz);if(dist<.15)return true;const st=Math.min(dist,3.6*dt);d.position.x+=dx/dist*st;d.position.z+=dz/dist*st;d.position.y=0;d.rotation.y=Math.atan2(dx,dz);const u=d.userData;u.wph=(u.wph||0)+dt*9;walkAnim(d,u.wph,1);return false;}
function giftBox(){if(!GB){GB=new T.Group();box(GB,.6,.4,.6,0xe5484d,0,.2,0,true);box(GB,.12,.41,.62,0xf5b82e,0,.2,0,false);box(GB,.62,.12,.62,0xc9373c,0,.46,0,false);GB.userData.lid=GB.children[2];SL.g.add(GB);}return GB;}
function trophy(){if(!TRO){TRO=new T.Group();cyl(TRO,.22,.12,.3,0xf2c94c,0,.35,0,false);cyl(TRO,.05,.05,.25,0xf2c94c,0,.12,0,false);box(TRO,.4,.1,.4,0x7a5a1a,0,0,0,false);SL.g.add(TRO);}return TRO;}
function mxReset(){MX={used:{},slide:null,corner:null,seat:null,gift:null,eom:null,clap:0};SCR.mode='res';SCR.d=null;scrDraw(true);MEETCH.forEach(function(d){d.userData.busy=false;sitOne(d);});CHR.forEach(function(c){c.g.position.set(c.hx,0,c.hz);c.g.rotation.x=0;c.g.rotation.y=0;c.g.rotation.z=0;});if(GB)GB.visible=false;if(TRO)TRO.visible=false;}
function pickEmp(title,fn){const L=MEETCH.filter(function(d){return !d.userData.busy&&d.userData.e;}).map(function(d){const e=d.userData.e;return {e:e,r:empRec(e)};}).sort(function(a,b){return b.r.im-a.r.im;}).slice(0,7);
  if(!L.length){toast('Personne de disponible dans la salle.');return;}
  const btns=L.map(function(o){return {t:o.e.name+' — '+empLine(o.r),f:function(){fn(o.e,o.r);}};});btns.push({t:'Annuler',f:function(){openMeetMenu();}});dlg(title,'Choisis un employé présent dans la salle.',btns);}
function openMeetMenu(){if(!MEET.on||MEET.by!=='me')return;const u=MX.used;
  const B=[
   {t:'🏆 Employé du Mois (6 pièces)',dis:u.eom||coins<6,f:function(){pickEmp('🏆 Employé du Mois',function(e,r){if(coins<6)return;coins-=6;u.eom=1;e.im=Math.min(100,e.im+15);e.sw=Math.min(100,e.sw+10);e.boost=90;RESULT=Math.min(100,RESULT+3);scrMode('eom',{nm:e.name,im:Math.round(e.im),lv:e.lv});const d=dbl(e);if(d){d.userData.busy=true;standOne(d);MX.eom={d:d,ph:'go',t:0};MX.clap=4.5;}toast('🏆 '+e.name+' est Employé du Mois : il monte devant l\'écran sous les applaudissements. Sérieux +15, bosseur +10, progression boostée 90 s. Résultats +3.');sayM(e,'Merci patron !');});}},
   {t:'🙏 Remerciements publics',dis:u.merci,f:function(){pickEmp('🙏 Remerciements publics',function(e){u.merci=1;e.im=Math.min(100,e.im+8);RESULT=Math.min(100,RESULT+1);MX.clap=3;sayM(e,'Oh… merci !');toast('🙏 Tu remercies '+e.name+' devant tout le monde : image +8. Les autres applaudissent en grinçant des dents.');});}},
   {t:'💰 Distribution de primes (10 pièces)',dis:u.prime||coins<10,f:function(){coins-=10;u.prime=1;EMP.forEach(function(e){empS(e);e.sw=Math.min(100,e.sw+5);});RESULT=Math.min(100,RESULT+4);MX.clap=3;MEETCH.slice(0,3).forEach(function(d){say(d,'💰');});toast('💰 Prime pour tous : bosseur +5 pour chaque employé, Résultats +4.');}},
   {t:'📊 Écran des stats en direct',f:function(){scrMode('stats');toast('Les stats des employés sont projetées en direct.');}},
   {t:'🎞️ Diaporama interminable (30 s)',dis:u.slide||!!MX.slide,f:function(){u.slide=1;MX.slide={t:0,dur:30,n:6};scrMode('slide');toast('🎞️ Diaporama lancé : les employés ne progressent plus pendant 30 s. Résultats +4 à la fin.');}},
   {t:'🧱 Mise au coin (30 s)',dis:u.corner||!!MX.corner,f:function(){pickEmp('🧱 Mise au coin',function(e){u.corner=1;e.corner=1;e.noF=30;empS(e);e.sw=Math.max(0,e.sw-3);RESULT=Math.min(100,RESULT+2);const d=dbl(e);if(d){d.userData.busy=true;standOne(d);MX.corner={d:d,ph:'go',s:30};}toast('🧱 '+e.name+' se lève et file au coin 30 s, face au mur. Bosseur −3, Résultats +2.');sayM(e,'Je suis en CM2 ou quoi ?');});}},
   {t:'💺 Siège éjectable',dis:u.seat||!!MX.seat,f:function(){pickEmp('💺 Siège éjectable',function(e){u.seat=1;empS(e);e.im=Math.max(0,e.im-6);e.sw=Math.max(0,e.sw-3);RESULT=Math.min(100,RESULT+1);const d=dbl(e);if(d){d.userData.busy=true;MX.seat={d:d,ch:d.userData.seat,t:0,hit:0};}toast('💺 Le siège de '+e.name+' s\'éjecte ! Sérieux −6, bosseur −3.');});}},
   {t:'🗳️ Sondage truqué',dis:u.poll,f:function(){dlg('🗳️ Sondage truqué','Choisis la question : le résultat sera très largement « OUI », forcément. Mais 1 fois sur 4, les employés comprennent que c\'est truqué.',[
     {t:'Supprimer la pause café ?',f:function(){pollGo('Supprimer la pause café ?',4,function(){EMP.forEach(function(e){empS(e);e.sw=Math.max(0,e.sw-3);});});}},
     {t:'Heures supplémentaires gratuites ?',f:function(){pollGo('Heures sup gratuites ?',6,function(){EMP.forEach(function(e){empS(e);e.sw=Math.min(100,e.sw+2);e.im=Math.max(0,e.im-2);});});}},
     {t:'Une prime pour tous ? (8 pièces)',dis:coins<8,f:function(){coins-=8;pollGo('Une prime pour tous ?',3,function(){EMP.forEach(function(e){empS(e);e.sw=Math.min(100,e.sw+3);});});}},
     {t:'Retour',f:function(){openMeetMenu();}}]);}},
   {t:'🎁 Cadeau empoisonné',dis:u.gift||!!MX.gift,f:function(){pickEmp('🎁 Cadeau empoisonné',function(e){u.gift=1;e.chore={k:'serp',t:25};endFault(e);e.noF=40;RESULT=Math.min(100,RESULT+2);const d=dbl(e);if(d){d.userData.busy=true;const b=giftBox();b.visible=true;b.position.set(pp.x,1.4,pp.z);b.userData.lid.position.y=.46;b.userData.lid.rotation.z=0;MX.gift={d:d,t:0,fx:pp.x,fz:pp.z,said:0,said2:0};}toast('🎁 '+e.name+' reçoit une « prime »… avec une corvée cachée (serpillère). Il a 25 s, sinon blâme.');});}},
   {t:'Fermer',f:function(){}}];
  dlg('📋 Animer la réunion','Chaque animation ne sert qu\'une fois par réunion. Pense à clore vite : le magasin doit tourner !',B);}
function pollGo(q,d,fn){MX.used.poll=1;const r=80+((Math.random()*19)|0);scrMode('poll',{q:q,r:r});fn();RESULT=Math.min(100,RESULT+d);
  if(Math.random()<.25){RESULT=Math.max(0,RESULT-6);toast('🗳️ « OUI » à '+r+' % : les employés ont compris que c\'était truqué ! Résultats −6.');}else toast('🗳️ « OUI » à '+r+' % : sondage passé comme une lettre à la poste. Résultats +'+d+'.');}
function mxTick(dt){if(!MEET.on)return;hostTick(dt);scrDraw(false);salTick(dt);
  if(MX.clap>0){MX.clap-=dt;MEETCH.forEach(function(d){if(d.userData.busy)return;const a=d.userData.arms,v=MX.clap>0?-1.25+Math.sin(clk*20+d.position.x)*.3:-.85;a[0].rotation.x=v;a[1].rotation.x=v;});}
  if(MX.eom){const o=MX.eom,d=o.d;if(o.ph==='go'){if(walkTo(d,25.8+8,-62.4,dt)){o.ph='show';d.rotation.y=0;standOne(d);d.userData.arms[1].rotation.x=-2.8;const tr=trophy();tr.visible=true;tr.position.set(d.position.x+.42,2.15,d.position.z+.1);}}else if(o.ph==='show')d.position.y=Math.abs(Math.sin(clk*6))*.12*(MX.clap>0?1:0);}
  if(MX.gift){const g=MX.gift,d=g.d,b=giftBox(),s=d.userData.seat,tz=s.sd?-55.1:-56.9,tx=s.x;g.t+=dt;const t=g.t;
    if(t<1){const p=t;b.position.set(g.fx+(tx-g.fx)*p,1.4+(.98-1.4)*p+Math.sin(p*Math.PI)*1.6,g.fz+(tz-g.fz)*p);b.rotation.y=p*9;}
    else if(t<2.6){b.position.set(tx,.98,tz);b.rotation.y=0;if(!g.said){g.said=1;say(d,'🎁 Pour moi ?!');}const q=t-1;b.userData.lid.position.y=.46+Math.min(1.2,q*1.6);b.userData.lid.rotation.z=Math.min(1.2,q*1.2);d.userData.arms[0].rotation.x=-2.7;d.userData.arms[1].rotation.x=-2.7;d.position.y=-.08+Math.abs(Math.sin(t*10))*.1;}
    else if(t<6){if(!g.said2){g.said2=1;say(d,'🧹 Une serpillère…');}b.userData.lid.position.y=1.66;d.userData.arms[0].rotation.x=-.2;d.userData.arms[1].rotation.x=-.2;d.userData.m.rotation.x=.25;d.position.y=-.08;}
    else{b.visible=false;MX.gift=null;sitOne(d);d.userData.busy=false;}}
  if(MX.seat){const s=MX.seat,d=s.d,c=s.ch,sg=c.sd?1:-1,t=(s.t+=dt),hz=c.z+(c.sd?.1:-.1),A=d.userData.arms;
    if(t<.7){const w=Math.sin(t*70)*.05;c.g.position.x=c.hx+w;d.position.x=c.hx+w;if(!s.said){s.said=1;say(d,'Hé… c\'est quoi ce bouton ?');}}
    else if(t<1.6){const p=(t-.7)/.9,h=Math.sin(p*Math.PI/2)*3.4;d.position.y=-.08+h;d.position.z=hz+sg*p*1.6;d.rotation.x=sg*p*2.2;A[0].rotation.x=-2.6+Math.sin(t*30)*.7;A[1].rotation.x=-2.6-Math.sin(t*30)*.7;c.g.position.y=h;c.g.position.z=c.hz+sg*p*1.1;c.g.rotation.y+=dt*16;}
    else if(t<2.5){const p=(t-1.6)/.9,h=3.4*(1-p*p);d.position.y=-.08+h;d.position.z=hz+sg*(1.6+p*1.4);d.rotation.x=sg*(2.2-p*.6);c.g.position.y=h;c.g.position.z=c.hz+sg*(1.1+p*1.6);c.g.rotation.y+=dt*10;}
    else if(!s.hit){s.hit=1;d.position.y=.22;d.position.z=hz+sg*3;d.rotation.x=sg*1.55;A[0].rotation.x=-1.2;A[1].rotation.x=-1.2;c.g.position.y=.4;c.g.position.z=c.hz+sg*2.7;c.g.rotation.y=0;c.g.rotation.z=1.4;say(d,'AÏE !');}
    else if(t>6.5){c.g.position.set(c.hx,0,c.hz);c.g.rotation.z=0;c.g.rotation.y=0;sitOne(d);d.userData.busy=false;MX.seat=null;}}
  if(MX.slide){MX.slide.t+=dt;if(MX.slide.t>=MX.slide.dur){MX.slide=null;RESULT=Math.min(100,RESULT+4);scrMode('res');toast('🎞️ Fin du diaporama. Résultats +4.');}}
  if(MX.corner){const c=MX.corner,d=c.d;if(c.ph==='go'){if(walkTo(d,18,-63.4,dt)){c.ph='stay';d.rotation.y=Math.PI;standOne(d);}}else if(c.ph==='stay'){c.s-=dt;if(c.s<=0)c.ph='back';}else if(c.ph==='back'){const sx=d.userData.seat;if(walkTo(d,sx.x,sx.z+(sx.sd?.9:-.9),dt)){sitOne(d);d.userData.busy=false;MX.corner=null;EMP.forEach(function(e){e.corner=0;});toast('Fin de la mise au coin.');}}}
}
let SHB=null;const MOOD={t:0,img:0,k:'bad'},SHAME=[],AUTH={day:-9,ca:1,co:2,ho:2,an:2,re:1},PLOT={day:-9};
function moodOn(k){return MOOD.t>0&&MOOD.k===k&&rank===0;}
let ITW=0;function addW(n){if(VIGI||ITW)return;if(n>0&&WH&&WH.t>0)WH.n++;if(n>0&&moodOn('bad'))return;if(n>0&&rank===0){WKP+=n;addPSW(n);cseTask();}if(rank===0&&!SEC){if(n>0&&clk-WKCD>=6){WKCD=clk;const bs=lvBase(LT.e.b,false);if(SB>bs)SB=Math.max(bs,SB-1);}return;}SW+=balPts(n,'w')*(n>0&&moodOn('good')?2:1);}function unseenNow(){return SEENT<=0&&!seenList.some(function(w){return w.k==='mgr'||w.k==='guard'||w.k==='dir'||w.k==='cam';});}
function addB(n){if(VIGI)return;if(n>0&&moodOn('bad'))return;SB+=balPts(n,'b');if(n>0&&rank===0&&!SEC)addPS(n);if(n>0&&rank===0&&!SEC&&CONN>0&&!NOCOIN&&mode==='zone'&&unseenNow())coins+=n<=5?1:(n<=15?2:3);}

/* ---------- recherche de chemin (grille + BFS) ---------- */
function grid(zn){if(zn.gr)return zn.gr;const c=.35,b=zn.bounds,w=Math.ceil((b.x[1]-b.x[0])/c),h=Math.ceil((b.z[1]-b.z[0])/c),bl=new Uint8Array(w*h);
  for(let j=0;j<h;j++)for(let i=0;i<w;i++)bl[j*w+i]=hit(b.x[0]+(i+.5)*c,b.z[0]+(j+.5)*c,.33,zn)?1:0;
  return (zn.gr={c:c,w:w,h:h,bl:bl,ox:b.x[0],oz:b.z[0]});}
function clearLine(zn,x1,z1,x2,z2){const n=Math.ceil(Math.hypot(x2-x1,z2-z1)/.3);for(let i=1;i<n;i++){const t=i/n;if(hit(x1+(x2-x1)*t,z1+(z2-z1)*t,.3,zn))return false;}return true;}
function path(zn,x1,z1,x2,z2){
  if(clearLine(zn,x1,z1,x2,z2))return [[x2,z2]];
  const G=grid(zn);
  function cell(x,z){return [clamp(Math.floor((x-G.ox)/G.c),0,G.w-1),clamp(Math.floor((z-G.oz)/G.c),0,G.h-1)];}
  function free(c){if(!G.bl[c[1]*G.w+c[0]])return c;for(let r=1;r<8;r++)for(let dj=-r;dj<=r;dj++)for(let di=-r;di<=r;di++){const i=c[0]+di,j=c[1]+dj;if(i<0||j<0||i>=G.w||j>=G.h)continue;if(!G.bl[j*G.w+i])return [i,j];}return c;}
  const s=free(cell(x1,z1)),e=free(cell(x2,z2)),W=G.w,N=W*G.h,prev=new Int32Array(N).fill(-2),q=[s[1]*W+s[0]];prev[q[0]]=-1;const goal=e[1]*W+e[0];
  for(let h=0;h<q.length&&prev[goal]===-2;h++){const cI=q[h],ci=cI%W,cj=(cI-ci)/W;
    for(let dj=-1;dj<=1;dj++)for(let di=-1;di<=1;di++){if(!di&&!dj)continue;const i=ci+di,j=cj+dj;if(i<0||j<0||i>=W||j>=G.h)continue;const k=j*W+i;if(prev[k]!==-2||G.bl[k])continue;
      if(di&&dj&&(G.bl[cj*W+i]||G.bl[j*W+ci]))continue;prev[k]=cI;q.push(k);}}
  if(prev[goal]===-2)return [[x2,z2]];
  const cells=[];for(let k=goal;k!==-1;k=prev[k])cells.push(k);cells.reverse();
  const pts=cells.map(function(k){const i=k%W,j=(k-i)/W;return [G.ox+(i+.5)*G.c,G.oz+(j+.5)*G.c];});
  const out=[];let a=[x1,z1],idx=0;
  while(idx<pts.length){let far=idx;for(let j=pts.length-1;j>idx;j--){if(clearLine(zn,a[0],a[1],pts[j][0],pts[j][1])){far=j;break;}}out.push(pts[far]);a=pts[far];idx=far+1;}
  out.push([x2,z2]);return out;}
function follow(o,dt,spd){
  if(!o.path||o.pi>=o.path.length)return true;
  const w=o.path[o.pi],dx=w[0]-o.x,dz=w[1]-o.z,d=Math.hypot(dx,dz);
  if(d<.15){o.pi++;return o.pi>=o.path.length;}
  {const st=Math.min(d,spd*dt);o.x+=dx/d*st;o.z+=dz/d*st;}o.hd=Math.atan2(dx,dz);o.ph=(o.ph||0)+dt*6;return false;}

/* ---------- managers ---------- */
function mkTag(){const cv=document.createElement('canvas');cv.width=256;cv.height=72;const tx=ctex(cv);const sp=new T.Sprite(new T.SpriteMaterial({map:tx,transparent:true,toneMapped:false,depthTest:false}));sp.scale.set(2.4,.675,1);sp.position.set(0,3.2,0);return {cv:cv,tx:tx,sp:sp};}
/* petites missions de branleur dans les rayons (frais / epicerie / bazar) */
(function(){
  const cand=[];for(let x=-26;x<=44;x+=1.5)for(let z=-15;z<=16;z+=1.5){if(hit(x,z,1,S))continue;if(S.markers.some(function(m){return Math.hypot(m.x-x,m.z-z)<3.4;}))continue;
    if([[30.45,18.3],[40.6,16.5],[-27.5,17.4],[-27.5,-16.6],[-27.6,-8.3],[-27.6,8.6]].some(function(q){return Math.hypot(q[0]-x,q[1]-z)<3.5;}))continue;cand.push([x,z]);}
  for(let i=cand.length-1;i>0;i--){const j=(rnd()*(i+1))|0,t=cand[i];cand[i]=cand[j];cand[j]=t;}
  const REG=[{f:function(x){return x<-8;},t:['dates','retourner','ouvrir','poser','chariot'],n:6},{f:function(x){return x>=-8&&x<24;},t:['facing','prix','poser','gouter','chariot','facing','prix'],n:8},{f:function(x){return x>=24;},t:['piles','jouets','poser','chariot','piles','jouets'],n:6}];
  const placed=[];
  REG.forEach(function(r){let k=0;for(let i=0;i<cand.length&&k<r.n;i++){const c=cand[i];if(!r.f(c[0]))continue;if(placed.some(function(q){return Math.hypot(q[0]-c[0],q[1]-c[1])<5.5;}))continue;marker(S,r.t[k%r.t.length],c[0],c[1]);placed.push(c);k++;}});
})();
function drawTag(tg,name,pct){const x=tg.cv.getContext('2d'),W0=256,h=72;x.clearRect(0,0,W0,h);x.font='600 23px Fredoka,system-ui,sans-serif';const fw=Math.min(W0,Math.max(120,Math.ceil(x.measureText(name).width+40))),ox=(W0-fw)/2,w=fw;x.save();x.translate(ox,0);x.fillStyle='rgba(95,22,34,.95)';rr(x,2,2,w-4,h-4,14);x.fill();x.strokeStyle='#f5b82e';x.lineWidth=3;rr(x,3,3,w-6,h-6,13);x.stroke();
  x.fillStyle='#fff';x.font='600 23px Fredoka,system-ui,sans-serif';x.textAlign='center';x.textBaseline='middle';x.fillText(name,w/2,24);
  x.fillStyle='rgba(255,255,255,.2)';rr(x,16,46,w-32,12,6);x.fill();
  x.fillStyle=pct>50?'#3cc47c':pct>25?'#f5b82e':'#e5484d';rr(x,16,46,Math.max(14,(w-32)*pct/100),12,6);x.fill();x.restore();tg.tx.needsUpdate=true;}
const NAMES=['Julien','Nathalie','Kalvin','Celine'];
const MGR=[
  {name:'Nicolas',zn:'store',look:{shirt:0x7a2e2e,pants:0x2b2f36,hair:0x555555,glasses:1,badge:1},route:[[-14,12.6],[-14,-11.4],[-14,-.4]],next:75},
  {name:'Sylvie',zn:'store',look:{shirt:0x5b2a86,pants:0x2b2f36,hair:0x1b1b1b,bun:1,badge:1},route:[[14,12.6],[14,-11.4],[14,-.4]],next:35},
  {name:'Patrick',zn:'store',look:{shirt:0x1d5f7a,pants:0x2b2f36,hair:0x8d5524,badge:1},route:[[0,-11.4],[0,12.6],[0,-.4]],next:55},
  {name:'Valérie',zn:'store',look:{shirt:0x2a7a4f,pants:0x2b2f36,hair:0xb5651d,bun:1,glasses:1,badge:1},route:[[32,12.6],[32,-13.2],[39,-13.2],[32,-13.2],[32,-6.5],[39,-6.5],[32,-6.5],[32,.5],[39,.5],[32,.5]],next:95},
  {name:'Habib',zn:'store',look:{shirt:0x8a5a2b,pants:0x2b2f36,hair:0x222222,glasses:1,badge:1},route:[[20,12.6],[20,-.4],[8,-.4],[8,12.6]],next:65},
  {name:'Danielle',zn:'store',look:{shirt:0x9d3b6a,pants:0x2b2f36,hair:0x6b3a2a,bun:1,badge:1},route:[[-20,12.6],[-8,12.6],[-8,-11.4],[-20,-11.4]],next:85},
  {name:'Julien',zn:'reserve',look:{shirt:0x3b5b7a,pants:0x2b2f36,hair:0x777777,badge:1},route:[[8,-27.4],[-2,-27.4],[-2,-34],[8,-33]],next:45},
  {name:'Nathalie',zn:'office',look:{shirt:0x7a3b3b,pants:0x2b2f36,hair:0xc9a227,bun:1,glasses:1,badge:1},route:[[22,-28],[23,-38],[40,-38],[40,-28],[51.6,-27.6],[51.6,-38.4]],next:70},
  {name:'Kalvin',zn:'parking',look:{shirt:0x2b6f7a,pants:0x2b2f36,hair:0x1b1b1b,badge:1},route:[[-22,33],[8,33],[8,43],[-22,43]],next:60,tour:1},
  {name:'Celine',zn:'office',look:{shirt:0x6b2b6f,pants:0x2b2f36,hair:0x4a2c1a,bun:1,glasses:1,badge:1},route:[[20,-32],[36,-32],[41,-33.5],[55,-33.5],[64.4,-34],[64.4,-37.2,1],[64.4,-34],[55,-33.5],[41,-33.5],[36,-32]],next:80,tour:1}];
const SPOTS={reserve:[[-10.2,-30.4],[-10.4,-29.1],[-10.1,-27.8],[-10.6,-26.7]],pause:[[-36.3,-40.6],[-34.6,-41.1],[-33.2,-40.4],[-36,-38.4]]};
function drawM(m){[m.tg,m.ts,m.tp,m.ti].forEach(function(t){drawTag(t,m.pn||m.name,m.stand);});}
MGR.forEach(function(m){if(m.tour===1){const r0=m.route;m.tour=m.name==='Kalvin'?[{zn:'parking',route:r0},{zn:'location',route:LOCR},{zn:'parking',route:r0},{zn:'electro',route:ELER},{zn:'parking',route:r0},{zn:'drive',route:DRVR}]:[{zn:'office',route:r0},{zn:'reserve',route:[[8,-27.4],[-2,-27.4],[-2,-34],[8,-33]]}];m.tk=0;}});
function mgrHop(m){m.tk=((m.tk||0)+1)%m.tour.length;const T2=m.tour[m.tk];try{Z[m.zn].g.remove(m.g);Z[m.zn].g.remove(m.cone.grp);}catch(_){}m.zn=T2.zn;m.route=T2.route;Z[m.zn].g.add(m.g);Z[m.zn].g.add(m.cone.grp);m.x=T2.route[0][0];m.z=T2.route[0][1];m.ri=0;m.path=null;m.pi=0;m.lp=0;m.g.position.set(m.x,0,m.z);}
MGR.forEach(function(m,k){m.look.tie=m.look.shirt;m.look.shirt=0xf1f1f4;m.look.trim=0x2b2f36;m.g=makeChar(m.look);Z[m.zn].g.add(m.g);
  m.gs=makeChar(m.look);R.g.add(m.gs);m.gp=makeChar(m.look);PZG.add(m.gp);m.gi=makeChar(m.look);PZG.add(m.gi);
  m.tg=mkTag();m.g.add(m.tg.sp);m.ts=mkTag();m.gs.add(m.ts.sp);m.tp=mkTag();m.gp.add(m.tp.sp);m.ti=mkTag();m.gi.add(m.ti.sp);
  m.gs.visible=m.gp.visible=m.gi.visible=false;
  m.x=m.route[0][0];m.z=m.route[0][1];m.ri=0;m.path=null;m.pi=0;m.hd=0;m.task=null;m.spot='reserve';m.it=0;
  m.wait=k*1.5;m.state='patrol';m.stand=100;m.fired=false;m.stun=0;m.respawn=0;m.ph=0;m.t=m.next;m.g.position.set(m.x,0,m.z);drawM(m);
  m.cone=mkCone(Z[m.zn].g,6.5,.7,0xffd84a,.16);});
function smokerAt(spot){return MGR.find(function(x){return x.state==='smoke'&&!x.fired&&x.spot===spot;});}
function releaseTask(m){if(m.task){m.task.claimed=null;m.task=null;}m.path=null;}
function backToPatrol(m,t){m.state='patrol';m.t=t;m.x=m.route[0][0];m.z=m.route[0][1];m.ri=0;m.path=null;m.wait=.5;m.stun=0;m.g.position.set(m.x,0,m.z);}
function startSmoke(m){releaseTask(m);m.state='smoke';m.t=24+Math.random()*8;m.spot=Math.random()<.5?'reserve':'pause';if(rank>=1){const o=EMP.filter(function(x){return x.zn===(m.spot==='pause'?'office':'reserve')||true;});pushMsg({from:o[(Math.random()*o.length)|0].name,kind:'m',mg:m,zn:m.spot==='pause'?'office':'reserve',txt:m.name+' fume '+(m.spot==='pause'?'sur la terrasse de la salle de pause':'au local fumeur')+'.',life:24});}
  const sp=SPOTS[m.spot][MGR.indexOf(m)%4],c=m.spot==='reserve'?m.gs:m.gp;c.position.set(sp[0],0,sp[1]);c.rotation.y=m.spot==='reserve'?Math.PI/2:-Math.PI/2;walkAnim(c,0,0);}
function updMgr(m,dt){
  if(mirrorMgr(m,dt))return;
  if(m.fcd>0)m.fcd-=dt;
  if(m.fired){m.g.visible=m.gs.visible=m.gp.visible=m.gi.visible=false;
    if(m.respawn>0){m.respawn-=dt;if(m.respawn<=0){m.name=NAMES[(Math.random()*NAMES.length)|0];m.fired=false;m.stand=100;backToPatrol(m,60);drawM(m);toast(m.name+' arrive : nouveau manager.');}}
    return;}
  if(m.state==='smoke'){m.g.visible=false;m.gi.visible=false;m.gs.visible=m.spot==='reserve';m.gp.visible=m.spot==='pause';m.t-=dt;
    if(m.t<=0)backToPatrol(m,55+Math.random()*25);return;}
  if(m.state==='insp'){inspUpdate(m,dt);return;}
  m.gs.visible=m.gp.visible=m.gi.visible=false;m.g.visible=true;
  if(m.stun>0){m.stun-=dt;m.g.rotation.x=-1.35;m.g.position.set(m.x,.35,m.z);walkAnim(m.g,0,0);return;}
  m.g.rotation.x=0;
  if(!globalThis.__nonpc&&evade(m,dt))return;
  m.t-=dt;if(m.t<=0){startSmoke(m);return;}
  let mv=false;
  if(FIREW&&FIREW.m===m){const d=Math.hypot(m.x-pp.x,m.z-pp.z);m.rpT=(m.rpT||0)-dt;
    if(d<2.1){doFire(m);m.wait=2;m.path=null;}
    else{if(!m.path||m.pi>=m.path.length||m.rpT<=0){m.rpT=.8;m.path=path(Z[cur],m.x,m.z,pp.x,pp.z);m.pi=0;}follow(m,dt,3.1);mv=true;}}
  else if(m.task){const k=m.task;
    if(!m.path||m.pi>=m.path.length){if(!k.arr){k.arr=true;k.w=k.kind==='fridge'?999:3.5;if(k.kind==='fridge')recruit(m,k);say(m.g,k.kind==='mess'?'Quel bazar !':k.kind==='rat'?'Beurk, un rat !':k.kind==='fridge'?'Les frigos sont HS !':'Des produits périmés !');}
      if(k.kind==='fridge'){FR.mA=true;if(FR.n>=FR.need)FR.prog+=dt/10;if(FR.prog>=1)k.w=0;}else k.w-=dt;walkAnim(m.g,0,0);if(k.w<=0)resolveTask(m);}
    else{follow(m,dt,2.7);mv=true;}}
  else if(m.wait>0){m.wait-=dt;walkAnim(m.g,0,0);}
  else{
    if(!m.path||m.pi>=m.path.length){if(m.route[m.ri][2])wcKnock(m);m.ri=(m.ri+1)%m.route.length;if(m.ri===0&&Array.isArray(m.tour)&&m.tour.length&&!globalThis.__notour){m.lp=(m.lp||0)+1;if(m.lp>=2||cur!==m.zn||mode!=='zone')mgrHop(m);}const w=m.route[m.ri];m.path=path(Z[m.zn],m.x,m.z,w[0],w[1]);m.pi=0;m.wait=.5+Math.random()*1.2;walkAnim(m.g,0,0);}
    else{m.pz=(m.pz||(8+Math.random()*12))-dt;if(m.pz<=0){m.pz=16+Math.random()*20;m.wait=5;}follow(m,dt,1.7);mv=true;}}
  if(mv){m.g.rotation.y=angLerp(m.g.rotation.y,m.hd,1-Math.exp(-dt*7));walkAnim(m.g,m.ph,1);}
  m.g.position.set(m.x,0,m.z);}
function resolveTask(m){const j=m.task;m.task=null;m.path=null;const i=JOBS.indexOf(j);if(i>=0)JOBS.splice(i,1);if(j.mesh)S.g.remove(j.mesh);
  if(j.kind==='fridge'){if(FR.mt>2){coins+=3;addW(6);toast('Tu as aidé à vider les frigos : +3 pièces, +6 bosseur.');}FR.on=false;FRIDGE.visible=false;endFridge();addB(20);toast('Frigos vidés à temps : '+m.name+' garde sa réputation. +20 branleur');}
  else if(j.kind==='mess'){if(j.ms){const q=MESS.indexOf(j.ms);if(q>=0)MESS.splice(q,1);S.g.remove(j.ms.g);}addB(3);toast(m.name+' ramasse le bazar à temps, sans perdre de réputation. +3 branleur');}
  else if(j.kind==='rat'){addB(8);toast(m.name+' a attrapé le rongeur à temps. +8 branleur');}
  else{addB(6);toast(m.name+' jette les produits périmés à temps. +6 branleur');}}
const JOBDMG={rat:7,perime:6,mess:4};
function assignJobs(dt){JOBS.forEach(function(j){j.age=(j.age||0)+(dt||0);
  if(j.kind!=='fridge'&&j.age>=60&&!j.pen){j.pen=true;const q=j.tgt;if(q&&!q.fired){toast('Le problème traîne depuis 1 minute : '+q.name+' (le manager appelé) perd de la réputation !');if(rank===0&&!SEC)addPS(10);hitMgr(q,JOBDMG[j.kind]||6);}}
  if(j.claimed&&j.tgt&&j.claimed===j.tgt&&!j.arr&&j.kind!=='fridge'){let nb=null,nd=Math.hypot(j.tgt.x-j.x,j.tgt.z-j.z)-3;MGR.forEach(function(m){if(m===j.tgt||m.zn!=='store'||m.fired||m.state!=='patrol'||m.task||m.stun>0)return;const d=Math.hypot(m.x-j.x,m.z-j.z);if(d<6&&d<nd){nd=d;nb=m;}});
    if(nb){const o=j.tgt;releaseTask(o);j.claimed=nb;nb.task=j;nb.path=path(S,nb.x,nb.z,j.x,j.z);nb.pi=0;nb.wait=0;toast(nb.name+' passe par là et s\'en occupe à la place de '+o.name+'.');}}
  if(j.claimed||(j.hold&&j.hold>Date.now()))return;let b=null,bd=1e9;
  MGR.forEach(function(m){if(m.zn!=='store'||m.fired||m.state!=='patrol'||m.task||m.stun>0)return;const d=Math.hypot(m.x-j.x,m.z-j.z);if(d<bd){bd=d;b=m;}});
  if(b){if(!j.tgt)j.tgt=b;j.claimed=b;b.task=j;b.path=path(S,b.x,b.z,j.x,j.z);b.pi=0;b.wait=0;}});}
function inspUpdate(m,dt){m.it+=dt;m.g.visible=false;m.gs.visible=m.gp.visible=false;const g=m.gi;g.visible=true;
  const A=[-17.2,-34],B=[-23.8,-31.6];let x,z,mv=true,hd;
  if(m.it<3){const u=m.it/3;x=A[0]+(B[0]-A[0])*u;z=A[1]+(B[1]-A[1])*u;hd=Math.atan2(B[0]-A[0],B[1]-A[1]);}
  else if(m.it<8){x=B[0];z=B[1];mv=false;hd=Math.PI;}
  else if(m.it<11){const u=(m.it-8)/3;x=B[0]+(A[0]-B[0])*u;z=B[1]+(A[1]-B[1])*u;hd=Math.atan2(A[0]-B[0],A[1]-B[1]);}
  else{backToPatrol(m,50+Math.random()*30);return;}
  g.position.set(x,0,z);g.rotation.y=hd;walkAnim(g,m.it*6,mv?1:0);}

/* ---------- carriere ---------- */
function lockOffice(){if(O.obs.indexOf(doorObs)<0)O.obs.push(doorObs);dirDoor.visible=true;DIRM.forEach(function(m){m.off=true;});}
function unlockOffice(){const i=O.obs.indexOf(doorObs);if(i>=0)O.obs.splice(i,1);dirDoor.visible=false;DIRM.forEach(function(m){m.off=false;});}
function resetRank(){rank=0;lockOffice();if(TIE){TIE.parent.remove(TIE);TIE=null;}}
function myRole(){return SEC?'v':rank>=1?'m':'e';}
function netCounts(jl){let M=0,E=0,P=0,V=0;if(!NET.on||!NET.joined)return {M:0,E:0,P:0,V:0,on:false};Object.keys(NET.players).forEach(function(pid){if(pid===NET.pid)return;const p=NET.players[pid];if(!p||!p.lk)return;const r=p.lk.role;const early=(jl===undefined||(typeof p.joined==='number'&&p.joined<jl));if(r==='m'&&early){if(p.lk.pm)P++;else M++;}else if(r==='v'&&early)V++;else if(r==='e')E++;});return {M:M,E:E,P:P,V:V,on:true};}
function mgrSlotOK(jl){const c=netCounts(jl);return !c.on||c.M+c.P<6;}
function mgrNeedE(){return 0;}
const BENCH=[2,3,4,5];

/* ----- Un joueur connecte prend la place du PNJ du meme prenom (ou d'un PNJ libre) ----- */
const PNJX={taken:[],t:0};
function pnjNorm(n){return String(n||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim().split(/[\s\-_.0-9]+/)[0]||'';}
function pnjList(){const L=[];MGR.forEach(function(m){L.push({k:'m',o:m,n:pnjNorm(m.name)});});
  EMP.forEach(function(e){if(!e.wp||!e.name||e.cap)return;L.push({k:'e',o:e,n:pnjNorm(e.name)});});
  GUARDS.forEach(function(g){L.push({k:'v',o:g,n:g.pn?pnjNorm(g.pn):''});});
  EMP.forEach(function(e){if(e.wp||!e.name||e.name!=='Laurent')return;L.push({k:'r',o:e,n:pnjNorm(e.name)});});return L;}
function pnjPlayers(){const P=[];
  if(NET.on&&NET.joined){Object.keys(NET.players).forEach(function(id){const p=NET.players[id];if(!p)return;P.push({id:id,nm:p.nm,role:(p.lk&&p.lk.role)||'e',j:typeof p.joined==='number'?p.joined:1e15});});}
  else if(PNAME&&PNAME!=='Toi')P.push({id:'me',nm:PNAME,role:(typeof LK!=='undefined'&&LK&&LK.role)||'e',j:0});
  P.sort(function(a,b){return a.j-b.j||(a.id<b.id?-1:1);});return P;}
function pnjPlan(){const L=pnjList(),P=pnjPlayers(),taken=[],un=[];
  P.forEach(function(p){const n=pnjNorm(p.nm);const f=n&&L.find(function(x){return x.n===n&&taken.indexOf(x)<0;});if(f)taken.push(f);else un.push(p);});
  un.forEach(function(p){const pref=p.role==='m'?['m','e','v']:p.role==='v'?['v','e','m']:['e','m','v'];
    for(let i=0;i<pref.length;i++){const f=L.find(function(x){return x.k===pref[i]&&taken.indexOf(x)<0&&!(x.k==='m'&&(x.o.dis&&!x.o.pj))&&!x.o.pj_keep;});if(f){taken.push(f);break;}}});
  return taken;}
function pnjOff(x){const o=x.o;if(x.k==='e'){if(!(o.out>=1e8)){o.pj=1;o.out=1e9;o.g.visible=false;if(o.f)try{endFault(o);}catch(_){}}}
  else if(x.k==='m'){if(!o.fired){try{releaseTask(o);}catch(_){}o.fired=true;o.respawn=-1;o.pj=1;o.g.visible=o.gs.visible=o.gp.visible=o.gi.visible=false;}}
  else if(x.k==='v'){if(!o.pj){o.pj=1;o.stun=1e9;o.g.visible=false;}}
  else if(x.k==='r'){if(!o.pj){o.pj=1;o.out=1e9;o.g.visible=false;}}}
function pnjOn(x){const o=x.o;if(!o.pj)return;o.pj=0;
  if(x.k==='e'||x.k==='r'){o.out=0;o.noF=20;o.g.visible=true;}
  else if(x.k==='m'){o.fired=false;o.stand=100;o.respawn=0;try{backToPatrol(o,60);drawM(o);}catch(_){}}
  else if(x.k==='v'){o.stun=0;o.g.visible=true;}}
function pnjSync(dt){PNJX.t-=dt;if(PNJX.t>0)return;PNJX.t=1;
  const nw=pnjPlan();PNJX.taken.forEach(function(x){if(nw.indexOf(x)<0)pnjOn(x);});
  nw.forEach(function(x){pnjOff(x);});PNJX.taken=nw;}
function mgrBench(){if(globalThis.__nobench)return;BENCH.forEach(function(i){const m=MGR[i];if(!m)return;m.fired=true;m.respawn=-1;m.dis=true;m.g.visible=m.gs.visible=m.gp.visible=m.gi.visible=false;});}
function spawnEmp(name,wp,hair,xo){const ch=makeChar(Object.assign({shirt:0x2f6fd0,pants:0x2b2f36,hair:hair||0x3a2a1a,badge:1},xo||{}));S.g.add(ch);empTag(ch,name);const e={g:ch,wp:wp,i:1,wait:0,x:wp[0][0],z:wp[0][1],ph:0,name:name,cd:0,zn:'store',prog:0,path:null,pi:0,hd:0};ch.position.set(e.x,0,e.z);NPC.push(e);EMP.push(e);
 e.f=null;e.conf=0;e.warn=0;e.bl=0;e.nf=8+Math.random()*50;e.flag=0;e.spy=0;e.noF=0;e.cvcd=0;e.press=0;e.sayP=0;e.lastF=-999;e.out=0;e.blAge=0;return e;}
const SWAPR=[[[-24,-.4],[-2,-.4]],[[22,-11.4],[32,-11.4]],[[10,12.6],[34,12.6]],[[-10,-11.4],[4,-11.4]],[[14,-.4],[30,-.4]]];let SWAPI=0;
(function(){[['Eric',[[-16,-11.4],[-16,12.6]],0x2a2a2a,{}],['Fatia',[[-3,-11.4],[-3,12.6]],0x8d3b2a,{hs:'long',fem:1}],['Charlene',[[6,12.6],[6,-11.4]],0xc79a4a,{beard:1,bc:0x8a5a2b}],['Laura',[[-12,-.4],[16,-.4]],0x5a3825,{}],['Océane',[[-24,12.6],[0,12.6]],0xf2c96b,{hs:'long',fem:1}],].forEach(function(d,k){const e=spawnEmp(d[0],d[1],d[2],d[3]);e.wait=k*.9;e.ph=k*2;e.xtra=1;});})();
[['Pascale',[[-22,-.4],[-6,-.4]],0x6b3a2a,{hs:'long',fem:1}],['Steve',[[24,-.4],[34,-.4]],0xb08968,{}],].forEach(function(d,k){const e=spawnEmp(d[0],d[1],d[2],d[3]);e.wait=k*1.1;e.ph=k*1.7;e.xtra=1;});
/* v230 : accueil avec 2 hotesses qui tournent + micro (coin branleur) */
const HOSTS=[];
(function(){const g=S.g;
  cyl(g,.05,.05,.5,0x2b2f36,22.4,1.37,14.6,false);cyl(g,.16,.16,.04,0x2b2f36,22.4,1.14,14.6,false);sph(g,.09,0x1b2430,22.4,1.66,14.6,1,1.2,1);
  box(g,.5,.12,.22,0x2b2f36,24.4,1.2,14.7,false);
  marker(S,'micro',23.4,12.7,'Micro de l\'accueil');
  const LOOP=[[19.4,16.9],[22.8,16.7],[24.5,16.3],[20.2,16.0],[19.7,13.3],[24.2,13.3],[20.4,13.3],[19.5,15.8]];
  [['Clara',LOOP,0xc79a4a,0],['Manon',LOOP.slice(4).concat(LOOP.slice(0,4)),0x3a2a1a,3]].forEach(function(d){
    const e=spawnEmp(d[0],d[1].map(function(q){return q.slice();}),d[2],{hs:'long',fem:1,shirt:0x2a9d8f,pants:0x1f3a52});
    e.hos=1;e.i=d[3];e.x=d[1][0][0];e.z=d[1][0][1];e.g.position.set(e.x,0,e.z);HOSTS.push(e);});
})();
function mgrToEmp(m){const nm=m.name;if(EMP.some(function(e){return e.name===nm;}))return;const wp=SWAPR[(SWAPI++)%SWAPR.length];const e=spawnEmp(nm,wp.map(function(q){return q.slice();}),0x555555);toast('🔄 '+nm+' redevient employé.');return e;}
function pickMgr(title,why,zones,onPick,opt){const btns=[];
  MGR.forEach(function(m){if(m.fired||zones.indexOf(m.zn)<0)return;const ok=m.zn!=='store'||(m.state==='patrol'&&!m.task&&m.stun<=0);
    btns.push({t:(ok?'Appeler ':'(occupé) ')+m.name+' • réputation '+Math.round(m.stand)+' %',dis:!ok,f:function(){if(m.fired||(m.zn==='store'&&(m.task||m.state!=='patrol'))){toast(m.name+' n\'est plus disponible.');return;}onPick(m);}});});
  if(!btns.length)return false;
  btns.push({t:opt?'Personne : je laisse comme ça':'Laisser le hasard choisir',f:function(){onPick(null);}});
  dlg(title,why+' Quel manager appeler ? Celui qui s\'en occupe perd de la réputation.',btns);return true;}
function callJob(j,why,opt){if(rank!==0||CREATING)return false;if(!opt)j.hold=Date.now()+25000;
  const shown=pickMgr('📞 Appeler un manager',why,['store'],function(m){j.hold=0;if(!m){if(opt)return;const E=MGR.filter(function(x){return !x.fired&&x.zn==='store'&&x.state==='patrol'&&!x.task&&x.stun<=0;});if(!E.length)return;m=E[(Math.random()*E.length)|0];toast('Le hasard désigne '+m.name+'.');}if(opt)JOBS.push(j);if(j.claimed)return;j.tgt=m;j.claimed=m;m.task=j;m.path=path(S,m.x,m.z,j.x,j.z);m.pi=0;m.wait=0;toast('Tu appelles '+m.name+' : il arrive.');},opt);
  if(!shown)j.hold=0;return shown;}
let PRO_OLD=false;function succPick(){if(!PRO_OLD)return null;const L=[];if(rank===0&&!CREATING&&LVL>=2)L.push({me:1,lv:Math.max(LVL,LVM),im:SB,j:0});
  if(NET.on&&NET.joined)Object.keys(NET.players).forEach(function(pid){if(pid===NET.pid)return;const p=NET.players[pid];if(p&&p.lk&&p.lk.role==='e'&&(p.lv||1)>=2)L.push({pid:pid,nm:p.nm||'Un joueur',lv:p.lv||1,im:(p.sb||0),j:p.joined||0});});
  L.sort(function(a,b){return b.im-a.im||a.j-b.j;});return L[0]||null;}
function mgrLeft(nm){const w=succPick();if(!w)return;if(w.me){if(mgrSlotOK())promote(nm,' a quitté la partie');else toast(nm+' a quitté la partie, mais il y a déjà 3 managers joueurs (maximum).');}else toast(w.nm+' (niveau '+w.lv+') prend le poste de '+nm+'.');}
function netWatchM(){if(!NET.on||!NET.joined){NET.mprev={};return;}const cu={};Object.keys(NET.players).forEach(function(pid){const p=NET.players[pid];if(pid!==NET.pid&&p&&p.lk&&p.lk.role==='m')cu[pid]=p.nm||'Un manager';});
  const pv=NET.mprev||{};Object.keys(pv).forEach(function(pid){if(!cu[pid]&&!NET.players[pid])mgrLeft(pv[pid]);});NET.mprev=cu;}
function promote(n,how){saveGame();mobClear();PRO.gr=Date.now()+PRO.grace*1000;PRO.psc=0;PRO.pn=0;PRO.pw=0;PRO.lr=0;PRO.im=0;PRO.iw=0;PRO.sl=proSlot();proSave();SEC=false;chRole('m',1);rank=1;SB=lvBase(LT.m.b,true);SW=lvBase(LT.m.w,true);mgrReset();renderQI();image=Math.max(image,50);unlockOffice();TIE=box(pl.userData.m,.12,.46,.03,0xd62839,0,1.02,.22,false);toast(n+(how||' est viré')+' et TU ES PROMU MANAGER ! Niveau manager '+LVM+', tes points repartent à 0. Le bureau de la directrice est ouvert.');}
function repAdj(m,dmg,by){if(by==='dir')return dmg;by=by||'me';dmg*=.5;m.hl=(m.hl||[]).filter(function(h){return clk-h.t<90;});const rep=m.hl.filter(function(h){return h.by===by&&clk-h.t<60;}).length;dmg*=Math.pow(.75,Math.min(4,rep));const who={};m.hl.forEach(function(h){who[h.by]=1;});who[by]=1;if(Object.keys(who).length>=3)dmg*=1.5;m.hl.push({t:clk,by:by});return dmg;}
function hitMgr(m,dmg,by){if(m.fired||m.imm>0)return;if(m.pn&&(by===undefined||by==='me')){try{sRpc('edm_hit_mgr',{p_name:m.pn,p_dmg:Math.round(dmg)});}catch(_){}}if(netNpcLive()){try{netSbBroadcast('mh',{from:NET.pid,i:MGR.indexOf(m),dmg:dmg});}catch(_){}}dmg=repAdj(m,dmg,by);if((by===undefined||by==='me')&&rank===0&&!VIGI)addPS(Math.round(dmg*PRO_CC),1);m.stand=Math.max(m.pn?1:0,m.stand-dmg);drawM(m);if(m.stand<=0)fireMgr(m);}
function fireMgr(m){releaseTask(m);m.fired=true;m._lf=clk;m.g.visible=m.gs.visible=m.gp.visible=m.gi.visible=false;
  const sw=succPick();
  if(sw&&!sw.me){m.respawn=-1;mgrToEmp(m);toast(m.name+' est viré : '+sw.nm+' (niveau '+sw.lv+') prend le poste.');}
  else if(sw&&mgrSlotOK()){m.respawn=-1;mgrToEmp(m);promote(m.name);}
  else if(sw){m.respawn=25;toast(m.name+' est viré, mais il y a déjà 3 managers joueurs (maximum) : le poste revient à un PNJ. Tu restes employé.');}
  else{m.respawn=25;toast(m.name+' est viré ! Un nouveau manager PNJ arrive dans 25 s.'+(rank===0?' Les postes de manager se gagnent au tirage de promotion.':''));}}
let BR=null,CANDON=false,CANDCD=0;
function candList(){if(!PRO_OLD)return [];return MGR.filter(function(m){return !m.fired&&m.stand<=25;});}
function candUpdate(dt){CANDCD=Math.max(0,CANDCD-dt);const on=rank===0&&!CREATING;
  if(on){if(O.obs.indexOf(doorObs)>=0){const i=O.obs.indexOf(doorObs);O.obs.splice(i,1);dirDoor.visible=false;}
    if(!CANDON){CANDON=true;if(candList().length){pop('🚪 Un manager est sur la sellette : la porte de la directrice est ouverte aux candidatures !','warn');toast('Un manager est sur le point d\'être viré : va poser ta candidature dans le bureau de la directrice !');}}}
  else if(CANDON){CANDON=false;if(rank===0){lockOffice();if(cur==='office'&&pp.x>29.2&&pp.x<38&&pp.z<-34){pp.z=-32.6;pp.x=33.8;}}}
  if(CANDM)CANDM.off=!on||rank!==0;}
function dlg(title,text,btns){text=noSW(text);try{const bb0=$('bribeB');bb0.style.display='';bb0.style.gridTemplateColumns='';}catch(_){}$('bribe').querySelector('.mhead span').textContent=title;$('bribeT').textContent=text;const b=$('bribeB');b.innerHTML='';
  btns.forEach(function(o){const k=document.createElement('button');k.className='abtn';k.textContent=o.t;k.disabled=!!o.dis;k.onclick=function(){closeDlg();if(o.f)o.f();};b.appendChild(k);});uiOpen=true;$('bribe').hidden=false;}
function closeDlg(){$('bribe').hidden=true;uiOpen=!!(MG||PAN||PHN);}
function openCand(){const L=candList();
  if(CANDCD>0){toast('La directrice t\'a déjà reçu : reviens dans '+Math.ceil(CANDCD)+' s.');return;}
  const btns=[];
  MGR.filter(function(m){return !m.fired;}).sort(function(a,b){return a.stand-b.stand;}).slice(0,4).forEach(function(m){const p=Math.max(.15,Math.min(.75,.2+image*.004+(100-m.stand)*.004));
    btns.push({t:'Balancer '+m.name+' (réputation '+Math.round(m.stand)+' %) ≈ '+Math.round(p*100)+' %, risque de blâme',f:function(){balanceGo(m,p);}});});
  L.forEach(function(m){const k=Math.max(0,25-m.stand)/100,p1=Math.min(.6,.25+image*.003+k),p2=Math.min(.6,.4+k);
    btns.push({t:'Candidater à la place de '+m.name+' (≈ '+Math.round(p1*100)+' %)',f:function(){candGo(m,p1,false);}});
    btns.push({t:'Mentir pour achever '+m.name+' (≈ '+Math.round(p2*100)+' %, risque de blâme)',f:function(){candGo(m,p2,true);}});});
  if(REV&&REV.n>=3&&image>=REV_IMG){const pr=Math.min(.8,.4+image*.004);btns.push({t:'Plaider pour reprendre ton poste (≈ '+Math.round(pr*100)+' %)',f:function(){revGo(pr);}});}
  btns.push({t:'Annuler'});
  dlg('🏢 Bureau de la directrice','« Qu\'est-ce que vous voulez ? » Tu peux balancer un manager (il perd de la réputation si elle te croit, sinon c\'est toi qui prends un blâme)'+(L.length?' ou candidater : un manager est au bord du licenciement.':'.')+' Sérieux actuelle : '+Math.round(image)+'.',btns);}
function revGo(p){CANDCD=30;if(!REV)return;const L=MGR.filter(function(x){return !x.fired;}).sort(function(a,b){return a.stand-b.stand;});
  if(Math.random()<p&&L.length&&mgrSlotOK()){const m=L[0],back=Math.floor(REV.lost/4);REV=null;m.stand=0;drawM(m);releaseTask(m);m.fired=true;m.g.visible=m.gs.visible=m.gp.visible=m.gi.visible=false;m.respawn=-1;promote(m.name,' te cède son poste');coins+=back;pop('🎉 La directrice te rend ton poste ! +'+back+' pièces','good');}
  else{REV=null;say(dirc,'Non, vous avez déjà eu votre chance.');pop('❌ La directrice refuse : tu restes employé.','bad');}}
function balanceGo(m,p){CANDCD=30;if(m.fired){toast('Trop tard : '+m.name+' est déjà parti.');return;}
  if(Math.random()<p){image=Math.min(100,image+3);coins+=3;addB(3);pop('🗣️ La directrice te croit : '+m.name+' perd 18 de réputation !','good');toast('Tu balances '+m.name+' : +3 pièces, Sérieux +3, +3 branleur.');hitMgr(m,18);}
  else{say(dirc,'Vous racontez n\'importe quoi !');pop('🤥 Dénonciation rejetée : blâme !','bad');giveBlame('tu as balancé '+m.name+' à tort',0);}}
function candGo(m,p,lie){CANDCD=45;
  if(m.fired||m.stand>25){toast('Trop tard : la situation a changé.');return;}
  if(Math.random()<p){m.stand=0;drawM(m);releaseTask(m);m.fired=true;m.g.visible=m.gs.visible=m.gp.visible=m.gi.visible=false;m.respawn=-1;promote(m.name);
    pop(lie?'😈 Ton mensonge a marché : '+m.name+' est viré, tu prends sa place !':'🎉 Candidature acceptée : tu remplaces '+m.name+' !','good');toast(m.name+' redevient simple employé. Tu es maintenant manager.');}
  else if(lie){m.stand=Math.min(100,m.stand+10);drawM(m);say(dirc,'Vous mentez ! Dehors !');pop('🤥 La directrice ne te croit pas : blâme !','bad');giveBlame('tu as menti à la directrice',0);}
  else{pop('❌ Candidature refusée. Reviens plus tard','warn');say(dirc,'Je vais y réfléchir…');}}
function caughtLoot(G,extra){const n=LOOT.length;theftFine(lootVal());LOOT.length=0;say(G.g,extra||'Je t\'ai attrapé, petit saligaud !');pop('🚨 Le vigile t\'a attrapé ! Butin confisqué','bad');if(rank>=1)fireV('un vigile');else giveBlame('le vigile a trouvé du butin sur toi ('+n+' objet'+(n>1?'s':'')+') !',30);}
function startBribe(G){BR={G:G,t:12};G.wait=999;G.fx=0;G.fs=0;uiOpen=true;say(G.g,'Je t\'ai attrapé, petit saligaud !');const b=$('bribeB');
  $('bribeT').textContent='Le vigile a trouvé du butin sur toi : blâme à la clé. Tu peux lui proposer des pièces pour qu\'il te laisse partir (les pièces vont dans sa poche), mais s\'il refuse tu perds 10 pièces et tu prends le blâme quand même. Tu as '+Math.floor(coins)+' pièce'+(coins>=2?'s':'')+'.';
  b.innerHTML='';[[1,'25 %'],[2,'50 %'],[5,'80 %']].forEach(function(o){const k=document.createElement('button');k.className='abtn';k.textContent='Lui donner '+o[0]+' pièce'+(o[0]>1?'s':'')+' (≈ '+o[1]+' de chances)';k.disabled=coins<o[0];k.onclick=function(){resolveBribe(o[0]);};b.appendChild(k);});
  const d=document.createElement('button');d.className='abtn';d.textContent='Accepter le blâme';d.onclick=function(){resolveBribe(0);};b.appendChild(d);$('bribe').hidden=false;}
function resolveBribe(a){if(!BR)return;const G=BR.G;BR=null;$('bribe').hidden=true;uiOpen=!!(MG||PAN||PHN);G.wait=3;
  if(a<=0){caughtLoot(G);return;}
  const pr={1:.25,2:.5,5:.8}[a]||.3;
  if(Math.random()<pr){coins-=a;G.pocket=(G.pocket||0)+a;say(G.g,'Hm… Je n\'ai rien vu. Circulez.');pop('🤫 Le vigile empoche '+a+' pièce'+(a>1?'s':'')+' et te laisse partir','good');toast('Corruption réussie : tu gardes ton butin, le vigile a '+G.pocket+' pièce'+(G.pocket>1?'s':'')+' en poche.');G.cd=40;}
  else{const l=Math.min(Math.floor(coins),10);coins-=l;caughtLoot(G,'Vous essayez de me corrompre ?!');toast('Corruption refusée : tu perds '+l+' pièce'+(l>1?'s':'')+' (elles disparaissent) et tu prends le blâme.');}}
let AQM=null,BLWHY=[],BLTXT='',AQ=0,SAKEYS=[];function giveBlame(why,loss){if(NK>.5)NP.t=0;if(PIMM>0){toast('🛡️ Immunité : le blâme ne t\'atteint pas ('+why+').');return;}if(REV&&rank===0){REV=null;toast('Blâme : mission « Reprendre ton poste » échouée.');}if(rank>=1)RESULT=Math.max(0,RESULT-10);image=Math.max(0,image-(rank===0?30:15));coins=Math.max(0,coins-(loss||0));proLose(20,'Blâme');blAge=0;BLWHY.push(why);if(BLWHY.length>3)BLWHY.shift();
  if(blames>=BLMX()){toast('Blâme de plus : '+why+'. Tu es déjà à '+BLMX()+' : le manager arrive pour te mettre à pied !');if(FIREW)FIREW.t=60;return;}
  blames++;
  if(blames>=BLMX()){FIREW={m:null,rp:0};toast(BLMX()+' blâmes ! Un manager a 1 minute pour venir te mettre à pied. Fais-toi oublier (ou change de zone)…');}
  else toast('Blâme '+blames+'/'+BLMX()+' : '+why+'. Sans nouveau blâme, il s\'efface avec le temps.');}
function doFire(m){WN=0;WNT=0;if(isCseMe()){CSEV.lost=CSEV.eDay;CSE.m=CSE.m.filter(function(n){return n!=='@me';});try{cseVests();}catch(_){}setTimeout(function(){toast('Tu perds ton siège au CSE.',1);},2500);}const why=BLWHY.slice();BLWHY=[];blames=0;blAge=0;FIREW=null;lives--;coins=Math.max(0,coins-5);if(lives<=0){if(m)say(m.g,'Vous êtes viré !');proLose(Math.round((PRO.psc||0)*.15),'Viré');gameOver();return;}if(m)say(m.g,'Mise à pied !');toast((m?m.name:'Un manager')+' te met à pied pour la journée : −1 cœur et 5 pièces (journée non payée). Tu gardes tous tes points. Les blâmes repartent à 0.',1);if(lives>0&&mode==='zone'){try{$('fade').classList.add('on');if(cur!=='office')enter('office');pp.x=22.5;pp.z=-40.4;pp.face=0;camPos.set(pp.x,CAMH,pp.z+CAMZ);camLook.set(pp.x,.4,pp.z-.6);const txt=(m?m.name:'Un manager')+' t\'a mis à pied pour la journée.'+(why.length?' Motifs : '+why.join(' / ')+'.':' Trop de blâmes.')+' Tu perds 1 cœur ('+lives+' restant'+(lives>1?'s':'')+') et 5 pièces, mais tu gardes tous tes points. Le lendemain, tu reprends à l\'entrée du personnel. Sans cœur, c\'est le renvoi définitif.';BLTXT=txt;setTimeout(function(){dlg('📅 Un jour de mise à pied',txt,[{t:'Reprendre',f:function(){$('fade').classList.remove('on');}}]);},350);}catch(_){$('fade').classList.remove('on');}}}
/* ---------- v225 : avertissements, blâmes qui s'effacent un par un, minuit Paris, ambiance nuit ---------- */
let WN=0,WNT=0,blTs=[];
function giveWarn(why){if(PIMM>0){toast('🛡️ Immunité : l\'avertissement ne t\'atteint pas ('+why+').');return;}WN++;WNT=0;proLose(5,'Avertissement');if(WN>=3){WN=0;pop('⚠️ 3 avertissements : ça fait un blâme !','bad');giveBlame(why+' (3 avertissements)',0);}else pop('⚠️ Avertissement '+WN+'/3 : '+why+'. Il s\'efface après 3 min sans nouveau.','warn');}
function addWarn(e){e.wn=(e.wn||0)+1;e.wnT=0;if(e.wn>=3){e.wn=0;addBl(e);return 2;}return 1;}
function blKeep(ts,n,last,dt){while(ts.length<n)ts.push(0);while(ts.length>n)ts.shift();for(let i=0;i<ts.length;i++)ts[i]+=dt;while(ts.length&&ts[0]>=600)ts.shift();let c=ts.length;if(n>=3&&last>=60)c=Math.min(c,2);while(ts.length>c)ts.shift();return Math.min(n,c);}
function parisDay(){try{return new Intl.DateTimeFormat('fr-CA',{timeZone:'Europe/Paris',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());}catch(_){const d=new Date();return d.getFullYear()+'-'+(d.getMonth()+1)+'-'+d.getDate();}}
function parisHour(){try{const p=new Intl.DateTimeFormat('en-GB',{timeZone:'Europe/Paris',hour:'2-digit',minute:'2-digit',hour12:false}).formatToParts(new Date());let h=0,m=0;p.forEach(function(x){if(x.type==='hour')h=(+x.value)%24;if(x.type==='minute')m=+x.value;});return h+m/60;}catch(_){const d=new Date();return d.getHours()+d.getMinutes()/60;}}
let PDAY=parisDay(),PDT=0;
function dayReset(){WN=0;WNT=0;blames=0;blAge=0;blTs=[];FIREW=null;EMP.forEach(function(e){e.bl=0;e.warn=0;e.wn=0;e.blT=[];});toast('🌅 Nouveau jour : avertissements et blâmes remis à zéro.');}
let NMODE='auto',NK=0,NKA=-1;try{NMODE=localStorage.getItem('edm_nm')||'auto';}catch(_){}
function nightTarget(){if(NMODE==='day')return 0;if(NMODE==='night')return 1;const h=parisHour();if(h>=18.5||h<6.5)return 1;if(h>=17.5)return h-17.5;if(h<7.5)return 7.5-h;return 0;}
let TON=false,NMSG=false,TBS='',DETC={t:-1,v:1};
function hasTorch(){return (INV.torche>0||INV.torchem>0||INV.frontale>0||SEC)?true:false;}
function dkCone(ctx,x,z,h,len,st){const fx=Math.sin(h),fz=Math.cos(h);[[.2,.24,1],[.45,.34,.95],[.7,.44,.85],[.95,.54,.7]].forEach(function(c){dkHole(ctx,x+fx*len*c[0],.2,z+fz*len*c[0],len*c[1],st*c[2]);});}
function inLit(x,z){return dkLights(cur).some(function(l){return Math.hypot(l.x-x,l.z-z)<l.r*.75;});}
function detM(){if(NK<.5||mode!=='zone')return 1;if(DETC.t===clk)return DETC.v;const v=((TON&&hasTorch())?(INV.frontale>0?1.5:1.3):(inLit(pp.x,pp.z)?1:.6))*(SILT>0?.7:1);DETC.t=clk;DETC.v=v;return v;}
function nightBig(){const el=$('nightMsg');if(!el)return;el.innerHTML='🌙 Le magasin tombe dans la nuit !<small>'+(hasTorch()?'Allume ta lampe torche avec le bouton 🔦 pour y voir mieux.':'Achète la lampe torche pour y voir mieux (boutique du smartphone, onglet Accessoires).')+'</small>';el.classList.add('on');setTimeout(function(){el.classList.remove('on');},8000);}
function torchUI(){const night=NK>.35&&mode==='zone';if(!night&&TON)TON=false;const show=hasTorch()&&night,st=show?(TON?'1':'0'):'h';if(st===TBS)return;TBS=st;const bt=$('bTorch');if(!bt)return;bt.hidden=!show;bt.classList.toggle('off',!TON);$('bTorchT').textContent=TON?'Torche ON':'Torche OFF';}
$('bTorch').addEventListener('click',function(){if(!hasTorch()||NK<=.35||uiOpen)return;TON=!TON;TBS='';torchUI();toast(TON?'🔦 Lampe torche allumée : tu y vois mieux, mais les managers te repèrent de plus loin.':'🔦 Lampe torche éteinte : plus discret, mais tu y vois à peine.');});
function nightTick(dt){const tg=nightTarget();NK+=(tg-NK)*Math.min(1,dt*.8);if(Math.abs(tg-NK)<.002)NK=tg;if(NK>.4&&!NMSG){NMSG=true;nightBig();}if(NK<.1)NMSG=false;torchUI();nightLife(dt);SILT=Math.max(0,SILT-dt);try{mgrNight(dt);csqTick(dt);}catch(_){}autoHide(dt);proTick(dt);mobTick(dt);
  const s=mode==='zone'?(cur==='parking'?1:.5):.7,k=Math.round(NK*s*200)/200;if(k===NKA)return;NKA=k;
  hemi.intensity=.95*(1-.35*k);sun.intensity=1.45*(1-.55*k);hemi.color.setHex(k>0?(k>.5?0x9fb2dc:0xd8d8e6):0xfff4e6);scene.background.setHex(k>.85?0x0b1222:k>.6?0x1a2640:k>.3?0x55688a:k>.05?0x93a9c4:0xb9d3e6);}

/* v236 : cachettes automatiques (on se cache en passant dessus, sans appuyer sur Agir) */
function doHide(m,auto){if(NK>.5&&GUARDS.some(function(G){return G.zn===cur&&G.stun<=0&&G.fx>0&&Math.hypot(G.x-pp.x,G.z-pp.z)<5.5&&!blocked(Z[cur],G.x,G.z,pp.x,pp.z);})){m.cool=3;toast('Le vigile t\'a vu te cacher ! Coupe sa vue d\'abord (tourne un coin).');return false;}
  HID=45;HIDT=0;HIDP=auto?{x:m.x,z:m.z}:{x:pp.x,z:pp.z};m.cool=2;if(!auto||clk-HTO>8){HTO=clk;toast('Tu te caches : les vigiles te perdent. Ne bouge pas !');}return true;}
function autoHide(dt){if(HID>0){HID-=dt;HIDT+=dt;if(HIDP&&Math.hypot(pp.x-HIDP.x,pp.z-HIDP.z)>.7){HID=0;if(HIDT>1.5)toast('Tu sors de ta planque.');}return;}if(mode!=='zone'||rank!==0||uiOpen||SEC)return;const zn=Z[cur];if(!zn)return;
  for(let i=0;i<zn.markers.length;i++){const m=zn.markers[i];if((m.obj!=='cache'&&m.obj!=='cachette')||m.off||m.cool>0)continue;if(Math.hypot(m.x-pp.x,m.z-pp.z)<.6){doHide(m,true);return;}}}
/* v231 : la nuit = moins de monde (1/3 en moins, plus de caisses ni d'accueil ni de clients) + prime de nuit */
const NP={t:0,n:0,T:600,G:30};let NSTAFF=null;
function nightStaffBuild(){const L=[],cap={store:8,reserve:3,drive:3,electro:2,office:3,boulangerie:2,poissonnerie:2,location:1},cnt={},off={'Léa':1,'Tom':1,'Clara':1,'Manon':1};
  EMP.forEach(function(e){if(!e.name||e.cap)return;if(off[e.name]){L.push({e:e});return;}const z=e.zn;cnt[z]=(cnt[z]||0)+1;if(cap[z]!==undefined&&cnt[z]>cap[z])L.push({e:e});});
  L.forEach(function(r,i){r.th=.15+.65*(i/Math.max(1,L.length));});return L;}
function nightLife(dt){if(!NSTAFF)NSTAFF=nightStaffBuild();
  NSTAFF.forEach(function(r){const e=r.e,go=NK>r.th;
    if(go&&!e.nOff){if(e.pj||e.out>0)return;e.nOff=1;if(e.f){try{endFault(e);}catch(_){}}e.tk=null;e.path=null;e.out=1e9;e.g.visible=false;}
    else if(!go&&e.nOff){e.nOff=0;if(!e.pj&&!e.cap&&e.out>=1e8){e.out=0;e.noF=20;e.g.visible=true;}}
    else if(go&&e.nOff&&!e.pj&&!(e.out>=1e8)){e.out=1e9;e.g.visible=false;}});
  if(NK>.6&&mode==='zone'&&rank===0&&!SEC&&!uiOpen&&!CREATING){NP.t+=dt;if(NP.t>=NP.T){NP.t=0;NP.n++;coins+=NP.G;pop('🌙 Prime de nuit : +'+NP.G+' 🪙 ('+Math.round(NP.T/60)+' min sans te faire attraper)','good');}}}
/* ---------- v228 : nuit = calque sombre percé de zones éclairées ---------- */
const DKC=$('dk');let DKX=null,DSET=1,DKT=0;try{DKX=DKC&&DKC.getContext?DKC.getContext('2d'):null;DSET=+(localStorage.getItem('edm_dk')||1)||1;}catch(_){}
const DARKA={store:.58,reserve:.78,boulangerie:.6,poissonnerie:.6,drive:.7,parking:.9,office:.66,salle:.66,compta:.7,coffres:.72,electro:.66,location:.7};
const DKP={store:[7,6,.45,5.5],reserve:[12,9,.3,4.6],boulangerie:[7,6,.5,4.8],poissonnerie:[7,6,.55,4.8],drive:[8,7,.5,5],parking:[13,11,.5,7.5],office:[8,7,.5,4.8],salle:[8,7,.55,4.8],compta:[7,6,.55,4.5],coffres:[7,6,.6,4.5],electro:[8,7,.5,5],location:[7,6,.55,4.8]};
const LGT={};
function dkHash(a,b){let h=(Math.imul(a+101,73856093)^Math.imul(b+977,19349663))>>>0;h^=h>>>13;h=Math.imul(h,1274126177)>>>0;return (h>>>0)/4294967295;}
function dkLights(zn){if(LGT[zn])return LGT[zn];const z=Z[zn],P=DKP[zn],L=[];if(!z||!P){LGT[zn]=L;return L;}
  const bx=z.bounds.x,bz=z.bounds.z;let ix=0;for(let x=bx[0]+P[0]*.5;x<bx[1];x+=P[0],ix++){let iz=0;for(let zz=bz[0]+P[1]*.5;zz<bz[1];zz+=P[1],iz++){if(dkHash(ix*31+zn.length,iz*17+zn.charCodeAt(0))<P[2]){const jx=(dkHash(ix,iz+5)-.5)*P[0]*.5,jz=(dkHash(ix+9,iz)-.5)*P[1]*.5;L.push({x:x+jx,z:zz+jz,r:P[3]*(.85+dkHash(iz,ix)*.3),s:1});}}}
  if(z.spawn)L.push({x:z.spawn.x,z:z.spawn.z,r:4.4,s:1});if(zn==='store')L.push({x:22.5,z:15,r:5.2,s:1});LGT[zn]=L;return L;}
const DKV=new T.Vector3(),DKA={x:0,y:0},DKB={x:0,y:0},DKC2={x:0,y:0};
function dkProj(x,y,z,o){DKV.set(x,y,z).project(camera);o.x=(DKV.x*.5+.5)*DKC.width;o.y=(1-(DKV.y*.5+.5))*DKC.height;}
function dkHole(ctx,x,y,z,r,st){dkProj(x,y,z,DKA);dkProj(x+r,y,z,DKB);dkProj(x,y,z+r,DKC2);const rx=Math.abs(DKB.x-DKA.x)||1,ry=Math.abs(DKC2.y-DKA.y)||1;if(DKA.x<-rx||DKA.x>DKC.width+rx||DKA.y<-ry||DKA.y>DKC.height+ry)return;
  ctx.setTransform(1,0,0,ry/rx,DKA.x,DKA.y);const g=ctx.createRadialGradient(0,0,0,0,0,rx);g.addColorStop(0,'rgba(0,0,0,'+st+')');g.addColorStop(.5,'rgba(0,0,0,'+(st*.7)+')');g.addColorStop(1,'rgba(0,0,0,0)');ctx.fillStyle=g;ctx.fillRect(-rx,-rx,rx*2,rx*2);ctx.setTransform(1,0,0,1,0,0);}
function darkDraw(){const ctx=DKX;if(!ctx)return;const a=(DARKA[cur]||.6)*NK*DSET;
  if(mode!=='zone'||a<.01){if(!DKC.hidden){DKC.hidden=true;}return;}DKC.hidden=false;
  const w=Math.max(2,Math.round((canvas.clientWidth||innerWidth)/2)),h=Math.max(2,Math.round((canvas.clientHeight||innerHeight)/2));if(DKC.width!==w||DKC.height!==h){DKC.width=w;DKC.height=h;}
  ctx.setTransform(1,0,0,1,0,0);ctx.globalCompositeOperation='source-over';ctx.clearRect(0,0,w,h);ctx.fillStyle='rgba(4,7,16,'+a.toFixed(3)+')';ctx.fillRect(0,0,w,h);
  ctx.globalCompositeOperation='destination-out';
  dkLights(cur).forEach(function(l){dkHole(ctx,l.x,.1,l.z,l.r,l.s);});
  const on=TON&&hasTorch();dkHole(ctx,pp.x,.3,pp.z,on?(INV.frontale>0?2.6:2):1.2,.9);
  if(on)dkCone(ctx,pp.x,pp.z,pp.face,INV.frontale>0?10:7.2,.95);
  if(cur===D.zn&&D.stun<=0){dkHole(ctx,D.x,.3,D.z,2.2,.85);dkCone(ctx,D.x,D.z,D.h,D.rage>0?8:7,.85);}
  MGR.forEach(function(m){if(m.zn===cur&&!m.fired&&m.g.visible&&m.stun<=0){dkHole(ctx,m.x,.3,m.z,2,.8);dkCone(ctx,m.x,m.z,m.g.rotation.y,6,.8);}});
  GUARDS.forEach(function(g){if(g.zn===cur&&g.stun<=0){dkHole(ctx,g.x,.3,g.z,2,.8);dkCone(ctx,g.x,g.z,g.h,6.5,.8);}});
  ctx.globalCompositeOperation='source-over';}
let LAMPS=false;function dkPosts(){if(LAMPS||!Z.parking)return;LAMPS=true;const g=Z.parking.g,pm=new T.MeshLambertMaterial({color:0x2b303c}),bm=new T.MeshBasicMaterial({color:0xffe9a8});dkLights('parking').forEach(function(l,i){if(l.r<6)return;const p=new T.Mesh(new T.CylinderGeometry(.09,.12,3.4,8),pm);p.position.set(l.x,1.7,l.z);g.add(p);const b=new T.Mesh(new T.SphereGeometry(.26,10,8),bm);b.position.set(l.x,3.5,l.z);g.add(b);});}
function dkLabel(){return DSET>=1?'100 %':DSET>=.7?'70 %':'50 %';}
function nightLabel(){return NMODE==='night'?'toujours nuit':NMODE==='day'?'toujours jour':'selon l\'heure de Paris';}
function fireUpdate(dt){
  PDT+=dt;if(PDT>=5){PDT=0;const d=parisDay();if(d!==PDAY){PDAY=d;dayReset();}}
  WNT+=dt;if(WN>0&&WNT>=180){WN=0;toast('Ton avertissement est effacé.');}
  blAge+=dt;const cp=rank<1?blKeep(blTs,blames,blAge,dt):3;
  if(blames>cp&&rank<1){blames=cp;if(FIREW){FIREW=null;toast('Le manager n\'est pas venu : tu retombes à 2 blâmes.');}else if(cp<3)toast('Ton temps passe : tu retombes à '+blames+' blâme'+(blames>1?'s':'')+'.');}
  if(FIREW&&(rank>=1||blames<3))FIREW=null;
  if(FIREW&&mode==='zone'){const k=FIREW;k.rp-=dt;
    if(!k.m||k.m.zn!==cur||k.m.fired){k.m=null;if(k.rp<=0){k.rp=1;let b=null,bd=1e9;MGR.forEach(function(m){if(m.zn!==cur||m.fired||m.state!=='patrol'||m.stun>0)return;const d=Math.hypot(m.x-pp.x,m.z-pp.z);if(d<bd){bd=d;b=m;}});if(b){k.m=b;b.t=Math.max(b.t,80);say(b.g,'Toi, viens ici !');}}}}}
function drawFG(){if(!FG)return;const n=FR.n||0,k=n+'|'+Math.round(FR.prog*40)+'|'+(FR.mA?1:0);if(k===FG.k)return;FG.k=k;const x=FG.cv.getContext('2d'),ok=n>=FR.need;x.clearRect(0,0,256,96);x.fillStyle='rgba(18,32,54,.93)';rr(x,2,2,252,92,16);x.fill();
  x.fillStyle=ok?'#46d17a':'#ff6a6a';x.font='600 30px Fredoka,system-ui,sans-serif';x.textAlign='center';x.textBaseline='middle';x.fillText('Équipe '+n+'/'+FR.need,128,30);
  x.fillStyle='#2b3b57';rr(x,16,56,224,24,10);x.fill();if(FR.prog>0){x.fillStyle=ok?'#46d17a':'#8a93a3';rr(x,16,56,Math.max(16,224*FR.prog),24,10);x.fill();}FG.tex.needsUpdate=true;}
function endFridge(){FR.pl=false;FR.prog=0;FR.mt=0;FR.n=0;FR.order=0;FR.assist=false;NPC.forEach(function(n){if(n.help){n.help=null;n.path=null;n.wait=1;}});}
function recruit(m,k){const L=NPC.filter(function(n){return n.name&&!n.help&&!n.trip;});const pOrd=rank===0&&cur==='store'&&mode==='zone'&&VEST<=0&&!pretend&&!act;const nb=Math.min(L.length,pOrd?1:2+((Math.random()*2)|0));
  for(let i=0;i<nb;i++){const e=L[i];e.help={x:-13.4+i*1.1,z:-16.3};e.path=null;e.wait=0;say(e.g,'On vide les frigos !');}
  if(rank===0&&cur==='store'&&mode==='zone'){if(VEST>0)toast(m.name+' voit ton gilet « je suis débordé » et n\'ose pas t\'appeler.');else if(pretend)toast(m.name+' voit que tu fais semblant de bosser : il prend quelqu\'un d\'autre.');else if(!act){FR.order=20;FR.mn=m.name;toast(m.name+' t\'ordonne de venir vider les frigos ! Il faut être 3 en même temps : rejoins le cercle « Vider les frigos ».');}}}
function helpersReady(k){let n=0;NPC.forEach(function(e){if(e.help&&Math.hypot(e.x-e.help.x,e.z-e.help.z)<.6)n++;});return n;}
function frozenSh(){shInit();const d=function(m){return Math.hypot(m.x+16.4,m.z-5.8);},L=SHV.filter(function(m){return d(m)<7;});if(L.length)return L;const q=SHV.slice().sort(function(a,b){return d(a)-d(b);});return q.slice(0,1);}
function frozenLost(){const L=frozenSh();L.forEach(function(m){m.stock=0;});prodApply();RESULT=Math.max(0,RESULT-8);toast('🧊 Les surgelés sont jetés ! Les rayons sont vides : il faut les remplir, sinon les résultats baissent.');}
function startFridgeMgr(){FR.on=true;FR.t=120;FR.order=0;FR.assist=false;FR.prog=0;FR.mt=0;FR.n=0;FR.meT=-9;FR.pl=true;FRIDGE.visible=true;const jf={kind:'fridge',x:-14.6,z:-16.2,claimed:'PLAYER',pl:1};JOBS.push(jf);recruit({name:PNAME},jf);toast('🧊 Les frigos sont en panne ! Va sur le cercle « Vider les frigos » : 2 employés t\'attendent. À toi d\'appuyer sur Action : 10 s pour tout vider (2 min max).');}
function fridgeOkPl(){const i=JOBS.findIndex(function(j){return j.kind==='fridge'&&j.pl;});if(i>=0)JOBS.splice(i,1);FR.on=false;FRIDGE.visible=false;endFridge();RESULT=Math.min(100,RESULT+8);coins+=6;addW(6);toast('Frigos vidés à temps : Résultats +8, +6 pièces, +6 bosseur.');}
function fridgeFail(){const jp=JOBS.find(function(x){return x.kind==='fridge'&&x.pl;});if(jp){JOBS.splice(JOBS.indexOf(jp),1);FR.on=false;FRIDGE.visible=false;frozenLost();endFridge();addAnger(40);RESULT=Math.max(0,RESULT-10);toast('Frigos pas vidés à temps : la directrice est furieuse. Résultats −10.');return;}
  const j=JOBS.find(function(x){return x.kind==='fridge';});const m=j&&(j.tgt&&!j.tgt.fired?j.tgt:j.claimed);const cl=j&&j.claimed;if(j){JOBS.splice(JOBS.indexOf(j),1);}
  FR.on=false;FRIDGE.visible=false;MGR.forEach(function(x){if(!x.fired&&(x===m||!m))hitMgr(x,10);});if(cl){cl.task=null;cl.path=null;}
  frozenLost();
  const had=FR.order>0&&!FR.assist;endFridge();addAnger(40);addB(25);toast('Frigos pas vidés à temps ! Blâme pour '+(m?m.name:'les managers')+' et les employés. +25 branleur');if(had){giveBlame('tu n\'as pas aidé à vider les frigos !',2);giveBlame('deuxième blâme pour désobéissance',0);}}
function clearJobs(){endFridge();JOBS.forEach(function(j){if(j.mesh)S.g.remove(j.mesh);});JOBS.length=0;FR.on=false;FRIDGE.visible=false;MGR.forEach(function(m){m.task=null;m.path=null;});}
function gameOver(){v117Reset();DEBT=0;DEBPER=0;SB=0;SW=0;ONB=false;PNG=0;resetRes();{const tk=INV.torche,tm=INV.torchem;Object.keys(INV).forEach(function(k){INV[k]=0;});INV.torche=tk||0;INV.torchem=tm||0;}renderQI();JAM=DISG=VEST=0;LOOT.length=0;GRADE=0;VGXP=0;lives=3;blames=0;FIREW=null;blAge=0;coins=0;image=20;hunger=100;charges=0;won=false;act=null;pretend=false;
  Object.keys(OBJ).forEach(function(k){OBJ[k].n=0;});resetRank();VIGI=false;SEC=false;ROLE='e';clearJobs();
  MGR.forEach(function(m){m.fired=false;m.stand=100;backToPatrol(m,m.next);m.respawn=0;drawM(m);});mgrBench();
  puddles.forEach(function(p){S.g.remove(p.mesh);});puddles.length=0;
  resetParking();Object.keys(Z).forEach(function(k){Z[k].markers.forEach(function(m){m.cool=0;m.prog=0;});});mailCD=0;WCI.t=0;
  if(MG)closeMail();
  toast('Plus de vies : tu es viré du magasin. On recommence.');toMap(true);}
let HUDFULL='';
function hudWin(h){const P=hudParts(h);return P.m+P.s;}
let QSEL=null;const QJ={list:[],more:0};
function hudKey(l){const t=l.replace(/<[^>]+>/g,'');if(t.indexOf('PRIORITAIRE')>=0)return 'pri';if(l.indexOf('data-pin')>=0)return 'cf';if(/🔔 Sabotages/.test(t))return 'aq';if(/📦 Commande|🛍️ Sacs/.test(t))return 'cmd';if(/✊ CSE :/.test(t))return 'cse';return '';}
function hudParts2(h){const all=h.split('</div>').filter(function(x){return x;}).map(function(x){return x+'</div>';}).map(function(l,i){return {l:l,c:hudCls(l),k:hudKey(l),i:i};});
  if(QSEL&&!all.some(function(x){return x.k===QSEL;}))QSEL=null;
  const ord=function(a,b){return ((a.c===0)?0:1)-((b.c===0)?0:1)||((a.k&&a.k===QSEL)?0:1)-((b.k&&b.k===QSEL)?0:1)||a.c-b.c||a.i-b.i;};
  const mk=function(x){return x.l.replace(/^<div>/,'<div class="qb q'+x.c+(x.k&&x.k===QSEL?' qsel':'')+'">');};
  const T=all.filter(function(x){return x.c===0;}),R=all.filter(function(x){return x.c!==0&&x.c!==9;}).sort(ord);
  QJ.list=all.slice().sort(ord);QJ.more=T.length?R.length:Math.max(0,R.length-3);
  try{const b=$('bQJn');if(b){b.hidden=!QJ.more;b.textContent=QJ.more;}}catch(_){}
  if(T.length)return {m:T.slice(0,2).map(mk).join(''),s:''};
  return {m:R.slice(0,3).map(mk).join(''),s:''};}
function qjOpen(){let p=$('qjP');if(!p){p=document.createElement('div');p.id='qjP';document.body.appendChild(p);
    p.addEventListener('click',function(e){const b=e.target.closest?e.target.closest('[data-q]'):null;if(b){QSEL=QSEL===b.dataset.q?null:b.dataset.q;lastHud=null;qjOpen();return;}if(e.target.id==='qjX'||e.target===p)p.hidden=true;});}
  const L=QJ.list;p.innerHTML='<div class="qjw"><div class="qjt">📜 Journal de quêtes <button id="qjX">✕</button></div><p class="qjd">Touche une quête pour la suivre : elle passe en premier et une flèche verte t\'y guide. Touche-la encore pour arrêter.</p>'
    +(L.length?L.map(function(x){return x.l.replace(/^<div>/,'<div class="qb q'+x.c+(x.k?' qk':'')+(x.k&&x.k===QSEL?' qsel':'')+'"'+(x.k?' data-q="'+x.k+'"':'')+'>'+(x.k?(x.k===QSEL?'🟢 ':'⚪ '):''));}).join(''):'<p class="qjd">Aucune quête pour le moment.</p>')+'</div>';p.hidden=false;}
/* fleches vers les quetes (comme Rideau de fer) : jaune = prioritaire, rouge = chrono, verte = quete suivie */
function edmZoneNext(from,to){if(from===to)return null;const seen={},Q=[[from,null]];seen[from]=1;while(Q.length){const c=Q.shift();for(let i=0;i<PORTALS.length;i++){const q=PORTALS[i];if(q.zn!==c[0]||seen[q.to])continue;const f=c[1]||q;if(q.to===to)return f;seen[q.to]=1;Q.push([q.to,f]);}}return null;}
function qtFind(pred){let best=null,bd=1e9;Object.keys(Z).forEach(function(id){Z[id].markers.forEach(function(m){if(m.off||!pred(m))return;const d=(id===cur?0:1000)+Math.hypot(m.x-pp.x,m.z-pp.z);if(d<bd){bd=d;best={zn:id,x:m.x,z:m.z};}});});return best;}
function qtObj(L){return qtFind(function(m){return L.indexOf(m.obj)>=0;});}
function qTarget(k){try{
  if(k==='pri'&&PRI)return qtObj(PRI.d.ids);
  if(k==='cf'){const st=cfSt();if(!st.ms.length||cfEmpty())return null;if(!st.bribed){if(cfDone(st))return qtObj(['compbrib','compmiss']);const q=st.ms.find(function(m){return m.p<m.n;});return q?qtObj([q.k]):null;}return qtObj(st.key?['compcoffre']:['compkey']);}
  if(k==='aq'){if(SABN>=3)return qtObj(['alarme']);if(AQM&&AQM[0])return {zn:cur,x:AQM[0].x,z:AQM[0].z};return null;}
  if(k==='cmd'){if(BAG>0)return qtObj(['retrait']);if(!CMD)return null;const left=CMD.need.filter(function(n){return !CMD.got[n];});if(left.length)return qtFind(function(m){return PKM.indexOf(m)>=0&&left.indexOf(m.nm)>=0;});return qtObj(['prepcmd']);}
  if(k==='cse'&&CSQ.mk.length){let b=null,bd=1e9;CSQ.mk.forEach(function(m){const id=Object.keys(Z).find(function(z){return Z[z]===m.zone;});const d=(id===cur?0:1000)+Math.hypot(m.x-pp.x,m.z-pp.z);if(d<bd){bd=d;b={zn:id,x:m.x,z:m.z};}});return b;}
  if(k==='chrono'){if(DF.on&&DF.mk)return {zn:'drive',x:DF.mk.x,z:DF.mk.z};if(MEET.on)return qtObj(['cloturer','animer'])||{zn:'salle',x:Z.salle.spawn.x,z:Z.salle.spawn.z};if(CSE.vote)return qtObj(['urne']);if(FR.order>0)return qtObj(['frigo','surgeles','vider']);return null;}
}catch(_){}return null;}
function edmArrows(){let box=$('edmArr');if(!box){box=document.createElement('div');box.id='edmArr';document.body.appendChild(box);}
  const L=[];if(mode==='zone'&&!CREATING&&!CINE&&!uiOpen){const ch=QJ.list.some(function(x){return x.c===0;});if(ch){const t=qTarget('chrono');if(t)L.push([t,'red','⏱']);}
    if(PRI){const t=qTarget('pri');if(t)L.push([t,'ya','⭐']);}if(QSEL&&QSEL!=='pri'){const t=qTarget(QSEL);if(t)L.push([t,'grn','🟢']);}}
  while(box.children.length<L.length){const d=document.createElement('div');d.className='qmarr';d.innerHTML='<i>➤</i><span></span>';box.appendChild(d);}
  Array.prototype.forEach.call(box.children,function(el,i){const q=L[i];if(!q){el.style.display='none';return;}const t=q[0];let tx=t.x,tz=t.z,txt,same=t.zn===cur;
    if(!same){const lg=edmZoneNext(cur,t.zn);if(!lg){el.style.display='none';return;}tx=lg.x;tz=lg.z;txt=({store:'Magasin',reserve:'Réserve',office:'Bureaux',salle:'Salle de réunion',drive:'Drive',parking:'Parking',boulangerie:'Boulangerie',poissonnerie:'Poissonnerie',compta:'Compta',coffres:'Coffres',electro:'Électro',location:'Location'})[t.zn]||t.zn;}else txt=Math.round(Math.hypot(t.x-pp.x,t.z-pp.z))+' m';
    const v=new T.Vector3(tx,1,tz).project(camera);let sx=v.x,sy=v.y;if(v.z>1){sx=-sx;sy=-sy;}
    if(same&&Math.abs(sx)<.86&&Math.abs(sy)<.8&&v.z<1){el.style.display='none';return;}
    const a=Math.atan2(sy,sx),mm=Math.max(Math.abs(Math.cos(a))/.86,Math.abs(Math.sin(a))/.74),ex=Math.cos(a)/mm,ey=Math.sin(a)/mm;
    el.style.display='flex';el.className='qmarr '+q[1];el.style.left=((ex+1)/2*100)+'%';el.style.top=((1-ey)/2*100)+'%';el.querySelector('i').style.transform='rotate('+(-a)+'rad)';const s2=q[2]+' '+txt;const sp=el.querySelector('span');if(sp.textContent!==s2)sp.textContent=s2;});}
function hudCls(l){const t=l.replace(/<[^>]+>/g,'');
  if(/⏱|📣 Sifflet|📌|🔥 Incendie|🚨 ALARME INCENDIE|📋 Réunion|📮 Élections/.test(t))return 0;
  if(t.indexOf('PRIORITAIRE')>=0)return 1;
  if(l.indexOf('data-pin')>=0||/Reprends ton poste|🔔 Sabotages|🔑 Tu as la clé|✊ CSE :/.test(t))return 2;
  if(/📦 Commande|🛍️ Sacs/.test(t))return 3;
  if(/🎲 Tirage de promotion/.test(t))return 9;
  return 5;}
function hudParts(h){const all=h.split('</div>').filter(function(x){return x;}).map(function(x){return x+'</div>';}).map(function(l,i){const c=hudCls(l);return {l:l.replace(/^<div>/,'<div class="qb q'+c+'">'),c:c,i:i};});
  const ord=function(a,b){return a.c-b.c||a.i-b.i;};
  if($('objs').classList.contains('open'))return {m:'<div class="qjh">📜 Journal de quêtes <small>(touche pour fermer)</small></div>'+all.slice().sort(ord).map(function(x){return x.l;}).join(''),s:''};
  const T=all.filter(function(x){return x.c===0;});if(T.length)return {m:T.slice(0,2).map(function(x){return x.l;}).join(''),s:''};
  const R=all.filter(function(x){return x.c!==9;}).sort(ord),more=R.length-3;
  return {m:R.slice(0,3).map(function(x){return x.l;}).join(''),s:more>0?'<div class="qjm">📜 +'+more+' quête'+(more>1?'s':'')+' dans le journal</div>':''};}
function hudPartsOld(h){const all=h.split('</div>').filter(function(x){return x;}).map(function(x){return x+'</div>';});
  if($('objs').classList.contains('open')===true)return {m:h,s:''};
  const pins=all.filter(function(l){return l.indexOf('data-pin')>=0;}).join(''),ls=all.filter(function(l){return l.indexOf('data-pin')<0;});
  if(!ls.length)return {m:pins,s:''};
  const pi=ls.findIndex(function(l){return l.indexOf('PRIORITAIRE')>=0;}),tick=Math.floor(Date.now()/5000),mi=pi>=0?pi:0;
  const rest=ls.filter(function(_,i){return i!==mi;});
  if(rest.length<=2)return {m:ls[mi]+pins,s:rest.join('')};
  const pg=Math.ceil(rest.length/2),o=(tick%pg)*2;return {m:ls[mi]+pins,s:rest.slice(o,o+2).join('')};}
function hudSet(el,html){try{const sk=html.replace(/\d+/g,'#');if(el._sk===sk&&el.firstChild){const tmp=document.createElement('div');tmp.innerHTML=html;const tw=function(n){const r=[],w=document.createTreeWalker(n,4);let x;while((x=w.nextNode()))r.push(x);return r;},a=tw(el),b=tw(tmp);if(a.length===b.length){for(let i=0;i<a.length;i++)if(a[i].nodeValue!==b[i].nodeValue)a[i].nodeValue=b[i].nodeValue;return;}}el.innerHTML=html;el._sk=sk;}catch(_){el.innerHTML=html;}}
function hudText(){const L=[];
  if(CART.n<=3)L.push(rank>=1?'🛒 Abri à caddies presque vide : envoie quelqu\'un en corvée':'🛒 Abri à caddies presque vide : ramène des caddies (parking)');
  if(rank===0&&ONB)L.push(BRK>0?'Pause pointée : '+Math.floor(Math.ceil(BRK)/60)+':'+('0'+(Math.ceil(BRK)%60)).slice(-2)+' (puis dépointe)':'Pause finie : va dépointer !');
  if(rank===0&&!CREATING)L.push('🎲 Tirage de promotion dans '+proFmt(proLeft())+(PRO.cd===PRO.sl?' (pas candidat à ce tirage)':''));
  else if(rank>=1&&proGrace())L.push('🛡 Période de grâce : '+proFmt(Math.max(0,(PRO.gr-Date.now())/1000))+' sans risque de chute');
  MOB.l.forEach(function(e){L.push('<b style="color:#e5484d">⏱ '+MOBC[e.k].n+' : '+Math.max(0,Math.ceil(e.t))+' s'+(e.mine?' (déclenché par toi)':'')+'</b>');});
  if(SEC){L.push('Détecteur 📡 : bip près d\'un voleur, fouille-le (Agir)');L.push('Radar devant toi : surveille les employés');L.push('Caméras : ordinateur de sécurité');L.push('Ronde : suis les ronds bleus (magasin, parking, réserve)');}
  else if(rank>=1&&!won){L.push('Radar devant toi : repère les fautifs, reste derrière eux pour les presser');L.push('Caméras, planning, convocations : ordinateur');L.push('Résultats '+Math.round(RESULT)+'/100 • Réputation '+Math.round(COMP)+' %');L.push('📱 Téléphone > Autorité : corvées, heures forcées, annonces au micro, pire cauchemar, réunion (aussi au pupitre de la salle de réunion)');L.push('Glande aussi (canapé, baby-foot, clope, frigo) : gare aux dénonciations');L.push('Dénonce les managers qui fument (photo)');L.push('Missions : contrôler les rayons, poser une caméra, regarder les caméras');L.push('Bureau de la directrice : convoque, planifie');L.push(won?'Tu diriges le magasin !':'Atteins '+WIN+' pièces ('+Math.floor(coins)+')');}
  if(KEY)L.push('<b style="color:#12a150">🔑 Tu as la clé : '+Math.ceil(KEYT)+' s</b>');else{const kh=keyHolder();if(kh)L.push('<b style="color:#e5484d">🔑 '+kh.nm+' a volé la clé de la directrice : '+Math.ceil(kh.t)+' s</b>');}
  if(rank===0&&!SEC){try{const st=cfSt();if(st.ms.length&&!cfEmpty()){if(!st.bribed){if(cfDone(st))L.push('<b data-pin="1" style="color:#12a150">📋 Virginie : services faits, soudoie-la (40 🪙) !</b>');else st.ms.forEach(function(m,i){L.push('<b data-pin="1" style="color:#12a150">📋 '+(i+1)+'. '+m.t+' : '+m.p+'/'+m.n+(m.p>=m.n?' ✅':'')+'</b>');});}else if(!st.e&&!st.key)L.push('<b data-pin="1" style="color:#12a150">🗝️ Va chercher la clé dans le bureau de la directrice</b>');else if(!st.e)L.push('<b data-pin="1" style="color:#12a150">💰 Entre dans la salle des coffres et vide le coffre-fort</b>');}}catch(_){}}
  if(LOOT.length)L.push('Butin '+LOOT.length+'/3 (valeur '+lootVal()+') : va au coffre de ta voiture');
  if(charges>0)L.push('Seau : '+charges+' flaque'+(charges>1?'s':''));
  if(!VIGI&&D.rage<=0&&RES.anger>=25)L.push('<b style="color:#e5484d">Directrice : colère '+Math.round(RES.anger)+' %</b>');
  {const em=shEmpty();if(em>0)L.push('<b style="color:#e5484d">🛒 Rayons vides : '+em+'</b>');}
  if(!VIGI&&FR.on)L.push('Frigos en panne ! ('+Math.ceil(FR.t)+' s)');
  if(JAM>0)L.push('Brouilleur actif : '+Math.ceil(JAM)+' s');if(DISG>0)L.push('Déguisé : '+Math.ceil(DISG)+' s');if(VEST>0)L.push('Gilet « débordé » : '+Math.ceil(VEST)+' s');if(INV.ext>0)L.push('Extincteur perso x'+INV.ext);
  if(!VIGI&&FR.order>0)L.push('<b style="color:#e5484d">📌 '+(FR.mn||'Le manager')+' t\'a désigné pour vider les surgelés : va sur la marque ou 2 blâmes ! ('+Math.ceil(FR.order)+' s)</b>');
  if(rank>=1&&D.rage>0)L.push('La directrice est EN COLÈRE !');
  if(WCIN)L.push('Toilettes : '+Math.floor(WCIN.t)+' s'+(WCIN.dn>0?' — on te dénonce !':''));
  if(CMD)L.push('📦 Commande : '+CMD.need.map(function(n){return CMD.got[n]?'✅ '+n:n;}).join(' • ')+(CMD.need.every(function(n){return CMD.got[n];})?' → retourne au Drive':''));
  if(BAG>0)L.push('🛍️ Sacs prêts : '+BAG+' (sers un client au retrait)');
  if(DF.on)L.push('<b style="color:#e5484d">🔥 Incendie au Drive : '+Math.max(0,Math.ceil(45-DF.t))+' s !</b>');
  if(ALM.t>0)L.push('<b style="color:#e5484d">🚨 ALARME INCENDIE : '+Math.ceil(ALM.t)+' s</b>');
  else if(rank===0&&AQ)L.push('🔔 Sabotages '+['⬜','✅'].map(function(){return '';}).join('')+[0,1,2].map(function(i){return i<SABN?'✅':'⬜';}).join('')+' '+SABN+'/3'+(SABN>=3?' : tire une alarme incendie !':' (3 pour l\'alarme incendie)'));
  {const dg=MGR.filter(function(m){return !m.fired&&m.stand<50;}).sort(function(a,b){return a.stand-b.stand;}).slice(0,3);if(dg.length)L.push('⚠ Managers en danger : '+dg.map(function(m){return m.name+' '+Math.round(m.stand)+' %';}).join(' • '));}
  if(MEET.on)L.push('<b style="color:#7b4bb7">📋 Réunion '+(rank>=1?'en cours : clos-la vite au pupitre (bonus) ':'obligatoire ')+'('+Math.ceil(MEET.max-MEET.t)+' s)</b>');
  if(WH&&WH.t>0&&rank===0)L.push('<b style="color:#e5484d">📣 Sifflet de '+WH.by+' : tâches de bosseur '+Math.min(3,WH.n)+'/3 • '+Math.ceil(WH.t)+' s</b>');
  if(DIRS)L.push('<b style="color:#b8860b">👑 '+(DIRS.me?'Tu es le directeur':DIRS.who+' est le directeur')+' : '+Math.ceil(DIRS.t)+' s</b>');
  if(CSE.vote&&rank===0)L.push('<b style="color:#d7263d">📮 Élections CSE : vote à la boîte aux lettres de la salle de pause ('+Math.ceil(CSE.vote.t)+' s)</b>');
  if(CSQ.k&&isCseMe())L.push('✊ CSE : '+csqTxt());if(rank===0&&!SEC&&NET.on&&NET.joined&&!CSEV.vote)L.push('📮 Vote du CSE de demain : urne de la salle de pause');if(CSE.m.length)L.push('🧑‍🏭 CSE : '+CSE.m.map(function(n){return n==='@me'?'toi':n;}).join(', ')+(isCseMe()?' • 5 cartons':''));
  if(CFAL.t>0)L.push('<b style="color:#e5484d">🚨 Alarme du coffre : rondes renforcées ('+Math.ceil(CFAL.t)+' s)</b>');
  if(PIMM>0)L.push('🛡️ Immunité : '+Math.ceil(PIMM)+' s');
  if(TEAM.t>0)L.push('👥 Ordre d\'équipe en cours ('+TEAM.by+') : '+Math.ceil(TEAM.t)+' s');
  if(rank>=1&&!DIRS)L.push('🏆 Objectif : être élu Employé du Mois (vote dans '+Math.max(0,Math.ceil(EOM.next-clk))+' s)');
  if(rank===0&&MOOD.t>0)L.push(MOOD.k==='bad'?'<b style="color:#e5484d">😠 Mauvaise humeur : ta progression est bloquée ('+Math.ceil(MOOD.t)+' s)</b>':'<b style="color:#12a150">😄 Bonne humeur : bosseur ×2 ('+Math.ceil(MOOD.t)+' s)</b>');
  if(REV&&rank===0)L.push('<b style="color:#b86e00">⭐ Reprends ton poste : tâches '+Math.min(REV.n,3)+'/3 • Sérieux '+Math.round(image)+'/'+REV_IMG+' • puis plaide chez la directrice • '+Math.ceil(REV.t)+' s</b>');
  if(PRI)L.unshift('<b style="color:#b86e00">⭐ PRIORITAIRE : '+PRI.d.txt+(PRI.d.n>1?' ('+PRI.c+'/'+PRI.d.n+')':'')+' • +'+PRI.d.coins+' 🪙</b>');
  return L.map(function(t){return '<div>'+noSW(t)+'</div>';}).join('');}

/* ---------- faux mails ---------- */
const TPL=[
  {t:'Demande d\'augmentation de 300 %',b:'Bonjour la direction, vu mon travail exceptionnel, je réclame +300 % et une voiture de fonction.',dmg:5,need:10,cost:3},
  {t:'Insulte à la directrice',b:'Ce magasin est géré comme un poulailler et vous le savez très bien.',dmg:8,need:14,cost:5},
  {t:'Démission avec le stock',b:'Je démissionne et je pars en Thaïlande avec toute la réserve de chocolat.',dmg:10,need:18,cost:8},
  {t:'Rumeur de détournement de fonds',b:'Je préfère vous prévenir : les caisses ne tombent jamais juste, et pourtant je n\'y suis pour rien.',dmg:13,need:20,cost:10},
  {t:'« Répondre à tous » : direction nulle',b:'(Envoyé par erreur à tout le magasin. Vraiment. Pardon.)',dmg:15,need:24,cost:14}];
let MG=null;
const TASKS=[['rayons','Remplir les rayons',5,1],['flic','Fliquer les collègues',4,.6],['parking','Surveiller le parking',3,.5],['reserve','Ranger la réserve',5,1],['nettoyer','Nettoyer les allées',3,1]];
function openMail(){if(rank>=1||SEC){openMgrPC();return;}MG={step:'h'};uiOpen=true;$('mail').hidden=false;$('mTitle').textContent='Ordinateur';renderMail();}
function closeMail(){MG=null;uiOpen=!!(PAN||PHN);$('mail').hidden=true;}
function setPhase(p,dur){if(!MG)return;MG.phase=p;MG.pt=0;MG.dur=dur;const s=$('mStat');if(!s)return;s.className=p==='ok'?'':p;s.textContent=p==='ok'?'Tout est calme. Tape vite !':p==='warn'?'Des pas dans le couloir…':'ILS SONT LÀ ! Lâche le clavier !';}
function sendMail(tg,tp){MG.step=3;if(MG.express){INV.mailx--;renderQI();}else mailCD=30;$('mTitle').textContent='Mail envoyé';addB(8);if(!tg.fired)hitMgr(tg,tp.dmg);renderMail();}
function renderMail(){if(MG&&typeof MG.step==='string'&&MG.step[0]==='m'){renderMgr();return;}const b=$('mBody');$('tskC').textContent=Math.floor(coins)+' pièces';
  if(MG.step==='h'){const cd=mailCD>0;
    b.innerHTML='<p class="mtxt">Bienvenue sur ton poste. Solde : <b>'+Math.floor(coins)+' pièces</b>. Envoyer un faux mail coûte de l\'argent.</p>'+
      '<button class="mopt" data-a="new"'+(cd||coins<5?' disabled':'')+'>Écrire un faux mail<small>'+(cd?'Délai : encore '+Math.ceil(mailCD)+' s (fais une autre tâche entre-temps)':coins<5?'Il te faut au moins 5 pièces':'Dès 5 pièces • choisis la victime puis le mail')+'</small></button>'+
      (INV.mailx>0?'<button class="mopt" data-a="exp">Faux mail express ×'+INV.mailx+'<small>Objet : sans minijeu, sans frais ni attente</small></button>':'')+
      (INV.rapport>0?'<button class="mopt" data-a="rap">Envoyer le rapport parfait ×'+INV.rapport+'<small>Objet : Sérieux +15, +5 pièces, +5 bosseur</small></button>':'')+
      '<button class="mopt" data-a="plan">Planning d\'absence<small>Programme les tâches de ton avatar quand tu es déconnecté ('+PLAN.length+'/3)</small></button>'+
      '<button class="mopt" data-a="close">Éteindre l\'ordinateur</button>';}
  else if(MG.step==='plan'){b.innerHTML='<p class="mtxt">Choisis jusqu\'à 3 tâches. Quand tu te déconnectes (menu principal), ton avatar reste au magasin comme un PNJ, avec ton nom. Il fait ce qu\'il veut (bêtises, vols, délations) et les collègues peuvent le choper, mais les tâches choisies ici réduisent ses risques. Tes pièces et tes points ne bougent pas. Sans aucune tâche : -1 pièce par jour réel d\'absence.</p>'+TASKS.map(function(t,i){return '<button class="mopt" data-a="ptask" data-i="'+i+'">'+(PLAN.indexOf(t[0])>=0?'☑ ':'☐ ')+t[1]+'<small>Moins de risques de se faire choper à ne rien faire</small></button>';}).join('')+'<button class="mopt" data-a="home">Terminé</button>';}
  else if(MG.step===0){const L=MGR.filter(function(m){return !m.fired;});
    b.innerHTML='<p class="mtxt">Écris un faux mail au nom d\'un manager. Choisis la victime.</p>'+(L.length?L.map(function(m){return '<button class="mopt" data-a="tgt" data-i="'+MGR.indexOf(m)+'">'+m.name+'<small>Réputation '+m.stand+' %</small></button>';}).join(''):'<p class="mtxt">Aucun manager en poste pour le moment.</p>');}
  else if(MG.step===1){b.innerHTML='<p class="mtxt">Quel mail envoyer au nom de '+MG.tgt.name+' ?</p>'+TPL.map(function(t,i){return '<button class="mopt" data-a="tpl" data-i="'+i+'"'+(!MG.express&&coins<t.cost?' disabled':'')+'>'+t.t+'<small>Dégâts '+t.dmg+' • difficulté '+(i+1)+'/5 • '+(MG.express?'gratuit (objet)':t.cost+' pièces')+'</small></button>';}).join('');}
  else if(MG.step===2){b.innerHTML='<div class="mail-prev"><b>À : la directrice</b><br>De : '+MG.tgt.name+'<br>Objet : '+MG.tpl.t+'<br><br>'+MG.tpl.b+'</div><div class="mbar"><i id="mProg"></i></div><div id="mStat">Tout est calme. Tape vite !</div><button class="mtap" data-tap="1">TAPER</button>';}
  else{b.innerHTML='<p class="mtxt">Mail envoyé au nom de '+MG.tgt.name+'. Sa réputation baisse de '+MG.tpl.dmg+' points'+(MG.tgt.fired?' : il est viré !':'.')+' Tu gagnes 8 points de branleur.</p><button class="mopt" data-a="home">Retour au bureau</button><button class="mopt" data-a="close">Éteindre l\'ordinateur</button>';}}
function mailTap(){if(!MG||MG.step!==2)return;
  if(MG.phase==='danger'){if(MG.pt>.25){closeMail();giveBlame('surpris en train d\'écrire un faux mail !',3);}return;}
  MG.prog=Math.min(100,MG.prog+100/MG.tpl.need);
  if(MG.prog>=100){sendMail(MG.tgt,MG.tpl);return;}
  $('mProg').style.width=MG.prog+'%';}
$('mBody').addEventListener('click',function(e){const b=e.target.closest('[data-a]');if(!b||!MG)return;const a=b.dataset.a;
  if(b.disabled)return;
  if(a==='new'){if(mailCD>0||coins<5)return;MG.express=false;MG.step=0;$('mTitle').textContent='Faux mail';renderMail();}
  else if(a==='exp'){if(!(INV.mailx>0))return;MG.express=true;MG.step=0;$('mTitle').textContent='Faux mail express';renderMail();}
  else if(a==='rap'){if(!(INV.rapport>0))return;INV.rapport--;image=Math.min(100,image+15);coins+=5;addW(5);toast('Rapport parfait envoyé ! Sérieux +15, +5 pièces, +5 bosseur.');renderQI();renderMail();}
  else if(a==='tgt'){MG.tgt=MGR[+b.dataset.i];MG.step=1;$('mTitle').textContent='Choisis le mail';renderMail();}
  else if(a==='tpl'){MG.tpl=TPL[+b.dataset.i];if(MG.express){sendMail(MG.tgt,MG.tpl);return;}if(coins<MG.tpl.cost){toast('Pas assez de pièces : '+MG.tpl.cost+' requises.');return;}coins-=MG.tpl.cost;MG.step=2;MG.prog=0;$('mTitle').textContent='Écris le mail';renderMail();setPhase('ok',1.4);}
  else if(a==='plan'){MG={step:'plan'};$('mTitle').textContent='Planning d\'absence';renderMail();}
  else if(a==='ptask'){const k=TASKS[+b.dataset.i][0],ix=PLAN.indexOf(k);if(ix>=0)PLAN.splice(ix,1);else if(PLAN.length<3)PLAN.push(k);else toast('3 tâches maximum.');try{localStorage.setItem(CK('edm_plan'),JSON.stringify(PLAN));}catch(_){}renderMail();}
  else if(a==='home'){MG={step:'h'};$('mTitle').textContent='Ordinateur';renderMail();}
  else if(a==='close')closeMail();});
$('mBody').addEventListener('pointerdown',function(e){if(e.target.closest('[data-tap]')){e.preventDefault();mailTap();}});
$('mClose').addEventListener('click',closeMail);

/* ---------- legende, classement, photo ---------- */
const LEG=[['work','Travail','Ranger rayons et palettes, nettoyer. Pièces, Sérieux et points de bosseur.'],
  ['rest','Pause','Manger, dormir, baby-foot. Faim et points de branleur.'],
  ['sabo','Coups bas','Seau, rats, périmés : les managers nettoient et perdent des points.'],
  ['hack','Piratage','Ordinateurs (faux mails) et PC froid (frigos en panne).'],
  ['steal','Vol','Tiroir-caisse, vitrine, stock. Rapporte gros, mais gare aux regards.'],
  ['spy','Espionnage','Photographier un manager qui fume, dénoncer un collègue.'],
  ['sec','Sécurité','Ronde (3 points), porte de secours, local technique : missions du vigile.'],
  ['boss','Direction','Bureau de la directrice, réservé aux managers.']];
let PAN=null;
function openPan(tab){PAN=tab;uiOpen=true;$('pan').hidden=false;renderPan();}
function closePan(){PAN=null;uiOpen=!!(MG||PHN);$('pan').hidden=true;}
function renderPan(){const b=$('panBody');$('pTabL').classList.toggle('on',PAN==='leg');$('pTabR').classList.toggle('on',PAN==='rank');
  if(PAN==='leg'){b.innerHTML='<p class="mtxt"><b>Maintiens le bouton Agir</b> (ou la touche E) sur un cercle : la barre se remplit. Relâche pour faire une pause, reprends ensuite. Tu restes sur place pendant l\'action.</p>'+
    LEG.map(function(l){return '<div class="lg"><i class="sw" style="background:'+hex6(CAT[l[0]])+'"></i><div><b>'+l[1]+'</b><small>'+l[2]+'</small></div></div>';}).join('')+
    '<p class="mtxt">Un coup bas, un vol ou un piratage vu par un manager, le vigile, la directrice ou une caméra = blâme. Cache-toi derrière les rayonnages de la réserve.</p>';}
  else{const rows=LB.map(function(e){return {n:e.n,w:e.w,b:e.b};}).concat([{n:PNAME,w:SW,b:SB,me:1}]);
    const col=function(t,k){const r=rows.slice().sort(function(a,c){return c[k]-a[k];});return '<div class="lc"><h4>'+t+'</h4>'+r.slice(0,5).map(function(e,i){return '<div class="lr'+(e.me?' me':'')+'"><span>'+(i+1)+'. '+e.n+'</span><b>'+e[k]+'</b></div>';}).join('')+'</div>';};
    b.innerHTML='<div class="lcols">'+col('Meilleur branleur','b')+col('Meilleur bosseur','w')+'</div>'+(SRV.board&&SRV.board.length?'<h4 class="ph3">Meilleurs managers de la saison '+SEASON.n+'</h4>'+SRV.board.slice(0,8).map(function(e){return '<div class="lr'+(e.mine?' me':'')+'"><span>'+e.rk+'. '+String(e.name).replace(/[<>&]/g,'')+'</span><b>'+e.actions+' act. • '+e.salary+' 🪙</b></div>';}).join(''):'')+seasonBox();if(SRV.on&&Date.now()-SRV.bt>15000){SRV.bt=Date.now();sBoard();sHall();}}}
/* v223 : mesure reelle du rythme de gain (pieces et points par heure de jeu), pour regler l'economie */
var ECO=(function(){let o={t:0,c:0,b:0};try{o=Object.assign(o,JSON.parse(localStorage.getItem('edm_eco')||'{}'));}catch(_){}return o;})(),ECP={c:0,b:0,sv:0};
function ecoTick(dt){if(mode!=='zone'||uiOpen){ECP.c=coins;ECP.b=SB;return;}ECO.t+=dt;if(coins>ECP.c)ECO.c+=coins-ECP.c;ECP.c=coins;if(SB>ECP.b)ECO.b+=SB-ECP.b;ECP.b=SB;ECP.sv+=dt;if(ECP.sv>=30){ECP.sv=0;try{localStorage.setItem('edm_eco',JSON.stringify(ECO));}catch(_){}}}
function ecoLine(){if(ECO.t<300)return '<p class="mtxt">📊 Rythme de gain : pas encore assez de jeu pour le mesurer (5 min minimum).</p>';const h=ECO.t/3600;return '<p class="mtxt">📊 Ton rythme réel : <b>'+Math.round(ECO.c/h)+' pièces/h</b> · <b>'+Math.round(ECO.b/h)+' points/h</b> (sur '+Math.round(ECO.t/60)+' min de jeu).</p>';}
function seasonBox(){if(!SRV.on)return ecoLine()+'<p class="mtxt">🏆 Saison '+SEASON.n+' · classement en ligne indisponible (hors connexion).</p>';
  let h='<h4 class="ph3">🏆 Saison '+SEASON.n+' · fin dans '+fmtLeft()+'</h4><p class="mtxt">Chaque lundi : nouveau tirage de poste, classement remis à zéro. Le meilleur manager devient <b>Employé de la semaine</b> : chapeau doré 👑 et bonus.</p>';
  if(!(SRV.board&&SRV.board.length))h+='<p class="mtxt">Aucun manager classé pour l\'instant cette semaine.</p>';
  if(SRV.hall&&SRV.hall.length)h+='<h4 class="ph3">👑 Palmarès</h4>'+SRV.hall.slice(0,5).map(function(e){return '<div class="lr"><span>Saison '+e.season+' · '+String(e.name).replace(/[<>&]/g,'')+'</span><b>'+e.actions+' act.</b></div>';}).join('');
  return ecoLine()+h;}
$('pTabL').addEventListener('click',function(){PAN='leg';renderPan();});
$('pTabR').addEventListener('click',function(){PAN='rank';renderPan();});
$('pClose').addEventListener('click',closePan);

/* ---------- tutoriel ---------- */
const TUTO={
 e:[['🎯','Ton but : devenir manager',['<b>La mission principale</b> : devenir manager. Tous les 3 h 30, un <b>tirage de promotion</b> désigne celui qui a marqué le plus de <b>points de promotion</b> (branleur ×2,5, crasses aux managers ×4, un peu de travail bien fait, gagnés depuis le dernier tirage). Pas de minimum : il faut juste avoir marqué au moins 1 point. Ton score et ton rang sont affichés à droite (🏆).','<b>Sabote les managers et tes collègues</b> pour qu\'ils n\'évoluent pas avant toi… sans te faire prendre.','Se faire prendre coûte des points de promotion : <b>avertissement −5</b>, <b>blâme −20</b>, <b>viré −15 %</b> du score de la période.','Manager, tu as 20 minutes de grâce. Si tu tombes, tu repars niveau 1 employé (pièces et objets gardés, objets verrouillés par niveau).']],
  ['🛒','Ton travail d\'employé',['<b>Maintiens le bouton Agir</b> (ou la touche E / Espace) sur un cercle coloré : la barre se remplit.','Ranger les rayons, les palettes, nettoyer : des <b>pièces</b> et un petit bonus de promotion, mais travailler fait baisser un peu ton branleur (1 point toutes les 6 s au plus, jamais sous le début de ton niveau).','Traîner, téléphoner, voler, saboter : des points de <b>branleur</b>… mais attention aux yeux.']],
  ['👀','Ne te fais pas choper',['Un manager, le vigile, la directrice ou une caméra qui te voit en faute : <b>blâme</b>.','Trop de blâmes : tu perds une vie (3 vies). Cache-toi derrière les rayonnages de la réserve.','Le radar et les cônes de vision montrent qui regarde.']],
  ['📈','Niveaux et objets',['Seuls les points de <b>branleur</b> font monter ton niveau : à chaque niveau, de <b>nouveaux objets</b> (petits au début, plus gros ensuite).','Les objets servent à piéger tes rivaux ou à faire chuter la réputation des managers (poudre à gratter, rumeur, lettre anonyme, complot…).','Voler : si tu es pris, tu rembourses l\'objet. Pas assez d\'argent ? Le reste est <b>retenu sur ton salaire</b> (« payé, mais −1 retenu pour vol »).','Tu as deux carrières : chaque rôle garde son propre niveau.']],
  ['📱','Smartphone et boutique',['Touche 📱 (ou P) : boutique d\'objets (coussin, gilet, pétard, extincteur, banane, café, rapport parfait…).','Messages, mails piégés, rapport parfait à envoyer depuis un ordinateur.','Pense à la <b>pause</b> : pointe à la pointeuse, mange, va aux toilettes.']],
  ['🕵️','Bêtises et sabotages',['Dénoncer un collègue ou photographier un manager qui fume (espionnage).','Faire pleurer une caissière, bloquer l\'ascenseur du Drive, écraser un driver, mettre le feu à la friteuse, déclencher l\'alarme incendie…','Plus c\'est méchant, plus ça rapporte en branleur. Plus ça se voit, plus ça coûte.']],
  ['⭐','La mission prioritaire',['Une <b>étoile ⭐</b> annonce la quête principale du moment (en haut de l\'écran).','Sur la <b>loupe 🔍</b>, une étoile jaune marque la zone approximative : va-y directement.','Réussie : un bon paquet de pièces.']],
  ['📋','Quand le manager convoque',['Réunion obligatoire : tout le monde en <b>salle de réunion</b> (derrière les bureaux), personne ne sort avant la fin.','Le manager peut te mettre au coin, t\'éjecter de ta chaise, te faire un cadeau empoisonné, projeter un diaporama interminable…','Mais dans la salle, tu peux aussi piéger la réunion.']],
  ['💨','Piéger la salle de réunion',['Achète les objets au téléphone (aux toilettes), puis pose-les sur les <b>anneaux dorés</b> de la salle, <b>avant</b> une réunion.','<b>Coussin péteur</b> sur un siège : 15 s après qu\'un employé s\'y assoit, POUET, il perd du Sérieux.','<b>Clé USB truquée</b> (ordinateur du projecteur) : une image gênante du manager s\'affiche. <b>Pétard</b> dans la poubelle : elle prend feu. <b>Stroboscope</b> : lumières folles.','Attention : une caméra cachée du vigile peut te filmer et te valoir un blâme.']],
  ['☕','La machine à café',['La machine de la salle de réunion : prends un café (cercle bleu) et promène-toi avec.','Mais en plein magasin, un manager, un vigile ou la directrice qui te voit = <b>blâme</b>. Il refroidit en 100 s.','Trop d\'employés agglutinés autour : la <b>caméra de la salle</b> les repère, un manager vient les chercher.']],
  ['🏆','Employé du Mois et directeur',['Toutes les 5 minutes environ, un <b>Employé du Mois</b> est élu (employés, managers et toi) : prime, Sérieux en hausse. Un manager élu devient le <b>bras droit</b> de la directrice (immunité).','<b>De temps en temps</b>, la directrice part en <b>vacances</b> : le meilleur manager devient <b>Directeur 4 minutes</b>. Il peut blâmer tout le monde, toi compris, et même saboter le magasin puis accuser un autre manager. Les <b>managers</b> (pas les employés) peuvent le démasquer.','Le <b>vigile</b> (bouton 💼 près de lui) : paye-le pour <b>fermer les yeux</b> ou pour <b>suivre</b> un manager et récolter des preuves.','Quand un manager <b>siffle</b>, toute l\'équipe (vrais joueurs compris) doit faire <b>3 tâches en 1 minute</b>, sinon blâme. Les objets coûtent de plus en plus cher à chaque niveau.']],
  ['🧑‍🏭','Le CSE : élus et grève',['Chaque jour, à <b>minuit</b>, <b>2 joueurs</b> sont élus au CSE pour la journée (pas de PNJ).','Vote toute la journée à la <b>boîte aux lettres</b> de la salle de pause, pour un autre joueur. Sans vote, le jeu désigne les joueurs les plus actifs.','Les élus portent un <b>gilet rouge</b> et sont protégés : <b>5 cartons au lieu de 3</b>. Le bouton <b>✊ Grève</b> donne 45 s d\'immunité, et des <b>missions syndicales</b> rapportent plus de branleur. Les 5 cartons perdus : mise à pied et siège perdu. Au panneau syndical : heure syndicale (annule un blâme) et droit d\'alerte (−10 de réputation à un manager).','La salle de pause a aussi une <b>machine à café</b> (+2 bosseur).']],
  ['🚽','Toilettes, café et hygiène',['Les toilettes ont une cabine <b>Hommes</b> et une cabine <b>Femmes</b> : un homme dans les toilettes des femmes déclenche une <b>alerte</b> (manager et vigile) et un blâme.','Dans une cabine, utilise le cercle pour faire pipi, caca, laisser des traces ou <b>tout boucher au papier</b> (inondation, toilettes bloquées 1 min). Des collègues trouvent les toilettes sales et <b>dénoncent la dernière personne entrée</b>.','Lave-toi les mains aux <b>lavabos</b> ! Sinon un collègue ou un manager peut te dénoncer.','Le <b>café</b> coûte 1 pièce, et tu te promènes avec la tasse (attention aux managers).','Inondation : toute la pièce est <b>condamnée</b> (tu es éjecté, entrée interdite 1 min). Seuls les <b>managers</b> peuvent y entrer pour <b>déboucher</b> (30 s), puis désigner un employé pour nettoyer.','<b>Envie</b> : la jauge monte avec le temps et quand tu manges trop sans faim (prouts, collègues qui se plaignent). Si les toilettes du personnel sont bouchées, cours aux <b>toilettes clients</b> (parking) : s\'il y a un client, tu risques l\'accident (−15 Sérieux). Un homme de ménage PNJ (Mika) nettoie de temps en temps : ne salis pas juste après lui ! Items : <b>Inspection d\'hygiène</b> (fait chuter les managers) et <b>Scotch « Hors service »</b>.']],['👥','Parties en ligne',['<b>10 joueurs maximum</b> : 3 managers joueurs au plus, un seul vigile joueur, le reste en employés. Quand un manager PNJ est viré et remplacé par un joueur, il redevient employé PNJ : le nombre de managers (5) et d\'employés reste stable.','5 <b>vigiles PNJ</b> : 2 au magasin, un réserve/bureaux, un au parking et un qui fait parking ↔ Drive. Une <b>caméra</b> surveille maintenant le Drive.','En ligne, un petit compteur affiche la fluidité (images par seconde) et le nombre de joueurs.']]],
 m:[['👔','Ton rôle de manager',['<b>Fumer</b> une clope (cercle de la terrasse ou du local) fait baisser ton stress : tu gagnes des points de <b>bosseur</b> et donc des niveaux.','Mets la <b>pression</b> aux employés fautifs : reste derrière eux, ils bossent plus vite.','Les <b>Résultats</b> (jauge /100) montent quand le magasin tourne et baissent sinon : à 0, la directrice te vire.','Ordinateur : caméras, planning, convocations, mails.']],
  ['🚨','Signalements',['Sur ton téléphone (onglet messages) : des employés signalent des fautes, des collègues qui fument…','Les signalements de <b>vrais joueurs</b> sont fréquents, ceux des PNJ sont rares : va sur place.','Une mauvais Sérieux de manager attire les ennuis (rivaux, mur du pire cauchemar).']],
  ['📣','Autorité (onglet 🏢)',['<b>Amendes</b>, <b>pire cauchemar</b> (mur de la honte, 1 fois par jour), <b>corvées</b> et <b>heures forcées</b> (1 à 2 par jour), <b>annonces au micro</b>, <b>réunion obligatoire</b>.','Quotas par jour : choisis bien ta cible.','Humilier tout le monde plombe l\'ambiance : plus aucune progression des employés pendant un moment.']],
  ['🎬','La salle de réunion',['Entre par la porte des bureaux, ou touche la salle sur la loupe 🔍.','Au pupitre : <b>Lancer</b> la réunion, <b>Animer</b> (Employé du Mois, primes, stats en direct, diaporama, mise au coin, siège éjectable, sondage truqué, cadeau empoisonné), <b>Clore</b>.','Plus la réunion est courte, plus elle rapporte (90 s max).','Méfie-toi : des employés peuvent piéger la salle (image gênante, stroboscope, poubelle en feu à éteindre). Et disperse les attroupements du café.']],
  ['🏪','Le magasin, le Drive',['Répare un carreau cassé, passe l\'autolaveuse, éteins un incendie, sers le retrait du Drive, débloque l\'ascenseur.','Le <b>Drive</b> n\'est pas accessible depuis la loupe : on y va en traversant le magasin vers le parking.','Mission prioritaire ⭐ : l\'étoile sur la loupe indique la zone.']],
  ['🧰','Tes objets de manager',['Des objets se débloquent à chaque niveau : <b>humilier</b> un employé, lui faire perdre du Sérieux, le mettre de <b>mauvaise humeur</b> (plus aucune progression de Sérieux), lui coller un blâme, lancer un audit…','Cible surtout l\'employé le mieux vu : c\'est lui qui vise ta place.']],
  ['⚔️','Rivalité et succession',['Les managers PNJ ont une <b>réputation</b> visible. Si l\'un part, le meilleur Sérieux (puis le plus haut niveau) est promu.','Un manager peut te dénoncer à la directrice ou te mettre sur le mur du pire cauchemar.','Les employés peuvent te dénoncer : reste exemplaire quand la directrice rôde.']],
  ['🏆','Employé du Mois et directeur',['Ton but : être élu <b>Employé du Mois</b> (Résultats et Sérieux hauts) : <b>grosse prime</b> et <b>immunité</b>. Le vote revient régulièrement.','Quand la directrice part en <b>vacances</b> (de temps en temps), le <b>meilleur manager</b> devient <b>Directeur 4 minutes</b> : immunité, blâmes, chute des managers, <b>sabotage du magasin</b>… et à son retour <b>désigne un coupable</b> (un autre manager). Mais attention : les autres managers peuvent te <b>filer</b> et relever des preuves sur le rond bleu qui apparaît 30 s après chaque sabotage : 1, 2 puis 3 preuves = tu es démasqué. Tu peux aussi payer un <b>vigile</b> (💼) pour suivre un manager.','Les <b>ordres d\'équipe</b> (sifflet, note, audit, purge…) touchent <b>tout le monde</b>, vrais joueurs compris. Un seul à la fois : un autre manager ne peut pas doubler.','Tu peux aussi <b>saquer les autres managers</b> avec tes objets (ragot, sabotage, poignard, machination…). Les objets coûtent de plus en plus cher : 200 🪙 et plus aux hauts niveaux.']]],
 v:[['🛡️','Ton rôle de vigile',['Tu surveilles le magasin : <b>fouille</b> des employés et des managers.','Gagne des grades et des pièces à chaque fouille réussie.','Le vigile a des missions prioritaires ⭐ propres à son poste.']],
  ['🎒','Le butin',['Tu peux <b>piquer</b> des objets (tentation !) et les ramener à ta voiture au parking.','Les managers et la directrice peuvent te prendre sur le fait : tu es viré du poste.','Bouton 🗑 pour jeter le butin si ça chauffe.']],
  ['🎒','Pupitre et gadgets',['La <b>cabine de sécurité</b> est à l\'entrée du magasin (à gauche de la porte). Les clients (employés et managers) y paient des services : ça remplit ta <b>caisse</b>, que tu relèves au pupitre. Tu y fixes aussi les <b>tarifs</b> (×1, ×1,5, ×2).','Le bouton <b>🎒 Gadgets</b> : talkie-walkie (grade 0), taser (Agent), chien renifleur (Chef d\'équipe), menottes (Responsable sécurité), plus l\'<b>interrogatoire</b> (laisser partir, faire avouer, faire chanter).','Côté employé/manager : au pupitre, tu peux payer le vigile pour qu\'il <b>ferme les yeux</b>, <b>surveille</b> ou <b>pi\u00e8ge</b> un employé (managers).']],
  ['📹','Caméras et salle de réunion',['<b>Planque une caméra</b> dans la salle (cercle près de l\'entrée) : elle filme les employés qui piègent la réunion et leur vaut un blâme.','<b>Pique le vidéoprojecteur</b> (butin ! 30 de valeur) : plus de stats ni de diaporama pendant 4 min.','Les caméras repèrent aussi les attroupements autour de la machine à café.']]],
 l:[['🗺️','La loupe 🔍',['Touche la loupe pour voir <b>tout</b> le magasin : touche une zone pour y aller.','L\'étoile jaune ⭐ marque la zone de la mission prioritaire.','Le <b>Drive</b> reste non cliquable (ascenseur) ; la <b>salle de réunion</b> est cliquable pour les managers.']],
  ['🏬','Les zones',['<b>Magasin</b> et ses caisses, <b>réserve</b>, <b>boulangerie</b>, <b>poissonnerie</b>, <b>toilettes</b>.','<b>Bureaux</b> (informatique, salle de pause), accessibles par la porte du personnel.','<b>Salle de réunion</b> : porte bleue au fond des bureaux.']],
  ['🚗','Parking et Drive',['Le parking relie le magasin à la route ; le Drive prépare les commandes et les remet au retrait.','Tu dois être entré dans l\'entreprise avant d\'agir sur le parking.']],
  ['⌨️','Commandes',['Déplacement : joystick / glisser, ou ZQSD / flèches. Agir : bouton ou E / Espace.','📱 ou P : smartphone. H : guide. L : classement. M ou Échap : loupe.']]]};
const TTAB=[['e','Employé'],['m','Manager'],['v','Vigile'],['l','Lieux']];
let TT={tab:'e',i:0,cb:null};
function tutoOff(){if(globalThis.__notuto)return true;try{return localStorage.getItem('edm_tuto_off')==='1';}catch(_){return false;}}
function showTuto(tab,cb){TT.tab=tab||(ROLE==='v'?'v':ROLE==='m'?'m':'e');TT.i=0;TT.cb=cb||null;uiOpen=true;$('tuto').hidden=false;try{$('tOff').checked=localStorage.getItem('edm_tuto_off')==='1';}catch(_){}renderTuto();}
function renderTuto(){const P=TUTO[TT.tab],p=P[TT.i];
  $('tTabs').innerHTML=TTAB.map(function(t){return '<button class="ttab'+(t[0]===TT.tab?' on':'')+'" data-t="'+t[0]+'">'+t[1]+'</button>';}).join('');
  $('tBody').innerHTML='<div class="tbig">'+p[0]+'</div><div class="tti">'+p[1]+'</div><ul class="tul">'+p[2].map(function(l){return '<li>'+(TT.tab==='e'?noSW(l):l)+'</li>';}).join('')+'</ul>';
  $('tDots').innerHTML=P.map(function(_,i){return '<i'+(i===TT.i?' class="on"':'')+'></i>';}).join('');
  $('tPrev').style.visibility=TT.i?'visible':'hidden';$('tNext').textContent=TT.i<P.length-1?'▶':'Jouer ✓';}
function closeTuto(){$('tuto').hidden=true;uiOpen=!!(MG||PHN||PAN);const cb=TT.cb;TT.cb=null;if(cb)cb();}
$('tTabs').addEventListener('click',function(e){const b=e.target.closest('button');if(!b)return;TT.tab=b.dataset.t;TT.i=0;renderTuto();});
$('tPrev').addEventListener('click',function(){if(TT.i>0){TT.i--;renderTuto();}});
$('tNext').addEventListener('click',function(){if(TT.i<TUTO[TT.tab].length-1){TT.i++;renderTuto();}else closeTuto();});
$('tSkip').addEventListener('click',closeTuto);
$('tOff').addEventListener('change',function(){try{localStorage.setItem('edm_tuto_off',$('tOff').checked?'1':'0');}catch(_){}});
$('pTabT').addEventListener('click',function(){closePan();showTuto();});
$('bHelp').addEventListener('click',function(){openPan('leg');});$('bLog').addEventListener('click',logOpen);$('logx').addEventListener('click',logClose);$('logp').addEventListener('click',function(e){if(e.target===$('logp'))logClose();});$('objs').addEventListener('click',function(){qjOpen();});$('bQJ').addEventListener('click',function(){qjOpen();});
$('bRank').addEventListener('click',function(){openPan('rank');});

/* ---------- smartphone : boutique + inventaire ---------- */
const ITEMS=[
 {id:'papier',n:'Papier dans le dos',ic:'📝',p:12,t:'b',th:20,k:'dirback',d:'À coller dans le DOS de la directrice (colle-toi derrière elle quand elle est de dos) : +10 branleur, elle se balade avec « Je suis nulle » 45 s.'},
 {id:'banane',n:'Peau de banane',ic:'🍌',p:18,t:'b',th:30,k:'floor',d:'À poser dans les ALLÉES du magasin : la directrice, un manager ou un vigile qui passe dessus s\'étale.'},
 {id:'coussin',n:'Coussin péteur',ic:'💨',p:12,t:'b',th:10,k:'seat',d:'À poser sur un SIÈGE de bureau : le manager qui s\'en approche s\'assoit… POUET, il tombe.'},
 {id:'petard',n:'Pétard dans la poubelle',ic:'🧨',p:15,t:'b',th:15,k:'bin',d:'À glisser dans une POUBELLE : BOUM, managers, vigiles et directrice proches sursautent 3 s.'},
 {id:'brouil',n:'Brouilleur de caméras',ic:'📡',p:20,t:'b',th:20,k:'panel',d:'À brancher sur un TABLEAU ÉLECTRIQUE : toutes les caméras sont aveugles 20 s.'},
 {id:'mailx',n:'Faux mail express',ic:'✉️',p:25,t:'b',th:25,pc:1,d:'À utiliser sur un ORDINATEUR : envoie un faux mail sans minijeu, sans frais ni attente.'},
 {id:'deguis',n:'Déguisement de collègue',ic:'🥸',p:30,t:'b',th:30,k:'locker',d:'À enfiler aux CASIERS de la salle de pause : managers et directrice ne te reconnaissent plus 25 s (pas les vigiles ni les caméras).'},
 {id:'cafe',n:'Café piégé',ic:'☕',p:14,t:'b',th:35,k:'coffee',d:'À glisser dans la MACHINE À CAFÉ : le manager qui vient en boire file aux toilettes et perd de la réputation.'},
 {id:'gilet',n:'Gilet « je suis débordé »',ic:'🦺',p:20,t:'w',th:10,k:'locker',d:'À enfiler aux CASIERS de la salle de pause : 40 s sans soupçon ni ordre des managers.'},
 {id:'batte',n:'Batte de baseball',ic:'🏏',p:10,t:'b',th:10,d:'3 coups : bouton « Batte » près d\'un client (moins de 1,5 m) : +8 branleur. Un manager, un vigile ou une caméra qui te voit = blâme. Un pompier emporte le client et la directrice devient furieuse.',passive:1},
 {id:'ext',n:'Extincteur perso',ic:'🧯',p:15,t:'w',th:15,d:'Passif : éteint un feu (voiture ou station) en 1,2 s au lieu de 4 s, avec bonus.',passive:1},
 {id:'rapport',n:'Rapport parfait',ic:'📊',p:35,t:'w',th:25,pc:1,d:'À envoyer depuis un ORDINATEUR : Sérieux +15, +5 pièces, +5 bosseur.'}];
ITEMS.push({id:'jumelles',n:'Jumelles',ic:'🔭',p:12,t:'m',th:0,d:'Double la portée de ton radar pendant 25 s.'},
 {id:'micro',n:'Micro-espion',ic:'🎙️',p:20,t:'m',th:0,d:'À poser sur l\'employé le plus proche : sa jauge de preuve se remplit tant qu\'il fait une faute (60 s).'},
 {id:'tampon',n:'Tampon « blâme »',ic:'🟥',p:25,t:'m',th:0,d:'Ta prochaine sanction sera un blâme direct, même sans preuve suffisante.'},
 {id:'note',n:'Note de service',ic:'📋',p:15,t:'m',th:0,fx:'note',d:'Ordre d\'équipe : plus aucune faute pendant 25 s. Résultats +6.'},
 {id:'sifflet',n:'Sifflet',ic:'📣',p:10,t:'m',th:0,fx:'sifflet',d:'Ordre à TOUTE l\'équipe (joueurs réels compris) : tout le monde se remet au travail et doit faire 3 tâches de bosseur en 1 min, sinon blâme. Un seul ordre d\'équipe à la fois (un autre manager ne peut pas le doubler).'});
ITEMS.push({id:'cle',n:'Clé USB truquée',ic:'💾',p:22,t:'b',th:20,k:'proj',d:'À brancher sur l\'ORDINATEUR du vidéoprojecteur (salle de réunion) : à la prochaine réunion, une image gênante du manager s\'affiche devant tout le monde.'},
 {id:'strobo',n:'Stroboscope',ic:'🪩',p:25,t:'b',th:25,k:'strobo',d:'À brancher sur la CONSOLE LUMIÈRE (salle de réunion) : les lumières clignotent 40 s pendant la prochaine réunion.'});
const ISPOTS=[],SPL={proj:'l\'ordinateur du vidéoprojecteur (salle de réunion)',strobo:'la console lumière (salle de réunion)',seat:'un siège de bureau',bin:'une poubelle',panel:'un tableau électrique',locker:'les casiers de la salle de pause',coffee:'la machine à café'};
(function(){const ring=function(zn,k,x,z){const m=new T.Mesh(new T.RingGeometry(.55,.75,28),new T.MeshBasicMaterial({color:0xffd23f,transparent:true,opacity:.9,depthWrite:false}));m.rotation.x=-Math.PI/2;m.position.set(x,.06,z);m.visible=false;Z[zn].g.add(m);ISPOTS.push({k:k,zn:zn,x:x,z:z,ring:m});};
  SEATP.forEach(function(q){ring('office','seat',q[0],q[1]);});
  [['store',-5.7,-.4],['store',1.3,-11.4],['store',40.3,-9.75],['reserve',0,-40.4],['parking',-3.7,30],['office',19.4,-32],['office',55,-40.5]].forEach(function(b){const g=Z[b[0]].g;cyl(g,.3,.24,.7,0x4a5568,b[1],.35,b[2],true);cyl(g,.32,.32,.06,0x2d3748,b[1],.72,b[2],false);ring(b[0],'bin',b[1],b[2]);});
  [['store',-12,-10.2],['reserve',11,-39.5],['parking',17,30],['office',34,-37.6]].forEach(function(b){const g=Z[b[0]].g;box(g,.9,1.3,.25,0xf2c230,b[1],.9,b[2],true);box(g,.5,.4,.05,0x222222,b[1],1.1,b[2]+.14,false);ring(b[0],'panel',b[1],b[2]);});
  [[41.2,-37]].forEach(function(b){const g=Z.office.g;[0,1,2].forEach(function(i){box(g,.5,1.7,.5,[0x3b6fb5,0x4a86d0,0x2f5a96][i],b[0]+(i-1)*.55,.85,b[1],true);});ring('office','locker',b[0],b[1]+.9);});
  [[58.4,-40.5]].forEach(function(b){const g=Z.office.g;box(g,.7,1.1,.6,0x6d4c41,b[0],.55,b[1],true);box(g,.3,.25,.3,0xf5f5f5,b[0],.5,b[1]+.25,false);ring('office','coffee',b[0],b[1]+.9);});})();

/* ---------- reserve elargie : quai, camions, stockages, frigos, balle a cartons ---------- */
const BAYS=[],RES={cN:20,ct:0,pv:0,pvs:0,anger:0,cT:0,bT:0,pT:0,stT:0,nextT:15,regT:0,bal:0,cp:0},BAL={broken:false,t:0,hit:false,full:false};
let BLM=[],CHM=[];function pressOne(){RES.cp++;if(RES.cp>=3){RES.cp=0;if(RES.bal<10){RES.bal++;if(RES.bal===5){toast('5 balles pressées : un camion doit venir les charger !');RES.nextT=Math.min(RES.nextT,18);BAYS.forEach(function(b){if(b.state==='docked')b.dwell=Math.max(b.dwell,40);});}}}}
let CTM=[],PVM=[],PVG=null,BALL=null,BALLAMP=null,SIGNMK=null;
function dynLabel(w,h,sx,sy){const cv=document.createElement('canvas');cv.width=w;cv.height=h;const tex=ctex(cv);const sp=new T.Sprite(new T.SpriteMaterial({map:tex,transparent:true,toneMapped:false,depthTest:false}));sp.scale.set(sx*1.18,sy*1.18,1);
  return {sp:sp,k:'',draw:function(txt,bg){const key=txt+bg;if(key===this.k)return;this.k=key;const x=cv.getContext('2d');x.clearRect(0,0,w,h);x.fillStyle=bg;rr(x,2,2,w-4,h-4,14);x.fill();x.fillStyle='#fff';x.font='600 '+Math.round(h*.42)+'px Fredoka,system-ui,sans-serif';x.textAlign='center';x.textBaseline='middle';x.fillText(txt,w/2,h/2+2);tex.needsUpdate=true;}};}
function drawTruck(b){b.lab.draw('Camion '+(b.i+1)+' : '+b.left+'/'+b.load+' palettes',(b.left>0&&b.dwell<35)?'rgba(214,40,57,.96)':'rgba(18,32,54,.93)');b.piles.forEach(function(p,k){p.visible=k<b.pile;});}
function callTruck(b){b.state='arrive';b.x=-84;b.load=4+((Math.random()*3)|0);b.left=b.load;b.signed=false;b.warned=false;b.help=0;b.npcT=0;b.pile=Math.min(b.pile,6);b.dwell=115;b.tr.visible=true;drawTruck(b);}
function setDZone(zn){D.zn=zn;Z[zn].g.add(dirc);Z[zn].g.add(dcone.grp);D.path=null;}
function addAnger(n){if(D.rage>0)return;RES.anger+=n;if(RES.anger>=100){RES.anger=0;startRage();}else if(n>=20)toast('La directrice bouillonne… (colère '+Math.round(RES.anger)+' %)');}
function startRage(){if(D.rage>0)return;D.rage=1;D.ti=0;D.sayT=0;D.stun=0;
  D.tour=[{zn:'store',x:14,z:12.6},{zn:'store',x:-14,z:12.6},{zn:'store',x:-27.2,z:8.6,hop:'reserve',tx:8,tz:-27.2},
    {zn:'reserve',x:-2,z:-33.5,w:1},{zn:'reserve',x:-17.5,z:-31.8,w:1.5},{zn:'reserve',x:-25.5,z:-35.6,w:1.5},{zn:'reserve',x:-32,z:-35.8,w:3},{zn:'reserve',x:-37.3,z:-31,w:3},{zn:'reserve',x:-20,z:-35.5,w:1},{zn:'reserve',x:8,z:-26.9,hop:'store',tx:-26.4,tz:-8.3},
    {zn:'store',x:-14,z:-11.4},{zn:'store',x:14,z:-11.4},{zn:'store',x:32,z:-.4},{zn:'store',x:30.45,z:17.6,hop:'parking',tx:0,tz:26},
    {zn:'parking',x:0,z:34},{zn:'parking',x:-18,z:34,w:1},{zn:'parking',x:8,z:44,w:1.5},{zn:'parking',x:22,z:33,w:1},{zn:'parking',x:0,z:25.2,hop:'store',tx:30.45,tz:16.4},
    {zn:'store',x:14,z:12.6},{zn:'store',x:14,z:-.4}];
  if(D.zn!=='store')setDZone('store');
  const f=D.tour[0];D.path=path(Z[D.zn],D.x,D.z,f.x,f.z);D.pi=0;D.wait=.1;dirc.scale.setScalar(1.4);dTagR.visible=true;dTag.visible=false;
  toast('LA DIRECTRICE EST HORS D\'ELLE ! Elle fait le tour du magasin, des réserves et du parking. Bosse ou planque-toi !');}
const MESS=[];
function messAt(x,z){const g=new T.Group();g.position.set(x,0,z);for(let i=0;i<5;i++){const c=PROD[(Math.random()*PROD.length)|0];box(g,.3+Math.random()*.2,.25,.3,c,(Math.random()-.5)*1.6,.13,(Math.random()-.5)*1.6,false).rotation.y=Math.random()*3;}const sl=label('⚠ Sol sale',{sx:1.5,sy:.4,w:256,h:64,size:30,bg:'rgba(230,160,20,.96)',fg:'#10151f',depth:false});sl.position.y=1.5;g.add(sl);S.g.add(g);const me={g:g,t:100,age:0};MESS.push(me);if(MESS.length>14){const o=MESS.shift();S.g.remove(o.g);}return me;}
function resetRes(){if(typeof resetSys2==='function')resetSys2();if(typeof resetShelves==='function')resetShelves();MESS.forEach(function(o){S.g.remove(o.g);});MESS.length=0;RES.nextT=25;RES.bal=0;RES.cp=0;RES.ct=0;RES.cN=20;RES.cT=0;RES.pv=0;RES.pvs=0;RES.anger=0;BAL.broken=false;BAL.t=0;BAL.hit=false;
  BAYS.forEach(function(b){b.state='idle';b.t=25+b.i*20;b.tr.visible=false;b.x=-80;b.tr.position.x=-80;b.pile=0;b.left=0;b.mk.off=true;drawTruck(b);});
  if(D.rage>0){D.rage=0;D.tour=null;dirc.scale.setScalar(1.06);dTagR.visible=false;dTag.visible=true;}if(D.zn!=='store')setDZone('store');}
function updRes(dt){
  if(!BAYS.some(function(b){return b.state!=='idle';})){RES.nextT-=dt;if(RES.nextT<=0)callTruck(BAYS[(Math.random()*2)|0]);}
  RES.regT+=dt;if(RES.regT>30){RES.regT=0;MGR.forEach(function(m){if(!m.fired&&m.stand<100){m.stand++;drawM(m);}});}
  BAYS.forEach(function(b){
    if(b.state==='idle'){}
    else if(b.state==='arrive'){b.x+=dt*9;if(b.x>=-41.9){b.x=-41.9;b.state='docked';drawTruck(b);toast('Un camion arrive au quai '+(b.i+1)+' : '+b.load+' palettes à décharger.');}}
    else if(b.state==='docked'){b.dwell-=dt;b.npcT+=dt;if(b.npcT>45&&b.left>0){b.npcT=0;b.left--;b.pile=Math.min(6,b.pile+1);}
      if(b.left>0&&b.dwell<35&&!b.warned){b.warned=true;toast('ATTENTION : le camion '+(b.i+1)+' n\'est pas déchargé, il va repartir !');}
      if(b.dwell<=0){b.state='leave';if(b.left>0){const n=b.left;b.left=0;addAnger(15*n);toast('Le camion '+(b.i+1)+' repart avec '+n+' palette'+(n>1?'s':'')+' non déchargée'+(n>1?'s':'')+' ! La directrice est furieuse.');}}drawTruck(b);}
    else if(b.state==='leave'){b.x-=dt*9;if(b.x<-84){b.state='idle';b.tr.visible=false;RES.nextT=70+Math.random()*60;}}
    b.tr.position.x=b.x;b.mk.off=!(b.state==='docked'&&b.left>0);});
  SIGNMK.off=!BAYS.some(function(b){return b.state==='docked'&&b.left===0&&!b.signed;});
  let tot=0;BAYS.forEach(function(b){tot+=b.pile;});
  RES.stT+=dt;if(RES.stT>40&&tot>0){RES.stT=0;const bb=BAYS.slice().sort(function(a,c){return c.pile-a.pile;})[0];bb.pile--;RES.pv++;drawTruck(bb);}
  if(tot>=5)addAngerSlow(dt*2.2);if(RES.bal>=5)addAngerSlow(dt*1.5);if(RES.ct>=8)addAngerSlow(dt);if(MESS.length>=6)addAngerSlow(dt*.8);
  RES.cT+=dt;if(RES.cT>(BAL.broken?Math.min(RES.cN,4):RES.cN)){RES.cT=0;if(BAL.broken){RES.cN=8;if(RES.ct<26)RES.ct++;}else{RES.cN=25+Math.random()*45;const r=Math.random(),n=r<.4?1:r<.7?2:r<.9?3:4;RES.ct=Math.min(12,RES.ct+n);}}
  BAL.full=RES.bal>=10;
  if(BAL.full&&!BAL.warnF){BAL.warnF=true;pop('🗜️ La balle à cartons est pleine : il faut la vider (réserve).','bad');}if(!BAL.full)BAL.warnF=false;
  if(!BAL.broken){if(!BAL.full){RES.bT+=dt;if(RES.bT>20&&RES.ct>=4){RES.bT=0;RES.ct--;pressOne();}}}
