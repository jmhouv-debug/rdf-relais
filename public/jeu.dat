 const o=T2.o,guilty=T2.k==='e'?(o.loot>0||!!o.f):!!o.loot,pk=function(a){return a[(Math.random()*a.length)|0];};
 dlg('🗣️ Interrogatoire : '+o.name,'Il transpire…',[
  {t:'Le laisser partir',f:function(){chat(o,'Circulez, il n\'y a rien à voir.','Merci, chef !');}},
  {t:'Le faire avouer',f:function(){
    if(guilty){chat(o,pk(['Allez, avoue, on sait tout !','Dix secondes pour me dire la vérité…']),pk(['Bon… d\'accord, c\'est moi !','Ok ok, j\'ai fait une bêtise !']));
      setTimeout(function(){gradeXp();if(T2.k==='e'){addBl(o);o.loot=0;if(o.f)endFault(o);}else{hitMgr(o,15);o.loot=null;}coins+=4;RESULT=Math.min(100,RESULT+4);say(pl,'Blâme pour toi ! (+4 🪙)');},2000);}
    else{chat(o,pk(['Tu as l\'air bien nerveux, toi…','Qu\'est-ce que tu me caches ?']),pk(['Mais je n\'ai rien fait, je vous jure !','Vous faites erreur !']));RESULT=Math.max(0,RESULT-3);}}},
  {t:'Annuler'}]);}
