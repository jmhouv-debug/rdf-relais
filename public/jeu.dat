  const R=QM.R.map(function(r){return [Math.ceil(r.cd>0?r.cd:0),Math.ceil(r.lk>0?r.lk:0),Math.round(r.prog*100),r.cnt|0,r.done?1:0,r.both?1:0];});
  const K=QM.key,k={st:K.st,zn:K.zn,x:K.x,z:K.z,by:K.by?K.by.id:-1,room:K.room||''};
  qnS('s',{t:Math.round(QM.t*10)/10,j:Math.round(QM.j*10)/10,dc:QM.decoy>0?1:0,H:H,A:A,R:R,k:k,pu:Math.round(QM.pup.prog*100),mu:QM.meetUsed?1:0,ft:QM.firstTeam?1:0,
    C:QM.CE.map(function(n){return [r1(n.x),r1(n.z),Math.ceil(n.ko||0),n.chase?1:0,n.cid,n.zn,n.ty||1,n.gone>0?1:0];}),QS:QM.QS.filter(function(q){return !q.done;}).map(function(q){return [q.id,q.t,q.ids.join('|'),q.room||'',q.nm,q.zn||'',q.own,q.n,q.ids.map(function(id){const r=QM.R.find(function(x){return x.id===id;});return r?[r.k,r.need||0,r.pair||'',r.dur]:0;})];}),IN:Math.ceil(QM.insp||0),CV:QM.CV?QCVK.filter(function(k){return QM.CV[k]&&QM.A.some(function(a){return a.cv&&a.cv.k===k;});}).map(function(k){return [k,QM.CV[k].seed,Math.round(QM.CV[k].t0*10)/10];}):[],CN:Z.cv_arch&&Z.cv_arch.cv&&Z.cv_arch.cv.npc?Z.cv_arch.cv.npc.map(function(n){return [r1(n.x),r1(n.z),n.st==='chase'?1:0,n.stun>0?1:0];}):0,FR:QM.freeR?[Math.round(QM.freeR.prog*100),QM.freeR.n]:0,F:QM.FY.map(function(f){return [r1(f.x),r1(f.z),r1(f.h),Math.ceil(f.ko||0)];}),
    L:Object.keys(QM.lockR).join(','),LZ:Object.keys(QM.lockZ).join(','),S:[QM.stg.i,QM.stg.n],B:QM.boss?[QM.boss.i,r1(QM.boss.x),r1(QM.boss.z),r1(QM.boss.h),QM.boss.hp,QM.boss.max,QM.boss.dead?1:0,QM.boss.stun>0?1:0,QM.boss.intro>0?1:0,QM.boss.zn,QM.arena?[QM.arena.ph==='loot'?1:0,Math.round(QM.arena.t)]:0,QM.boss.mins.map(function(m){return [r1(m.x),r1(m.z),r1(m.h),m.ko>0?(m.ko>50?2:1):0];}),QM.boss.sh>0?Math.round(QM.boss.sh/QM.boss.shMax*100):0,QM.boss.tired>0?1:0,QM.boss.air?1:0]:0,BZ:(QM.BZ||[]).map(function(z){return [z.id,z.k,r1(z.x),r1(z.z),z.r||0,r1(z.h||0),z.len||0,z.w||0,z.a||0,Math.round((z.t||0)*10)/10,z.t0||0];}),WP:(QM.WP||[]).map(function(w){return [w.id,w.k,w.zn,r1(w.x),r1(w.z)];}),BX:(QM.BX||[]).map(function(b){return [b.id,b.zn,r1(b.x),r1(b.z),b.ch||0];}),HZ:(QM.HZ||[]).map(function(e){return [e.id,r1(e.x),r1(e.z),e.ty,e.ko>0?1:0];}),AR:QM.arena?[QM.arena.zid,QM.arena.kind,QM.arena.ph==='loot'?1:0,Math.round(QM.arena.t),QM.arena.wave||0,QM.arena.nw||0,QM.arena.wk||'',QM.arena.wsz||0]:0,BN:QM.bossN||0,TR:(QM.TR||[]).map(function(t){return [t.id,t.k,t.zn,r1(t.x),r1(t.z),t.cd>0?1:0];}),DG:QM.dog?[r1(QM.dog.x),r1(QM.dog.z)]:0,DT:Math.ceil(QM.dmgT||0),M:QM.R.map(function(r){return r.act?(r.dbl?3:r.duo?2:1):0;}).join(''),I:QM.IT.map(function(it){return [it.id,it.k,it.zn,r1(it.x),r1(it.z)];}),
