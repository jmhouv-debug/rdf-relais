 for(let i=0;i<22;i++){const a=Math.random()*6.283,r=85+Math.random()*38,px=128+Math.cos(a)*r,py=128+Math.sin(a)*r,rad=2+Math.random()*5;x.fillStyle='rgba('+col+',.9)';x.beginPath();x.arc(px,py,rad,0,6.283);x.fill();
  x.strokeStyle='rgba('+col+',.7)';x.lineWidth=rad*.6;x.beginPath();x.moveTo(128+Math.cos(a)*(r-26),128+Math.sin(a)*(r-26));x.lineTo(px,py);x.stroke();}
 if(drip){for(let i=0;i<6;i++){const px=60+Math.random()*136,len=30+Math.random()*90;x.strokeStyle='rgba('+col+',.85)';x.lineWidth=3+Math.random()*5;x.beginPath();x.moveTo(px,120);x.lineTo(px+(Math.random()-.5)*6,120+len);x.stroke();x.fillStyle='rgba('+col+',.9)';x.beginPath();x.arc(px,120+len,x.lineWidth*.9,0,6.283);x.fill();}}
