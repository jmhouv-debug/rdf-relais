  const el1=label('EN PANNE',{sx:2,sy:.5,w:256,h:64,size:34,bg:'rgba(214,40,57,.97)',depth:false});el1.position.set(x0+1,3.4,-4);el1.visible=false;g.add(el1);ELEV.sign=[el1];
  obs(D,x0+.8,-4,1.4,3.4);
