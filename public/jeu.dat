  if(D.rage>0&&cur===D.zn&&mode==='zone'){D.sayT-=dt;if(D.sayT<=0){D.sayT=5+Math.random()*3;say(dirc,['AU TRAVAIL !!','Qui a fait ça ?!','Je veux des résultats !','C\'est inadmissible !','Plus vite !!'][(Math.random()*5)|0]);}}
