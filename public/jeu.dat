<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style><link rel="manifest" href="/app.webmanifest"><meta name="theme-color" content="#0f1b2e"><link rel="icon" href="/edm-icon-192.png"><link rel="apple-touch-icon" href="/edm-icon-180.png"><meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="Employé du Mois"></head><body>
<title>Employé du Mois</title>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600&display=swap">
<style>
/* Concept : jeu 3D isométrique, HUD réduit au texte, accents or / vert / rouge alerte. */
:root{
  --bg:#0f1b2e; --fg:#f3f6fb; --muted:#d3deee; --panel:rgba(18,32,54,.8); --edge:rgba(255,255,255,.22);
  --gold:#f5b82e; --green:#3cc47c; --red:#e5484d;
  --display:'Fredoka',system-ui,-apple-system,'Segoe UI',sans-serif;
  color-scheme:dark;
}
html,body{height:100%;height:100dvh}
[hidden]{display:none!important}
body{background:var(--bg);color:var(--fg);font-family:var(--display);overflow:hidden;-webkit-user-select:none;user-select:none}
#app{position:relative;height:100%;height:100dvh;overflow:hidden;touch-action:none}
#c{position:absolute;inset:0;width:100%;height:100%;display:block}#nightMsg{position:absolute;left:0;right:0;top:20%;text-align:center;padding:0 18px;pointer-events:none;z-index:8;opacity:0;transition:opacity 1s;font:700 26px/1.25 var(--display);color:#cfe0ff;text-shadow:0 2px 14px #000,0 0 6px #000}#nightMsg.on{opacity:1}#nightMsg small{display:block;margin-top:10px;font:600 16px/1.3 var(--display);color:#ffe9a8}#bTorch{background:rgba(255,214,102,.97);color:#1b2433;font-size:10px}#bTorch.off{background:rgba(70,80,100,.95);color:#dbe7f7}
#dk{position:absolute;inset:0;width:100%;height:100%;display:block;pointer-events:none}
.hud{position:absolute;pointer-events:none;text-shadow:0 1px 3px rgba(0,0,0,.95),0 0 10px rgba(0,0,0,.6)}
#vig{position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at center,transparent 64%,rgba(8,14,28,.34))}
#tl{top:max(10px,env(safe-area-inset-top,0px));left:max(12px,env(safe-area-inset-left,0px));max-width:60vw;font-size:13px;line-height:1.4}
#tl small{display:block;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:2px}
#objs .ok{opacity:.5;text-decoration:line-through}
#tr{top:max(10px,env(safe-area-inset-top,0px));right:max(12px,env(safe-area-inset-right,0px));display:flex;flex-direction:column;align-items:flex-end;gap:5px;font-size:13px;font-variant-numeric:tabular-nums}
#tr .row{display:flex;gap:10px}
#tr b{color:var(--gold);font-weight:600}
.mini{font-size:10px;color:var(--muted);width:90px;text-align:right}
.bar{height:5px;border-radius:3px;background:rgba(255,255,255,.2);margin-top:2px;overflow:hidden}
.bar i{display:block;height:100%;border-radius:3px;width:100%}
#hunger i{background:var(--green)}
#urg i{background:#c98a2b}
#res i{background:var(--gold)}
#comp i{background:#7ab8ff}
#rdr i{background:#ff5a5a}
#rglow{position:fixed;inset:0;pointer-events:none;z-index:6;opacity:0;box-shadow:inset 0 0 70px 14px var(--rc,#ff4040);transition:opacity .08s}
#stam i{background:#5ad6a0}
#bDrop{background:rgba(200,80,60,.95);color:#fff}#bFork{background:rgba(60,140,200,.97);color:#fff;font-size:10px}#bMach{background:rgba(230,140,40,.97);color:#fff;font-size:10px}#bLet{background:rgba(120,90,200,.96);color:#fff;font-size:10px}
#susp i{background:var(--red);width:0}
#susp{opacity:0;transition:opacity .2s}
#btns{right:max(12px,env(safe-area-inset-right,0px));bottom:max(16px,env(safe-area-inset-bottom,0px));display:flex;gap:10px;pointer-events:auto;text-shadow:none}
#back{left:max(12px,env(safe-area-inset-left,0px));bottom:max(16px,env(safe-area-inset-bottom,0px));pointer-events:auto;text-shadow:none}
.btn{width:62px;height:62px;border-radius:16px;border:1px solid var(--edge);background:var(--panel);color:var(--fg);font:600 11px var(--display);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;cursor:pointer;-webkit-tap-highlight-color:transparent}
#back .btn{width:46px;height:46px;border-radius:50%}
body[data-mode=map] #back .zo,body[data-mode=create] #back{display:none!important}
#bMsg{position:relative}#bMsgN{position:absolute;top:-4px;right:-4px;min-width:18px;height:18px;border-radius:9px;background:#e5484d;color:#fff;font:600 11px var(--display);display:grid;place-items:center;padding:0 4px}
.btn:active,.btn.on{background:var(--gold);color:#1b2433}
.btn:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
.btn svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
#stick{position:fixed;width:110px;height:110px;border-radius:50%;border:2px solid rgba(255,255,255,.35);background:rgba(255,255,255,.08);pointer-events:none}
#knob{position:absolute;left:35px;top:35px;width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.55)}
#toast{position:absolute;left:50%;top:calc(env(safe-area-inset-top,0px) + 78px);transform:translateX(-50%);padding:7px 14px;border-radius:999px;background:var(--panel);border:1px solid var(--edge);font-size:14px;opacity:0;transition:opacity .25s;pointer-events:none;max-width:92vw;text-align:center}
#toast.on{opacity:1}
#maptitle{left:0;right:0;top:max(16px,env(safe-area-inset-top,0px));text-align:center;font-size:20px;font-weight:600;color:#14243d;text-shadow:0 1px 0 rgba(255,255,255,.6)}
#strobeFx{position:absolute;inset:0;pointer-events:none;z-index:4;display:none;animation:strb .22s steps(1) infinite}#strobeFx.on{display:block}@keyframes strb{0%{background:rgba(255,40,120,.45)}25%{background:rgba(0,0,0,.55)}50%{background:rgba(60,140,255,.45)}75%{background:rgba(255,255,255,.55)}}#alarmFx{position:absolute;inset:0;pointer-events:none;z-index:4;display:none;background:radial-gradient(ellipse at center,rgba(229,72,77,0) 35%,rgba(229,72,77,.55) 100%);animation:almf .45s infinite alternate}#alarmFx.on{display:block}@keyframes almf{from{opacity:.25}to{opacity:1}}
#fade{position:absolute;inset:0;background:#05080f;opacity:0;transition:opacity .28s;pointer-events:none;z-index:5}
#fade.on{opacity:1}
#err{position:absolute;inset:0;display:grid;place-items:center;padding:24px;text-align:center}
body[data-mode=map] .game{display:none!important}
body[data-mode=zone] .maponly{display:none!important}
@media (prefers-reduced-motion:reduce){#toast,#fade{transition:none}}
#roleRv{position:absolute;inset:0;display:grid;place-items:center;background:radial-gradient(circle at 50% 40%,rgba(30,42,68,.97),rgba(5,8,15,.98));z-index:10;padding:16px;text-shadow:none;color:#fff}#roleRv[hidden]{display:none}.rrbox{width:min(420px,100%);text-align:center}.rrk{letter-spacing:.22em;font-size:12px;opacity:.7;font-weight:700}.rric{font-size:84px;line-height:1.1;margin:14px 0 4px}.rric.land{animation:rrpop .55s}@keyframes rrpop{0%{transform:scale(.5)}60%{transform:scale(1.28)}100%{transform:scale(1)}}.rrnm{font-size:30px;font-weight:800;letter-spacing:.05em;min-height:38px}.rrds{font-size:15px;opacity:.92;margin:10px 4px 20px;min-height:66px;line-height:1.4}#roleRv .rrse,.sais{display:block;width:max-content;max-width:100%;margin:0 auto 18px;padding:6px 14px;border-radius:999px;background:#f5b82e;color:#2b1d00;font-weight:800;font-size:12px;letter-spacing:.06em}.sais{margin:8px auto 6px}.rrgl{margin:-6px 4px 20px;padding:10px 12px;border-radius:12px;background:rgba(245,184,46,.14);border:1px solid rgba(245,184,46,.5);font-size:14px;line-height:1.4;text-align:left}.rrgl:empty{display:none}#roleGo{min-height:48px;padding:12px 24px;border-radius:14px;border:0;font-weight:800;font-size:16px;background:linear-gradient(150deg,#46d483,#1e9a57);color:#06210f}#roleGo[hidden]{display:none}
#tuto{position:absolute;inset:0;display:grid;place-items:center;background:rgba(5,8,15,.8);z-index:9;padding:16px;text-shadow:none}#tuto[hidden]{display:none}#tuto .mbox{width:min(460px,100%)}.ttabs{display:flex;gap:5px;margin:10px 0 2px}.ttab{flex:1;padding:7px 2px;border-radius:10px;border:1px solid var(--edge);background:#1d2f4a;color:var(--fg);font:500 13px var(--display);cursor:pointer}.ttab.on{background:var(--gold);color:#1b2433}.tbig{font-size:42px;text-align:center;margin:10px 0 0}.tti{font:700 19px var(--display);text-align:center;margin-top:2px}.tul{margin:10px 0 0;padding-left:18px;font-size:14px;line-height:1.45}.tul li{margin-top:5px}.tul small{color:var(--muted)}.tnav{display:flex;gap:8px;align-items:center;justify-content:space-between;margin-top:14px}.tnav button{padding:9px 14px;border-radius:12px;border:1px solid var(--edge);background:#1d2f4a;color:var(--fg);font:600 14px var(--display);cursor:pointer}.tnav button.go{background:var(--gold);color:#1b2433}.tdots{display:flex;gap:5px}.tdots i{width:7px;height:7px;border-radius:50%;background:#3b5a85}.tdots i.on{background:var(--gold)}.tchk{display:flex;gap:8px;align-items:center;margin-top:12px;font-size:13px;color:var(--muted)}#mail,#pan,#bribe,#pauseM{position:absolute;inset:0;display:grid;place-items:center;background:rgba(5,8,15,.62);z-index:6;padding:16px;text-shadow:none}
.mbox{width:min(420px,100%);max-height:100%;overflow:auto;background:#162338;border:1px solid var(--edge);border-radius:16px;padding:14px 14px 16px;touch-action:manipulation}
.mhead{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:17px;font-weight:600}
.mhead button{background:none;border:0;color:var(--muted);font:600 18px var(--display);cursor:pointer;padding:4px 8px}
.mtxt{margin:8px 0 0;font-size:14px;color:var(--muted);line-height:1.4}
.mopt{display:block;width:100%;text-align:left;padding:11px 12px;margin-top:8px;border-radius:12px;border:1px solid var(--edge);background:#1d2f4a;color:var(--fg);font:500 15px var(--display);cursor:pointer}
.mopt small{display:block;color:var(--muted);font-size:12px;margin-top:2px;font-weight:400}
.mopt:active{background:#2a4469}
.mbar{height:12px;border-radius:6px;background:rgba(255,255,255,.15);overflow:hidden;margin-top:12px}
.mbar i{display:block;height:100%;width:0;background:var(--gold)}
#mStat{margin-top:10px;padding:8px 10px;border-radius:10px;font-size:14px;font-weight:600;text-align:center;background:rgba(60,196,124,.18);color:#8ff0bb}
#mStat.warn{background:rgba(245,184,46,.2);color:#ffd878}
#mStat.danger{background:rgba(229,72,77,.3);color:#ffb3b5}
.mtap{display:block;width:100%;margin-top:12px;padding:20px 10px;border-radius:14px;border:0;background:var(--gold);color:#1b2433;font:600 20px var(--display);cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
.mtap:active{transform:scale(.98)}
.mail-prev{margin-top:10px;padding:10px 12px;border-radius:10px;background:#0e1828;font-size:13px;line-height:1.45;color:var(--muted)}
#sc{font-size:11px;color:var(--muted)}
#back{display:flex;gap:8px}
#wcbar{right:max(12px,env(safe-area-inset-right,0px));bottom:calc(max(16px,env(safe-area-inset-bottom,0px)) + 80px);display:flex;flex-direction:column;gap:8px;pointer-events:auto;text-shadow:none}
.btn[hidden]{display:none!important}
#bAct{touch-action:none}
#pop{position:absolute;left:50%;top:30%;transform:translate(-50%,-50%) scale(.6);max-width:70vw;padding:8px 14px;border-radius:16px;font:700 15px/1.25 var(--display);text-align:center;color:#fff;background:rgba(40,60,100,.94);border:2px solid #fff;box-shadow:0 6px 22px rgba(0,0,0,.5);opacity:0;pointer-events:none;z-index:9}
#pop.good{background:rgba(30,150,80,.96)}#pop.bad{background:rgba(205,45,60,.96)}#pop.warn{background:rgba(224,150,20,.97);color:#1b2433}
#pop.on{animation:popin 2.2s ease-out forwards}
@keyframes popin{0%{opacity:0;transform:translate(-50%,-50%) scale(.5)}12%{opacity:1;transform:translate(-50%,-50%) scale(1.12)}22%{transform:translate(-50%,-50%) scale(1)}80%{opacity:1}100%{opacity:0;transform:translate(-50%,-62%) scale(1)}}
#bMsg.ring{background:linear-gradient(150deg,#ff6060,#c21f2f)!important;animation:vib .4s linear infinite;box-shadow:0 0 0 3px rgba(255,80,80,.55),0 3px 8px rgba(0,0,0,.45)}
@keyframes vib{0%,100%{transform:translateX(0) rotate(0)}15%{transform:translateX(-2px) rotate(-7deg)}35%{transform:translateX(2px) rotate(7deg)}55%{transform:translateX(-2px) rotate(-5deg)}75%{transform:translateX(2px) rotate(5deg)}}
#cineSkip{position:absolute;right:max(14px,env(safe-area-inset-right,0px));bottom:max(18px,env(safe-area-inset-bottom,0px));display:none;z-index:7;padding:10px 16px;border-radius:999px;border:1px solid rgba(255,255,255,.6);background:rgba(14,24,42,.7);color:#fff;font:600 14px var(--display);cursor:pointer}
body[data-mode=cine] #cineSkip{display:block}
body[data-mode=cine] .game,body[data-mode=cine] #back,body[data-mode=cine] #toasts,body[data-mode=cine] #bubs,body[data-mode=cine] #qi,body[data-mode=cine] #stick{display:none!important}
#tr .gold,#tr .gold b{color:#ffc933;font-weight:700;text-shadow:0 0 2px #4a2e00,0 0 3px #4a2e00,0 1px 2px #4a2e00}
#toast{display:none!important}
#bubs{position:absolute;left:50%;top:max(34%,calc(env(safe-area-inset-top,0px) + 120px));transform:translateX(-50%);width:min(440px,88vw);display:flex;flex-direction:column;align-items:center;gap:8px;pointer-events:none;z-index:9}
.bub{max-width:100%;padding:10px 16px;border-radius:18px;font:700 16px/1.3 var(--display);text-align:center;color:#fff;background:rgba(40,60,100,.95);border:2px solid #fff;box-shadow:0 6px 22px rgba(0,0,0,.5);animation:bubin .22s ease-out;transition:opacity .45s}
.bub.warn{background:rgba(224,150,20,.97);color:#1b2433}.bub.off{opacity:0}
@keyframes bubin{from{transform:scale(.7);opacity:0}to{transform:scale(1);opacity:1}}
#toasts{position:static;margin-top:6px;width:min(260px,60vw);display:flex;flex-direction:column;align-items:flex-start;pointer-events:none;z-index:6}
.tt{margin-top:4px;padding:3px 8px;border-radius:10px;border:1px solid rgba(255,255,255,.55);background:rgba(18,32,54,.74);box-shadow:0 2px 8px rgba(0,0,0,.45);color:#fff;font-size:12px;font-weight:700;line-height:1.25;text-align:left;text-shadow:none;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden;animation:ttin .25s ease-out;transition:opacity .6s}
.tt.warn{background:rgba(224,150,20,.96);color:#1b2433;border-color:#fff;-webkit-line-clamp:2;font-size:12px}
#objs{max-height:9.4em;overflow:hidden;pointer-events:auto}#objs.ov:not(.open){-webkit-mask-image:linear-gradient(#000 82%,transparent);mask-image:linear-gradient(#000 82%,transparent)}#objs.open{max-height:none}
#logp{position:absolute;inset:0;display:grid;place-items:center;background:rgba(5,8,15,.62);z-index:10;padding:16px}#logp[hidden]{display:none}#logp .mbox{width:min(460px,100%);background:#16253b;border:1px solid #3b5a85;border-radius:14px;padding:12px 14px;color:#fff}.lgm{padding:5px 0;border-bottom:1px solid rgba(255,255,255,.1);font-size:13px;line-height:1.3}.lgm small{color:#9fb4d1;margin-right:4px}
.tt.off{opacity:0}
@keyframes ttin{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}
#tl{top:calc(env(safe-area-inset-top,0px) + 6px)}
#back{flex-direction:column;bottom:max(8px,env(safe-area-inset-bottom,0px));gap:6px}
#back .btn{width:36px;height:36px;border-radius:50%;color:#fff;border:2px solid rgba(255,255,255,.9);box-shadow:0 3px 8px rgba(0,0,0,.45),inset 0 1px 2px rgba(255,255,255,.45);background:linear-gradient(150deg,#5b6b86,#2c3850)}
#back .btn svg{width:24px;height:24px;stroke-width:2.1;filter:drop-shadow(0 1px 1px rgba(0,0,0,.4))}
#back .btn:active{filter:brightness(1.3);transform:scale(.93)}
#bMsg{background:linear-gradient(150deg,#46d483,#1e9a57)!important}#bGuard{background:linear-gradient(150deg,#5a6b85,#2c3a52)!important}#bGadget{background:linear-gradient(150deg,#3a5fb0,#1f2a44)!important}#bStrike{background:linear-gradient(150deg,#e5484d,#a3171c)!important}#bSeat{background:linear-gradient(150deg,#9b6bd6,#5e3a9a)!important}
#bMenu{background:linear-gradient(150deg,#8d9ab5,#4a5874)!important}
#bMap{background:linear-gradient(150deg,#4da3ff,#2468c9)!important}
#bRank{background:linear-gradient(150deg,#ffc93c,#e08a12)!important}
#bFs{background:linear-gradient(150deg,#ff7a7a,#c0392b)!important}
#bHelp{background:linear-gradient(150deg,#b98bff,#6c42c9)!important}
#qi{left:calc(max(12px,env(safe-area-inset-left,0px)) + 56px);max-width:max(90px,calc(100vw - 290px))}
#tr{color:#1d63e0;font-weight:600;text-shadow:0 0 3px #fff,0 0 3px #fff,0 0 6px rgba(255,255,255,.9),0 1px 2px #fff}
#tl{color:#0a7a46;font-weight:700;text-shadow:0 0 3px #fff,0 0 3px #fff,0 0 6px rgba(255,255,255,.9),0 1px 2px #fff}
#tl small{color:#085c35;font-weight:800}
#tr b{color:#0b3d91}
#tr .mini,.mini{color:#154aa8;font-weight:700;width:104px}
#sc{color:#154aa8;font-weight:600}
.bar{height:9px;border:2px solid var(--gold);background:rgba(8,18,40,.7);border-radius:6px;box-shadow:0 0 0 1px rgba(0,0,0,.35),0 1px 4px rgba(0,0,0,.4);margin-top:3px;box-sizing:border-box}
#btns{gap:8px}
#btns .btn{width:58px;height:58px}
#back{flex-direction:column-reverse;left:max(10px,env(safe-area-inset-left,0px));top:auto;bottom:max(8px,env(safe-area-inset-bottom,0px));transform:none;gap:6px}
#back .btn{width:36px;height:36px}#back .btn svg{width:20px;height:20px}
#wcbar{right:max(10px,env(safe-area-inset-right,0px));top:auto;bottom:calc(max(16px,env(safe-area-inset-bottom,0px)) + 74px);transform:none;gap:8px}
#wcbar .btn{width:54px;height:54px;font-size:10px}
#wcbar #bMsg{width:62px;height:62px}
#qi{bottom:max(16px,env(safe-area-inset-bottom,0px));max-width:calc(100vw - 250px)}
#colP{display:flex;flex-direction:row;justify-content:flex-end;align-items:flex-end;gap:8px;position:absolute;right:0;bottom:calc(100% + 10px)}
#bGrim{touch-action:manipulation;background:rgba(60,180,110,.95);color:#10202e}
#mail{background:linear-gradient(160deg,#0b3558,#17608f);z-index:8;padding:0;display:flex;justify-content:center;align-items:stretch}
#mail .mbox{width:min(560px,100%);height:100%;max-height:none;border-radius:0;display:flex;flex-direction:column;padding:12px 14px calc(52px + env(safe-area-inset-bottom,0px));background:#16253b;border:0}
@media(min-width:620px){#mail .mbox{height:min(100% - 70px,720px);margin:20px auto auto;border-radius:12px;border:1px solid #3b5a85;box-shadow:0 18px 50px rgba(0,0,0,.55);padding-bottom:16px}}
#mail #mBody{flex:1;min-height:0;overflow-y:auto}
.tskb{position:absolute;left:0;right:0;bottom:0;height:40px;background:#0a1626;border-top:1px solid #2c4468;display:flex;justify-content:space-between;align-items:center;padding:0 14px;font-size:13px;color:#cfe0f5}
.mopt[disabled]{opacity:.45;cursor:default}
#act{position:absolute;left:50%;transform:translateX(-50%);bottom:max(96px,calc(env(safe-area-inset-bottom,0px) + 96px));width:min(260px,66vw);text-align:center;font-size:14px;font-weight:600;pointer-events:none;text-shadow:0 1px 3px rgba(0,0,0,.95)}
.abar{height:12px;border-radius:7px;background:rgba(0,0,0,.5);border:1px solid var(--edge);margin-top:4px;overflow:hidden}
.abar i{display:block;height:100%;width:0;background:var(--gold)}
.ptabs{display:flex;gap:6px;margin:10px 0 2px}
.ptab{flex:1;padding:8px;border-radius:10px;border:1px solid var(--edge);background:#1d2f4a;color:var(--fg);font:500 14px var(--display);cursor:pointer}
.ptab.on{background:var(--gold);color:#1b2433}
.lg{display:flex;gap:10px;align-items:flex-start;margin-top:9px;font-size:14px}
.lg small{display:block;color:var(--muted);font-size:12px;line-height:1.35;font-weight:400}
.sw{flex:none;width:16px;height:16px;border-radius:50%;margin-top:3px;border:2px solid rgba(255,255,255,.7)}
#phone{position:absolute;inset:0;z-index:9;background:#04060b;display:flex;justify-content:center;text-shadow:none}
.dev{width:min(440px,100%);height:100%;display:flex;flex-direction:column;min-height:0;background:linear-gradient(#111c31,#0a101c);padding:max(10px,env(safe-area-inset-top,0px)) 14px calc(max(12px,env(safe-area-inset-bottom,0px)) + 30px)}
@media(min-width:520px){.dev{padding-bottom:12px;height:min(100%,800px);margin:auto;border-radius:36px;border:7px solid #2a3042;box-shadow:0 0 0 2px #0c0f18,0 20px 60px rgba(0,0,0,.7)}}
.sbar{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);padding:2px 6px 8px}
.dev h3{margin:0 0 4px;font:600 20px var(--display);text-align:center}
.dev .ptabs{margin:8px 0 4px}
#phBody{flex:1;min-height:0;overflow-y:auto;overflow-x:hidden;padding:0 2px 8px;-webkit-overflow-scrolling:touch}
#phClose{margin-top:8px;padding:14px;border-radius:14px;border:0;background:#e5484d;color:#fff;font:600 16px var(--display);cursor:pointer}
#qi{left:max(12px,env(safe-area-inset-left,0px));bottom:max(72px,calc(env(safe-area-inset-bottom,0px) + 72px));display:flex;gap:6px;flex-wrap:wrap;max-width:60vw;pointer-events:auto;text-shadow:none}
#qi button{width:44px;height:44px;border-radius:12px;border:1px solid var(--edge);background:var(--panel);font-size:22px;cursor:pointer;position:relative;padding:0}
#qi button b{position:absolute;right:2px;bottom:0;font:600 11px var(--display);color:var(--gold)}
.it{flex-wrap:wrap}.it .tx{flex:1 1 150px;overflow-wrap:anywhere}
.phh{display:flex;justify-content:space-between;gap:8px;font-size:13px;margin-top:8px;color:var(--muted)}.phh b{color:var(--gold)}
.it{display:flex;gap:10px;align-items:center;margin-top:8px;padding:8px;border-radius:12px;background:#1d2f4a}.it.lk{opacity:.55}
i.plus{font-style:normal;color:#8ff0bb;font-weight:700;margin-left:6px;display:inline-block;animation:plus 1.8s ease-out forwards}
@keyframes plus{0%{opacity:0;transform:translateY(8px) scale(.8)}15%{opacity:1;transform:translateY(0) scale(1.25)}70%{opacity:1}100%{opacity:0;transform:translateY(-12px)}}
.it .ic{font-size:26px;width:34px;text-align:center}.it .tx{flex:1;min-width:0;font-size:14px}.it small{display:block;color:var(--muted);font-size:12px;line-height:1.3;font-weight:400}
.it button{padding:7px 10px;border-radius:10px;border:0;background:var(--gold);color:#1b2433;font:600 13px var(--display);cursor:pointer;white-space:nowrap}.it button:disabled{background:#3a4a66;color:#8a93a3;cursor:default}
.ctabs{display:flex;gap:6px;overflow-x:auto;margin:10px 0 2px;padding-bottom:4px;-webkit-overflow-scrolling:touch}.ctab{flex:none;padding:7px 10px;border-radius:999px;border:1px solid #2f4366;background:#16253d;color:#dbe7f7;font:600 12px var(--display);cursor:pointer;white-space:nowrap}.ctab b{color:var(--gold);margin-left:2px}.ctab.on{background:var(--gold);color:#1b2433;border-color:var(--gold)}.ctab.on b{color:#1b2433}.ctab.z{opacity:.5}
.ph3{margin:12px 0 0;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--gold)}
.lcols{display:flex;gap:10px;margin-top:10px}
.lc{flex:1;min-width:0}.lc h4{margin:0 0 6px;font-size:13px;color:var(--gold)}
.lr{display:flex;justify-content:space-between;gap:6px;font-size:13px;padding:4px 6px;border-radius:8px}
.lr.me{background:rgba(245,184,46,.22)}
#photo{position:absolute;left:50%;top:20%;transform:translateX(-50%) rotate(-4deg);z-index:6;background:#f8f4ea;padding:10px 10px 8px;border-radius:6px;box-shadow:0 12px 30px rgba(0,0,0,.55);text-align:center;color:#2a2418;font:600 15px var(--display);text-shadow:none;cursor:pointer;width:min(260px,72vw)}
#photo canvas{width:100%;height:auto;display:block;border-radius:3px}
#photo p{margin:7px 0 0}
#photo.go{animation:pop .45s ease-out}
@keyframes pop{from{transform:translateX(-50%) rotate(-4deg) scale(.4);opacity:0}to{transform:translateX(-50%) rotate(-4deg) scale(1);opacity:1}}
@media (prefers-reduced-motion:reduce){#photo.go{animation:none}}
#mBody{max-height:64vh;overflow-y:auto}

/* creation de personnage */
body[data-mode=create] .game,body[data-mode=create] .maponly{display:none!important}
#creator{position:absolute;z-index:8;text-shadow:none;display:flex;flex-direction:column;background:rgba(14,24,42,.93);border:1px solid var(--edge);overflow:hidden}
@media (min-aspect-ratio:1/1){#creator{top:12px;bottom:12px;right:max(12px,env(safe-area-inset-right,0px));width:min(390px,46vw);border-radius:18px}}
@media (max-aspect-ratio:1/1){#creator{left:0;right:0;bottom:0;height:60%;border-radius:18px 18px 0 0}}
#crUp,#crDn{position:absolute;right:10px;z-index:3;width:46px;height:46px;border-radius:50%;border:1px solid var(--edge);background:rgba(255,210,63,.95);color:#1b2433;font:700 20px var(--display);display:flex;align-items:center;justify-content:center;cursor:pointer;user-select:none;-webkit-user-select:none;touch-action:none;box-shadow:0 2px 8px rgba(0,0,0,.45)}
#crUp{top:64px}#crDn{bottom:84px}#crUp[hidden],#crDn[hidden]{display:none}
#crSb{position:absolute;right:3px;top:64px;bottom:84px;width:5px;border-radius:3px;background:rgba(255,255,255,.12);z-index:2;pointer-events:none}
#crSb i{position:absolute;left:0;right:0;border-radius:3px;background:var(--gold)}
#crH{padding:12px 16px 4px;font-size:20px;font-weight:600}#crH small{display:block;font-size:12px;color:var(--muted);font-weight:400}
#crB{flex:1;min-height:0;overflow-y:auto;padding:4px 16px 8px;touch-action:pan-y;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
#creator,#creator *{touch-action:pan-y}#creator input{touch-action:manipulation}
#crB h4{margin:12px 0 6px;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--gold);font-weight:600}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{padding:7px 12px;border-radius:999px;border:1px solid var(--edge);background:#1d2f4a;color:var(--fg);font:500 14px var(--display);cursor:pointer;touch-action:manipulation}
.chip.on{background:var(--gold);color:#1b2433;border-color:var(--gold)}
.chip:disabled{opacity:.45;cursor:default}
.sw{width:30px;height:30px;padding:0;border-radius:50%;border:2px solid rgba(255,255,255,.3);cursor:pointer;touch-action:manipulation}
.sw.on{border-color:#fff;box-shadow:0 0 0 2px var(--gold)}
.sw.none{background:repeating-linear-gradient(45deg,#2b3a55,#2b3a55 4px,#3b4d6d 4px,#3b4d6d 8px)}
#crName{width:100%;box-sizing:border-box;padding:9px 12px;border-radius:12px;border:1px solid var(--edge);background:#1d2f4a;color:var(--fg);font:500 16px var(--display);-webkit-user-select:text;user-select:text}
.crn{margin:6px 0 0;font-size:12px;color:var(--muted);line-height:1.35}
#crF{padding:10px 16px calc(12px + env(safe-area-inset-bottom,0px));display:flex;gap:8px}
#crGo{flex:1;padding:13px;border-radius:14px;border:0;background:var(--gold);color:#1b2433;font:600 18px var(--display);cursor:pointer}
#crRnd{padding:13px 16px;border-radius:14px;border:1px solid var(--edge);background:#1d2f4a;color:var(--fg);font:600 18px var(--display);cursor:pointer}
#acc{position:fixed;inset:0;z-index:60;overflow-y:auto;-webkit-overflow-scrolling:touch;background:radial-gradient(120% 90% at 50% 0%,#1d3354 0%,#0f1b2e 70%);color:var(--fg);padding:max(18px,env(safe-area-inset-top,0px)) max(16px,env(safe-area-inset-right,0px)) max(24px,env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px));touch-action:pan-y}
#acc[hidden]{display:none}#acc{--i-ahead:url(data:image/jpeg;base64,);--i-alabel:url(data:image/jpeg;base64,);--i-aavatar:url(data:image/jpeg;base64,);--i-asolo:url(data:image/jpeg;base64,);--i-aonline:url(data:image/jpeg;base64,);--i-aedit:url(data:image/jpeg;base64,);--i-areset:url(data:image/jpeg;base64,);--i-anew:url(data:image/jpeg;base64,);--i-ainfo:url(data:image/jpeg;base64,);--i-afoot:url(data:image/jpeg;base64,);--i-bhead:url(data:image/jpeg;base64,);--i-bemp:url(data:image/jpeg;base64,);--i-bman:url(data:image/jpeg;base64,);--i-bvig:url(data:image/jpeg;base64,);--i-bice:url(data:image/jpeg;base64,);--i-bicm:url(data:image/jpeg;base64,);--i-bicv:url(data:image/jpeg;base64,);}.artw{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(100vw,calc(100dvh*941/1672));aspect-ratio:941/1672}.artw img{width:100%;height:100%;display:block;-webkit-user-drag:none}.pbtn{position:absolute;left:16%;top:76.5%;width:67.5%;height:14%;border:0;background:transparent;border-radius:999px;cursor:pointer;-webkit-tap-highlight-color:transparent;padding:0}.pbtn:active{background:rgba(255,255,255,.22)}.tart{background:linear-gradient(#3a86d9 0,#3a86d9 35%,#1b2030 65%,#1b2030 100%)}#acc.menu{background:linear-gradient(#3b86d9 0,#2a55a8 24%,#18286a 58%,#141c46 100%) fixed}.ib{display:block;width:100%;border:0;padding:0;background:center/100% 100% no-repeat;cursor:pointer;-webkit-tap-highlight-color:transparent;border-radius:18px}.ib:active{transform:translateY(3px);filter:brightness(.92)}.hd{width:100%;background:center/100% 100% no-repeat;border-radius:14px}.lab{width:64%;margin:6px 0 0 -4px;background:center/100% 100% no-repeat;transform:rotate(-1.5deg)}.lcard{margin-top:6px;padding:12px;border:3px solid #ffd23a;border-radius:24px;background:linear-gradient(#1b449c,#10286b);box-shadow:0 0 0 2px #0b1f55,0 6px 0 rgba(0,0,0,.35)}.lcard.cur{border-color:#ff5a64}.lrow{display:flex;gap:12px;align-items:center;padding:8px;border:2px solid #4aa8ff;border-radius:16px;background:rgba(10,28,80,.7)}.lav{flex:0 0 22%;aspect-ratio:193/183;background:center/100% 100% no-repeat;border-radius:6px}.lnm{min-width:0;color:#fff;font:700 28px var(--display);text-shadow:0 2px 0 #0b1f55}.lnm small{display:block;font:500 12px var(--display);color:#d8e6ff;text-shadow:none;margin-top:3px}.g2{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}.g2 .ib{aspect-ratio:428/150}.g2 .abtn,.g2 .abtn2{padding:14px 8px}.wide{aspect-ratio:847/156;margin-top:14px;border-radius:26px}.info{margin-top:14px;aspect-ratio:818/108;background:center/100% 100% no-repeat}.foot{position:fixed;left:0;right:0;bottom:0;height:calc(100vw*252/941);max-height:20vh;z-index:-1;pointer-events:none;background:left bottom/cover no-repeat;opacity:.95;-webkit-mask-image:linear-gradient(transparent,#000 40%);mask-image:linear-gradient(transparent,#000 40%)}.pill{display:inline-flex;align-items:center;gap:8px;margin:12px 0 0;padding:6px 14px;border:2px solid #ffd23a;border-radius:99px;background:rgba(10,28,80,.85);color:#fff;font:600 15px var(--display)}.pill i{width:12px;height:12px;border-radius:50%;background:#3ee06a;box-shadow:0 0 6px #3ee06a}.qq{margin:14px 0 4px;font:700 26px var(--display);color:#fff;text-shadow:0 3px 0 #0b1f55,0 0 10px rgba(0,0,0,.4)}.ccard{display:grid;grid-template-columns:33% 1fr;gap:10px;margin-top:12px;padding:8px;border:3px solid #ffd23a;border-radius:24px;background:linear-gradient(#1d4aa6,#12307a);box-shadow:0 0 0 2px #0b1f55,0 6px 0 rgba(0,0,0,.35)}.ccard.cur{border-color:#ff5a64}.ccard .por{border-radius:18px;background:center/cover no-repeat;min-height:120px}.ccard .ct{display:flex;align-items:center;gap:8px}.ccard .ct i{width:34px;height:34px;background:center/contain no-repeat;border-radius:6px}.ccard .ct b{font:700 25px var(--display);color:#fff;text-shadow:0 2px 0 #0b1f55}.ccard .lvp{display:inline-block;margin-top:4px;padding:1px 10px;border:2px solid #ffd23a;border-radius:99px;background:#0b1f55;color:#fff;font:700 12px var(--display)}.ccard p{margin:6px 0 8px;font-size:12.5px;line-height:1.3;color:#e8f0ff}.ccard .abtn{width:100%;margin-top:0;padding:10px 8px;font-size:17px}.accw.lst{padding-bottom:max(150px,22vh)}#acc.menu .accw h2{display:block;margin:6px 0 16px;padding:8px 10px;border-radius:14px;border:3px solid #fff;background:linear-gradient(#e8333d,#b3121f);color:#ffd23a;font:700 30px var(--display);text-shadow:0 3px 0 #6e0b14,0 0 12px rgba(0,0,0,.35);box-shadow:0 5px 0 #6e0b14,0 8px 14px rgba(0,0,0,.4)}#acc.menu .abtn{border:3px solid #fff;background:linear-gradient(#ffe066,#f5a50f);color:#6e0b14;text-shadow:0 1px 0 rgba(255,255,255,.55);box-shadow:0 0 0 3px #b3121f,0 6px 0 #8a4f00,0 10px 14px rgba(0,0,0,.4);font-weight:700}#acc.menu .abtn:active{transform:translateY(3px);box-shadow:0 0 0 3px #b3121f,0 3px 0 #8a4f00}#acc.menu .abtn2,#acc.menu #crBack{border:3px solid #fff;background:linear-gradient(#4a9bf0,#1f5bb5);color:#fff;text-shadow:0 2px 0 rgba(0,20,70,.6);box-shadow:0 0 0 2px #10306a,0 5px 0 #10306a,0 8px 12px rgba(0,0,0,.35);font-weight:700}#acc.menu .acard{border:3px solid #ffd23a;border-radius:20px;background:linear-gradient(rgba(22,48,104,.93),rgba(14,30,70,.93));box-shadow:0 6px 0 rgba(0,0,0,.35)}#acc.menu .acard.cur{border-color:#ff5a64;box-shadow:0 0 0 3px #fff,0 6px 0 rgba(0,0,0,.35)}#acc.menu .aname{color:#fff;text-shadow:0 2px 0 rgba(0,0,0,.45)}#acc.menu .accn{color:#d8e6ff}#acc.menu .accm{color:#ffd23a}.tw{position:static}.tart{position:fixed;inset:0;z-index:-1;overflow:hidden}.tart svg{position:absolute;inset:0;width:100%;height:100%}.tbot{position:fixed;left:max(16px,env(safe-area-inset-left,0px));right:max(16px,env(safe-area-inset-right,0px));bottom:calc(10% + env(safe-area-inset-bottom,0px));max-width:480px;margin:0 auto}
.accw{max-width:480px;margin:0 auto}.accw h2{margin:6px 0 14px;font:600 30px var(--display);text-align:center;color:var(--gold)}
.accw label{display:block;margin:12px 0 4px;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.accw input{width:100%;box-sizing:border-box;padding:12px 14px;border-radius:12px;border:1px solid var(--edge);background:#1d2f4a;color:var(--fg);font:500 16px var(--display);-webkit-user-select:text;user-select:text}
.accn{margin:12px 0;font-size:13px;color:var(--muted);line-height:1.4}.accm{min-height:18px;margin:10px 0 0;font-size:14px;color:#ffd166;font-weight:600}
.accrow{display:flex;gap:8px;margin-top:10px}.accrow>button{flex:1}
.abtn,.abtn2{padding:13px 12px;border-radius:14px;font:600 16px var(--display);cursor:pointer;touch-action:manipulation}
.abtn{border:0;background:var(--gold);color:#1b2433}.abtn2{border:1px solid var(--edge);background:#1d2f4a;color:var(--fg)}
.abtn:disabled,.abtn2:disabled{opacity:.5}.abtn.full{width:100%;margin-top:14px}
.alink{background:none;border:0;color:#8ec5ff;text-decoration:underline;font:inherit;cursor:pointer;padding:0 0 0 6px}
.acard{margin-top:12px;padding:12px;border-radius:16px;border:1px solid var(--edge);background:rgba(18,32,54,.8)}.acard.cur{border-color:var(--gold)}
.aname{font:600 20px var(--display)}.aname small{display:block;margin-top:2px;font:400 12px var(--display);color:var(--muted)}
#crBack{padding:13px 16px;border-radius:14px;border:1px solid var(--edge);background:#1d2f4a;color:var(--fg);font:600 18px var(--display);cursor:pointer}
#crTitle{position:absolute;z-index:7;left:max(16px,env(safe-area-inset-left,0px));top:max(14px,env(safe-area-inset-top,0px));font-size:26px;font-weight:600;color:#fff;text-shadow:0 2px 6px rgba(0,0,0,.6)}
#crTitle small{display:block;font-size:13px;font-weight:400;color:var(--muted)}
@media (max-height:480px) and (min-aspect-ratio:1/1){
#tr{gap:2px;font-size:11px}#tr .row{gap:8px}
.mini,#tr .mini{width:84px;font-size:9px}.bar{height:6px;border-width:1.5px;margin-top:1px}
#bSnd{display:none!important;margin-top:0!important;padding:0 6px!important;font-size:11px!important}
#toasts{width:min(250px,34vw)!important}
#tl{top:calc(env(safe-area-inset-top,0px) + 6px);max-width:34vw;font-size:11px;line-height:1.3}
#back{gap:4px}#back .btn{width:32px;height:32px}#back .btn svg{width:18px;height:18px}
#btns{gap:6px}#btns .btn{width:50px;height:50px;font-size:9px}
#wcbar{flex-direction:column;gap:6px;bottom:calc(max(16px,env(safe-area-inset-bottom,0px)) + 62px);right:max(12px,env(safe-area-inset-right,0px))}
#wcbar .btn{width:50px;height:50px;font-size:9px}
#wcbar #bMsg{width:54px;height:54px}
#qi{max-width:30vw}
#act{bottom:max(76px,calc(env(safe-area-inset-bottom,0px) + 76px))}
}
/* cadre vie + infos libres */
#tr{box-sizing:border-box;padding:4px 8px 5px;border-radius:11px;background:linear-gradient(180deg,rgba(38,92,196,.72),rgba(20,44,110,.66));border:1px solid rgba(255,214,102,.65);box-shadow:0 2px 7px rgba(0,0,0,.3),inset 0 1px 0 rgba(255,255,255,.22);color:#eaf2ff;gap:1px;font-size:11.5px;text-shadow:0 1px 2px rgba(0,0,0,.85)}
#tr b{color:#ffe08a}#tr .gold,#tr .gold b{color:#ffd24a;text-shadow:0 1px 2px rgba(0,0,0,.9)}
#tr .mini,.mini{color:#dbe8ff;width:92px;font-size:9px}#tr .bar,.bar{height:7px;border-width:1.5px;margin-top:1px}
#sc{color:#c9dcff;font-size:9.5px;text-align:right}
#stat{display:flex;gap:7px;justify-content:flex-end;align-items:center;max-width:100%;line-height:1}#stat small{display:inline;margin:0;font-size:9.5px;letter-spacing:0;text-transform:none;white-space:nowrap;font-weight:700;text-shadow:0 0 2px #000,0 0 3px #000,0 1px 2px #000;opacity:.92}#stat #netS{color:#8fdcff}#stat #perf{color:#9be28b}#stat small[hidden]{display:none}
#tl{color:#fff;font-size:11.5px;line-height:1.3;text-shadow:0 0 2px #000,0 0 3px #000,0 1px 3px #000}
#tl small{color:#8ff0bd;font-size:9.5px;text-shadow:0 0 2px #000,0 0 3px #000,0 1px 3px #000}
#objs{max-height:none!important;-webkit-mask-image:none!important;mask-image:none!important}
#objs b[style*="7b4bb7"]{color:#d8bcff!important}#objs b[style*="d7263d"],#objs b[style*="e5484d"]{color:#ff9aa1!important}#objs b[style*="12a150"]{color:#6df0ac!important}#objs b[style*="b8860b"]{color:#ffd24a!important}
#susp:not([style*="opacity: 1"]){display:none}
@keyframes hfade{from{opacity:0;transform:translateY(-3px)}to{opacity:1;transform:none}}#objs>div{animation:hfade .45s ease-out}
@media (max-aspect-ratio:1/1){#tl{max-width:calc(100vw - 52vw - 40px)}#tr{max-width:52vw}#tr .row{gap:6px;justify-content:flex-end}}
.phh{flex-wrap:wrap;gap:2px 10px}.balt{font-size:12px;margin:4px 0 6px}
#blames{display:flex;align-items:center;justify-content:flex-end;gap:10px;flex-wrap:wrap;line-height:1}
#blames .lv{display:flex;gap:1px}#blames .h{font-size:25px;color:#ff3b4f;text-shadow:0 1px 0 #7a0a18,0 0 7px rgba(255,59,79,.55)}
#blames .h.e{color:transparent;-webkit-text-stroke:1.6px #9aa8bb;text-shadow:none}
#blames .bd{display:flex;gap:4px;align-items:center}
#blames .c{width:15px;height:21px;border-radius:3px;border:2px solid #9aa8bb;background:rgba(255,255,255,.14);transform:rotate(-7deg);box-sizing:border-box}
#blames .c.on1{background:#ffd23f;border-color:#9c7400}#blames .c.on2{background:#ff9a2e;border-color:#9a4600}#blames .c.on3{background:#ff3b30;border-color:#75080a}
#blames .c.new{animation:cblink .45s 4}@keyframes cblink{50%{transform:rotate(-7deg) scale(1.55)}}
#blames.alert .h:not(.e){animation:hpulse 1s infinite}@keyframes hpulse{50%{transform:scale(1.18)}}
#blames .fw{flex-basis:100%;text-align:right;font-size:11px;font-weight:800;color:#ff9b9b;text-shadow:0 1px 2px #000}
#gains{display:flex;flex-direction:column;align-items:flex-start;gap:3px;margin-top:4px;pointer-events:none}
#gains .gn{font-size:15px;font-weight:800;padding:3px 11px;border-radius:10px;background:rgba(14,22,40,.72);text-shadow:0 1px 2px #000;animation:gnin .25s ease-out;transition:opacity .45s,transform .45s}
#gains .gn.off{opacity:0;transform:translateY(-6px)}@keyframes gnin{from{opacity:0;transform:translateY(6px)}}
#tl{max-width:calc(100vw - var(--trw,200px) - 78px)!important;box-sizing:border-box}#objM,#objS{padding-right:6px}#tl #objs,#tl #toasts,#tl #gains{max-width:100%;overflow-wrap:anywhere}#toasts{width:min(230px,calc(100vw - var(--trw,200px) - 58px))!important}#toasts .tt{max-width:100%;box-sizing:border-box;display:block!important;max-height:none!important;white-space:normal!important;-webkit-line-clamp:unset!important;overflow:visible!important;font-size:13px}
#serb i,#comp i{background:linear-gradient(90deg,#f5b82e,#ffd56a)}
#sc{line-height:1.25}#sc span{display:block;font-size:14px;font-weight:800;margin-top:1px;text-shadow:0 1px 2px rgba(0,0,0,.85)}#sc .scw{color:#8ff0a4}#sc .scb{color:#ffb86b}#sc span b{font-size:18px;color:inherit!important}
#objs{max-height:none!important;min-height:0}#objM{min-height:2.5em}#objS{min-height:4.6em;margin-top:7px;padding-top:5px;border-top:1px dashed rgba(0,0,0,.25);overflow:hidden}#objM:empty,#objS:empty{min-height:0;margin:0;padding:0;border:0}#objs.open #objS{min-height:0;margin:0;padding:0;border:0}#objM>div,#objS>div{animation:hfade .45s ease-out}
#perf,#netS{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;margin-top:3px}

/* v219 : panneau réduit, pièces plus grosses */
#tr{gap:1px!important;padding:3px 7px 4px!important}
#tr .gold b,#tr .gold b#coins,#coins{font-size:20px!important;font-weight:800!important;line-height:1.05}
#tr .gold{font-size:12px!important}
#blames .h{font-size:18px!important}
#blames .c{width:11px!important;height:15px!important;border-width:1.5px!important}
#blames{gap:7px!important}
#tr .bar,.bar{height:5px!important;margin-top:0!important}
#tr .mini,.mini{line-height:1.1}
#sc span{font-size:13px!important;margin-top:0!important}#sc span b{font-size:16px!important}

#cqp{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(max(16px,env(safe-area-inset-bottom,0px)) + 168px);width:min(420px,92vw);background:rgba(18,32,54,.95);border:2px solid #f5b82e;border-radius:14px;padding:8px;z-index:12;pointer-events:auto;color:#fff;text-shadow:none}
#cqp .cqh{font:700 15px/1.2 var(--display);text-align:center;margin-bottom:6px}
#cqp .cqg{display:grid;grid-template-columns:1fr 1fr;gap:6px}
#cqp button{font:700 14px/1.15 var(--display);color:#fff;background:#274a7a;border:1px solid #6fa0e0;border-radius:10px;padding:8px 6px;min-height:46px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px}
#cqp button small{font:600 12px var(--display);color:#ffd56a}#cqp button.wide{grid-column:1/3}
/* ===== Fermeture du magasin (partie rapide) ===== */
body[data-mode=qm] .hud,body[data-mode=qm] .maponly,body[data-mode=qm] #dk,body[data-mode=qm] #nightMsg,body[data-mode=qm] #vig,body[data-mode=qm] #toast,body[data-mode=qm] #bubs,body[data-mode=qm] #qi{display:none!important}
body[data-mode=qm] #btns{display:flex!important}
body[data-mode=qm] #btns>*:not(#bAct):not(#qmP1){display:none!important}
#qmP1{display:none}body[data-mode=qm] #qmP1:not([hidden]){display:flex!important}#qmP1.cd{opacity:.45;filter:grayscale(.6)}
body[data-mode=qm] #bAct{display:flex!important}
#qmHud{display:none}
body[data-mode=qm] #qmHud{display:block}
#qmTop{position:fixed;left:50%;transform:translateX(-50%);top:max(8px,env(safe-area-inset-top,0px));z-index:6;display:flex;align-items:center;gap:10px;padding:6px 12px;border-radius:14px;background:rgba(14,22,40,.72);border:1px solid rgba(255,214,102,.55);pointer-events:none;font-family:var(--display)}
#qmTime{font:700 24px var(--display);color:#fff;min-width:68px;text-align:center;text-shadow:0 1px 3px #000}
#qmTime.low{color:#ff6b6b;animation:qmpulse 1s infinite}@keyframes qmpulse{50%{transform:scale(1.12)}}
#qmBarW{width:min(170px,34vw)}#qmBarL{font-size:11px;color:#dbe8ff;white-space:nowrap}#qmBarL b{color:#ffd24a;font-size:14px}
.qmbar{height:9px;border-radius:6px;background:rgba(255,255,255,.18);border:1.5px solid rgba(255,214,102,.8);overflow:hidden;margin-top:2px}
.qmbar i{display:block;height:100%;width:0;background:linear-gradient(90deg,#ff9f1c,#ff4d6d);transition:width .4s}
#qmRole{position:fixed;left:max(10px,env(safe-area-inset-left,0px));top:calc(max(8px,env(safe-area-inset-top,0px)) + 112px);z-index:6;max-width:min(300px,46vw);font:600 12px/1.35 var(--display);color:#fff;text-shadow:0 0 2px #000,0 1px 3px #000;pointer-events:none}
#qmRole .qmz{color:#9fd4ff}#qmRole .qmkey{color:#ffd21f}#qmRole .qmt{margin-top:4px;color:#ffc27a;font-size:11.5px}#qmRole small{color:#c9d6ea;font-weight:500}
.qmemp{color:#6df0ac}.qmimp{color:#ff8a8a}
#qmMsg{position:fixed;left:50%;transform:translateX(-50%);top:calc(max(8px,env(safe-area-inset-top,0px)) + 58px);z-index:6;width:min(560px,calc(100vw - 124px));display:flex;flex-direction:column;align-items:center;gap:2px;pointer-events:none;text-align:center}
.qmm{font:700 12px/1.3 var(--display);color:#bfe3ff;text-shadow:0 0 2px #000,0 1px 3px #000;transition:opacity .5s}.qmm.good{color:#8ff0bd}.qmm.bad{color:#ff8a8a}.qmm.warn{color:#ffd166}.qmm.off{opacity:0}
#qmCaught{position:fixed;left:50%;transform:translateX(-50%);top:38%;z-index:7;padding:10px 16px;border-radius:14px;background:rgba(120,20,30,.88);border:2px solid #ff8a8a;color:#fff;font:700 15px/1.35 var(--display);text-align:center;max-width:86vw;pointer-events:none}
#qmTR{position:fixed;right:max(10px,env(safe-area-inset-right,0px));top:max(8px,env(safe-area-inset-top,0px));z-index:7;display:flex;flex-direction:column;gap:8px}
#qmTR button{width:44px;height:44px;border-radius:50%;border:1px solid var(--edge);background:var(--panel);color:var(--fg);font:600 22px var(--display);cursor:pointer}
#qmPowB{position:fixed;right:max(12px,env(safe-area-inset-right,0px));bottom:calc(max(16px,env(safe-area-inset-bottom,0px)) + 96px);z-index:6;display:flex;flex-direction:row;gap:10px;align-items:flex-end;justify-content:flex-end}
#qmPowB .btn:not(#qmP1){width:64px;height:64px;font-size:11px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px}#qmPowB .btn[hidden]{display:none}#qmPowB .btn.cd{opacity:.45;filter:grayscale(.6)}#qmPowB #qmAl,#qmPowB #qmLk{border-color:#ff8a8a}
#qmOv{position:fixed;inset:0;z-index:30;background:rgba(8,14,26,.82);display:flex;align-items:center;justify-content:center;padding:14px;box-sizing:border-box}
#qmOv[hidden]{display:none}
.qmbox{width:min(460px,94vw);max-height:90vh;overflow-y:auto;background:#14233b;border:2px solid #f5b82e;border-radius:18px;padding:16px;box-sizing:border-box;color:#eaf2ff;font-family:var(--display);text-align:center}
.qmbox h2{margin:4px 0 8px;font:700 24px var(--display)}.qmk{font-size:12px;letter-spacing:.12em;color:#ffd24a}.qmic{font-size:54px;line-height:1.1;margin-top:4px}
.qmd{font-size:13.5px;line-height:1.45;color:#dbe7f7;text-align:left;margin:8px 0}.qmsm{font-size:11.5px;color:#9fb3cf;margin:8px 0}
.qmpw{text-align:left;font-size:13px;line-height:1.4;background:rgba(255,255,255,.06);border-radius:12px;padding:8px 10px;margin:8px 0}.qmpw div{margin-top:4px}
.qmteam{display:flex;flex-wrap:wrap;gap:5px;justify-content:center;margin:8px 0}.qmteam small{flex-basis:100%;color:#9fb3cf}.qmn{padding:3px 9px;border-radius:10px;background:#274a7a;font-size:13px}
.qmvote{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin:10px 0}
.qmvb{padding:10px 6px;border-radius:12px;border:1px solid #6fa0e0;background:#274a7a;color:#fff;font:700 15px var(--display);cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:2px;min-height:52px}
.qmvb small{font-size:12px;min-height:14px}.qmvb.on{background:#f5b82e;color:#1b2433}.qmvb:disabled{opacity:.6}.qmvb.on:disabled{opacity:1}
.abtn2.full{width:100%;margin-top:10px}
.gtabs{display:flex;gap:6px;margin:4px 0 10px}.gtab{flex:1;padding:11px 6px;border-radius:12px;border:1px solid var(--edge);background:#1d2f4a;color:var(--fg);font:600 14px var(--display);cursor:pointer}.gtab.on{background:var(--gold);color:#1b2433;border-color:var(--gold)}
.fmi{padding:10px 12px;border-radius:14px;border:1px solid #ff9f1c;background:rgba(60,30,10,.6);font-size:13px;line-height:1.4;margin-bottom:8px}.fmi small{color:#ffcf99}
@media (max-height:500px) and (min-aspect-ratio:1/1){#qmRole{top:calc(max(8px,env(safe-area-inset-top,0px)) + 46px);max-width:28vw;font-size:11px}#qmMsg{top:calc(max(8px,env(safe-area-inset-top,0px)) + 54px);width:min(440px,50vw)}#qmTop{padding:4px 10px}#qmTime{font-size:20px}#qmPowB{bottom:calc(max(10px,env(safe-area-inset-bottom,0px)) + 84px);right:max(12px,env(safe-area-inset-right,0px));flex-direction:row}body[data-mode=qm] #qmSta{bottom:2px;height:4px}#qmPowB .btn{width:56px;height:56px}}
#qmTR button.on{background:#f5b82e;color:#1b2433}
#qmBadge{position:fixed;left:max(10px,env(safe-area-inset-left,0px));top:max(10px,env(safe-area-inset-top,0px));z-index:7;padding:5px 11px;border-radius:999px;font:700 13px var(--display);letter-spacing:.04em;color:#fff;pointer-events:none;box-shadow:0 2px 8px rgba(0,0,0,.35)}
#qmBadge.emp{background:#1f9d5c;border:2px solid #8ff0bd}#qmBadge.imp{background:#c0262d;border:2px solid #ffb3b3;animation:qmimpg 2.4s infinite}@keyframes qmimpg{50%{box-shadow:0 0 14px rgba(255,80,80,.8)}}
#qmMapT{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(max(16px,env(safe-area-inset-bottom,0px)) + 8px);z-index:7;padding:7px 14px;border-radius:12px;background:rgba(14,22,40,.85);color:#fff;font:600 13px var(--display);pointer-events:none}
#qmMapT[hidden]{display:none}
.qmrole{margin:8px auto;padding:10px;border-radius:16px;font:700 24px var(--display)}.qmrole small{display:block;font-size:12.5px;font-weight:500;opacity:.9}.qmrole.emp{background:#1f9d5c;border:2px solid #8ff0bd}.qmrole.imp{background:#a81f26;border:2px solid #ffb3b3}
@media (max-width:440px){#qmTop{left:auto;right:62px;transform:none;padding:5px 9px;gap:7px}#qmBarW{width:110px}#qmTime{font-size:21px;min-width:58px}#qmBadge{font-size:11.5px;padding:4px 8px}#qmRole{top:calc(max(8px,env(safe-area-inset-top,0px)) + 112px)}}
.gpick{display:flex;flex-direction:column;gap:14px;margin-top:10px}
.gcard{display:block;width:100%;text-align:left;padding:16px;border-radius:18px;border:2px solid #f5b82e;background:linear-gradient(135deg,#21416e,#152a48);color:#fff;font-family:var(--display);cursor:pointer}
.gcard b{display:block;font-size:22px;margin-bottom:4px}.gcard span{font-size:13.5px;line-height:1.4;color:#dbe7f7}.gcard i{font-style:normal;display:inline-block;margin-left:6px;padding:2px 8px;border-radius:8px;background:#ff4d6d;font-size:11px;vertical-align:middle}
.gcard.rf{border-color:#ff9f1c;background:linear-gradient(135deg,#5a2a10,#2a1a2e)}
.gcur{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:9px 12px;border-radius:12px;background:rgba(14,22,40,.6);border:1px solid var(--edge);font:600 14px var(--display);margin:4px 0 10px}
.gcur button{padding:7px 10px;border-radius:10px;border:1px solid var(--edge);background:#274a7a;color:#fff;font:600 12.5px var(--display);cursor:pointer}
#qmSta{display:none}body[data-mode=qm] #qmSta{display:block;position:absolute;left:8px;right:8px;bottom:5px;height:6px;border-radius:4px;background:rgba(0,0,0,.4);overflow:hidden}#qmSta b{display:block;height:100%;width:100%;background:#46d17a;transition:background .2s}
#qmPowB{justify-content:flex-end!important}
body[data-mode=qm] #qmP1{width:auto}
#qmGo{position:sticky;bottom:0;z-index:2;box-shadow:0 -10px 18px 6px #14233b}
#qmMapB{position:fixed;left:max(12px,env(safe-area-inset-left,0px));bottom:calc(max(16px,env(safe-area-inset-bottom,0px)) + 6px);z-index:7;width:52px;height:52px;border-radius:50%;border:1px solid var(--edge);background:var(--panel);font-size:24px;cursor:pointer}
#qmMapB.on{background:#f5b82e}
#qmMapAll{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(max(16px,env(safe-area-inset-bottom,0px)) + 52px);z-index:8;padding:10px 16px;border-radius:14px;border:2px solid #f5b82e;background:#14233b;color:#fff;font:700 15px var(--display);cursor:pointer}
#qmMapAll[hidden]{display:none}
#qmBig{position:fixed;left:50%;top:30%;transform:translate(-50%,-50%);z-index:9;padding:12px 20px;border-radius:18px;background:rgba(14,22,40,.88);border:3px solid #ffd21f;color:#ffd21f;font:800 22px var(--display);text-align:center;max-width:88vw;pointer-events:none;animation:qmpop .35s ease-out}
#qmBig[hidden]{display:none}@keyframes qmpop{0%{transform:translate(-50%,-50%) scale(.5);opacity:0}100%{transform:translate(-50%,-50%) scale(1);opacity:1}}
#qmJamFx{position:fixed;inset:0;z-index:5;pointer-events:none;opacity:.6;mix-blend-mode:screen;background:repeating-linear-gradient(0deg,rgba(255,255,255,.18) 0 2px,rgba(0,0,0,.25) 2px 4px),repeating-linear-gradient(90deg,rgba(120,255,160,.08) 0 3px,transparent 3px 7px);animation:qmjam .12s steps(2) infinite}
#qmJamFx[hidden]{display:none}@keyframes qmjam{0%{transform:translate(0,0)}50%{transform:translate(-6px,3px)}100%{transform:translate(4px,-2px)}}
#qmCine{position:fixed;inset:0;z-index:20;display:flex;align-items:center;justify-content:center;pointer-events:none}
#qmCine[hidden]{display:none}
#qmCine .stamp{font:900 clamp(30px,9vw,64px) var(--display);color:#fff;background:#c0262d;border:6px solid #fff;border-radius:16px;padding:10px 24px;transform:rotate(-6deg);box-shadow:0 10px 40px rgba(0,0,0,.6);animation:qmstamp .5s cubic-bezier(.2,1.6,.4,1)}
#qmCine .stamp.imp{background:#1f9d5c}@keyframes qmstamp{0%{transform:rotate(-6deg) scale(2.6);opacity:0}100%{transform:rotate(-6deg) scale(1);opacity:1}}
body.qmcine #qmHud>*:not(#qmCine):not(#qmOv){display:none!important}body.qmcine #btns,body.qmcine #stick{display:none!important}
.rdfl .rdfp{font-size:13.5px;line-height:1.4;color:#dbe7f7;margin:8px 2px}
.rdferr{padding:10px 12px;border-radius:12px;background:rgba(160,30,40,.75);border:1px solid #ff9b9b;color:#fff;font-size:13px;margin:6px 0}
.rdfs{padding:12px;border-radius:16px;border:2px solid #ff9f1c;background:rgba(40,24,30,.75);margin:10px 0}.rdfs.on{border-color:#46d17a}
.rdfh{display:flex;justify-content:space-between;align-items:center;font:700 17px var(--display);color:#fff}.rdfh span{font-size:13px;color:#ffcf99}
.rdfn{display:flex;flex-wrap:wrap;gap:5px;margin:8px 0;min-height:24px}.rdfn span{padding:3px 9px;border-radius:10px;background:#274a7a;color:#fff;font-size:13px}.rdfn i{color:#9fb3cf;font-size:12.5px}
.rdfs .abtn{width:100%}.rdfs .abtn:disabled{opacity:.45}
.rdfl2{display:flex;flex-direction:column;gap:6px;margin:10px 0}.rdfm{padding:8px 10px;border-radius:10px;background:rgba(255,255,255,.08);color:#fff;font:600 15px var(--display)}.rdfm small{color:#ffcf99;font-weight:500}

.ginst{display:block;width:100%;margin-top:16px;padding:14px;border-radius:18px;border:2px solid #3cc47c;background:linear-gradient(135deg,#1f7a4c,#145236);color:#fff;font-family:var(--display);font-size:20px;cursor:pointer}.ginst small{display:block;font-size:12.5px;color:#d5f5e3;margin-top:2px}
.ginsth{margin-top:10px;padding:12px 14px;border-radius:14px;background:rgba(255,255,255,.1);color:#fff;font-size:14px;line-height:1.6;text-align:left}
.gacc{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:6px 12px;margin:-4px 0 10px;font:500 12.5px var(--display);color:#cfe0f5}.gacc span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.gacc button{flex:none;padding:6px 10px;border-radius:10px;border:1px solid rgba(255,255,255,.3);background:transparent;color:#fff;font:600 12px var(--display);cursor:pointer}

#qmHearts{position:fixed;left:max(10px,env(safe-area-inset-left,0px));top:calc(max(10px,env(safe-area-inset-top,0px)) + 34px);z-index:7;display:flex;gap:4px;pointer-events:none}
.qmh{position:relative;display:inline-block;width:38px;height:36px}
.qmh::before,.qmh i::before{content:'❤';position:absolute;left:0;top:-6px;font-size:40px;line-height:1;font-family:sans-serif}
.qmh::before{color:rgba(0,0,0,.45);-webkit-text-stroke:2px rgba(255,255,255,.75)}
.qmh i{position:absolute;left:0;top:0;bottom:0;overflow:hidden;font-style:normal}
.qmh i::before{color:#ff2d55;-webkit-text-stroke:2px #fff;text-shadow:0 0 6px rgba(255,45,85,.6)}
.qmzh{display:inline-block;padding:4px 10px;border-radius:12px;background:rgba(46,140,70,.9);color:#fff;font:700 13px var(--display)}
#qmStaW{position:fixed;left:max(12px,env(safe-area-inset-left,0px));top:calc(max(10px,env(safe-area-inset-top,0px)) + 76px);z-index:7;width:124px;height:9px;border-radius:6px;background:rgba(0,0,0,.45);border:1px solid rgba(255,255,255,.5);overflow:hidden;pointer-events:none}
#qmStaW b{display:block;height:100%;width:100%;background:#46d17a;transition:background .2s}
#qmBadge.zomb{background:#2e8c46;border:2px solid #b6f5c8}
#qmBig.zomb{background:rgba(46,140,70,.95)}
#qmRole{top:calc(max(8px,env(safe-area-inset-top,0px)) + 96px)!important}
@media (orientation:portrait){#qmMsg{left:150px;right:8px;transform:none;width:auto;align-items:flex-end;text-align:right}}

.qmcls{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin:6px 0}
.qmcl{display:flex;flex-direction:column;align-items:flex-start;gap:1px;padding:7px 8px;border-radius:12px;border:2px solid rgba(255,255,255,.25);background:rgba(30,50,85,.9);color:#fff;font:600 13px var(--display);text-align:left;cursor:pointer}
.qmcl span{font-size:11.5px;color:#cfe0f5;font-weight:500}.qmcl i{font-style:normal;font-size:11px;color:#ffb3b3}
.qmcl.on{border-color:#46d17a;background:rgba(31,122,76,.95)}.qmcl:disabled{opacity:.4}
.qmpt{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:10px 0}.qmpt .abtn{font-size:16px;padding:14px 6px}.qmpt .abtn:disabled{opacity:.35}
#qmDark{position:fixed;inset:0;z-index:4;pointer-events:none;background:radial-gradient(circle at 50% 55%,rgba(0,0,0,.35) 0,rgba(0,0,0,.35) 110px,rgba(0,0,0,.88) 260px);animation:qmdk 8s linear}
@keyframes qmdk{0%{opacity:0}4%{opacity:1}92%{opacity:1}100%{opacity:0}}

#qmIt{display:none}body[data-mode=qm] #qmIt:not([hidden]){display:flex!important;flex-direction:column;align-items:center;justify-content:center;width:64px;height:64px;border-radius:18px;background:rgba(14,22,40,.82);border:2px solid #ffd21f;color:#fff;font:600 11px var(--display);gap:2px}
#qmIt.cd{opacity:.45}
.qmh.bonus::before{content:'❤'}.qmh.bonus i::before{color:#ffb020;text-shadow:0 0 8px rgba(255,176,32,.8)}

#qmHit{display:none}body[data-mode=qm] #qmHit:not([hidden]){display:flex!important;flex-direction:column;align-items:center;justify-content:center;width:80px;height:80px;border-radius:50%;background:radial-gradient(circle at 40% 35%,#ff6b6b,#c0262d);border:3px solid #fff;color:#fff;font:700 11.5px var(--display);gap:1px;box-shadow:0 4px 14px rgba(192,38,45,.6);touch-action:none}
#qmHit.cd{filter:grayscale(.7);opacity:.6}
#qmObj{position:fixed;left:50%;transform:translateX(-50%);top:calc(max(8px,env(safe-area-inset-top,0px)) + 54px);z-index:6;max-width:min(520px,60vw);padding:6px 12px;border-radius:12px;background:rgba(14,22,40,.82);border:1px solid #ffd21f;color:#ffe9a6;font:700 13px var(--display);text-align:center;pointer-events:none}
#qmObj:empty{display:none}
@media (orientation:portrait){#qmObj{left:150px;right:8px;transform:none;max-width:none;text-align:right;font-size:12px}#qmMsg{top:calc(max(8px,env(safe-area-inset-top,0px)) + 132px)!important}}

#qmObj{line-height:1.35}#qmObj b{display:block;color:#ffd21f;margin-bottom:2px}
.qmq{display:flex;gap:5px;align-items:baseline;justify-content:flex-end;color:#fff;font-weight:600;text-align:right}.qmq small{color:#cfe0f5;font-weight:500}
.qmq .qn{color:#ffd21f;font-size:15px}.qmq.ok{color:#7ee0a8;text-decoration:line-through;opacity:.75}
#qmArr{position:fixed;inset:0;z-index:5;pointer-events:none}
.qmarr{position:absolute;transform:translate(-50%,-50%);display:none;flex-direction:column;align-items:center;gap:1px;pointer-events:none}
.qmarr i{font-style:normal;font-size:30px;color:#ffd21f;text-shadow:0 0 6px #000,0 0 2px #000;line-height:1}
.qmarr span{padding:1px 6px;border-radius:8px;background:rgba(14,22,40,.85);border:1px solid #ffd21f;color:#fff;font:700 11.5px var(--display);white-space:nowrap}
@media (orientation:landscape){.qmq{justify-content:center;text-align:center}}

.qmq.me{color:#e7c6ff}.qmq.me .qn{color:#c77dff}.qmarr.me i{color:#c77dff}.qmarr.me span{border-color:#c77dff}
.qmpod{margin:10px 0;text-align:left}.qmpr{display:grid;grid-template-columns:30px 1fr auto;gap:6px;align-items:center;padding:5px 8px;border-radius:9px;background:rgba(255,255,255,.06);margin:3px 0;font-weight:600}
.qmpr.me{background:rgba(255,210,31,.18);outline:1px solid #ffd21f}.qmpr small{color:#ffd21f;font-weight:700}.qmtt{font-size:13px;margin-top:4px;color:#cfe0f5}

#qmObj{pointer-events:auto;padding:4px 8px;font-size:11px;line-height:1.25}
#qmObj b{display:inline;font-size:11px}
#qmObj .qmq{justify-content:flex-start;gap:4px;max-width:100%}
#qmObj .qmq .qn{font-size:12px;flex:none}
#qmObj .qmq .qt{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
#qmObj.big .qmq .qt{white-space:normal}
@media (orientation:portrait){#qmObj{left:auto;right:8px;max-width:46vw;text-align:left;font-size:11px}#qmObj.big{max-width:60vw}#qmMsg{top:calc(max(8px,env(safe-area-inset-top,0px)) + 142px)!important}}

#qmTorch{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
#qmCvH{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(max(16px,env(safe-area-inset-bottom,0px)) + 170px);z-index:6;padding:6px 12px;border-radius:12px;background:rgba(14,22,40,.88);border:1px solid #e5484d;color:#fff;font:700 12px var(--display);text-align:center;pointer-events:none;max-width:86vw}
#qmCvH b{color:#ffd21f;font-size:15px;letter-spacing:2px}
#qmPad{position:fixed;inset:0;z-index:30;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center}#qmPad[hidden]{display:none}
.qmpadw{background:#1b2436;border:2px solid #e5484d;border-radius:18px;padding:14px;width:min(300px,86vw);text-align:center;color:#fff;font-family:var(--display)}
.qmpadt{font-weight:800;font-size:18px;margin-bottom:6px}.qmpadv{display:flex;gap:8px;justify-content:center;margin:6px 0}.qmpadv span{width:44px;height:52px;border-radius:10px;background:#0e1628;border:1px solid #ffd21f;display:flex;align-items:center;justify-content:center;font-size:26px;font-weight:800;color:#ffd21f}
.qmpadm{font-size:12px;color:#cfe0f5;min-height:16px;margin-bottom:6px}.qmpadk{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.qmpadk button{height:50px;border-radius:12px;border:1px solid #3a4a66;background:#26324a;color:#fff;font:800 20px var(--display)}.qmpadk button[data-c=OK]{background:#2e8c46}
.qmpadx{margin-top:10px;width:100%;height:40px;border-radius:10px;border:1px solid #3a4a66;background:transparent;color:#cfe0f5;font:700 14px var(--display)}
@keyframes qmhelp{0%,100%{opacity:1;transform:translate(-50%,-50%) scale(1)}50%{opacity:.55;transform:translate(-50%,-50%) scale(1.15)}}
.qmarr.help{animation:qmhelp .6s infinite}.qmarr.help span{border-color:#ff9f1c}.qmq.help{color:#ffb35c}

#qmBossC{position:fixed;inset:0;z-index:25;pointer-events:none;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle,rgba(0,0,0,.55),rgba(0,0,0,.85))}
#qmBossC[hidden]{display:none}
.qmbc{text-align:center;color:#fff;font-family:var(--display);transform:scale(.6);opacity:0}
#qmBossC.go .qmbc{animation:qmbc 3.3s ease-out forwards}
@keyframes qmbc{0%{transform:scale(.4);opacity:0}12%{transform:scale(1.08);opacity:1}20%{transform:scale(1)}85%{opacity:1}100%{opacity:0;transform:scale(1.05)}}
.qmbc1{font-weight:800;letter-spacing:3px;color:#ffd21f;font-size:14px}.qmbc2{font-size:96px;line-height:1.1;filter:drop-shadow(0 0 18px rgba(229,72,77,.8))}
.qmbc3{font-size:30px;font-weight:900;text-transform:uppercase;color:#ff5a5f;text-shadow:0 3px 0 #000}.qmbc4{font-size:15px;color:#cfe0f5;margin-top:2px}.qmbc5{font-size:14px;font-style:italic;margin-top:10px;color:#fff;max-width:80vw}
#qmBossH{position:fixed;left:50%;transform:translateX(-50%);top:calc(max(8px,env(safe-area-inset-top,0px)) + 64px);z-index:6;width:min(360px,80vw);pointer-events:none;font-family:var(--display)}
#qmBossH[hidden]{display:none}.qmbh1{color:#fff;font-weight:800;font-size:13px;text-shadow:0 1px 2px #000;display:flex;justify-content:space-between}.qmbh1 small{color:#ffd21f}
.qmbh2{height:12px;border-radius:7px;background:rgba(0,0,0,.6);border:1px solid rgba(255,255,255,.4);overflow:hidden;margin-top:2px}.qmbh2 i{display:block;height:100%;transition:width .2s}
#qmBlind{position:absolute;inset:0;background:#f6f3ea;pointer-events:none}#qmBlind[hidden]{display:none}

.qmbh2.sh{height:7px;margin-top:2px}

#qmAlarm{position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at center,rgba(229,40,40,0) 45%,rgba(229,40,40,.55) 100%)}#qmAlarm[hidden]{display:none}
#qmFl{position:absolute;inset:0;pointer-events:none;background:#000}#qmFl[hidden]{display:none}
#qmShut{position:fixed;left:0;right:0;top:0;z-index:4;pointer-events:none;background:repeating-linear-gradient(#9aa3ad 0 9px,#6b7480 9px 12px);border-bottom:4px solid #3a4250;box-shadow:0 4px 10px rgba(0,0,0,.4);transition:height .4s}#qmShut[hidden]{display:none}

#qmBox{max-height:calc(100vh - 28px);max-height:calc(100dvh - 28px);overflow-y:auto;-webkit-overflow-scrolling:touch}
#qmOv{align-items:flex-start}#qmOv>#qmBox{margin:auto 0}
#qmHit:not([hidden]){width:66px!important;height:66px!important;font-size:10px!important}#qmHit span:first-child{font-size:21px!important}
#qmUlt{width:64px;height:64px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;font-size:10px;font-weight:800;color:#fff;padding:0;
  background:conic-gradient(#f5c542 var(--c,0%),rgba(40,40,50,.85) 0);border:3px solid rgba(245,197,66,.55);box-shadow:0 2px 8px rgba(0,0,0,.4);text-shadow:0 1px 2px #000}
#qmUlt.ready{background:radial-gradient(circle,#ffe58a,#e0a800);border-color:#fff3b0;color:#3a2a00;text-shadow:none;animation:qmUltP 1s ease-in-out infinite}
@keyframes qmUltP{50%{transform:scale(1.08);box-shadow:0 0 18px #ffd34d}}
#qmInv{position:fixed;right:max(6px,env(safe-area-inset-right,0px));bottom:calc(max(16px,env(safe-area-inset-bottom,0px)) + 200px);display:flex;flex-direction:column;gap:6px;z-index:6}
.qminv{width:44px;height:44px;border-radius:12px;border:2px solid rgba(255,255,255,.55);background:rgba(20,24,32,.72);font-size:24px;position:relative;padding:0;color:#fff}
.qminv.sp{border-color:#f5c542;margin-top:4px}.qminv.empty{opacity:.35}
.qminv b{position:absolute;right:1px;bottom:-1px;font-size:11px;background:#e8590c;border-radius:7px;padding:0 3px;line-height:14px}
.qmgt{display:flex;gap:4px;flex-wrap:wrap;margin:4px 0}.qmgt .abtn2{flex:1;min-width:70px;padding:6px 4px;font-size:12px}.qmgt .abtn2.on{background:#f5c542;color:#222}
.qmgl{text-align:left}.qmgi{font-size:12.5px;line-height:1.35;padding:6px 8px;margin:4px 0;background:rgba(255,255,255,.07);border-radius:8px}
/* Employe du Mois U3 : bloc de quetes en encadres + journal */
#objS{min-height:0!important;margin-top:2px!important;padding-top:0!important;border-top:0!important}
#objM{min-height:0!important}
#objM .qb,#objS .qb{border:1.5px solid rgba(40,60,90,.28);border-radius:8px;padding:2px 7px;margin:3px 0;background:rgba(255,255,255,.42);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;box-sizing:border-box}
#objM .qb.q0{border-color:#e5484d;background:rgba(255,235,235,.85)}
#objM .qb.q1{border-color:#e0a800;background:rgba(255,244,205,.85)}
#objM .qb.q2{border-color:#12a150}
#objs.open #objM{max-height:46vh;overflow-y:auto}
#objs.open .qb{white-space:normal!important}
.qjh{font-weight:800;margin-bottom:2px}.qjh small{font-weight:500;opacity:.7}
.qjm{font-size:11.5px;font-weight:700;opacity:.8;padding:1px 4px}
#sc .scp{display:block;font-weight:700;color:#b86e00}
/* Employe du Mois U4 */
#objM .qb,#objS .qb{white-space:normal!important;overflow:visible!important;background:rgba(255,255,255,.32)!important}
#objM .qb.q0{font-size:15px;font-weight:800;border-width:2.5px!important;animation:qbUrg 1s ease-in-out infinite}
@keyframes qbUrg{50%{background:rgba(255,80,80,.55);border-color:#ff1f1f}}
#objM .qb.qsel{border-color:#12a150!important;box-shadow:0 0 0 1.5px #12a150 inset}
#bQJ{position:relative}#bQJn{position:absolute;top:-4px;right:-4px;min-width:17px;height:17px;border-radius:9px;background:#e5484d;color:#fff;font:800 11px/17px system-ui;text-align:center;padding:0 3px;box-sizing:border-box}
#qjP{position:fixed;inset:0;z-index:40;background:rgba(5,10,20,.55);display:flex;align-items:flex-start;justify-content:center;padding:60px 12px 12px}
#qjP[hidden]{display:none}
#qjP .qjw{background:#f4f1ea;color:#1b2433;border-radius:14px;padding:10px 12px;width:min(420px,100%);max-height:75vh;overflow-y:auto;box-shadow:0 8px 30px rgba(0,0,0,.5)}
#qjP .qjt{font-weight:800;font-size:17px;display:flex;justify-content:space-between;align-items:center}
#qjP #qjX{border:0;background:#1b2433;color:#fff;border-radius:8px;width:30px;height:30px;font-size:16px}
#qjP .qjd{font-size:12px;opacity:.75;margin:4px 0 6px}
#qjP .qb{border:1.5px solid rgba(40,60,90,.3);border-radius:8px;padding:5px 8px;margin:5px 0;font-size:13px;background:#fff}
#qjP .qb.qk{cursor:pointer}#qjP .qb.qsel{border-color:#12a150;background:#e9f8ee}
#qjP .qb.q0{border-color:#e5484d}#qjP .qb.q1{border-color:#e0a800}
#edmArr{position:fixed;inset:0;z-index:5;pointer-events:none}
.qmarr.ya i{color:#ffd21f}.qmarr.red i{color:#ff3b30;animation:qbBl .8s infinite}.qmarr.red span{border-color:#ff3b30}.qmarr.grn i{color:#2ee66b}.qmarr.grn span{border-color:#2ee66b}
@keyframes qbBl{50%{opacity:.35}}
#toasts .tt.mini{background:rgba(20,26,38,.6)!important;color:#fff!important;border:0!important;box-shadow:none!important;font-size:11px!important;font-weight:600!important;padding:2px 8px!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis;margin-top:3px}
</style>


<div id="boot" style="position:fixed;inset:0;z-index:99999;background:linear-gradient(#3a86d9 0,#3a86d9 35%,#1b2030 65%,#1b2030 100%);overflow:hidden"><div class="artw"><img id="bootArt" alt="" src="data:image/jpeg;base64,"></div></div>
<script>setTimeout(function(){var b=document.getElementById('boot');if(b)b.remove();},9000);</script>
<div id="app">
  <canvas id="c"></canvas><canvas id="dk"></canvas><div id="nightMsg"></div>
  <div id="err" hidden>Le moteur 3D n'a pas pu se charger. Vérifiez la connexion et rechargez la page.</div>

  <div class="game" id="vig"></div>
  <div class="hud game" id="tl"><small id="rank">Employé</small><div id="objs"><div id="objM"></div><div id="objS"></div></div><div id="toasts"></div><div id="gains"></div></div>
  <div class="hud game" id="tr">
    <div id="stat"><small id="netS" hidden></small><small id="perf" hidden></small></div>
    <div class="row"><span id="clock">Jour 1 08:00</span><span class="gold"><b id="coins">0</b> pièces</span></div>
    <div id="blames"></div>
    <span id="sc">Bosseur 0 • Branleur 0</span>
    <div id="res" class="mini" hidden>Résultats<div class="bar"><i></i></div></div>
    <div id="comp" class="mini" hidden>Réputation<div class="bar"><i></i></div></div>
    <div id="rdr" class="mini" hidden>Détecteur 📡<div class="bar"><i></i></div></div>
    <div id="rglow"></div>
    <button id="bSnd" hidden aria-label="Son" style="pointer-events:auto;background:var(--panel);border:1px solid var(--edge);color:var(--fg);border-radius:8px;font-size:14px;padding:2px 8px;margin-top:4px;cursor:pointer">🔊</button>
    <div id="stam" class="mini" hidden>Endurance<div class="bar"><i></i></div></div>
    <div id="serb" class="mini">Sérieux<div class="bar"><i></i></div></div>
    <div id="hunger" class="mini">Faim<div class="bar"><i></i></div></div>
    <div id="urg" class="mini">🚽 Toilettes<div class="bar"><i></i></div></div>
    <div id="susp" class="mini">Alerte<div class="bar"><i></i></div></div>
  </div>
  <div class="hud game" id="wcbar"><button class="btn" id="bTel" hidden aria-label="Smartphone"><svg viewBox="0 0 24 24"><rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2"/></svg>Menu</button><button class="btn" id="bPhone" hidden>Appeler</button><button class="btn" id="bExit" hidden>Sortir</button></div>
  <div class="hud game" id="btns">
    <button class="btn" id="bTorch" hidden aria-label="Lampe torche"><span style="font-size:24px;line-height:1">🔦</span><span id="bTorchT">Torche</span></button>
    <button class="btn" id="bFork" hidden aria-label="Lever les fourches"><span style="font-size:22px;line-height:1">⬆️</span>Fourches</button>
    <button class="btn" id="bMach" hidden aria-label="Lâcher la machine"><span style="font-size:22px;line-height:1">🧹</span>Lâcher</button>
    <button class="btn" id="bDrop" hidden aria-label="Jeter le butin"><span style="font-size:24px;line-height:1">🗑️</span>Jeter</button>
    <button class="btn" id="bShout" hidden aria-label="Au travail"><span style="font-size:24px;line-height:1">📢</span>Au travail</button>
    <button class="btn" id="bLet" hidden aria-label="Faire chanter"><span style="font-size:24px;line-height:1">🤫</span>Chanter</button>
    
    <div id="cqp" hidden></div>
    <div id="colP"><button class="btn" id="bGrim" hidden aria-label="Faire une grimace"><span style="font-size:26px;line-height:1">😜</span>Grimace</button><button class="btn zo" id="bStrike" hidden aria-label="Grève"><span style="font-size:26px;line-height:1">✊</span><span id="bStrikeT">Grève</span></button><button class="btn zo" id="bSeat" hidden aria-label="S'asseoir"><span style="font-size:26px;line-height:1">🪑</span><span id="bSeatT">Asseoir</span></button><button class="btn zo" id="bBat" hidden aria-label="Frapper un client"><span style="font-size:26px;line-height:1">🏏</span><span id="bBatT">Tacler</span></button><button class="btn zo" id="bCli" hidden aria-label="Répondre au client"><span style="font-size:26px;line-height:1">❓</span>Répondre</button></div><button class="btn zo" id="bGuard" hidden aria-label="Parler à un vigile"><span style="font-size:26px;line-height:1">💼</span>Vigile</button><button class="btn zo" id="bGadget" hidden aria-label="Gadgets du vigile"><span style="font-size:26px;line-height:1">🎒</span>Gadgets</button><button class="btn" id="bAct" aria-label="Maintenir pour agir"><svg viewBox="0 0 24 24"><path d="M9 11V5a1.5 1.5 0 0 1 3 0v5m0-1.5a1.5 1.5 0 0 1 3 0V11m0-1a1.5 1.5 0 0 1 3 0v5a6 6 0 0 1-6 6h-1a6 6 0 0 1-5-3l-2-4a1.5 1.5 0 0 1 2.5-1.5L9 15"/></svg>Agir</button>
    <button class="btn zo" id="bMsg" hidden aria-label="Téléphone"><svg viewBox="0 0 24 24"><rect x="6.5" y="2.5" width="11" height="19" rx="3" fill="rgba(255,255,255,.22)"/><path d="M10 5.5h4M10.5 18.3h3"/></svg><b id="bMsgN" hidden></b></button>
  </div>
  <div class="hud" id="back"><button class="btn" id="bMenu" aria-label="Menu"><svg viewBox="0 0 24 24"><path d="M5 7.5h14M5 12h14M5 16.5h14"/></svg></button><button class="btn zo" id="bMap" aria-label="Carte du jeu" style="width:42px;height:42px;border-radius:14px;flex-direction:column;gap:0"><svg viewBox="0 0 24 24" style="width:20px;height:20px"><path d="M3.5 6.5l5.5-2 6 2 5.5-2v13l-5.5 2-6-2-5.5 2z" fill="rgba(255,255,255,.22)"/><path d="M9 4.5v13M15 6.5v13"/></svg><span style="font:700 9px var(--display);line-height:1;margin-top:1px">Carte</span></button><button class="btn zo" id="bRank" aria-label="Classement"><svg viewBox="0 0 24 24"><path d="M4 20v-7h5v7M9 20V7h6v13M15 20v-9h5v9" fill="rgba(255,255,255,.22)"/><path d="M12 2.8l1 2 2.2.3-1.6 1.5.4 2.2-2-1.1-2 1.1.4-2.2-1.6-1.5 2.2-.3z" fill="#fff" stroke="none"/></svg></button><button class="btn zo" id="bQJ" aria-label="Journal de quêtes"><span style="font-size:18px;line-height:1">📜</span><b id="bQJn" hidden></b></button><button class="btn zo" id="bLog" aria-label="Historique des messages"><span style="font-size:18px;line-height:1">💬</span></button><button class="btn zo" id="bHelp" aria-label="Légende des couleurs"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="rgba(255,255,255,.22)"/><path d="M9.5 9.6a2.6 2.6 0 1 1 3.7 2.3c-.8.5-1.2 1-1.2 1.8M12 17.2h.01"/></svg></button><button class="btn" id="bFs" hidden aria-label="Quitter le plein écran"><svg viewBox="0 0 24 24"><path d="M9 4H4v5M15 4h5v5M9 20H4v-5M15 20h5v-5"/><path d="M4 4l5 5M20 4l-5 5M4 20l5-5M20 20l-5-5"/></svg></button></div>
  <div class="hud maponly" id="maptitle">Touche une zone</div>
  <div id="stick" hidden><div id="knob"></div></div>
  <div id="toast"></div><div id="bubs"></div><div id="logp" hidden><div class="mbox" style="max-height:80vh;display:flex;flex-direction:column"><h3 style="margin:0 0 6px">💬 Derniers messages</h3><div id="logl" style="overflow-y:auto;flex:1;min-height:0"></div><button class="abtn full" id="logx" style="margin-top:8px">Fermer</button></div></div><div id="pop"></div><button id="cineSkip" aria-label="Passer l'arrivée">Passer ▶</button>
  <div id="alarmFx"></div><div id="strobeFx"></div>
  <div id="fade"></div>
