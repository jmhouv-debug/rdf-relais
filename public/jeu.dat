  else if(s[4]!==1&&D.hr){D.hr=0;dirc.scale.setScalar(1.06);dTagR.visible=false;dTag.visible=true;}
  return true;}
/* ---- actions des joueurs visibles par tous (feu, inondation, alarme...) ---- */
const WFX={feu:1,pneu:1,eteindre:1,essence:1,allumer:1,panne:1,dfrit:1,dext:1,deboucher:1};
function wfxSend(o,m,i){try{if(!NET.on||!NET.joined||!NET.sb)return;netSbBroadcast('wfx',{from:NET.pid,by:String(PNAME||'Un joueur').slice(0,20),o:o,zn:m&&m.zone?m.zone.id||m.zone.name||'':'',x:m?+m.x.toFixed(2):0,z:m?+m.z.toFixed(2):0,i:i|0});}catch(_){}}
function wfxFind(d){for(const k in Z){const zz=Z[k];if(!zz||!zz.markers)continue;const m=zz.markers.find(function(q){return q.obj===d.o&&Math.hypot(q.x-d.x,q.z-d.z)<.9;});if(m)return m;}return null;}
function wfxRecv(d){try{if(!d||d.from===NET.pid||typeof d.o!=='string')return;const by=String(d.by||'Un joueur').slice(0,20),o=d.o;
  if(o==='flood'){WCFL=Math.max(WCFL,60);if(WCIN)exitCabin();wcEject(true);toast('🌊 '+by+' a inondé les toilettes !');return;}
  if(o==='trace'){const i=d.i?1:0;WCDIRT[i]=1;showStain(i,'b');return;}
  if(!WFX[o])return;
  if(o==='deboucher'){if(WCFL>0){wcUnclog();toast('🪠 '+by+' a débouché les toilettes.');}return;}
  if(o==='alarme'){if(ALM.t>0)return;ALM.t=25;ALM.cd=240;PNK=0;$('alarmFx').classList.add('on');pop('🚨 ALARME INCENDIE tirée par '+by+' !','warn');return;}
  if(o==='essence'){STN.n=Math.min(3,STN.n+1);STN.pat.forEach(function(q,i){q.visible=i<STN.n*2+1;});STN.mk.al.off=false;toast('⛽ '+by+' répand de l\'essence à la station.');return;}
  if(o==='allumer'){if(STN.burn>0)return;igniteStation();toast('🔥 '+by+' a mis le feu à la station-service !');return;}
  if(o==='panne'){BAL.broken=true;BAL.t=240+Math.random()*340;BAL.hit=false;const m=wfxFind(d);if(m)m.cool=9999;toast('⚙️ '+by+' a mis la balle à cartons en panne.');return;}
  if(o==='dfrit'){if(!DF.on){startDriveFire();toast('🔥 '+by+' a mis le feu à la friteuse du Drive !');}return;}
  if(o==='dext'){if(DF.on){stopDriveFire();toast('🧯 '+by+' a éteint l\'incendie du Drive.');}return;}
  const m=wfxFind(d);if(!m)return;
  if(o==='feu'&&m.car&&!m.car.charred){const c=m.car;burnCar(c);m.off=true;m.cool=9999;c.mp.off=true;c.mp.cool=9999;toast('🔥 '+by+' a mis le feu à une voiture !');}
  else if(o==='pneu'&&m.car&&!m.car.flat){crevePneus(m.car);m.off=true;m.cool=9999;toast('🛞 '+by+' a crevé des pneus.');}
  else if(o==='eteindre'){if(m.car){const c=m.car;c.burn=0;m.off=true;stopFire(c.x,c.z,4);c.charred=false;c.body.material.color.setHex(c.col);c.win.material.color.setHex(0x080b10);c.mf.off=false;c.mf.cool=120;toast('🧯 '+by+' a éteint une voiture en feu.');}else if(STN.burn>0){STN.burn=0;STN.cool=150;STN.mk.ee.off=true;stopFire(19,31.5,14);STN.pat.forEach(function(q){q.visible=false;});toast('🧯 '+by+' a éteint la station-service.');}}
  }catch(e){console.log('wfx',e);}}
function netSbSendPos(force){const now=Date.now();{const n=Object.keys(NET.players).length;if(!force&&now-NET.sbLast<(n<=4?75:n<=8?120:180))return;}NET.sbLast=now;netSbBroadcast('pos',Object.assign({pid:NET.pid,joined:NET.myJoined||now},netMine()));}
function netSbFinishJoin(){
  if(!NET.on||!NET.sb||NET.joined)return;
  let older=0;Object.keys(NET.players).forEach(function(id){if(id!==NET.pid&&NET.players[id].joined<NET.myJoined)older++;});
  if(older>=10){NET.leaving=true;try{if(NET.ws)NET.ws.close();}catch(_){}toast('Partie complète : 10 joueurs maximum.');pop('👥 Partie complète (10 joueurs max)','bad');return;}
  NET.players[NET.pid]=Object.assign(sbClean(Object.assign({joined:NET.myJoined},netMine())),{seen:Date.now()});NET.joined=true;NET.lastState=Date.now();NET.hostPid=netNextHost(NET.players,null);
  toast('En ligne : connecté.');
}
function netSbTick(){
  const now=Date.now();
  if(NET.joined){if(now-(NET._st||0)>=100||!NET.players[NET.pid]){NET._st=now;NET.players[NET.pid]=Object.assign(sbClean(Object.assign({joined:NET.myJoined},netMine())),{seen:now});}
    Object.keys(NET.players).forEach(function(id){if(id!==NET.pid&&now-(NET.players[id].seen||0)>6000)delete NET.players[id];});
    NET.hostPid=netNextHost(NET.players,null);
    if(Object.keys(NET.players).length>1&&now-NET.lastState>35000){NET.lastState=now;try{if(NET.ws)NET.ws.close();}catch(_){}}}
  if(NET.sbJoined){netSbSendPos(false);if(netNpcIsHost())netNpcSend();}
}
function netJoined(){if(NET.joined)return;NET.joined=true;NET.lastState=Date.now();}
function netClient(){
  const p=new Peer('edmc-'+NET.pid);
  p.on('open',function(){NET.myPeer=p;NET.peers.push(p);netListen(p);NET.attempts++;netConnect('edm-'+NET.code,0,true);});
  p.on('error',function(e){if(e.type==='peer-unavailable'){if(!NET.joined&&NET.role!=='host')netCreate();return;}console.log('net',e.type);});
}
function netCreate(){
  if(NET.creating||NET.joined)return;NET.creating=true;
  const hp=new Peer('edm-'+NET.code);
  hp.on('open',function(id){const old=NET.myPeer;NET.myPeer=hp;NET.peers.length=0;NET.peers.push(hp);netListen(hp);try{old.destroy();}catch(_){}
    NET.role='host';NET.hostPid=NET.pid;NET.players[NET.pid]=Object.assign({joined:1,peerId:id},netMine());NET.seq=1;netJoined();toast('En ligne : tu as lancé la partie. Les amis arrivent avec le même lien.');});
  hp.on('error',function(e){if(e.type==='unavailable-id'){NET.creating=false;if(NET.attempts<4){setTimeout(function(){NET.attempts++;netConnect('edm-'+NET.code,0,true);},600+Math.random()*600);}else toast('En ligne : impossible de rejoindre ou de lancer la partie.');}else console.log('net',e.type);});
}
function netConnect(peerId,n,first){
  if(NET.role==='host'||NET.leaving)return;
  const c=NET.myPeer.connect(peerId,{reliable:true});let opened=false;
  const to=setTimeout(function(){if(opened)return;try{c.close();}catch(_){}if(first){if(!NET.joined&&NET.role!=='host')netCreate();return;}if(n<12)NET.recon=setTimeout(function(){netConnect(peerId,n+1,false);},1500);},7000);
  c.on('open',function(){opened=true;clearTimeout(to);NET.hostConn=c;NET.lastState=Date.now();c.send(Object.assign({t:'hello',pid:NET.pid,peerId:NET.myPeer.id},netMine()));});
  c.on('data',netData);
  c.on('close',function(){if(NET.hostConn===c){NET.hostConn=null;netHostLost();}});
  c.on('error',function(){});
}
function netListen(p){p.on('connection',function(c){
  c.on('data',function(m){if(NET.role!=='host'||!m)return;
    if(m.t==='hello'){const old=NET.players[m.pid];if(!old&&Object.keys(NET.players).length>=10){try{c.send({t:'full'});}catch(_){}setTimeout(function(){try{c.close();}catch(_){}},400);return;}NET.players[m.pid]=Object.assign({},m,{joined:old&&typeof old.joined==='number'?old.joined:++NET.seq,seen:Date.now()});delete NET.players[m.pid].t;delete NET.players[m.pid].pid;NET.conns[m.pid]=c;c._pid=m.pid;netBroadcast();}
    else if(m.t==='ev'){netRecvEv(m);Object.keys(NET.conns).forEach(function(pid){if(pid!==m.from){try{NET.conns[pid].send(m);}catch(_){}}});}
    else if(m.t==='pos'&&NET.players[m.pid]){const p0=NET.players[m.pid];p0.nm=m.nm;p0.zn=m.zn;p0.x=m.x;p0.z=m.z;p0.f=m.f;p0.in=m.in;p0.ky=m.ky||0;p0.im=m.im||0;p0.lv=m.lv||1;p0.sb=m.sb||0;p0.sw=m.sw||0;p0.lk=m.lk;p0.cd=String(m.cd||'').slice(0,12);p0.seen=Date.now();}});
  c.on('close',function(){if(c._pid&&NET.conns[c._pid]===c){delete NET.players[c._pid];delete NET.conns[c._pid];}});
  c.on('error',function(){});});}
function netData(m){if(m&&m.t==='full'){NET.leaving=true;try{if(NET.ws)NET.ws.close();}catch(_){}toast('Partie complète : 10 joueurs maximum.');pop('👥 Partie complète (10 joueurs max)','bad');return;}if(m&&m.t==='ev'&&(NET.role!=='host'||NET_URL)){netRecvEv(m);return;}if(!m||m.t!=='s'||(NET.role==='host'&&!NET_URL))return;NET.players=m.players||{};NET.hostPid=m.host;NET.seq=m.seq||NET.seq;NET.lastState=Date.now();netJoined();}
function netHostLost(){
  if(NET.leaving||NET.role==='host')return;
  const old=NET.hostPid;if(old)delete NET.players[old];
  const cand=netNextHost(NET.players,old);
  if(cand===NET.pid)netBecomeHost();
  else if(cand&&NET.players[cand]&&NET.players[cand].peerId){NET.hostPid=null;NET.lastState=Date.now()+4000;clearTimeout(NET.recon);NET.recon=setTimeout(function(){netConnect(NET.players[cand].peerId,0,false);},1200);}
}
function netBecomeHost(){
  NET.role='host';NET.hostPid=NET.pid;NET.hostConn=null;NET.players[NET.pid]=Object.assign(NET.players[NET.pid]||{joined:1},{peerId:NET.myPeer.id},netMine());
  toast('En ligne : tu deviens l\'hôte de la partie.');if(NET.myPeer.id!=='edm-'+NET.code)netLobby(0);
}
function netLobby(n){if(NET.leaving)return;const lp=new Peer('edm-'+NET.code);lp.on('open',function(){NET.peers.push(lp);netListen(lp);});lp.on('error',function(e){if(e.type==='unavailable-id'&&n<10)setTimeout(function(){netLobby(n+1);},3000);});}
function netBroadcast(){const msg={t:'s',players:NET.players,host:NET.hostPid,seq:NET.seq};Object.keys(NET.conns).forEach(function(pid){try{NET.conns[pid].send(msg);}catch(_){}});}
function netTick(){
  if(NET.on&&NET.sb&&!NET.leaving){netSbTick();return;}
  if(NET.on&&NET_URL&&!NET.leaving){if(NET.ws&&NET.ws.readyState===1){netWsSend(Object.assign({t:'pos',pid:NET.pid},netMine()));if(NET.joined&&Date.now()-NET.lastState>6000){try{NET.ws.close();}catch(_){}}}return;}
  if(!NET.on||!NET.joined||NET.leaving)return;
  if(NET.role==='host'){
    Object.assign(NET.players[NET.pid],netMine());
    const now=Date.now();Object.keys(NET.players).forEach(function(pid){if(pid===NET.pid)return;const p=NET.players[pid];if(!NET.conns[pid]||now-(p.seen||now)>8000){delete NET.players[pid];if(NET.conns[pid]){try{NET.conns[pid].close();}catch(_){}delete NET.conns[pid];}}});
    netBroadcast();NET.lastState=Date.now();
  }else if(NET.hostConn){
    try{NET.hostConn.send(Object.assign({t:'pos',pid:NET.pid},netMine()));}catch(_){}
    if(Date.now()-NET.lastState>4500){try{NET.hostConn.close();}catch(_){}NET.hostConn=null;netHostLost();}
  }
}
const NET_DEF={g:'h',build:1,tall:1,hs:'court',hc:0x4a2c1a,beard:0,cap:null,skin:0xf1c9a5,role:'e'};
function netFrame(dt){
  try{netWatchM();}catch(_){}
  if(NET.on&&NET.joined&&!NET.roleChk&&NET.players[NET.pid]&&typeof NET.players[NET.pid].joined==='number'){NET.roleChk=true;
    if(rank>=1){const jl0=NET.players[NET.pid].joined,c=netCounts(jl0),full=c.M+c.P>=6&&!proKeep();if(full){LK.role='e';applyLook(lookOpts(),PNAME);startRole('e');pop('👥 Postes de manager complets','warn');toast('Tous les postes de manager joueurs sont pris (3 au maximum). Tu entres comme employé.');}}
    if(SEC){const jl=NET.players[NET.pid].joined;let nv=0;Object.keys(NET.players).forEach(function(pid){if(pid===NET.pid)return;const p=NET.players[pid];if(p&&p.lk&&p.lk.role==='v'&&typeof p.joined==='number'&&p.joined<jl)nv++;});if(nv>=5){LK.role='e';applyLook(lookOpts(),PNAME);startRole('e');pop('🛡️ Postes de vigile pris','warn');toast('Les 5 postes de vigile joueur sont pris : tu entres comme employé.');}}}
  const hud=$('netS');if(!NET.on||!NET.joined){if(hud)hud.hidden=true;return;}
  let cnt=0;const seen={},first=NET.known===null;if(first)NET.known={};
  Object.keys(NET.players).forEach(function(pid){const p=NET.players[pid];if(!p)return;cnt++;if(pid===NET.pid)return;seen[pid]=1;
    if(!NET.known[pid]){NET.known[pid]=p.nm||'?';if(!first)toast((p.nm||'Un joueur')+' est arrivé dans le magasin.');}
    let a=NET.av[pid];const lkj=JSON.stringify(p.lk||{});
    if(!a||a.lkj!==lkj){if(a&&a.g.parent)a.g.parent.remove(a.g);const g=makeChar(lookOpts(Object.assign({},NET_DEF,p.lk)));
      const nl=label(p.nm||'?',{fit:1,sx:1.7,sy:.42,w:256,h:64,size:30,bg:'rgba(47,111,208,.92)',depth:false});nl.position.set(0,2.75,0);g.add(nl);{const ib=label((p.lk&&p.lk.ic)||'⭐',{sx:.95,sy:.95,w:96,h:96,size:62,bg:'rgba(0,0,0,0)',depth:false});ib.position.set(0,3.45,0);g.add(ib);}
      a={g:g,lkj:lkj,x:p.x,z:p.z,f:p.f||0,ph:0,zn:null};NET.av[pid]=a;}
    if(a.zn!==p.zn){if(a.g.parent)a.g.parent.remove(a.g);const zz=Z[p.zn];if(zz){zz.g.add(a.g);a.zn=p.zn;a.x=p.x;a.z=p.z;}}
    const ex=Math.min(.16,Math.max(0,(Date.now()-(p.rt||0))/1000)),tx=p.x+(p.vx||0)*ex,tz=p.z+(p.vz||0)*ex,k=Math.min(1,dt*20),nx=a.x+(tx-a.x)*k,nz=a.z+(tz-a.z)*k,mvd=Math.hypot(nx-a.x,nz-a.z);a.x=nx;a.z=nz;a.f=angLerp(a.f,p.f||0,Math.min(1,dt*10));
    a.ph+=mvd*5.2;walkAnim(a.g,a.ph,dt>0?Math.min(1,mvd/(dt*3.6)):0);
    a.g.position.set(a.x,0,a.z);a.g.rotation.y=a.f;a.g.visible=mode==='zone'&&cur===p.zn&&!!p.in;});
  Object.keys(NET.av).forEach(function(pid){if(!seen[pid]){const a=NET.av[pid];if(a.g.parent)a.g.parent.remove(a.g);delete NET.av[pid];if(NET.known&&NET.known[pid]){toast(NET.known[pid]+' est parti.');delete NET.known[pid];}}});
  if(hud){hud.hidden=false;hud.textContent='En ligne · '+cnt+' joueur'+(cnt>1?'s':'')+(NET.role==='host'?' · hôte':'');}
}
addEventListener('pagehide',function(){if(NET.sb)netSbBroadcast('bye',{pid:NET.pid});NET.leaving=true;try{if(NET.ws)NET.ws.close();}catch(_){}try{NET.peers.forEach(function(p){p.destroy();});}catch(_){}});
/*NET-END*/
/* v211 : plafonds de PNJ par zone + alarmes incendie contre un mur */
(function(){const KS=['Léa','Tom','Clara','Manon','Charlene','Laura','Marc','Quentin','Houcine','Fatima','Hugo','Elian','Johanna','Joad','Eric','Fatia'],MAXZ={reserve:4,drive:4,office:4,electro:3,location:1,poissonnerie:2,boulangerie:3},cnt={};
  EMP.forEach(function(e){if(!e.name)return;const z=e.zn;let keep=true;if(z==='store')keep=KS.indexOf(e.name)>=0;else if(MAXZ[z]!==undefined){cnt[z]=(cnt[z]||0)+1;keep=cnt[z]<=MAXZ[z];}
    if(!keep){e.out=1e9;e.cap=1;e.g.visible=false;}});
  const AL=[['store',-20.6,17.9,'S'],['store',45.5,5,'E'],['electro',-59.4,54.7,'S'],['reserve',-27,-26.2,'S'],['office',41.6,-26.2,'S']];
  Object.keys(Z).forEach(function(k){const zn=Z[k];for(let i=zn.markers.length-1;i>=0;i--){const m=zn.markers[i];if(m.obj==='alarme'){zn.g.remove(m.g);zn.markers.splice(i,1);}}});
  AL.forEach(function(a){const zn=Z[a[0]],b=zn.bounds,g=zn.g,x=a[1],z=a[2];marker(zn,'alarme',x,z,'Alarme incendie');
    const wx=a[3]==='E'?b.x[1]-.12:a[3]==='W'?b.x[0]+.12:x,wz=a[3]==='S'?b.z[1]-.12:a[3]==='N'?b.z[0]+.12:z,ew=a[3]==='E'||a[3]==='W';
    box(g,ew?.2:.5,.62,ew?.5:.2,0xd62839,wx,1.45,wz,false);box(g,ew?.22:.3,.22,ew?.3:.22,0xf5f5f5,wx+(a[3]==='E'?-.02:a[3]==='W'?.02:0),1.5,wz+(a[3]==='S'?-.02:a[3]==='N'?.02:0),false);});
})();
/* v215 : moins de ronds regroupes dans le magasin, un employe de moins en rayon */
(function(){const zn=Z.store,TH={rat:1,perime:1,dates:1,retourner:1,poser:1,chariot:1,facing:1,prix:1,piles:1,jouets:1,ouvrir:1,gouter:1},SK={mctrl:1,mpcam:1,vcaisse:1,vprix:1,vissue:1,rd1:1,cmdpick:1,aidecaisse:1},cnt={};
  zn.markers.forEach(function(m){cnt[m.obj]=(cnt[m.obj]||0)+1;});
  for(let i=zn.markers.length-1;i>=0;i--){const m=zn.markers[i];if(!TH[m.obj]||cnt[m.obj]<=1)continue;
    const nb=zn.markers.some(function(o){return o!==m&&!SK[o.obj]&&Math.hypot(o.x-m.x,o.z-m.z)<5;});
    if(nb){zn.g.remove(m.g);zn.markers.splice(i,1);cnt[m.obj]--;}}
})();
/* v216 : questions des clients (rares) */
const CQ={c:null,st:'',cd:70,t:0,rg:''};
function cqEnd(){cqHide();const q=CQ.c;if(q){if(q.qm)q.qm.visible=false;q.path=null;q.wait=1.5;}CQ.c=null;CQ.st='';CQ.cd=90+Math.random()*60;const b=$('bCli');if(b)b.hidden=true;}
function cqWit(why){if(rank!==0)return;if(seenList.some(function(w){return w.k==='mgr'||w.k==='guard'||w.k==='dir';})){MW.push(clk);if(MW.length>=3){MW=[];giveBlame(why+' (vu par un manager) !',2);}else pop('⚠️ Avertissement ('+MW.length+'/3) : '+why+', un manager t\'a vu.','bad');}}
function cqRes(d){if(rank>=1)RESULT=clamp(RESULT+d,0,100);}
function cqDone(){coins+=2;cqRes(1);pop('✅ Client accompagné jusqu\'au rayon : +2 pièces'+(rank>=1?', Résultats +1':'')+'.','good');say(CQ.c.g,'Merci beaucoup !');cqEnd();}
function cqMove(n,dt){const dx=pp.x-n.x,dz=pp.z-n.z,d=Math.hypot(dx,dz);
  if(CQ.st==='ask'||CQ.st==='dlg'){n.g.rotation.y=angLerp(n.g.rotation.y,Math.atan2(dx,dz),1-Math.exp(-dt*8));walkAnim(n.g,0,0);n.g.position.set(n.x,0,n.z);return true;}
  if(CQ.st==='come'&&d<2.3){CQ.st='ask';CQ.t=18;say(n.g,'Excusez-moi, vous savez où est le rayon « '+CQ.rg+' » ?');return true;}
  if(CQ.st==='follow'&&d<1.8){n.g.rotation.y=angLerp(n.g.rotation.y,Math.atan2(dx,dz),1-Math.exp(-dt*8));walkAnim(n.g,0,0);n.g.position.set(n.x,0,n.z);return true;}
  if(CQ.st==='come'||CQ.st==='follow'){n.rp=(n.rp||0)-dt;if(!n.path||n.pi>=n.path.length||n.rp<=0){n.rp=.8;n.path=path(S,n.x,n.z,pp.x,pp.z);n.pi=0;}follow(n,dt,CQ.st==='come'?2.6:2.4);n.g.rotation.y=angLerp(n.g.rotation.y,n.hd,1-Math.exp(-dt*6));walkAnim(n.g,n.ph,1);n.g.position.set(n.x,0,n.z);return true;}
  return false;}
function cqHide(){const p=$('cqp');if(p)p.hidden=true;}
function cqPick(f){cqHide();f();}
function cqOpen(){if(CQ.st!=='ask'||!CQ.c)return;CQ.st='dlg';CQ.t=10;const rg=CQ.rg,p=$('cqp');if(!p)return;
  p.innerHTML='<div class="cqh">🛒 « Où est le rayon '+rg+' ? »</div><div class="cqg"><button data-q="r">Le renseigner<small>+1 🪙</small></button><button data-q="a">L\'accompagner<small>+2 🪙</small></button><button data-q="m">Mauvais rayon<small>+4 branleur</small></button><button data-q="b">Blague<small>+3 branleur</small></button><button data-q="v" class="wide">« Va voir mon manager »<small>+2 branleur</small></button></div>';p.hidden=false;
  p.onclick=function(e){const b=e.target.closest('button');if(!b||CQ.st!=='dlg')return;const q=b.dataset.q;
    if(q==='r')cqPick(function(){coins+=1;cqRes(1);toast('Tu le renseignes : +1 pièce de pourboire'+(rank>=1?', Résultats +1':'')+'.');say(CQ.c.g,'Merci !');cqEnd();});
    else if(q==='a')cqPick(function(){CQ.st='follow';CQ.t=70;toast('Le client te suit : mène-le au rayon '+rg+' (70 s).');});
    else if(q==='m')cqPick(function(){addB(4);cqRes(-1);toast('Tu l\'envoies dans le mauvais rayon : +4 branleur.');cqWit('tu envoies un client au mauvais endroit');say(CQ.c.g,'Euh… d\'accord.');cqEnd();});
    else if(q==='b')cqPick(function(){addB(3);cqRes(-1);toast('Tu lui sors une blague : +3 branleur.');cqWit('tu te moques d\'un client');say(CQ.c.g,'Ha… ha…');cqEnd();});
    else if(q==='v')cqPick(function(){addB(2);cqRes(-1);toast('Tu t\'en fiches complètement : +2 branleur.');cqWit('tu envoies balader un client');say(CQ.c.g,'Quel accueil…');cqEnd();});};}
function cqTick(dt){const b=$('bCli');
  const can=mode==='zone'&&cur==='store'&&!MEET.on&&ALM.t<=0&&!VIGI&&!SEC&&!CINE&&!CARM&&!PSEAT&&!BR;
  if(!can){if(CQ.c&&CQ.st!=='dlg')cqEnd();if(b)b.hidden=true;return;}
  if(!CQ.c){CQ.cd-=dt;if(b)b.hidden=true;if(CQ.cd>0||uiOpen||act)return;
    let best=null,bd=1e9;NPC.forEach(function(n){if(n.noq||n.name||n.off||n.f||n.loot||n.flee>0||n.help||n.tk)return;const d=Math.hypot(n.x-pp.x,n.z-pp.z);if(d>4&&d<10&&d<bd){bd=d;best=n;}});
    const K=Object.keys(GON);if(!best||!K.length){CQ.cd=6;return;}
    CQ.c=best;CQ.rg=K[(Math.random()*K.length)|0];CQ.st='come';CQ.t=25;
    if(!best.qm){best.qm=label('❓',{sx:.8,sy:.8,w:96,h:96,size:60,bg:'rgba(46,125,230,.95)'});best.qm.position.set(0,3.3,0);best.g.add(best.qm);}best.qm.visible=true;return;}
  const n=CQ.c;if(n.off||n.f){cqEnd();return;}
  const d=Math.hypot(n.x-pp.x,n.z-pp.z);
  if(CQ.st==='come'){CQ.t-=dt;if(CQ.t<=0||d>16)cqEnd();}
  else if(CQ.st==='ask'){CQ.t-=dt;if(CQ.t<=0||d>6){toast('Le client est parti chercher tout seul.');cqEnd();}}
  else if(CQ.st==='dlg'){CQ.t-=dt;if(CQ.t<=0||d>8){cqHide();toast('Le client n\'a pas attendu ta réponse.');cqEnd();}}
  else if(CQ.st==='follow'){CQ.t-=dt;const g=GON[CQ.rg];if(g&&Math.hypot(pp.x-g.x,pp.z-g.z)<4.5&&d<5.5)cqDone();else if(CQ.t<=0||d>13){toast('Tu as perdu le client en route : pas de récompense.');cqEnd();}}
  if(b)b.hidden=!(CQ.st==='ask'&&!uiOpen&&d<3.4);}
$('bCli').addEventListener('click',function(){cqOpen();});
/* v216 : batte de baseball / tacle sur les clients, pompier, directrice furieuse */
const BH={cd:0},PF={g:null,x:30.4,z:16.4,ph:0,path:null,pi:0,st:'',tg:null,rp:0,rage:false};
function batTarget(){let b=null,bd=1.5;NPC.forEach(function(n){if(n.name||n.off||n.fall>0||n.gone>0)return;const d=Math.hypot(n.x-pp.x,n.z-pp.z);if(d<bd){bd=d;b=n;}});return b;}
function pfCall(n,rage){if(!PF.g){PF.g=makeChar({shirt:0xd62839,pants:0x2b2f36,hair:0x2a2a2a,badge:1});S.g.add(PF.g);}if(PF.st)return;PF.x=30.4;PF.z=16.4;PF.st='go';PF.tg=n;PF.rage=rage;PF.path=null;PF.rp=0;PF.g.visible=true;toast('🚒 Quelqu\'un a appelé les pompiers : un pompier arrive pour le client.');}
function pfTick(dt){NPC.forEach(function(n){if(n.gone>0)n.gone-=dt;});if(!PF.st||!PF.g)return;
  if(PF.st==='go'){const n=PF.tg;if(!n){PF.st='';PF.g.visible=false;return;}PF.rp-=dt;if(!PF.path||PF.pi>=PF.path.length||PF.rp<=0){PF.rp=1;PF.path=path(S,PF.x,PF.z,n.x,n.z);PF.pi=0;}
    follow(PF,dt,3.6);PF.g.rotation.y=angLerp(PF.g.rotation.y,PF.hd||0,1-Math.exp(-dt*8));walkAnim(PF.g,PF.ph,1);PF.g.position.set(PF.x,0,PF.z);
    if(Math.hypot(PF.x-n.x,PF.z-n.z)<1.5){n.gone=150;n.fall=0;n.g.rotation.x=0;n.g.visible=false;if(CQ.c===n)cqEnd();try{say(PF.g,'On s\'occupe de vous, monsieur !');}catch(_){}PF.st='out';PF.path=path(S,PF.x,PF.z,30.4,16.4);PF.pi=0;toast('Le pompier embarque le client.');addAnger(PF.rage?100:25);}}
  else{const arr=follow(PF,dt,3.6);PF.g.rotation.y=angLerp(PF.g.rotation.y,PF.hd||0,1-Math.exp(-dt*8));walkAnim(PF.g,PF.ph,1);PF.g.position.set(PF.x,0,PF.z);if(arr){PF.st='';PF.g.visible=false;}}
  PF.g.visible=PF.g.visible&&cur==='store'&&mode==='zone';}
function batHit(){const n=batTarget();if(!n||BH.cd>0)return;const bat=INV.batte>0;BH.cd=bat?2.5:30;
  if(bat){INV.batte--;NOCOIN=1;addB(8);NOCOIN=0;}else{SB+=1;coins+=1;}
  n.fall=4;n.path=null;if(CQ.c===n)cqEnd();try{say(n.g,bat?'AÏE !':'Hé !');}catch(_){}
  pop(bat?'🏏 Coup de batte sur un client ! +8 branleur':'🤼 Tu plaques un client ! +1 branleur, +1 pièce','bad');
  if(seenList.some(function(w){return w.k==='mgr'||w.k==='guard'||w.k==='dir'||w.k==='cam';})){giveBlame('tu as frappé un client devant témoin !',10);if(seenList.some(function(w){return w.k==='cam';}))camAlert();}
  pfCall(n,bat);renderQI();}
function batUI(dt){BH.cd=Math.max(0,BH.cd-dt);const b=$('bBat');if(!b)return;const ok=mode==='zone'&&cur==='store'&&rank===0&&!VIGI&&!SEC&&!uiOpen&&!MEET.on&&!CINE&&!CARM&&!PSEAT&&!!batTarget();b.hidden=!ok;if(ok){b.disabled=BH.cd>0;const t=$('bBatT');if(t)t.textContent=(BH.cd>0&&!(INV.batte>0)?'Tacler '+Math.ceil(BH.cd)+' s':(INV.batte>0?'Batte ×'+INV.batte:'Tacler'));}}
$('bBat').addEventListener('click',function(){batHit();});
/* v212 : cachettes sur le parking */
(function(){[['store',[[-24,-16],[-10,-16.2],[8,-16.2],[26,-16.2],[31,-8.8],[44.2,-8.8],[-27,4],[-9,2.2]],'Sous un carton',1],['reserve',[[-22,-38.3],[-15.6,-38.3],[-30,-30]],'Chambre froide / recoin',0]].forEach(function(sp){const zz=Z[sp[0]];sp[1].forEach(function(c){const q=nearFree(zz,c[0],c[1]);if(zz.markers.some(function(m){return !MGRONLY[m.obj]&&Math.hypot(m.x-q[0],m.z-q[1])<2.4;}))return;marker(zz,'cache',q[0],q[1],sp[2]);if(sp[3]){const g=zz.g;box(g,1.1,.8,.7,0xb98b5a,q[0],.4,q[1]-.85,false);box(g,1.12,.06,.2,0xe8d3a8,q[0],.82,q[1]-.85,false);box(g,.7,.5,.6,0xc79a63,q[0]+.9,.25,q[1]-.8,false);}});});})();
(function(){const P2=Z.parking;[[-6,72],[-10,45],[14,70],[40,55],[58,40]].forEach(function(c){const q=nearFree(P2,c[0],c[1]);marker(P2,'cachette',q[0],q[1],'Cachette');});})();
accAuto();(function(){var b=document.getElementById('boot');if(b)b.remove();})();
requestAnimationFrame(frame);
})();
</script>

</body></html>