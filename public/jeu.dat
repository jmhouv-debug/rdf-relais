  function flat(w,d,x,z,c,y,h){return box(g,w,h||.06,d,c,x,y===undefined?-.01:y,z,false);}
  const RD=0x2f3238,SW=0xbdc2ca;
  /* circuit : route a gauche (x -34), en bas (z 70), a droite (x 49) */
  flat(6,50,49,48.5,RD,.0);flat(88,6,7.5,70,RD,.0);
  for(let z=26;z<=66;z+=4){box(g,.18,.02,2,0xf2c94c,49,.04,z,false);}
  for(let x=-32;x<=46;x+=4)box(g,2,.02,.18,0xf2c94c,x,.04,70,false);
  [46.1,51.9].forEach(function(x){box(g,.12,.02,50,0xffffff,x,.04,48.5,false);});
  [67.1,72.9].forEach(function(z){box(g,88,.02,.12,0xffffff,7.5,.04,z,false);});
  /* flèches de sens au sol */
  [[49,60,0]].forEach(function(a){const m=new T.Mesh(new T.ShapeGeometry((function(){const sh=new T.Shape();sh.moveTo(0,1.2);sh.lineTo(.9,0);sh.lineTo(.3,0);sh.lineTo(.3,-1.2);sh.lineTo(-.3,-1.2);sh.lineTo(-.3,0);sh.lineTo(-.9,0);sh.closePath();return sh;})()),new T.MeshBasicMaterial({color:0xffffff}));m.rotation.x=-Math.PI/2;m.rotation.z=a[2];m.position.set(a[0],.05,a[1]);g.add(m);});
  /* trottoirs + bordures */
  flat(2.4,50,-38.6,48.5,SW,.01,.08);flat(2.4,50,53.2,48.5,SW,.01,.08);flat(88,2.4,7.5,74.2,SW,.01,.08);
  flat(9.6,46,59.2,48.5,0xaab3a8,.0,.06);flat(88,4.6,7.5,77.7,0xaab3a8,.0,.06);
  /* facade du magasin (prolongee) */
  box(g,10,5,.6,0xece6d6,-33,2.5,22.7,true);box(g,10,.5,.64,0x1d3b6f,-33,.25,22.7,false);box(g,18,5,.6,0xece6d6,37,2.5,22.7,true);box(g,18,.5,.64,0x1d3b6f,37,.25,22.7,false);
  box(g,20,5,.6,0xece6d6,56,2.5,22.7,true);
  /* haies + arbres */
  box(g,102,1,.4,0x3f7d4a,13,.5,79.6,true);box(g,.4,1,56,0x3f7d4a,63.8,.5,51.6,true);
  [[60,30],[62,36],[60,58],[62,68],[-24,76],[-8,76],[8,76],[24,76],[40,76],[56,76]].forEach(function(p){cyl(g,.18,.22,1.8,0x7a5230,p[0],.9,p[1],true);sph(g,1.2,0x3f8f4a,p[0],2.5,p[1]);sph(g,.9,0x4aa356,p[0]+.4,3.1,p[1]-.2);});
  /* panneau passage pietons */
  cyl(g,.06,.06,2.6,0x6b7480,53.4,1.3,52.6,true);box(g,.8,.8,.08,0x2f6fd0,53.4,2.7,52.6,false);
  for(let z=44.6;z<=51.4;z+=1)box(g,6,.02,.5,0xffffff,49,.05,z-.3,false);
  /* kiosque ascenseur du Drive (a droite, face a la route) */
  const kx=59.5,kz=48,kg=new T.Group();kg.position.set(kx,0,kz);kg.rotation.y=Math.PI/2;g.add(kg);
  box(kg,4.8,.25,3.6,0x8d939c,0,.12,0,true);
  box(kg,4.4,4.6,3.2,0xcfd6de,0,2.55,0,true);box(kg,4.6,.35,3.4,0x6a4c93,0,5,0,true);
  box(kg,3.4,3.0,.08,0x7fd0ff,0,1.75,-1.62,false).material.transparent=true;
  box(kg,1.05,2.7,.12,0xaab4c0,-.55,1.6,-1.66,false);box(kg,1.05,2.7,.12,0xaab4c0,.55,1.6,-1.66,false);box(kg,.08,2.7,.14,0x23272e,0,1.6,-1.7,false);
  box(kg,.3,.5,.1,0x23272e,1.6,1.4,-1.68,false);box(kg,.14,.14,.12,0x2ecc71,1.6,1.5,-1.74,false);
  const ks=sign('DRIVE ▼',3,.8,'#6a4c93','#ffffff');ks.position.set(0,5.7,-1.7);kg.add(ks);
  const el2=label('EN PANNE',{sx:2,sy:.5,w:256,h:64,size:34,bg:'rgba(214,40,57,.97)',depth:false});el2.position.set(kx-2.1,2.7,kz);el2.visible=false;g.add(el2);ELEV.sign.push(el2);
  obs(P,kx,kz,3.6,4.8);
  marker(P,'dpanne',56.2,44.2,'Bloquer l\'ascenseur');marker(P,'repasc',56.2,51.8,'Réparer l\'ascenseur');
  /* drivers */
  [['Kévin',3,0x6b3a2a],['Amélie',15,0x3a2a1a],['Sofiane',27,0x222222]].forEach(function(d,i){
    const c=makeChar({shirt:0x6a4c93,pants:0x2b2f36,hair:d[2],badge:1,cap:0x6a4c93,fem:i===1?1:0,hs:i===1?'long':undefined});c.visible=false;g.add(c);empTag(c,'Driver '+d[0],'');
    const cr=box(c,.5,.36,.4,0xc9a26b,0,1.05,.42,false);
    const bl=new T.Mesh(new T.CircleGeometry(1.1,18),new T.MeshBasicMaterial({color:0x9b1c24,transparent:true,opacity:.9,depthWrite:false}));bl.rotation.x=-Math.PI/2;bl.visible=false;g.add(bl);
    DRVN.push({sayT:1+i*1.3,lab:null,sl:null,c:c,nm:'Driver '+d[0],st:'idle',t:d[1],x:55,z:48,path:null,pi:0,ph:0,hd:-Math.PI/2,crate:cr,blood:bl,t0:d[1]});cr.visible=false;});
})();

const CART={n:9,max:12,t:0,lb:null,mk:null};let CARTLD=-1;
/* ----- Parking : bitume plus riche, vegetation, lampadaires, chariots ----- */
(function(){
  const g=P.g;
  try{const ac=document.createElement('canvas');ac.width=ac.height=512;const ax=ac.getContext('2d');ax.fillStyle='#464950';ax.fillRect(0,0,512,512);
    for(let i=0;i<7;i++){const v=58+Math.floor(Math.random()*14);ax.fillStyle='rgba('+v+','+(v+2)+','+(v+8)+',.3)';ax.beginPath();ax.ellipse(120+Math.random()*270,120+Math.random()*270,40+Math.random()*60,25+Math.random()*40,Math.random()*3,0,7);ax.fill();}
    for(let i=0;i<7000;i++){const v=52+Math.floor(Math.random()*52);ax.fillStyle='rgb('+v+','+(v+2)+','+(v+8)+')';ax.fillRect(Math.random()*512,Math.random()*512,1+Math.random()*2.4,1+Math.random()*2.4);}
    for(let i=0;i<3;i++){ax.fillStyle='rgba(14,14,18,.22)';ax.beginPath();ax.ellipse(40+Math.random()*430,40+Math.random()*430,10+Math.random()*16,7+Math.random()*10,Math.random()*3,0,7);ax.fill();}
    ax.lineCap='round';ax.lineJoin='round';for(let i=0;i<4;i++){ax.strokeStyle='rgba(14,16,20,.5)';ax.lineWidth=1.2+Math.random()*1.2;ax.beginPath();let x=60+Math.random()*390,y=60+Math.random()*390,a=Math.random()*6.28;ax.moveTo(x,y);for(let k=0;k<12;k++){a+=Math.random()*.9-.45;x+=Math.cos(a)*14;y+=Math.sin(a)*14;ax.lineTo(x,y);}ax.stroke();}
    const tx=ctex(ac);tx.wrapS=tx.wrapT=T.RepeatWrapping;tx.repeat.set(10,6);tx.anisotropy=4;if(P.floorMesh){P.floorMesh.material.map=tx;P.floorMesh.material.needsUpdate=true;}}catch(_){}
  const GR=[0x2c7a38,0x3a9448,0x4fae55,0x2a6c35,0x63bf5f];
  function tree(x,z,k){k=k||1;cyl(g,.16*k,.26*k,2.1*k,0x7a5230,x,1.05*k,z,true);
    [[0,3.0,0,1.5],[.9,2.5,.3,1.1],[-.8,2.6,-.2,1.15],[.2,3.8,.2,1.0],[-.3,2.4,.9,.95],[.4,2.6,-.9,.9]].forEach(function(q,i){const m=sph(g,q[3]*k,GR[i%GR.length],x+q[0]*k,q[1]*k,z+q[2]*k);if(i<2){m.castShadow=true;}});}
  function bush(x,z,k,fl){k=k||1;[[0,0,.8],[.7,.1,.6],[-.6,.05,.65],[.15,.1,.62]].forEach(function(q,i){sph(g,q[2]*k,GR[(i+1)%GR.length],x+q[0]*k,.45*k,z+q[1]*k,1,.8,1).castShadow=true;});
    if(fl){const FC=[0xff5d73,0xffd23a,0xffffff,0xff9bd1];for(let i=0;i<7;i++)sph(g,.09*k,FC[i%4],x+(Math.random()-.5)*1.5*k,.55*k+Math.random()*.5*k,z+(Math.random()-.5)*1.1*k);}}
  /* arbres sur les pelouses exterieures */
  [-30,-18,-6,6,18,30,42,54,64].forEach(function(x,i){tree(x,82.2,1+((i*37)%5)/12);});
    [30,44,58,72].forEach(function(z,i){tree(66.4,z,1+((i*23)%5)/12);});
  box(g,106,.04,5,0x7fb36b,13,-.02,82.2,false);box(g,5,.04,60,0x7fb36b,-42.2,-.02,52,false);buildFacades(g);box(g,5,.04,52,0x7fb36b,66.4,-.02,52,false);
  /* buissons fleuris le long des haies et des trottoirs */
  [-26,-12,2,16,30,44].forEach(function(x,i){bush(x,78.7,1,i%2===0);});
    [34,52,66].forEach(function(z){bush(62.4,z,.9,true);});
  /* jardinieres au bord du parking */
  [[-34,25.2],[-6,25],[26,25.2]].forEach(function(q){box(g,2.6,.55,1.1,0x9a6a3a,q[0],.28,q[1],true);box(g,2.4,.12,.9,0x4a2f1a,q[0],.58,q[1],false);for(let i=0;i<5;i++)sph(g,.22,[0xff5d73,0xffd23a,0xff9bd1][i%3],q[0]-.9+i*.45,.78,q[1]);});
  /* lampadaires : bras + tete lumineuse */
  [[-29.6,30],[-29.6,44],[-29.6,58],[45.2,30],[45.2,58]].forEach(function(q){const d=q[0]<0?1:-1;box(g,.7,.12,.12,0x6b7480,q[0]+d*.3,5.1,q[1],false);ell(g,.3,0xfff0b8,q[0]+d*.62,4.92,q[1],1.5,.55,1);cyl(g,.2,.24,.4,0x59616e,q[0],.2,q[1],true);});
  /* chariots */
  function cartM(x,z,r){const cg=new T.Group();cg.position.set(x,0,z);cg.rotation.y=r;g.add(cg);box(cg,.62,.06,.9,0xaeb6c2,0,.34,0,true);box(cg,.62,.34,.04,0xc8d0da,0,.55,.45,true);box(cg,.62,.34,.04,0xc8d0da,0,.55,-.45,true);box(cg,.04,.34,.9,0xc8d0da,.31,.55,0,true);box(cg,.04,.34,.9,0xc8d0da,-.31,.55,0,true);box(cg,.62,.05,.05,0xd62839,0,.92,.5,false);[[-.25,-.35],[.25,-.35],[-.25,.35],[.25,.35]].forEach(function(w){tube(cg,.06,.06,.04,0x15181d,w[0],.08,w[1],1,1,0,Math.PI/2);});}
  cartM(-33.4,30.4,.3);cartM(-33.6,31.6,.12);cartM(-33.2,32.8,.4);box(g,1.1,.04,3,0xf2c94c,-33.5,.03,31.4,false);
  /* abri a caddies : toit, poteaux, panneau, compteur */
  [[-34.6,29.6],[-32.4,29.6],[-34.6,33.2],[-32.4,33.2]].forEach(function(q){cyl(g,.07,.07,1.9,0x59616e,q[0],.95,q[1],false);});
  box(g,2.6,.14,4.1,0x2a9d8f,-33.5,1.95,31.4,false);box(g,2.6,.06,.1,0xffffff,-33.5,1.86,29.4,false);
  CART.lb=dynLabel(400,72,3.9,.7);CART.lb.sp.position.set(-33.5,3.1,31.4);g.add(CART.lb.sp);
  cartM(-27.4,32.2,.8);cartM(-26.7,33.7,2.2);cartM(-28.3,34.3,1.4);
  CART.mk=marker(P,'caddies',-28.4,32.3);
})();
function drvSlot(i){return [54.3,46.3+i*1.7];}
function drvSay(d,dt){d.sayT-=dt;if(d.sayT>0)return;
  if(d.lab){d.lab.visible=false;d.lab=null;d.sayT=2+Math.random()*3;return;}
  const M=['Mais c\'est quoi ce bazar !','On est bloqués !','Un manager, vite !','Ça fait une heure qu\'on attend !','Encore cet ascenseur…'],k=(Math.random()*M.length)|0;
  if(!d.sl)d.sl={};if(!d.sl[k]){const l=label(M[k],{sx:2.9,sy:.5,w:400,h:64,size:26,bg:'rgba(214,40,57,.95)',fg:'#ffffff'});l.position.y=3.4;d.c.add(l);d.sl[k]=l;}
  d.lab=d.sl[k];d.lab.visible=true;d.sayT=3;}
function onRoad(x,z){return (x>=45.6&&x<=52.4&&z<=73.5)||(z>=66.6&&z<=73.4)||x<=-30.6;}

/* ----- missions prioritaires : une seule a la fois, mieux payee ----- */
let REV=null;
const PRI_POOL=[
 {r:'e',ids:['dpanne'],n:1,txt:'Bloque l\'ascenseur du Drive',coins:30,b:15},
 {r:'e',ids:['ecraser'],n:1,txt:'Écrase un driver sur la route',coins:35,b:30},
 {r:'e',ids:['rayon'],n:3,txt:'Remplis 3 rayons',coins:25,w:15},
 {r:'e',ids:['nettoyer'],n:2,txt:'Nettoie 2 flaques',coins:22,w:12},
 {r:'e',ids:['pointeuse'],n:1,txt:'Pointe ta pause',coins:18,b:6},
 {r:'e',ids:['cmdok'],n:1,txt:'Prépare une commande du Drive (cours dans le magasin)',coins:40,w:20,when:function(){return ELEV.t<=0&&!DF.on&&(!!CMD||ORD.n>0);}},
 {r:'e',ids:['retrait'],n:1,txt:'Sers un client au retrait du Drive',coins:35,w:15,when:function(){return BAG>0;}},
 {r:'e',ids:['dfrit'],n:1,txt:'Mets le feu à la friteuse du Drive',coins:45,b:30,when:function(){return !DF.on&&SB>=20;}},
 {r:'e',ids:['alarme'],n:1,txt:'Déclenche l\'alarme incendie',coins:70,b:45,wt:8,when:function(){return SABN>=3&&ALM.cd<=0&&ALM.t<=0;}},
 {r:'m',ids:['dext'],n:1,txt:'Éteins l\'incendie du Drive',coins:45,res:8,wt:10,when:function(){return DF.on;}},
 {r:'m',ids:['retrait'],n:1,txt:'Sers un client au retrait du Drive',coins:30,res:5,when:function(){return BAG>0;}},
 {r:'v',ids:['dext'],n:1,txt:'Éteins l\'incendie du Drive',coins:45,wt:10,when:function(){return DF.on;}},
 {r:'m',ids:['repasc'],n:1,txt:'Débloque l\'ascenseur du Drive',coins:40,res:8,wt:8,when:function(){return ELEV.t>0;}},
 {r:'m',ids:['reparer'],n:1,txt:'Fais réparer un carreau cassé',coins:35,res:6,wt:4,when:function(){return BROKEN.length>0;}},
 {r:'m',ids:['press'],n:2,txt:'Mets la pression à 2 employés',coins:30,res:6},
 {r:'m',ids:['autolav'],n:1,txt:'Passe l\'autolaveuse',coins:30,res:6},
 {r:'m',ids:['convoquer'],n:1,txt:'Convoque un employé au bureau',coins:28,res:5},
 {r:'v',ids:['fouille'],n:2,txt:'Fouille 2 employés',coins:35},
 {r:'v',ids:['fouillem'],n:1,txt:'Fouille un manager',coins:40},
 {r:'v',ids:['fouille'],n:3,txt:'Fouille 3 employés',coins:55}];
PRI_POOL.forEach(function(d){d.coins=Math.max(5,Math.round(d.coins*(d.r==='e'?.4:.55)));});
function priRole(){return SEC?'v':rank>=1?'m':'e';}
function priPick(){const r=priRole(),el=PRI_POOL.filter(function(d){return d.r===r&&(!d.when||d.when());});if(!el.length)return;
  let tot=0;el.forEach(function(d){tot+=d.wt||1;});let x=Math.random()*tot,pk=el[0];for(let i=0;i<el.length;i++){x-=el[i].wt||1;if(x<=0){pk=el[i];break;}}
  if(pk.ids[0]==='nettoyer'&&Z.parking.puds)Z.parking.puds.forEach(function(q){q.m.cool=0;});PRI={d:pk,c:0,r:r};toast('⭐ Nouvelle mission prioritaire : '+pk.txt+' (+'+pk.coins+' pièces)');}
function priHit(key){if(!PRI||PRI.d.mob||PRI.d.ids.indexOf(key)<0)return;
  if(key==='dpanne'&&!(ELEV.t>0))return;if(key==='repasc'&&ELEV.t>0)return;
  PRI.c++;if(PRI.c<PRI.d.n)return;
  const d=PRI.d;coins+=d.coins;if(d.b)addB(d.b);if(d.w)addW(d.w);if(d.res)RESULT=Math.min(100,RESULT+d.res);
  pop('⭐ Mission prioritaire accomplie ! +'+d.coins+' 🪙','good');toast('Mission prioritaire réussie : '+d.txt+'. +'+d.coins+' pièces.');PRI=null;PRT=110+Math.random()*80;}
function plotTick(dt){if(globalThis.__noplot||rank!==0||VIGI||CREATING||mode!=='zone'||cur!=='store')return;const d=dayN();if(PLOT.day===d||Math.random()>dt*.01)return;
  const mg=MGR.filter(function(m){return !m.fired&&m.zn==='store';});if(!mg.length)return;const m=mg[(Math.random()*mg.length)|0];PLOT.day=d;
  if(image>=THREAT_IMG){shameAdd({nm:PNAME,im:Math.round(image),lv:Math.max(LVL,LVM),sb:Math.round(SB),sw:Math.round(SW)});pop('🏴 '+m.name+' te met sur le mur du pire cauchemar !','bad');say(m.g,'Pas question que tu prennes ma place !');giveBlame(m.name+' veut protéger son poste : tu es son pire cauchemar',0);}
  else if(Math.random()<.3){startMeeting('npc',m);pop('📋 '+m.name+' convoque une réunion obligatoire !','bad');}
  else if(Math.random()<.6){MOOD.t=90;MOOD.k='bad';MOOD.img=image;pop('📣 '+m.name+' t\'humilie au micro : mauvaise humeur !','bad');toast('Mauvaise humeur pendant 90 s : plus aucune progression (image, bosseur, branleur). Tu gardes l\'argent.');}}
function puddleMove(m){const P_=Z.parking,L=P_.puds;if(!L)return;const me=L.find(function(q){return q.m===m;}),oth=L.find(function(q){return q.m!==m;});if(!me)return;
  for(let k=0;k<60;k++){const b=P_.bounds,x=b.x[0]+4+Math.random()*(b.x[1]-b.x[0]-8),z=b.z[0]+4+Math.random()*(b.z[1]-b.z[0]-8);
    if(hit(x,z,1.4,P_)||(oth&&Math.hypot(oth.m.x-x,oth.m.z-z)<14)||Math.hypot(m.x-x,m.z-z)<12)continue;
    m.x=x;m.z=z;m.g.position.set(x,0,z);me.s.position.set(x,.04,z);break;}
  m.cool=Math.max(m.cool,12);}
function priTick(dt){v117Tick(dt);if(Z.parking.puds)Z.parking.puds.forEach(function(q){q.s.visible=q.m.cool<=0;});authTick();meetTick(dt);cafeTick(dt);cupTick(dt);if(SAL.projGone>0){SAL.projGone-=dt;if(SAL.projGone<=0)PROJM.forEach(function(b){b.visible=true;});}EMP.forEach(function(e){empS(e);if(e.boost>0)e.boost-=dt;if(e.nog>0)e.nog-=dt;if(!e.f){if(!MX.slide&&!e.corner&&!(e.nog>0)){const g=e.boost>0?4:1;e.im=Math.min(100,e.im+dt*.04*g);e.sw=Math.min(100,e.sw+dt*.03*g);}}else e.sb=Math.min(100,e.sb+dt*.08);});
  if(MOOD.t>0){MOOD.t-=dt;if(rank===0&&MOOD.k==='bad'){if(image>MOOD.img)image=MOOD.img;else MOOD.img=image;}if(MOOD.t<=0){MOOD.t=0;toast('L\'ambiance du magasin se calme.');}}
  if(CINE)return;plotTick(dt);if(REV){REV.t-=dt;if(rank>=1||REV.t<=0){if(rank===0)toast('⏱ Mission « Reprendre ton poste » échouée : le temps est écoulé.');REV=null;}}
  if(PRI){if(PRI.r!==priRole()||(PRI.d.when&&!PRI.d.when())){PRI=null;PRT=30;}return;}
  PRT-=dt;if(PRT<=0)priPick();}

/* ----- drive : clients, incendie, alarme du magasin ----- */
function startDriveFire(){DF.on=true;DF.t=0;if(DF.mk)DF.mk.off=false;
  if(!DF.fl&&fireTex){DF.fl=[];for(let i=0;i<7;i++){const sp=new T.Sprite(new T.SpriteMaterial({map:fireTex,transparent:true,depthWrite:false,blending:T.AdditiveBlending,toneMapped:false}));sp.position.set(64.8+Math.random()*2.4,1.5,-3+(Math.random()-.5)*.8);DRV.g.add(sp);DF.fl.push(sp);}}
  if(DF.fl)DF.fl.forEach(function(f){f.visible=true;});}
function stopDriveFire(){DF.on=false;if(DF.mk)DF.mk.off=true;if(DF.fl)DF.fl.forEach(function(f){f.visible=false;});}
function startAlarm(){ALM.t=25;ALM.cd=240;PNK=0;SABN=0;AQ=0;SAKEYS=[];addB(35);pop('🚨 ALARME INCENDIE ! Les clients fuient, plus personne ne surveille !','good');toast('Tu tires l\'alarme : +35 branleur. Pendant 25 s, aucun manager ne peut te surveiller !');$('alarmFx').classList.add('on');}
function endAlarm(){$('alarmFx').classList.remove('on');SAT=Math.max(0,SAT-25);addAnger(35);
  if(rank>=1){RESULT=Math.max(0,RESULT-10);toast('Fausse alerte incendie : la directrice veut des comptes. Résultats −10.');}
  else if(Math.random()<.5)giveBlame('alarme incendie : les caméras t\'ont repéré !',10);else toast('L\'alarme s\'arrête. Personne n\'a vu qui l\'a déclenchée… cette fois.');}
function dxReset(){CMD=null;BAG=0;PNK=0;SABN=0;AQ=0;SAKEYS=[];ALM.t=0;ALM.cd=0;PKT=10;stopDriveFire();$('alarmFx').classList.remove('on');SLOTS.forEach(function(sl){sl.st='idle';sl.c.visible=false;sl.mk.off=true;});}
function dxTick(dt){
  if(ALM.cd>0)ALM.cd-=dt;
  if(ALM.t>0){ALM.t-=dt;ALM.b-=dt;if(ALM.b<=0){ALM.b=.4;ALM.hi=!ALM.hi;beep(ALM.hi?900:640,.38,cur==='store'?.06:.025);}if(ALM.t<=0){ALM.t=0;endAlarm();}}
  PKM.forEach(function(m){m.off=!(CMD&&CMD.need.indexOf(m.nm)>=0&&!CMD.got[m.nm]);});
  PKT-=dt;if(PKT<=0){PKT=(LK.sim?8:26)+Math.random()*20;const fr=SLOTS.filter(function(x){return x.st==='idle';});if(fr.length){const sl=fr[(Math.random()*fr.length)|0];sl.st='wait';sl.t=sl.max;sl.c.visible=true;sl.mk.off=false;sl.bar.scale.x=2;}}
  SLOTS.forEach(function(sl){if(sl.st!=='wait')return;sl.t-=dt;const u=Math.max(0,sl.t/sl.max);sl.bar.scale.x=2*u;sl.bar.material.color.setHex(u>.5?0x2ecc71:u>.25?0xf4a261:0xe63946);
    if(sl.t<=0){sl.st='idle';sl.c.visible=false;sl.mk.off=true;SAT=Math.max(0,SAT-1.5);if(rank>=1)RESULT=Math.max(0,RESULT-1);if(cur==='drive')toast('Un client est reparti sans sa commande : satisfaction −1,5.');}});
  if(DF.on){DF.t+=dt;SAT=Math.max(0,SAT-dt*.35);if(DF.fl)DF.fl.forEach(function(f,i){const k=1+Math.sin(clk*9+i*1.7)*.25;f.scale.set(1.3*k,1.6*k,1);f.position.y=1.5+Math.abs(Math.sin(clk*6+i))*.5;});
    if(DF.t>=45){stopDriveFire();CMD=null;BAG=0;ORD.n=Math.min(14,ORD.n+5);SAT=Math.max(0,SAT-15);addAnger(25);if(rank>=1)RESULT=Math.max(0,RESULT-8);pop('🔥 Le Drive a brûlé : sacs perdus, commandes en retard !','bad');}}}
function drvAlive(){return DRVN.filter(function(d){return d.st!=='dead';}).length;}
function drvPlace(d){d.c.position.set(d.x,0,d.z);d.c.rotation.y=d.hd;}
function drvReset(){DRVN.forEach(function(d){d.st='idle';d.t=d.t0;d.c.visible=false;d.c.scale.set(1,1,1);d.blood.visible=false;d.crate.visible=false;});}
function drvKill(d){d.st='dead';d.t=16;d.c.visible=true;d.c.scale.set(1.3,.1,1.3);d.crate.visible=false;d.blood.position.set(d.x,.04,d.z);d.blood.visible=true;d.c.position.set(d.x,0,d.z);
  if(d.lab){d.lab.visible=false;d.lab=null;}priHit('ecraser');addB(25);addAnger(20);SAT=Math.max(0,SAT-8);
  pop('💥 Tu as écrasé '+d.nm+' ! +25 branleur','good');
  if(seenList.length){giveBlame('tu as écrasé '+d.nm+' sous les yeux de tout le monde !',10);}else toast('Personne ne t\'a vu… cette fois. Le Drive manque de bras ('+drvAlive()+' driver'+(drvAlive()>1?'s':'')+' en état).');}
function drvTick(dt){
  DRVN.forEach(function(d){
    if(d.st==='idle'){d.t-=dt;if(d.t<=0&&ELEV.t>0){d.st='wait';const sl=drvSlot(DRVN.indexOf(d));d.x=sl[0];d.z=sl[1];d.hd=Math.PI/2;d.c.visible=true;d.crate.visible=false;drvPlace(d);walkAnim(d.c,0,0);}
    else if(d.t<=0&&ELEV.t<=0){d.st='out';d.x=DRV_OUT[0][0];d.z=DRV_OUT[0][1];d.path=DRV_OUT.slice(1);d.pi=0;d.c.visible=true;d.crate.visible=false;d.hd=-Math.PI/2;}}
    else if(d.st==='out'||d.st==='back'){const done=follow(d,dt,3.1);drvPlace(d);walkAnim(d.c,d.ph,1);
      if(done){if(d.st==='out'){d.st='in';d.t=9+Math.random()*8;d.c.visible=false;}else{if(ELEV.t>0){d.st='wait';const sl=drvSlot(DRVN.indexOf(d));d.x=sl[0];d.z=sl[1];walkAnim(d.c,0,0);d.hd=Math.PI/2;drvPlace(d);}else{d.st='idle';d.t=6+Math.random()*10;d.c.visible=false;}}}}
    else if(d.st==='in'){d.t-=dt;if(d.t<=0){d.st='back';d.x=1.6;d.z=25.4;d.path=DRV_OUT.slice(0,-1).reverse();d.pi=0;d.c.visible=true;d.crate.visible=true;}}
    else if(d.st==='wait'){if(ELEV.t<=0){d.st='idle';d.t=4;d.c.visible=false;if(d.lab){d.lab.visible=false;d.lab=null;}}else drvSay(d,dt);}
    else if(d.st==='dead'){d.t-=dt;if(d.t<=0){d.st='idle';d.t=8;d.c.visible=false;d.c.scale.set(1,1,1);d.blood.visible=false;}}});
  if(CARM&&cur==='parking'&&Math.abs(CARM.v)>2.2){const c=CARM;DRVN.forEach(function(d){if(d.st!=='out'&&d.st!=='back')return;if(!onRoad(d.x,d.z))return;
    for(let t=-1.8;t<=1.8;t+=.9){if(Math.hypot(d.x-(c.x+Math.sin(c.h)*t),d.z-(c.z+Math.cos(c.h)*t))<1.3){drvKill(d);break;}}});}}
function carHit(x,z,h){const s=Math.sin(h),c=Math.cos(h);return hit(x+s*1.1,z+c*1.1,1,P)||hit(x-s*1.1,z-c*1.1,1,P)||hit(x,z,1.05,P);}
function placeCarMk(x,z,h){const b=P.bounds;
  function put(m,px,pz){m.x=clamp(px,b.x[0]+.5,b.x[1]-.5);m.z=clamp(pz,b.z[0]+.5,b.z[1]-.5);m.g.position.set(m.x,0,m.z);}
  put(MYCAR.mkC,x-Math.sin(h)*3.4,z-Math.cos(h)*3.4);put(MYCAR.mkM,x+Math.sin(h-Math.PI/2)*2.4,z+Math.cos(h-Math.PI/2)*2.4);MYCAR.lab.position.set(x,2.6,z);}
function startCar(){if(CARM||!MYCAR||cur!=='parking'||CINE)return;
  const i=P.obs.indexOf(MYCAR.ob);if(i>=0)P.obs.splice(i,1);
  CARM={x:MYCAR.g.position.x,z:MYCAR.g.position.z,h:MYCAR.g.rotation.y+Math.PI,v:0,L:(holdB||holdK)?1:0};
  pp.x=CARM.x;pp.z=CARM.z;MYCAR.mkM.off=true;MYCAR.mkC.off=true;act=null;
  toast('Moteur démarré ! Joystick pour conduire, Agir pour descendre. Les drivers ne sont écrasables que sur la route (pas sur le parking).');}
function exitCar(){if(!CARM)return;const c=CARM;CARM=null;lockRel=true;
  const h=c.h,ex=Math.abs(Math.cos(h))*2.2+Math.abs(Math.sin(h))*4.2,ed=Math.abs(Math.sin(h))*2.2+Math.abs(Math.cos(h))*4.2;
  MYCAR.ob={a:c.x-ex/2,b:c.x+ex/2,c:c.z-ed/2,d:c.z+ed/2};P.obs.push(MYCAR.ob);
  const b=P.bounds;let px=c.x,pz=c.z,ok=false;
  for(let r=2.4;r<9&&!ok;r+=.6)for(let a=0;a<12&&!ok;a++){const an=h+Math.PI/2+a*Math.PI/6,x=c.x+Math.sin(an)*r,z=c.z+Math.cos(an)*r;if(x>b.x[0]+.4&&x<b.x[1]-.4&&z>b.z[0]+.4&&z<b.z[1]-.4&&!hit(x,z,.45,P)){px=x;pz=z;ok=true;}}
  pp.x=px;pp.z=pz;placeCarMk(c.x,c.z,c.h);MYCAR.mkM.off=false;MYCAR.mkC.off=false;MYCAR.mkM.cool=.5;}
function driveStep(dt,ix,iz){const c=CARM,mv=Math.hypot(ix,iz),b=P.bounds;
  if(!(holdB||holdK))c.L=0;else if(!c.L){exitCar();return;}
  let dd=0;if(mv>.05){dd=Math.atan2(ix,iz)-c.h;dd=Math.atan2(Math.sin(dd),Math.cos(dd));const rate=(.9+Math.min(1,Math.abs(c.v)/4)*.6)*4.4*dt;const nh=c.h+clamp(dd,-rate,rate);if(carHit(c.x,c.z,c.h)||!carHit(c.x,c.z,nh))c.h=nh;}
  if(carHit(c.x,c.z,c.h)){let done=false;for(let k=0;k<16&&!done;k++){const an=k*Math.PI/8;for(let r=.12;r<=.6&&!done;r+=.12){const tx=c.x+Math.sin(an)*r,tz=c.z+Math.cos(an)*r;if(!carHit(tx,tz,c.h)){c.x=tx;c.z=tz;done=true;}}}
    if(!done){const o=c.h;for(let k=1;k<=6&&!done;k++){for(const sg of [1,-1]){if(!carHit(c.x,c.z,o+sg*k*.2)){c.h=o+sg*k*.2;done=true;break;}}}}}
  const tgt=mv>.05?9*Math.min(1,mv)*(Math.abs(dd)>1.9?.3:1):0;c.v+=clamp(tgt-c.v,-24*dt,13*dt);
  const s=Math.sin(c.h),co=Math.cos(c.h);let nx=c.x+s*c.v*dt,nz=c.z+co*c.v*dt;
  if(carHit(nx,nz,c.h)){if(!carHit(nx,c.z,c.h)){nz=c.z;c.v*=.6;}else if(!carHit(c.x,nz,c.h)){nx=c.x;c.v*=.6;}else{nx=c.x;nz=c.z;c.v=0;}}
  c.x=clamp(nx,b.x[0]+2.2,b.x[1]-2.2);c.z=clamp(nz,b.z[0]+2.2,b.z[1]-2.2);
  MYCAR.g.position.set(c.x,0,c.z);MYCAR.g.rotation.y=c.h+Math.PI;MYCAR.lab.position.set(c.x,2.6,c.z);
  pp.x=c.x;pp.z=c.z;pp.face=c.h;}
function startFire(x,z,n,dur,spread,y){for(let i=0;i<n;i++){const sp=new T.Sprite(new T.SpriteMaterial({map:fireTex,transparent:true,depthWrite:false,blending:T.AdditiveBlending,toneMapped:false}));
  sp.position.set(x+(Math.random()-.5)*spread,y||1,z+(Math.random()-.5)*spread);P.g.add(sp);FIRES.push({sp:sp,t:dur,dur:dur,ph:Math.random()*6,y:y||1});}}
function setAlibi(loss,msg){ALIBI.t=6;ALIBI.loss=loss;ALIBI.msg=msg;}
function crevePneus(c){c.flat=true;c.g.rotation.z=.07;c.g.position.y=-.12;c.wh.forEach(function(w){w.scale.x=.28;});}
function stopFire(x,z,r){for(let i=FIRES.length-1;i>=0;i--){const f=FIRES[i];if(Math.hypot(f.sp.position.x-x,f.sp.position.z-z)<r){P.g.remove(f.sp);FIRES.splice(i,1);}}}
function burnCar(c){c.charred=true;c.burn=32;c.bt=0;c.me.off=false;c.me.cool=0;c.body.material.color.setHex(0x1b1b1b);c.win.material.color.setHex(0x333333);startFire(c.x,c.z,5,32,2.2,1.1);}
function igniteStation(){const n=STN.n;STN.burn=40;STN.mk.ee.off=false;STN.mk.ee.cool=0;STN.n=0;STN.mk.al.off=true;STN.mk.es.off=true;STN.mk.al.cool=0;
  startFire(19,31.5,9+n*3,40,9,1.4);STN.pumps.forEach(function(m){m.material.color.setHex(0x1b1b1b);});}
function resetParking(){exitCar();if(typeof rentReset==='function')rentReset();if(MYCAR){MYCAR.g.position.set(14,0,38);MYCAR.g.rotation.y=0;MYCAR.ob.a=12.9;MYCAR.ob.b=15.1;MYCAR.ob.c=35.9;MYCAR.ob.d=40.1;if(MYCAR.mkM)placeCarMk(14,38,Math.PI);}CARS.forEach(function(c){c.flat=false;c.burn=0;c.g.rotation.z=0;c.g.position.y=0;c.wh.forEach(function(w){w.scale.x=1;});c.mp.off=false;c.mf.off=false;c.me.off=true;c.burn=0;});STN.mk.ee.off=true;
  FIRES.forEach(function(f){P.g.remove(f.sp);});FIRES.length=0;STN.n=0;STN.burn=0;STN.cool=0;STN.pat.forEach(function(m){m.visible=false;});STN.mk.es.off=false;STN.mk.al.off=false;
  STN.pumps.forEach(function(m){if(m.material.userData.c!==undefined)m.material.color.setHex(m.material.userData.c);});ALIBI.t=0;}

