function vhReset(){VH.list.forEach(function(w){vhHome(w);});PLT.forEach(function(p){p.hid=false;p.dl=0;p.rs=0;if(p.truck===2)p.truck=1;p.g.visible=true;p.ld=null;p.top=null;p.under=null;p.lv=0;Z.reserve.g.add(p.g);p.g.position.set(p.hx,0,p.hz);p.g.rotation.y=0;p.x=p.hx;p.z=p.hz;});RACKS.forEach(rkReset);wlReset();VH.hc=0;NPC.forEach(function(n){n.hop=0;});}
