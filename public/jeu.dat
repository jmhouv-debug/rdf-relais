let SHV=null,SHW=0,SHT=0;
function crowd(h){h=((h%24)+24)%24;const q=function(x){return x*x;};return .4+1.5*Math.exp(-q((h-11)/.9))+1.5*Math.exp(-q((h-16)/1.0));}
let RUSHW=0;
function prodApply(){PRODI.forEach(function(p){p.arr.forEach(function(a,i){const m=SHV[a[7]],vis=m.stock>=95||a[6]<m.stock/100;if(a[8]===vis)return;a[8]=vis;dm.position.set(a[0],a[1],a[2]);if(vis)dm.scale.set(a[3],a[4],a[5]);else dm.scale.set(0,0,0);dm.updateMatrix();p.im.setMatrixAt(i,dm.matrix);p.dirty=true;});if(p.dirty){p.im.instanceMatrix.needsUpdate=true;p.dirty=false;}});}
function shInit(){if(SHV)return;SHV=Z.store.markers.filter(function(m){return m.obj==='rayon';});PRODI.forEach(function(p){p.arr.forEach(function(a){a[6]=Math.random();let bi=0,bd=1e9;SHV.forEach(function(m,i){const d=(m.x-a[0])*(m.x-a[0])+(m.z-a[2])*(m.z-a[2]);if(d<bd){bd=d;bi=i;}});a[7]=bi;});});SHV.forEach(function(m){m.stock=50+Math.random()*32;m.sl=dynLabel(150,44,1.7,.5);m.sl.sp.position.set(m.x,2.6,m.z);Z.store.g.add(m.sl.sp);m.rs=0;});}
function resetShelves(){if(SHV){SHV.forEach(function(m){m.stock=50+Math.random()*32;});prodApply();}SHW=0;SHT=0;}
function shEmpty(){let n=0;if(SHV)SHV.forEach(function(m){if(m.stock<=15)n++;});return n;}
function updShelves(dt){shInit();
  const f=crowd(mins/60),want=Math.min(4,Math.max(1,Math.round(f*6)));let ci=0;
  NPC.forEach(function(c){if(c.name)return;c.off=ci>=want||c.gone>0||NK>.5;ci++;});
  if(f>1.4&&!RUSHW){RUSHW=1;if(mode==='zone'&&cur==='store')pop('🛒 Heure de pointe : les clients affluent','warn');}else if(f<1.0)RUSHW=0;
  NPC.forEach(function(c){if(c.off)return;const mv=Math.abs((c.px||0)-c.x)+Math.abs((c.pz||0)-c.z)>.002;c.px=c.x;c.pz=c.z;if(c.buy>0)c.buy-=dt;if(c.buy>0||!mv)return;
    for(let i=0;i<SHV.length;i++){const m=SHV[i];if(m.stock>8&&Math.hypot(m.x-c.x,m.z-c.z)<2.4){m.stock=Math.max(0,m.stock-(6+Math.random()*4));c.buy=12+Math.random()*6;break;}}});
  EMP.forEach(function(e){if(MEET.on||e.zn!=='store'||e.out>0||e.f)return;if(e.rs>0)e.rs-=dt;if(e.rs>0)return;
    for(let i=0;i<SHV.length;i++){const m=SHV[i];if(m.stock<70&&Math.hypot(m.x-e.x,m.z-e.z)<2.4){m.stock=Math.min(100,m.stock+14);e.rs=10;break;}}});
  const near=function(m){return mode==='zone'&&cur==='store'&&Math.hypot(m.x-pp.x,m.z-pp.z)<8;};
  let sd=false;SHV.forEach(function(m){const b=Math.round(m.stock/4);if(b!==m.bk){m.bk=b;sd=true;}});if(sd)prodApply();
  SHV.forEach(function(m){const v=Math.round(m.stock);m.off=m.stock>=85;
    m.sl.sp.visible=mode==='zone'&&cur==='store'&&(m.stock<=35||near(m));
    m.sl.draw(m.stock<=15?'Rayon VIDE':'Rayon '+v+' %',m.stock<=15?'rgba(214,40,57,.96)':m.stock<=35?'rgba(224,150,20,.96)':'rgba(18,32,54,.9)');});
  if(SHV&&frozenSh().some(function(m){return m.stock<=15;}))RESULT=Math.max(0,RESULT-dt*.05);
  const em=shEmpty();
  if(em>=3){addAngerSlow(dt*(.8+.5*(em-3)));SHW-=dt;if(SHW<=0){SHW=70;pop('🛒 Rayons vides !','bad');toast('Les rayons se vident : la directrice s\'énerve ! Remplissez-les vite.');MGR.forEach(function(m){if(!m.fired&&m.zn==='store')hitMgr(m,4);});}}
  /* camions et palettes qui traînent */
  let ling=0;BAYS.forEach(function(b){if(b.state==='docked'&&b.left>0&&b.dwell<80)ling++;});if(ling)addAngerSlow(dt*.6*ling);
  RES.pvA=RES.pv>0?(RES.pvA||0)+dt:0;if(RES.pvA>80&&RES.pv>=2)addAngerSlow(dt*(.3+.15*RES.pv));
  let tp2=0;BAYS.forEach(function(b){tp2+=b.pile;});RES.dkA=tp2>0?(RES.dkA||0)+dt:0;if(RES.dkA>70)addAngerSlow(dt*.5);}
