const SKINC=[['Très clair',0xf6d5bb],['Clair',0xf1c9a5],['Mat',0xd9a577],['Brun',0xb47a52],['Foncé',0x7d4e33],['Très foncé',0x4a2c1d]];
const TOPC=[['Selon le rôle',null],['Bleu',0x2f6fd0],['Rouge',0xd62839],['Vert',0x2a9d8f],['Jaune',0xf2c230],['Blanc',0xf1f1f4],['Noir',0x1b1b1b],['Rose',0xe86aa6],['Orange',0xe8833a]],PANTC=[['Selon le rôle',null],['Bleu marine',0x2b3a55],['Noir',0x1b1b1b],['Gris',0x6b7480],['Beige',0xc2a77f],['Jean',0x3f5f8f],['Kaki',0x5b6b3e]];
const CAPC=[['Aucune',null],['Bleue',0x2f6fd0],['Rouge',0xd62839],['Noire',0x1b1b1b],['Verte',0x2a9d8f],['Jaune',0xf2c230]];
const HSM=[['Courts','court'],['Longs','long'],['Chauve','chauve'],['Crête','crete'],['Afro','afro']],HSF=[['Court','court'],['Long','long'],['Queue de cheval','queue'],['Chignon','chignon'],['Afro','afro']];
const LK={g:'h',name:'',build:1,tall:1,hs:'court',hc:0x4a2c1a,beard:0,cap:0x2f6fd0,skin:0xf1c9a5,role:'e',sim:0,ic:'⭐',top:null,pant:null};
const ICONS=['⭐','💀','😎','🐺','🦊','🔥','👑','🤡','👽','🦈','🎃','🐸','🍕','⚡','🤖','🦄','🐙','💣'];
let ROLE='e',VIGI=false,SEC=false,STARTED=false,GM='cont',CRMSG='',autoT=0,DISCW=false;
try{const sv=JSON.parse(localStorage.getItem('edm_look')||'null');if(sv&&typeof sv==='object'){['g','name','build','tall','hs','hc','beard','cap','skin','role','sim','ic','top','pant'].forEach(function(k){if(sv[k]!==undefined)LK[k]=sv[k];});}}catch(_){}
function lookOpts(L){L=L||LK;const f=L.g==='f',bald=L.hs==='chauve',o={shirt:f?0xe86aa6:0x2f6fd0,pants:0x2b3a55,badge:1,skin:L.skin,cap:L.cap||0,crown:L.crown||L.cw?1:0,hair:bald?0:L.hc,hs:L.hs,bc:(!f&&L.beard)?L.hc:0,beard:f?0:L.beard,fem:f,bw:L.build,bh:L.tall};
  if(L.role==='m'){o.shirt=0xf1f1f4;o.trim=0x2b3a55;o.tie=0xd62839;o.badge=0;}
  if(L.role==='v'){o.shirt=0x1f2a44;o.pants=0x141a2b;o.cap=0x1f2a44;o.sec=1;o.badge=0;}
  if(L.top!=null)o.shirt=L.top;if(L.pant!=null)o.pants=L.pant;
  return o;}
function pvRebuild(){if(pvChar){const r=pvChar.rotation.y;pvScene.remove(pvChar);pvChar=makeChar(lookOpts());pvChar.rotation.y=r;}else pvChar=makeChar(lookOpts());pvScene.add(pvChar);}
function crRender(){const B0=$('crB'),st0=B0.scrollTop;crRender0();B0.scrollTop=st0;requestAnimationFrame(function(){B0.scrollTop=st0;if(window.crUpd)window.crUpd();});}
function crRender0(){const f=LK.g==='f',B=$('crB');
  const chips=function(key,arr,cur){return '<div class="chips">'+arr.map(function(a){return '<button class="chip'+(cur===a[1]?' on':'')+'" data-k="'+key+'" data-v="'+a[1]+'">'+a[0]+'</button>';}).join('')+'</div>';};
  const sws=function(key,arr,cur){return '<div class="chips">'+arr.map(function(a,i){return '<button class="sw'+(a[1]===null?' none':'')+(cur===a[1]?' on':'')+'" data-k="'+key+'" data-i="'+i+'" aria-label="'+a[0]+'" title="'+a[0]+'" style="'+(a[1]===null?'':'background:#'+a[1].toString(16).padStart(6,'0'))+'"></button>';}).join('')+'</div>';};
  B.innerHTML=''
   +'<h4>Prénom</h4><input id="crName" maxlength="12" placeholder="Ton prénom" value="'+LK.name.replace(/[<>&"]/g,'')+'" autocomplete="off">'
   +'<h4>Genre</h4>'+chips('g',[['Homme','h'],['Femme','f']],LK.g)
   +'<h4>Corpulence</h4>'+chips('build',[['Maigre',.82],['Normal',1],['Costaud',1.28]],LK.build)
   +'<h4>Taille</h4>'+chips('tall',[['Petit',.9],['Moyen',1],['Grand',1.1]],LK.tall)
   +'<h4>Cheveux</h4>'+chips('hs',f?HSF:HSM,LK.hs)
   +(LK.hs!=='chauve'?'<h4>Couleur des cheveux</h4>'+sws('hc',HAIRC,LK.hc):'')
   +(f?'':'<h4>Barbe</h4>'+chips('beard',[['Aucune',0],['Barbe',1],['Barbe longue',2],['Moustache',3]],LK.beard))
   +'<h4>Peau</h4>'+sws('skin',SKINC,LK.skin)
   +'<h4>Casquette</h4>'+sws('cap',CAPC,LK.cap)+'<h4>Haut</h4>'+sws('top',TOPC,LK.top)+'<h4>Pantalon</h4>'+sws('pant',PANTC,LK.pant)
   +'<h4>Icône au-dessus de ta tête</h4>'+chips('ic',ICONS.map(function(a){return [a,a];}),LK.ic||'⭐')+'<p class="crn">Les joueurs réels ont une icône au-dessus de leur nom ; les PNJ n\'en ont pas.</p>'
   +'<h4>Simulation</h4>'+chips('sim',[['Normale',0],['Simulation',1]],LK.sim||0)+'<p class="crn">'+'Simulation. Employé : tu démarres au magasin avec 2 objets volés dans les poches, traverse le magasin jusqu\'à ta voiture sans te faire fouiller. Manager et vigile : les employés PNJ font des bêtises (et des vols) en continu, sans risque d\'être viré.'+'</p>'
   +'<h4>Absence</h4><p class="crn">Quand tu te déconnectes, ton avatar reste au magasin comme un PNJ, avec ton nom : il fait des bêtises, peut voler ou dénoncer et se faire choper, mais le planning programmé depuis l\'ordinateur des bureaux réduit ses risques (sans planning : -1 pièce par jour réel). Tes pièces et points restent intacts. Planning actuel : '+(PLAN.length?PLAN.map(function(k){return (TASKS.find(function(t){return t[0]===k;})||[0,k])[1];}).join(', '):'aucun planning pour l\'instant')+'.</p><div class="chips"><button class="chip" data-act="disc">'+(DISCW?'Me déconnecter quand même':'Se déconnecter (avatar PNJ)')+'</button></div><p class="crn" id="crMsg">'+CRMSG+'</p>';}
$('crB').addEventListener('click',function(e){const b=e.target.closest('button');if(!b||b.disabled)return;
  if(b.dataset.act==='disc'){if(!PLAN.length&&!DISCW){DISCW=true;CRMSG='⚠️ Avant de te déconnecter : pense à programmer une tâche (ordinateur des bureaux, « Planning d\'absence »), sinon tu perds 1 pièce par jour réel d\'absence. Tu peux te déconnecter quand même.';crRender();return;}DISCW=false;const nm0=($('crName')||{value:LK.name}).value.trim().slice(0,12);{let okL=0;try{okL=(Date.now()-(+localStorage.getItem(CK('edm_leave'))||0))>72*3600000?1:0;if(okL)localStorage.setItem(CK('edm_leave'),String(Date.now()));}catch(_){}GH={t:Date.now(),plan:PLAN.slice(),name:nm0||'Alex',leave:okL};try{localStorage.setItem(CK('edm_ghost'),JSON.stringify(GH));}catch(_){}CRMSG=(okL?'🏖️ Congé de 24 h posé : tu peux t\'absenter 48 h sans perdre de points. ':'Pas de congé disponible (1 tous les 3 jours) : au-delà de 24 h d\'absence, tes points retombent au début de ton niveau. ')+(PLAN.length?'Ton avatar reste au magasin comme un PNJ, avec ton nom.':'Ton avatar reste au magasin comme un PNJ, mais sans planning : −1 pièce par jour d\'absence.');}const m2=$('crMsg');if(m2)m2.textContent=CRMSG;return;}
  DISCW=false;const k=b.dataset.k;if(!k)return;
  if(k==='gm'){GM=b.dataset.v;crRender();return;}
  if(b.classList.contains('sw')){const arr=k==='hc'?HAIRC:k==='skin'?SKINC:k==='top'?TOPC:k==='pant'?PANTC:CAPC;LK[k]=arr[+b.dataset.i][1];}
  else{let v=b.dataset.v;if(k!=='g'&&k!=='hs'&&k!=='role'&&k!=='gm'&&k!=='ic')v=+v;LK[k]=v;if(k==='g'){if(v==='f'){LK.beard=0;if(LK.hs==='crete')LK.hs='court';}else if(LK.hs==='queue'||LK.hs==='chignon')LK.hs='court';}}
  const nm=$('crName');if(nm)LK.name=nm.value;crRender();pvRebuild();});
(function(){const B=$('crB'),up=$('crUp'),dn=$('crDn'),sb=$('crSb').firstElementChild;
  function upd(){const mx=B.scrollHeight-B.clientHeight,t=B.scrollTop;up.hidden=t<8;dn.hidden=mx<=0||t>=mx-8;$('crSb').style.display=mx>0?'block':'none';if(mx>0){const h=Math.max(.15,B.clientHeight/B.scrollHeight);sb.style.height=(h*100)+'%';sb.style.top=((1-h)*(t/mx)*100)+'%';}}
  let raf=0,dir=0;function loop(){if(!dir)return;B.scrollTop+=dir*9;upd();raf=requestAnimationFrame(loop);}
  function go(d){return function(e){e.preventDefault();e.stopPropagation();dir=d;cancelAnimationFrame(raf);B.scrollTop+=d*40;loop();};}
  function stop(){dir=0;cancelAnimationFrame(raf);upd();}
  up.addEventListener('pointerdown',go(-1));dn.addEventListener('pointerdown',go(1));
  ['pointerup','pointercancel','pointerleave'].forEach(function(n){up.addEventListener(n,stop);dn.addEventListener(n,stop);});
  B.addEventListener('scroll',upd);addEventListener('resize',upd);window.crUpd=upd;upd();})();
$('creator').addEventListener('wheel',function(e){const B=$('crB');B.scrollTop+=e.deltaY;e.preventDefault();},{passive:false});
$('creator').addEventListener('pointerdown',function(e){e.stopPropagation();});
(function(){const B=$('crB');let y0=null,s0=0,mv=false;B.addEventListener('pointerdown',function(e){if(e.pointerType==='mouse')return;y0=e.clientY;s0=B.scrollTop;mv=false;});
 B.addEventListener('pointermove',function(e){if(y0===null)return;const dy=e.clientY-y0;if(Math.abs(dy)>6)mv=true;if(mv)B.scrollTop=s0-dy;});
 const end=function(){y0=null;};B.addEventListener('pointerup',end);B.addEventListener('pointercancel',end);
 B.addEventListener('click',function(e){if(mv){mv=false;e.stopPropagation();e.preventDefault();}},true);})();
$('crB').addEventListener('input',function(e){if(e.target.id==='crName')LK.name=e.target.value;});
$('crRnd').addEventListener('click',function(){const pk=function(a){return a[(Math.random()*a.length)|0];};LK.g=Math.random()<.5?'h':'f';LK.build=pk([.82,1,1.28]);LK.tall=pk([.9,1,1.1]);LK.hs=pk((LK.g==='f'?HSF:HSM).map(function(a){return a[1];}));LK.hc=pk(HAIRC)[1];LK.beard=LK.g==='h'?pk([0,1,2,3]):0;LK.skin=pk(SKINC)[1];LK.cap=pk(CAPC)[1];crRender();pvRebuild();});
const SEASON={n:1};
const RRD={e:['👷','EMPLOYÉ','Tu piéges les managers, tu glandes malin et tu montes de niveau pour débloquer des objets. Ne te fais pas attraper !','#4fc3f7','🎯 <b>Objectif :</b> deviens manager, puis reste-y le plus longtemps possible pour être élu <b>Employé de la semaine</b>.'],m:['👔','MANAGER','Tu mets la pression aux employés, tu gères la réputation du magasin et tu accèdes au bureau de la directrice.','#f5b82e','🎯 <b>Objectif :</b> garde ton poste le plus longtemps possible et maintiens ta réputation : le meilleur manager de la semaine est élu <b>Employé de la semaine</b>.'],v:['🛡️','VIGILE','Employé de sécurité : rondes, fouilles, arrestations de voleurs. Tu restes un employé : tu peux monter en niveau et devenir manager.','#3b82f6','🎯 <b>Objectif :</b> gagne la confiance de la direction pour être promu manager, puis reste-y le plus longtemps possible : <b>Employé de la semaine</b> à la clé.']};
let RRT=[];
function roleReveal(fresh,cb,force){
  if(!force&&(globalThis.__notuto||globalThis.__norole)){cb();return;}
  const r=RRD[LK.role]?LK.role:'e',ov=$('roleRv'),keys=['e','m','v'];RRT.forEach(clearTimeout);RRT=[];
  const show=function(k,land){const d=RRD[k];$('rrIc').textContent=d[0];$('rrNm').textContent=d[1];$('rrNm').style.color=d[3];$('rrIc').className='rric'+(land?' land':'');};
  const fin=function(){show(r,true);$('rrK').textContent=fresh?'TON RÔLE':'TU REPRENDS TON POSTE';$('rrDs').textContent=RRD[r][2];$('rrGl').innerHTML=RRD[r][4];$('roleGo').hidden=false;try{beep(660,.12,.06);}catch(_){}};
  ov.hidden=false;uiOpen=true;$('roleGo').hidden=true;$('rrDs').textContent='';$('rrGl').innerHTML='';$('rrSe').textContent='SAISON '+SEASON.n+' · EMPLOYÉ DE LA SEMAINE';
  $('roleGo').onclick=function(){RRT.forEach(clearTimeout);RRT=[];ov.hidden=true;uiOpen=false;cb();};
  if(!fresh){fin();return;}
  $('rrK').textContent='TIRAGE AU SORT…';show('e',false);
  let t=0;for(let k=0;k<18;k++){t+=70+k*k*1.1;(function(k,t){RRT.push(setTimeout(function(){if(k===17)fin();else{show(keys[k%3],false);try{beep(300+k*25,.04,.03);}catch(_){}}},t));})(k,t);}
}
function launch(){const nm=(LK.name||'').trim().slice(0,12);
  const first=!STARTED,fresh=DRAWN;DRAWN=null;applyLook(lookOpts(),nm||'Alex');let msg='Bienvenue '+PNAME+' ! Touche une zone pour entrer.';
  if(first){{const lv=readJ(CK('edm_lv'))||{},v0=readJ(CK('edm_save'))||{};if(lv.t&&lv.t.e&&lv.t.m){LT.e=lv.t.e;LT.m=lv.t.m;}else{const sp=function(L){L=L||1;return {b:1+Math.ceil((L-1)/2),w:1+Math.floor((L-1)/2)};};LT.e=sp(lv.e||v0.LV);LT.m=sp(lv.m||v0.LM);}lvSync();}
    if(SVOK()&&GM==='cont'){const v=readJ(SVK());SB=v.SB||0;SW=v.SW||0;{const TL=(rank>=1?LT.m:LT.e);if(!(rank>=1)&&!SEC){SB+=SW;SW=0;LT.e.w=1;}SB=Math.max(SB,lvBase(TL.b));SW=Math.max(SW,lvBase(TL.w));}coins=v.coins;lives=v.lives||3;blames=(v.pd&&v.pd!==parisDay())?0:Math.min(2,v.blames||0);GRADE=v.GR||0;VGXP=v.GX||0;image=v.image||20;mins=v.mins||mins;if(v.INV)Object.keys(v.INV).forEach(function(k){if(typeof v.INV[k]==='number')INV[k]=v.INV[k];});renderQI();msg='Partie reprise.';}
    const gg=ghostReport();if(gg){const sb0=SB;if(gg.loss>0)coins=Math.max(0,coins-gg.loss);if(gg.caught)blames=Math.min(2,blames+1);msg='Pendant ton absence ('+gg.mins+' min), ton avatar PNJ '+gg.events.slice(0,3).join(', ')+'.'+(gg.caught?' Il s\'est fait choper ('+gg.caught+') : +1 blâme.':'')+(gg.loss>0?' Sans planning : -'+gg.loss+' pièce'+(gg.loss>1?'s':'')+'.':'')+' '+(sb0>SB?'Absent trop longtemps : tes points retombent au début de ton niveau (−'+(sb0-SB)+').':'Tes points n\'ont pas bougé.');}
    GH=null;try{localStorage.removeItem(CK('edm_ghost'));}catch(_){}STARTED=true;}
  if(first||LK.role!==ROLE){startRole(LK.role);if(LK.sim&&LK.role!=='e'){EMP.forEach(function(e){e.nf=1+Math.random()*8;});if(mode==='map')enter('store');msg='Simulation : les employés du magasin font des bêtises. Mets-toi derrière un fautif pour le presser.';}}else if(rank===1&&!VIGI&&ROLE==='e'){TIE=box(pl.userData.m,.12,.46,.03,0xd62839,0,1.02,.22,false);}
  if(LK.sim){if(REALC===null)REALC=coins;coins=9999;}else if(REALC!==null){coins=REALC;REALC=null;}
  if(LK.sim&&LK.role==='e'&&LOOT.length<2){LOOT.length=0;LOOT.push({n:'Téléphone',v:12},{n:'Écouteurs',v:5});if(mode==='map')enter('store');msg='Simulation voleur : 2 objets volés sur toi, rejoins ta voiture au parking !';}
  CREATING=false;pvCam.clearViewOffset();$('creator').hidden=true;$('crTitle').hidden=true;$('acc').hidden=true;document.body.dataset.mode=mode;toast(msg);if(first){roleReveal(!!fresh,function(){if(tutoOff())startCine();else showTuto(null,startCine);});}if(LK.online)netStart();}
$('crGo').addEventListener('click',function(){const nm=($('crName')||{value:LK.name}).value.trim().slice(0,12);LK.name=nm;
  if(ACC&&ACCD[ACC.id]){ACCD[ACC.id].ch[CUR_CH]=lkSnap();accSave();}
  $('creator').hidden=true;$('crTitle').hidden=true;accShow('list',nm?'Perso « '+nm+' » enregistré.':'Perso enregistré.');});
$('crBack').addEventListener('click',function(){$('creator').hidden=true;$('crTitle').hidden=true;accShow('list','');});
function questRows(){const R=[];
  if(PRI)R.push({t:'⭐ Principale : '+PRI.d.txt+(PRI.d.n>1?' ('+PRI.c+'/'+PRI.d.n+')':''),ab:null});
  if(rank===0&&!SEC){try{const st=cfSt();if(st.ms.length&&!cfEmpty())R.push({t:'📋 Comptable : '+(st.bribed?(st.key?'ouvre le coffre':'prends la clé au bureau'):cfDone(st)?'soudoie-la':st.ms.map(function(m){return m.t+' '+m.p+'/'+m.n;}).join(' • ')),ab:function(){const q=cfSt();q.ms=[];q.bribed=0;q.key=0;toast('Quête de la comptable abandonnée.');}});}catch(e){}}
  if(CMD)R.push({t:'📦 Drive : '+CMD.need.map(function(n){return CMD.got[n]?'✅ '+n:n;}).join(' • '),ab:function(){CMD=null;toast('Commande Drive abandonnée.');}});
  if(rank===0&&AQ&&ALM.t<=0)R.push({t:'🔔 Alarme incendie : sabotages '+SABN+'/3',ab:function(){SABN=0;PNK=0;AQ=0;SAKEYS=[];toast('Sabotages abandonnés.');}});
  if(WH&&WH.t>0&&rank===0)R.push({t:'📣 Sifflet de '+WH.by+' : '+Math.ceil(WH.t)+' s (abandonner = blâme)',ab:function(){WH=null;giveBlame('mission du manager abandonnée',1);}});
  return R;}
let PAUSEO=false;
function closePause(){PAUSEO=false;$('pauseM').hidden=true;uiOpen=!!(MG||PAN||PHN);}
function openPause(){if(CREATING||BR)return;PAUSEO=true;uiOpen=true;$('pauseM').hidden=false;renderPause();}
function renderPause(){const J=$('pauseJ'),B=$('pauseB');J.innerHTML='';B.innerHTML='';
  const h=document.createElement('div');h.style.cssText='color:#dbe7f7;font-weight:600;font-size:13px';h.textContent='Journal des quêtes';J.appendChild(h);
  const R=questRows();if(!R.length){const e=document.createElement('div');e.style.cssText='color:#9fb0c8;font-size:13px';e.textContent='Aucune quête en cours.';J.appendChild(e);}
  R.forEach(function(r){const d=document.createElement('div');d.style.cssText='display:flex;gap:8px;align-items:center;justify-content:space-between;color:#dbe7f7;font-size:13px;line-height:1.3';const sp=document.createElement('span');sp.textContent=r.t;d.appendChild(sp);
    if(r.ab){const b=document.createElement('button');b.className='abtn';b.textContent='Abandonner';b.onclick=function(){r.ab();renderPause();};d.appendChild(b);}J.appendChild(d);});
  [['Reprendre',closePause],['🏖️ '+cgLabel(),function(){cgPose();renderPause();}],['🌙 Obscurité : '+dkLabel(),function(){DSET=DSET>=1?.7:DSET>=.7?.5:1;try{localStorage.setItem('edm_dk',String(DSET));}catch(_){}renderPause();}],['🌙 Ambiance : '+nightLabel(),function(){NMODE=NMODE==='auto'?'night':NMODE==='night'?'day':'auto';try{localStorage.setItem('edm_nm',NMODE);}catch(_){}NKA=-1;renderPause();}],['Menu principal',function(){closePause();openMenu();}],['Quitter',function(){closePause();openMenu();toast('Partie sauvegardée. Tu peux fermer la page : à bientôt !');}]].forEach(function(a){const b=document.createElement('button');b.className='abtn';b.textContent=a[0];b.onclick=a[1];B.appendChild(b);});}
function openMenu(){if(CREATING)return;if(mode==='zone')toMap(true);saveGame();CREATING=true;document.body.dataset.mode='create';accShow('game','');}
$('bMenu').addEventListener('click',openPause);
let pvLast=0;
