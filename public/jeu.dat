  const dx=s[0]-G.x,dz=s[1]-G.z,d=Math.hypot(dx,dz);if(d>5){G.x=s[0];G.z=s[1];}else{const kk=Math.min(1,dt*10);G.x+=dx*kk;G.z+=dz*kk;}
  G.h=angLerp(G.h,s[2],1-Math.exp(-dt*8));const mv=d>.03;if(mv)G.ph+=dt*8;walkAnim(G.g,G.ph,mv?1:0);G.wait=0;G.path=null;return true;}
function dirMirror(dt){
  if(!netNpcLive())return false;const s=NETNPC.d;if(!s)return false;
  if(D.rage>0||D.inv||D.ov||D.stun>0||CONV||DEN)return false;
  if(D.zn!==s[3]){setDZone(s[3]);D.x=s[0];D.z=s[1];}
  const dx=s[0]-D.x,dz=s[1]-D.z,d=Math.hypot(dx,dz);if(d>6){D.x=s[0];D.z=s[1];}else{const kk=Math.min(1,dt*10);D.x+=dx*kk;D.z+=dz*kk;}
  D.th=s[2];D.path=null;D.wait=d>.03?0:1;
