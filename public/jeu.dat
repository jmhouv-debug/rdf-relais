  /* petrins (2) + table de faconnage */
  [-45,-42].forEach(function(x){box(g,1.3,.9,1.3,0x9aa3ad,x,.45,2.4,true);cyl(g,.55,.5,.5,0xcfd6de,x,1.15,2.4,true);obs(B,x,2.4,1.5,1.5);});
  box(g,5,.9,1.4,0xd8b98a,-38.5,.45,4.2,true);obs(B,-38.5,4.2,5.2,1.6);for(let i=0;i<6;i++)box(g,.9,.18,.28,0xd9a05b,-40.5+i*.8,1,4.2,false);
  /* chambre froide + congelateur */
  box(g,4,2.6,.2,0xdfeaf2,-45.5,1.3,6.6,true);box(g,.2,2.6,3.6,0xdfeaf2,-43.5,1.3,8.4,true);obs(B,-45.5,6.6,4,.3);obs(B,-43.5,8.4,.3,3.6);
  {const fl=new T.Mesh(new T.PlaneGeometry(3.8,3.6),new T.MeshLambertMaterial({color:0xbfe3f2}));fl.rotation.x=-Math.PI/2;fl.position.set(-45.6,.018,8.4);g.add(fl);}
  box(g,1.6,.9,1.2,0xf4f4f4,-46.4,.45,9.4,true);obs(B,-46.4,9.4,1.7,1.3);
  {const cl=label('Chambre froide · congélo',{sx:3.2,sy:.5,w:340,h:64,size:26,depth:true});cl.position.set(-45.5,3.1,6.6);g.add(cl);}
  /* comptoir baguettes cote magasin (mur est) */
  box(g,1,1.1,8,0xc8a36b,-33.1,.55,5.2,true);obs(B,-33.1,5.2,1.2,8.2);for(let i=0;i<10;i++)box(g,.3,.16,.7,[0xd9a05b,0xc58a43,0xe6b877][i%3],-33.1,1.2,1.6+i*.75,false);
