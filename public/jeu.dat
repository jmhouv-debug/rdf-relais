const RENT=[];
/* ----- v203 : coffre de la compta (missions de Virginie, pot-de-vin, cle chez la directrice, ouverture longue) ----- */
let CFKEYM=null;
const CFP=[{k:'compclass',n:2,t:'Classer 2 factures fournisseurs'},{k:'compgom',n:2,t:'Remplir 2 dossiers de la direction'},{k:'loccontrat',n:2,t:'Faire signer 2 contrats à l\'agence de location'},{k:'lockeys',n:2,t:'Ranger 2 fois les clés de l\'agence (inventaire)'},{k:'signer',n:1,t:'Faire signer un bon de livraison à la réserve'},{k:'inventaire',n:1,t:'Faire l\'inventaire du frais pour la compta'},{k:'elecpromo',n:2,t:'Mettre à jour 2 étiquettes de prix (électro)'},{k:'wcplan',n:1,t:'Remplir le planning de nettoyage des toilettes'}];
const CFM={},CFAL={t:0,gc:null,tour:null},CFR={k:'',st:null},CFBR=40,CFLOOT=160;
function cfDay(){const g=pariz();return g?g.year+'-'+g.month+'-'+g.day:new Date().toISOString().slice(0,10);}
function cfSt(){const key=CK('edm_cf'),d=cfDay();if(CFR.k!==key||!CFR.st){CFR.k=key;const v=readJ(key);CFR.st=(v&&v.d===d&&Array.isArray(v.ms))?v:null;}
  if(!CFR.st||CFR.st.d!==d)CFR.st={d:d,ms:[],bribed:0,key:0,e:0};return CFR.st;}
function cfSave(){try{localStorage.setItem(CFR.k,JSON.stringify(CFR.st));}catch(_){}}
function cfCd(){const st=cfSt();return st.e?st.d:'';}
function cfEmpty(){const st=cfSt();if(st.e)return true;try{if(NET.on)return Object.keys(NET.players).some(function(pid){return pid!==NET.pid&&NET.players[pid]&&NET.players[pid].cd===st.d;});}catch(_){}return false;}
function cfDone(st){return st.ms.length===3&&st.ms.every(function(m){return m.p>=m.n;});}
function cfHit(k){if(rank>=1||SEC)return;const st=cfSt();if(!st.ms.length||st.bribed)return;let ch=0;st.ms.forEach(function(m){if(m.k===k&&m.p<m.n){m.p++;ch=1;if(m.p>=m.n)toast('✅ Mission de Virginie faite : '+m.t+(cfDone(st)?'. Retourne la voir !':''));}});if(ch)cfSave();}
function activeQuest(){if(rank!==0||SEC)return null;if(AQ&&ALM.t<=0)return 'alarme';try{const st=cfSt();if(st.ms.length&&!cfEmpty())return 'compta';}catch(e){}if(CMD)return 'drive';return null;}
function cfCan(inf,o){const k=inf.key;if(k!=='compmiss'&&k!=='compbrib'&&k!=='compkey'&&k!=='compcoffre')return true;
  const no=function(t){toast(t);if(o)o.cool=2;return false;};
  if(rank>=1||SEC)return no('Virginie ne traite qu\'avec les employés.');
  const st=cfSt();if(cfEmpty())return no('Le coffre-fort est déjà vidé aujourd\'hui : reviens demain.');
  if(k==='compmiss'){if(!st.ms.length&&(activeQuest()==='drive'||activeQuest()==='alarme'))return no('Termine d\'abord ta quête en cours : '+(activeQuest()==='alarme'?'l\'alarme incendie':'la commande Drive')+' (ou abandonne-la dans le menu ≡).');if(LVL<2&&!st.ms.length)return no('Virginie ne confie rien aux débutants : reviens quand tu seras niveau 2.');return true;}
  if(k==='compbrib'){if(st.bribed)return no('Virginie est déjà dans ta poche pour aujourd\'hui.');if(!st.ms.length)return no('Virginie ne te connaît pas : parle-lui d\'abord, elle a des petits services à te demander.');if(!cfDone(st))return no('Virginie veut d\'abord que tu finisses ses services ('+st.ms.filter(function(m){return m.p>=m.n;}).length+'/3).');
    if(LVL<2)return no('Virginie ne traite pas avec les débutants : il faut être au moins niveau 2 (tu es niveau '+LVL+').');if(coins<CFBR)return no('Il te faut '+CFBR+' pièces pour la soudoyer.');return true;}
  if(k==='compkey'){if(!st.bribed)return no('Soudoie d\'abord Virginie.');if(st.key)return no('Tu as déjà la clé du coffre.');return true;}
  if(!st.bribed)return no('Le coffre est blindé. Virginie doit d\'abord être soudoyée.');if(!st.key)return no('Il te faut la clé du coffre, rangée dans le bureau de la directrice.');return true;}
function cfFinish(o,m){const st=cfSt();
  if(o==='compmiss'){if(!st.ms.length){const pool=CFP.slice(),pick=[];for(let i=0;i<3;i++)pick.push(pool.splice((Math.random()*pool.length)|0,1)[0]);st.ms=pick.map(function(x){return {k:x.k,n:x.n,t:x.t,p:0};});cfSave();say(Z.compta.chara,'Rends-moi trois services…');toast('📋 Virginie : « '+st.ms.map(function(x){return x.t;}).join(' · ')+' ». Reviens me voir après.');}
    else if(!cfDone(st))toast('📋 Virginie : « Alors ? '+st.ms.map(function(x){return x.t+' ('+x.p+'/'+x.n+')';}).join(' · ')+' »');
    else if(!st.bribed)toast('Virginie : « Beau travail. Maintenant, parlons argent… » Soudoie-la (40 pièces, cercle à droite).');
    else if(!st.key)toast('Virginie : « La clé du coffre ? Dans le bureau de la directrice. La porte est ouverte… pour l\'instant. »');
    else toast('Virginie : « Qu\'est-ce que tu fais encore là ? Le coffre est derrière toi ! »');m.cool=3;return;}
  if(o==='compbrib'){coins-=CFBR;st.bribed=1;cfSave();addB(12);m.cool=5;pop('🤫 Virginie est soudoyée : −'+CFBR+' 🪙','good');say(Z.compta.chara,'Je n\'ai rien vu, rien entendu…');toast('Virginie t\'ouvre la porte du bureau de la directrice : va y chercher la clé du coffre (discrètement !). +12 branleur');return;}
  if(o==='compkey'){st.key=1;cfSave();addB(10);m.cool=5;pop('🗝️ Clé du coffre en poche !','good');toast('Clé du coffre récupérée. Retourne à la compta forcer le coffre-fort : ouverture très longue, un vigile peut passer. +10 branleur');return;}
  coins+=CFLOOT;st.e=1;cfSave();addB(60);m.cool=999;pop('💰 Coffre-fort vidé : +'+CFLOOT+' 🪙','good');toast('Le coffre-fort de la compta est vidé : +'+CFLOOT+' pièces (tu en avais mis '+CFBR+'), +60 branleur. Il se remplira demain.');cfAlarm();}
function cfAlarm(){CFAL.t=150;try{pop('🚨 ALARME DU COFFRE ! Les vigiles accourent','bad');beep(880,.3,.08);}catch(_){}if(CFAL.gc){CFAL.gc.tour=CFAL.tour;CFAL.gc.ti=0;if(!CFAL.sp0)CFAL.sp0=CFAL.gc.spd;CFAL.gc.spd=CFAL.sp0+.9;}}
function cfVault(){if(COFOPEN)return true;if(rank>=1||SEC)return false;const st=cfSt();return !!(st.key&&!cfEmpty());}
function cfBust(who){if(PIMM>0||rank>=1||SEC)return false;const st=cfSt();st.bribed=0;st.key=0;st.ms=[];cfSave();blames=3;FIREW=null;try{say(Z.compta.chara,'C\'est lui, j\'ai tout vu !');}catch(_){}pop('🚨 Pris en train de forcer le coffre !','bad');doFire(null);toast('Pris sur le fait par '+who+' : 3 blâmes d\'un coup, tu es viré ! Le pot-de-vin est perdu et Virginie ne te fera plus confiance aujourd\'hui.');return true;}
function cfTick(dt){const gone=rank>=1||SEC||cfEmpty(),st=cfSt();
  if(CFM.miss){CFM.miss.off=gone||st.ms.length>0;CFM.brib.off=gone||!(cfDone(st)&&!st.bribed);CFM.key.off=gone||!(st.bribed&&!st.key);CFM.safe.off=gone||!st.key;}
  if(CFAL.t>0){CFAL.t-=(dt||.016);if(CFAL.t<=0&&CFAL.gc){CFAL.gc.tour=CFAL.norm;CFAL.gc.ti=0;if(CFAL.sp0)CFAL.gc.spd=CFAL.sp0;}}
  if(!CFKEYM||rank>=1||SEC||CANDON||typeof dirDoor==='undefined'||!dirDoor)return;const want=!!(st.bribed&&!st.key&&!cfEmpty()),open=O.obs.indexOf(doorObs)<0;
  if(want&&!open){const i=O.obs.indexOf(doorObs);if(i<0)return;O.obs.splice(i,1);dirDoor.visible=false;}
  else if(!want&&open){const inside=cur==='office'&&pp.x>29.2&&pp.x<38&&pp.z<-34;if(inside)return;O.obs.push(doorObs);dirDoor.visible=true;}}
function rentReset(){RENT.forEach(function(c){c.charred=false;c.flat=false;c.burn=0;c.g.rotation.z=0;c.g.position.y=0;c.body.material.color.setHex(c.col);if(c.win&&c.win.material&&c.win.material.color)c.win.material.color.setHex(c.isTruck?0x24313f:0x080b10);c.wh.forEach(function(w){w.scale.x=1;});c.sc.visible=false;c.load=0;c.crates.forEach(function(b){b.visible=false;});c.mf.off=false;c.mf.cool=0;c.mr.off=false;c.mr.cool=0;if(c.mp)c.mp.off=false;c.me.off=true;stopFire(c.x,c.z,4);});}
const REQ={dfrit:['b',20],rat:['b',5],perime:['b',5],balance:['b',10],pneu:['b',15],pcfroid:['b',25],essence:['b',30],feu:['b',35],allumer:['b',40],volerf:['b',20],panne:['b',40],signer:['w',10],inventaire:['w',15],enfourner:['w',8],glacer:['w',8],volerb:['b',10],surchauffe:['b',30],volerp:['b',15],planquer:['b',25],locrayer:['b',15],locfeu:['b',35],locpneu:['b',20],locvol:['b',20],elecdemo:['b',5],elecjeu:['b',10],elecbrch:['b',20],elecvolc:['b',12],elecvol:['b',25],compcheq:['b',30],compdoss:['b',15],compnote:['b',25],compbrib:['b',35],lockeyv:['b',25],locresa:['b',10],eleccon:['b',40],elecalm:['b',30],compcoffre:['b',55],loccaisse:['b',35]};
const SMALL={dates:[4,0,'Dates mélangées : le frais va finir à la poubelle'],retourner:[3,0,'Dates retournées, personne ne verra rien'],ouvrir:[5,5,'Porte du frigo laissée ouverte'],facing:[3,0,'Facing défait : le rayon est un champ de bataille'],prix:[5,5,'Étiquettes de prix interverties'],
  poser:[3,0,'Produits jetés par terre'],chariot:[2,0,'Chariot abandonné en travers de l\'allée'],jouets:[4,8,'Paquet de jouets éventré'],piles:[4,5,'Tu empoches des piles']};
function reqOf(m){if(rank>=1){if(VIGI&&m.obj==='butin'&&m.big)return ['b',m.req+20];return null;}if(m.obj==='butin')return m.req?['b',m.req]:null;if(SMALL[m.obj]&&SMALL[m.obj][1])return ['b',SMALL[m.obj][1]];if(m.obj==='voler')return ['b',({'Stock':15,'Vitrine':25,'Tiroir-caisse':35})[m.txt]||15];const r0=REQ[m.obj]||null;if(r0&&r0[0]==='w'&&!SEC)return null;return r0;}
function hex6(n){return '#'+('000000'+n.toString(16)).slice(-6);}
function mkNA(m){const o=m.obj;try{
  if(o==='ranger')return !BAYS.some(function(b){return b.pile>0;});
  if(o==='palvide')return !(RES.pv>0);
  if(o==='jeter')return !(RES.ct>0)||BAL.full||(BAL.broken&&rank<1);
  if(o==='prepcmd')return rank===0&&!CMD&&!(ORD.n>0)&&!DF.on&&!(ELEV.t>0);
  if(o==='retrait'){const sl=SLOTS.find(function(x){return x.mk===m;});return !sl||sl.st!=='wait';}
  if(o==='signer')return !BAYS.some(function(x){return x.state==='docked'&&x.left===0&&!x.signed;});
  if(o==='caddies')return CART.n>=CART.max;
}catch(_){}return false;}
function mkChk(m){return rank===0&&!SEC&&!!AQ&&ALM.t<=0&&SAKEYS.indexOf(m.obj)>=0;}
function mkChkAdd(){Object.keys(Z).forEach(function(k){Z[k].markers.forEach(function(m){if(m.ck||!MK[m.obj]||MK[m.obj][0]!=='sabo')return;try{m.ck=label('✔ fait',{sx:1,sy:.42,w:160,h:64,size:34,bg:'#2ee66b',fg:'#10151f',depth:false});m.ck.position.y=2.35;m.ck.visible=false;m.g.add(m.ck);}catch(_){}});});}
