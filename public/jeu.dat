const Z={};
function zone(id,name,cz,bounds,spawn){const g=new T.Group();scene.add(g);return (Z[id]={id:id,name:name,cz:cz,g:g,bounds:bounds,spawn:spawn,obs:[],markers:[]});}
function obs(zn,x,z,w,d){zn.obs.push({a:x-w/2,b:x+w/2,c:z-d/2,d:z+d/2});}
