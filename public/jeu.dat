    if(a.caught>0)a.at=null;
    const hi=d.hd|0;if(hi>=0&&QM.HS[hi]&&!a.hide){a.x=QM.HS[hi].x;a.z=QM.HS[hi].z;qmHideIn(a,QM.HS[hi]);}else if(hi<0&&a.hide)qmUnhide(a);}
  else if(ev==='a'){if(d.k==='melee')qmMelee(a);else if(d.k==='grab')qmGrab(a);else if(d.k==='use')qmUseItem(a);else if(d.k==='usec')qmUseCons(a,d.i|0);else if(d.k==='ult')qmUlt(a);else if(d.k==='pow'){if(d.p==='portal')a.ptDest=QZ.indexOf(d.z)>=0?d.z:null;qmUsePow(a,d.p);}else if(d.k==='lock')qmLock(a);else if(d.k==='jam')qmJam(a);else if(d.k==='alert')qmAlert(a);
    else if(d.k==='vote'&&QM.meet&&QM.meet.v[a.id]===undefined&&!a.out){QM.meet.v[a.id]=d.p|0;QM.meet._ch=1;}
    else if(d.k==='free'&&a.caught>0){}
    else if(d.k==='cvx'&&a.cv)qmCvOut(a,'esc');
    else if(d.k==='help')qmHelpCall(a);
    else if(d.k==='pile')qmPileGrab(a);
    else if(d.k==='trap'){const t=(QM.TR||[]).find(function(x){return x.id===d.id;});if(t)qmTrapFire(a,t);}
    else if(d.k==='boxo'){const b=QM.BX.find(function(x){return x.id===d.id;});if(b)qmBxOpen(a,b);}
    else if(d.k==='wpsw'){const w=QM.WP.find(function(x){return x.id===d.id;});if(w)qmWpTake(a,w);}}}
function qnHostTick(dt,sim){
  if(sim)QM.A.forEach(function(a){if(!a.remote)return;
    if(a.at==='pup'&&QM.key.st==='held'&&QM.key.by===a&&a.zn==='salle'&&!QM.meetUsed&&Math.hypot(a.x-QM.pup.x,a.z-QM.pup.z)<1.5){QM.pup.prog+=dt/3;QM.pup.touch=QM.clk;if(QM.pup.prog>=1){qmMeeting(a);return;}}
    if(Date.now()-(a.seen||QN.lastSnap)>9000){a.remote=0;a.pid='';qmMsg('📴 '+a.name+' a quitté la partie : un PNJ prend sa place.','warn',1);return;}
    if(a.caught>0){a.caught-=dt;if(a.caught<=0)qmRelease(a);qmPose(a,dt,false);return;}
    if(a.tx!==undefined&&!a.hide){const dx=a.tx-a.x,dz=a.tz-a.z,d=Math.hypot(dx,dz);if(d>6){a.x=a.tx;a.z=a.tz;}else{const st=Math.min(d,dt*9);if(d>.001){a.x+=dx/d*st;a.z+=dz/d*st;}}a.hd=a.th;a.ph=(a.ph||0)+(d>.05?dt*7:0);qmPose(a,dt,d>.05);}});
  QN.snapT-=dt;if(QN.snapT<=0){QN.snapT=.2;qnSnap();}}
function qnSnap(){const r1=function(v){return Math.round(v*100)/100;};
