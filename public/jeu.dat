      X.fans=sh.slice(7,10).map(function(c,n){const p=qmCellC(o,C,c[0],c[1]);const nb=[[1,0],[-1,0],[0,1],[0,-1]].filter(function(d){const a=c[0]+d[0],b=c[1]+d[1];if(a<0||b<0||a>=N||b>=N)return false;if(d[0]===1)return !M.E[c[0]][c[1]];if(d[0]===-1)return !M.E[a][b];if(d[1]===1)return !M.S[c[0]][c[1]];return !M.S[a][b];});
        let best=nb[0]||[1,0];nb.forEach(function(d){if((D[(c[0]+d[0])+','+(c[1]+d[1])]||99)<(D[(best[0]+c[0])+','+(best[1]+c[1])]||99))best=d;});
        const g=new T.Group();g.position.set(p[0],.9,p[1]);zn.g.add(g);const bl=new T.Mesh(new T.BoxGeometry(1.5,.12,.22),new T.MeshLambertMaterial({color:0x2b2f36}));g.add(bl);const bl2=bl.clone();bl2.rotation.y=Math.PI/2;g.add(bl2);
        const w=new T.Mesh(new T.PlaneGeometry(C*.9,C*.9),new T.MeshBasicMaterial({color:0x7fd3ff,transparent:true,opacity:0,depthWrite:false}));w.rotation.x=-Math.PI/2;w.position.set(p[0],.06,p[1]);zn.g.add(w);
        return {x:p[0],z:p[1],dx:best[0],dz:best[1],g:g,w:w,ph:n*1.7,r:C*.5};});}
    X.start=qmCellC(o,C,0,0);X.exit=qmCellC(o,C,N-1,N-1);
    {const ex=qmRingMesh(0x46d17a,'🚪 SORTIE',260);ex.g.position.set(X.exit[0],0,X.exit[1]);scene.remove(ex.g);zn.g.add(ex.g);}
    zn.spawn={x:X.start[0],z:X.start[1]};
    if(k==='arch'){X.npc=[];const far=[];for(let i=0;i<N;i++)for(let j=0;j<N;j++)if(i+j>=N-1)far.push([i,j]);
      for(let n=0;n<2;n++){const c=far[(rnd()*far.length)|0],p=qmCellC(o,C,c[0],c[1]);const g=makeChar({shirt:0x8e9a95,pants:0x4a4f55,hair:0xd9d9d9,skin:0xc9d6cf,hs:'court'});zn.g.add(g);
        X.npc.push({g:g,x:p[0],z:p[1],h:0,ph:0,st:'wander',stun:0,dz:0,path:null,pi:0,rp:0,gr:2+n*3,zn:'cv_arch'});}}}
  else{const W=k==='cad'?24:18,D=k==='cad'?18:12;X.W=W;X.D=D;box(zn.g,W,.1,D,k==='cad'?0x6e5d4b:0x5b6470,o[0]+W/2,-.05,o[1]+D/2);
    const wall=function(a,b,c,d){box(zn.g,b-a,2.6,d-c,0xd9d2c3,(a+b)/2,1.3,(c+d)/2);zn.obs.push({a:a,b:b,c:c,d:d});};
    wall(o[0]-.3,o[0]+W+.3,o[1]-.3,o[1]);wall(o[0]-.3,o[0]+W+.3,o[1]+D,o[1]+D+.3);wall(o[0]-.3,o[0],o[1],o[1]+D);wall(o[0]+W,o[0]+W+.3,o[1],o[1]+D);
    const furn=function(x,z,w,d,h,c){box(zn.g,w,h,d,c,o[0]+x,h/2,o[1]+z);zn.obs.push({a:o[0]+x-w/2,b:o[0]+x+w/2,c:o[1]+z-d/2,d:o[1]+z+d/2});};
    X.door=[o[0]+W/2,o[1]+D-.7];box(zn.g,1.8,2.3,.12,0x5a3d22,X.door[0],1.15,o[1]+D-.05);
