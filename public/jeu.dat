function startCine(){if(CINE)return;const h0=hinted;hinted=true;enter('parking');hinted=h0;
  MYCAR.body.material.color.setHex(LK.g==='f'?0xe86aa6:0x2f6fd0);
  CINE={t:0,h0:h0,end:false};MYCAR.g.position.set(14,0,70);pp.x=14;pp.z=70;pp.face=Math.PI;
  camPos.set(pp.x,CAMH,pp.z+CAMZ);camLook.set(pp.x,.4,pp.z-.6);document.body.dataset.mode='cine';}
const CPATH=[[16.4,38],[16.4,34],[-14,33.5],[-25,26.5],[-25,24.9]],CSP=6;let CLEN=0;for(let i=0;i<CPATH.length-1;i++)CLEN+=Math.hypot(CPATH[i+1][0]-CPATH[i][0],CPATH[i+1][1]-CPATH[i][1]);
function cinePos(d){for(let i=0;i<CPATH.length-1;i++){const a=CPATH[i],b=CPATH[i+1],L=Math.hypot(b[0]-a[0],b[1]-a[1]);if(d<=L){const u=d/L;return {x:a[0]+(b[0]-a[0])*u,z:a[1]+(b[1]-a[1])*u,f:Math.atan2(b[0]-a[0],b[1]-a[1])};}d-=L;}return {x:-25,z:24.9,f:Math.PI};}
function endCine(){if(!CINE)return;CINE=null;GR=8;MYCAR.g.position.set(14,0,38);MYCAR.g.rotation.z=0;MYCAR.g.rotation.y=0;MYCAR.lab.position.set(14,2.6,38);
  if(D.zn==='office')setDZone('store');NEEDSTAFF=false;enter('office');pp.x=22.5;pp.z=-40.4;pp.face=0;camPos.set(pp.x,CAMH,pp.z+CAMZ);camLook.set(pp.x,.4,pp.z-.6);document.body.dataset.mode='zone';$('fade').classList.remove('on');
  toast('Tu es entré par la porte du personnel, dans le bureau des managers. Ta voiture est garée sur le parking : c\'est ton coffre pour planquer ce que tu emportes…');}function cineTick(dt){const c=CINE;c.t+=dt;c.wk=false;
  if(c.t<3.4){const u=c.t/3.4,e=1-Math.pow(1-u,3),z=70+(38-70)*e;MYCAR.g.position.set(14,0,z);MYCAR.g.rotation.z=Math.sin(c.t*9)*.006*(1-u);pp.x=14;pp.z=z;pp.face=Math.PI;}
  else{MYCAR.g.position.set(14,0,38);const d=Math.max(0,c.t-3.8)*CSP,p=cinePos(Math.min(d,CLEN));pp.x=p.x;pp.z=p.z;pp.face=d>0?p.f:Math.PI*.5;if(d>0&&d<CLEN){c.wk=true;pp.ph+=CSP*dt*2.6;}}
  const tF=3.8+CLEN/CSP+.4;
  if(c.t>tF&&!c.end){c.end=true;$('fade').classList.add('on');}
  if(c.t>tF+.4)endCine();}
$('cineSkip').addEventListener('click',endCine);
$('bDrop').addEventListener('pointerdown',function(e){e.preventDefault();if(!uiOpen&&!CREATING)dropLoot();});
$('bFork').addEventListener('click',function(){const v=VH.carry;if(!v||v.k!=='fenwick'||uiOpen)return;v.fl=(v.fl+1)%3;toast(['Fourches en bas.','Fourches à mi-hauteur.','Fourches en haut.'][v.fl]);});
$('bMach').addEventListener('pointerdown',function(e){e.preventDefault();if(!uiOpen&&!CREATING){if(VH.carry)vhDrop();else machDrop();}});
$('bLet').addEventListener('pointerdown',function(e){e.preventDefault();if(!uiOpen&&!CREATING)letGo();});
/* cameras : flux en direct dans l'ordinateur */
let FMT=null,fcam=null,FBOX=[],fT=0,CAMS=null;
function allCams(){if(!CAMS){CAMS=[];[[SCAM,'Magasin'],[RCAM,'Réserve / labos'],[PCAM,'Parking']].forEach(function(a){a[0].forEach(function(c,i){CAMS.push({c:c,nm:(c.zn==='boulangerie'?'Boulangerie':c.zn==='poissonnerie'?'Poissonnerie':a[1])+' '+(i+1)});});});}return CAMS;}
function mgrFeed(dt){if(!MG||MG.step!=='mcam'||MG.cam===undefined||$('mail').hidden)return;fT-=dt;if(fT>0)return;fT=.22;
  const cv=$('mfeed');if(!cv||!cv.getContext)return;const ctx=cv.getContext('2d'),ce=allCams()[MG.cam];if(!ce)return;const c=ce.c;
  try{if(!FMT){FMT=new T.WebGLRenderTarget(320,180);FMT.texture.encoding=T.sRGBEncoding;fcam=new T.PerspectiveCamera(36,320/180,.3,220);}
    fcam.position.set(c.x,4,c.z);fcam.lookAt(c.x+Math.sin(c.h)*7,.3,c.z+Math.cos(c.h)*7);fcam.updateMatrixWorld();
    const vis={};Object.keys(Z).forEach(function(k){vis[k]=Z[k].g.visible;Z[k].g.visible=k===c.zn;});const pv=pl.visible,dv=dirc.visible;pl.visible=false;dirc.visible=D.zn===c.zn;
    renderer.setRenderTarget(FMT);renderer.render(scene,fcam);renderer.setRenderTarget(null);
    Object.keys(Z).forEach(function(k){Z[k].g.visible=vis[k];});pl.visible=pv;dirc.visible=dv;
    const buf=new Uint8Array(320*180*4);renderer.readRenderTargetPixels(FMT,0,0,320,180,buf);
    const img=ctx.createImageData(320,180);for(let y=0;y<180;y++)img.data.set(buf.subarray((179-y)*1280,(180-y)*1280),y*1280);ctx.putImageData(img,0,0);
  }catch(err){ctx.fillStyle='#10151f';ctx.fillRect(0,0,320,180);ctx.fillStyle='#8a93a3';ctx.font='14px sans-serif';ctx.fillText('Flux indisponible',100,95);}
  FBOX=[];ctx.font='600 11px sans-serif';
  try{EMP.forEach(function(e){if(e.zn!==c.zn)return;const dx=e.x-c.x,dz=e.z-c.z,d=Math.hypot(dx,dz);if(d>(c.r||11)*1.3||d<1)return;if((Math.sin(c.h)*dx+Math.cos(c.h)*dz)/d<Math.cos(.62))return;if(blocked(Z[c.zn],c.x,c.z,e.x,e.z))return;
    const v1=new T.Vector3(e.x,2.1,e.z).project(fcam),v0=new T.Vector3(e.x,.1,e.z).project(fcam),X=(v1.x+1)/2*320,Y1=(1-v1.y)/2*180,Y0=(1-v0.y)/2*180,h=Y0-Y1;if(!(h>5))return;const w=h*.6;
    ctx.lineWidth=2;ctx.strokeStyle=e.f?'#ff4d4f':'#7ee0a8';ctx.strokeRect(X-w/2,Y1,w,h);ctx.fillStyle=e.f?'#ff4d4f':'#7ee0a8';
    ctx.fillText(e.name+(e.f?(e.flag>0?' : '+FK[e.f.k][1]:' ⚠'):''),X-w/2,Y1-3);FBOX.push({e:e,x:X,y:(Y0+Y1)/2});});}catch(_){}
  ctx.fillStyle='rgba(255,60,60,.95)';ctx.font='600 11px monospace';ctx.fillText('● REC  '+ce.nm+'  '+$('clock').textContent,6,174);}
function feedClick(ev,f){const r=f.getBoundingClientRect(),x=(ev.clientX-r.left)/r.width*320,y=(ev.clientY-r.top)/r.height*180;let b=null,bd=34;FBOX.forEach(function(q){const d=Math.hypot(q.x-x,q.y-y);if(d<bd){bd=d;b=q;}});
  if(!b){toast('Touche un employé sur l\'image.');return;}const e=b.e;e.flag=45;if(e.f){e.conf=Math.max(e.conf,70);toast(e.name+' repéré : '+FK[e.f.k][1]+'. Preuve 70 %. Va l\'attraper sur place !');}else toast(e.name+' marqué suspect… mais il ne fait rien pour l\'instant.');}
function openMgrPC(){MG={step:'mh'};uiOpen=true;$('mail').hidden=false;$('mTitle').textContent=SEC?'Poste de sécurité':'Poste du manager';renderMgr();}
function authHTML(S,back){
  if(S.step==='mauth'){authTick();return '<p class="mtxt">Ton autorité est limitée chaque jour : tu ne peux pas écraser tout le monde tout le temps.</p>'
     +'<button class="mopt" data-m="pw" data-p="ca"'+(AUTH.ca<=0?' disabled':'')+'>Pire cauchemar ('+AUTH.ca+'/1)<small>Désigne l\'employé qui menace ton poste : blâme, image à 0, sa photo sur le mur du magasin</small></button>'
     +'<button class="mopt" data-m="pw" data-p="co"'+(AUTH.co<=0?' disabled':'')+'>Corvée ('+AUTH.co+'/2)<small>Un employé doit passer la serpillère, vider les frigos ou nettoyer la friteuse, sinon blâme</small></button>'
     +'<button class="mopt" data-m="pw" data-p="ho"'+(AUTH.ho<=0?' disabled':'')+'>Heures forcées ('+AUTH.ho+'/2)<small>Un employé travaille 60 s sans pouvoir glander</small></button>'
     +'<button class="mopt" data-m="pw" data-p="re"'+(AUTH.re<=0?' disabled':'')+'>Réunion obligatoire ('+AUTH.re+'/1)<small>Tous les employés sont téléportés en salle de réunion. Court = Résultats +, long = Résultats −. Les rayons ne sont plus remplis</small></button>'
     +'<button class="mopt" data-m="pw" data-p="an"'+(AUTH.an<=0?' disabled':'')+'>Annonce au micro ('+AUTH.an+'/2)<small>Humilier : mauvaise humeur, plus aucune progression 90 s • Prime : bonne humeur, bosseur ×2 pendant 90 s (8 pièces)</small></button>'+back;}
  else if(S.step==='mpick'){const pw=S.pw,L=EMP.map(function(e,i){return {i:i,e:e,r:empRec(e)};}).filter(function(o){return !(o.e.out>0);}).sort(function(a,b){return b.r.im-a.r.im;});
     return '<p class="mtxt">'+({ca:'Qui est ton pire cauchemar ? (celui qui peut te prendre ta place)',co:'Quel employé envoyer en corvée ?',ho:'Quel employé garder en heures forcées ?'}[pw])+'</p>'
     +onlineEmps().map(function(r){return '<div class="mtxt"><b>'+r.nm+'</b> (joueur) <small>'+empLine(r)+'</small></div>';}).join('')
     +L.map(function(o){return '<button class="mopt" data-m="pe" data-i="'+o.i+'">'+o.e.name+'<small>'+empLine(o.r)+'</small></button>';}).join('')+'<button class="mopt" data-m="auth">Retour</button>';}
  else if(S.step==='mchore'){return '<p class="mtxt">Quelle corvée pour '+EMP[S.ei].name+' ?</p>'+[['serp','Passer la serpillère'],['frigo','Vider les frigos'],['frit','Nettoyer la friteuse du Drive'],['cart','Ramener les caddies au parking'+(CART.n<=3?' (abri presque vide !)':'')]].map(function(a){return '<button class="mopt" data-m="ch" data-k="'+a[0]+'">'+a[1]+'</button>';}).join('')+'<button class="mopt" data-m="auth">Retour</button>';}
  else if(S.step==='mann'){return '<p class="mtxt">Annonce au micro, dans tout le magasin :</p><button class="mopt" data-m="an" data-k="hum">Humilier les employés<small>Mauvaise humeur 90 s : aucune progression (image, bosseur, branleur). Résultats +4</small></button><button class="mopt" data-m="an" data-k="prime"'+(coins<8?' disabled':'')+'>Prime publique (8 pièces)<small>Bonne humeur 90 s : bosseur ×2. Résultats +6</small></button><button class="mopt" data-m="auth">Retour</button>';}
  return '';}
function authAct(a,b,i,S,closeFn){authTick();
  if(a==='auth'){S.step='mauth';}
  else if(a==='pw'){authTick();const pw=b.dataset.p;if(AUTH[pw]<=0)return;if(pw==='re'){AUTH.re--;closeFn();startMeeting('me');return true;}if(pw==='an')S.step='mann';else S.step='mpick';S.pw=pw;}
  else if(a==='pe'){authTick();const e=EMP[i];if(!e||e.out>0)return;if(S.pw==='ca'){if(AUTH.ca<=0)return;AUTH.ca--;const r0=empRec(e);addBl(e);shameAdd(r0);RESULT=Math.min(100,RESULT+5);coins+=2;toast('🏴 '+e.name+' est ton pire cauchemar : blâme, image à 0, sa photo est sur le mur du magasin. Résultats +5.');say(e.g,'C\'est de la jalousie !');S.step='mauth';}
    else if(S.pw==='ho'){if(AUTH.ho<=0)return;AUTH.ho--;e.ot=60;e.noF=60;endFault(e);toast(e.name+' est en heures forcées pendant 60 s.');say(e.g,'Encore ?!');S.step='mauth';}
    else if(S.pw==='co'){S.step='mchore';S.ei=i;}}
  else if(a==='ch'){authTick();const e=EMP[S.ei];if(!e||AUTH.co<=0)return;AUTH.co--;e.chore={k:b.dataset.k,t:25};endFault(e);e.noF=40;toast(e.name+' part en corvée ('+({serp:'serpillère',frigo:'frigos',frit:'friteuse',cart:'caddies'}[b.dataset.k])+').');say(e.g,'Pourquoi moi…');S.step='mauth';}
  else if(a==='an'){authTick();if(AUTH.an<=0)return;const k=b.dataset.k;if(k==='prime'){if(coins<8)return;coins-=8;MOOD.t=90;MOOD.k='good';RESULT=Math.min(100,RESULT+6);toast('📣 Prime publique : bonne humeur 90 s, bosseur ×2.');}else{MOOD.t=90;MOOD.k='bad';MOOD.img=image;RESULT=Math.min(100,RESULT+4);coins+=2;toast('📣 Humiliation publique : mauvaise humeur 90 s, aucune progression pour les employés.');}AUTH.an--;S.step='mauth';}
  return false;}
function renderMgr(){const b=$('mBody'),st=MG.step;$('tskC').textContent=Math.floor(coins)+' pièces';
  const back='<button class="mopt" data-m="home">Retour</button>';
  if(st==='mh'){const un=MSG.filter(function(m){return !m.seen;}).length;
    b.innerHTML='<p class="mtxt">Résultats : <b>'+Math.round(RESULT)+' / 100</b>. À 0, la directrice te vire. Les signalements arrivent sur ton téléphone.</p>'
     +'<button class="mopt" data-m="cam"'+(CAMCD>0?' disabled':'')+'>Caméras<small>'+(CAMCD>0?'Indisponibles : encore '+Math.ceil(CAMCD)+' s':'50 s de flux en direct : Résultats + tant que tu surveilles')+'</small></button>'
     +(SEC?'':'<button class="mopt" data-m="auth">Autorité<small>Pire cauchemar, corvées, heures forcées, annonces (usage limité par jour)</small></button><button class="mopt" data-m="plan">Planning<small>'+(PLCD>0?'Prochain dans '+Math.ceil(PLCD)+' s':'Renforcer une zone : moins de fautes pendant 60 s')+'</small></button><button class="mopt" data-m="staff">Employés et blâmes<small>Voir les blâmes ; virer un employé à 3 blâmes</small></button>')
     +'<button class="mopt" data-m="shop">Fournitures<small>Jumelles, micro-espion, tampon, note de service</small></button>'
     +'<button class="mopt" data-a="close">Éteindre l\'ordinateur</button>';}
  else if(st==='mcam'){const L=allCams();b.innerHTML='<div class="chips">'+L.map(function(c,i){return '<button class="chip'+(MG.cam===i?' on':'')+'" data-m="cx" data-i="'+i+'">'+c.nm+'</button>';}).join('')+'</div>'
     +'<canvas id="mfeed" width="320" height="180" style="width:100%;margin-top:8px;border-radius:10px;background:#000;display:block;touch-action:manipulation"></canvas><p class="mtxt">Touche un employé sur l\'image pour le marquer : sa jauge de preuve monte, puis va le sanctionner sur place. Un cadre rouge = activité suspecte.</p>'+back;fT=0;}
  else if(st==='mbox'){b.innerHTML='<p class="mtxt">Messages de tes collègues (ils peuvent se tromper… ou pas).</p>'+(MSG.length?MSG.map(function(m,i){return '<button class="mopt" data-m="mm" data-i="'+i+'">'+(m.seen?'':'● ')+m.from+' : « '+m.e.name+' '+({traine:'ne fait rien',tel:'est sur son téléphone',vol:'a l\'air de piquer un produit',pause:'fait une pause sauvage'}[m.k])+' '+ZNAME[m.z]+'. »<small>'+(m.seen?'Employé marqué suspect':'Touche pour le marquer suspect')+'</small></button>';}).join(''):'<p class="mtxt">Aucun message pour l\'instant.</p>')+back;}
  else if(st==='mplan'){b.innerHTML='<p class="mtxt">Choisis une zone à renforcer : les employés y font moins de fautes pendant 60 s.</p>'+[['store','Renfort magasin'],['reserve','Renfort réserve'],['all','Réunion générale (−3 pièces)']].map(function(a){return '<button class="mopt" data-m="pz" data-z="'+a[0]+'"'+(PLCD>0?' disabled':'')+'>'+a[1]+'</button>';}).join('')+back;}
  else if(st==='mauth'||st==='mpick'||st==='mchore'||st==='mann'){b.innerHTML=authHTML(MG,back);}
  else if(st==='mstaff'){b.innerHTML='<p class="mtxt">Les blâmes se donnent sur le terrain, en prenant les employés en faute. À 3 blâmes, tu peux le virer ici (il se calme au bout de 1 min, 5 min et 10 min).</p>'+onlineEmps().map(function(r){return '<div class="mtxt"><b>'+r.nm+'</b> (joueur) <small>'+empLine(r)+(r.im>=PROMO_IMG?' ⚠ menace pour ton poste':'')+'</small></div>';}).join('')+EMP.map(function(e,i){const n=e.bl||0,dots='●'.repeat(n)+'○'.repeat(3-n),r=empRec(e);return '<button class="mopt" data-m="fire" data-i="'+i+'"'+(n<3||e.out>0?' disabled':'')+'>'+e.name+(e.out>0?' (viré)':'')+' '+dots+'<small>'+empLine(r)+(r.im>=PROMO_IMG?' ⚠ menace • ':' • ')+(n>=3?'3 blâmes : tu peux le VIRER (encore '+Math.max(0,Math.ceil(60-(e.blAge||0)))+' s)':n+' blâme'+(n>1?'s':'')+' sur 3')+'</small></button>';}).join('')+back;}
  else if(st==='mshop'){b.innerHTML='<p class="mtxt">Fournitures de service. Les objets achetés s\'utilisent depuis la barre rapide en jeu.</p>'+ITEMS.filter(function(i){return i.t==='m'&&!i.dir;}).map(function(it){return '<div class="it"><span class="ic">'+it.ic+'</span><div class="tx"><b>'+it.n+' ×'+(INV[it.id]||0)+(FLASH.id===it.id&&clk-FLASH.t<2?'<i class="plus">+1</i>':'')+'</b><small>'+it.d+'</small></div><button data-m="by" data-id="'+it.id+'"'+(coins<it.p||!itemOK(it)?' disabled':'')+'>Acheter · '+(itemOK(it)?it.p+' 🪙':lockTxt(it))+'</button></div>';}).join('')+back;}}
$('mBody').addEventListener('click',function(ev){if(!MG||typeof MG.step!=='string'||MG.step[0]!=='m')return;
  const f=ev.target.closest('#mfeed');if(f){feedClick(ev,f);return;}
  const b=ev.target.closest('[data-m]');if(!b||b.disabled)return;const a=b.dataset.m,i=+b.dataset.i;
  if(a==='home'){if(MG.step==='mcam'&&CAMT>5)CAMCD=40;MG={step:'mh'};}
  else if(a==='cam'){if(CAMCD>0)return;MG={step:'mcam',cam:0};CAMT=0;}
  else if(a==='staff'){MG={step:'mstaff'};}
  else if(['auth','pw','pe','ch','an'].indexOf(a)>=0){if(authAct(a,b,i,MG,closeMail))return;}
  else if(a==='fire'){const e=EMP[i];if(!e||(e.bl||0)<3||e.out>0)return;e.out=90;e.bl=0;e.warn=0;endFault(e);e.g.visible=false;coins+=10;RESULT=Math.min(100,RESULT+15);COMP=Math.min(100,COMP+5);addW(4);toast('Tu as viré '+e.name+' : +10 pièces, Résultats +15, réputation +5.');}
  else if(a==='cx'){MG.cam=i;}
  else if(a==='box'){MG={step:'mbox'};}
  else if(a==='mm'){const m=MSG[i];if(m){m.seen=true;m.e.flag=45;if(m.e.f)m.e.conf=Math.max(m.e.conf,40);toast(m.e.name+' est marqué suspect (45 s).');}}
  else if(a==='plan'){MG={step:'mplan'};}
  else if(a==='pz'){if(PLCD>0)return;const z=b.dataset.z;if(z==='all'){if(coins<3){toast('Il faut 3 pièces.');return;}coins-=3;}PLB={t:60,z:z};PLCD=90;RESULT=Math.min(100,RESULT+3);toast('Planning appliqué : moins de fautes pendant 60 s. Résultats +3');MG={step:'mh'};}
  else if(a==='conv'){MG={step:'mconv'};}
  else if(a==='shop'){MG={step:'mshop'};}
  else if(a==='by'){buyItem(b.dataset.id);}
  renderMail();});

