  box(f,1.2,1.5,6,0x7fb5e6,-47.1,.75,-14,true);box(f,1.1,1.3,5.8,0xbfe6f5,-47.1,.75,-14,false);obs(F,-47.1,-14,1.4,6.2);
  box(f,4,1.2,1,0xf4f4f4,-38,.6,-19.1,true);box(f,3.8,.7,.9,0xcfe3f2,-38,1.5,-19.1,false);obs(F,-38,-19.1,4.2,1.2);
