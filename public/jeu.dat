  let x,z;if(best){x=best.x;z=best.z;}else{const k=PRI.d.ids[0];if(k==='ecraser'){x=64;z=-4;}else if(k==='convoquer'){x=28;z=-34;}else{x=10;z=0;}}
  return {x:Math.round(x/12)*12+(x>=0?4:-4)*0,z:Math.round(z/12)*12};}
