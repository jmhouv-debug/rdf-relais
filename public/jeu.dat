  cyl(g,.45,.45,.06,0xffffff,-31,3.2,-42.95,false).rotation.x=Math.PI/2;box(g,.04,.3,.02,0x222222,-31,3.28,-42.9,false);
  function sofa(x,z,c){ao(g,x,z,4.2,2.2,.45);box(g,3.2,.5,1.3,c,x,.25,z,true);box(g,3.2,.8,.32,c,x,.8,z-.55,true);box(g,.3,.7,1.3,c,x-1.55,.55,z,true);box(g,.3,.7,1.3,c,x+1.55,.55,z,true);
    box(g,.8,.2,.5,0xfff3d6,x-.8,.62,z,false);obs(0,x,z,3.3,1.4);}
  sofa(-29,-28.8,0xd1495b);sofa(-22.5,-28.8,0x2f80ed);
  marker(0,'sieste',-29,-26.9,'Dormir');marker(0,'sieste',-22.5,-26.9,'Dormir');
