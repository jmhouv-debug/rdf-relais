  box(g,.4,5,19.3,W,-25.8,2.5,-53.05,true);
  /* zones infranchissables : vide au nord-ouest, route, vide a l'est de la halle */
  obs(R,-18,-62.1,16,23.9);obs(R,.75,-58.9,21.5,30.4);
  obs(R,-52,-68.2,20,10.6);
  obs(R,-52,-34.5,21.2,18.2);
  box(g,16.4,5,.4,0xc9ccd2,-34,2.5,-74.2,true);
  box(g,.3,1.2,10.8,0x7a8594,-25.8,.6,-68.1,true);box(g,.3,1.2,10.8,0x7a8594,-42.2,.6,-68.1,true);
  const es=sign('ÉPICERIE · LIQUIDES',6,1.1,'#d9822b','#ffffff');es.position.set(-62.45,3.3,-53);es.rotation.y=Math.PI/2;g.add(es);
  /* mur sud bas : ouverture vers le magasin en x=-21.4 */
