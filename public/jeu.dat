 if(prk&&!o.loot){setTimeout(function(){conneriePris(o);},1500);}else if(g&&Math.random()<.85){setTimeout(function(){if(tg.k==='e')fouilleE(o);else fouilleM(o);},1500);}else if(!g){setTimeout(function(){pop('🔎 Contrôle de '+o.name+' : rien à signaler.','warn');},1500);}else{setTimeout(function(){toast('Il t\'a filé entre les doigts…');},1500);}}
