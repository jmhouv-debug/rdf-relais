 {id:'mdiscours',n:'Discours motivant',ic:'🎤',p:14,t:'m',th:0,fx:'mdiscours',d:'Tu fais ton petit discours à l\'équipe : Résultats +4, Sérieux +6, +8 bosseur.'},
 {id:'mprime',n:'Prime d\'équipe',ic:'🎁',p:40,t:'m',th:0,fx:'mprime',d:'Tu distribues une prime : Résultats +6, Sérieux +10, +12 bosseur.'},
 {id:'mpause',n:'Sieste planquée',ic:'😴',p:10,t:'m',tr:'b',th:0,fx:'mpause',d:'Une petite sieste derrière la porte du bureau : +8 branleur, Résultats −2.'},
 {id:'mfrais',n:'Note de frais bidon',ic:'🧾',p:16,t:'m',tr:'b',th:0,fx:'mfrais',d:'Un resto « professionnel » à ton nom : +25 pièces, +10 branleur, Résultats −3.'},
 {id:'mdouble',n:'Double jeu du manager',ic:'🎭',p:60,t:'m',tr:'x',th:0,fx:'mdouble',d:'Tu fais la leçon en haut et le contraire en bas : Résultats +5, Sérieux +8, +8 bosseur, +8 branleur.'});
Object.assign(ILV,{leche:1,cafeboss:2,repos:3,gateau:4,heures:6,alibi:4,doublejeu:6,taupe:8,mdiscours:3,mprime:5,mpause:2,mfrais:4,mdouble:6});
(function(){const TRM={indiscret:'b',rumeurm:'b',sabotage:'b',rapdir:'b',poignard:'b',machin:'b',dirm:'x',revol:'x'};ITEMS.forEach(function(i){if(TRM[i.id])i.tr=TRM[i.id];});})();
ITEMS.forEach(function(i){i.lv=i.lv||ILV[i.id]||1;});
ITEMS.forEach(function(i){if(!i.fin)i.p=Math.min(260,Math.round(i.p*(i.t==='m'?2:3)*(1+.2*(i.lv-1))));});
function rivals(n){const L=EMP.filter(function(e){return !(e.out>0);});L.forEach(empS);L.sort(function(a,b){return b.im-a.im;});return L.slice(0,n);}
function imgHit(e,n){empS(e);e.im=Math.max(0,e.im-n);}
function liveMgrs(){return MGR.filter(function(m){return !m.fired;});}
const FX={
 hygiene:function(){let n=0,np=0;const det=[];JOBS.forEach(function(j){if(j.kind==='rat'){n++;det.push('rongeurs');}else if(j.kind==='perime')np++;});if(np>0){const pj=JOBS.find(function(j){return j.kind==='perime';});if(rank===0&&!SEC&&mobStart('aud',pj.x,pj.z,'store',{})){}else{n+=np;det.push('produits périmés');}}if(WCDIRT[0]||WCDIRT[1]){n++;det.push('toilettes sales');}if(WCFL>0){n+=2;det.push('toilettes inondées');}if(CW.dirt>=50){n++;det.push('toilettes clients dégueulasses');}
  if(!n&&np===0){image=Math.max(0,image-8);return '🧪 L\'inspecteur ne trouve rien : appel abusif. Sérieux −8.';}
  if(!n)return '🧪 Audit d\'hygiène lancé ! Les managers ont 60 s pour retirer les périmés, sinon ils prennent un blâme.';
  const dm=8+6*n;liveMgrs().filter(function(m){return !(m.imm>0)&&(!DIRS||DIRS.m!==m);}).forEach(function(m){hitMgr(m,dm);});RESULT=Math.max(0,RESULT-(4+3*n));addB(4+2*n);return '🧪 Inspection d\'hygiène ! Constats : '+det.join(', ')+'. Les managers perdent '+dm+' de réputation, Résultats −'+(4+3*n)+'. +'+(4+2*n)+' branleur.';},
 scotch:function(){if(!inWcRoom()){toast('Va dans les toilettes pour scotcher le « Hors service ».');return null;}const i=pp.x<64.5?0:1;if(WCS[i]>0){toast('Cette cabine est déjà scotchée.');return null;}WCS[i]=1;WCST[i]=35+Math.random()*25;setScotch(i,true);addB(3);return '🚧 Tu scotches « Hors service » sur la cabine '+(i?'FEMMES':'HOMMES')+'. Un collègue va se faire piéger… +3 branleur.';},
 carnet:function(){image=Math.min(100,image+5);addW(2);return '📒 Tu prends des notes : Sérieux +5, +2 bosseur.';},
 badge:function(){image=Math.min(100,image+10);return '🏅 Badge épinglé : Sérieux +10.';},
 cv:function(){image=Math.min(100,image+12);addW(4);return '📄 CV retouché : Sérieux +12, +4 bosseur.';},
 relax:function(){MOOD.t=0;image=Math.min(100,image+6);return '🧘 Respiration… La mauvaise humeur est partie. Sérieux +6.';},
 formation:function(){addW(20);image=Math.min(100,image+8);return '🎓 Formation express : +20 bosseur, Sérieux +8.';},
 dossier:function(){image=Math.min(100,image+20);return '💼 Dossier irréprochable : Sérieux +20.';},
 avocat:function(){if(blames<1){toast('Tu n\'as aucun blâme à annuler.');return null;}blames--;image=Math.min(100,image+10);return '⚖️ Ton avocat annule un blâme : Sérieux +10.';},
 sponsor:function(){image=Math.min(100,image+35);return '🤝 Un directeur parle de toi en bien : Sérieux +35.';},
 poudre:function(){const r=rivals(1)[0];if(!r)return null;imgHit(r,6);addB(2);say(r.g,'Ça gratte !');return '🧪 '+r.name+' se gratte partout. +2 branleur.';},
 rumeur:function(){const r=rivals(1)[0];if(!r)return null;imgHit(r,10);addB(2);return '🗣️ La rumeur court sur '+r.name+'. +2 branleur.';},
 photoc:function(){const r=rivals(1)[0];if(!r)return null;imgHit(r,15);addB(6);return '📸 Photo de '+r.name+' qui circule. +6 branleur.';},
 fauxrap:function(){const r=rivals(1)[0];if(!r)return null;imgHit(r,20);addB(12);return '📑 Un faux rapport accable '+r.name+'. +12 branleur.';},
 lettre:function(){const L=liveMgrs();if(!L.length)return null;const m=L[(Math.random()*L.length)|0];hitMgr(m,12);addB(4);return '✉️ Lettre anonyme contre '+m.name+' : −12 de réputation. +4 branleur.';},
 laxatif:function(){const R=rivals(2);if(!R.length)return null;R.forEach(function(e){imgHit(e,8);e.nog=60;say(e.g,'Aïe mon ventre…');});addB(2);return '🍫 '+R.map(function(e){return e.name;}).join(' et ')+' filent aux toilettes, de mauvaise humeur 60 s. +2 branleur.';},
 complot:function(){const L=liveMgrs();if(!L.length)return null;const m=L[(Math.random()*L.length)|0];hitMgr(m,25);addB(8);return '🕶️ Complot contre '+m.name+' : −25 de réputation. +8 branleur.';},
 bombe:function(){EMP.forEach(function(e){imgHit(e,12);});addB(6);return '💣 Rumeurs sur tout le monde. +6 branleur.';},
 raillerie:function(){const r=rivals(1)[0];if(!r)return null;imgHit(r,8);r.nog=30;say(r.g,'Oh…');RESULT=Math.min(100,RESULT+1);return '🎤 Remarque cinglante sur '+r.name+' : −8 Sérieux, il boude 30 s.';},
 bonnet:function(){let b=null,bd=9;EMP.forEach(function(e){if(e.zn!==cur||(e.out>0))return;const d=Math.hypot(e.x-pp.x,e.z-pp.z);if(d<bd){bd=d;b=e;}});if(!b){toast('Aucun employé à moins de 9 m.');return null;}imgHit(b,10);say(b.g,'Quelle honte…');return '🎓 '+b.name+' porte le bonnet d\'âne : −10 Sérieux.';},
 surcharge:function(){EMP.forEach(function(e){e.nog=45;});RESULT=Math.min(100,RESULT+2);return '📚 Surcharge de dossiers : tout le monde est de mauvaise humeur 45 s (plus de progression de Sérieux). Résultats +2.';},
 convoc:function(){const r=rivals(1)[0];if(!r)return null;imgHit(r,15);return '📣 '+r.name+' est convoqué devant tout le monde : −15 Sérieux.';},
 humeur:function(){EMP.forEach(function(e){e.nog=90;});return '😤 Ambiance exécrable : plus aucune progression de Sérieux pendant 90 s.';},
 disciplin:function(){const r=rivals(1)[0];if(!r)return null;addBl(r);say(r.g,'Un blâme ?!');return '📛 Dossier disciplinaire pour '+r.name+' : blâme, son Sérieux tombe à 0.';},
 audit:function(){EMP.forEach(function(e){imgHit(e,8);});RESULT=Math.min(100,RESULT+4);return '🔍 Audit surprise : −8 Sérieux pour chaque employé. Résultats +4.';},
 classement:function(){const R=rivals(3);R.forEach(function(e){imgHit(e,20);});return '📉 Classement truqué : '+R.map(function(e){return e.name;}).join(', ')+' perdent 20 Sérieux.';}};

/* ---------- v117 : ordres d'équipe, Employé du Mois, directeur ---------- */
const TEAM={t:0,by:'',k:''},EOM={next:200,last:''},VAC={next:480};let WH=null,PIMM=0,DIRS=null,NPCORD=150;
function lossPct(n){return n<=5?.08:(n<=10?.25:.5);}
function pimg(n){if(rank===0&&!(PIMM>0)){image=Math.max(0,image-n);if(n>0&&!SEC){const b=lvBase(LT.e.b,false),r=Math.max(0,SB-b),l=Math.floor(r*lossPct(n));if(l>0){SB-=l;toast('📉 Un coup dur : −'+l+' points de branleur.');}}}}
function otherMgr(n){const L=liveMgrs().filter(function(m){return !(m.imm>0)&&(!DIRS||DIRS.m!==m);}).sort(function(){return Math.random()-.5;});return L.slice(0,n);}
function topEmp(n){return rivals(n);}
function teamFree(){if(TEAM.t>0){pop('⏳ Un ordre d\'équipe est déjà en cours ('+Math.ceil(TEAM.t)+' s) : attends la fin.','bad');toast('👥 '+TEAM.by+' vient de lancer un ordre à toute l\'équipe ('+Math.ceil(TEAM.t)+' s) : attends la fin.');return false;}return true;}
const TEAMDUR={sifflet:60,note:25,surcharge:45,humeur:90,audit:25,rappel:20,primem:25,objectifs:25,tournee:60,budget:25,purge:25,dirm:25};
function teamApply(k,by,mine){TEAM.t=Math.max(25,TEAMDUR[k]||25);TEAM.by=by;TEAM.k=k;const pe=rank===0;
 if(k==='sifflet'){EMP.forEach(function(e){if(e.out>0)return;endFault(e);e.noF=65;e.whi=18+Math.random()*38;});if(pe){WH={t:60,n:0,by:by};pop('📣 '+by+' siffle : fais 3 tâches de bosseur en 1 minute, sinon blâme !','bad');}else if(mine)RESULT=Math.min(100,RESULT+3);}
 else if(k==='note'){NOTE=25;if(mine)RESULT=Math.min(100,RESULT+6);}
 else if(k==='surcharge'){EMP.forEach(function(e){e.nog=45;});if(pe){MOOD.t=45;MOOD.k='bad';MOOD.img=image;}if(mine)RESULT=Math.min(100,RESULT+2);}
 else if(k==='humeur'){EMP.forEach(function(e){e.nog=90;});if(pe){MOOD.t=90;MOOD.k='bad';MOOD.img=image;}}
 else if(k==='audit'){EMP.forEach(function(e){imgHit(e,8);});pimg(8);if(mine)RESULT=Math.min(100,RESULT+4);}
 else if(k==='rappel'){EMP.forEach(function(e){imgHit(e,4);});pimg(4);if(mine)RESULT=Math.min(100,RESULT+3);}
 else if(k==='primem'){EMP.forEach(function(e){empS(e);e.im=Math.min(100,e.im+5);});if(pe){image=Math.min(100,image+5);MOOD.t=40;MOOD.k='good';}if(mine)RESULT=Math.min(100,RESULT+10);}
 else if(k==='objectifs'){EMP.forEach(function(e){imgHit(e,7);});pimg(7);if(mine)RESULT=Math.min(100,RESULT+6);}
 else if(k==='tournee'){EMP.forEach(function(e){imgHit(e,10);e.nog=60;});pimg(10);if(pe){MOOD.t=60;MOOD.k='bad';MOOD.img=image;}}
 else if(k==='budget'){EMP.forEach(function(e){imgHit(e,15);});pimg(15);if(mine)RESULT=Math.min(100,RESULT+8);}
 else if(k==='purge'){topEmp(2).forEach(function(e){addBl(e);say(e.g,'Un blâme ?!');});if(pe&&Math.random()<.5)giveBlame('grande purge',0);}
 else if(k==='dirm'){if(mine)RESULT=Math.min(100,RESULT+20);otherMgr(9).forEach(function(m){hitMgr(m,14);});}
 if(mine)netEv(k,by);}
function netEv(k,by){try{if(typeof NET==='undefined'||!NET.on||!NET.joined)return;const m={t:'ev',k:k,by:by,from:NET.pid};if(NET.sb){netSbBroadcast('ev',m);return;}if(NET_URL){netWsSend(m);return;}if(NET.role==='host')Object.keys(NET.conns).forEach(function(pid){try{NET.conns[pid].send(m);}catch(_){}});else if(NET.hostConn)NET.hostConn.send(m);}catch(_){}}
function netRecvEv(m){if(!m||m.from===NET.pid||!TEAMDUR[m.k]||TEAM.t>0)return;teamApply(m.k,String(m.by||'Un manager').slice(0,20),false);toast('👥 '+String(m.by||'Un manager').slice(0,20)+' lance un ordre à toute l\'équipe.');}
function teamFx(k,msg){return function(){if(!teamFree())return null;teamApply(k,PNAME||'Manager',true);return msg;};}
function mgrHit(n,dmg,msg,extra){const L=otherMgr(n);if(!L.length){toast('Aucun autre manager à viser.');return null;}L.forEach(function(m){hitMgr(m,dmg);});if(extra)extra();return msg.replace('{n}',L.map(function(m){return m.name;}).join(' et '));}
function empHit(n,dmg,b,msg,nogT){const R=rivals(n);if(!R.length)return null;R.forEach(function(e){imgHit(e,dmg);if(nogT)e.nog=nogT;say(e.g,'Hé !');});let g=b?(dmg<=10?2:(dmg<=18?6:12)):0;if(g)addB(g);msg=msg.replace(/ ?: −\d+ Sérieux( chacun)?/,'').replace(/−\d+ Sérieux( chacun)?/,'').replace(/\+\d+ branleur/,g?'+'+g+' branleur':'');return msg.replace('{n}',R.map(function(e){return e.name;}).join(' et '));}
function gain(img,w){image=Math.min(100,image+img);if(w)addW(w);}
Object.assign(FX,{
 sifflet:teamFx('sifflet','📣 Coup de sifflet : toute l\'équipe doit faire 3 tâches de bosseur en 1 minute, sinon blâme.'),
 note:teamFx('note','📋 Note de service : plus aucune faute pendant 25 s. Résultats +6.'),
 surcharge:teamFx('surcharge','📚 Surcharge de dossiers : toute l\'équipe est de mauvaise humeur 45 s. Résultats +2.'),
 humeur:teamFx('humeur','😤 Ambiance exécrable : toute l\'équipe boude 90 s (plus de progression de Sérieux).'),
 audit:teamFx('audit','🔍 Audit surprise : tous les employés perdent 8 de Sérieux. Résultats +4.'),
 rappel:teamFx('rappel','🔔 Rappel à l\'ordre : tous les employés perdent 4 de Sérieux. Résultats +3.'),
 primem:teamFx('primem','🎁 Prime d\'équipe : Sérieux +5 pour tous, bonne humeur 40 s. Résultats +10.'),
 objectifs:teamFx('objectifs','🎯 Objectifs impossibles : tous les employés perdent 7 de Sérieux. Résultats +6.'),
 tournee:teamFx('tournee','🚶 Tournée générale : toute l\'équipe boude 60 s et perd 10 de Sérieux.'),
 budget:teamFx('budget','✂️ Coupe budgétaire : tous les employés perdent 15 de Sérieux. Résultats +8.'),
 purge:teamFx('purge','🧹 Grande purge : les 2 employés les mieux vus prennent un blâme.'),
 dirm:teamFx('dirm','☎️ Tu appelles le directeur général : Résultats +20, les autres managers perdent 14 de réputation.'),
 post:function(){gain(3);return '📝 Post-it motivation : Sérieux +3.';},
 cafeine:function(){gain(2,4);return '☕ Double expresso : +4 bosseur, Sérieux +2.';},
 stylo:function(){gain(6,2);return '✒️ Tu signes avec un beau stylo : Sérieux +6, +2 bosseur.';},
 cravate:function(){gain(10);return '👔 Cravate du lundi : Sérieux +10.';},
 tableau:function(){gain(14,6);return '🗂️ Tableau de bord impeccable : Sérieux +14, +6 bosseur.';},
 mentor:function(){gain(20,12);return '🧑‍🏫 Un mentor te défend : Sérieux +20, +12 bosseur.';},
 reseau:function(){gain(28,10);return '🤵 Ton réseau parle de toi : Sérieux +28, +10 bosseur.';},
 coupe:function(){gain(36,20);return '🏆 Coupe de la réussite : Sérieux +36, +20 bosseur.';},
 cabinet:function(){gain(45,30);return '🎯 Coaching de cadre : Sérieux +45, +30 bosseur.';},
 parrain:function(){gain(60,40);return '🤝 Un parrain à la direction : Sérieux +60, +40 bosseur.';},
 piston:function(){image=100;return '🚀 Piston ultime : ton Sérieux passe à 100 !';},
 chewing:function(){return empHit(1,4,1,'🍬 Chewing-gum sur la chaise de {n} : −4 Sérieux. +1 branleur.');},
 cafeverse:function(){return empHit(1,7,2,'🫗 Café renversé sur {n} : −7 Sérieux, il boude 20 s. +2 branleur.',20);},
 ragot:function(){return mgrHit(1,8,'🤫 Ragot sur {n} : −8 de réputation. +3 branleur.',function(){addB(3);});},
 selfie:function(){return empHit(1,12,4,'🤳 Selfie compromettant de {n} : −12 Sérieux. +4 branleur.');},
 fuite:function(){return empHit(2,14,6,'📰 Fuite de mails sur {n} : −14 Sérieux chacun. +6 branleur.');},
 pot:function(){return mgrHit(1,18,'🥂 Pot de départ piégé pour {n} : −18 de réputation. +7 branleur.',function(){addB(7);});},
 dossierc:function(){return empHit(1,26,8,'🕵️ Dossier compromettant sur {n} : −26 Sérieux. +8 branleur.');},
 greve:function(){return mgrHit(2,20,'📢 Coup monté contre {n} : −20 de réputation chacun. +10 branleur.',function(){addB(10);});},
 putsch:function(){EMP.forEach(function(e){imgHit(e,15);});addB(6);return '🔥 Putsch de l\'open space. +6 branleur.';},
 scandale:function(){return mgrHit(1,45,'🗞️ Grand scandale autour de {n} : −45 de réputation. +18 branleur.',function(){addB(18);});},
 noir:function(){const R=rivals(3);if(!R.length)return null;R.forEach(function(e){imgHit(e,30);});const L=otherMgr(1);L.forEach(function(m){hitMgr(m,30);});addB(22);return '🖤 Dossier noir : '+R.map(function(e){return e.name;}).join(', ')+(L.length?' et '+L[0].name:'')+' prennent −30. +22 branleur.';},
 regard:function(){return empHit(1,3,0,'👀 Regard noir sur {n} : −3 Sérieux, il boude 20 s.',20);},
 planning:function(){RESULT=Math.min(100,RESULT+4);return '🗓️ Planning serré : Résultats +4.';},
 indiscret:function(){return mgrHit(1,6,'📞 Coup de fil indiscret sur {n} : −6 de réputation.');},
 rumeurm:function(){return mgrHit(1,10,'🗯️ Rumeur sur {n} : −10 de réputation.');},
 sabotage:function(){return mgrHit(1,14,'🔧 Petit sabotage contre {n} : −14 de réputation.');},
 rapdir:function(){return mgrHit(1,20,'📨 Rapport à la directrice contre {n} : −20 de réputation. Résultats +3.',function(){RESULT=Math.min(100,RESULT+3);});},
 poignard:function(){return mgrHit(1,30,'🗡️ Coup de poignard à {n} : −30 de réputation.');},
 machin:function(){return mgrHit(2,22,'🎭 Machination contre {n} : −22 de réputation chacun.');},
 revol:function(){const L=otherMgr(9);if(!L.length)return null;L.forEach(function(m){hitMgr(m,26);});RESULT=Math.max(0,RESULT-5);return '🚨 Révolution de palais : '+L.map(function(m){return m.name;}).join(', ')+' perdent 26. Résultats −5.';},
 dirblame:function(){if(!DIRS||!DIRS.me)return null;if(DIRS.cd>0){toast('Le directeur doit patienter '+Math.ceil(DIRS.cd)+' s.');return null;}const r=rivals(1)[0];if(!r)return null;DIRS.cd=4;addBl(r);say(r.g,'Un blâme ?!');INV.dirblame=99;return '📛 Le directeur blâme '+r.name+' : son Sérieux tombe à 0.';},
 dirdown:function(){if(!DIRS||!DIRS.me)return null;if(DIRS.cd>0){toast('Le directeur doit patienter '+Math.ceil(DIRS.cd)+' s.');return null;}const L=otherMgr(1);if(!L.length)return null;DIRS.cd=4;hitMgr(L[0],35);INV.dirdown=99;return '👇 Le directeur rabaisse '+L[0].name+' : −35 de réputation.';},
 dirsabot:function(){if(!DIRS||!DIRS.me)return null;if(DIRS.cd>0){toast('Le directeur doit patienter '+Math.ceil(DIRS.cd)+' s.');return null;}DIRS.cd=20;dirSabotage();INV.dirsabot=99;return '💥 Sabotage : flaques, produits au sol et ascenseur du Drive bloqué. Pense à désigner un coupable !'+(DIRS.scape?'':' (personne désigné pour l\'instant)');},
 dirscape:function(){if(!DIRS||!DIRS.me)return null;const L=otherMgr(9);if(!L.length)return null;const m=L[(Math.random()*L.length)|0];DIRS.scape=m;INV.dirscape=99;return '🫵 '+m.name+' sera tenu responsable si le magasin est saboté.';},
 dirall:function(){if(!DIRS||!DIRS.me)return null;if(DIRS.cd>0){toast('Le directeur doit patienter '+Math.ceil(DIRS.cd)+' s.');return null;}DIRS.cd=12;EMP.forEach(function(e){imgHit(e,20);});INV.dirall=99;return '🌪️ Réorganisation : tous les employés perdent 20 de Sérieux.';}});
function dirStart(who,me,m){if(DIRS)return;DIRS={t:240,who:who,me:me,m:m||null,cd:0,hit:15,pb:0,sab:0,scape:null,sabT:50+Math.random()*40};if(m)m.imm=245;if(me){PIMM=Math.max(PIMM,245);INV.dirblame=INV.dirdown=INV.dirall=INV.dirsabot=INV.dirscape=99;renderQI();}D.inv=null;D.rage=0;
 pop('👑 La directrice part en vacances : '+(me?'tu deviens':who+' devient')+' Directeur pendant 4 minutes !','good');toast(me?'La directrice est en vacances : tu es immunisé. Blâme, fais chuter les managers, saborde même le magasin… mais désigne un coupable avant son retour (barre rapide).':who+' remplace la directrice : il peut blâmer tout le monde, y compris toi, et peut-être saboter le magasin. Fais-toi discret.');}
function dirEnd(){if(!DIRS)return;const d=DIRS;DIRS=null;if(d.me){INV.dirblame=INV.dirdown=INV.dirall=INV.dirsabot=INV.dirscape=0;renderQI();}
 EVS.forEach(function(e){if(e.m.parent)e.m.parent.remove(e.m);});EVS.length=0;
 let msg='👑 La directrice est de retour : fin du règne de '+(d.me?'ton directorat':d.who)+'.',expo=false;
 if(d.sab>0){const pr=d.proof||0;expo=pr>=3||Math.random()<[0,.35,.65][pr];
  if(expo){msg+=' Les managers ont des preuves ('+pr+') : la directrice démasque le directeur !';if(!d.me&&d.m&&!d.m.fired){fireMgr(d.m);msg+=' '+d.who+' est viré.';}}
  else{const L=otherMgr(9).filter(function(m){return m!==d.m;}),sc=(d.scape&&!d.scape.fired&&d.scape!==d.m)?d.scape:L[0];
   if(sc){hitMgr(sc,60,'dir');msg+=' Elle découvre les dégâts : '+sc.name+' est tenu responsable (−60 de réputation).';}else msg+=' Elle découvre les dégâts mais ne trouve aucun coupable.';}}
 toast(msg);if(expo&&d.me&&rank>=1)demote();}
const EVS=[];
function evSpot(x,z){const m=new T.Mesh(new T.RingGeometry(.55,.8,28),new T.MeshBasicMaterial({color:0x3fa9ff,transparent:true,opacity:.9,depthWrite:false}));m.rotation.x=-Math.PI/2;m.position.set(x,.07,z);Z.store.g.add(m);const n=[];liveMgrs().forEach(function(g){if(DIRS&&DIRS.m===g)return;if(Math.random()<.3)n.push(8+Math.random()*17);});EVS.push({x:x,z:z,t:30,p:0,m:m,n:n,got:false});}
function evProof(by){if(!DIRS)return;DIRS.proof=(DIRS.proof||0)+1;if(DIRS.me)toast('🔎 '+by+' a relevé une preuve contre toi…');else if(by==='Toi')toast('🔎 Preuve relevée contre le directeur '+DIRS.who+' ('+Math.min(3,DIRS.proof)+'/3).');}
function dirSabotage(){DIRS.sab++;{const x=-16+Math.random()*52,z=-9+Math.random()*19;evSpot(x,z);if(DIRS.me)toast('Les managers ont 30 s pour te prendre en flagrant délit : éloigne-toi.');else if(rank>=1)toast('🔎 Le directeur '+DIRS.who+' vient de saboter le magasin ! Va sur le rond bleu avant 30 s pour relever une preuve.');}DIRS.sabT=60+Math.random()*50;if(mode==='zone'||mode==='map'){[-16,-8,-3,2,14,20,26,36].sort(function(){return Math.random()-.5;}).slice(0,4).forEach(function(x){messAt(x,-9+Math.random()*19);});}ELEV.t=Math.max(ELEV.t,90);RESULT=Math.max(0,RESULT-6);}
function vacStart(){if(DIRS)return;const L=liveMgrs().slice().sort(function(a,b){return b.stand-a.stand;}),top=L[0];const pl=rank>=1?(RESULT+image)/2:-1;
 if(pl>=0&&(!top||pl+Math.random()*15>=top.stand))dirStart(PNAME||'Toi',true,null);else if(top)dirStart(top.name,false,top);}
function eomElect(){const C=[];EMP.forEach(function(e){if(e.out>0)return;empS(e);C.push({k:'e',e:e,n:e.name,s:e.im});});liveMgrs().forEach(function(m){C.push({k:'m',m:m,n:m.name,s:m.stand});});
 const pl=rank===0?image:(rank>=1?(RESULT+image)/2:-1);if(pl>=0)C.push({k:'p',n:PNAME||'Toi',s:pl});
 C.forEach(function(c){c.s+=Math.random()*18;if(c.n===EOM.last)c.s-=40;});C.sort(function(a,b){return b.s-a.s;});const w=C[0];if(!w)return;EOM.last=w.n;
 if(w.k==='p'){if(rank===0){coins+=40;image=Math.min(100,image+20);addW(10);pop('🏆 Tu es Employé du Mois ! Prime +40 🪙, Sérieux +20','good');toast('Employé du Mois : continue comme ça, la promotion approche.');}
  else{coins+=90;PIMM=Math.max(PIMM,90);pop('🏆 Tu es le bras droit de la directrice (Employé du Mois) ! Prime +90 🪙, immunité 90 s','good');toast('Grosse prime et immunité : plus aucun blâme pendant 90 s.');}}
 else if(w.k==='e'){w.e.im=100;w.e.sw=Math.min(100,w.e.sw+10);pop('🏆 Employé du Mois : '+w.n,'good');}
 else{w.m.imm=90;w.m.stand=Math.min(100,w.m.stand+15);drawM(w.m);pop('🏆 '+w.n+' (manager) devient le bras droit de la directrice : prime et immunité','good');}}
function npcOrder(){if(netNpcLive())return;const L=liveMgrs().filter(function(m){return !(m.imm>0);});if(!L.length)return;const m=L[(Math.random()*L.length)|0],r=Math.random();
 if(rank>=1&&r<.3){const d=3+((Math.random()*5)|0);RESULT=Math.max(0,RESULT-d);toast('🗡️ '+m.name+' te savonne auprès de la directrice : Résultats −'+d+'.');return;}
 if(TEAM.t>0)return;const k=r<.55?'sifflet':r<.7?'note':r<.82?'surcharge':r<.92?'audit':'rappel';teamApply(k,m.name,false);if(netNpcIsHost())netEv(k,m.name);toast('👥 '+m.name+' lance un ordre à toute l\'équipe : '+({sifflet:'sifflet, 3 tâches de bosseur en 1 min',note:'note de service',surcharge:'surcharge de dossiers',audit:'audit surprise',rappel:'rappel à l\'ordre'})[k]+'.');}

/* ---------- v121 : CSE (élus du personnel, gilets, grève) ---------- */
const CSE={m:[],next:240,vote:null,cd1:0,cd2:0,end:0},STRK={t:0,cd:0};let WKP=0;
function isCseName(n){return CSE.m.indexOf(n)>=0;}
function isCseMe(){return rank===0&&CSE.m.indexOf('@me')>=0;}
function setVest(ch,on){let v=ch.userData.cvest;if(!v){if(!on)return;const m=ch.children[0]||ch;v=new T.Group();box(v,.72,.52,.56,0xd7263d,0,1.02,0,false);const lb=sign('CSE',.46,.2,'#ffffff','#d7263d');lb.position.set(0,1.05,.29);v.add(lb);m.add(v);ch.userData.cvest=v;}v.visible=!!on;}
function strikeLabel(g,on){let l=g.userData.slab;if(!l){if(!on)return;l=label('✊ EN GRÈVE',{sx:2.3,sy:.58,w:256,h:64,size:30,bg:'rgba(229,72,77,.95)'});l.position.y=3.35;g.add(l);g.userData.slab=l;}l.visible=!!on;}
function cseVests(){EMP.forEach(function(e){setVest(e.g,isCseName(e.name));});Object.keys(MEETD).forEach(function(k){setVest(MEETD[k],isCseName(k));});setVest(pl,isCseMe());}
function cseCands(){const L=[];EMP.forEach(function(e){if(e.out>0)return;empS(e);if(e.sw>=40&&(e.bl||0)<2)L.push({id:e.name,nm:e.name,sc:e.im+e.sw*.5});});if(rank===0&&WKP>=15&&blames<2)L.push({id:'@me',nm:PNAME||'Toi',sc:image+WKP});return L;}
function cseStart(){const C=cseCands();CSE.vote=null;if(C.length<2){CSE.next=clk+120;return;}CSE.vote={t:80,cands:C,me:null};
 if(rank===0){pop('📮 Élections du CSE : dépose ton bulletin à la boîte aux lettres de la salle de pause !','good');toast('Élections du CSE : candidats '+C.map(function(c){return c.id==='@me'?'toi':c.nm;}).join(', ')+'. 80 s pour voter (on ne vote pas pour soi, ta voix compte 3).');}
 else toast('📮 Élections du CSE en cours chez les employés.');}
function cseTally(){const V=CSE.vote;CSE.vote=null;if(!V)return;const cnt={};V.cands.forEach(function(c){cnt[c.id]=0;});
 EMP.forEach(function(e){if(e.out>0)return;const L=V.cands.filter(function(c){return c.id!==e.name;});if(!L.length)return;let tot=0;L.forEach(function(c){tot+=c.sc*c.sc;});let r=Math.random()*tot,pick=L[0];for(let i=0;i<L.length;i++){r-=L[i].sc*L[i].sc;if(r<=0){pick=L[i];break;}}cnt[pick.id]++;});
 if(V.me&&cnt[V.me]!==undefined)cnt[V.me]+=3;
 V.cands.sort(function(a,b){return (cnt[b.id]-cnt[a.id])||(b.sc-a.sc);});CSE.m=V.cands.slice(0,2).map(function(c){return c.id;});CSE.end=clk+360;CSE.next=clk+360;WKP=0;STRK.cd=0;cseVests();
 const nm=V.cands.slice(0,2).map(function(c){return c.id==='@me'?'toi':c.nm;});pop('🧑‍🏭 Élus du CSE : '+nm.join(' et '),'good');
 if(CSE.m.indexOf('@me')>=0)toast('Tu es élu au CSE ! Gilet rouge, protection contre les blâmes (1 sur 2 sauté) et bouton ✊ Grève (45 s d\'immunité). Attention : 2 blâmes et tu perds ton siège.');}
function openVoteOld(){if(!CSE.vote){toast('📮 Pas d\'élection en ce moment (prochain vote dans '+Math.max(0,Math.ceil(CSE.next-clk))+' s). Pour te présenter : 15 points de bosseur sur la période et moins de 2 blâmes (tu en as '+Math.round(WKP)+').');return;}
 if(CSE.vote.me){toast('Tu as déjà voté.');return;}const L=CSE.vote.cands.filter(function(c){return c.id!=='@me';});
 dlg('📮 Élections du CSE','On ne vote pas pour soi-même. Ta voix compte pour 3.'+(CSE.vote.cands.some(function(c){return c.id==='@me';})?' Tu es candidat !':''),L.map(function(c){return {t:c.nm,f:function(){if(CSE.vote)CSE.vote.me=c.id;toast('Bulletin glissé dans l\'urne pour '+c.nm+'.');}};}).concat([{t:'Voter blanc',f:function(){if(CSE.vote)CSE.vote.me='blank';toast('Bulletin blanc.');}},{t:'Annuler'}]));}
function openBoard(){const mem=CSE.m.map(function(n){return n==='@me'?'toi':n;}).join(', ')||'personne';const me=isCseMe();
 dlg('🧑‍🏭 Panneau syndical CSE','Élus du CSE : '+mem+'. 2 sièges, réservés aux joueurs. Vote toute la journée à l\'urne de la salle de pause, résultat à minuit (sans vote, les plus actifs sont désignés). Les élus portent un gilet rouge, ont 5 cartons au lieu de 3, des missions syndicales et peuvent se mettre en grève.',me?[
  {t:'📣 Heure syndicale : annuler 1 blâme'+(CSE.cd1>0?' ('+Math.ceil(CSE.cd1)+' s)':''),dis:CSE.cd1>0||blames<1,f:function(){if(blames<1||CSE.cd1>0)return;blames--;CSE.cd1=150;toast('Le syndicat plaide ta cause : un blâme est annulé.');}},
  {t:'🚨 Droit d\'alerte : signaler un manager'+(CSE.cd2>0?' ('+Math.ceil(CSE.cd2)+' s)':''),dis:CSE.cd2>0,f:function(){if(CSE.cd2>0)return;const L=otherMgr(1);if(!L.length){toast('Aucun manager à signaler.');return;}CSE.cd2=200;hitMgr(L[0],10);addB(3);toast('🚨 Le CSE alerte la direction sur '+L[0].name+' : −10 de réputation. +3 branleur.');}},
  {t:'Fermer'}]:[{t:'Fermer'}]);}
function strikeStart(){if(!isCseMe()||STRK.cd>0||STRK.t>0)return;STRK.t=45;STRK.cd=180;PIMM=Math.max(PIMM,45);MOOD.t=45;MOOD.k='bad';MOOD.img=image;strikeLabel(pl,true);pop('✊ Tu te mets en grève : immunité 45 s, mais ni salaire ni progression.','good');}
function cseTick(dt){if(CSE.cd1>0)CSE.cd1-=dt;if(CSE.cd2>0)CSE.cd2-=dt;if(STRK.cd>0)STRK.cd-=dt;if(STRK.t>0){STRK.t-=dt;if(STRK.t<=0){STRK.t=0;strikeLabel(pl,false);toast('La grève est terminée : retour au travail.');}}
 if(CSE.m.indexOf('@me')>=0&&(rank!==0||VIGI)){CSE.m=CSE.m.filter(function(n){return n!=='@me';});cseVests();strikeLabel(pl,false);}

 EMP.forEach(function(e){if(!isCseName(e.name)){if(e.strk>0){e.strk=0;strikeLabel(e.g,false);}return;}
  if((e.bl||0)>=2){CSE.m=CSE.m.filter(function(n){return n!==e.name;});cseVests();toast(e.name+' perd son siège au CSE (trop de blâmes).');return;}
  if(e.strk>0){e.strk-=dt;e.noF=Math.max(e.noF||0,2);if(e.strk<=0){e.strk=0;strikeLabel(e.g,false);}}
  else{e.sn=(e.sn===undefined?70+Math.random()*100:e.sn)-dt;if(e.sn<=0){e.sn=200+Math.random()*150;e.strk=40;strikeLabel(e.g,true);if(rank===0)toast('✊ '+e.name+' (CSE) se met en grève 40 s !');}}});
 if(CSE.vote){CSE.vote.t-=dt;if(CSE.vote.t<=0)cseTally();}
 
 const sb=$('bStrike');if(sb){const on=isCseMe()&&mode==='zone'&&!CINE&&!uiOpen;sb.hidden=!on;const t=$('bStrikeT');if(t)t.textContent=STRK.t>0?Math.ceil(STRK.t)+' s':STRK.cd>0?Math.ceil(STRK.cd)+' s':'Grève';}}

/* ---------- v122 : toilettes H/F, saletés, inondation, lavabos ---------- */
const WCDIRT=[0,0];let WCFL=0,UNW=false,UNWC=0,UNWT=1,WCV=45;WC.last=null;
function openWcUse(){if(!WCIN)return;const i=WCIN.i,dirty=!!WCDIRT[i];
 const B=[{t:'🚽 Faire pipi',f:function(){wcDo('pipi');}},{t:'💩 Faire caca',f:function(){wcDo('caca');}},{t:'🤢 Laisser des traces (+7 branleur)',f:function(){wcDo('trace');}},{t:'🧻 Tout boucher au papier : inondation (+15 branleur)',f:function(){wcDo('flood');}}];
 if(dirty)B.push({t:'🧽 Nettoyer (+1 bosseur)',f:function(){wcDo('clean');}});B.push({t:'Annuler'});
 dlg('🚽 Cabine',dirty?'Les toilettes sont sales…':'Que veux-tu faire ?',B);}
function wcDo(k){if(!WCIN)return;const i=WCIN.i;
 if(k==='clean'){WCDIRT[i]=0;CAB[i].dirt.visible=false;addW(1);toast('🧽 Tu nettoies : toilettes impeccables.');return;}
 UNW=true;UNWC=20;WC.last={who:'@me',t:clk};if(k==='pipi')URG=Math.max(0,URG-60);if(k==='caca'||k==='trace'||k==='flood')URG=0;if(k==='trace'||k==='flood')cleanerCheck();
 if(k==='pipi'){addB(2);if(Math.random()<.55||globalThis.__peemiss){WCDIRT[i]=1;showStain(i,'p');toast('Aaah… +2 branleur, mais tu en as mis à côté : traces jaunes partout !');}else toast('Aaah… +2 branleur. Pense à te laver les mains aux lavabos !');}
 else if(k==='caca'){addB(4);if(Math.random()<.35){WCDIRT[i]=1;showStain(i,'b');toast('Aïe : tu as laissé des traces… +4 branleur. Sors avant qu\'on le découvre.');}else toast('Soulagement… +4 branleur. Lave-toi les mains !');}
 else if(k==='trace'){wfxSend('trace',null,i);addB(7);WCDIRT[i]=1;showStain(i,'b');toast('🤢 Quel désastre : toilettes dégueulasses. +7 branleur. Sors vite avant qu\'on te voie.');}
 else if(k==='flood'){wfxSend('flood',null);addB(15);WCFL=60;exitCabin();wcEject(true);pop('🌊 Les toilettes sont inondées ! Bloquées 1 minute.','bad');toast('Tu bouches tout : l\'eau déborde partout. Disparais avant qu\'on te dénonce…');}}
const PH={
 idle_store:['Si tu sais pas quoi faire, va faire du facing avant que je te blâme !','Les rayons ne se rangent pas tout seuls : facing, tout de suite !','Tu fixes quoi, là ? Les yaourts vont s\'aligner par magie ?'],
 idle_reserve:['La réserve, c\'est pas un hôtel ! Va remplir les rayons !','Encore planqué dans la réserve ? Les palettes ne bougeront pas seules !','Tu comptes les cartons ou tu les regardes ?'],
 idle_office:['Le bureau, c\'est pas la salle de sieste. Au boulot !','Tu as des tâches à faire, pas un fauteuil à chauffer !'],
 idle_parking:['Le parking, c\'est pour les clients, pas pour les rêveurs ! Les chariots !','Les chariots ne vont pas se ranger seuls !'],
 idle_def:['Toi, là ! Va te rendre utile avant que je te blâme !'],
 cafe:['Un café en main en plein service ? Tu te crois à la terrasse ?','Le café, c\'est en pause. Pas devant les clients !'],
 vol:['Je t\'ai vu mettre ça dans ta poche : voleur !','Reposez ça immédiatement ! C\'est du vol !'],
 sabo:['Qu\'est-ce que tu fabriques ?! C\'est du sabotage !','Tu as cassé quelque chose ? Je t\'ai vu !'],
 sieste:['Debout ! On ne dort pas pendant le service !'],
 wc_flood:['Qui a inondé les toilettes ?! Je veux le nom, tout de suite !','Une inondation ! C\'est encore vous, j\'en suis sûre !'],
 wc_dirt:['Les toilettes sont dégueulasses ! Qui est passé en dernier ?','Quelqu\'un a oublié la chasse d\'eau… et la dignité.'],
 hands:['Tu ne t\'es pas lavé les mains ! C\'est dégoûtant !','Les mains, ça se lave ! On n\'est pas des animaux !'],
 gen:['Je t\'ai vu !','Pris sur le fait !']
};
function phrase(ctx,zn){const k=(ctx==='idle')?('idle_'+(PH['idle_'+zn]?zn:'def')):ctx;const a=PH[k]||PH.gen;return a[(Math.random()*a.length)|0];}
function wcAsker(){const r=Math.random();const ms=MGR.filter(function(m){return !m.fired;});if(r<.5||!ms.length)return {n:'La directrice',g:dirc,d:true};const m=ms[(Math.random()*ms.length)|0];return {n:m.name,g:m.g,d:false};}
const WCB={a:59.9,b:61,c:-35.8,d:-32.2};
function inWcRoom(){return cur==='office'&&pp.x>60.6&&pp.x<69&&pp.z>-43.6&&pp.z<-24.4;}
function wcMgr(){return rank>=1;}
function wcEject(force){if(!inWcRoom())return;if(!force&&wcMgr())return;pp.x=58.6;pp.z=-34;act=null;if(!force)pop('🌊 Les toilettes sont condamnées : tu es éjecté ! Réservé aux managers (1 min).','bad');}
function wcFlood(on){const ix=O.obs.indexOf(WCB);if(on&&ix<0&&!wcMgr())O.obs.push(WCB);else if((!on||wcMgr())&&ix>=0)O.obs.splice(ix,1);}
function wcUnclog(){WCFL=0;if(WCWATER)WCWATER.visible=false;CAB.forEach(function(c){c.mk.off=c.closed;});WCDIRT[0]=WCDIRT[1]=1;CAB.forEach(function(c,i){showStain(i,'b');showStain(i,'p');});wcFlood(false);if(WC.mkD)WC.mkD.off=true;
 coins+=4;RESULT=Math.min(100,RESULT+4);addW(3);
 const E=EMP.filter(function(e){return !(e.out>0)&&!e.chore;}).slice(0,4);const B=E.map(function(e){return {t:'🧽 '+e.name+' nettoie les toilettes (30 s)',f:function(){e.chore={k:'wc',t:30};if(typeof endFault==='function')endFault(e);e.noF=40;toast(e.name+' part nettoyer les toilettes.');}};});
 B.push({t:'Je laisse tel quel'});dlg('🪠 Déboucher : fait !','Les toilettes sont débouchées (+4 pièces, Résultats +4) mais restent sales. Désigne un employé pour les nettoyer :',B);}
function wcNear(){let n=null,bd=4;EMP.forEach(function(e){if(e.zn!==cur||e.out>0)return;const d=Math.hypot(e.x-pp.x,e.z-pp.z);if(d<bd){bd=d;n=e.name;}});MGR.forEach(function(m){if(m.zn!==cur||m.fired)return;const d=Math.hypot(m.x-pp.x,m.z-pp.z);if(d<bd){bd=d;n=m.name;}});return n;}
function wcVisit(force){const E=EMP.filter(function(e){return !(e.out>0);});if(!E.length)return;const v=E[(Math.random()*E.length)|0].name;
 if(!(WCDIRT[0]||WCDIRT[1]||WCFL>0))return;const L=WC.last;if(!L||clk-L.t>400||(!force&&Math.random()>.75))return;
 const fl=WCFL>0,K=wcAsker();if(L.who==='@me'){if(rank===0){pop('🚽 '+K.n+' : « '+phrase(fl?'wc_flood':'wc_dirt')+' » ('+v+' t\'a dénoncé)','bad');if(K.g)say(K.g,phrase(fl?'wc_flood':'wc_dirt'));giveWarn((fl?'toilettes inondées':'toilettes sales')+' (dénoncé par '+v+')');}}
 else{const e=EMP.find(function(x){return x.name===L.who;});if(e){const wr=addWarn(e);toast('🚽 '+v+' dénonce '+e.name+' : toilettes sales, '+(wr===2?'blâme !':'avertissement '+e.wn+'/3.'));}}
 WCDIRT[0]=WCDIRT[1]=0;CAB.forEach(function(c){c.dirt.visible=false;});WC.last=null;}
function wcTick(dt){
 if(WCFL<=0&&O.obs.indexOf(WCB)>=0)wcFlood(false);
 if(WCFL>0){WCFL-=dt;CAB.forEach(function(c){c.mk.off=true;});if(WCWATER)WCWATER.visible=true;wcFlood(true);if(WC.mkD)WC.mkD.off=!wcMgr();wcEject(false);if(WCFL<=0){WCFL=0;if(WCWATER)WCWATER.visible=false;CAB.forEach(function(c){c.mk.off=c.closed;});wcFlood(false);if(WC.mkD)WC.mkD.off=true;toast('Les toilettes sont de nouveau utilisables.');}}
 if(WCIN&&WCIN.alert>0){WCIN.alert-=dt;if(WCIN.alert<=0){WCIN.alert=0;const m=MGR.find(function(x){return !x.fired&&x.zn==='office';})||MGR.find(function(x){return !x.fired;}),nm=m?m.name:'Un manager';pop('🚨 '+nm+' et un vigile débarquent : « Monsieur, ce sont les toilettes des femmes ! »','bad');exitCabin();giveBlame('homme dans les toilettes des femmes',15);}}
 WCV-=dt;if(WCV<=0){WCV=35+Math.random()*30;wcVisit(false);}
 if(UNW&&rank===0&&mode==='zone'&&!WCIN){UNWT-=dt;if(UNWT<=0){UNWT=1;if(UNWC>0)UNWC-=1;else{const w=wcNear();if(w&&Math.random()<.12){UNW=false;UNWC=20;{const K=wcAsker();pop('🤢 '+K.n+' : « '+phrase('hands')+' » ('+w+' t\'a dénoncé)','bad');if(K.g)say(K.g,phrase('hands'));}giveWarn('mains pas lavées (dénoncé par '+w+')');}}}}
 if(rank!==0||VIGI)UNW=false;v124Tick(dt);}
/* ---------- v124 : toilettes clients, besoins, ménage, inspection, scotch ---------- */
