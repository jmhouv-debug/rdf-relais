  lvCheck();$('sc').innerHTML=(SEC?'Grade '+GN[GRADE]+' • ':'')+'Niv. '+(rank>=1?LVM:LVL)+((rank===0&&!SEC)?'':'<span class="scw">💼 Bosseur <b>'+SW+'</b>/'+lvNeed((rank>=1?LT.m:LT.e).w)+'</span>')+'<span class="scb">🎭 '+((rank===0&&!SEC)?'Points de branleur':'Branleur')+' <b>'+SB+'</b>/'+lvNeed((rank>=1?LT.m:LT.e).b)+'</span>'+((rank===0&&!SEC&&!CREATING)?'<span class="scp">🏆 <b>'+proMine()+'</b> pts'+(function(){const k=proRank();return k&&k.n>1?' • '+proOrd(k.r)+' sur '+k.n:'';})()+'</span>':'');
  $('rank').hidden=!rank&&!VIGI&&!SEC;
  $('rank').textContent=rank?'Manager':(SEC?'Sécurité · '+GN[GRADE]+' · Sérieux ':'Employé · Sérieux ')+Math.round(image);
  $('bTel').hidden=!WCIN;$('qi').hidden=!$('qi').innerHTML||mode!=='zone'||!!PHN;const ab=$('act');if(act&&act.key==='vider'){ab.hidden=false;$('actL').textContent='Vider les frigos : équipe '+FR.n+'/'+FR.need+(FR.n<FR.need?' (il faut être '+FR.need+' !)':'');$('actF').style.width=Math.round(clamp(FR.prog,0,1)*100)+'%';$('actF').style.background=FR.n>=FR.need?'#46d17a':'#ff6a6a';}else if(act){ab.hidden=false;$('actL').textContent=act.label;$('actF').style.width=Math.round(clamp(act.o.prog||0,0,1)*100)+'%';$('actF').style.background=hex6(CAT[act.cat]);}else{let pm=null,pd=3.2;Z[cur].markers.forEach(function(m){if(m.prog>0&&!m.off){const d=Math.hypot(m.x-pp.x,m.z-pp.z);if(d<pd){pd=d;pm=m;}}});
    if(mode==='zone'&&pm){ab.hidden=false;$('actL').textContent='Progression mémorisée ('+Math.max(0,Math.ceil(10-(clk-pm.touch)))+' s)';$('actF').style.width=Math.round(clamp(pm.prog,0,1)*100)+'%';$('actF').style.background='#8a93a3';}else ab.hidden=true;}
  try{edmArrows();}catch(_){}const htF=hudText();HUDFULL=htF;const HP=hudParts2(htF),ht=HP.m+'\u0001'+HP.s;if(ht!==lastHud){if(!lastHud||lastHud.split('\u0001')[0]!==HP.m)hudSet($('objM'),HP.m);if(!lastHud||lastHud.split('\u0001')[1]!==HP.s)hudSet($('objS'),HP.s);lastHud=ht;}
}


/* ---------- MANAGER : radar, fautes, sanctions, cameras, ordinateur ---------- */
let LOWT=0,RPAY=0,dIdle=0,RESULT=70,COMP=100,CONV=null,CONVCD=0,lowC=false,CAMCD=0,CAMT=0,mIdle=0,ppx=0,ppz=0,HID=0,HIDT=0,HTO=-99,HIDP=null,JUM=0,TAMP=0,NOTE=0,WCOCC=0,PLB={t:0,z:'all'},PLCD=0,lowW=false;
const MSG=[],SANC=[];
const FK={traine:['💤','Traîne',1],tel:['📱','Téléphone perso',1],vol:['🧴','Vole un produit',2],pause:['☕','Pause sauvage',1]};
const FZ={store:['traine','vol','pause'],reserve:['traine','vol','pause'],boulangerie:['traine','vol','pause'],poissonnerie:['traine','vol','pause'],office:['pause','traine'],parking:['traine']};
const ZNAME={store:'au magasin',reserve:'en réserve',boulangerie:'au labo boulangerie',poissonnerie:'au labo poissonnerie',office:'aux bureaux',parking:'au parking',salle:'en salle de réunion',compta:'à la comptabilité',coffres:'à la salle des coffres',electro:'au magasin d\'électroménager',location:'à l\'agence de location'};
const mcone=mkCone(scene,9,.55,0x6ee7ff,.22);mcone.grp.visible=false;
const bubbleH=label('Planqué…',{sx:1.9,sy:.55,w:256,h:64,size:30,bg:'rgba(46,160,90,.96)'});scene.add(bubbleH);bubbleH.visible=false;
marker(R,'mfumer',-11.6,-28.4);marker(R,'mfrigo',-23.2,-38.3);marker(R,'mfrigo',-14.6,-38.3);
const MOBCODE=marker(O,'mobcode',34,-35,'Code de l\'alarme'),MOBBOX=marker(S,'mobbox',22,16.6,'Alarme du magasin : désactivation');const MFR=marker(O,'mfrap',65,-36.9),MOU=marker(O,'mouvrir',67.9,-36.9);MFR.off=MOU.off=true;
(function(){const pk=function(zn,x,z){const m=marker(zn,'planque',x,z);return m;};
  [[S,-26.3,11.2],[S,31,17],[S,45,16.6],[S,36.4,-13.3],[O,37.2,-27.4],[O,17.2,-27.4],[O,37.2,-40.8],[R,-35.6,-36.8],[R,-17.2,-27.4],[R,-37,-27.4],[R,-32.3,-40.8]].forEach(function(a){pk(a[0],a[1],a[2]);});})();
const MGRONLY={mobcode:1,mobbox:1,mobfix:1,planque:1,mfrap:1,mouvrir:1,mfumer:1,mfrigo:1,mctrl:1,mpcam:1},MGRSHARE={cafe:1,cabine:1,butin:1,coffre:1,pc:1,convoquer:1,planning:1,sieste:1,babyfoot:1,wc:1,food:1,photo:1,planquer:1};
const VGW={cafe:1,cabine:1,wc:1,food:1,sieste:1,babyfoot:1,planque:1,vcaisse:1,vprix:1,vcam:1,vsalle:1,butin:1,binfire:1};
function vView(m){return false;if(!(SEC&&VG.surv>0))return false;const k=MK[m.obj];return !!k&&(k[0]==='work'||k[0]==='steal'||k[0]==='sabo')&&!VGW[m.obj];}
function roleOK(m){if(m.obj==='cstract'||m.obj==='csplainte'||m.obj==='csfin')return isCseMe();return roleOK0(m);}
function roleOK0(m){const o=m.obj;if(o==='mobcode'||o==='mobbox')return rank>=1&&!SEC&&!!mobAlarm();if(o==='mobfix')return rank>=1&&!SEC&&mobFixOK(m);if(NK>.5&&(o==='discuter'||o==='aidecaisse'))return false;if(o==='mcarton')return rank===0&&!SEC&&!!WL&&WL.st==='idle'&&WL.lv<3;if(o==='vtake')return rank===0&&!SEC&&!VH.carry&&!MACH.carry;if(CON[o])return rank===0&&!SEC;if(o==='repasc')return ELEV.t>0;if(o==='binfire')return !!SAL.fire;if(o==='viderb')return BAL.full||BAL.broken;if(o==='debloquer')return rank>=1&&BAL.broken;if(o==='rd1'||o==='rd2'||o==='rd3'||o==='vissue'||o==='vlocal')return SEC;if(o==='sprank1'||o==='sprank2')return rank===0&&!MEET.on;if(o==='cafe')return true;if(o==='urne'||o==='cse')return rank===0;if(o==='pupitre')return !SEC;if(o==='vcaisse'||o==='vprix')return SEC;if(o==='wcvig')return rank===0;if(o==='wcplan')return rank>=1;if(o==='deboucher')return rank>=1&&WCFL>0;if(o==='disperser')return rank>=1&&COF.grp.length>0;if(o==='binfire')return !!MX.fire;if(o==='vcam')return SEC&&!SAL.cam;if(o==='vsalle')return SEC&&SAL.projGone<=0&&LOOT.length<3;if(o==='cloturer')return rank>=1&&MEET.on&&MEET.by==='me';if(o==='lancer')return rank>=1&&!MEET.on;if(o==='animer')return rank>=1&&MEET.on&&MEET.by==='me';if(o==='repasc')return rank>=1;if(o==='candid'||o==='discuter'||o==='micro'||o==='cache')return rank===0;if(o==='autolav'||o==='reparer'||o==='aidecaisse')return rank>=1;if(MGRONLY[o])return rank>=1;if(rank>=1)return !!MGRSHARE[o]||(!!MK[o]&&MK[o][0]==='work'&&o!=='vider');return true;}
function mgrReset(){LOWT=0;RPAY=0;DEN=null;D.inv=null;LASTSLACK=-99;RESULT=70;COMP=100;CONV=null;CONVCD=0;lowC=false;CAMCD=0;CAMT=0;mIdle=0;TCAMS.forEach(function(c){Z[c.zn].g.remove(c.g);});TCAMS.length=0;HID=0;JUM=0;TAMP=0;NOTE=0;PLB={t:0,z:'all'};PLCD=0;lowW=false;MSG.length=0;SANC.length=0;
  EMP.forEach(function(e){e.f=null;e.conf=0;e.warn=0;e.bl=0;e.nf=8+Math.random()*50;e.flag=0;e.spy=0;e.noF=0;e.cvcd=0;e.press=0;e.sayP=0;e.lastF=-999;e.out=(e.cap||e.nOff)?1e9:0;e.blAge=0;e.g.visible=!(e.cap||e.nOff);if(e.fb)e.fb.sp.visible=false;});}
function coneR(){return JUM>0?16:9;}
function inConeE(e){if(e.out>0||e.zn!==cur||mode!=='zone')return false;const dx=e.x-pp.x,dz=e.z-pp.z,d=Math.hypot(dx,dz);if(d>coneR()||d<.01)return false;if((Math.sin(pp.face)*dx+Math.cos(pp.face)*dz)/d<=Math.cos(.55))return false;return !blocked(Z[cur],pp.x,pp.z,e.x,e.z);}
function rateMult(e){return ((PLB.t>0&&(PLB.z==='all'||PLB.z===e.zn))?.35:1)*(LK.sim?4:1);}
function startFault(e){const ks=FZ[e.zn]||['traine'],k=ks[(Math.random()*ks.length)|0];if(k==='vol')e.loot=60;e.f={k:k,t:(14+Math.random()*10)*(LK.sim?1.5:1),sev:FK[k][2]};e.conf=0;e.lastF=clk;
  if(rank>=1&&e.zn!==cur&&Math.random()<(globalThis.__nomsgcd?.75:.25)){const o=EMP.filter(function(x){return x!==e;});pushMsg({theft:k==='vol',from:o[(Math.random()*o.length)|0].name,kind:'e',e:e,zn:e.zn,txt:e.name+' '+({traine:'ne fait rien',tel:'est sur son téléphone',vol:'a l\'air de piquer un produit',pause:'fait une pause sauvage'}[k])+' '+ZNAME[e.zn]+'.'});}}
function addBl(e){if(isCseName(e.name)&&(e.strk>0||Math.random()<.5))return;e.bl=Math.min(3,(e.bl||0)+1);e.blAge=0;empS(e);e.im=0;e.sb=Math.max(0,e.sb-15);}
function empS(e){if(e.im===undefined){e.im=12+((Math.random()*38)|0);e.lv=1+((Math.random()*4)|0);e.sb=(Math.random()*70)|0;e.sw=(Math.random()*90)|0;}return e;}
function dayN(){return Math.floor(mins/1440);}
function authTick(){const d=dayN();if(AUTH.day!==d){AUTH.day=d;AUTH.ca=1;AUTH.co=2;AUTH.ho=2;AUTH.an=2;AUTH.re=1;}}
function onlineEmps(){const L=[];if(NET.on&&NET.joined)Object.keys(NET.players).forEach(function(pid){if(pid===NET.pid)return;const p=NET.players[pid];if(p&&p.lk&&p.lk.role==='e')L.push({nm:p.nm||'Joueur',im:p.im||0,lv:p.lv||1,sb:p.sb||0,sw:p.sw||0,on:1});});return L;}
function empRec(e){empS(e);return {nm:e.name,im:Math.round(e.im),lv:e.lv,sb:Math.round(e.sb),sw:Math.round(e.sw)};}
function empLine(r){return 'Sérieux '+r.im+' • Niv. '+r.lv+' • Bosseur '+r.sw+' • Branleur '+r.sb;}
function shameAdd(r){SHAME.push(Object.assign({day:dayN()},r));while(SHAME.length>3)SHAME.shift();drawShame();}
function drawShame(){if(typeof SHB==='undefined'||!SHB)return;const x=SHB.cv.getContext('2d'),w=1024,h=360;x.clearRect(0,0,w,h);x.fillStyle='#1d1230';x.fillRect(0,0,w,h);x.strokeStyle='#f5b82e';x.lineWidth=8;x.strokeRect(6,6,w-12,h-12);
  x.fillStyle='#f5b82e';x.font='700 38px Fredoka,system-ui,sans-serif';x.textAlign='center';x.fillText('🏴 MUR DU PIRE CAUCHEMAR',w/2,52);
  const L=SHAME.slice().reverse();if(!L.length){x.fillStyle='#b9a8d6';x.font='600 30px system-ui,sans-serif';x.fillText('Aucun employé désigné pour le moment',w/2,200);}
  L.forEach(function(r,i){const cx=20+i*330,cy=76;x.fillStyle='#2b1c47';x.fillRect(cx,cy,310,264);let hh=0;for(let k=0;k<r.nm.length;k++)hh=(hh*31+r.nm.charCodeAt(k))%360;
    x.fillStyle='hsl('+hh+',55%,50%)';x.beginPath();x.arc(cx+155,cy+78,52,0,7);x.fill();x.fillStyle='#fff';x.font='700 56px system-ui,sans-serif';x.fillText((r.nm[0]||'?').toUpperCase(),cx+155,cy+98);
    x.font='700 30px system-ui,sans-serif';x.fillText(r.nm.slice(0,16),cx+155,cy+170);x.font='600 24px system-ui,sans-serif';x.fillStyle='#e8dcff';x.fillText('Sérieux '+r.im+' • Niv. '+r.lv,cx+155,cy+208);x.fillText('Bosseur '+r.sw+' • Branleur '+r.sb,cx+155,cy+240);});
  SHB.tex.needsUpdate=true;}
SHB=(function(){const cv=document.createElement('canvas');cv.width=1024;cv.height=360;const tex=ctex(cv);const m=new T.Mesh(new T.PlaneGeometry(6.4,2.25),new T.MeshBasicMaterial({map:tex,toneMapped:false}));m.position.set(26,3.75,-17.8);S.g.add(m);return {cv:cv,tex:tex};})();drawShame();
function endFault(e){e.tp=0;e.f=null;e.conf=0;e.press=0;e.sayP=0;e.nf=LK.sim?(5+Math.random()*10):(40+Math.random()*60);}
const PLG=[];let SHCD=0;
function pressLight(e,w){const base=e.f?2.2:1.2;if(e.f)endFault(e);e.pcd=50;e.press=0;e.sayP=0;e.noF=Math.max(e.noF||0,28);
  while(PLG.length&&clk-PLG[0]>120)PLG.shift();const k=PLG.length<5?1:.4;PLG.push(clk);RESULT=Math.min(100,RESULT+base*k*(w||1));addW(1);
  say(e.g,['Oui chef !','J\'y retourne !','Je m\'y remets !','Pardon, j\'y vais !'][(Math.random()*4)|0]);}
function sanctionE(e){
  if(!e.f){e.cd=6;return;}
  const need=e.f.sev>1?60:100,proof=e.conf>=need,tamp=TAMP>0&&!proof;
  const direct=proof||tamp||(e.warn||0)>=1;if(tamp)TAMP--;
  if(direct){if(proof)COMP=Math.min(100,COMP+2);e.warn=0;addBl(e);coins+=4+e.f.sev*2;RESULT=Math.min(100,RESULT+8);toast('BLÂME pour '+e.name+' ('+FK[e.f.k][1]+') : '+(proof?'faute prouvée':tamp?'tampon':'récidive')+'. +'+(4+e.f.sev*2)+', Résultats +8');}
  else{e.warn=1;coins+=2;RESULT=Math.min(100,RESULT+4);toast('Avertissement pour '+e.name+' : preuves insuffisantes ('+Math.round(e.conf)+' %). Récidive = blâme. Résultats +4');}
  addW(3);say(e.g,['Oui chef…','Pardon !','Ça ne se reproduira pas','C\'est injuste !'][(Math.random()*4)|0]);
  endFault(e);e.noF=45;e.cd=10;
  SANC.push(clk);while(SANC.length&&clk-SANC[0]>120)SANC.shift();
  if(SANC.length>=8){SANC.length=0;RESULT=Math.max(0,RESULT-8);toast('Les employés se plaignent de ton harcèlement : Résultats -8.');}}
/* ---------- v237/v238 : promotion par tirage (creneaux communs a tous les joueurs) ---------- */
const PRO={per:3.5*3600,min:1,keep:1e9,pn:0,pw:0,seen:{},lr:0,lmt:0,ms:0,grace:20*60,idle:480,sl:0,cd:-1,pv:null,psc:0,gr:0,ld:false,sv:0,tk:0,im:0,iw:0,lx:0,lz:0};
function proSlot(){return Math.floor(Date.now()/(PRO.per*1000));}
function proFmt(t){t=Math.max(0,Math.round(t));const h=Math.floor(t/3600),m=Math.floor(t%3600/60);return h>0?h+' h '+('0'+m).slice(-2):m+' min';}
function proLoad(){PRO.ld=true;PRO.sl=proSlot();try{const v=JSON.parse(localStorage.getItem(CK('edm_pro'))||'null');if(v){if(v.sl===PRO.sl){PRO.psc=v.psc||0;PRO.pn=v.pn||0;PRO.pw=v.pw||0;PRO.seen=v.seen&&typeof v.seen==='object'?v.seen:{};PRO.cd=typeof v.cd==='number'?v.cd:-1;}PRO.gr=v.gr||0;PRO.ms=v.ms||0;}}catch(_){}
  if(rank>=1&&PRO.ms&&Date.now()-PRO.ms>PRO.keep*1000)proBackEmp();}
function proSave(){if(!PRO.ld)return;try{if(rank>=1)PRO.ms=Date.now();localStorage.setItem(CK('edm_pro'),JSON.stringify({sl:PRO.sl,psc:PRO.psc,pn:PRO.pn,pw:PRO.pw,seen:PRO.seen,gr:PRO.gr,cd:PRO.cd,ms:rank>=1?PRO.ms:0}));}catch(_){}}
function addPS(n,raw){if(CREATING||rank>=1||!(n>0))return;const v=raw?n:n*PRO_CB;PRO.psc+=v;PRO.pn=(PRO.pn||0)+v;}
function proLose(n,why){if(CREATING||rank!==0||SEC||!(n>0))return;if(!PRO.ld)proLoad();const v=Math.min(PRO.psc||0,n);if(v<=0)return;PRO.psc-=v;PRO.pn=Math.max(0,(PRO.pn||0)-v);setTimeout(function(){toast('🏆 '+why+' : −'+Math.round(v)+' pts de promotion',1);},1300);}
function addPSW(n){if(CREATING||rank>=1||SEC||!(n>0))return;const v=Math.min(n*PRO_CW,Math.max(0,(PRO.pn||0)/3-(PRO.pw||0)));if(v>0){PRO.psc+=v;PRO.pw=(PRO.pw||0)+v;}}
const PRO_CB=2.5,PRO_CC=4,PRO_CW=1,PRO_CA=40;
function proOrd(r){return r===1?'1er':r+'e';}
function proHash(t){let h=2166136261;t=String(t);for(let i=0;i<t.length;i++){h^=t.charCodeAt(i);h=Math.imul(h,16777619);}return h>>>0;}
function proBeat(a,b,S){if(a.sc!==b.sc)return a.sc>b.sc;if(a.lv!==b.lv)return a.lv>b.lv;if(a.sb!==b.sb)return a.sb>b.sb;if(a.j!==b.j)return a.j<b.j;return proHash(a.id+':'+S)<proHash(b.id+':'+S);}
function proKeep(){if(!PRO.ld)proLoad();return rank>=1&&!!PRO.ms&&Date.now()-PRO.ms<PRO.keep*1000;}
function proBackEmp(){PRO.ms=0;PRO.cd=-1;PRO.gr=0;chRole('e',0);LK.role='e';try{applyLook(lookOpts(),PNAME);startRole('e');}catch(_){}SB=lvBase(LT.e.b,false);SW=lvBase(LT.e.w,false);proSave();try{saveGame();}catch(_){}pop('⬇ Absent plus de 7 h : tu redeviens employé','warn');toast('Tu n\'es pas revenu dans les 7 h : ton poste de manager est libéré. Tu retrouves ton niveau d\'employé, sans rien perdre, et tu participes au prochain tirage.');}
function proLeft(){return Math.max(0,(PRO.sl+1)*PRO.per-Date.now()/1000);}
function proGrace(){return rank>=1&&Date.now()<PRO.gr;}
function proMine(){return PRO.cd===PRO.sl?0:Math.round(PRO.psc);}
function proPeers(S){const L=[];if(!(NET.on&&NET.joined))return L;Object.keys(NET.players).forEach(function(pid){if(pid===NET.pid)return;const p=NET.players[pid];if(!p||!p.lk||p.lk.role==='m')return;
  const sc=p.sl===S?(p.ps||0):(p.sl===S+1?(p.pvs||0):0);L.push({id:pid,nm:p.nm||'Un joueur',sc:Math.round(sc),j:typeof p.joined==='number'?p.joined:1e15,lv:p.lv||1,sb:p.sb||0});});return L;}
function proRank(){if(!(NET.on&&NET.joined))return null;const me=proMine(),A={};Object.keys(PRO.seen||{}).forEach(function(k){A[k]=PRO.seen[k];});proPeers(PRO.sl).forEach(function(p){A[p.id]=p.sc;});
  let r=1,n=1;Object.keys(A).forEach(function(k){n++;if(A[k]>me)r++;});return {r:r,n:n};}
function proSeen(){if(!(NET.on&&NET.joined)||rank>=1)return;const ks=Object.keys(PRO.seen);proPeers(PRO.sl).forEach(function(p){if(PRO.seen[p.id]!==undefined||ks.length<300)PRO.seen[p.id]=Math.max(PRO.seen[p.id]||0,p.sc);});}
function proRankMsg(){if(rank!==0||SEC||CREATING)return;const k=proRank();if(!k||k.n<2||proMine()<=0)return;if(!PRO.lr){PRO.lr=k.r;return;}if(k.r===PRO.lr||Date.now()-(PRO.lmt||0)<30000)return;
  if(k.r<PRO.lr)pop('⬆️ Tu passes '+proOrd(k.r)+' au classement de promotion !','good');else pop('⬇️ Tu as été dépassé : tu es '+proOrd(k.r)+' sur '+k.n,'warn');PRO.lr=k.r;PRO.lmt=Date.now();}
function proDraw(S,sc){sc=Math.round(sc);if(SRV&&SRV.on){pop('🎲 Tirage de promotion : le résultat arrive dans quelques minutes.','warn');return false;}
  if(sc<1){pop('🎲 Tirage de promotion : tu n\'as marqué aucun point pendant la période. Pas de promotion cette fois.','warn');toast('Prochain tirage dans '+proFmt(proLeft())+'. Marque des points de branleur et fais des crasses aux managers.');return false;}
  const net=NET.on&&NET.joined;
  if(net){const me0=NET.players[NET.pid]||{},me={id:NET.pid,nm:PNAME,sc:sc,lv:Math.max(LVL,LVM),sb:Math.round(SB),j:typeof me0.joined==='number'?me0.joined:1e15};let best=null;
    proPeers(S).filter(function(p){return p.sc>=1;}).forEach(function(p){if(!best||proBeat(p,best,S))best=p;});
    if(best&&proBeat(best,me,S)){pop('🎲 Tirage de promotion : '+best.nm+' l\'emporte ('+best.sc+' pts contre tes '+sc+(best.sc===sc?', départagés à égalité':'')+').','warn');toast('Prochain tirage dans '+proFmt(proLeft())+'.');return false;}}
  if(!mgrSlotOK()){toast('🎲 Tirage de promotion : tous les postes de manager joueurs sont pris. Réessaie au prochain tirage.');return false;}
  if(!net){const L=MGR.filter(function(m){return !m.fired;}).sort(function(a,b){return a.stand-b.stand;});if(!L.length){toast('🎲 Tirage de promotion : aucun manager à remplacer pour le moment.');return false;}
    const m=L[0];m.stand=0;drawM(m);releaseTask(m);m.fired=true;m.g.visible=m.gs.visible=m.gp.visible=m.gi.visible=false;m.respawn=-1;mgrToEmp(m);
    promote(m.name,' cède son poste (tirage de promotion, '+sc+' pts)');}
  else promote('Un manager PNJ',' cède son poste (tirage de promotion, '+sc+' pts)');
  pop('🎉 Tu es promu manager !','good');return true;}
function proRoll(){const S=PRO.sl,sc=PRO.cd===S?0:PRO.psc;PRO.pv={sl:S,sc:Math.round(sc)};PRO.sl=proSlot();PRO.psc=0;PRO.pn=0;PRO.pw=0;PRO.seen={};PRO.lr=0;proSave();if(rank>=1)return;proDraw(S,sc);}
function proIdle(dt){if(!(rank>=1&&NET.on&&NET.joined)){PRO.im=0;PRO.iw=0;return;}
  const mv=Math.hypot(pp.x-PRO.lx,pp.z-PRO.lz)>.05||keys.size>0||uiOpen||!!act||Math.abs(stick.x)+Math.abs(stick.y)>.1;PRO.lx=pp.x;PRO.lz=pp.z;
  if(mv){PRO.im=0;PRO.iw=0;return;}PRO.im+=dt;
  if(PRO.im>=PRO.idle-120&&!PRO.iw){PRO.iw=1;toast('⚠ Tu es inactif : tu perds ton poste de manager dans 2 min si tu ne bouges pas.');}
  if(PRO.im>=PRO.idle){PRO.im=0;PRO.iw=0;demote();toast('Tu as perdu ton poste de manager : trop longtemps inactif.');}}
function proTick(dt){if(CREATING)return;if(!PRO.ld)proLoad();proIdle(dt);PRO.tk-=dt;if(PRO.tk>0)return;PRO.tk=5;
  if(PRO.sl!==proSlot()){if(mode==='zone'&&!uiOpen)proRoll();else if(rank>=1){PRO.sl=proSlot();}return;}
  if(Date.now()-PRO.sv>15000){PRO.sv=Date.now();proSave();}proSeen();proRankMsg();try{cseDaily();seasonApply();absCheck();}catch(_){}}

/* ---------- v239 : obligations imposees aux managers ---------- */
const MOBC={chariot:{n:'Chariot renversé',rep:8,ps:12},rack:{n:'Rack tombé',rep:12,bl:1,ps:18},aud:{n:'Audit hygiène (périmés)',rep:12,bl:1,ps:20},elev:{n:'Ascenseur du Drive bloqué',rep:10,ps:15},alarm:{n:'Alarme du magasin',rep:12,bl:1,ps:30}};
const MOB={l:[],cd:0,uid:0,pad:'',lock:0,T:60};
function mobAlarm(){return MOB.l.find(function(e){return e.k==='alarm'&&!e.mine;})||null;}
function mobById(id){return MOB.l.find(function(e){return e.id===id;})||null;}
function mobCodeGen(){let s='';for(let i=0;i<4;i++)s+=((Math.random()*10)|0);return s;}
function mobRm(e){try{if(e.mk){const zz=Z[e.zn];if(zz){zz.g.remove(e.mk.g);const q=zz.markers.indexOf(e.mk);if(q>=0)zz.markers.splice(q,1);}e.mk=null;}}catch(_){}const i=MOB.l.indexOf(e);if(i>=0)MOB.l.splice(i,1);}
function mobClear(){MOB.l.slice().forEach(mobRm);MOB.pad='';if(PRI&&PRI.d&&PRI.d.mob){PRI=null;PRT=30;}}
function mobMk(e){if(e.k==='chariot'||e.k==='rack'||e.k==='aud'){const zz=Z[e.zn];if(!zz)return;try{e.mk=marker(zz,'mobfix',e.x,e.z,'Résoudre : '+MOBC[e.k].n);e.mk.me=e.id;}catch(_){}}}
function mobNet(ev,p){try{if(NET.on&&NET.joined&&NET.sb){p.from=NET.pid;netSbBroadcast(ev,p);}}catch(_){}}
function mobStart(k,x,z,zn,ref,force){if(CREATING||rank!==0||SEC||!MOBC[k])return false;if(!force&&MOB.cd>0){toast('Obligation pour les managers déjà lancée il y a peu : celle-ci ne leur impose rien.');return false;}
  const e={id:'o'+(++MOB.uid)+'_'+String(NET.pid||'x').slice(0,8),k:k,x:x,z:z,zn:zn,t:MOB.T,mine:1,done:0,ms:ref&&ref.ms||null,ri:ref&&typeof ref.ri==='number'?ref.ri:-1,code:k==='alarm'?mobCodeGen():'',p:{t:20+Math.random()*20,ok:Math.random()<.7,did:0}};
  MOB.l.push(e);if(!force)MOB.cd=120;
  mobNet('mob',{id:e.id,k:k,x:+(+x).toFixed(2),z:+(+z).toFixed(2),zn:zn,ri:e.ri,code:e.code});
  toast('⏱ '+MOBC[k].n+' : les managers ont '+MOB.T+' s pour réagir. S\'ils ratent : +'+Math.round(MOBC[k].ps*PRO_CB)+' points de promotion pour toi.');return true;}
function mobRecv(d){try{if(!d||d.from===NET.pid||rank<1||typeof d.id!=='string'||!MOBC[d.k])return;if(mobById(d.id))return;const zn=Z[d.zn]?d.zn:'store';
  const e={id:d.id.slice(0,24),k:d.k,x:+d.x||0,z:+d.z||0,zn:zn,t:MOB.T,mine:0,done:0,ms:null,ri:d.ri|0,code:String(d.code||'').replace(/\D/g,'').slice(0,4),p:null};
  if(e.k==='elev'&&!(ELEV.t>0))ELEV.t=9999;MOB.l.push(e);mobMk(e);pop('⏱ '+MOBC[e.k].n+' : '+MOB.T+' s !','warn');toast('Obligation : '+MOBC[e.k].n+'. Ouvre la carte : l\'étoile montre où aller.');}catch(_){}}
function mobEndRecv(d){try{if(!d||d.from===NET.pid||typeof d.id!=='string')return;const e=mobById(d.id);if(!e)return;if(e.k==='elev'&&rank>=1)ELEV.t=0;mobEnd(e,String(d.by||'Un manager').slice(0,20),true);}catch(_){}}
function mobEnd(e,by,remote){mobRm(e);if(remote){if(e.mine)toast('✅ '+by+' a réagi à temps : '+MOBC[e.k].n+' est réglé.');else if(rank>=1)toast('✅ '+by+' a réglé : '+MOBC[e.k].n+'.');}}
function mobSolve(e,by){if(e.done)return;e.done=1;mobNet('mobend',{id:e.id,by:String(by||PNAME||'Un manager').slice(0,20)});if(!e.mine&&rank>=1){RESULT=Math.min(100,RESULT+3);coins+=8;addW(3);}mobRm(e);}
function mobPnj(e){if(e.k==='chariot'){const q=MESS.indexOf(e.ms);if(q>=0){MESS.splice(q,1);try{S.g.remove(e.ms.g);}catch(_){}}}
  else if(e.k==='rack'){const r=RACKS[e.ri];if(r&&r.st!=='up'&&r.st!=='rise'){r.st='rise';r.f=1;}}
  else if(e.k==='elev'){ELEV.t=0;}
  else if(e.k==='aud'){for(let i=JOBS.length-1;i>=0;i--){const j=JOBS[i];if(j.kind==='perime'){try{if(j.claimed)releaseTask(j.claimed);}catch(_){}if(j.mesh)S.g.remove(j.mesh);JOBS.splice(i,1);}}}
  mobSolve(e,'Un manager PNJ');toast('✅ Un manager PNJ a réagi à temps : '+MOBC[e.k].n+'.');}
function mobWorld(e){if(e.t<2)return false;if(e.k==='chariot')return !!e.ms&&MESS.indexOf(e.ms)<0;if(e.k==='rack'){const r=RACKS[e.ri];return !!r&&(r.st==='rise'||r.st==='up');}if(e.k==='elev')return !(ELEV.t>0);if(e.k==='aud')return !JOBS.some(function(j){return j.kind==='perime';});return false;}
function alarmRing(mine){if(ALM.t>0)return;if(mine)startAlarm();else{ALM.t=25;ALM.cd=Math.max(ALM.cd,240);$('alarmFx').classList.add('on');pop('🚨 ALARME INCENDIE !','warn');}}
function alarmArm(m){AQ=0;SABN=0;SAKEYS=[];PNK=0;ALM.cd=240;if(!mobStart('alarm',m.x,m.z,cur,{},true)){startAlarm();return;}pop('🔔 Alarme armée : elle sonne dans '+MOB.T+' s !','warn');}
function mobFail(e){mobRm(e);const c=MOBC[e.k];
  if(e.mine){addPS(c.ps);toast('⏱ '+c.n+' : aucun manager n\'a réagi à temps ! +'+Math.round(c.ps*PRO_CB)+' points de promotion.');
    const L=MGR.filter(function(m){return !m.fired&&m.zn==='store';});if(L.length)hitMgr(L[(Math.random()*L.length)|0],c.rep*2,'mob');
    if(e.k==='alarm'){alarmRing(true);mobNet('mobring',{});}}
  else{COMP=Math.max(0,COMP-c.rep);if(c.bl)RESULT=Math.max(0,RESULT-10);toast('⏱ '+c.n+' non réglé : réputation −'+c.rep+(c.bl?', blâme (résultats −10)':'')+'.');pop('⏱ '+c.n+' : raté !','bad');if(e.k==='alarm')alarmRing(false);}}
function mobFixOK(m){return !!m.me&&!!mobById(m.me);}
function mobFix(m){const e=mobById(m.me);if(!e)return;
  if(e.k==='chariot'){if(e.ms){const q=MESS.indexOf(e.ms);if(q>=0)MESS.splice(q,1);try{S.g.remove(e.ms.g);}catch(_){}}mobSolve(e,PNAME);pop('✅ Chariot rangé','good');}
  else if(e.k==='rack'){const r=RACKS[e.ri];if(r&&r.st!=='up'&&r.st!=='rise'){r.st='rise';r.f=1;}mobSolve(e,PNAME);pop('✅ Rack relevé','good');}
  else if(e.k==='aud'){const j=JOBS.find(function(x){return x.kind==='perime';});if(j){try{if(j.claimed)releaseTask(j.claimed);}catch(_){}if(j.mesh)S.g.remove(j.mesh);JOBS.splice(JOBS.indexOf(j),1);}
    const n=JOBS.find(function(x){return x.kind==='perime';});if(n&&e.mk){e.x=n.x;e.z=n.z;e.mk.x=n.x;e.mk.z=n.z;e.mk.g.position.set(n.x,0,n.z);toast('Il reste des périmés : va au prochain rond.');}else{mobSolve(e,PNAME);pop('✅ Périmés retirés','good');}}}
function mobShowCode(){const e=mobAlarm();if(!e)return;MOB.seen=e.id;dlg('🔐 Code de l\'alarme','',[{t:'J\'ai retenu le code'}]);$('bribeT').innerHTML='<div style="font:700 64px monospace;letter-spacing:12px;text-align:center">'+e.code+'</div>';
  setTimeout(function(){try{if(!$('bribe').hidden&&$('bribeT').innerHTML.indexOf(e.code)>=0&&$('bribeT').innerHTML.indexOf('monospace')>=0)closeDlg();}catch(_){}},7000);}
function mobPad(){const e=mobAlarm();if(!e)return;if(MOB.lock>0){toast('Clavier bloqué : '+Math.ceil(MOB.lock)+' s.');return;}
  const b=[];'123456789'.split('').forEach(function(d){b.push({t:d,f:function(){mobKey(d);}});});b.push({t:'⌫',f:function(){MOB.pad=MOB.pad.slice(0,-1);mobPad();}});b.push({t:'0',f:function(){mobKey('0');}});b.push({t:'OK',f:function(){mobSubmit();}});b.push({t:'Annuler'});
  dlg('🚨 Alarme du magasin','Tape le code ('+Math.max(0,Math.ceil(e.t))+' s) :  '+(MOB.pad+'____').slice(0,4).split('').join(' '),b);try{const bb=$('bribeB');bb.style.display='grid';bb.style.gridTemplateColumns='repeat(3,1fr)';}catch(_){}}
function mobKey(d){if(MOB.pad.length<4)MOB.pad+=d;mobPad();}
function mobSubmit(){const e=mobAlarm();if(!e)return;if(MOB.pad===e.code){MOB.pad='';mobSolve(e,PNAME);pop('✅ Alarme désamorcée !','good');}else{MOB.pad='';MOB.lock=3;toast('Code faux : clavier bloqué 3 s.');}}
function mobSync(){if(rank<1||SEC){return;}const e=MOB.l.find(function(x){return !x.mine;});if(!e){if(PRI&&PRI.d&&PRI.d.mob){PRI=null;PRT=30;}return;}
  const al=mobAlarm(),it=al||e,ids=it.k==='alarm'?(MOB.seen===it.id?['mobbox']:['mobcode']):it.k==='elev'?['repasc']:['mobfix'];
  const tx=it.k==='alarm'?(MOB.seen===it.id?'Tape le code à l\'alarme du magasin':'Va chercher le code chez la directrice'):MOBC[it.k].n;
  if(!PRI||!PRI.d||!PRI.d.mob)PRI={d:{ids:ids,txt:tx,coins:0,n:1,mob:1},c:0,r:'m'};else{PRI.d.ids=ids;PRI.d.txt=tx+' ('+Math.max(0,Math.ceil(it.t))+' s)';}}
function mobTick(dt){if(CREATING)return;MOB.cd=Math.max(0,MOB.cd-dt);MOB.lock=Math.max(0,MOB.lock-dt);
  for(let i=MOB.l.length-1;i>=0;i--){const e=MOB.l[i];if(!e)continue;e.t-=dt;
    if(e.mine){if(mobWorld(e)){mobRm(e);toast('✅ Un manager a réagi à temps : '+MOBC[e.k].n+' est réglé.');continue;}
      if(e.p&&!e.p.did){e.p.t-=dt;if(e.p.t<=0){e.p.did=1;if(e.p.ok){mobPnj(e);continue;}}}}
    if(e.t<=0)mobFail(e);}
  mobSync();}

function demote(){LT.e.b=1;LT.e.w=1;lvSync();chRole('e',0);PRO.gr=0;PRO.psc=0;PRO.pn=0;PRO.pw=0;PRO.lr=0;PRO.cd=proSlot();PRO.sl=proSlot();proSave();SB=lvBase(1,false);SW=lvBase(1,false);saveGame();toast('La directrice te vire de ton poste : tu retombes tout en bas. Niveau 1 employé, points à 0. Tu gardes tes pièces et tes objets (verrouillés tant que ton niveau est trop bas).');if(MG)closeMail();LK.role='e';applyLook(lookOpts(),PNAME);startRole('e');image=Math.max(10,image-25);pop('⬇ Tu redeviens employé niveau 1','bad');toast('Tu ne peux pas être promu au prochain tirage (dans '+proFmt(proLeft())+'), seulement au suivant.');}
function mgrUpdate(dt){
  if(rank<1){$('rdr').hidden=true;if(mcone.grp.visible)mcone.grp.visible=false;bubbleH.visible=false;MFR.off=MOU.off=true;$('bMsg').hidden=mode!=='zone'||!!CINE;$('bMsgN').hidden=true;$('bMsg').classList.remove('ring');lightFaults(dt);return;}
  $('bMsg').hidden=mode!=='zone';{const un=MSG.filter(function(m){return !m.read;}).length;$('bMsgN').textContent=un;$('bMsgN').hidden=!un;$('bMsg').classList.toggle('ring',un>0&&!PHN);}
  if(DEN){DEN.t-=dt;if(DEN.t<=0){const by=DEN.by;DEN=null;if(D.rage<=0&&!D.inv){toast(by+' t\'a dénoncé à la directrice ! Elle arrive : fais bonne figure…');D.inv={t:35,rp:0};if(D.zn!==cur){setDZone(cur);D.x=Z[cur].spawn.x;D.z=Z[cur].spawn.z;}D.stun=0;D.wait=0;D.path=null;}}}
  if(D.inv){D.inv.t-=dt;if(D.zn===cur&&D.stun<=0){D.inv.rp-=dt;if(D.inv.rp<=0){D.inv.rp=1.2;D.path=path(Z[cur],D.x,D.z,pp.x,pp.z);D.pi=0;D.wait=0;}}else if(D.zn!==cur){setDZone(cur);D.x=Z[cur].spawn.x;D.z=Z[cur].spawn.z;D.path=null;D.wait=0;}
    if(D.zn===cur&&Math.hypot(D.x-pp.x,D.z-pp.z)<3.2&&mode==='zone'){const caught=clk-LASTSLACK<12||(act&&act.cat==='rest');D.inv=null;D.wait=3;D.path=null;say(dirc,caught?'Je vous y prends !':'Hmm… je vous ai à l\'œil.');if(caught&&SEC&&LOOT.length){fireV('la directrice');}else if(caught){giveBlame('la directrice te surprend à glander !',3);}else toast('La directrice ne trouve rien : fausse alerte.');}
    else if(D.inv.t<=0){D.inv=null;toast('La directrice abandonne ses recherches.');}}
  if(SHCD>0)SHCD-=dt;if(JUM>0)JUM-=dt;if(NOTE>0)NOTE-=dt;if(PLB.t>0)PLB.t-=dt;if(PLCD>0)PLCD-=dt;
  
  let nf=0;let PRP=null;{let pd=4.7;EMP.forEach(function(e){if(e.out>0||e.zn!==cur||mode!=='zone')return;const d=Math.hypot(pp.x-e.x,pp.z-e.z);if(d<pd){pd=d;PRP=e;}});}
  EMP.forEach(function(e){
    if(e.out>0){e.out-=dt;e.g.visible=false;e.seen=false;if(e.f)endFault(e);e.noF=99;if(e.out<=0){e.out=0;e.noF=20;e.bl=0;e.warn=0;e.g.visible=true;toast('Un nouvel employé prend le poste de '+e.name+'.');}return;}
    if(e.loot>0)e.loot-=dt;
    e.blAge=(e.blAge||0)+dt;e.blT=e.blT||[];{const cp=blKeep(e.blT,e.bl||0,e.blAge,dt);if((e.bl||0)>cp)e.bl=cp;}if(e.wn>0){e.wnT=(e.wnT||0)+dt;if(e.wnT>=180)e.wn=0;}
    if(e.cd>0){}if(e.pcd>0)e.pcd-=dt;if(e.noF>0)e.noF-=dt;if(e.flag>0)e.flag-=dt;if(e.spy>0)e.spy-=dt;if(e.cvcd>0)e.cvcd-=dt;
    const inC=inConeE(e);e.seen=inC;const hd=e.g.rotation.y,dxp=pp.x-e.x,dzp=pp.z-e.z,dp=Math.hypot(dxp,dzp),beh=dp>.2&&(Math.sin(hd)*dxp+Math.cos(hd)*dzp)/dp<-.3;
    const near=inC&&HID<=0&&dp<6&&!beh;
    if(mode==='zone'&&e.zn===cur&&!e.help&&!e.chore&&!(e.ot>0)&&!(e.pcd>0)&&!(e.wi&&e.wi.visible)&&e===PRP&&(e.f?(beh?dp<4.6:dp<3.4):dp<3.2)&&(dp<2.4||!blocked(Z[cur],pp.x,pp.z,e.x,e.z))){e.press=Math.min(100,(e.press||0)+dt*(e.f?(beh?(inC?40:30):24):(beh?34:26)));if(e.press>40&&!e.sayP){e.sayP=1;say(e.g,['Pitié…','Je suis sur le point de m\'y mettre !','Il est derrière moi ?','Oh non, le manager…'][(Math.random()*4)|0]);}
      if(e.press>=100){e.press=0;e.sayP=0;if(e.f)sanctionE(e);else pressLight(e);return;}}
    else e.press=Math.max(0,(e.press||0)-dt*12);
    if(e.f){nf++;if(NOTE>0)e.f.t=0;e.f.t-=dt*(near?4:1)*(e.press>0?.3:1);
      const inT=tcSees(e);if(inT&&!e.tp&&e.conf>=40){e.tp=1;pushMsg({theft:!!(e.f&&e.f.k==='vol'),from:'Caméra',kind:'e',e:e,zn:e.zn,txt:e.name+' est filmé en pleine faute '+ZNAME[e.zn]+'.'});}
      if(inC||inT||e.spy>0)e.conf=Math.min(100,e.conf+dt*(HID>0?32:22));else e.conf=Math.max(0,e.conf-dt*3);
      if(e.flag>0)e.conf=Math.max(e.conf,70);
      if(e.f.t<=0)endFault(e);}
    else{e.conf=Math.max(0,e.conf-dt*10);
      if(e.nf===undefined)e.nf=8+Math.random()*50;
      if(!e.help&&!(e.noF>0)&&NOTE<=0&&!(e.tk&&e.tk.ph==='do')){e.nf-=dt*rateMult(e);if(e.nf<=0){if(near)e.nf=3;else startFault(e);}}}
    if(e.f&&e.f.k!=='vol'&&(inC||e.flag>0||e.spy>0||e.press>0||tcSees(e)||(e.zn===cur&&mode==='zone'&&dp<16))){if(!e.fb){e.fb=dynLabel(400,72,3.9,.7);e.fb.sp.position.set(0,3.5,0);e.g.add(e.fb.sp);}
      const need=e.f.sev>1?60:100;e.fb.draw(FK[e.f.k][0]+' '+FK[e.f.k][1]+((inC||e.flag>0||e.spy>0||e.press>0||tcSees(e))?' • preuve '+Math.round(e.conf)+'%':'')+(e.press>1?' • pression '+Math.round(e.press)+'%':''),e.conf>=need?'rgba(214,40,57,.96)':'rgba(214,120,20,.96)');e.fb.sp.visible=true;}
    else if(e.press>1){if(!e.fb){e.fb=dynLabel(400,72,3.9,.7);e.fb.sp.position.set(0,3.5,0);e.g.add(e.fb.sp);}e.fb.draw('👀 Pression '+Math.round(e.press)+'%','rgba(214,120,20,.96)');e.fb.sp.visible=true;}
    else if(e.fb)e.fb.sp.visible=false;});
  let sup=0;EMP.forEach(function(e){if(e.seen&&!e.f&&sup<3)sup++;});
  let camSup=0;TCAMS.forEach(function(c){if(EMP.some(function(e){return !(e.out>0)&&!e.f&&e.zn===c.zn&&camSees(c,e);}))camSup++;});camSup=Math.min(3,camSup);
  RESULT=clamp(RESULT+dt*(.045+sup*.14+camSup*.06-.013*Math.min(nf,7)*(LK.sim?.5:1)),LK.sim?15:0,100);
  if(CONVCD>0)CONVCD-=dt;if(CAMCD>0)CAMCD-=dt;RPAY+=dt;if(RPAY>=120){RPAY=0;if(mode==='zone')coins+=Math.round(RESULT/25);}
  if(CONV){CONV.t-=dt;if(CONV.t<=0){CONV=null;D.wait=0;setDZone('store');D.x=14;D.z=12.6;D.path=null;toast('La directrice te laisse repartir : « Dernier avertissement. »');}}
  else{if(RESULT<30&&!LK.sim){LOWT+=dt;if(LOWT>90&&CONVCD<=0){LOWT=0;startConv();}}else LOWT=0;}
  if(COMP<=0){if(proGrace()){COMP=1;}else{demote();return;}}
  if(COMP<=25&&!lowC){lowC=true;toast('Ta réputation est à '+Math.round(COMP)+' % : un employé peut te faire tomber !');}else if(COMP>40)lowC=false;
  {const mv=Math.hypot(pp.x-ppx,pp.z-ppz);ppx=pp.x;ppz=pp.z;if(mv<.02&&!act&&(!uiOpen||PHN)&&HID<=0&&mode==='zone'&&!CONV&&!WCIN)mIdle+=dt;else mIdle=0;if(mIdle>25&&!uiOpen){mIdle=0;mgrSlack();}}
  tcUpdate(dt);radarTick(dt);vigDenTick(dt);cabTick(dt);
  {let ch=false;for(let i=MSG.length-1;i>=0;i--){if(clk-MSG[i].t>MSG[i].life){MSG.splice(i,1);ch=true;}}if(ch&&PHN==='msg')renderPhone();else if(ch)renderQI&&0;}
  if(MG&&MG.step==='mcam'&&!$('mail').hidden){CAMT+=dt;RESULT=Math.min(100,RESULT+dt*(FBOX.some(function(q){return q.e.f;})?1.2:.4));if(CAMT>=50){CAMCD=60;CAMT=0;MG={step:'mh'};renderMail();toast('Temps de visionnage écoulé : caméras indisponibles 60 s.');}}
  if(RESULT<30&&!lowW){lowW=true;toast('La directrice : « Tes résultats sont inquiétants. Fais quelque chose ! »');}else if(RESULT>50)lowW=false;
  if(RESULT<=0&&LK.sim)RESULT=15;
  if(WC.busy)WCOCC+=dt;else WCOCC=0;
  MFR.off=MOU.off=!WC.busy||cur!=='office';
  mcone.grp.visible=mode==='zone'&&!uiOpen;mcone.grp.position.set(pp.x,0,pp.z);mcone.grp.rotation.y=pp.face;mcone.grp.scale.setScalar(coneR()/9);mcone.mat.color.setHex(HID>0?0x5ee07a:0x6ee7ff);
  bubbleH.visible=HID>0&&mode==='zone';bubbleH.position.set(pp.x,2.95,pp.z);
  choreTick(dt);mgrFeed(dt);}
let FZT=200;
function choreTick(dt){if(!globalThis.__noplot&&!VIGI&&!FR.on&&!CINE&&mode==='zone'&&cur==='store'){FZT-=dt;if(FZT<=0){FZT=300+Math.random()*240;startFridgeMgr();}}
  EMP.forEach(function(e){if(e.out>0)return;
  if(e.ot>0){e.ot-=dt;RESULT=Math.min(100,RESULT+dt*.08);empS(e);if(e.ot<=0){e.ot=0;e.sw=Math.min(100,e.sw+10);coins+=3;toast(e.name+' a fini ses heures forcées : +3 pièces.');}}
  if(e.chore){e.chore.t-=dt;if(e.chore.t<=0){const k=e.chore.k;e.chore=null;if(k==='cart'){CART.n=Math.min(CART.max,CART.n+8);cartSend();}if(k==='wc'){CW.dirt=0;WCDIRT[0]=WCDIRT[1]=0;CAB.forEach(function(c){c.dirt.visible=false;});}if(Math.random()<.72){RESULT=Math.min(100,RESULT+4);coins+=3;empS(e);e.sw=Math.min(100,e.sw+8);if(k==='serp'&&MESS.length){const o=MESS.shift();S.g.remove(o.g);}toast(e.name+' a fait sa corvée : Résultats +4, +3 pièces.');}
    else{addBl(e);toast(e.name+' a refusé la corvée : blâme, image à 0 !');say(e.g,'Non mais ça va pas ?!');}}}});}
function useMItem(id){
  if(id==='jumelles'){JUM=25;INV.jumelles--;toast('Jumelles : portée du radar doublée pendant 25 s.');}
  else if(id==='micro'){let b=null,bd=9;EMP.forEach(function(e){if(e.zn!==cur)return;const d=Math.hypot(e.x-pp.x,e.z-pp.z);if(d<bd){bd=d;b=e;}});if(!b){toast('Aucun employé à moins de 9 m.');return;}b.spy=60;INV.micro--;toast('Micro-espion posé sur '+b.name+' (60 s) : sa jauge se remplit tant qu\'il fait une faute.');}
  else if(id==='tampon'){TAMP++;INV.tampon--;toast('Tampon prêt : ta prochaine sanction sera un blâme direct.');}
  else if(id==='note'){NOTE=25;RESULT=Math.min(100,RESULT+6);INV.note--;toast('Note de service : tout le monde se remet au travail 25 s. Résultats +6');}
  else if(id==='sifflet'){let n=0;EMP.forEach(function(e){if(e.zn===cur&&e.f&&Math.hypot(e.x-pp.x,e.z-pp.z)<9){endFault(e);e.noF=25;n++;}});if(!n){toast('Personne ne fait de faute à moins de 9 m.');return;}RESULT=Math.min(100,RESULT+1.5*Math.min(n,4));INV.sifflet--;toast('Coup de sifflet : '+n+' employé'+(n>1?'s':'')+' se remet'+(n>1?'tent':'')+' au travail. Résultats +'+(1.5*Math.min(n,4)));}
  renderQI();}

let DEN=null,LASTSLACK=-99;
let NPCMSG=-99;
function pushMsg(o){if(SEC&&!o.theft)return;if(!o.real&&!globalThis.__nomsgcd){const gap=o.theft?25:70;if(clk-NPCMSG<gap)return;NPCMSG=clk;}o.t=clk;o.life=o.life||30;o.seen=false;o.read=false;MSG.unshift(o);if(MSG.length>8)MSG.pop();try{if(navigator.vibrate)navigator.vibrate([120,60,120]);}catch(_){}if(rank>=1)beep(1400,.09,.05);}
function mgrSlack(){if(rank<1)return;LASTSLACK=clk;if(DEN||D.inv)return;const w=EMP.find(function(e){return e.zn===cur&&!e.f&&Math.hypot(e.x-pp.x,e.z-pp.z)<9;});if(w&&Math.random()<.85)DEN={t:6+Math.random()*6,by:w.name};}
function denounceM(m){if(m.fired)return;m.dnT=clk;hitMgr(m,rank<1?10:8);say(m.g,'Quoi ?! Qui a balancé ?');
  if(rank<1){coins+=3;image=Math.min(100,image+6);addB(2);toast('Tu dénonces '+m.name+' qui glandait : -10 de réputation pour lui. +3, Sérieux +6, +2 branleur');}
  else{coins+=3;RESULT=Math.min(100,RESULT+2);addW(3);toast('Tu dénonces '+m.name+' à la directrice : +3, Résultats +2, +3 bosseur');}}
function fouilleE(e){e.cd=12;
  if(e.loot>0){gradeXp();e.loot=0;if(e.f)endFault(e);addBl(e);e.noF=40;say(e.g,'Zut…');say(pl,'Je t\'ai attrapé, petit saligaud !');coins+=15;RESULT=Math.min(100,RESULT+6);COMP=Math.min(100,COMP+2);addW(8);image=Math.min(100,image+4);dogProof(e);pop('🚨 Attrapé ! '+e.name+' avait du butin : blâme. +15 🪙','good');toast('Fouille réussie sur '+e.name+' : +15 pièces, +8 bosseur, Sérieux +4.');}
  else{say(e.g,'Hé !');say(pl,'Oups, désolé, je me suis trompé.');pop('🙈 '+e.name+' n\'avait rien sur lui (aucune sanction pour toi).','warn');}}
function fouilleM(m){m.fcd=12;
  if(m.loot){gradeXp();m.loot=null;hitMgr(m,22);coins+=25;addW(12);image=Math.min(100,image+8);RESULT=Math.min(100,RESULT+4);say(m.g,'Mais… c\'est pas à moi !');say(pl,'Je t\'ai attrapé, petit saligaud !');dogProof(m);pop('🚨 Attrapé ! '+m.name+' cachait un objet volé : blâme. +25 🪙','good');toast('Fouille réussie sur le manager '+m.name+' : +25 pièces, +12 bosseur, Sérieux +8.');}
  else{say(m.g,'Hé !');say(pl,'Oups, désolé, je me suis trompé.');pop('🙈 '+m.name+' n\'avait rien sur lui (aucune sanction pour toi).','warn');}}
let RDR={t:0};
let SNDON=true;
let PAYD=null;
let DEBT=0,DEBPER=0;
function theftFine(v){if(!(v>0)||PIMM>0)return;const pay=Math.min(coins,v);coins-=pay;DEBT+=v-pay;if(v>pay){DEBPER=Math.max(DEBPER,Math.min(4,Math.ceil(DEBT/2)));try{giveBlame('tu n\'as pas de quoi payer l\'objet volé !',0);}catch(_){}}toast('💸 Amende pour vol : −'+pay+' 🪙'+(v>pay?' ; '+(v-pay)+' retenue'+((v-pay)>1?'s':'')+' sur ton salaire.':'.'));}
function policePenalty(price){const fine=Math.max(10,Math.round(price*1.5));theftFine(price+fine);return fine;}
function payTick(){const d=Math.floor((mins-1080)/1440);if(PAYD===null){PAYD=d;return;}if(d>PAYD){PAYD=d;if(mode!=='zone')return;const w=STRK.t>0?0:(rank<1?(SEC?4:2):3),ret=Math.min(DEBT,w,DEBPER>0?DEBPER:w);DEBT-=ret;if(DEBT<=0)DEBPER=0;coins+=w-ret;pop('💶 Paie du jour : +'+w+' 🪙'+(ret?' (−'+ret+' retenu pour vol)':''),ret?'bad':'good');toast('Salaire de fin de journée : +'+w+' pièces'+(ret?', mais −'+ret+' retenu'+(ret>1?'s':'')+' sur ton salaire pour vol (reste '+DEBT+').':'.'));}}
const SON=new T.Group(),SONR=[];
for(let i=0;i<3;i++){const m=new T.Mesh(new T.RingGeometry(.93,1,40,1,-Math.PI/2-.85,1.7),new T.MeshBasicMaterial({color:0x4aa3ff,transparent:true,opacity:0,side:T.DoubleSide,depthWrite:false}));m.rotation.x=-Math.PI/2;m.position.y=.09;SON.add(m);SONR.push(m);}
SON.visible=false;scene.add(SON);let SONP=0;
function sonarTick(dt,lv,mute,col){if(!(lv>0)||mode!=='zone'){SON.visible=false;return;}
  SON.visible=true;SON.position.set(pp.x,0,pp.z);SON.rotation.y=pp.face;SONP=(SONP+dt*(.6+2.4*lv))%1;
  const c=new T.Color(col);
  SONR.forEach(function(m,i){const p=(SONP+i/3)%1;m.scale.setScalar(1.2+p*(3+3*lv));m.material.color.copy(c);m.material.opacity=Math.min(1,(1-p)*(.3+.7*lv)*(mute?1.3:1));});}
(function(){$('bSnd').addEventListener('click',function(){SNDON=!SNDON;this.textContent=SNDON?'🔊':'🔇';});})();
const _beep0=beep;beep=function(f,d,v){if(SNDON)_beep0(f,d,v);};
function radarTick(dt){const bar=$('rdr'),gl=$('rglow'),sb=$('bSnd');if(!VIGI||rank<1){bar.hidden=true;sb.hidden=true;gl.style.opacity=0;sonarTick(dt,0);return;}bar.hidden=false;sb.hidden=false;
  let bd=99,bt=null;EMP.forEach(function(e){if(e.zn!==cur||e.out>0||!(e.loot>0)||e.hide>0)return;const d=Math.hypot(e.x-pp.x,e.z-pp.z);if(d<bd){bd=d;bt=e;}});MGR.forEach(function(m){if(m.zn!==cur||m.fired||!m.loot)return;const d=Math.hypot(m.x-pp.x,m.z-pp.z);if(d<bd){bd=d;bt=m;}});
  const R=9+2*GRADE,mute=!SNDON;
  if(bd<R&&mode==='zone'&&!uiOpen){const lv=1-bd/R;bar.firstElementChild.firstElementChild.style.width=Math.round(lv*100)+'%';
    const col=lv<.4?'#4aa3ff':lv<.75?'#ff9a2e':'#ff3b3b';bar.style.setProperty('--rc',col);gl.style.setProperty('--rc',col);
    RDR.t-=dt;const per=.1+(bd/R)*.9;
    if(RDR.t<=0){RDR.t=per;beep(600+lv*700,.07,.06);RDR.p=1;}
    const ph=Math.max(0,1-(per-RDR.t)/Math.min(.35,per)); /* flash au rythme du bip */
    gl.style.opacity=((mute?.35:.18)+(mute?.5:.3)*lv)*(RDR.p?ph:1)*(bd<R*.85||mute?1:.6);
    bar.firstElementChild.style.transform='scaleY('+(1+.6*ph)+')';
    sonarTick(dt,lv,mute,col);}
  else{bar.firstElementChild.firstElementChild.style.width='0%';bar.firstElementChild.style.transform='';RDR.t=0;gl.style.opacity=0;sonarTick(dt,0);}}
function denounceE(e){if(!e.f){e.cd=6;return;}image=Math.min(100,image+6);coins+=3;addB(3);const wr=addWarn(e);say(e.g,['Balance !','Je te revaudrai ça…','Oh non…'][(Math.random()*3)|0]);toast('Tu dénonces '+e.name+' aux managers ('+FK[e.f.k][1]+') : '+(wr===2?'3 avertissements, ça fait un blâme pour lui':'avertissement '+e.wn+'/3 pour lui')+'. +3, Sérieux +6, +3 branleur');endFault(e);e.noF=60;e.cd=15;}
function lightFaults(dt){EMP.forEach(function(e){
  if(e.noF>0)e.noF-=dt;
  if(e.f){e.f.t-=dt;if(e.f.t<=0)endFault(e);}
  else{if(e.nf===undefined)e.nf=10+Math.random()*50;if(!e.help&&!(e.noF>0)){e.nf-=dt;if(e.nf<=0)startFault(e);}}
  const dp=Math.hypot(e.x-pp.x,e.z-pp.z),show=!!e.f&&e.f.k!=='vol'&&mode==='zone'&&e.zn===cur&&dp<9&&!blocked(Z[cur],pp.x,pp.z,e.x,e.z);
  if(show){if(!e.fb){e.fb=dynLabel(400,72,3.9,.7);e.fb.sp.position.set(0,3.5,0);e.g.add(e.fb.sp);}e.fb.draw(FK[e.f.k][0]+' '+FK[e.f.k][1],'rgba(214,120,20,.96)');e.fb.sp.visible=true;}
  else if(e.fb)e.fb.sp.visible=false;});}
function tpTo(zn,x,z){if(WCIN)exitCabin();act=null;if(mode!=='zone'||cur!==zn)enter(zn);
  const cs=[[0,-2.3],[0,2.3],[2.3,0],[-2.3,0],[1.7,1.7],[-1.7,-1.7],[1.7,-1.7],[-1.7,1.7],[0,-1.2],[0,1.2],[1.2,0],[-1.2,0]];
  for(let i=0;i<cs.length;i++){const tx=x+cs[i][0],tz=z+cs[i][1];if(!hit(tx,tz,.45,Z[zn])){pp.x=tx;pp.z=tz;break;}}
  pp.face=Math.atan2(x-pp.x,z-pp.z);}
function zz2(m){return m.kind==='e'?m.e.zn:m.zn;}
function goMsg(i){const m=MSG[i];if(!m)return;m.seen=true;
  const gone=clk-m.t>m.life||(m.kind==='e'&&!m.e.f)||(m.kind==='cafe'&&!COF.grp.length)||(m.kind==='m'&&(m.mg.state!=='smoke'||m.mg.fired));
  if(gone){toast('Trop tard : l\'infraction est terminée.');MSG.splice(i,1);renderPhone();return;}
  closePhone();
  {const zz=m.kind==='e'?m.e.zn:m.zn;if(WCIN)exitCabin();act=null;enter(zz);}
  toast('Tu arrives à l\'entrée : '+Z[zz2(m)].name+'. Cherche toi-même qui fait quoi !');}
$('bShout').addEventListener('click',function(){if(rank<1||mode!=='zone')return;
  if(SHCD>0){toast('Tu es enroué : '+Math.ceil(SHCD)+' s avant de pouvoir recrier.');return;}
  let b=null,bs=99;EMP.forEach(function(e){if(e.zn!==cur||e.out>0||e.help||e.chore||e.ot>0||e.pcd>0)return;const d=Math.hypot(e.x-pp.x,e.z-pp.z);if(d>11||blocked(Z[cur],pp.x,pp.z,e.x,e.z))return;const sc=d-(e.f?6:0);if(sc<bs){bs=sc;b=e;}});
  if(!b){pop('📢 Personne à presser à portée.','bad');SHCD=3;return;}
  SHCD=12;say(pl,'Au travail !');pressLight(b,.6);pop('📢 « Au travail, '+b.name+' ! » Résultats en hausse','good');});
$('bGuard').addEventListener('click',guardTalk);$('bGadget').addEventListener('click',gadgetMenu);
$('bStrike').addEventListener('click',strikeStart);
$('bSeat').addEventListener('click',function(){if(seatLock())return;if(PSEAT)standPlayer();else sitPlayer(freeChair());});
$('bMsg').addEventListener('click',function(){if(PHN){closePhone();return;}openPhone(rank>=1?'msg':'inv');});

const TCAMS=[];
function placeCam(m){const zc={store:[8,0],reserve:[-15,-33],parking:[0,41]}[cur]||[m.x,m.z+5],h=Math.atan2(zc[0]-m.x,zc[1]-m.z),g=new T.Group();g.position.set(m.x,0,m.z);
  box(g,.12,2.2,.12,0x555e6a,0,1.1,0,false);box(g,.5,.3,.7,0x2b2f36,0,2.3,0,false);box(g,.14,.14,.2,0xe5484d,0,2.2,.4,false);g.rotation.y=h;
  const cn=mkCone(g,8,.6,0xffd84a,.18);cn.grp.position.y=0;Z[cur].g.add(g);TCAMS.push({x:m.x,z:m.z,h:h,zn:cur,t:28,g:g});toast('Caméra posée : elle surveille cette zone pendant 28 s (jauge de preuve automatique).');}
function camSees(c,e){const dx=e.x-c.x,dz=e.z-c.z,d=Math.hypot(dx,dz);if(d>8||d<.2)return false;if((Math.sin(c.h)*dx+Math.cos(c.h)*dz)/d<=Math.cos(.6))return false;return !blocked(Z[c.zn],c.x,c.z,e.x,e.z);}
function cartSend(){try{if(NET.on&&NET.joined&&NET.sb)netSbBroadcast('cart',{from:NET.pid,n:CART.n});}catch(_){}}
function cartTick(dt){if(!CART.lb)return;CART.t+=dt;CART.s=(CART.s||0)+dt;
  const slave=!!(NET.on&&NET.sb&&NET.joined&&NET.hostPid&&NET.hostPid!==NET.pid);
  if(!slave&&CART.s>=10&&netNpcIsHost()){CART.s=0;cartSend();}
  if(CART.t>=45&&!slave){CART.t=0;if(CART.n>0){CART.n--;if(netNpcIsHost())cartSend();}}
  if(CART.n<=0&&rank>=1)RESULT=Math.max(0,RESULT-dt*.03);
  if(CARTLD!==CART.n){if(CART.n===2&&CARTLD>2&&rank>=1)pop('🛒 Abri à caddies presque vide : envoie un employé en corvée (Autorité).','bad');CARTLD=CART.n;CART.lb.draw('🛒 Caddies '+CART.n+'/'+CART.max,CART.n<=3?'rgba(214,40,57,.96)':'rgba(30,110,60,.96)');}}
function tcSees(e){if(rank<1)return false;for(let i=0;i<TCAMS.length;i++){const c=TCAMS[i];if(c.zn!==e.zn)continue;const dx=e.x-c.x,dz=e.z-c.z,d=Math.hypot(dx,dz);if(d>8||d<.2)continue;if((Math.sin(c.h)*dx+Math.cos(c.h)*dz)/d<=Math.cos(.6))continue;if(!blocked(Z[c.zn],c.x,c.z,e.x,e.z))return true;}return false;}
function tcUpdate(dt){for(let i=TCAMS.length-1;i>=0;i--){const c=TCAMS[i];c.t-=dt;c.g.visible=rank>=1;if(c.t<=0){Z[c.zn].g.remove(c.g);TCAMS.splice(i,1);toast('Une caméra posée s\'est éteinte.');}}}
function startConv(idle){COMP=Math.max(0,COMP-10);RESULT=idle?Math.max(15,RESULT-8):40;CONVCD=210;LOWT=0;dIdle=0;CONV={t:7};DEN=null;D.inv=null;D.rage=0;
  tpTo('office',32,-34.4);setDZone('office');D.x=32.4;D.z=-37.4;D.th=Math.PI;D.h=Math.PI;D.path=null;D.stun=0;D.wait=999;
  toast(idle?'La directrice t\'a vu planté là à ne rien faire : convocation immédiate. Réputation -10 % (reste '+Math.round(COMP)+' %), Résultats -8.':'La directrice te convoque IMMÉDIATEMENT dans son bureau : résultats trop faibles. Savon : réputation -10 % (reste '+Math.round(COMP)+' %).');say(dirc,idle?'Vous êtes payé pour bouger !':'Vos résultats sont catastrophiques !');}
function nearFree(zn,x,z){for(let r=0;r<8;r++){for(let a=0;a<8;a++){const tx=x+Math.cos(a*.785)*r,tz=z+Math.sin(a*.785)*r;if(!hit(tx,tz,.9,zn)&&Math.abs(tx-x)<=r+.01)return [tx,tz];}}return [x,z];}
(function(){[[S,-14,-6],[S,2,8],[S,20,-8],[S,36,6],[S,10,-6],[R,-6,-33],[R,-30,-33],[O,24,-34]].forEach(function(a){const q=nearFree(a[0],a[1],a[2]);marker(a[0],'mctrl',q[0],q[1]);});
  [[S,-18,4],[S,8,-4],[S,32,4],[R,-8,-30],[R,-30,-31],[P,0,36]].forEach(function(a){const q=nearFree(a[0],a[1],a[2]);marker(a[0],'mpcam',q[0],q[1]);});})();
/* ---------- butin, voiture, arrivee ---------- */
const WTAB={'Écouteurs':[2,1],'Téléphone':[4,2],'Enceinte':[6,2],'Console de jeu':[6,2],'Chocolats':[1.5,1],'Pack de bières':[5,2],'Saumon fumé':[3,1],'Parfum':[3,1],'Cartons de cigarettes':[2,1],'Cigarettes':[1.8,1],'Piles':[1.4,1],'Perceuse':[6,2],'Écran PC':[10,3],'Télévision':[13,3],'Vidéoprojecteur':[8,2]};function wOf(n){return WTAB[n]?WTAB[n][1]:2;}
const LOOT=[],DROPS=[],GN=['Stagiaire','Agent','Chef d\'équipe','Responsable sécurité'];let CINE=null,MYCAR=null,GRADE=0,VGXP=0,STAM=100,STAMX=false,RUNDR=100/6,RUNRG=25,lastNoRun=-9,LETE=null,VD=8;
function gradeXp(){VGXP++;addPS(PRO_CA,1);const th=[3,8,15];let g=0;th.forEach(function(t,i){if(VGXP>=t)g=i+1;});if(g>GRADE){GRADE=g;pop('🎖️ Promu : '+GN[GRADE]+' !','good');toast('Nouveau grade : '+GN[GRADE]+'. '+(GRADE>=2?'Attention : les autres vigiles te surveillent maintenant.':'Détecteur plus puissant et fouille plus rapide.'));}}
function fireV(who){chRole('e',0);theftFine(lootVal());LOOT.length=0;pop('🚨 Vigile pris à voler ! Tu es viré','bad');toast(who+' t\'a pris sur le fait : tu es viré du poste de vigile et redeviens employé.');if(MG)closeMail();LK.role='e';applyLook(lookOpts(),PNAME);startRole('e');image=Math.max(10,image-25);GRADE=Math.max(0,GRADE-1);}
function dropLoot(){if(!LOOT.length)return;const items=LOOT.splice(0,LOOT.length);const sp=label('🎒',{sx:.9,sy:.9,w:96,h:96,size:56,bg:'rgba(200,60,60,.92)'});sp.position.set(pp.x,.9,pp.z);Z[cur].g.add(sp);DROPS.push({x:pp.x,z:pp.z,items:items,t:20,zn:cur,sp:sp,arm:false});pop('🗑️ Butin jeté ! Tu peux le reprendre dans 20 s','warn');}
function dropTick(dt){for(let i=DROPS.length-1;i>=0;i--){const d=DROPS[i];d.t-=dt;d.sp.visible=d.zn===cur&&mode==='zone';const dd=Math.hypot(d.x-pp.x,d.z-pp.z);
  if(dd>2.4||d.zn!==cur)d.arm=true;
  if(d.arm&&d.zn===cur&&mode==='zone'&&dd<1.2&&LOOT.length+d.items.length<=3){d.items.forEach(function(it){LOOT.push(it);});pop('🎒 Butin récupéré','good');d.t=0;}
  if(d.t<=0){Z[d.zn].g.remove(d.sp);DROPS.splice(i,1);}}}
function letGo(){const e=LETE;if(!e||!(e.loot>0)||e.hide>0)return;
  const seen=MGR.some(function(m){return m.zn===cur&&!m.fired&&m.stun<=0&&Math.hypot(m.x-pp.x,m.z-pp.z)<7;});
  if(seen){fireV('Un manager');return;}
  const o1=3+((Math.random()*4)|0),o2=o1+3+((Math.random()*5)|0);
  const accept=function(v){coins+=v;e.hide=30;e.cd=15;say(pl,'Marché conclu… je n\'ai rien vu.');say(e.g,'Merci chef… je mets ça dans mon coffre !');pop('🤫 '+e.name+' te donne '+v+' 🪙. Le détecteur ne marche plus sur lui pendant 30 s.','good');};
  const caught=function(){const price=Math.round(8+Math.random()*22);fouilleE(e);coins+=price;imgHit(e,12);pop('🚨 '+e.name+' a refusé le marché : arrêté, il paie l\'objet ('+price+' 🪙), perd de l\'image et prend un blâme.','good');
    if((LK.sim||GRADE>=3)&&!(VG.cd.menottes>0)&&!ARR.on){VG.cd.menottes=60;say(pl,'Les mains dans le dos !');arrestStart(e,'e');}};
  chat(e,'Ce serait dommage que ça se sache…','Euh… on peut s\'arranger ?',500);
  setTimeout(function(){dlg('🤫 '+e.name+' propose un arrangement',e.name+' te propose '+o1+' 🪙 pour que tu fermes les yeux.',[
   {t:'Oui, marché conclu (+'+o1+' 🪙)',f:function(){accept(o1);}},
   {t:'Non, pas assez…',f:function(){chat(e,'Attends… et si je te donne plus ?','Bon, '+o2+' pièces, d\'accord ?',300);
     setTimeout(function(){dlg('🤫 '+e.name+' insiste',e.name+' monte à '+o2+' 🪙. Dernière offre !',[
      {t:'Oui, marché conclu (+'+o2+' 🪙)',f:function(){accept(o2);}},
      {t:'Non : je t\'arrête !',f:function(){say(pl,'Je t\'arrête !');caught();}}]);},900);}}]);},1300);}
function portique(){if(!LOOT.length||VEST>0||(SEC&&GRADE<2))return;if(LOOT.every(function(l){return l.off;})){toast('Le portique reste muet : antivols retirés.');return;}pop('🚨 PORTIQUE : ALARME !','bad');toast('Le portique sonne !');
  [0,160,320,480].forEach(function(t,i){setTimeout(function(){beep(i%2?900:1200,.14,.09);},t);});{let bg=null,bd=1e9;GUARDS.forEach(function(G){if(G.zn==='parking'){const d=Math.hypot(G.x-pp.x,G.z-pp.z);if(d<bd){bd=d;bg=G;}}});const rr=globalThis.__portrnd!=null?globalThis.__portrnd:(globalThis.__nonpc?0:Math.random());if(bg&&rr<.7){bg.fx=14;bg.cd=0;bg.stun=0;bg.wait=0;GFC=0;toast('Un vigile du parking t\'a repéré : il arrive ! Cours te cacher entre les voitures.');}else toast('Personne ne semble avoir réagi… file avant qu\'on te voie.');}}
let CABT=12;
function cabTick(dt){const inC=!!(act&&act.key==='cabine')&&mode==='zone';if(!inC){CABT=8+Math.random()*14;return;}
  CABT-=dt;if(CABT>0)return;CABT=18+Math.random()*30;if(Math.random()>=.6)return;
  let bg=null,bd=1e9;GUARDS.forEach(function(G){if(G.zn===cur&&G.stun<=0){const d=Math.hypot(G.x-pp.x,G.z-pp.z);if(d<bd){bd=d;bg=G;}}});
  if(bg){bg.fx=12;bg.cd=0;bg.wait=0;bg.path=null;say(bg.g,'Cette cabine est occupée depuis un moment…');pop('👀 Un vigile vient voir la cabine ! Sors vite','warn');}}
function vigDenTick(dt){if(!(SEC&&GRADE>=2&&LOOT.length>0))return;if(D.inv)LASTSLACK=clk;if(DEN||D.inv||mode!=='zone')return;VD-=dt;if(VD<=0){VD=10;const w=EMP.find(function(e){return e.zn===cur&&!(e.out>0)&&Math.hypot(e.x-pp.x,e.z-pp.z)<8;});if(w&&Math.random()<.55){DEN={t:5+Math.random()*4,by:w.name};LASTSLACK=clk;}}}
function lootVal(){let v=0;LOOT.forEach(function(l){v+=l.v;});return v;}
const lootS=label('🎒 Butin',{sx:1.5,sy:.42,w:200,h:56,size:28,bg:'rgba(200,60,60,.92)'});lootS.visible=false;scene.add(lootS);
