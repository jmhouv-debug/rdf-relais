/* clients de l'hyper (la carte classique utilise ceux du jeu d'origine) */
function qmMapClients(){const L=[];for(let i=0;i<8;i++){const lk={shirt:[0xd94841,0x3b82f6,0xf59e0b,0x10b981,0x8b5cf6][i%5],pants:0x334155,hair:[0x2b1d14,0xc9a227,0x1b1b1b,0x6b3a2a][i%4],fem:i%2===1,hs:i%2?'long':'court'};const g=makeChar(lk);scene.add(g);const p=qmRand('store');g.position.set(p[0],0,p[1]);const wp=[0,1,2,3,4,5].map(function(){return qmRand('store');});L.push({g:g,x:p[0],z:p[1],zn:'store',ph:0,path:null,pi:0,wp:wp,i:0,wait:Math.random()*2,hd:0});}return L;}

/* ================= Convocation : pièces d'évasion hors carte ================= */
const QCV={arch:{n:'Archives (dans le noir)',ic:'📁',o:[400,400]},cad:{n:'Bureau au cadenas',ic:'🔢',o:[500,400]},vent:{n:'Conduits d\'aération',ic:'🌀',o:[600,400]},cls:{n:'Salle de classement',ic:'🗂️',o:[700,400]}};
const QCVK=Object.keys(QCV);
QCVK.forEach(function(k){QZN['cv_'+k]=QCV[k].ic+' '+QCV[k].n;});
QCFG.cvMax=120;QCFG.freeT=3;
function qmRng(seed){let s=(seed>>>0)||1;return function(){s=(Math.imul(s,1664525)+1013904223)>>>0;return s/4294967296;};}
function qmIsCv(zn){return typeof zn==='string'&&zn.indexOf('cv_')===0;}
function qmCvInit(){QCVK.forEach(function(k){if(Z['cv_'+k])return;const o=QCV[k].o;zone('cv_'+k,QCV[k].n,0,{x:[o[0]-2,o[0]+30],z:[o[1]-2,o[1]+30]},{x:o[0]+1.6,z:o[1]+1.6});});
  QM.CV={};QM.CVg={};QM.CN=[];QM.help=null;
  if(!QM.freeM){const p=qmFree('office',QM.exit[0]+2.6,QM.exit[1]+.4);QM.freeR={zn:'office',x:p[0],z:p[1],prog:0,n:0};QM.freeM=qmRingMesh(0x46d17a,'🔓 Libérer les convoqués · à 2',440);QM.freeM.g.position.set(p[0],0,p[1]);}
  QM.freeR.prog=0;QM.freeR.n=0;QM.freeM.g.visible=false;
  if(QM.inf&&QM.inf.m)QM.inf.m.g.visible=false;
  if(!$('qmTorch')){const c=document.createElement('canvas');c.id='qmTorch';c.hidden=true;const dk=$('dk');if(dk&&dk.parentNode)dk.parentNode.insertBefore(c,dk.nextSibling);else document.body.appendChild(c);}
  if(!$('qmPad')){const d=document.createElement('div');d.id='qmPad';d.hidden=true;document.body.appendChild(d);}
  if(!$('qmCvH')){const d=document.createElement('div');d.id='qmCvH';d.hidden=true;document.body.appendChild(d);}}
/* ---------- labyrinthe ---------- */
function qmMaze(N,rnd,braid){const E=[],S=[];for(let i=0;i<N;i++){E.push([]);S.push([]);for(let j=0;j<N;j++){E[i].push(1);S[i].push(1);}}
  const seen={},st=[[0,0]];seen['0,0']=1;
  while(st.length){const c=st[st.length-1],i=c[0],j=c[1];const nb=[[1,0],[-1,0],[0,1],[0,-1]].filter(function(d){const a=i+d[0],b=j+d[1];return a>=0&&b>=0&&a<N&&b<N&&!seen[a+','+b];});
    if(!nb.length){st.pop();continue;}const d=nb[(rnd()*nb.length)|0],a=i+d[0],b=j+d[1];
    if(d[0]===1)E[i][j]=0;else if(d[0]===-1)E[a][b]=0;else if(d[1]===1)S[i][j]=0;else S[a][b]=0;seen[a+','+b]=1;st.push([a,b]);}
  const B=[];for(let i=0;i<N;i++)for(let j=0;j<N;j++){if(i<N-1&&E[i][j]&&rnd()<braid)B.push({k:'E',i:i,j:j});if(j<N-1&&S[i][j]&&rnd()<braid)B.push({k:'S',i:i,j:j});}
  B.forEach(function(b){if(b.k==='E')E[b.i][b.j]=0;else S[b.i][b.j]=0;});return {N:N,E:E,S:S,B:B};}
function qmZClear(zn){while(zn.g.children.length)zn.g.remove(zn.g.children[0]);zn.obs.length=0;zn.gr=null;}
function qmWallSeg(zn,ox,oz,C,k,i,j,h,col,th,keep){let a,b,c,d;if(k==='E'){const x=ox+(i+1)*C;a=x-th;b=x+th;c=oz+j*C-th;d=oz+(j+1)*C+th;}else{const z=oz+(j+1)*C;a=ox+i*C-th;b=ox+(i+1)*C+th;c=z-th;d=z+th;}
  const m=box(zn.g,b-a,h,d-c,col,(a+b)/2,h/2,(c+d)/2);const o={a:a,b:b,c:c,d:d};if(!keep)zn.obs.push(o);return {m:m,o:o};}
function qmMazeBuild(zn,M,ox,oz,C,h,col,th){const N=M.N;
  /* murs exterieurs */
  [[ox-th,ox+N*C+th,oz-th*2,oz],[ox-th,ox+N*C+th,oz+N*C,oz+N*C+th*2],[ox-th*2,ox,oz,oz+N*C],[ox+N*C,ox+N*C+th*2,oz,oz+N*C]].forEach(function(w){box(zn.g,w[1]-w[0],h,w[3]-w[2],col,(w[0]+w[1])/2,h/2,(w[2]+w[3])/2);zn.obs.push({a:w[0],b:w[1],c:w[2],d:w[3]});});
  for(let i=0;i<N;i++)for(let j=0;j<N;j++){if(i<N-1&&M.E[i][j])qmWallSeg(zn,ox,oz,C,'E',i,j,h,col,th);if(j<N-1&&M.S[i][j])qmWallSeg(zn,ox,oz,C,'S',i,j,h,col,th);}}
function qmCellC(o,C,i,j){return [o[0]+(i+.5)*C,o[1]+(j+.5)*C];}
function qmMazeDist(M,si,sj){const N=M.N,D={};D[si+','+sj]=0;const q=[[si,sj]];for(let h=0;h<q.length;h++){const i=q[h][0],j=q[h][1],d0=D[i+','+j];
  const nb=[];if(i<N-1&&!M.E[i][j])nb.push([i+1,j]);if(i>0&&!M.E[i-1][j])nb.push([i-1,j]);if(j<N-1&&!M.S[i][j])nb.push([i,j+1]);if(j>0&&!M.S[i][j-1])nb.push([i,j-1]);
  nb.forEach(function(n){const k=n[0]+','+n[1];if(D[k]===undefined){D[k]=d0+1;q.push(n);}});}return D;}
/* ---------- generation des 4 pieces ---------- */
function qmCvGen(k,seed){const zn=Z['cv_'+k],o=QCV[k].o,rnd=qmRng(seed);qmZClear(zn);QM.CVg[k]=seed;const X={k:k,seed:seed};zn.cv=X;
  if(k==='arch'||k==='vent'){const N=k==='arch'?8:9,C=k==='arch'?3.2:2.6;X.N=N;X.C=C;const M=qmMaze(N,rnd,k==='arch'?.1:.16);X.M=M;
    box(zn.g,N*C+2,.1,N*C+2,k==='arch'?0x3a3328:0x4a5058,o[0]+N*C/2,-.05,o[1]+N*C/2);
    if(k==='arch'){qmMazeBuild(zn,M,o[0],o[1],C,1.7,0x6b5a45,.22);
      /* dossiers sur les etageres */
      zn.obs.slice(4).forEach(function(w,n){if(n%2)return;const cx=(w.a+w.b)/2,cz=(w.c+w.d)/2;box(zn.g,Math.max(.3,(w.b-w.a)*.8),.3,Math.max(.3,(w.d-w.c)*.8),[0xc0392b,0x2980b9,0xf1c40f,0x27ae60][n%4],cx,1.75,cz);});}
    else{const B0=M.B;M.B.forEach(function(b){if(b.k==='E')M.E[b.i][b.j]=0;else M.S[b.i][b.j]=0;});qmMazeBuild(zn,M,o[0],o[1],C,1.2,0x8a96a3,.18);X.base=zn.obs.slice();
      X.BW=B0.map(function(b){const s=qmWallSeg(zn,o[0],o[1],C,b.k,b.i,b.j,1.2,0x8a96a3,.18,true);s.m.material=new T.MeshLambertMaterial({color:0x9aa7b4});return {k:b.k,i:b.i,j:b.j,m:s.m,o:s.o,on:false};});
      const D=qmMazeDist(M,0,0),cells=[];for(let i=0;i<N;i++)for(let j=0;j<N;j++)if((i+j)>2&&!(i===N-1&&j===N-1))cells.push([i,j]);
      const sh=cells.slice().sort(function(){return rnd()-.5;});
