      else if(ev==='cart'&&d.from!==NET.pid&&isFinite(d.n))CART.n=Math.max(0,Math.min(CART.max,d.n|0));
      else if(ev==='ev'&&d.from!==NET.pid)netRecvEv(d);
      else if(ev==='bye'&&typeof d.pid==='string'&&d.pid!==NET.pid)delete NET.players[d.pid];}};
  ws.onclose=function(){if(NET.ws===ws)NET.ws=null;NET.sbJoined=false;if(NET.leaving||!NET.on||!NET.sb)return;if(NET.joined&&!NET.lostMsg){NET.lostMsg=1;toast('En ligne : connexion perdue, reconnexion…');}NET.wsTry++;if(NET.wsTry<60)NET.recon=setTimeout(netSbOpen,2000);};
  ws.onerror=function(){};
