function spotOf(obj){let best=null;Object.keys(Z).forEach(function(id){Z[id].markers.forEach(function(m){if(!m.off&&m.obj===obj&&(!best||Math.abs(m.x)<Math.abs(best.x)))best=m;});});return best?{x:Math.round(best.x/12)*12,z:Math.round(best.z/12)*12}:null;}
function cfPins(){Object.keys(CFPIN).forEach(function(k){CFPIN[k].visible=false;});if(mode!=='map'||rank>=1||SEC)return;const st=cfSt();if(cfEmpty())return;const list=[];
  if(!st.ms.length){if(LVL>=2)list.push(['📋',61,-55]);}else if(!st.bribed){if(cfDone(st))list.push(['🤝',61,-55]);else st.ms.forEach(function(m,i){if(m.p<m.n){const q=spotOf(m.k);if(q)list.push([String(i+1),q.x,q.z]);}});}
  else if(!st.key)list.push(['🗝️',33,-41]);else list.push(['💰',77,-52]);
  const used={};list.forEach(function(p){const l=CFPIN[p[0]],kk=Math.round(p[1])+','+Math.round(p[2]),n=used[kk]=(used[kk]||0)+1;l.position.set(p[1]+(n-1)*7,9.5,p[2]-4);const k=6*(1+Math.sin(clk*3)*.1);l.scale.set(k,k,1);l.visible=true;});}
