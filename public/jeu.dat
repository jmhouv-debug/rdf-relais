const ENVT=(function(){try{if(!T.PMREMGenerator)return null;const sc=new T.Scene(),g=new T.SphereGeometry(60,24,16),pos=g.attributes.position,col=new Float32Array(pos.count*3),c1=new T.Color(0x4f8fd0),c2=new T.Color(0xe8d6b6),c3=new T.Color(0x5a6676),t=new T.Color();
  for(let i=0;i<pos.count;i++){const y=pos.getY(i)/60;if(y>0)t.copy(c2).lerp(c1,Math.min(1,y*1.6));else t.copy(c2).lerp(c3,Math.min(1,-y*2.4));col[i*3]=t.r;col[i*3+1]=t.g;col[i*3+2]=t.b;}
  g.setAttribute('color',new T.BufferAttribute(col,3));sc.add(new T.Mesh(g,new T.MeshBasicMaterial({vertexColors:true,side:T.BackSide})));
  const sn=new T.Mesh(new T.SphereGeometry(7,10,8),new T.MeshBasicMaterial({color:0xffffff}));sn.position.set(30,38,-24);sc.add(sn);
  const pm=new T.PMREMGenerator(renderer),rt=pm.fromScene(sc,.03);pm.dispose();return rt.texture;}catch(_){return null;}})();
