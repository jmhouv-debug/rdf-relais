/* ----- v198 : parc de location (parking), personnel et missions des nouveaux batiments ----- */
(function(){
  const g=P.g;
  {const m=new T.Mesh(new T.PlaneGeometry(18.4,22.8),new T.MeshLambertMaterial({color:0x6b5a45}));m.rotation.x=-Math.PI/2;m.position.set(-27.4,.034,55.1);g.add(m);
   box(g,18.4,.02,.18,0xf2c230,-27.4,.05,43.7,false);box(g,18.4,.02,.18,0xf2c230,-27.4,.05,66.5,false);box(g,.18,.02,22.8,0xf2c230,-36.6,.05,55.1,false);box(g,.18,.02,22.8,0xf2c230,-18.2,.05,55.1,false);
   const lc=document.createElement('canvas');lc.width=1024;lc.height=200;const lx=lc.getContext('2d');lx.fillStyle='rgba(255,214,102,.95)';lx.font='bold 120px Arial Black,Arial,sans-serif';lx.textAlign='center';lx.textBaseline='middle';lx.fillText('LOCATION',512,104);
   const lm=new T.Mesh(new T.PlaneGeometry(9,1.76),new T.MeshBasicMaterial({map:new T.CanvasTexture(lc),transparent:true,depthWrite:false}));lm.rotation.x=-Math.PI/2;lm.position.set(-27.4,.07,52);g.add(lm);}
  {const l=label('PARC DE LOCATION',{sx:3.6,sy:.7,w:320,h:72,size:32,depth:true});l.position.set(-27.4,3.4,44.4);g.add(l);}
  function bay(x,z,w,d){box(g,.1,.02,d,0xffffff,x-w/2,.06,z,false);box(g,.1,.02,d,0xffffff,x+w/2,.06,z,false);}
  function mkMark(c,x,z,key,txt){const m=marker(P,key,x,z,txt);m.car=c;return m;}
  function addCommon(c){c.sc=new T.Group();c.sc.visible=false;c.g.add(c.sc);
    const sx=c.isTruck?1.34:.95;box(c.sc,.03,.05,1.9,0xe8ecf0,sx,.95,-.4,false).rotation.x=.08;box(c.sc,.03,.05,1.4,0xe8ecf0,sx,.78,.5,false).rotation.x=-.07;
    c.crates=c.crates||[];RENT.push(c);}
  /* 5 voitures : 2 rangees, espace entre les vehicules */
  [[-33.2,46.8,0x1d5f9a],[-27.7,46.8,0xffffff],[-22.2,46.8,0xf2c230],[-33.2,53.6,0x2a9d8f],[-27.7,53.6,0xd62839]].forEach(function(q,i){
    const x=q[0],z=q[1];bay(x,z,2.9,4.8);
    const c=P.mkCar(x,z,q[2],0);c.body.material=c.body.material.clone();c.win.material=c.win.material.clone();c.isTruck=false;c.col=q[2];addCommon(c);
    c.me=marker(P,'eteindre',x+2.1,z);c.me.car=c;c.me.off=true;
    c.mr=mkMark(c,x+2.1,z-1.5,'locrayer');c.mf=mkMark(c,x+2.1,z+1.5,'locfeu');c.mp=null;
    if(i===1)mkMark(c,x-2.1,z+1.2,'locpneu');
    if(i===2){const v=marker(P,'locvol',x-2.1,z+1.2);v.car=c;}
    if(i%2===0){const lv=marker(P,'loclaver',x-2.1,z-1.2);lv.car=c;}
  });
  /* 3 camions */
  function truck(x,z,col){const tg=new T.Group();tg.position.set(x,0,z);g.add(tg);
    const cargo=box(tg,2.6,2.8,4.2,col,0,1.7,.9,true);const cab=box(tg,2.4,1.9,1.7,0xe9e9ee,0,1.25,-2.3,true);const win=box(tg,2.0,.7,.06,0x24313f,0,1.7,-3.18,false);
    box(tg,2.6,.3,6.6,0x3a3f48,0,.35,0,false);
    [-1,1].forEach(function(sx){[-2.1,2.3].forEach(function(zz){tube(tg,.5,.5,.3,0x15181d,sx*1.3,.5,zz,1,1,0,Math.PI/2);});});
    const sg=sign('LOC · UTILITAIRES',3.6,.8,'#b45f06','#ffffff');sg.position.set(1.32,2.0,.9);sg.rotation.y=Math.PI/2;tg.add(sg);
    obs(P,x,z,2.9,6.8);
    const c={g:tg,x:x,z:z,body:cargo,win:win,wh:[],flat:false,burn:0,col:col,isTruck:true,load:0};
    c.crates=[];for(let k=0;k<4;k++){const b=box(tg,.8,.7,.8,0xc9a26b,-.7+(k%2)*1.4,3.4,.2+((k/2)|0)*1.3,false);b.visible=false;c.crates.push(b);}
    return c;}
  [[-32.5,61.3,0xf4f4f4],[-25.5,61.3,0xf2c230],[-21.3,53.6,0xf4f4f4]].forEach(function(q){
    const x=q[0],z=q[1];bay(x,z,3.4,7.2);
    const c=truck(x,z,q[2]);addCommon(c);
    c.me=marker(P,'eteindre',x+2.4,z+2.6);c.me.car=c;c.me.off=true;
    c.mr=mkMark(c,x+2.4,z-.2,'locrayer');c.mf=mkMark(c,x+2.4,z-2.2,'locfeu');
    const ld=marker(P,'locload',x+2.4,z+1.4);ld.car=c;
  });
  /* personnel : electro (3 employes + 1 vigile) et location (1 employe) */
  function stat(zn,x,z,name,shirt,rot,cap){const c=makeChar({shirt:shirt,pants:0x2b2f36,hair:0x3a2a1a,badge:1,cap:cap});c.position.set(x,0,z);c.rotation.y=rot;zn.g.add(c);empTag(c,name,'');return c;}
  function emp(zn,x,z,name,shirt,rot){const c=stat(zn,x,z,name,shirt,rot);EMP.push({g:c,x:x,z:z,name:name,cd:0,zn:zn.id});}
  emp(ELECTRO,-50,43.2,'Vendeur Karim',0x1f7a8c,0);emp(ELECTRO,-66,36.4,'Vendeuse Inès',0x1f7a8c,Math.PI);emp(ELECTRO,-58,45,'Caissier Dylan',0x1f7a8c,0);
  emp(LOCATION,-54,61,'Loueuse Sandra',0xb45f06,0);
  /* missions : electro */
  [['elecdemo',-64.4,27.2],['elecbrch',-56,27.2],['elecbrch',-72.8,27.2],['elecclass',-77.6,46],['elecpromo',-62,36.4],['elecaide',-50,41.6],['elecjeu',-71,34],['elecvolc',-69.6,37],['elecvol',-53,36.6],['elecvolc',-77.6,54.6],['elecclass',-77.6,50.5]].forEach(function(q){marker(ELECTRO,q[0],q[1],q[2]);});
  /* compta */
  [['compclass',56.4,-58.4],['compcheq',58.2,-56.4],['compdoss',56.4,-61.2],['compnote',64.6,-60.8],['compbrib',63.6,-56.4]].forEach(function(q){marker(COMPTA,q[0],q[1],q[2]);});
  /* agence de location */
  [['loccontrat',-56.8,64],['lockeys',-57,59.8],['lockeyv',-60.4,59.8],['locresa',-51.3,64]].forEach(function(q){marker(LOCATION,q[0],q[1],q[2]);});
})();


