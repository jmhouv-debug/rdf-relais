  QM.meMi=label('📍 Toi',{sx:8,sy:2.2,w:300,h:80,size:40,bg:'rgba(30,160,90,.97)'});QM.meMi.visible=false;scene.add(QM.meMi);
  QM.ZL=QZ.map(function(id){const b=Z[id].bounds;const l=label(QZN[id],{sx:13,sy:2.6,w:420,h:84,size:40,bg:'rgba(14,22,40,.82)'});l.position.set((b.x[0]+b.x[1])/2,9,(b.z[0]+b.z[1])/2);l.visible=false;scene.add(l);return l;});
