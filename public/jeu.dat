  chef(F,-45,-13.6,'Poissonnier Hervé',0x4a86d0,'');chef(F,-35.8,-10.5,'Poissonnière Nadia',0x4a86d0,'');
  cam(F,{x:-47.6,z:-19.6,b:.8,amp:.7,sp:.9,ph:3});
