  box(g,21.5,1.3,.4,W,-51.75,.65,-43.9,true);obs(R,-51.75,-43.9,21.5,.5);
  box(g,27.9,1.3,.4,W,-48.95,.65,-62.7,true);obs(R,-48.95,-62.7,27.9,.7);
