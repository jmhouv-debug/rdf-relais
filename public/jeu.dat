function qmLaunch(i){if(!(STARTED||QM.on)){accShow('rdf','');qnLobby(i);if(QN.autoSalle){const k=QN.autoSalle;QN.autoSalle=0;setTimeout(function(){if(!QM.on)qnEnter(k);},1800);}return;}if(STARTED||QM.on){try{sessionStorage.setItem('edm_auto',JSON.stringify({ch:i,qm:1}));location.reload();}catch(_){toast('Recharge la page pour lancer la partie rapide.',1);}return;}
  accLoadChar(i);applyLook(lookOpts(),(LK.name||'').trim().slice(0,12)||'Alex');
  $('acc').hidden=true;$('creator').hidden=true;$('crTitle').hidden=true;CREATING=false;QM.ch=i;qmStart();}
function qmLaunchGo(i,opts){try{accLoadChar(i);}catch(_){}applyLook(lookOpts(),(LK.name||'').trim().slice(0,12)||'Alex');
  $('acc').hidden=true;$('creator').hidden=true;$('crTitle').hidden=true;CREATING=false;QM.ch=i;qmStart(opts);}
function qmToMenu(){try{sessionStorage.setItem('edm_auto',JSON.stringify({tolist:1}));}catch(_){}location.reload();}
function qmReplay(){try{sessionStorage.setItem('edm_auto',JSON.stringify({ch:QM.ch||0,qm:1,solo:1}));}catch(_){}location.reload();}
function qmFree(zn,x,z){const Zn=Z[zn];if(!hit(x,z,.42,Zn))return [x,z];for(let r=.4;r<5;r+=.4)for(let a=0;a<6.28;a+=.5){const X=x+Math.cos(a)*r,Y=z+Math.sin(a)*r;if(X<Zn.bounds.x[0]+.5||X>Zn.bounds.x[1]-.5||Y<Zn.bounds.z[0]+.5||Y>Zn.bounds.z[1]-.5)continue;if(!hit(X,Y,.42,Zn))return [X,Y];}return [x,z];}
function qmInitMap(){if(QPOOL)return;
  QPORT=PORTALS.filter(function(q){return QZ.indexOf(q.zn)>=0&&QZ.indexOf(q.to)>=0&&!q.hid&&!q.need&&!q.lock&&!q.elev;});
  QPOOL={};QZ.forEach(function(id){const L=[];const en=QPORT.find(function(q){return q.to===id;});const ox=en?en.tx:Z[id].spawn.x,oz=en?en.tz:Z[id].spawn.z;
    const ok=function(x,z){if(qmNoPool(id,x,z))return false;const P=path(Z[id],ox,oz,x,z);return !(P.length===1&&!clearLine(Z[id],ox,oz,x,z));};
    Z[id].markers.forEach(function(m){if(!hit(m.x,m.z,.45,Z[id])&&ok(m.x,m.z)&&!QPORT.some(function(q){return q.zn===id&&Math.hypot(q.x-m.x,q.z-m.z)<2.2;}))L.push([m.x,m.z]);});
    const sp=Z[id].spawn;if(sp&&!hit(sp.x,sp.z,.45,Z[id]))L.push([sp.x,sp.z]);QPOOL[id]=L;});
  const used=[];QSPOT={};
  QMD.forEach(function(d){const L=QPOOL[d.zn];let best=null,bd=1e9;
    L.forEach(function(p){if(used.some(function(u){return u[2]===d.zn&&Math.hypot(u[0]-p[0],u[1]-p[1])<3.2;}))return;const dd=Math.hypot(p[0]-d.at[0],p[1]-d.at[1]);if(dd<bd){bd=dd;best=p;}});
    if(!best)best=qmFree(d.zn,d.at[0],d.at[1]);used.push([best[0],best[1],d.zn]);QSPOT[d.id]=best;});
  const far=function(zn,x,z,dm){return !used.some(function(u){return u[2]===zn&&Math.hypot(u[0]-x,u[1]-z)<dm;});};
  const reach={};QZ.forEach(function(id){const en=QPORT.find(function(q){return q.to===id;});reach[id]=en?[en.tx,en.tz]:[Z[id].spawn.x,Z[id].spawn.z];});
  const ok=function(id,x,z){if(qmNoPool(id,x,z))return false;if(hit(x,z,.45,Z[id]))return false;const o=reach[id],P=path(Z[id],o[0],o[1],x,z);return !(P.length===1&&!clearLine(Z[id],o[0],o[1],x,z));};
  QHIDE=[];QZ.forEach(function(id){Z[id].markers.forEach(function(m){if(['planque','cache','planquer'].indexOf(m.obj)<0)return;if(!ok(id,m.x,m.z)||!far(id,m.x,m.z,2.2))return;used.push([m.x,m.z,id]);QHIDE.push({zn:id,x:m.x,z:m.z,n:QHN[id][QHIDE.filter(function(h){return h.zn===id;}).length%QHN[id].length]});});});
  QMINI=[];const cnt={};QZ.forEach(function(id){Z[id].markers.forEach(function(m){const L=QMN[m.obj];if(!L||!ok(id,m.x,m.z)||!far(id,m.x,m.z,2.3))return;if(QPORT.some(function(q){return q.zn===id&&Math.hypot(q.x-m.x,q.z-m.z)<2.2;}))return;
    cnt[m.obj]=(cnt[m.obj]||0)+1;used.push([m.x,m.z,id]);QMINI.push({id:'m'+QMINI.length,k:'mini',zn:id,x:m.x,z:m.z,room:(id==='office'&&['wc','lavabo','wcplan'].indexOf(m.obj)>=0?'wc':id==='reserve'&&m.obj==='mfrigo'?'froid':''),n:L[(cnt[m.obj]-1)%L.length],dur:3+Math.random(),g:1});});});}
function qmZoneNext(a,b,ign){if(a===b)return null;if(!ign&&QM.lockZ&&QM.lockZ[b])return null;const LZ=ign?{}:(QM.lockZ||{});const prev={};prev[a]=null;const q=[a];
  while(q.length){const z=q.shift();if(z===b)break;QPORT.forEach(function(p){if(LZ[p.to])return;if(p.zn===z&&!(p.to in prev)){prev[p.to]=p;q.push(p.to);}});}
  if(!(b in prev))return null;let p=prev[b];while(p&&p.zn!==a)p=prev[p.zn];return p;}
function qmRand(zn){const L=QPOOL[zn];if(!L||!L.length){const s=Z[zn].spawn;return [s.x,s.z];}return L[(Math.random()*L.length)|0];}
function qmLook(){const f=Math.random()<.5,hc=[0x2b1d14,0x6b3a2a,0xc9a227,0x1b1b1b,0x8d5524,0xb5651d,0x555555][(Math.random()*7)|0];
  return {shirt:f?0xe86aa6:0x2f6fd0,pants:0x2b3a55,badge:1,skin:[0xf1c9a5,0xe0ac69,0xc68642,0x8d5524,0xffdbac][(Math.random()*5)|0],hair:hc,hs:f?['long','queue','chignon','court'][(Math.random()*4)|0]:['court','court','crete','afro'][(Math.random()*4)|0],fem:f,beard:!f&&Math.random()<.3?1:0,bc:hc,cap:Math.random()<.15?0xd62839:0};}
function qmRingMesh(col,txt,w){w=Math.max(w||0,Math.min(900,Math.round(Array.from(txt).length*15.5+60)));const g=new T.Group();
  const disc=new T.Mesh(discG,new T.MeshBasicMaterial({color:col,transparent:true,opacity:.3,depthWrite:false}));disc.rotation.x=-Math.PI/2;disc.position.y=.03;g.add(disc);
  const rg=new T.Mesh(ringG,new T.MeshBasicMaterial({color:col,transparent:true,opacity:.95,depthWrite:false}));rg.rotation.x=-Math.PI/2;rg.position.y=.05;g.add(rg);
  const lb=dynLabel(w,64,3.3*w/400,.53);lb.sp.position.y=1.75;g.add(lb.sp);lb.draw(txt,hex6(col)+'f2');scene.add(g);return {g:g,disc:disc,ring:rg,lb:lb};}
function qmMsg(t,k,all){if(all&&QM.mp&&QN.host)qnS('msg',{t:t,k:k||''});const box=$('qmMsg');if(!box)return;const d=document.createElement('div');d.className='qmm '+(k||'');d.textContent=t;box.appendChild(d);while(box.children.length>2)box.firstElementChild.remove();
  setTimeout(function(){d.classList.add('off');setTimeout(function(){d.remove();},500);},Math.min(5200,2600+t.length*30));}
function qmShuffle(A){for(let i=A.length-1;i>0;i--){const j=(Math.random()*(i+1))|0,t=A[i];A[i]=A[j];A[j]=t;}return A;}
const QACT=['kit','shield','portal','cart','disc','info','taser','toys','blackout','hype'];

function qmMakeRoster(H){const used=H.map(function(h){return h.n;});const R=H.map(function(h){return {pid:h.pid,n:h.n,lk:h.lk||null,cl:QCL[h.cl]?h.cl:''};});
  const taken={};R.forEach(function(r){if(r.cl&&!taken[r.cl])taken[r.cl]=1;else r.cl='';});
  qmShuffle(QNAMES.filter(function(n){return used.indexOf(n)<0;})).slice(0,QCFG.team-R.length).forEach(function(n){R.push({pid:'',n:n,lk:qmLook(),cl:''});});
  const free=qmShuffle(QCK.filter(function(k){return !taken[k];}));R.forEach(function(r){r.r='emp';if(!r.cl)r.cl=free.shift()||QCK[(Math.random()*QCK.length)|0];});return R;}
function qmSetCls(a,k){a.cls=k;try{qmOutfit(a.g,k);}catch(_){}a.wl=a.wl||1;a.pw=[QCL[k].pw];a.hpMax=k==='rec'?20:12;if(!(a.down>0)&&!(a.zomb>0))a.hp=a.hpMax;}
function qmStart(opts){qmApplyMap((opts&&opts.map)||qmPickMap(),opts);qmInitMap();QM.mp=!!(opts&&opts.roster);QM.on=true;QM.t=QCFG.time;QM.j=0;QM.end=null;QM.paused=true;QM.decoy=0;QM.meetUsed=true;QM.picked=0;QM._mp=0;try{QM.camNear=localStorage.getItem('edm_qmcam')==='1';QM.auto=localStorage.getItem('edm_qmauto2')==='1';}catch(_){QM.auto=false;}QM.meet=null;QM.key={st:'none'};QM.firstTeam=false;QM.uiOpen=false;QM.D=[];QM.FX=[];QM.map=false;
  /* on masque tout ce qui appartient au jeu classique */
  try{dirc.visible=false;dcone.grp.visible=false;}catch(_){}
  try{MGR.forEach(function(m){[m.g,m.gs,m.gp,m.gi].forEach(function(g){if(g)g.visible=false;});if(m.cone)m.cone.grp.visible=false;});}catch(_){}
  try{GUARDS.forEach(function(G){G.g.visible=false;G.cone.grp.visible=false;});}catch(_){}
  try{NPC.forEach(function(n){if(n.name)n.g.visible=false;});}catch(_){}
  try{[RCAM,PCAM,SCAM].forEach(function(A){A.forEach(function(c){if(c.cone)c.cone.grp.visible=false;});});}catch(_){}
  Object.keys(Z).forEach(function(k){Z[k].markers.forEach(function(m){m.g.visible=false;});});
  try{mapLabels.forEach(function(l){l.visible=false;});}catch(_){}
  [alertS,lootS,dHint,grimS,bubble,bubbleZ].forEach(function(s){try{s.visible=false;}catch(_){}});
  try{if(mapStarT)mapStarT.sp.visible=false;mapStar.visible=false;mapAlert.visible=false;}catch(_){}
  /* equipe de 8 : 6 employes + 2 traitres. En ligne, le roster vient de l'hote ; les places libres sont des PNJ */
  const R=(opts&&opts.roster)||qmMakeRoster([{pid:'me',n:PNAME,lk:null}]);
  QM.A=[];let me=null;
  R.forEach(function(r,i){const mine=opts&&opts.roster?r.pid===QN.pid:r.pid==='me';let g;
    if(mine)g=pl;else{const o=r.lk||qmLook();g=makeChar(o);const tg=label(r.n+(r.pid?' 🎮':''),{sx:2.1,sy:.52,w:256,h:64,size:28,bg:o.fem?'rgba(214,80,150,.93)':'rgba(30,85,175,.93)'});tg.position.y=2.65;g.add(tg);scene.add(g);}
    const a={id:i,pid:r.pid||'',name:r.n,g:g,zn:'store',x:0,z:0,h:0,cd:{},caught:0,imm:0,inv:0,sus:0,st:'idle',job:null,wt:0,ph:0,think:Math.random(),role:'emp',pw:['kit'],hp:QCFG.hp,down:0,zomb:0,rev:0,cure:0,gr:QCFG.growl};
    a.tag=dynLabel(300,64,2.2,.5);a.tag.sp.visible=false;scene.add(a.tag.sp);qmSetCls(a,r.cl||QCK[i%QCK.length]);a.hp=a.hpMax;
    if(mine){a.human=1;me=a;}else if(r.pid&&opts&&opts.roster)a.remote=1;
    QACT.forEach(function(k){a.cd[k]=0;});a.cd.alert=a.role==='imp'?20+Math.random()*25:0;a.cd.lock=a.role==='imp'?10+Math.random()*15:0;a.cd.jam=a.role==='imp'?15+Math.random()*20:0;QM.A.push(a);});
  QM.me=me;
  /* tout le monde demarre au magasin, autour de l'entree des reserves */
  {const ZS=qmShuffle(QM.park?['store','reserve','office','parking']:['store','reserve','office','store']),anc={};QM.A.forEach(function(a,i){const k=(i>>1)%ZS.length,zn=ZS[k];if(!anc[k]){let q=qmRand(zn);if(zn==='store'&&k>0){for(let t=0;t<10;t++){const q2=qmRand(zn);const o=anc[ZS.indexOf('store')];if(!o||Math.hypot(q2[0]-o[0],q2[1]-o[1])>18){q=q2;break;}}}anc[k]=q;}const p=qmFree(zn,anc[k][0]+(i%2)*1.4,anc[k][1]+(i%2)*.6);a.zn=zn;a.x=p[0];a.z=p[1];a.h=Math.PI;if(!a.human){a.g.position.set(a.x,0,a.z);}});}
  cur=me.zn;mode='zone';pp.x=me.x;pp.z=me.z;pp.face=Math.PI;
  /* PNJ chasseurs : la directrice + 3 managers */
  QM.H=[];
  const mkH=function(name,look,zn,dir){const g=makeChar(look);try{qmAccMgr(g,dir);}catch(_){}if(dir){g.scale.setScalar(1.06);box(g,.16,.2,.06,0xf2c94c,.16,.95,-.3,false);}
    const tg=label(dir?'Directrice':'Manager '+name,{sx:2.2,sy:.52,w:256,h:64,size:26,bg:dir?'rgba(35,35,43,.95)':'rgba(140,110,10,.95)'});tg.position.y=3.0;g.add(tg);scene.add(g);
    const cg=new T.Group();scene.add(cg);const cone=mkCone(cg,8.5,.75,dir?0xe5484d:0xffd84a,.18);
