function cleanerStep(dt){const r=CLN.run;if(!r)return;const ch=r.ch;r.T+=dt;
 if(r.stage===1){r.w-=dt;if(r.w<=0){r.stage=2;r.T=0;}return;}
 const tg=r.stage===0?r.pts[1]:r.pts[0];let d=99,dx=0,dz=0;try{dx=tg[0]-ch.position.x;dz=tg[1]-ch.position.z;d=Math.hypot(dx,dz);}catch(e){}
 if(!(d<=.05)&&r.T<(r.stage===0?14:30)&&d>2.4*dt){try{ch.position.x+=dx/d*2.4*dt;ch.position.z+=dz/d*2.4*dt;ch.rotation.y=Math.atan2(dx,dz);}catch(e){}return;}
