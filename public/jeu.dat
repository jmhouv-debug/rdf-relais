})();
const RD={cd:0,mk:[]};
function rdReset(){RD.cd=0;RD.mk.forEach(function(m,i){m.off=i>0;m.cool=0;});}
(function(){RD.mk=[marker(S,'rd1',-20,-14),marker(P,'rd2',50,75),marker(R,'rd3',9,-35)];marker(S,'vissue',20,14);marker(R,'vlocal',-38,-38);rdReset();})();
function boothPrice(n){return Math.round(n*BOOTH.mult);}
function boothPay(n){const p=boothPrice(n);if(coins<p){toast('Il te faut '+p+' 🪙.');return false;}coins-=p;BOOTH.till+=p;return true;}
function guardFree(){return GUARDS.find(function(G){return G.stun<=0&&!G.tail;});}
function openPupitre(){
 const em=boothPrice(rank>=1?40:25),tl=boothPrice(rank>=1?50:35),sv=boothPrice(35),fr=boothPrice(55);
 const B=[{t:'🙈 Fermer les yeux 40 s ('+em+' 🪙)',dis:coins<em,f:function(){if(!boothPay(rank>=1?40:25))return;GUARDS.forEach(function(g){g.stun=Math.max(g.stun,40);});toast('💼 Tous les vigiles ferment les yeux 40 s. Pas vu, pas pris.');}}];
 if(rank>=1){
  B.push({t:'🕵️ Faire surveiller un employé ('+sv+' 🪙)',dis:coins<sv,f:function(){const G=guardFree();if(!G){toast('Aucun vigile disponible.');return;}const E=EMP.filter(function(e){return !(e.out>0);}).slice(0,6);
   dlg('🕵️ Qui surveiller ?','Le vigile file l\'employé 60 s : s\'il fait une bêtise, blâme à la clé.',E.map(function(e){return {t:e.name,dis:coins<sv,f:function(){if(!boothPay(35))return;G.tail=true;G.stun=999;G.g.visible=false;TAILS.push({G:G,e:e,t:60,a:0,k:'watch'});toast('💼 Le vigile suit '+e.name+' pendant 60 s.');}};}).concat([{t:'Annuler'}]));}});
  B.push({t:'🪤 Piéger un employé ('+fr+' 🪙)',dis:coins<fr,f:function(){const E=EMP.filter(function(e){return !(e.out>0);}).slice(0,6);
   dlg('🪤 Qui piéger ?','Le vigile glisse un produit dans son sac puis le « découvre » : blâme. Risque : 20 % que ça se sache.',E.map(function(e){return {t:e.name,dis:coins<fr,f:function(){if(!boothPay(55))return;e.noF=30;setTimeout(function(){},0);BOOTH.frame=BOOTH.frame||[];BOOTH.frame.push({e:e,t:12});toast('💼 Le vigile prépare le coup contre '+e.name+'…');}};}).concat([{t:'Annuler'}]));}});
 }
 B.push({t:'Fermer'});
 dlg('💼 Pupitre de sécurité','Le vigile de service rend quelques services… contre des pièces (tarif ×'+BOOTH.mult+').',B);}
function boothTick(dt){if(RD.cd>0){RD.cd-=dt;if(RD.cd<=0&&RD.mk[0])RD.mk[0].off=false;}zapTick(dt);dogTick(dt);arrTick(dt);mgrTheftTick(dt);survTick(dt);fidgetAll(dt);
 if(BOOTH.frame)for(let i=BOOTH.frame.length-1;i>=0;i--){const q=BOOTH.frame[i];q.t-=dt;if(q.t<=0){BOOTH.frame.splice(i,1);const e=q.e;if(Math.random()<.2){RESULT=Math.max(0,RESULT-6);toast('🪤 Le coup monté contre '+e.name+' s\'est ébruité : Résultats −6.');}else{addBl(e);say(e.g,'C\'est pas à moi !');RESULT=Math.min(100,RESULT+3);toast('🪤 '+e.name+' est tombé dans le piège : blâme. Résultats +3.');}}}
 const gb=$('bGadget');if(gb)gb.hidden=!(SEC&&mode==='zone'&&!CINE&&!uiOpen);
 for(const k in VG.cd)if(VG.cd[k]>0)VG.cd[k]-=dt;
 if(WCIN===null&&SEC)BOOTH.mc.off=BOOTH.till<=0;}
function nearTarget(){let b=null,bd=3.2,kind=null;EMP.forEach(function(e){if(e.zn!==cur||e.out>0)return;const d=Math.hypot(e.x-pp.x,e.z-pp.z);if(d<bd){bd=d;b=e;kind='e';}});MGR.forEach(function(m){if(m.zn!==cur||m.fired)return;const d=Math.hypot(m.x-pp.x,m.z-pp.z);if(d<bd){bd=d;b=m;kind='m';}});return b?{o:b,k:kind}:null;}
function gadgetMenu(){
 const G=LK.sim?3:GRADE,B=[],cd=function(k){return Math.max(0,Math.ceil(VG.cd[k]||0));};
 const afford=function(n){if(n<=0||coins>=n)return true;toast('Il te faut '+n+' 🪙.');return false;},spend=function(n){if(n>0)coins-=n;};
 const add=function(k,t,lv,f,pr){const c=cd(k);pr=pr||0;B.push({t:(G<lv?'🔒 ':'')+t+(pr?' · '+pr+' 🪙':'')+(c>0?' ('+c+' s)':G<lv?' — grade '+GN[lv]:''),dis:G<lv||c>0||coins<pr,f:function(){f();}});};
 add('talkie','📻 Talkie-walkie : tous les vigiles te rejoignent',0,function(){if(!afford(60))return;spend(60);VG.cd.talkie=90;GUARDS.forEach(function(g){if(g.tail)return;g.zn!==cur?0:0;if(g.zn===cur){g.path=path(Z[g.zn],g.x,g.z,pp.x,pp.z);g.pi=0;g.wait=0;}});toast('📻 Les vigiles de la zone convergent vers toi.');},60);
 add('taser','⚡ Taser : 1 min, dans le dos d\'un suspect = paralysé 10 s',1,function(){if(!afford(80))return;spend(80);VG.cd.taser=180;VG.tz=60;pop('⚡ Taser armé pendant 1 minute : approche-toi dans le dos de quelqu\'un','good');},80);
 add('chien','🐕 Chien renifleur : 30 s, rechargement 3 min',2,function(){if(!afford(100))return;if(dogCall()){spend(100);VG.cd.chien=180;}},100);
 add('menottes','⛓️ Menottes : emmène le voleur au pupitre (1×/min)',3,function(){const T2=nearTarget();if(!T2){toast('Personne à portée.');return;}const o=T2.o;if(ARR.on){toast('Une arrestation est déjà en cours.');return;}if(!(o.loot||o.pfl)){toast('Rien contre '+o.name+' : fouille-le d\'abord (ou laisse le chien le repérer).');return;}if(o.loot){if(T2.k==='e')fouilleE(o);else fouilleM(o);}if(!afford(50))return;spend(50);VG.cd.menottes=90;say(pl,'Les mains dans le dos !');say(o.g,'Pitié, pas les menottes !');arrestStart(o,T2.k);},50);
 B.push({t:'🗣️ Interroger la cible proche · 10 🪙'+(cd('interro')>0?' ('+cd('interro')+' s)':''),dis:coins<10||cd('interro')>0,f:function(){if(!nearTarget()){toast('Personne à portée à interroger.');return;}if(!afford(10))return;spend(10);VG.cd.interro=30;interroge(true);}});
 B.push({t:'Fermer'});
 dlg('🎒 Gadgets du vigile','Grade : '+GN[G]+(LK.sim?' (simulation : tout est débloqué)':'')+'. Les gadgets se débloquent en montant en grade.',B);}
const ZAPS=[],CUFFS=[];let DOG=null;
