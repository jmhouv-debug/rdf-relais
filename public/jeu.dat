 for(let i=0;i<2;i++)if(WCS[i]>0){WCST[i]-=dt;if(WCST[i]<=0){WCS[i]=0;setScotch(i,false);const E=EMP.filter(function(e){return !(e.out>0);});if(E.length){const v=E[(Math.random()*E.length)|0];imgHit(v,10);pop('💦 '+v.name+' n\'a pas pu entrer dans la cabine « Hors service » : accident ! −10 Sérieux','bad');}}}
