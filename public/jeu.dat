  zn.g.add(g);const m={zone:zn,obj:obj,x:x,z:z,g:g,disc:disc,ring:ring,lb:lb,txt:txt||k[1],done:false,cool:0,off:false,prog:0,touch:0,spot:null};zn.markers.push(m);return m;}
