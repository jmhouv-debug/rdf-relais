const WAND=[];
function wander(zn,pts,col,spd,fem){const c=makeChar({shirt:col,pants:[0x2b2f36,0x3b4a66,0x5a4a3a][WAND.length%3],hair:[0x3a2a1a,0xb5651d,0x222222,0xd9b27c][WAND.length%4],fem:fem});Z[zn].g.add(c);c.position.set(pts[0][0],0,pts[0][1]);WAND.push({g:c,pts:pts,i:1,spd:spd,w:Math.random()*2,zn:zn});}
let COLD=0;const FRZ={x:[-26,-19.6],z:[-53,-45.6]};
function inFrz(x,z){return x>FRZ.x[0]&&x<FRZ.x[1]&&z>FRZ.z[0]&&z<FRZ.z[1];}
function coldTick(dt){
 const arr=EMP.concat(NPC);for(let k=0;k<arr.length;k++){const n=arr[k];if(!n||!n.g||n.zn!=='reserve')continue;
  if(inFrz(n.x,n.z)){n.cold=(n.cold||0)+dt;try{n.g.rotation.z=Math.sin(clk*46+k)*.07;n.g.position.x=n.x+Math.sin(clk*53+k*2)*.04;}catch(_){}
   if(n.cold>1.2&&!n.coldSaid){n.coldSaid=1;say(n.g,['🥶 Brrr… quel froid !','🥶 J\'en peux plus, je gèle…','🥶 Et en plus j\'ai envie de pisser !'][(Math.random()*3)|0]);}
   if(n.cold>7&&n.trip&&n.trip.ph==='stay'&&n.trip.left>0){n.trip.left=0;}}
  else if(n.cold){n.cold=0;n.coldSaid=0;try{n.g.rotation.z=0;}catch(_){}}}
 if(cur==='reserve'&&mode==='zone'&&inFrz(pp.x,pp.z)){const w=COLD<15;COLD+=dt;if(w&&COLD>=15)pop('🥶 Tu gèles : tu avances au ralenti et tu as très envie de faire pipi. Sors de la chambre froide !','bad');
  URG=Math.min(100,URG+dt*(COLD>15?6:3));try{pl.rotation.z=Math.sin(clk*46)*.05;}catch(_){}}
 else if(COLD>0){COLD=Math.max(0,COLD-dt*2);try{pl.rotation.z=0;}catch(_){}}}
function newZTick(dt){for(let k=0;k<WAND.length;k++){const q=WAND[k];if(cur!==q.zn)continue;if(q.w>0){q.w-=dt;continue;}const t=q.pts[q.i],dx=t[0]-q.g.position.x,dz=t[1]-q.g.position.z,d=Math.hypot(dx,dz);if(d<.15){q.i=(q.i+1)%q.pts.length;q.w=1.5+Math.random()*3;continue;}q.g.position.x+=dx/d*q.spd*dt;q.g.position.z+=dz/d*q.spd*dt;q.g.rotation.y=Math.atan2(dx,dz);}}
