function taserHit(o,k){const t=10;if(k==='m'){o.stun=Math.max(o.stun||0,t);}else{o.wait=t;o.path=null;}
 const zg=zapMk();o.g.add(zg);ZAPS.push({o:o,t:t,g:zg});VG.tzcd=6;say(o.g,'AAAARGH !');say(pl,'⚡ Bzzzt !');}
function hideTick(dt){EMP.forEach(function(e){if(e.hide>0){e.hide-=dt;if(e.hide<=0){e.hide=0;e.loot=0;}}});}
function zapTick(dt){hideTick(dt);if(VG.tz>0)VG.tz-=dt;if(VG.tzcd>0)VG.tzcd-=dt;
 for(let i=ZAPS.length-1;i>=0;i--){const z=ZAPS[i];z.t-=dt;
  try{z.g.children.forEach(function(b,j){b.position.set((Math.random()-.5)*.7,.2+Math.random()*1.5,(Math.random()-.5)*.6);b.rotation.z=(Math.random()-.5)*1.4;b.visible=((clk*30+j*7)|0)%3!==0;});z.o.g.rotation.z=Math.sin(clk*45)*.07;}catch(e){}
  if(z.t<=0||(z.o.fired)){try{z.o.g.remove(z.g);z.o.g.rotation.z=0;}catch(e){}ZAPS.splice(i,1);}}
 for(let i=CUFFS.length-1;i>=0;i--){const c=CUFFS[i];c.t-=dt;if(c.t<=0||c.o.fired){cuffOff(c.o);CUFFS.splice(i,1);}}}
function cuffOn(o,k,dur){dur=dur||20;const u=o.g.userData;if(!u||!u.arms)return;u.cuff=1;if(!u.cuffs){u.cuffs=[];[0,1].forEach(function(i){const c=new T.Mesh(new T.BoxGeometry(.22,.1,.22),new T.MeshBasicMaterial({color:0xb4bac5}));c.position.set(0,-.62,0);u.arms[i].add(c);u.cuffs.push(c);});}
 u.cuffs.forEach(function(c){c.visible=true;});if(k==='m')o.stun=Math.max(o.stun||0,dur);else{o.wait=Math.max(o.wait||0,dur);o.path=null;}CUFFS.push({o:o,t:dur});}
function cuffOff(o){const u=o.g&&o.g.userData;if(!u||!u.arms)return;u.cuff=0;if(u.cuffs)u.cuffs.forEach(function(c){c.visible=false;});u.arms[0].rotation.z=0;u.arms[1].rotation.z=0;}
function dogMake(){const g=new T.Group(),c=0xa5703a;box(g,.4,.4,.9,c,0,.55,0,true);box(g,.38,.36,.4,c,0,.8,.55,true);box(g,.2,.16,.22,0x2a1a10,0,.74,.82,false);box(g,.1,.2,.08,0x6b4220,.15,1.02,.5,false);box(g,.1,.2,.08,0x6b4220,-.15,1.02,.5,false);box(g,.1,.1,.4,c,0,.72,-.6,false);
 [[.15,.3],[-.15,.3],[.15,-.3],[-.15,-.3]].forEach(function(p){box(g,.1,.4,.1,0x8a5a2b,p[0],.2,p[1],false);});return g;}
function dogList(zn){const L=[];EMP.forEach(function(e){if(e.zn===zn&&!(e.out>0)&&!e.fired)L.push(e);});MGR.forEach(function(m){if(m.zn===zn&&!m.fired)L.push(m);});return L;}
function dogQueue(d){const L=dogList(d.zn).filter(function(o){return d.seen.indexOf(o.name)<0;});L.sort(function(a,b){return Math.hypot(a.x-pp.x,a.z-pp.z)-Math.hypot(b.x-pp.x,b.z-pp.z);});d.q=L.slice(0,10);d.i=0;d.st='go';d.path=null;}
function dogCall(){if(DOG&&DOG.on){toast('Le chien est déjà au travail.');return false;}
 const g=dogMake();Z[cur].g.add(g);DOG={on:true,zn:cur,x:pp.x+1.2,z:pp.z,hd:0,ph:0,path:null,pi:0,rp:0,q:[],i:0,st:'go',tm:0,t:30,idle:30,g:g,found:0,seen:[]};dogQueue(DOG);say(pl,'Rex ! Cherche !');return true;}
function dogEnd(){const d=DOG;if(!d)return;try{Z[d.zn].g.remove(d.g);}catch(e){}DOG=null;toast(d.found?'🐕 Le chien repart : '+d.found+' suspect'+(d.found>1?'s':'')+' repéré'+(d.found>1?'s':'')+'.':'🐕 Le chien repart : rien à signaler.');}
function dogProof(o){try{if(o.pfl)o.g.remove(o.pfl);const b=label('🎁',{sx:.8,sy:.8,w:96,h:96,size:58,bg:'rgba(255,169,77,.96)'});b.position.set(0,3.0,0);o.g.add(b);o.pfl=b;setTimeout(function(){try{o.g.remove(b);if(o.pfl===b)o.pfl=null;}catch(e){}},9000);}catch(e){}}
function dogTick(dt){const d=DOG;if(!d||!d.on)return;d.t-=dt;if(d.t<=0){dogEnd();return;}
 if(cur!==d.zn&&mode==='zone'){try{Z[d.zn].g.remove(d.g);}catch(e){}d.zn=cur;Z[cur].g.add(d.g);d.x=pp.x+1;d.z=pp.z+1;d.path=null;d.idle=30;dogQueue(d);}
 if(d.i>=d.q.length){d.idle-=dt;if(d.idle<=0){dogEnd();return;}
  const dist=Math.hypot(pp.x-d.x,pp.z-d.z);if(dist>2.5){d.x+=(pp.x-d.x)/dist*5*dt;d.z+=(pp.z-d.z)/dist*5*dt;d.hd=Math.atan2(pp.x-d.x,pp.z-d.z);d.ph+=dt*10;}else d.ph+=dt*2;
  try{d.g.position.set(d.x,Math.abs(Math.sin(d.ph))*.08,d.z);d.g.rotation.y=d.hd;}catch(e){}return;}
 const o=d.q[d.i];if(!o||o.fired||o.out>0||o.zn!==d.zn){d.i++;d.st='go';d.path=null;return;}
 if(d.st==='go'){d.gt=(d.gt||0)+dt;const dist=Math.hypot(o.x-d.x,o.z-d.z);if(d.gt>7){d.x=o.x-.8;d.z=o.z;d.gt=0;}if(dist<1.2){d.st='sniff';d.tm=1.2;d.gt=0;}
  else{d.rp-=dt;if(!d.path||d.pi>=d.path.length||d.rp<=0){d.rp=.6;d.path=path(Z[d.zn],d.x,d.z,o.x,o.z);d.pi=0;if(!d.path){d.x+=(o.x-d.x)/dist*5.5*dt;d.z+=(o.z-d.z)/dist*5.5*dt;d.hd=Math.atan2(o.x-d.x,o.z-d.z);d.ph+=dt*10;}}else{follow(d,dt,5.5);d.ph+=dt*4;}}}
 else if(d.st==='sniff'){d.tm-=dt;d.hd=Math.atan2(o.x-d.x,o.z-d.z);if(d.tm<=0){d.seen.push(o.name);if(!!o.loot&&!(o.hide>0)){d.found++;if(!(o.flee>0))evStart(o,25,true,{x:pp.x,z:pp.z,d:5});say(d.g,'🐕 WOUF ! WOUF !');say(o.g,'Oh non…');say(pl,'🐕 Le chien aboie contre '+o.name+' !');d.st='bark';d.bk=0;d.msg=6;}else{d.i++;d.st='go';d.path=null;if(d.i>=d.q.length)d.idle=30;}}}
 else if(d.st==='bark'){d.bk+=dt;d.msg-=dt;d.hd=Math.atan2(o.x-d.x,o.z-d.z);
  {const dd=Math.hypot(pp.x-o.x,pp.z-o.z)||1;d.x+=((o.x+(pp.x-o.x)/dd*1.1)-d.x)*Math.min(1,dt*6);d.z+=((o.z+(pp.z-o.z)/dd*1.1)-d.z)*Math.min(1,dt*6);}
  if(d.msg<=0){d.msg=6;say(pl,'🐕 Le chien aboie contre '+o.name+' !');say(d.g,'WOUF !');}
  if(Math.hypot(pp.x-o.x,pp.z-o.z)<3||d.bk>75||!o.loot||o.hide>0){d.i++;d.st='go';d.path=null;if(d.i>=d.q.length)d.idle=30;}}
 try{d.g.position.set(d.x,d.st==='bark'?Math.abs(Math.sin(clk*14))*.18:Math.abs(Math.sin(d.ph))*.1,d.z);d.g.rotation.y=d.hd;}catch(e){}}
const ARR={on:false};let POLM=null;
function arrChars(){if(POLM)return POLM;const mk=function(sh,fem,n,pre){const c=makeChar({shirt:sh,pants:0x1b2540,hair:0x222222,badge:1,cap:sh,fem:fem?1:0,hs:fem?'long':undefined});empTag(c,n,pre);c.visible=false;S.g.add(c);return c;};
 POLM=[mk(0x1d3b8b,0,'Duval','Gendarme '),mk(0x1d3b8b,1,'Morel','Gendarme '),mk(0x7b1d3a,1,'directrice','La ')];return POLM;}
function arrMove(c,tx,tz,dt,ph){try{const dx=tx-c.position.x,dz=tz-c.position.z,d=Math.hypot(dx,dz);if(d<.15){return true;}const st=Math.min(d,6*dt);c.position.x+=dx/d*st;c.position.z+=dz/d*st;c.rotation.y=Math.atan2(dx,dz);walkAnim(c,ph,1);return false;}catch(e){return true;}}
function arrestStart(o,k){if(ARR.on)return false;const P=arrChars();if(cur!=='store')enter('store');
 if(o.zn!=='store'){try{Z[o.zn].g.remove(o.g);}catch(e){}o.zn='store';S.g.add(o.g);}
 pp.x=26.3;pp.z=14;o.x=27.9;o.z=14;o.path=null;try{o.g.position.set(o.x,0,o.z);}catch(e){}
 cuffOn(o,k,30);if(k==='m')o.stun=Math.max(o.stun||0,30);else o.wait=30;
 const price=Math.round(8+Math.random()*22);ARR.on=true;ARR.t=0;ARR.o=o;ARR.k=k;ARR.price=price;ARR.ph=0;ARR.done=false;
 [[0,12.4],[1.4,12.4],[-1.4,12.4]].forEach(function(p,i){try{P[i].position.set(p[0],0,p[1]);P[i].visible=true;}catch(e){}});
 say(pl,'Gendarmerie ? J\'ai un voleur au pupitre !');pop('🚔 Arrestation : la gendarmerie arrive au pupitre…','good');return true;}
function arrEnd(){const P=POLM||[];P.forEach(function(c){try{c.visible=false;}catch(e){}});const o=ARR.o;if(o){cuffOff(o);const i=CUFFS.findIndex(function(c){return c.o===o;});if(i>=0)CUFFS.splice(i,1);o.wait=0;if(ARR.k==='m')o.stun=0;}ARR.on=false;ARR.o=null;}
function arrTick(dt){if(!ARR.on)return;ARR.t+=dt;ARR.ph+=dt*8;const P=arrChars(),o=ARR.o,t=ARR.t;
 if(t<5.5){arrMove(P[0],25.4,13.6,dt,ARR.ph);arrMove(P[1],29,13.8,dt,ARR.ph);arrMove(P[2],27.1,12.2,dt,ARR.ph);}
 else if(t<9){if(!ARR.s1){ARR.s1=1;say(P[0],'Gendarmerie ! Vous êtes en état d\'arrestation !');say(P[2],'Encore un voleur dans MON magasin !');say(o.g,'Je suis innocent !');}}
 else{if(!ARR.done){ARR.done=true;const fine=Math.max(10,Math.round(ARR.price*1.5));
   if(ARR.k==='e'){addBl(o);o.noF=90;}else{hitMgr(o,35);}
   RESULT=Math.min(100,RESULT+8);coins+=10+Math.round(ARR.price/2);gradeXp();
   say(P[2],'Blâme ! Et vous payez l\'amende !');say(o.g,'Mon portefeuille…');
   pop('🚔 '+o.name+' embarqué : amende '+fine+' 🪙 + objet volé '+ARR.price+' 🪙. Prime d\'arrestation pour toi !','good');}
  if(t<13){arrMove(P[0],0,12.4,dt,ARR.ph);arrMove(P[1],0,12.4,dt,ARR.ph);arrMove(P[2],0,12.4,dt,ARR.ph);try{o.x=P[0].position.x+1;o.z=P[0].position.z;o.g.position.set(o.x,0,o.z);}catch(e){}}
  else arrEnd();}}
let NPCPR=0;const NPCST={n:0,flee:0};
function npcMv(n,dt,spd,run){const done=follow(n,dt,spd);if(!done){n.g.rotation.y=angLerp(n.g.rotation.y,n.hd,1-Math.exp(-dt*8));walkAnim(n.g,n.ph,run?1.5:1);}else{walkAnim(n.g,0,0);}n.g.position.set(n.x,0,n.z);return done;}
function npcSpot(n){let b=null,bd=-1;const L=[];NPC.forEach(function(q){if(q.wp)q.wp.forEach(function(w){L.push(w);});});L.forEach(function(w){const d=Math.hypot(w[0]-pp.x,w[1]-pp.z)+Math.random()*4-Math.hypot(w[0]-n.x,w[1]-n.z)*.15;if(d>bd){bd=d;b=w;}});return b;}
function thrOf(e){let b=null,bd=99;const all=[];
 if(SEC&&mode==='zone'&&cur===e.zn){const d=Math.hypot(e.x-pp.x,e.z-pp.z);all.push([pp.x,pp.z]);if(d<bd){bd=d;b={d:d,x:pp.x,z:pp.z};}}
 GUARDS.forEach(function(g){if(g.zn!==e.zn||g.stun>0||g.tail)return;const d=Math.hypot(e.x-g.x,e.z-g.z);all.push([g.x,g.z]);if(d<bd){bd=d;b={d:d,x:g.x,z:g.z};}});
 if(DOG&&DOG.on&&DOG.zn===e.zn){const d=Math.hypot(e.x-DOG.x,e.z-DOG.z);all.push([DOG.x,DOG.z]);if(d<bd){bd=d;b={d:d,x:DOG.x,z:DOG.z};}}
 if(b)b.all=all;return b;}
function isThief(e){return (typeof e.loot==='number'?e.loot>0:!!e.loot)&&!(e.hide>0);}
function fleeSpot(e,t){const zn=Z[e.zn],b=zn.bounds;let best=null,bs=-1;
 for(let i=0;i<8;i++){const a=Math.random()*6.283,r=4+Math.random()*6,x=e.x+Math.cos(a)*r,z=e.z+Math.sin(a)*r;
  if(x<b.x[0]+1||x>b.x[1]-1||z<b.z[0]+1||z>b.z[1]-1||hit(x,z,.5,zn))continue;
  let sc=1e9;(t.all||[[t.x,t.z]]).forEach(function(q){sc=Math.min(sc,Math.hypot(x-q[0],z-q[1]));});sc+=Math.random()*2;if(sc>bs){bs=sc;best=[x,z];}}
 return best;}
function evStart(e,dur,thief,t){e.flee=dur;e.fth=!!thief;e.fpick=0;e.tk=null;e.path=null;e.fd=null;if(thief)NPCST.flee++;
 if(Math.random()<.5)say(e.g,thief?['Il me cherche ?!','Je me casse !','Pas question qu\'il me fouille !','Oh là là, il arrive…'][(Math.random()*4)|0]:['Bon, j\'y vais…','Je vais voir ailleurs.','Je ne fais rien de mal !'][(Math.random()*3)|0]);}
function evStop(e,cd){e.flee=0;e.path=null;e.fcd=cd||0;e.wait=Math.max(e.wait||0,0);}
function evade(e,dt){if(!e.name||e.out>0||e.help||e.fired)return false;
 if(e.fcd>0)e.fcd-=dt;
 if(mode!=='zone'||cur!==e.zn){e.flee=0;return false;}
 const t=thrOf(e);
 if(!(e.flee>0)){
  if(!t||t.d>10){e.vseen=false;return false;}
  if(isThief(e)){if(t.d<8&&!(e.fcd>0))evStart(e,25,true,t);}
  else if(t.d<6&&!e.vseen){e.vseen=true;if(!(e.fcd>0)&&Math.random()<.65)evStart(e,7+Math.random()*4,false,t);}
 }
 if(!(e.flee>0))return false;
 e.flee-=dt;if(e.fth&&!isThief(e)){evStop(e,6);return false;}
 if(e.flee<=0){evStop(e,e.fth?4:20);return false;}
 e.fpick-=dt;
 const tt=t||{x:pp.x,z:pp.z,d:20};
 if(!e.path||e.pi>=e.path.length||(e.fpick<=0&&tt.d<5)){e.fpick=1.6;const w=fleeSpot(e,tt);let pa=null;if(w)pa=path(Z[e.zn],e.x,e.z,w[0],w[1]);if(pa){e.path=pa;e.pi=0;}else if(!e.path){evStop(e,3);return false;}}
 follow(e,dt,e.fth?3.0:2.6);
 try{e.g.rotation.y=angLerp(e.g.rotation.y,e.hd,1-Math.exp(-dt*8));walkAnim(e.g,e.ph,1);e.g.position.set(e.x,0,e.z);}catch(_){}
 return true;}

/* ---------- allers-retours des employes PNJ : magasin <-> reserve / bureaux (parfois en courant) ---------- */
const TRIPD={reserve:{out:[-26.4,-8.3],arr:[8,-27.2]},office:{out:[38.2,16.5],arr:[19.4,-27.2]}};
function tripSpot(zn){if(zn==='reserve'&&Math.random()<.2)return [[-22.4,-48.1],[-22.8,-46],[-21.5,-47.5]][(Math.random()*3)|0];const b=Z[zn].bounds;for(let k=0;k<14;k++){const x=b.x[0]+2+Math.random()*(b.x[1]-b.x[0]-4),z=b.z[0]+2+Math.random()*(b.z[1]-b.z[0]-4);if(hit(x,z,.5,Z[zn]))continue;return [x,z];}return null;}
function tripGo(n,tx,tz,run){const zn=Z[n.zn];const pa=path(zn,n.x,n.z,tx,tz);if(!pa)return false;n.path=pa;n.pi=0;n.rn=!!run;return true;}
function tripMove(n,dt){const done=follow(n,dt,n.rn?3.3:1.5);try{n.g.rotation.y=angLerp(n.g.rotation.y,n.hd,1-Math.exp(-dt*8));walkAnim(n.g,n.ph,done?0:(n.rn?1.5:1));n.g.position.set(n.x,0,n.z);}catch(_){}return done;}
function tripMoveTo(n,zn){try{if(n.g.parent)n.g.parent.remove(n.g);Z[zn].g.add(n.g);}catch(_){}n.zn=zn;}
function tripTick(n,dt){if(globalThis.__nonpc||!n.name||n.help||n.out>0||n.xtraOff)return false;
 if(!n.trip){
  if(n.zn!=='store'||n.f||n.tk||n.flee>0||n.loot||MEET.on||ALM.t>0)return false;
  n.tpc=(n.tpc===undefined?6+Math.random()*30:n.tpc)-dt;if(n.tpc>0)return false;
  const away=NPC.filter(function(q){return q.trip;}).length;if(away>=6){n.tpc=10;return false;}
  const dz=Math.random()<.55?'reserve':'office',D0=TRIPD[dz];n.trip={ph:'out',dz:dz,t:0};
  if(!tripGo(n,D0.out[0],D0.out[1],Math.random()<.3)){n.trip=null;n.tpc=20;return false;}
  say(n.g,['Je vais à la '+(dz==='reserve'?'réserve':'pause')+' !','Je reviens…','Faut que j\'aille chercher un truc'][(Math.random()*3)|0]);return true;}
 const T=n.trip;
 if(n.f){walkAnim(n.g,0,0);return true;}
 if(T.ph==='out'){if(!n.path||n.pi>=n.path.length){n.tpc=0;}if(tripMove(n,dt)||!n.path){const D0=TRIPD[T.dz];tripMoveTo(n,T.dz);n.x=D0.arr[0];n.z=D0.arr[1];n.path=null;T.ph='stay';T.left=22+Math.random()*30;T.wait=.3;T.spot=0;n.g.position.set(n.x,0,n.z);}return true;}
 if(T.ph==='stay'){T.left-=dt;if(T.left<=0){T.ph='back';const D0=TRIPD[T.dz];if(!tripGo(n,D0.arr[0],D0.arr[1],Math.random()<.35)){T.ph='ret';}return true;}
  if(n.path&&n.pi<n.path.length){tripMove(n,dt);return true;}
  T.wait-=dt;walkAnim(n.g,0,0);if(T.wait>0)return true;
  const sp=(T.dz==='office'&&Math.random()<.3&&CAB&&CAB.length)?[CAB[(Math.random()*CAB.length)|0].cx,-35.2]:tripSpot(T.dz);
  if(sp&&tripGo(n,sp[0],sp[1],Math.random()<.2)){T.wait=1+Math.random()*3.5;if(sp.length&&T.dz==='office'&&sp[1]===-35.2)say(n.g,'🚽 Toilettes…');}else T.wait=1.5;return true;}
 if(T.ph==='back'){if(tripMove(n,dt)||!n.path)T.ph='ret';return true;}
 if(T.ph==='ret'){const o=n.trip;tripMoveTo(n,'store');n.x=TRIPD[o.dz].out[0];n.z=TRIPD[o.dz].out[1];n.g.position.set(n.x,0,n.z);n.trip=null;n.path=null;n.pi=0;n.wait=1;n.tpc=35+Math.random()*60;n.rn=false;return true;}
 return false;}
function workIcons(){EMP.forEach(function(e){if(!e.wi)return;e.wi.visible=e.zn===cur&&mode==='zone'&&!e.f&&!(e.out>0)&&(!!e.static||(e.tk&&e.tk.ph==='do'&&(e.tk.k==='stock'||e.tk.k==='tidy')));});}
function npcTask(n,dt){if(globalThis.__nonpc||!n.name||n.hos||MEET.on||ALM.t>0||n.help||n.flee>0)return false;
 if(!n.tk){n.tkc=(n.tkc===undefined?1+Math.random()*4:n.tkc)-dt;if(n.tkc>0)return false;n.tkc=3+Math.random()*6;
  shInit();const r=Math.random(),others=NPC.filter(function(q){return q!==n&&q.name&&!q.help&&Math.hypot(q.x-n.x,q.z-n.z)<14;});
  let tk=null;
  if(r<.55){let b=null,bs=101;SHV.forEach(function(m){if(m.stock<bs&&Math.hypot(m.x-n.x,m.z-n.z)<30){bs=m.stock;b=m;}});if(b)tk={k:'stock',x:b.x,z:b.z,m:b,t:7+Math.random()*8,msg:'📦 Je remplis le rayon'};}
  else if(r<.68&&others.length){const q=others[(Math.random()*others.length)|0];tk={k:'chat',x:q.x+.9,z:q.z,q:q,t:2,msg:'Dis, t\'as vu le planning ?'};}
  else if(r<.78&&clk>=NPCPR&&MESS.length<3){const m=SHV[(Math.random()*SHV.length)|0];tk={k:'prank',x:m.x,z:m.z,m:m,t:2,msg:'🤫 Personne ne regarde…'};}
  else{const w=n.wp[(Math.random()*n.wp.length)|0];tk={k:'tidy',x:w[0],z:w[1],t:4+Math.random()*3,msg:'🧹 Je range un peu'};}
  if(!tk)return false;
  n.path=path(S,n.x,n.z,tk.x,tk.z);if(!n.path){return false;}n.pi=0;tk.ph='go';n.tk=tk;}
 const tk=n.tk;
 if(tk.ph==='go'){const done=npcMv(n,dt,1.9,false);if(done||(n.path&&n.pi>=n.path.length)){tk.ph='do';n.path=null;say(n.g,tk.msg);if((tk.k==='stock'||tk.k==='tidy')&&!n.wi){n.wi=label('📦',{sx:.95,sy:.95,w:96,h:96,size:62,bg:'rgba(0,0,0,0)',depth:false});n.wi.position.set(0,3.45,0);n.wi.visible=false;n.g.add(n.wi);}}return true;}
 tk.t-=dt;walkAnim(n.g,0,0);n.g.position.set(n.x,0,n.z);
 if(tk.t<=0){
