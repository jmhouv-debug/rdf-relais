/* ----- Reserve agrandie (v196) : halle epicerie/liquides au nord, route d'acces camions a l'ouest, petite cour ----- */
(function(){
  const g=R.g,base=R.floorMesh;R.extra=[];
  function fl(w,d,x,z,tx){const m=floor(R,w,d,x,z,tx);R.extra.push(m);return m;}
  fl(21.5,18.3,-51.75,-53.35,tileTex('#cfd2d6','#b4b8be',9,7));
