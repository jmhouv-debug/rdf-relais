<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js"></script>
<script>
(function(){
'use strict';
if(!window.THREE){document.getElementById('err').hidden=false;return;}
const T=THREE,V3=T.Vector3;
const _sh=T.Color.prototype.setHex;T.Color.prototype.setHex=function(h){_sh.call(this,h);return this.convertSRGBToLinear();};
function ctex(cv){const t=new T.CanvasTexture(cv);t.encoding=T.sRGBEncoding;return t;}
const $=id=>document.getElementById(id);
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const angLerp=(a,b,t)=>{const d=((b-a+Math.PI)%(2*Math.PI)+2*Math.PI)%(2*Math.PI)-Math.PI;return a+d*t;};
let seed=7;const rnd=()=>(seed=(seed*16807)%2147483647)/2147483647;

/* ---------- rendu ---------- */
const canvas=$('c');
const renderer=new T.WebGLRenderer({canvas:canvas,antialias:true});
renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,2));
renderer.outputEncoding=T.sRGBEncoding;renderer.toneMapping=T.ACESFilmicToneMapping;renderer.toneMappingExposure=1.15;
renderer.shadowMap.enabled=true;renderer.shadowMap.type=T.PCFSoftShadowMap;
const scene=new T.Scene();scene.background=new T.Color(0xb9d3e6);
const camera=new T.PerspectiveCamera(36,1,.8,2400);
const hemi=new T.HemisphereLight(0xfff4e6,0x9aa6b6,.95);scene.add(hemi);
const sun=new T.DirectionalLight(0xffe6bf,1.45);
sun.castShadow=true;sun.shadow.mapSize.set(2048,2048);sun.shadow.bias=-.0006;
const sc=sun.shadow.camera;sc.left=-26;sc.right=26;sc.top=26;sc.bottom=-26;sc.near=1;sc.far=90;sc.updateProjectionMatrix();
scene.add(sun);scene.add(sun.target);
const ground=new T.Mesh(new T.PlaneGeometry(500,500),new T.MeshLambertMaterial({color:0xc9d6c1}));
ground.rotation.x=-Math.PI/2;ground.position.y=-.06;scene.add(ground);

/* ---------- helpers de construction ---------- */
const M={};const mat=c=>M[c]||(M[c]=new T.MeshLambertMaterial({color:c}));
const gBox=new T.BoxGeometry(1,1,1);
const gBoxR=(function(){const g=new T.BoxGeometry(1,1,1,4,4,4),P=g.attributes.position,N=g.attributes.normal,r=.07,h=.5-r,mp=function(u){const a=Math.abs(u);return Math.sign(u)*(a>.4?.5:a>.2?.42:0);};
  for(let i=0;i<P.count;i++){const x=mp(P.getX(i)),y=mp(P.getY(i)),z=mp(P.getZ(i)),cx=Math.max(-h,Math.min(h,x)),cy=Math.max(-h,Math.min(h,y)),cz=Math.max(-h,Math.min(h,z));let dx=x-cx,dy=y-cy,dz=z-cz;const l=Math.hypot(dx,dy,dz)||1;dx/=l;dy/=l;dz/=l;P.setXYZ(i,cx+dx*r,cy+dy*r,cz+dz*r);N.setXYZ(i,dx,dy,dz);}
  P.needsUpdate=true;N.needsUpdate=true;return g;})();
function box(p,w,h,d,c,x,y,z,sh){const rd=Math.max(w,h,d)<2.2&&Math.min(w,h,d)>=.1;const m=new T.Mesh(rd?gBoxR:gBox,mat(c));m.scale.set(w,h,d);m.position.set(x,y,z);if(sh){m.castShadow=true;m.receiveShadow=true;}p.add(m);return m;}
const GCS={};
function cyl(p,rt,rb,h,c,x,y,z,sh){const k='y'+rt+'_'+rb+'_'+h,m=new T.Mesh(GCS[k]||(GCS[k]=new T.CylinderGeometry(rt,rb,h,26)),mat(c));m.position.set(x,y,z);if(sh){m.castShadow=true;m.receiveShadow=true;}p.add(m);return m;}
function sph(p,r,c,x,y,z,sx,sy,sz){const k='p'+r,m=new T.Mesh(GCS[k]||(GCS[k]=new T.SphereGeometry(r,22,16)),mat(c));m.position.set(x,y,z);if(sx)m.scale.set(sx,sy,sz);p.add(m);return m;}
function half(p,r,c,x,y,z){const m=new T.Mesh(new T.SphereGeometry(r,16,10,0,Math.PI*2,0,Math.PI/2),mat(c));m.position.set(x,y,z);p.add(m);return m;}
function rr(x,a,b,w,h,r){x.beginPath();x.moveTo(a+r,b);x.arcTo(a+w,b,a+w,b+h,r);x.arcTo(a+w,b+h,a,b+h,r);x.arcTo(a,b+h,a,b,r);x.arcTo(a,b,a+w,b,r);x.closePath();}
function label(text,o){o=o||{};let w=o.w||256;const h=o.h||64;if(o.fit){try{const mc=label.mc||(label.mc=document.createElement('canvas').getContext('2d'));mc.font='600 '+(o.size||32)+'px Fredoka,system-ui,sans-serif';const tw=Math.max.apply(null,String(text).split('\n').map(function(l){return mc.measureText(l).width;}));const nw=Math.max(Math.round(h*1.3),Math.min(w,Math.ceil(tw+(o.size||32)*.9)));o=Object.assign({},o);o.sx=(o.sx||4)*nw/w;w=nw;}catch(_){}}{const gh=(o.size||32)/h*(o.sy||1)*1.18;if(gh<.27&&gh>0){const kk=Math.min(1.35,.27/gh);o=Object.assign({},o);o.sx=(o.sx||4)*kk;o.sy=(o.sy||1)*kk;}}const cv=document.createElement('canvas');cv.width=w;cv.height=h;const x=cv.getContext('2d');
  x.fillStyle=o.bg||'rgba(18,32,54,.9)';rr(x,2,2,w-4,h-4,14);x.fill();x.fillStyle=o.fg||'#fff';x.font='600 '+(o.size||32)+'px Fredoka,system-ui,sans-serif';x.textAlign='center';x.textBaseline='middle';{const L=String(text).split('\n');L.forEach(function(l,i){x.fillText(l,w/2,h/2+2+(i-(L.length-1)/2)*(o.size||32)*1.12);});}
  const s=new T.Sprite(new T.SpriteMaterial({map:ctex(cv),transparent:true,toneMapped:false,depthTest:o.depth===true}));s.scale.set((o.sx||4)*1.18,(o.sy||1)*1.18,1);return s;}
function sign(text,w,h,bg,fg){const cv=document.createElement('canvas');cv.width=512;cv.height=Math.round(512*h/w);const x=cv.getContext('2d');x.fillStyle=bg;x.fillRect(0,0,cv.width,cv.height);x.fillStyle=fg;x.font='600 '+Math.round(cv.height*.55)+'px Fredoka,system-ui,sans-serif';x.textAlign='center';x.textBaseline='middle';x.fillText(text,cv.width/2,cv.height/2+3);
  return new T.Mesh(new T.PlaneGeometry(w,h),new T.MeshBasicMaterial({map:ctex(cv),toneMapped:false}));}
function tileTex(a,b,rx,ry){const cv=document.createElement('canvas');cv.width=cv.height=256;const x=cv.getContext('2d');
  const sh=function(c,f){const n=parseInt(c.slice(1),16),r=Math.min(255,Math.round(((n>>16)&255)*f)),g=Math.min(255,Math.round(((n>>8)&255)*f)),bl=Math.min(255,Math.round((n&255)*f));return 'rgb('+r+','+g+','+bl+')';};
  x.fillStyle=b;x.fillRect(0,0,256,256);
  const fs=[1.03,.97,.99,1.02];
  for(let k=0;k<4;k++){const ox=(k%2)*128,oy=(k>>1)*128;x.fillStyle=sh(a,fs[k]);x.fillRect(ox+3,oy+3,122,122);
    const g=x.createLinearGradient(ox,oy,ox+128,oy+128);g.addColorStop(0,'rgba(255,255,255,.22)');g.addColorStop(.5,'rgba(255,255,255,0)');g.addColorStop(1,'rgba(0,0,0,.09)');x.fillStyle=g;x.fillRect(ox+3,oy+3,122,122);
    x.fillStyle='rgba(255,255,255,.28)';x.fillRect(ox+3,oy+3,122,2);x.fillRect(ox+3,oy+3,2,122);
    for(let q=0;q<26;q++){x.fillStyle='rgba(0,0,0,'+(.02+Math.random()*.03)+')';x.fillRect(ox+6+Math.random()*112,oy+6+Math.random()*112,1+Math.random()*3,1+Math.random()*2);}}
  const t=ctex(cv);t.wrapS=t.wrapT=T.RepeatWrapping;t.repeat.set(rx/2,ry/2);t.anisotropy=4;return t;}
function floor(zn,w,d,x,z,tex){const m=new T.Mesh(new T.PlaneGeometry(w,d),new T.MeshPhongMaterial({map:tex,shininess:35,specular:0x1c1c1c}));m.rotation.x=-Math.PI/2;m.position.set(x,0,z);m.receiveShadow=true;m.userData.zone=zn.id;zn.g.add(m);zn.floorMesh=m;return m;}

/* ---------- produits (instances) et ombres de contact ---------- */
function packTex(c1,c2,kind){const cv=document.createElement('canvas');cv.width=64;cv.height=96;const x=cv.getContext('2d');
  x.fillStyle=c1;x.fillRect(0,0,64,96);x.fillStyle=c2;x.fillRect(0,0,64,14);x.fillRect(0,82,64,14);x.fillStyle='rgba(255,255,255,.93)';
  if(kind===0){x.beginPath();x.arc(32,48,17,0,7);x.fill();x.fillStyle=c1;x.beginPath();x.arc(32,48,9,0,7);x.fill();}
  else if(kind===1){rr(x,10,28,44,40,7);x.fill();x.fillStyle=c2;x.fillRect(16,38,32,5);x.fillRect(16,50,24,5);}
  else if(kind===2){x.beginPath();x.moveTo(32,26);x.lineTo(54,68);x.lineTo(10,68);x.closePath();x.fill();}
  else{x.fillRect(8,32,48,7);x.fillRect(8,45,34,7);x.fillRect(8,58,42,7);}
  const t=ctex(cv);t.anisotropy=4;return t;}
const PAL=[['#e63946','#ffd6d9'],['#f4a261','#fff1dd'],['#2a9d8f','#d8fff9'],['#e9c46a','#7a4b00'],['#457b9d','#e1f3ff'],['#8ac926','#264d00'],['#9b5de5','#f0e0ff'],['#f15bb5','#fff0f8'],['#00bbf9','#d9f6ff'],['#fee440','#7a5d00'],['#ff7f50','#fff0e8'],['#2b2d42','#edf2f4']];
const PACKS=PAL.map(function(p,i){return {front:new T.MeshLambertMaterial({map:packTex(p[0],p[1],i%4)}),side:mat(parseInt(p[0].slice(1),16))};});
const prodB={},dm=new T.Object3D(),PRODI=[];
const GARM=[],GCOL=[0xe63946,0x2f80ed,0x2a9d8f,0xf4a261,0x8e44ad,0xf9d71c,0xf2f2f2,0x1d2a44,0xd2557a,0x6bbf59];
function addGarm(x,y,z){GARM.push([x,y,z,GCOL[Math.floor(rnd()*GCOL.length)]]);}
function flushGarm(g){const n=GARM.length;if(!n)return;const parts=[[.36,.4,.07,0,0],[.14,.17,.07,-.22,.1],[.14,.17,.07,.22,.1]];
  parts.forEach(function(p){const im=new T.InstancedMesh(gBox,mat(0xffffff),n);
    GARM.forEach(function(a,i){dm.position.set(a[0]+p[3],a[1]+p[4],a[2]);dm.scale.set(p[0],p[1],p[2]);dm.updateMatrix();im.setMatrixAt(i,dm.matrix);if(im.setColorAt)im.setColorAt(i,new T.Color(a[3]));});
    im.instanceMatrix.needsUpdate=true;if(im.instanceColor)im.instanceColor.needsUpdate=true;g.add(im);});}
function addProd(face,x,y,z,sx,sy,sz){const pi=Math.floor(rnd()*PACKS.length),k=pi+'_'+face;(prodB[k]=prodB[k]||[]).push([x,y,z,sx,sy,sz]);}
function flushProd(g){Object.keys(prodB).forEach(function(k){const pr=k.split('_'),pk=PACKS[+pr[0]],fi=+pr[1],arr=prodB[k];
  const ms=[pk.side,pk.side,pk.side,pk.side,pk.side,pk.side];ms[fi]=pk.front;
  const im=new T.InstancedMesh(gBox,ms,arr.length);
  arr.forEach(function(a,i){dm.position.set(a[0],a[1],a[2]);dm.scale.set(a[3],a[4],a[5]);dm.updateMatrix();im.setMatrixAt(i,dm.matrix);});
  im.instanceMatrix.needsUpdate=true;g.add(im);PRODI.push({im:im,arr:arr});});
  Object.keys(prodB).forEach(function(k){delete prodB[k];});}
const aoTex=(function(){const n=96,cv=document.createElement('canvas');cv.width=cv.height=n;const x=cv.getContext('2d'),id=x.createImageData(n,n);
  for(let j=0;j<n;j++)for(let i=0;i<n;i++){const u=(i/(n-1))*2-1,v=(j/(n-1))*2-1,r=Math.pow(Math.pow(Math.abs(u),4)+Math.pow(Math.abs(v),4),.25),t=clamp((r-.5)/.5,0,1),a=(1-t*t*(3-2*t))*255;const p=(j*n+i)*4;id.data[p]=id.data[p+1]=id.data[p+2]=0;id.data[p+3]=a;}
  x.putImageData(id,0,0);return ctex(cv);})();
function ao(g,x,z,w,d,o){const m=new T.Mesh(new T.PlaneGeometry(w,d),new T.MeshBasicMaterial({map:aoTex,transparent:true,depthWrite:false,opacity:o||.5}));m.rotation.x=-Math.PI/2;m.position.set(x,.012,z);g.add(m);}

/* ---------- personnages ---------- */
const TAGPRE=/^(Comptable|Driver|Boulanger|Boulangère|Pâtissier|Pâtissière|Poissonnier|Poissonnière|Vendeur|Vendeuse|Caissier|Caissière|Loueur|Loueuse|Gendarme|Hôtesse|Manager|Vigile|Employé|Employée) /;
function empTag(ch,n,pre){const l=label(String(n).replace(TAGPRE,''),{fit:1,sx:2.1,sy:.52,w:256,h:64,size:25,bg:'rgba(30,85,175,.93)'});l.position.y=2.65;ch.add(l);}
const GC={};
function geo(k,f){return GC[k]||(GC[k]=f());}
function tint(c,f){const r=Math.min(255,Math.round(((c>>16)&255)*f)),g=Math.min(255,Math.round(((c>>8)&255)*f)),b=Math.min(255,Math.round((c&255)*f));return (r<<16)|(g<<8)|b;}
function ell(p,r,c,x,y,z,sx,sy,sz,rx,rz){const m=new T.Mesh(geo('s'+r,function(){return new T.SphereGeometry(r,22,16);}),mat(c));m.position.set(x,y,z);m.scale.set(sx||1,sy||1,sz||1);if(rx)m.rotation.x=rx;if(rz)m.rotation.z=rz;p.add(m);return m;}
function tube(p,rt,rb,h,c,x,y,z,sx,sz,rx,rz){const m=new T.Mesh(geo('c'+rt+'_'+rb+'_'+h,function(){return new T.CylinderGeometry(rt,rb,h,22);}),mat(c));m.position.set(x,y,z);m.scale.set(sx||1,1,sz||1);if(rx)m.rotation.x=rx;if(rz)m.rotation.z=rz;p.add(m);return m;}
function makeChar(o){
  const g=new T.Group(),m=new T.Group();g.add(m);const skin=o.skin||0xf1c9a5,skinD=tint(skin,.86);
  const blob=new T.Mesh(new T.CircleGeometry(.5,22),new T.MeshBasicMaterial({color:0x000000,transparent:true,opacity:.26,depthWrite:false}));blob.rotation.x=-Math.PI/2;blob.position.y=.02;g.add(blob);
  const legs=[-1,1].map(s=>{const p=new T.Group();p.position.set(s*.16,.62,0);m.add(p);
    tube(p,.115,.095,.62,o.pants,0,-.31,0,1,1.05).castShadow=true;
    ell(p,.13,0x222831,0,-.57,.07,.95,.55,1.6);ell(p,.132,0xeceff3,0,-.605,.07,.97,.16,1.62);return p;});
  if(o.skirt)tube(m,.36,.46,.5,o.pants,0,.8,0,1,1).castShadow=true;
  const tor=tube(m,.31,.265,.72,o.shirt,0,.99,0,1,.76);tor.castShadow=true;
  ell(m,.31,o.shirt,0,1.33,0,1,.42,.76);
  ell(m,.265,o.trim||o.shirt,0,.65,0,1,.3,.76);
  tube(m,.275,.275,.09,o.trim||tint(o.pants,1.15),0,.69,0,1,.77);
  if(o.tie){box(m,.34,.07,.05,0xffffff,0,1.36,.205,false);ell(m,.07,o.tie,0,1.31,.235,1,.9,.6);box(m,.1,.52,.03,o.tie,0,1.04,.222,false);box(m,.14,.12,.03,o.tie,0,.76,.215,false);}
  if(o.blouse){box(m,.24,.52,.02,0xffffff,0,1.05,.205,false);}
  if(o.badge){box(m,.13,.09,.02,0xffffff,.17,1.2,.225,false);box(m,.2,.05,.02,0xf5b82e,0,.98,.222,false);}
  {const cc=(o.tie||o.blouse)?0xffffff:tint(o.shirt,1.12);[-1,1].forEach(function(sd){ell(m,.085,cc,sd*.095,1.4,.19,1.4,.3,.8,.3,sd*.7);});
   if(!o.tie&&!o.blouse){for(let k=0;k<4;k++){const y=1.22-k*.15,r=.265+(y-.63)/.72*.045;ell(m,.016,tint(o.shirt,.78),0,y,r*.76+.005,1,1,.5);}}
   if(!o.blouse)box(m,.1,.09,.02,tint(o.shirt,.88),-.16,1.1,.225,false);}
  const arms=[-1,1].map(s=>{const p=new T.Group();p.position.set(s*.42,1.31,0);m.add(p);
    ell(p,.105,o.shirt,0,-.01,0);tube(p,.092,.08,.5,o.shirt,0,-.27,0).castShadow=true;ell(p,.085,tint(o.shirt,.9),0,-.5,0,1,.4,1);
      const h=new T.Group();h.position.set(0,-.62,0);p.add(h);
      ell(h,.07,skin,0,-.025,0,1,1.05,.58);
      for(let k=0;k<4;k++){const L=[.062,.075,.07,.055][k];tube(h,.017,.013,L,skin,(k-1.5)*.032,-.075-L/2+.02,.012,1,1,.28);}
      tube(h,.019,.015,.06,skin,-s*.062,-.05,.035,1,1,.5,s*.55);
      return p;});
  tube(m,.095,.11,.14,skinD,0,1.45,0);
  const H=new T.Group(),hsc=o.hsc||.8;H.scale.set(hsc,hsc,hsc);H.position.y=1.45*(1-hsc);m.add(H);
  const head=ell(H,.37,skin,0,1.69,0,1,1.04,.98);head.castShadow=true;
  const eyes=[],brows=[];
  [-1,1].forEach(function(s){
    eyes.push({m:ell(H,.062,0xffffff,s*.13,1.7,.33,1,1.2,.5),y:1.2});eyes.push({m:ell(H,.038,0x1d1a1a,s*.13,1.7,.355,1,1.15,.5),y:1.15});ell(H,.012,0xffffff,s*.13+.012,1.715,.375);
    brows.push(ell(H,.05,o.hair?tint(o.hair,.8):0x3a2a20,s*.13,1.795,.335,1.7,.38,.5,0,-s*.12));
    ell(H,.05,0xf4a6a0,s*.215,1.58,.295,1,.7,.5);
    ell(H,.07,skin,s*.365,1.68,0,.7,1.1,.8);});
  ell(H,.045,tint(skin,.93),0,1.63,.355,1,.95,1.05);
  const mo=new T.Mesh(new T.TorusGeometry(.075,.014,8,14,Math.PI),mat(0x9b3d3d));mo.position.set(0,1.57,.335);mo.rotation.z=Math.PI;H.add(mo);const mOpen=ell(H,.04,0x5a1f24,0,1.54,.345,1.1,1.4,.5);mOpen.visible=false;
  if(o.cap){const d=new T.Mesh(geo('cap',function(){return new T.SphereGeometry(.415,30,18,0,Math.PI*2,0,1.62);}),mat(o.cap));d.position.set(0,1.745,-.02);d.rotation.x=-.2;d.castShadow=true;H.add(d);
    const vz=new T.Mesh(geo('vis',function(){return new T.SphereGeometry(.3,22,12,0,Math.PI*2,0,Math.PI/2);}),mat(o.cap));vz.position.set(0,1.905,.31);vz.scale.set(1.2,.26,1.15);vz.rotation.x=.22;H.add(vz);
    ell(H,.05,tint(o.cap,.85),0,2.13,-.02);if(o.sec)box(H,.16,.11,.03,0xf2c230,0,1.97,.4,false);}
  if(o.crown){const gm=mat(0xffc21a),cr=new T.Mesh(new T.CylinderGeometry(.27,.23,.17,16,1,true),gm);cr.position.set(0,2.2,-.02);H.add(cr);
    for(let k=0;k<6;k++){const a=k/6*Math.PI*2,sp=new T.Mesh(new T.ConeGeometry(.055,.17,6),gm);sp.position.set(Math.sin(a)*.25,2.35,Math.cos(a)*.25-.02);H.add(sp);const bl=new T.Mesh(new T.SphereGeometry(.03,8,6),mat(0xe53935));bl.position.set(Math.sin(a)*.25,2.45,Math.cos(a)*.25-.02);H.add(bl);}}
  if(o.hair){const hs=o.hs||'court',hc=o.hair,hl=tint(hc,1.18),hd=tint(hc,.82);
    const capH=function(r,th,tilt,y,z){const h=new T.Mesh(geo('h'+r+'_'+th,function(){return new T.SphereGeometry(r,30,20,0,Math.PI*2,0,th);}),mat(hc));h.position.set(0,y,z);h.rotation.x=tilt;h.castShadow=true;H.add(h);return h;};
    if(hs==='afro'){ell(H,.5,hc,0,2.0,-.14,1.02,.95,1);[[.0,2.42,-.1,.2],[-.36,2.3,-.08,.2],[.36,2.3,-.08,.2],[-.47,2.03,-.14,.17],[.47,2.03,-.14,.17],[0,2.26,-.4,.2],[-.3,2.12,-.4,.2],[.3,2.12,-.4,.2],[0,1.82,-.52,.2]].forEach(function(b){ell(H,b[3],hl,b[0],b[1],b[2]);});
      ell(H,.26,hd,0,1.5,-.3,1.1,.9,.8);}
    else{if(!o.cap)capH(.405,1.78,-.34,1.72,-.03);
      ell(H,.37,hc,0,1.58,-.13,1.02,.86,.75);
      [-1,1].forEach(function(sd){ell(H,.085,hc,sd*.345,1.74,.1,.55,1.5,.9);});
      if(!o.cap)for(let k=0;k<5;k++){const a=(k-2)/2*.95;ell(H,.07,hc,Math.sin(a)*.3,1.97-Math.abs(a)*.05,Math.cos(a)*.27+.01,1.3,.65,.9,-.5,a*.4);}
      if(o.bun||hs==='chignon'){ell(H,.17,hc,0,2.12,-.2);ell(H,.18,hl,0,2.13,-.2,1,.35,1);}}
    if(hs==='long'){ell(H,.36,hc,0,1.24,-.22,1.0,1.6,.52);ell(H,.3,hd,0,.95,-.24,.95,.9,.45);[-1,1].forEach(function(sd){ell(H,.13,hc,sd*.335,1.45,-.03,.55,2.1,.9);});}
    if(hs==='queue'){ell(H,.11,hc,0,1.82,-.4);ell(H,.075,hd,0,1.74,-.4,1.2,.7,1.2);tube(H,.085,.03,.56,hc,0,1.5,-.5,1,1,.28);ell(H,.05,0xe86aa6,0,1.76,-.4);}
    if(hs==='crete'){for(let k=0;k<6;k++){const a=(k-2.5)*.19;const c2=new T.Mesh(geo('cone',function(){return new T.ConeGeometry(.075,.3,10);}),mat(k%2?hc:hl));c2.position.set(0,2.07+Math.cos(a*1.4)*.05,a*1.45);c2.rotation.x=a*.9;H.add(c2);}}
  }
  if(o.bc&&o.beard){const bc=o.bc;
    if(o.beard===1||o.beard===2){ell(H,.31,bc,0,1.47,.08,1.04,.56,1.04);[-1,1].forEach(function(sd){ell(H,.1,bc,sd*.3,1.6,.06,.6,1.5,1);});}
    if(o.beard===2)ell(H,.24,bc,0,1.22,.12,.95,1.4,.8);
    if(o.beard>=1)[-1,1].forEach(function(sd){ell(H,.075,bc,sd*.075,1.615,.345,1.5,.55,.7);});}
  if(o.sec)box(m,.15,.12,.03,0xf2c230,-.17,1.2,.215,false);
  if(o.fem){[-1,1].forEach(function(sd){box(H,.1,.025,.03,0x1b1b1b,sd*.13,1.78,.37,false);});}
  if(o.bw||o.bh)m.scale.set(o.bw||1,o.bh||1,o.bw||1);
  if(o.glasses)[-1,1].forEach(function(s){const t=new T.Mesh(new T.TorusGeometry(.085,.016,8,18),mat(0x111111));t.position.set(s*.13,1.7,.355);H.add(t);});
  g.userData={o:o,m:m,legs:legs,arms:arms,eyes:eyes,brows:brows,mo:mo,mOpen:mOpen,bo:Math.random()*4};return g;
}
function setMood(c,k){const u=c.userData;if(!u.mo||u.mood===k)return;u.mood=k;const B=u.brows;
  const cfg={neutral:[-.12,0,0,1,1,1,0],happy:[-.05,.02,0,1.3,1.3,0,0],angry:[.4,-.025,1,1.05,.8,0,0],sad:[-.35,.01,1,.8,.8,0,0],surprised:[0,.05,0,1,1,0,1]}[k]||[-.12,0,0,1,1,1,0];
  B.forEach(function(b,i){const sd=i?1:-1;b.rotation.z=sd*cfg[0];b.position.y=1.795+cfg[1];});
  u.mo.visible=!cfg[6];u.mOpen.visible=!!cfg[6];u.mo.rotation.z=cfg[2]?0:Math.PI;u.mo.position.y=cfg[2]?1.525:1.57;u.mo.scale.set(cfg[3],cfg[4],1);}
function makeCart(){const c=new T.Group();
  box(c,.62,.04,.95,0x9aa3ad,0,.4,0,false);box(c,.62,.03,.8,0x9aa3ad,0,.2,0,false);
  box(c,.66,.42,.03,0xcfd6de,0,.62,.48,false);box(c,.03,.42,.95,0xcfd6de,-.32,.62,0,false);box(c,.03,.42,.95,0xcfd6de,.32,.62,0,false);box(c,.66,.3,.03,0xcfd6de,0,.58,-.46,false);
  box(c,.66,.03,.95,0xe4e9ee,0,.83,0,false);
  [-.3,.3].forEach(function(a){box(c,.035,.5,.035,0x6b7480,a,.84,-.5,false).rotation.x=-.15;box(c,.035,.22,.035,0x6b7480,a,.28,-.4,false);});
  tube(c,.022,.022,.68,0xe63946,0,1.1,-.56,1,1,0,Math.PI/2);
  [-.27,.27].forEach(function(a){[-.38,.38].forEach(function(b){tube(c,.06,.06,.05,0x222222,a,.07,b,1,1,0,Math.PI/2);});});
  const cols=[0xe63946,0xf4a261,0x2a9d8f,0xe9c46a,0x457b9d,0x8ac926,0xffffff];
  for(let k=0;k<5;k++){const q=Math.random();if(q<.45)box(c,.18+Math.random()*.12,.22+Math.random()*.1,.14+Math.random()*.1,cols[Math.floor(Math.random()*cols.length)],(Math.random()-.5)*.4,.55+Math.random()*.05,(Math.random()-.5)*.6,false);else sph(c,.1,cols[Math.floor(Math.random()*cols.length)],(Math.random()-.5)*.4,.58,(Math.random()-.5)*.6);}
  return c;}
function walkAnim(c,ph,amt){const u=c.userData;u.legs[0].rotation.x=Math.sin(ph)*.8*amt;u.legs[1].rotation.x=-Math.sin(ph)*.8*amt;u.arms[0].rotation.x=-Math.sin(ph)*.7*amt;u.arms[1].rotation.x=Math.sin(ph)*.7*amt;u.m.position.y=Math.abs(Math.sin(ph))*.07*amt;
  if(u.push){u.arms[0].rotation.x=-1.05;u.arms[1].rotation.x=-1.05;}
  if(u.cuff){u.arms[0].rotation.x=.9;u.arms[1].rotation.x=.9;u.arms[0].rotation.z=.18;u.arms[1].rotation.z=-.18;}
  if(u.eyes){const bt=(performance.now()/1000+u.bo)%4.2,bs=bt<.12?.1:1;if(bs!==u.bs){u.bs=bs;u.eyes.forEach(function(e){e.m.scale.y=e.y*bs;});}}}

