/* participants : 4 au plus pour un boss (celui qui ouvre + les plus proches, vrais joueurs d'abord) */
function qmArenaP(max,op){const L=QM.A.filter(function(a){return a.role==='emp'&&!a.out&&!a.cv&&!(a.caught>0);});if(!max||L.length<=max)return L;
  const o=op&&L.indexOf(op)>=0?op:(L.find(function(a){return a.human;})||L[0]);const po=qmP(o);
  const dist=function(a){const p=qmP(a);return (p[2]===po[2]?0:60)+Math.hypot(p[0]-po[0],p[1]-po[1]);};
  const rest=L.filter(function(a){return a!==o;}).sort(function(x,y){const hx=(x.human||x.remote)?0:1,hy=(y.human||y.remote)?0:1;return hx-hy||dist(x)-dist(y);});return [o].concat(rest).slice(0,max);}
function qmBossStart(room){if(QM.mp&&QN.client)return;const i=QM.bossN,D=QBOSS[i];if(!D)return;if(!Z.ar_pat)qmArenaInit();const zid='ar_'+D.id,zn=Z[zid];
  const P=qmArenaP(4,QM.lastOp);const n=Math.max(1,P.length);
  const m=qmBossMesh(i);const bs=zn.bs;const hp=Math.round(100*[1,1.7,2.4,3.2][i]*(.5+.3*n));
  const sh=qmBossShM(m.g);
  QM.boss={i:i,d:D,g:m.g,bar:m.bar,shM:sh,zn:zid,x:bs[0],z:bs[1],h:0,hp:hp,max:hp,ph:0,cd:0,at:99,nx:4,hitF:0,dead:0,intro:3.4,stun:0,slow:0,mins:[],rf:0,last:null,dash:null,st:'chase',lastP:'',sh:0,shMax:Math.round(6+2*n),tired:0,air:0,bt:0};
  qmArenaGo(zid,room,'boss',P);qmBossCine(i);if(QM.mp&&QN.host)qnS('bcine',{i:i});}
function qmChests(A,x,z,loot,n){A.loot=loot;A.chN=1;A.lt=0;const p=qmFree(A.zid,x,z+1.5);qmBxAdd(A.zid,p[0],p[1],0,1);}
function qmChestOpenOld(a,b){const A=QM.arena;const P=QM.A.filter(function(x){return x.zn===b.zn;});
  P.forEach(function(x){x.wl=Math.min(3,qmWl(x)+1);});
  for(let i=0;i<3;i++){const k=QCONS[(Math.random()*QCONS.length)|0],q=qmFree(b.zn,b.x+(i-1)*1.2,b.z-1);qmItemAdd(++QM.itN,k,b.zn,q[0],q[1]);}
  qmPts(a,5,'');qmMsg('🧰 Coffre ouvert : ⬆️ arme améliorée pour toute l\'équipe (niveau max 3) + 3 objets !','good',1);}
/* degats d'arme sur le boss : parade de face, dos x1,5, essoufle x2, bouclier insensible */
function qmBossWeapon(a,dmg,W){const B=QM.boss;if(!B||B.dead||B.intro>0||B.air)return;const p=qmP(a);
  if(B.sh>0){if(B.zn===cur&&Math.random()<.3)qmPow(B.x,B.z,'🛡️');return;}
  let k=1;if(B.tired>0)k=2;else{const bx=p[0]-B.x,bz=p[1]-B.z,dd=Math.max(.3,Math.hypot(bx,bz)),fr=(Math.sin(B.h)*bx+Math.cos(B.h)*bz)/dd;if(fr>.35){k=.5;if(B.zn===cur&&Math.random()<.25)qmPow(B.x,B.z+.01,'PARÉ !');}else if(fr<-.35)k=1.5;}
  if(!a.human&&!a.remote)k*=.7;qmBossHit(dmg*k,a,{st:W.st?.4:0,slow:W.slow||0});}
function qmBossShield(n,a,why){const B=QM.boss;if(!B||B.sh<=0)return false;B.sh=Math.max(0,B.sh-n);if(B.zn===cur)qmPow(B.x,B.z,'💥 BOUCLIER −'+n);if(B.sh<=0){B.tired=5;B.st='tired';B.bt=0;qmBig('💥 Bouclier cassé ! '+B.d.n+' est essoufflé : FONCEZ (dégâts ×2) !','key',1);}return true;}
function qmBossItem(a){const B=QM.boss;if(!B||B.dead)return;if(qmBossShield(3,a))return;qmBossHit(3,a);}
/* pouvoirs contre le boss (et contre son bouclier) */
function qmArenaPow(a,k,fx){const B=QM.boss;if(!B||B.dead||(a.human?cur:a.zn)!==B.zn)return false;const p=qmP(a),nm=a.name;const say2=function(t){qmMsg(t,'good',1);};
  const shield=k!=='kit'&&k!=='hype'&&k!=='shield'&&qmBossShield(4,a);
  if(k==='kit'){QM.A.forEach(function(b){if(b.zn===B.zn&&!(b.down>0)&&!b.out)b.hp=Math.min(b.hpMax,b.hp+4);});fx();say2('🩹 '+nm+' soigne toute l\'équipe : +1 cœur !');}
  else if(k==='shield'){B.taunt={a:a,t:6};a.shT=6;fx();if(B.sh>0)qmBossShield(4,a);say2('🛡️ '+nm+' attire le boss sur lui et encaisse (dégâts ÷2, 6 s) !');}
  else if(k==='portal'){fx({h:Math.atan2(B.x-p[0],B.z-p[1]),r:Math.min(6,Math.hypot(B.x-p[0],B.z-p[1]))});if(!shield)qmBossHit(6,a,{st:1});say2('🛒 '+nm+' fonce dans le boss avec un chariot !');}
  else if(k==='cart'){for(let i=0;i<3;i++){const q=qmFree(B.zn,p[0]+(i-1)*.9,p[1]+.9);qmItemAdd(++QM.itN,B.d.pk,B.zn,q[0],q[1]);}if(!shield)qmBossHit(3,a);say2('📦 '+nm+' renverse une palette : 3 projectiles au sol !');}
  else if(k==='disc'){if(!shield)B.stun=Math.max(B.stun,3);say2('🧽 '+nm+' fait une flaque : le boss glisse !');}
  else if(k==='info'){if(!shield)B.stun=Math.max(B.stun,3);say2('💻 '+nm+' pirate le boss !');}
  else if(k==='taser'){if(!shield)qmBossHit(5,a,{st:3});fx({tx:B.x,tz:B.z});say2('🔫 '+nm+' paralyse le boss !');}
  else if(k==='toys'){a.toys={n:3,t:30,cd:.3};say2('🤖 Les jouets de '+nm+' entrent en piste !');}
  else if(k==='blackout'){if(!shield)qmBossHit(8,a,{st:.5});fx();say2('⚡ '+nm+' envoie une décharge électrique !');}
  else if(k==='hype'){QM.dmgT=8;QM.A.forEach(function(b){if(b.zn===B.zn){b.boost=5;if(b.human){QM.st=100;QM.stx=false;}}});fx();say2('🎤 '+nm+' motive l\'équipe : dégâts ×2 pendant 8 s !');}
  else return false;return true;}
/* ---------- tick du boss ---------- */
function qmBossTick(dt){const B=QM.boss,host=!(QM.mp&&QN.client),me=QM.me;
  if(QM.dmgT>0)QM.dmgT-=dt;
  {const bl=$('qmBlind');if(bl){if(QM.blindT>0){QM.blindT-=dt;bl.hidden=false;bl.style.opacity=Math.min(.95,QM.blindT/1.2);}else if(!bl.hidden)bl.hidden=true;}}
  if((me.frz||0)>0)me.frz-=dt;
  if(B&&cur===B.zn&&QM.BZ.some(function(z){return z.k==='ice'&&qmInZ(z,pp.x,pp.z);})){const nx=pp.x+Math.sin(pp.face)*3*dt,nz=pp.z+Math.cos(pp.face)*3*dt;if(!hit(nx,nz,.38,Z[cur])){pp.x=nx;pp.z=nz;}}
  qmBZTick(dt,host);
  const H=$('qmBossH');if(QM.arena&&QM.arena.kind==='wave'){qmWaveTick(dt,host);return;}if(!B){if(H&&!H.hidden)H.hidden=true;return;}
  B.g.visible=B.zn===cur&&!QM.cine&&!B.air;B.bar.sp.visible=false;if(B.shM)B.shM.visible=B.sh>0;if(B.shM&&B.sh>0)B.shM.material.opacity=.18+.12*Math.sin(QM.clk*6);
  if(H){const on=cur===B.zn;H.hidden=!on;if(on){const pc=Math.max(0,B.hp/B.max*100),sp=B.sh>0?Math.round(B.sh/B.shMax*100):0;
    const t=QM.arena&&QM.arena.ph==='loot'?' · ouvrez le coffre 🧰':B.tired>0?' · 💫 ESSOUFFLÉ : FONCEZ !':B.sh>0?' · 🛡️ bouclier : pouvoirs et objets !':QM.arena?' · '+Math.max(0,Math.ceil(qmBLim(B)-QM.arena.t))+' s':'';
    const h='<div class="qmbh1">'+B.d.ic+' '+esc(B.d.n)+(B.stun>0?' 💫':'')+'<small>'+t+'</small></div><div class="qmbh2"><i style="width:'+pc.toFixed(1)+'%;background:'+B.d.bar+'"></i></div>'+(sp?'<div class="qmbh2 sh"><i style="width:'+sp+'%;background:#4dabf7"></i></div>':'');if(H._h!==h){H._h=h;H.innerHTML=h;}}}
  if(B.hitF>0){B.hitF-=dt;B.g.rotation.z=Math.sin(B.hitF*60)*.12;}else B.g.rotation.z=0;
  B.mins.forEach(function(m){m.g.visible=m.zn===cur&&!(m.ko>50);if(m.ko>0&&m.ko<50){m.ko-=dt;m.g.rotation.z=Math.sin(QM.clk*7)*.2;}else m.g.rotation.z=0;});
  if(B.dead){B.dead-=dt;B.g.rotation.x=Math.min(1.5,B.g.rotation.x+dt*3);B.g.position.set(B.x,0,B.z);if(host&&QM.arena)qmLootTick(dt);return;}
  B.g.rotation.x=B.tired>0?.45:0;
  if(!host){const dx=(B.tx===undefined?B.x:B.tx)-B.x,dz=(B.tz===undefined?B.z:B.tz)-B.z,d=Math.hypot(dx,dz);if(d>6){B.x=B.tx;B.z=B.tz;}else if(d>.01){const st=Math.min(d,dt*Math.max(4,d*6));B.x+=dx/d*st;B.z+=dz/d*st;}B.ph+=d>.03?dt*6:0;walkAnim(B.g,B.ph,d>.03?1:0);B.g.position.set(B.x,0,B.z);B.g.rotation.y=angLerp(B.g.rotation.y,B.th||0,.2);
    B.mins.forEach(function(m){const ddx=(m.tx===undefined?m.x:m.tx)-m.x,ddz=(m.tz===undefined?m.z:m.tz)-m.z,dd=Math.hypot(ddx,ddz);if(dd>.01){const st=Math.min(dd,dt*5);m.x+=ddx/dd*st;m.z+=ddz/dd*st;}m.ph+=dd>.03?dt*6:0;walkAnim(m.g,m.ph,dd>.03?1:0);m.g.position.set(m.x,0,m.z);m.g.rotation.y=m.th||0;});return;}
  const A=QM.arena;if(A){A.t+=dt;const P=QM.A.filter(function(a){return a.zn===B.zn&&!a.out;});if(!P.length||P.every(function(a){return a.down>0;})||A.t>=qmBLim(B)){qmArenaEnd(false);return;}}
  if(!B.rage&&B.hp>0&&B.hp<B.max*(B.i===2?.4:B.i===3?.5:0)){B.rage=1;QM.shake=.6;qmBig('😡 '+B.d.n+' est ENRAGÉE : plus rapide et plus agressive !','zomb',1);if(B.i===3)qmMinSpawn(B,2);}
  if(B.intro>0){B.intro-=dt;walkAnim(B.g,0,0);B.g.position.set(B.x,0,B.z);return;}
  if(B.slow>0)B.slow-=dt;if(B.taunt&&(B.taunt.t-=dt)<=0)B.taunt=null;if(B.decoy&&(B.decoy.t-=dt)<=0)B.decoy=null;
  if(B.i===3){if(B.rf===0&&B.hp<B.max*.66){B.rf=1;qmMinSpawn(B,2);}else if(B.rf===1&&B.hp<B.max*.33){B.rf=2;qmMinSpawn(B,2);}}
  qmMinTick(dt);
  if(B.air){walkAnim(B.g,0,0);return;}
  if(B.stun>0){B.stun-=dt;walkAnim(B.g,0,0);B.g.position.set(B.x,0,B.z);return;}
  if(B.tired>0){B.tired-=dt;walkAnim(B.g,0,0);B.g.position.set(B.x,0,B.z);if(B.tired<=0){B.st='chase';B.nx=2+Math.random()*2;}return;}
  if(B.dash){const D=B.dash,st=Math.min(D.left,D.spd*dt),nx=B.x+Math.sin(D.h)*st,nz=B.z+Math.cos(D.h)*st;D.left-=st;B.h=D.h;if(hit(nx,nz,.6,Z[B.zn])||D.left<=0){B.dash=null;if(D.left>0){B.stun=1.2;if(B.zn===cur){qmThud(.6);QM.shake=.3;}}}else{B.x=nx;B.z=nz;}B.ph+=dt*12;walkAnim(B.g,B.ph,1.6);B.g.position.set(B.x,0,B.z);B.g.rotation.y=B.h;return;}
  const live=QM.A.filter(function(a){return a.zn===B.zn&&qmLive(a)&&!(a.down>0);});
  /* barrage */
  if(B.st==='barrage'){B.bt-=dt;B.vt=(B.vt||0)-dt;B.h+=dt*1.5;walkAnim(B.g,0,0);
    if(B.vt<=0&&B.bt>.8){B.vt=B.i===3?1.1:.55;const zn=Z[B.zn];
      if(B.i===3){const z0=zn.o[1]+2+Math.random()*19,fromL=Math.random()<.5;qmBZAdd({k:'rect',x:fromL?zn.o[0]+.5:zn.o[0]+QAW-.5,z:z0,w:1.8,len:QAW-1,h:fromL?Math.PI/2:-Math.PI/2,t:1.2,t0:1.2,f:'shot',e:'cart'});}
      else{const pts=[];live.forEach(function(a){if(Math.random()<.7){const p=qmP(a);pts.push([p[0]+(Math.random()-.5)*4,p[1]+(Math.random()-.5)*4]);}});pts.push([zn.o[0]+2+Math.random()*(QAW-4),zn.o[1]+2+Math.random()*19]);
        pts.forEach(function(q){qmBZAdd({k:'circ',x:q[0],z:q[1],r:1.4,t:1,t0:1,f:'shot',e:'rain'});const tg=live[0];if(tg){const o={id:tg.id,k:'throw',zn:B.zn,x:B.x,z:B.z,tx:q[0],tz:q[1],ic:B.d.pj};qmPowFx(tg,'throw',o);if(QM.mp&&QN.host)qnS('fx',o);}});}}
    if(B.bt<=0){B.sh=0;B.st='tired';B.tired=2.5;}B.g.position.set(B.x,0,B.z);B.g.rotation.y=B.h;return;}
  /* cible */
  let tg=null,bd=1e9;live.forEach(function(a){const p=qmP(a),d=Math.hypot(p[0]-B.x,p[1]-B.z);if(d<bd){bd=d;tg=a;}});
  if(B.taunt&&B.taunt.a.zn===B.zn&&!(B.taunt.a.down>0)){tg=B.taunt.a;const p=qmP(tg);bd=Math.hypot(p[0]-B.x,p[1]-B.z);}
  if(B.cd>0)B.cd-=dt;B.nx-=dt*(B.rage?1.6:1);
  if(tg){const p=qmP(tg),x=p[0],z=p[1];const gx=B.decoy?B.decoy.x:x,gz=B.decoy?B.decoy.z:z;B.h=angLerp(B.h,Math.atan2(gx-B.x,gz-B.z),Math.min(1,dt*(B.i>=2?5:3.5)));
    if(B.nx<=0&&!B.decoy){const pool=['jump','barrage','spec','spec','jump'].filter(function(k){return k!==B.lastP;});const k=pool[(Math.random()*pool.length)|0];B.lastP=k;B.nx=5+Math.random()*2.5-B.i*.4;
      if(k==='spec'){if(B.cancel){B.cancel=0;if(B.zn===cur)say(B.g,'Mais… ça ne marche plus ?!');}else qmBossAtt(B,tg,x,z);}
      else if(k==='jump'){const v=live[(Math.random()*live.length)|0]||tg,q=qmP(v);B.air=1;qmBZAdd({k:'circ',x:q[0],z:q[1],r:2,t:1.2,t0:1.2,f:'land'});if(B.zn===cur)say(B.g,'Hop !');}
      else{const c=Z[B.zn].ctr;qmBZAdd({k:'circ',x:c[0],z:c[1],r:2.2,t:.9,t0:.9,f:'land',bar:1});B.air=1;if(B.zn===cur)say(B.g,'À couvert !');}}
    const gd=Math.hypot(gx-B.x,gz-B.z);
    if(gd>1.3){B.rp=(B.rp||0)-dt;if(blocked(Z[B.zn],B.x,B.z,gx,gz)){if(B.rp<=0||!B.path||B.pi>=B.path.length){B.path=path(Z[B.zn],B.x,B.z,gx,gz);B.pi=0;B.rp=.6;}}else{B.path=[[gx,gz]];B.pi=0;}const sh=B.h;follow(B,dt,(B.slow>0?1.3:2.5)+B.i*.2+(B.rage?.7:0));B.h=sh;B.ph+=dt*6;walkAnim(B.g,B.ph,1);}
    else{walkAnim(B.g,0,0);if(!B.decoy&&B.cd<=0&&!(tg.imm>0)&&bd<1.7){B.cd=B.rage?1:1.4;qmBHurt(tg,4);tg.imm=1.5;const k=Math.atan2(x-B.x,z-B.z);if(tg.human){const nx=pp.x+Math.sin(k)*1.6,nz=pp.z+Math.cos(k)*1.6;if(!hit(nx,nz,.38,Z[cur])){pp.x=nx;pp.z=nz;}}else if(tg.remote)qnS('hit',{id:tg.id,kx:Math.sin(k)*1.6,kz:Math.cos(k)*1.6,q:4});if(B.zn===cur)say(B.g,['Dehors !','Hors de MA vue !','Pas de pause pour vous !'][(Math.random()*3)|0]);}}}
  else walkAnim(B.g,0,0);
  B.g.position.set(B.x,0,B.z);B.g.rotation.y=B.h;}

function qmBossShM(g){const sh=new T.Mesh(new T.SphereGeometry(1.4,20,14),new T.MeshBasicMaterial({color:0x4dabf7,transparent:true,opacity:.28,depthWrite:false}));sh.position.y=1;g.add(sh);sh.visible=false;return sh;}

function qmBLim(B){return B&&B.i>=2?240:180;}

/* ================= Lot B3 : armes de classe et attaque automatique ================= */
const QCW={
  sst:{ic:'🧴',n:'Pulvérisateur',k:'shot',r:6,m:.7,rate:.8,pj:'💧',heal:1,d:'à distance, soigne un peu les alliés blessés'},
  rec:{ic:'🛒',n:'Transpalette',k:'melee',r:2.2,m:2,rate:1.1,kb:1.3,d:'gros coup de près qui repousse'},
  drv:{ic:'🔧',n:'Clé à molette',k:'shot',r:7,m:1.2,rate:1,pj:'🔧',d:'lancée, elle revient'},
  stg:{ic:'📎',n:'Agrafeuse',k:'shot',r:7,m:.5,rate:.35,pj:'📎',d:'tir rapide en rafale'},
  ent:{ic:'🧹',n:'Balai',k:'arc',r:2.8,m:1.2,rate:.8,d:'balayage qui touche plusieurs ennemis'},
  inf:{ic:'🔴',n:'Pointeur laser',k:'shot',r:9,m:.5,rate:.6,pj:'🔴',slow:1.5,d:'à distance, ralentit'},
  sec:{ic:'🏏',n:'Matraque',k:'melee',r:2,m:2,rate:1,st:.8,d:'gros dégâts, étourdit'},
  toy:{ic:'🎯',n:'Fléchettes en mousse',k:'shot',r:10,m:1,rate:.7,pj:'🎯',d:'longue portée'},
  ele:{ic:'🔌',n:'Rallonge électrique',k:'zone',r:2.6,m:1,rate:1.1,d:'décharge tout autour de lui'},
  ani:{ic:'📣',n:'Mégaphone',k:'cone',r:5,m:.8,rate:1,kb:.9,d:'onde qui repousse devant lui'}};
QCFG.mgrHp=5;QCFG.cliHp=2;QCFG.fayHp=2;
function qmCW(a){return QCW[a.cls]||QCW.stg;}
function qmWl(a){return Math.max(1,Math.min(3,a.wl||1));}
function qmWDmg(a){return qmCW(a).m*(1+.35*(qmWl(a)-1));}
/* toutes les cibles possibles (vue directe obligatoire : rien a travers les gondoles) */
function qmTgList(a){const p=qmP(a),zn=p[2],W=qmCW(a),R=W.r,L=[];const add=function(k,o,rad){const d=Math.hypot(o.x-p[0],o.z-p[1]);if(d>R+(rad||0))return;if(blocked(Z[zn],p[0],p[1],o.x,o.z))return;L.push({k:k,o:o,d:d});};
  if(qmIsAr(zn)){const B=QM.boss;if(B&&B.zn===zn&&!B.dead&&!(B.intro>0)&&!B.air)add('boss',B,.6);if(B)B.mins.forEach(function(m){if(!(m.ko>0))add('min',m);});(QM.HZ||[]).forEach(function(e){if(e.zn===zn&&!(e.ko>0))add('hz',e);});}
  else{QM.H.forEach(function(h){if(h.zn===zn&&!h.dir&&!(h.stun>0))add('mgr',h);});QM.CE.forEach(function(n){if(n.zn===zn&&!(n.ko>0)&&!(n.gone>0))add('cli',n);});QM.FY.forEach(function(f){if(f.zn===zn&&!(f.ko>0))add('fay',f);});}
  return L.sort(function(x,y){return x.d-y.d;});}
function qmAutoTg(a){const L=qmTgList(a);return L.length?L[0]:null;}
/* une attaque (respecte la cadence de l'arme) */
function qmAtk(a){if(a.down>0||a.out||a.cv||a.caught>0||a.zomb>0)return false;if(QM.clk<(a.acd||0)-.06)return false;const L=qmTgList(a);if(!L.length)return false;const W=qmCW(a),p=qmP(a),t=L[0];a.acd=QM.clk+W.rate/(QM.cafeT>0&&qmIsAr(qmP(a)[2])?2:1);
  const f=Math.atan2(t.o.x-p[0],t.o.z-p[1]);if(!a.human)a.hd=f;
  if(W.k==='shot')qmPowFx(a,'throw',{id:a.id,k:'throw',zn:p[2],x:p[0],z:p[1],tx:t.o.x,tz:t.o.z,ic:W.pj});else{qmPunch(a);if(p[2]===cur&&(W.k==='zone'||W.k==='arc'||W.k==='cone'))qmPow(p[0],p[1]+.01,W.k==='zone'?'⚡':W.k==='cone'?'📣':'💨');}
  if((QM.mp&&QN.client)&&a.human){qnS('a',{pid:QN.pid,k:'melee'});return true;}
  if(QM.mp&&QN.host&&!a.human){const o=W.k==='shot'?{id:a.id,k:'throw',zn:p[2],x:p[0],z:p[1],tx:t.o.x,tz:t.o.z,ic:W.pj,at:1}:{id:a.id,k:'punch',zn:p[2],x:p[0],z:p[1],at:1};qnS('fx',o);}
  else if(QM.mp&&QN.host&&a.human&&W.k==='shot')qnS('fx',{id:a.id,k:'throw',zn:p[2],x:p[0],z:p[1],tx:t.o.x,tz:t.o.z,ic:W.pj,at:1});
  let T=[t];if(W.k==='zone')T=L;else if(W.k==='arc'||W.k==='cone'){T=L.filter(function(o){let df=Math.atan2(o.o.x-p[0],o.o.z-p[1])-f;df=Math.atan2(Math.sin(df),Math.cos(df));return Math.abs(df)<(W.k==='arc'?1:.6);});}
  const dmg=qmWDmg(a);T.forEach(function(o){qmHitT(a,o,dmg,W);});
  if(W.heal&&(a.hcd||0)<QM.clk){const b=QM.A.filter(function(b){return b!==a&&b.zn===a.zn&&!(b.down>0)&&!b.out&&b.hp<b.hpMax&&Math.hypot(b.x-p[0],b.z-p[1])<6;}).sort(function(x,y){return x.hp-y.hp;})[0];if(b){a.hcd=QM.clk+2;b.hp=Math.min(b.hpMax,b.hp+1);}}
  return true;}
function qmPush(o,p,L,zn){const d=Math.max(.3,Math.hypot(o.x-p[0],o.z-p[1]));for(const k of [L,L*.6,L*.3]){const nx=o.x+(o.x-p[0])/d*k,nz=o.z+(o.z-p[1])/d*k;if(!hit(nx,nz,.38,Z[zn])){o.x=nx;o.z=nz;return;}}}
function qmHitT(a,t,dmg,W){const p=qmP(a),o=t.o,vis=o.zn===cur||p[2]===cur;
  if(t.k==='boss'){qmBossWeapon(a,dmg,W);return;}
  if(t.k==='min'){o.hp=(o.hp===undefined?4:o.hp)-dmg;if(vis)qmPow(o.x,o.z,'POW !');if(W.kb)qmPush(o,p,W.kb,o.zn);if(o.hp<=0){o.hp=4;o.ko=99;qmPts(a,3,'mgr');}return;}
  if(t.k==='hz'){o.hp=(o.hp===undefined?(o.ty===2?2:1.5):o.hp)-dmg;if(vis)qmPow(o.x,o.z,'POW !');if(W.kb)qmPush(o,p,W.kb,o.zn);if(o.hp<=0){o.ko=1;qmPts(a,1,'mgr');}return;}
  if(t.k==='mgr'){const h=o;const bx=p[0]-h.x,bz=p[1]-h.z,dd=Math.max(.3,Math.hypot(bx,bz));const back=(Math.sin(h.h||0)*bx+Math.cos(h.h||0)*bz)/dd<-.2;const d2=dmg*(back?QCFG.mgrHp/3:1);
    h.mhp=(h.mhp===undefined?QCFG.mgrHp:h.mhp)-d2;if(vis)qmPow(h.x,h.z,back?'DANS LE DOS !':'POW !');if(W.kb&&!back)qmPush(h,p,W.kb,h.zn);if(W.slow)h.slow=Math.max(h.slow||0,W.slow);if(W.st)h.stun=Math.max(h.stun||0,W.st);
    if(h.mhp<=0){h.mhp=QCFG.mgrHp;h.stun=5;h.turnT=0;h.path=null;qmPts(a,3,'mgr');if(h.tg)qmLose(h,null);if(h.grabT)qmUngrab(h);if(h.zn===cur)say(h.g,'Ouille… 💫');if(a.human)qmMsg('🤜 '+h.name+' est KO pendant 5 s !','good');qmNoise(a,8);}
    else{if(!h.tg&&!(h.stun>0)){h.turnT=1.3;h.turnTg=a;h.wait=Math.max(h.wait||0,.3);}if(h.zn===cur&&Math.random()<.3)say(h.g,back?'Hein ?!':'Aïe !');}return;}
  const n=o,fay=t.k==='fay';n.hp=(n.hp===undefined?(fay?QCFG.fayHp:QCFG.cliHp):n.hp)-dmg;if(vis)qmPow(n.x,n.z,'POW !');if(W.kb)qmPush(n,p,W.kb,n.zn);
  if(n.hp<=0){n.hp=fay?QCFG.fayHp:QCFG.cliHp;n.ko=fay?8:1.5;if(!fay)n.van=1;qmPts(a,1,'mgr');if(a.human)qmMsg(fay?'👊 Le fayot est KO : il ne balancera personne pendant 8 s.':'👊 Client énervé KO : il file se plaindre ailleurs !','good');if(fay)qmNoise(a,10);}}
/* boucle : attaque automatique (joueur local + bots) */
function qmAutoTick(dt){const me=QM.me;if(!QM.on||QM.paused||QM.cine)return;
  if(QM.auto&&!me.out&&!(me.down>0)&&!me.cv&&!(me.caught>0)&&!me.hide&&!QM.map&&!(me.frz>0))qmAtk(me);
  if(QM.mp&&QN.client)return;QM.A.forEach(function(a){if(a.human||a.remote||a.out||a.down>0||a.cv||a.caught>0||a.role!=='emp')return;if(qmIsAr(a.zn))return;if((a.bac||0)>QM.clk)return;if(qmAtk(a))a.bac=QM.clk+1.8+Math.random()*1.2;});}
/* tas de projectiles dans les arenes */
function qmPileNear(a){const p=qmP(a),zn=Z[p[2]];if(!zn||!zn.piles)return null;return zn.piles.find(function(q){return Math.hypot(q.x-p[0],q.z-p[1])<1.6;})||null;}
function qmPileGrab(a){const q=qmPileNear(a);if(!q||a.item)return;if(QM.mp&&QN.client&&a.human){qnS('a',{pid:QN.pid,k:'pile'});return;}a.item=q.k;if(a.human)qmMsg(QIT[q.k].ic+' Projectile en main : vise le boss et lance-le (bouton objet) !','good');}

/* ---------- jouets gardes du corps (Rayon jouets) ---------- */
function qmToysTick(dt){const host=!(QM.mp&&QN.client);
  QM.A.forEach(function(a){const n=a.toys?(a.toys.n||0):(a.toysN||0);
    if(!a.tyG&&n>0){a.tyG=[0,1,2].map(function(){const sp=label('🤖',{sx:.7,sy:.7,w:80,h:80,size:58,bg:'rgba(255,255,255,0)'});scene.add(sp);return sp;});}
    if(a.tyG){const p=qmP(a);a.tyG.forEach(function(sp,i){sp.visible=i<n&&p[2]===cur&&!QM.map&&!QM.cine;const an=QM.clk*2.6+i*2.094;sp.position.set(p[0]+Math.cos(an)*1.05,1.15+Math.sin(QM.clk*5+i)*.12,p[1]+Math.sin(an)*1.05);});if(n<=0&&!a.toys){a.tyG.forEach(function(sp){scene.remove(sp);});a.tyG=null;}}
    if(!host||!a.toys)return;const T2=a.toys;T2.t-=dt;T2.cd-=dt;if(T2.t<=0||T2.n<=0||a.out||a.cv){a.toys=null;a.toysN=0;return;}
    if(T2.cd>0||a.down>0)return;const p=qmP(a);let best=null,bd=3.6;
    const cand=function(k,o,rad){const d=Math.hypot(o.x-p[0],o.z-p[1]);if(d<bd+(rad||0)&&!blocked(Z[p[2]],p[0],p[1],o.x,o.z)){bd=d;best={k:k,o:o};}};
    if(qmIsAr(p[2])){const B=QM.boss;if(B&&B.zn===p[2]&&!B.dead&&!(B.intro>0)&&!B.air)cand('boss',B,1);if(B)B.mins.forEach(function(m){if(!(m.ko>0))cand('min',m);});(QM.HZ||[]).forEach(function(e){if(e.zn===p[2]&&!(e.ko>0))cand('hz',e);});}
    else{QM.H.forEach(function(h){if(h.zn===p[2]&&!h.dir&&!(h.stun>0))cand('mgr',h);});QM.CE.forEach(function(c){if(c.zn===p[2]&&!(c.ko>0)&&!(c.gone>0))cand('cli',c);});QM.FY.forEach(function(f){if(f.zn===p[2]&&!(f.ko>0))cand('fay',f);});}
    if(!best)return;T2.n--;T2.cd=.7;const o={id:a.id,k:'throw',zn:p[2],x:p[0],z:p[1],tx:best.o.x,tz:best.o.z,ic:'🤖'};qmPowFx(a,'throw',o);if(QM.mp&&QN.host)qnS('fx',o);
    if(best.k==='boss'){if(!qmBossShield(1,a))qmBossHit(1.5,a);}else qmHitT(a,best,1,{});
    if(a.cls==='toy'&&a.cd.toys>0)a.cd.toys=Math.max(0,a.cd.toys-3);if(a.human)qmMsg('🤖 Un jouet fonce sur '+(best.k==='mgr'?best.o.name:best.k==='boss'?'le boss':'l\'ennemi')+' ! ('+T2.n+' restant'+(T2.n>1?'s':'')+')','good');
    a.toysN=T2.n;});}

/* ================= Lot D : tenues de classe, magasin qui s'écroule, dernière minute ================= */
/* ---------- tenues ---------- */
function qmBodyG(g){return g&&g.userData&&g.userData.m?g.userData.m:(g&&g.children&&g.children.find(function(c){return c.type==='Group';}));}
function qmArm(m,s){return m.children.find(function(c){return c.type==='Group'&&Math.abs(c.position.y-1.31)<.01&&Math.sign(c.position.x)===s;});}
function qmOutfit(g,cls){const m=qmBodyG(g);if(!m)return;const old=m.children.filter(function(c){return c.name==='qmOut';});old.forEach(function(c){m.remove(c);});
  const ar=qmArm(m,1),al=qmArm(m,-1);[ar,al].forEach(function(a){if(!a)return;a.children.filter(function(c){return c.name==='qmOut';}).forEach(function(c){a.remove(c);});});
  const G=new T.Group();G.name='qmOut';m.add(G);const hand=function(a){const p=new T.Group();p.name='qmOut';p.position.set(0,-.62,0);a.add(p);return p;};
  const vest=function(col,str){tube(G,.33,.29,.6,col,0,1.0,0,1,.82);if(str){tube(G,.335,.32,.05,0xdfe6ee,0,.86,0,1,.83);tube(G,.34,.33,.05,0xdfe6ee,0,1.12,0,1,.83);}};
  const cap=function(col){ell(G,.31,col,0,1.88,0,1,.42,1);box(G,.34,.035,.24,col,0,1.84,.29,false);};
  if(cls==='sst'){vest(0x2e8c46);box(G,.2,.06,.02,0xffffff,0,1.08,-.255,false);box(G,.06,.2,.02,0xffffff,0,1.08,-.255,false);box(G,.12,.04,.02,0xffffff,.13,1.15,.27,false);box(G,.04,.12,.02,0xffffff,.13,1.15,.27,false);if(al)box(hand(al),.22,.16,.12,0xe5484d,0,-.05,.05,false);}
  else if(cls==='rec'){vest(0xff7a1a,1);}
  else if(cls==='drv'){cap(0x1f6fd0);vest(0x1f6fd0);if(ar)box(hand(ar),.07,.06,.22,0x222831,0,-.04,.1,false);}
  else if(cls==='stg'){box(G,.42,.48,.2,0xf59e0b,0,1.05,-.33,false);box(G,.18,.13,.02,0xffffff,.0,1.0,.245,false);box(G,.18,.03,.022,0xe5484d,0,1.05,.247,false);box(G,.02,.3,.02,0xe5484d,-.08,1.2,.235,false);box(G,.02,.3,.02,0xe5484d,.08,1.2,.235,false);}
  else if(cls==='ent'){box(G,.42,.46,.05,0x2563eb,0,.95,.225,false);box(G,.06,.3,.04,0x2563eb,-.14,1.27,.2,false);box(G,.06,.3,.04,0x2563eb,.14,1.27,.2,false);tube(G,.3,.3,.08,0x2563eb,0,.72,0,1,.8);if(ar)tube(hand(ar),.11,.09,.2,0x3b82f6,0,-.16,0,1,1);}
  else if(cls==='inf'){[-1,1].forEach(function(s){const t=new T.Mesh(new T.TorusGeometry(.07,.013,8,16),mat(0x111111));t.position.set(s*.104,1.65,.29);G.add(t);});box(G,.08,.015,.015,0x111111,0,1.65,.3,false);ell(G,.27,0x374151,0,1.42,-.24,1.15,.6,.7);vest(0x374151);if(al)box(hand(al),.04,.26,.36,0x2b2f36,.1,.25,0,false);}
  else if(cls==='sec'){vest(0x111827);box(G,.5,.07,.02,0xf2c230,0,1.15,-.25,false);cap(0x111827);box(G,.1,.08,.02,0xf2c230,0,1.92,.27,false);ell(G,.035,0x111111,.29,1.63,.02);}
  else if(cls==='toy'){ell(G,.3,0xe5484d,0,1.87,0,1,.45,1);ell(G,.18,0x3b82f6,0,1.95,.0,1,.3,1);box(G,.03,.12,.03,0x222222,0,2.02,0,false);box(G,.42,.03,.07,0xf2c230,0,2.08,0,false);box(G,.07,.03,.42,0x10b981,0,2.08,0,false);ell(G,.17,0x8a5a32,0,1.08,-.3);ell(G,.1,0x8a5a32,0,1.3,-.3);[-1,1].forEach(function(s){ell(G,.04,0x6b4423,s*.07,1.39,-.3);});}
  else if(cls==='ele'){ell(G,.33,0xf2c230,0,1.88,0,1,.55,1);tube(G,.4,.4,.03,0xf2c230,0,1.8,0,1,1);tube(G,.3,.3,.09,0x6b4423,0,.72,0,1,.8);box(G,.07,.16,.05,0x9aa3ad,.2,.66,.2,false);box(G,.06,.12,.05,0xe5484d,-.2,.66,.2,false);}
  else if(cls==='ani'){vest(0xd61f8f);[-1,1].forEach(function(s){ell(G,.075,0x222222,s*.3,1.64,0,.7,1,1);});box(G,.62,.04,.05,0x222222,0,1.95,0,false);box(G,.025,.025,.24,0x222222,.24,1.56,.15,false);ell(G,.04,0x222222,.24,1.56,.28);}
  const ic=label(QCL[cls]?QCL[cls].ic:'',{sx:.55,sy:.55,w:72,h:72,size:52,bg:'rgba(255,255,255,.9)'});ic.position.set(0,2.32,0);G.add(ic);}
function qmAccMgr(g,dir){const m=qmBodyG(g);if(!m)return;const ar=qmArm(m,1);if(dir)return;tube(m,.33,.29,.62,0x1f2a44,0,1.0,0,1,.82);box(m,.08,.34,.03,0xb3122b,0,1.08,.25,false);
  if(ar){const p=new T.Group();p.position.set(0,-.62,0);ar.add(p);box(p,.03,.32,.25,0x8a5a32,.02,-.05,.11,false);box(p,.032,.26,.2,0xffffff,.025,-.05,.11,false);}
  ell(m,.035,0x111111,-.29,1.63,.02);}
function qmAccCli(g,id){const m=qmBodyG(g);if(!m)return;const ar=qmArm(m,(id%2)?1:-1);if(!ar)return;[qmArm(m,1),qmArm(m,-1)].forEach(function(a){if(a)a.children.filter(function(c){return c.name==='qmOut';}).forEach(function(c){a.remove(c);});});const p=new T.Group();p.name='qmOut';p.position.set(0,-.62,0);ar.add(p);
  if(id%3===0){tube(p,.16,.12,.16,0xe5484d,0,-.2,.04,1,.75);box(p,.02,.18,.02,0xe5484d,0,-.04,.04,false);}else box(p,.26,.3,.1,[0xf2c230,0x10b981,0x8b5cf6][id%3],0,-.25,0,false);}
/* ---------- magasin qui s'ecroule ---------- */
function qmFunInit(){QM.dg=0;QM.parts=[];QM.smk=[];QM.lfin=0;(QM.debris||[]).forEach(function(d){if(d.parent)d.parent.remove(d);});QM.debris=[];
  if(!$('qmAlarm')){const d=document.createElement('div');d.id='qmAlarm';d.hidden=true;const dk=$('dk');if(dk&&dk.parentNode)dk.parentNode.insertBefore(d,dk.nextSibling);else document.body.appendChild(d);}
  if(!$('qmFl')){const d=document.createElement('div');d.id='qmFl';d.hidden=true;const dk=$('dk');if(dk&&dk.parentNode)dk.parentNode.insertBefore(d,dk.nextSibling);else document.body.appendChild(d);}
  if(!$('qmShut')){const d=document.createElement('div');d.id='qmShut';d.hidden=true;document.body.appendChild(d);}
  $('qmAlarm').hidden=true;$('qmFl').hidden=true;$('qmShut').hidden=true;}
const QDCOL=[0xe5484d,0xf2c230,0x3b82f6,0x10b981,0x8b5cf6,0xf59e0b,0xffffff,0x8a5a32];
function qmDebris(zn,x,z,n,r){const Zn=Z[zn];if(!Zn)return;for(let i=0;i<n;i++){const a=Math.random()*6.28,d=Math.random()*(r||2.2),px=x+Math.cos(a)*d,pz=z+Math.sin(a)*d;if(hit(px,pz,.05,Zn))continue;
    const k=Math.random();let mm;if(k<.15){QM.dbC=QM.dbC||new T.CircleGeometry(1,14);mm=new T.Mesh(QM.dbC,new T.MeshBasicMaterial({color:[0x9fd8ff,0xffe08a,0xd9b27a][i%3],transparent:true,opacity:.6,depthWrite:false}));mm.rotation.x=-Math.PI/2;mm.scale.setScalar(.35+Math.random()*.4);mm.position.set(px,.03,pz);}
    else{const s=.12+Math.random()*.16;QM.dbG=QM.dbG||new T.BoxGeometry(1,1.3,1);mm=new T.Mesh(QM.dbG,mat(QDCOL[(Math.random()*QDCOL.length)|0]));mm.scale.setScalar(s);mm.position.set(px,s*.65,pz);mm.rotation.set(Math.random()*1.5,Math.random()*6,Math.random()*1.5);}
    Zn.g.add(mm);QM.debris.push(mm);}}
function qmBurst(zn,x,z,n){if(zn!==cur)return;for(let i=0;i<(n||18);i++){const s=.1+Math.random()*.14;QM.dbG2=QM.dbG2||new T.BoxGeometry(1,1,1);const mm=new T.Mesh(QM.dbG2,mat(QDCOL[(Math.random()*QDCOL.length)|0]));mm.scale.setScalar(s);mm.position.set(x,1,z);scene.add(mm);
    const a=Math.random()*6.28,v=2+Math.random()*4;QM.parts.push({m:mm,vx:Math.cos(a)*v,vz:Math.sin(a)*v,vy:3+Math.random()*4,life:1.4+Math.random()*.6,zn:zn});}
  QM.shake=Math.max(QM.shake||0,.25);try{qmThud(.6);}catch(_){}}
function qmSmoke(zn,x,z){QM.smk.push({zn:zn,x:x,z:z,t:0});}
/* gros sabotage (quete reussie) : explosion de produits + debris */
function qmBigSab(q){const t=qmQTarget(q)||{};if(!t.zn)return;qmBurst(t.zn,t.x,t.z,24);qmDebris(t.zn,t.x,t.z,10,2.5);if(QM.mp&&QN.host)qnS('fx2',{k:'sab',zn:t.zn,x:t.x,z:t.z});}
function qmDegrade(){const lv=QM.j>=75?3:QM.j>=50?2:QM.j>=25?1:0;if(lv<=QM.dg)return;const host=!(QM.mp&&QN.client);
  for(let l=QM.dg+1;l<=lv;l++){
    if(l===1){qmBig('📉 Le magasin vacille : des produits partout !','zomb',1);if(true){['store','store','store','reserve','office'].forEach(function(zn){for(let k=0;k<3;k++){const p=qmRand(zn);qmDebris(zn,p[0],p[1],5,2);}});}}
    if(l===2){qmBig('💡 Les néons clignotent, ça fume en réserve !','zomb',1);['store','reserve','reserve','office'].forEach(function(zn){const p=qmRand(zn);qmSmoke(zn,p[0],p[1]);});['store','store','reserve'].forEach(function(zn){for(let k=0;k<3;k++){const p=qmRand(zn);qmDebris(zn,p[0],p[1],5,2);}});}
    if(l===3){qmBig('🚨 ALERTE ! Le magasin est au bord du gouffre !','zomb',1);['store','store','office'].forEach(function(zn){const p=qmRand(zn);qmSmoke(zn,p[0],p[1]);});['store','store','store','reserve','office'].forEach(function(zn){for(let k=0;k<3;k++){const p=qmRand(zn);qmDebris(zn,p[0],p[1],6,2.4);}});}}
  QM.dg=lv;}
function qmSiren(){try{const ac=QM.ac||(QM.ac=new (window.AudioContext||window.webkitAudioContext)());const o=ac.createOscillator(),gn=ac.createGain(),t=ac.currentTime;o.type='triangle';o.frequency.setValueAtTime(660,t);o.frequency.linearRampToValueAtTime(880,t+.35);o.frequency.linearRampToValueAtTime(660,t+.7);gn.gain.setValueAtTime(.0001,t);gn.gain.exponentialRampToValueAtTime(.05,t+.05);gn.gain.exponentialRampToValueAtTime(.0001,t+.72);o.connect(gn);gn.connect(ac.destination);o.start(t);o.stop(t+.75);}catch(_){}}
function qmTick2(f){try{const ac=QM.ac||(QM.ac=new (window.AudioContext||window.webkitAudioContext)());const o=ac.createOscillator(),gn=ac.createGain(),t=ac.currentTime;o.type='square';o.frequency.setValueAtTime(f||900,t);gn.gain.setValueAtTime(.04,t);gn.gain.exponentialRampToValueAtTime(.0001,t+.09);o.connect(gn);gn.connect(ac.destination);o.start(t);o.stop(t+.1);}catch(_){}}
function qmFunTick(dt){if(!QM.on)return;qmDegrade();const inMap=QZ.indexOf(cur)>=0&&!QM.map&&!QM.cine;
  /* particules */
  for(let i=QM.parts.length-1;i>=0;i--){const p=QM.parts[i];p.life-=dt;p.vy-=12*dt;p.m.position.x+=p.vx*dt;p.m.position.z+=p.vz*dt;p.m.position.y=Math.max(.06,p.m.position.y+p.vy*dt);if(p.m.position.y<=.06){p.vx*=.8;p.vz*=.8;p.vy=Math.abs(p.vy)*.3;}p.m.rotation.x+=dt*6;p.m.visible=p.zn===cur;if(p.life<=0){scene.remove(p.m);QM.parts.splice(i,1);}}
  /* fumee */
  QM.smk.forEach(function(s){s.t-=dt;if(s.t<=0&&s.zn===cur){s.t=.35;QM.smG=QM.smG||new T.SphereGeometry(1,10,8);const mm=new T.Mesh(QM.smG,new T.MeshBasicMaterial({color:0x777777,transparent:true,opacity:.45,depthWrite:false}));mm.scale.setScalar(.35+Math.random()*.3);mm.position.set(s.x+(Math.random()-.5)*.6,.6,s.z+(Math.random()-.5)*.6);scene.add(mm);QM.parts.push({m:mm,vx:(Math.random()-.5)*.4,vz:(Math.random()-.5)*.4,vy:1.2,life:2.2,zn:s.zn,sm:1});}});
  QM.parts.forEach(function(p){if(p.sm){p.vy=1.2;p.m.scale.multiplyScalar(1+dt*.5);p.m.material.opacity=Math.max(0,p.life/2.2*.45);}});
  /* neons qui clignotent (50 %+) */
  const fl=$('qmFl');if(QM.dg>=2&&inMap){QM.flT=(QM.flT||0)-dt;if(QM.flT<=0){QM.flT=14+Math.random()*10;QM.flOn=.6;}if(QM.flOn>0){QM.flOn-=dt;fl.hidden=false;fl.style.opacity=(Math.sin((.6-QM.flOn)/.6*Math.PI)*.22).toFixed(3);}else fl.hidden=true;}else if(!fl.hidden)fl.hidden=true;
  /* alarme rouge (75 %+ ou derniere minute) */
  const fin=QM.t<=60&&!QM.end,al=$('qmAlarm');const alOn=(QM.dg>=3||fin)&&inMap;
  if(alOn){al.hidden=false;al.style.opacity=(fin?.55:.35)+Math.sin(QM.clk*(fin?7:4))*.2;QM.sirT=(QM.sirT||0)-dt;if(QM.sirT<=0){QM.sirT=fin?2.2:4.5;qmSiren();}}else if(!al.hidden)al.hidden=true;
  /* derniere minute */
  if(fin&&!QM.lfin){QM.lfin=1;qmBig('🔥 DERNIÈRE MINUTE ! Tous les managers sont en chasse : tout donner !','zomb',1);}
  if(fin){QM.insp=Math.max(QM.insp||0,1.1);const s=Math.ceil(QM.t);if(s<=10&&s!==QM.lsec){QM.lsec=s;qmTick2(s<=3?1200:900);}}
  /* le rideau qui descend (derniere minute) */
  const sh=$('qmShut');if(fin&&!QM.map&&!QM.cine){sh.hidden=false;const k=Math.max(.04,Math.min(1,QM.j/100))*(1-Math.max(0,QM.t)/60*.5);sh.style.height=Math.round(k*16)+'vh';}else if(!sh.hidden)sh.hidden=true;}

/* ================= Lot C : pièges et dernières surprises ================= */
const QTRAP={huile:{ic:'🛢️',n:'la flaque d\'huile',z:['store']},cartons:{ic:'📦',n:'la pile de cartons',z:['reserve']},extinct:{ic:'🧯',n:'l\'extincteur',z:['store','office','reserve']},
  caddies:{ic:'🛒',n:'les caddies',z:['store','parking']},farine:{ic:'🌾',n:'le sac de farine',z:['reserve','boulangerie']},cage:{ic:'🔒',n:'la cage de livraison',z:['reserve']},
  ballons:{ic:'🎈',n:'les ballons',z:['store']},porte:{ic:'🚪',n:'la porte automatique',z:['store','reserve','office']}};
function qmDecoy(t){QM.decoy=Math.max(QM.decoy||0,t);QM.H.forEach(function(h){h.st='decoy';h.tg=null;h.dg=false;h.spot=0;if(h.grabT)qmUngrab(h);});}
function qmTrapInit(){(QM.TR||[]).forEach(function(t){scene.remove(t.m.g);});QM.TR=[];QM.trN=0;QM.dog=null;if(QM.mp&&QN.client)return;
  const K=qmShuffle(Object.keys(QTRAP)),n=QM.park?6:5,used=[];
  K.forEach(function(k){if(QM.TR.length>=n)return;const zs=QTRAP[k].z.filter(function(z){return QZ.indexOf(z)>=0&&!QM.lockZ[z];});if(!zs.length)return;const zn=zs[(Math.random()*zs.length)|0];let p;
    if(k==='porte'){const L=QPORT.filter(function(q){return q.zn===zn&&!QM.lockZ[q.to];});if(!L.length)return;const q=L[(Math.random()*L.length)|0];p=qmFree(zn,q.x+(Math.random()-.5)*2,q.z+(Math.random()-.5)*2);}
    else{for(let t=0;t<10;t++){const c=qmRand(zn);if(!used.some(function(u){return u[2]===zn&&Math.hypot(u[0]-c[0],u[1]-c[1])<10;})&&!QM.R.some(function(r){return r.zn===zn&&Math.hypot(r.x-c[0],r.z-c[1])<2;})){p=c;break;}}}
    if(!p)return;used.push([p[0],p[1],zn]);qmTrapAdd(k,zn,p[0],p[1]);});}
function qmTrapAdd(k,zn,x,z,id){const t={id:id||++QM.trN,k:k,zn:zn,x:x,z:z,cd:0,m:qmRingMesh(0x2ec4b6,QTRAP[k].ic+' Piège : '+QTRAP[k].n,360)};t.m.g.position.set(x,0,z);t.m.g.scale.setScalar(.75);QM.TR.push(t);return t;}
function qmTrapNear(a){const p=qmP(a);return (QM.TR||[]).find(function(t){return t.zn===p[2]&&!(t.cd>0)&&Math.hypot(t.x-p[0],t.z-p[1])<1.6;})||null;}
function qmTrapFire(a,t){if(!t||t.cd>0)return;if(QM.mp&&QN.client&&a.human){qnS('a',{pid:QN.pid,k:'trap',id:t.id});t.cd=45;return;}
  t.cd=45;const p=qmP(a),vis=t.zn===cur;let n=0;const near=function(R){return QM.H.filter(function(h){return h.zn===t.zn&&!h.dir&&Math.hypot(h.x-t.x,h.z-t.z)<R;});};
  const ko=function(h,s,txt){h.stun=Math.max(h.stun||0,s);h.path=null;if(h.tg)qmLose(h,null);if(h.grabT)qmUngrab(h);if(h.zn===cur&&txt)say(h.g,txt);n++;};
  if(t.k==='huile'){near(4).forEach(function(h){ko(h,3,'Wouaaah !');});t.oil=10;}
  else if(t.k==='cartons'){near(3.5).forEach(function(h){ko(h,4,'Aïe, les cartons !');});}
  else if(t.k==='extinct'){near(5.5).forEach(function(h){h.dark=4;h.slow=4;if(h.tg)qmLose(h,'Je n\'y vois plus rien !');n++;});}
  else if(t.k==='caddies'){const f=a.human?pp.face:(a.h||0);QM.H.forEach(function(h){if(h.zn!==t.zn||h.dir)return;const dx=h.x-t.x,dz=h.z-t.z,fw=dx*Math.sin(f)+dz*Math.cos(f),sd=Math.abs(dx*Math.cos(f)-dz*Math.sin(f));if(fw>0&&fw<12&&sd<1.6)ko(h,3,'Les caddies !');});const o={id:a.id,k:'cart',zn:t.zn,x:t.x,z:t.z,h:f,r:10};qmPowFx(a,'cart',o);if(QM.mp&&QN.host)qnS('fx',o);}
  else if(t.k==='farine'){near(4.5).forEach(function(h){h.slow=Math.max(h.slow||0,5);n++;});}
  else if(t.k==='cage'){const L=near(4).sort(function(x,y){return Math.hypot(x.x-t.x,x.z-t.z)-Math.hypot(y.x-t.x,y.z-t.z);});if(L[0])ko(L[0],6,'Sortez-moi de là !');}
  else if(t.k==='ballons'){qmDecoy(7);n=QM.H.length;}
  else if(t.k==='porte'){near(5).forEach(function(h){ko(h,4,'La porte !');});}
  qmBurst(t.zn,t.x,t.z,12);if(n)qmPts(a,2,'mgr');
  qmMsg(QTRAP[t.k].ic+' '+(a.human?'Tu déclenches':a.name+' déclenche')+' '+QTRAP[t.k].n+(n?' : '+n+' manager'+(n>1?'s':'')+' piégé'+(n>1?'s':'')+' !':' (raté, personne à portée)'),n?'good':'',t.zn===cur||a.human);}
function qmTrapTick(dt){const host=!(QM.mp&&QN.client);(QM.TR||[]).forEach(function(t){if(t.cd>0)t.cd-=dt;const v=(t.zn===cur||QM.map)&&!QM.cine;t.m.g.visible=v;t.m.disc.material.opacity=t.cd>0?.08:.3;t.m.ring.material.opacity=t.cd>0?.25:.95;t.m.lb.sp.visible=v&&!QM.map&&!(t.cd>0);
    if(t.oil>0&&host){t.oil-=dt;QM.H.forEach(function(h){if(h.zn===t.zn&&!h.dir&&!(h.stun>0)&&Math.hypot(h.x-t.x,h.z-t.z)<2.2){h.stun=3;if(h.zn===cur)say(h.g,'Ça glisse !');}});}});
  qmDogTick(dt,host);}
/* ---------- surprises ---------- */
function qmFireAlarm(){qmDecoy(20);QM.CE.forEach(function(n){if(!(n.gone>0)&&n.tmp===undefined){n.gone=20;n.g.visible=false;}});QM.firealT=20;qmBig('🚨 ALARME INCENDIE ! Les clients évacuent, les managers filent au point de rassemblement (20 s) !','key',1);for(let i=0;i<4;i++)setTimeout(qmSiren,i*900);}
function qmDogMesh(){const g=new T.Group();const c=0x8a5a32,d=0x5a3d22;box(g,.55,.5,1.1,c,0,.6,0,true);box(g,.42,.42,.5,c,0,.95,.65,true);box(g,.25,.2,.3,d,0,.85,.95,false);[[-.18,.35],[.18,.35],[-.18,-.35],[.18,-.35]].forEach(function(l){box(g,.14,.4,.14,d,l[0],.2,l[1],false);});box(g,.1,.25,.1,d,-.15,1.25,.6,false);box(g,.1,.25,.1,d,.15,1.25,.6,false);box(g,.08,.08,.45,c,0,.8,-.7,false);
  const lb=label('🐕 Chien du vigile',{sx:2,sy:.5,w:240,h:64,size:30,bg:'rgba(138,90,50,.95)'});lb.position.y=1.8;g.add(lb);scene.add(g);return g;}
function qmDogStart(o){const zn=o&&o.door&&QZ.indexOf(o.door.zn)>=0?o.door.zn:'store';const p=qmRand(zn);QM.dog={g:qmDogMesh(),zn:zn,x:p[0],z:p[1],h:0,ph:0,t:60,bark:0,path:null,pi:0,rp:0,calm:0};qmBig('🐕 Le chien du vigile est lâché (60 s) : il te sent à travers les gondoles ! Lance-lui un objet pour le calmer.','zomb',1);}
function qmDogTick(dt,host){const D=QM.dog;if(!D)return;D.g.visible=D.zn===cur&&!QM.cine;D.g.position.set(D.x,0,D.z);D.g.rotation.y=D.h;
  if(!host){const dx=(D.tx===undefined?D.x:D.tx)-D.x,dz=(D.tz===undefined?D.z:D.tz)-D.z,d=Math.hypot(dx,dz);if(d>.01){const st=Math.min(d,dt*6);D.x+=dx/d*st;D.z+=dz/d*st;D.h=Math.atan2(dx,dz);}return;}
  D.t-=dt;if(D.t<=0||D.calm>0){if(D.calm>0){D.calm-=dt;if(D.calm>0)return;}scene.remove(D.g);QM.dog=null;return;}
  let tg=null,bd=9;QM.A.forEach(function(a){if(!qmLive(a)||a.down>0||a.role!=='emp')return;const p=qmP(a);if(p[2]!==D.zn)return;const d=Math.hypot(p[0]-D.x,p[1]-D.z);if(d<bd){bd=d;tg=a;}});
  let gx,gz;if(tg){const p=qmP(tg);gx=p[0];gz=p[1];D.bark-=dt;if(D.bark<=0){D.bark=3;if(D.zn===cur)say(D.g,'WOUF ! WOUF !');const h=QM.H.filter(function(h){return h.zn===D.zn&&!(h.stun>0);}).sort(function(x,y){return Math.hypot(x.x-D.x,x.z-D.z)-Math.hypot(y.x-D.x,y.z-D.z);})[0];if(h&&h.st!=='decoy'){h.st='alert';h.tg=tg;h.gzn=null;h.wait=0;}if(tg.human)qmMsg('🐕 Le chien aboie : un manager arrive !','bad');}}
  else{if(!D.path||D.pi>=D.path.length){const q=qmRand(D.zn);gx=q[0];gz=q[1];}}
  D.rp-=dt;if(gx!==undefined&&(D.rp<=0||!D.path||D.pi>=D.path.length)){D.path=path(Z[D.zn],D.x,D.z,gx,gz);D.pi=0;D.rp=.6;}
  const ox=D.x,oz=D.z;if(!tg||bd>1.4)follow(D,dt,tg?3.2:2);if(Math.hypot(D.x-ox,D.z-oz)>.001)D.h=Math.atan2(D.x-ox,D.z-oz);}
function qmDogHit(a,x,z){const D=QM.dog;if(!D||D.calm>0)return false;const p=qmP(a);if(p[2]!==D.zn||Math.hypot(D.x-p[0],D.z-p[1])>10)return false;D.calm=2;qmPts(a,3,'mgr');qmMsg('🐕 '+(a.human?'Tu calmes':a.name+' calme')+' le chien avec un objet : il file se coucher !','good',1);if(D.zn===cur)say(D.g,'Ouaf… 💤');return true;}
function qmDelivery(){const zn='reserve';if(QZ.indexOf(zn)<0||QM.lockZ[zn])return false;const q=QPORT.find(function(p){return p.zn===zn;});let c=qmRand(zn);for(let i=0;i<5;i++){const p=qmFree(zn,c[0]+(i-2)*1.5,c[1]+1.2);qmBxAdd(zn,p[0],p[1]);}
  QM.H.filter(function(h){return !h.dir;}).slice(0,2).forEach(function(h,i){const p=qmFree(zn,c[0]+(i?2.5:-2.5),c[1]-1.5);h.zn=zn;h.x=p[0];h.z=p[1];h.path=null;h.gzn=null;h.tg=null;h.st='patrol';h.wait=8;});
  qmBig('🚚 Livraison surprise en réserve : 5 cartons à ouvrir… gardés par 2 managers !','key',1);return true;}

/* ================= Lot U : ultimes, inventaire, nouveau coffre, guide ================= */
const QULT={sst:{ic:'🚑',n:'Brancard',d:'Relève tous les collègues à terre de ta zone et soigne tout le monde à fond.'},
  rec:{ic:'🧱',n:'Mur de palettes',d:'Intouchable pendant 12 s : les managers ne peuvent ni t\'attraper ni te blesser.'},
  drv:{ic:'🚚',n:'Camion de livraison',d:'Un camion fonce tout droit devant toi (25 m) : tous les managers sur la route sont KO 6 s.'},
  stg:{ic:'☕',n:'Café pour tous',d:'Toute l\'équipe sabote 3 fois plus vite pendant 20 s.'},
  ent:{ic:'🧼',n:'Sol mouillé géant',d:'Toute ta zone glisse pendant 10 s : les managers tombent sans arrêt.'},
  inf:{ic:'💻',n:'Piratage des caméras',d:'15 s : les managers ne voient plus personne de l\'équipe et ne changent plus de zone.'},
  sec:{ic:'🚔',n:'Arrestation',d:'La directrice est KO 20 s où qu\'elle soit, et tous les managers sont sonnés 3 s.'},
  toy:{ic:'🤖',n:'Armée de jouets',d:'10 jouets gardes du corps pendant 45 s.'},
  ele:{ic:'⚡',n:'Black-out total',d:'Tout le magasin dans le noir 15 s : les managers voient 3 fois moins loin et ralentissent.'},
  ani:{ic:'🪩',n:'Soirée disco',d:'Managers et clients de ta zone dansent sur place 10 s, et l\'équipe court plus vite.'}};
const QULTB={sst:'relève et soigne à fond toute l\'équipe de l\'arène',rec:'intouchable 12 s, le boss ne vise que toi',drv:'gros dégâts, boss sonné 3 s, bouclier cassé',stg:'l\'équipe tape 2 fois plus vite 15 s',ent:'le boss glisse : 5 s à terre, dégâts ×2',
  inf:'bouclier cassé et prochaine attaque spéciale annulée',sec:'boss menotté 6 s + gros dégâts',toy:'10 jouets foncent sur le boss',ele:'boss aveugle 10 s : plus d\'attaques spéciales',ani:'le boss et ses renforts dansent 6 s, dégâts ×2'};
Object.assign(QIT,{pile:{ic:'🔋',n:'Pile',d:'+25 % de charge d\'ultime'},passe:{ic:'🗝️',n:'Passe',d:'ouvre n\'importe quelle salle fermée (devant sa porte)'},coeur:{ic:'❤️',n:'Cœur',d:'+1 cœur bonus (jusqu\'à 7)'}});
QIT.gilet.d='invisible pour les managers 20 s';QIT.trousse.d='relève ou soigne le collègue à côté de toi';
const QCONSK=['energy','croissant','cafe','trousse','choco','gilet','pile','passe'];/* guide */
/* ---------- charge de l'ultime ---------- */
function qmUltGain(a,n){if(!a||a.role!=='emp'||n<=0)return;if(qmIsAr(qmP(a)[2]))return;const was=a.ult||0;a.ult=Math.min(100,was+n*2.5);if(was<100&&a.ult>=100)qmMsg('⚡ Ultime de '+a.name+' prêt ! ('+QULT[a.cls].ic+' '+QULT[a.cls].n+')','good',1);}
/* ---------- declencher l'ultime ---------- */
function qmUlt(a){if(!a||a.down>0||a.out||a.cv||(a.ult||0)<100)return false;if(QM.mp&&QN.client&&a.human){qnS('a',{pid:QN.pid,k:'ult'});a.ult=0;qmMsg(QULT[a.cls].ic+' '+QULT[a.cls].n+' !','good');return true;}
  a.ult=0;const p=qmP(a),zn=p[2],ar=qmIsAr(zn),B=QM.boss&&QM.boss.zn===zn&&!QM.boss.dead?QM.boss:null,k=a.cls,res=B&&B.i===3?.5:1,nm=a.name;
  const say2=function(t){qmBig(QULT[k].ic+' '+t,'key',1);};QM.shake=.35;qmBurst(zn,p[0],p[1],20);
  if(k==='sst'){QM.A.forEach(function(b){if(qmP(b)[2]!==zn||b.out||b.cv)return;if(b.down>0){b.down=0;b.rev=0;b.imm=3;}b.hp=Math.max(b.hp,b.hpMax);});say2(nm+' : Brancard ! Toute l\'équipe de la zone est relevée et soignée !');}
  else if(k==='rec'){a.ultInv=12;if(B)B.taunt={a:a,t:12};QM.H.forEach(function(h){if(h.tg===a)qmLose(h,null);});say2(nm+' : Mur de palettes ! Intouchable 12 s.');}
  else if(k==='drv'){const f=a.human?pp.face:(a.remote&&a.th!==undefined?a.th:(a.h||0));let n=0;if(B){if(B.sh>0){B.sh=0;}qmBossHit(15,a,{st:3*res});n=1;}else QM.H.forEach(function(h){if(h.zn!==zn)return;const dx=h.x-p[0],dz=h.z-p[1],fw=dx*Math.sin(f)+dz*Math.cos(f),sd=Math.abs(dx*Math.cos(f)-dz*Math.sin(f));if(fw>-1&&fw<25&&sd<2.2){h.stun=Math.max(h.stun||0,6);if(h.tg)qmLose(h,null);if(h.grabT)qmUngrab(h);n++;}});
    const o={id:a.id,k:'cart',zn:zn,x:p[0],z:p[1],h:f,r:20};qmPowFx(a,'cart',o);if(QM.mp&&QN.host)qnS('fx',o);say2(nm+' : Camion de livraison ! '+(B?'Le boss est percuté !':n+' manager'+(n>1?'s':'')+' KO !'));}
  else if(k==='stg'){QM.cafeT=ar?15:20;say2(nm+' : Café pour tous ! '+(ar?'L\'équipe tape 2 fois plus vite.':'Sabotages ×3 pendant 20 s !'));}
  else if(k==='ent'){if(B){B.stun=Math.max(B.stun,5*res);B.tired=Math.max(B.tired||0,5*res);}else QM.wet={zn:zn,t:10};say2(nm+' : Sol mouillé géant ! '+(B?'Le boss glisse et tombe !':'Les managers glissent partout (10 s) !'));}
  else if(k==='inf'){if(B){B.sh=0;B.nx=Math.max(B.nx||0,8);B.cancel=1;}else{QM.hackT=15;QM.H.forEach(function(h){if(h.tg)qmLose(h,'Mais… plus rien sur les caméras ?!');h.gzn=null;});}say2(nm+' : Piratage ! '+(B?'Bouclier coupé et attaque annulée !':'Les managers ne voient plus personne (15 s) !'));}
  else if(k==='sec'){if(B){qmBossHit(20,a,{st:6*res});}else{QM.H.forEach(function(h){h.stun=Math.max(h.stun||0,h.dir?20:3);if(h.tg)qmLose(h,null);if(h.grabT)qmUngrab(h);});}say2(nm+' : Arrestation ! '+(B?'Le boss est menotté !':'La directrice est KO 20 s !'));}
  else if(k==='toy'){a.toys={n:10,t:45,cd:.3};say2(nm+' : Armée de jouets ! 10 jouets en renfort.');}
  else if(k==='ele'){if(B){B.nx=Math.max(B.nx||0,10);B.slow=Math.max(B.slow||0,10*res);}else{QM.dark={zn:'*',t:15};QM.H.forEach(function(h){h.dark=15;h.slow=Math.max(h.slow||0,6);if(h.tg)qmLose(h,'Qui a coupé le courant ?!');});}say2(nm+' : Black-out total ! '+(B?'Le boss est aveuglé.':'Tout le magasin est dans le noir (15 s) !'));}
  else if(k==='ani'){if(B){B.stun=Math.max(B.stun,6*res);B.tired=Math.max(B.tired||0,6*res);B.mins.forEach(function(m){if(!(m.ko>0))m.ko=6;});}else{QM.disco={zn:zn,t:10};QM.H.forEach(function(h){if(h.zn===zn&&!h.dir){h.stun=Math.max(h.stun||0,10);if(h.tg)qmLose(h,null);}});QM.CE.forEach(function(c){if(c.zn===zn&&!(c.gone>0))c.ko=Math.max(c.ko||0,10);});}
    QM.A.forEach(function(b){if(qmP(b)[2]===zn){b.boost=10;if(b.remote)qnS('buff',{id:b.id,k:'choco'});}});say2(nm+' : Soirée disco ! Tout le monde danse !');}
  qmPts(a,3,'');a.ult=0;return true;}
function qmUltTick(dt){if(QM.cafeT>0)QM.cafeT-=dt;if(QM.hackT>0)QM.hackT-=dt;QM.A.forEach(function(a){if(a.ultInv>0)a.ultInv-=dt;});
  if(QM.wet){QM.wet.t-=dt;if(QM.wet.t<=0)QM.wet=null;else if(!(QM.mp&&QN.client))QM.H.forEach(function(h){if(h.zn!==QM.wet.zn||h.dir)return;h.wf=(h.wf||0)-dt;if(h.wf<=0&&!(h.stun>0)){h.wf=1.7;h.stun=1.1;if(h.tg)qmLose(h,null);if(h.zn===cur)say(h.g,'Wouaaah !');}});}
  if(QM.disco){QM.disco.t-=dt;if(QM.disco.t<=0)QM.disco=null;else QM.H.forEach(function(h){if(h.zn===QM.disco.zn&&h.stun>0)h.g.rotation.y+=dt*6;});}
  /* bouton dore */
  const me=QM.me,U=$('qmUlt');if(!U)return;if(me.out||me.cv){U.hidden=true;return;}const c=Math.floor(me.ult||0),r=c>=100,ic=QULT[me.cls]?QULT[me.cls].ic:'⚡';
  const h='<span style="font-size:22px;line-height:1">'+ic+'</span><span>'+(r?'ULTIME':c+' %')+'</span>';if(U._h!==h){U._h=h;U.innerHTML=h;}U.hidden=false;U.classList.toggle('ready',r);U.style.setProperty('--c',c+'%');}
/* ---------- inventaire ---------- */
function qmConsAdd(a,k){a.cons=a.cons||[null,null];for(let i=0;i<2;i++){const s=a.cons[i];if(s&&s.k===k&&s.n<3){s.n++;return true;}}for(let i=0;i<2;i++){if(!a.cons[i]){a.cons[i]={k:k,n:1};return true;}}return false;}
function qmIsCons(k){return QCONS.indexOf(k)>=0;}
function qmCanTake(b,k){if(b.down>0||b.zomb>0||b.out||b.cv)return false;if(k==='coeur')return b.hp<28;if(qmIsCons(k)){const c=b.cons||[null,null];return c.some(function(s){return !s||(s.k===k&&s.n<3);});}return !b.item;}
function qmTake(a,k){const it=QIT[k];if(k==='coeur'){a.hp=Math.min(28,a.hp+4);if(a.human)qmMsg('❤️ +1 cœur bonus ('+Math.ceil(a.hp/4)+' cœurs) !','good');return;}
  if(qmIsCons(k))qmConsAdd(a,k);else a.item=k;if(a.human)qmMsg(it.ic+' Tu ramasses : '+it.n+' ('+it.d+'). Touche son icône à droite pour l\'utiliser.','good');}
function qmUseSp(a,k){const p=qmP(a);
  if(k==='pile'){a.ult=Math.min(100,(a.ult||0)+25);if(a.human)qmMsg('🔋 Pile : +25 % de charge d\'ultime ('+Math.floor(a.ult)+' %)','good');return true;}
  if(k==='passe'){const L=QROOM.filter(function(r){return QM.lockR[r.id]&&QM.RM[r.id];});const near=L.find(function(r){const o=QM.RM[r.id];return o.door&&o.door.zn===p[2]&&Math.hypot(o.door.x-p[0],o.door.z-p[1])<3.5;});
    if(near){QM.opener=a;QM.lastOp=a;qmOpenRoom(near.id);qmMsg('🗝️ '+a.name+' ouvre '+near.n+' avec le passe !','good',1);return true;}
    if(a.human)qmMsg(L.length?'🗝️ Va devant la porte d\'une salle fermée : '+L.map(function(r){return r.n;}).join(', '):'🗝️ Toutes les salles sont déjà ouvertes.');return false;}
  return false;}
function qmUseCons(a,i){a.cons=a.cons||[null,null];const s=a.cons[i];if(!s||a.down>0||a.out)return;
  if(QM.mp&&QN.client&&a.human){qnS('a',{pid:QN.pid,k:'usec',i:i});if(s.k==='cafe')QM.cafe=30;if(s.k==='choco')a.boost=20;if(s.k==='gilet')a.inv=20;return;}
  const keep=a.item;a.item=s.k;qmUseItem(a);const used=a.item!==s.k;a.item=keep;
  if(used){s.n--;if(s.n<=0)a.cons[i]=null;}}
function qmInvHud(){const me=QM.me,box=$('qmInv');if(!box)return;me.cons=me.cons||[null,null];const sl=[me.cons[0],me.cons[1],me.item?{k:me.item,n:1,sp:1}:null];
  const h=sl.map(function(s,i){return '<button class="qminv'+(i===2?' sp':'')+(s?'':' empty')+'" data-i="'+i+'">'+(s?QIT[s.k].ic+(s.n>1?'<b>×'+s.n+'</b>':''):'')+'</button>';}).join('');if(box._h!==h){box._h=h;box.innerHTML=h;
    Array.prototype.forEach.call(box.querySelectorAll('button'),function(b){b.onpointerdown=function(e){e.preventDefault();e.stopPropagation();if(!QM.on||QM.paused)return;const i=+b.dataset.i;if(i===2)qmUseItem(QM.me);else qmUseCons(QM.me,i);};});}
  box.hidden=me.out||!QM.on;}
/* ---------- nouveau coffre de fin d'arene ---------- */
function qmChestOpen(a,b){const P=QM.A.filter(function(x){return x.zn===b.zn;});const zn=Z[b.zn];
  P.forEach(function(x){x.wl=Math.min(3,qmWl(x)+1);if(x.down>0){x.down=0;x.rev=0;}x.hp=Math.max(x.hp,x.hpMax);x.ult=Math.min(100,(x.ult||0)+50);if(x.human){QM.st=100;QM.stx=false;}else if(x.remote)qnS('buff',{id:x.id,k:'cafe'});});
  const spot=function(){for(let t=0;t<20;t++){const x=zn.bounds.x[0]+3+Math.random()*(zn.bounds.x[1]-zn.bounds.x[0]-6),z=zn.bounds.z[0]+3+Math.random()*(zn.bounds.z[1]-zn.bounds.z[0]-6);if(!hit(x,z,.5,zn))return [x,z];}return [b.x,b.z];};
  for(let i=0;i<Math.max(2,P.length);i++){const q=spot();qmItemAdd(++QM.itN,'coeur',b.zn,q[0],q[1]);}
  const L=['croissant','cafe','choco','gilet','trousse','pile','pile','energy'];for(let i=0;i<4;i++){const q=qmFree(b.zn,b.x+(i-1.5)*1.3,b.z-1.2);qmItemAdd(++QM.itN,L[(Math.random()*L.length)|0],b.zn,q[0],q[1]);}
  if(Math.random()<.45){const q=qmFree(b.zn,b.x,b.z+1.5);qmItemAdd(++QM.itN,'passe',b.zn,q[0],q[1]);}
  qmPts(a,5,'');qmMsg('🧰 Coffre ouvert : vie pleine, +50 % d\'ultime, arme améliorée… et des cœurs ❤️ éparpillés dans la salle : partagez-les !','good',1);}
/* ---------- guide ---------- */
function qmGuide(tab){tab=tab||'obj';const T2={obj:'🎒 Objets',trap:'🪤 Pièges',cls:'👷 Classes',boss:'👹 Boss'};let h='<h2 class="qmemp">📖 Guide</h2><div class="qmgt">'+Object.keys(T2).map(function(k){return '<button class="abtn2'+(k===tab?' on':'')+'" data-g="'+k+'">'+T2[k]+'</button>';}).join('')+'</div><div class="qmgl">';
  if(tab==='obj'){h+='<p class="qmd">2 emplacements de consommables (jusqu\'à ×3 du même) + 1 emplacement spécial (objet à lancer, 🔋 pile ou 🗝️ passe), sur le bord droit. Touche une icône pour l\'utiliser.</p>';QCONSK.concat(['coeur']).forEach(function(k){h+='<div class="qmgi"><b>'+QIT[k].ic+' '+QIT[k].n+'</b> : '+QIT[k].d+'</div>';});h+='<div class="qmgi"><b>🥫🥚🧻📦📎 Objets à lancer</b> : pris dans les rayons (Agir près d\'une étagère) ; sonnent un manager 3 s, mettent un client KO.</div><div class="qmgi"><b>📦 Cartons</b> : Agir 2 s pour les ouvrir (objets, améliorations… ou piège).</div>';}
  else if(tab==='trap'){const D={huile:'il glisse et tombe 3 s, la flaque reste 10 s',cartons:'s\'écroulent : sonné 4 s',extinct:'aveuglé 4 s, il perd ta trace',caddies:'rangée lancée en ligne : KO 3 s',farine:'ralenti 5 s',cage:'enfermé 6 s',ballons:'les managers filent à l\'accueil 7 s',porte:'se referme sur eux : sonnés 4 s'};
    h+='<p class="qmd">Ronds turquoise : Agir 1 s pour déclencher quand un manager approche. Recharge 45 s.</p>';Object.keys(QTRAP).forEach(function(k){h+='<div class="qmgi"><b>'+QTRAP[k].ic+' '+QTRAP[k].n+'</b> : '+D[k]+'</div>';});}
  else if(tab==='cls'){QCK.forEach(function(k){const c=QCL[k],w=QCW[k],p=QPOW[c.pw],u=QULT[k];h+='<div class="qmgi"><b>'+c.ic+' '+c.n+'</b><br>⚔️ '+w.ic+' '+w.n+' : '+w.d+'<br>✨ '+p.ic+' '+p.b+' : '+p.d+'<br>🔹 '+c.pas+'<br>⚡ Ultime '+u.ic+' '+u.n+' : '+u.d+' <i>(boss : '+QULTB[k]+')</i></div>';});}
  else{const BD=['pâtons collants qui ralentissent, farine qui aveugle','souffle de givre en cône, verglas qui fait glisser','piles de dossiers, « entretien » qui immobilise 3 s ; enragée à 40 %','charge en ligne droite, caddies, managers en renfort ; enragée à 50 %, résiste aux ultimes'];
    h+='<p class="qmd">Un boss peut surgir en ouvrant une salle. 4 joueurs max dans l\'arène. Il saute, bombarde (cercles rouges), se protège d\'un bouclier (seuls les pouvoirs, ultimes et objets lancés le cassent), puis s\'essouffle : c\'est le moment de taper (×2). De face il pare (÷2), dans le dos ×1,5.</p>';QBOSS.forEach(function(B,i){h+='<div class="qmgi"><b>'+B.ic+' '+B.n+'</b> ('+B.ar+') : '+BD[i]+'</div>';});}
  h+='</div><button class="abtn full" id="qmGBack" style="margin-top:8px">⬅ Retour</button>';qmOv(h);
  Array.prototype.forEach.call(document.querySelectorAll('[data-g]'),function(b){b.onclick=function(){qmGuide(b.dataset.g);};});$('qmGBack').onclick=function(){if(QM._gInt!==undefined){const p=QM._gInt;QM._gInt=undefined;qmIntro(p);}else if(QM.on&&!QM.end)qmMenu();else qmOvClose();};}

/* ===================== OPÉRATION RIDEAU DE FER : salles en ligne (relais Cloudflare) =====================
   Une salle d'attente commune (rdf-lobby) + 3 salles de jeu (rdf-s1..3). L'hôte (le plus ancien joueur de la salle) fait tourner
   la directrice, les managers, les PNJ et la jauge ; les autres joueurs envoient leur position et leurs actions. */
const QN={on:false,pid:Math.random().toString(36).slice(2,10),ws:null,ok:{},ref:0,host:false,client:false,salle:0,ready:false,joined:0,all:{},hd:{},tx:0,snapT:0,lastSnap:0,dl:0,goT:0,cnt:0};
const QNMAX=8;
const QN_URL='wss://rdf-relais.jmhouv.workers.dev';/* relais Cloudflare (Durable Object) : une connexion par salle */
QN.socks={};
function qnOpen(){QN.on=true;if(!QN.socks.lobby)qnJoin('lobby');if(QN.salle&&!QN.socks['s'+QN.salle])qnJoin('s'+QN.salle);if(!QN.hbL)QN.hbL=setInterval(qnBeat,1500);}
function qnJoin(t){if(QN.socks[t])return;let ws;try{ws=new WebSocket(QN_URL+'/room/rdf-'+t);}catch(e){QN.err='Connexion au serveur impossible ici. Le jeu en ligne marche sur la version itch.io ; ici, joue en solo.';qnLobbyDraw();return;}
  QN.socks[t]=ws;QN.ok[t]=0;
  ws.onopen=function(){QN.ok[t]=1;QN.fails=0;QN.err='';if(t==='lobby')qnBeat();if(!QM.on)qnLobbyDraw();};
  ws.onmessage=function(e){let m=null;try{m=JSON.parse(e.data);}catch(_){return;}if(m&&typeof m.e==='string'&&m.d&&typeof m.d==='object')qnRecv(t,m.e,m.d);};
  ws.onclose=function(){if(QN.socks[t]!==ws)return;delete QN.socks[t];const was=QN.ok[t];QN.ok[t]=0;if(!was)QN.fails=(QN.fails||0)+1;
    if(QN.fails>=3)QN.err='Connexion au serveur impossible ici. Le jeu en ligne marche sur la version itch.io ; ici, joue en solo.';
    if(QN.on&&!QN.quit&&QN.fails<6&&(t==='lobby'||t==='s'+QN.salle))setTimeout(function(){if(QN.on&&!QN.quit&&(t==='lobby'||t==='s'+QN.salle))qnJoin(t);},2000);
    if(!QM.on)qnLobbyDraw();else if(t==='s'+QN.salle&&QM.mp&&!QM.end)qmMsg('📶 Connexion perdue, reconnexion…','bad');};
  ws.onerror=function(){};}
function qnLeave(t){const ws=QN.socks[t];delete QN.socks[t];QN.ok[t]=0;try{if(ws)ws.close();}catch(_){}}
function qnCloseAll(){QN.quit=true;QN.on=false;Object.keys(QN.socks).forEach(qnLeave);}
function qnSend(t,ev,d){const ws=QN.socks[t];if(!ws||ws.readyState!==1)return false;QN.cnt++;try{ws.send(JSON.stringify({e:ev,d:d}));}catch(_){return false;}return true;}
function qnS(ev,d){if(QN.salle)qnSend('s'+QN.salle,ev,d);}
/* ---------- salle d'attente ---------- */
function qnBeat(){if(!QN.on)return;const st=QM.on&&QM.mp?'g':'w';
  qnSend('lobby','hb',{pid:QN.pid,n:PNAME,cl:QN.cls||'',s:QN.salle,rd:QN.ready?1:0,j:QN.joined,st:st,tl:st==='g'?Math.ceil(QM.t||0):0,lk:lookOpts(),dl:QN.dl?Math.max(0,Math.ceil((QN.dl-Date.now())/1000)):0});
  if(!QM.on)qnLobbyTick();}
function qnMembers(k,st){const now=Date.now(),L=[];Object.keys(QN.all).forEach(function(id){const p=QN.all[id];if(p.s===k&&now-p.seen<5000&&(!st||p.st===st))L.push(p);});
  if(QN.salle===k&&!QM.on&&(!st||st==='w'))L.push({pid:QN.pid,n:PNAME,cl:QN.cls||'',s:k,rd:QN.ready?1:0,j:QN.joined,st:'w',lk:lookOpts(),me:1});
  L.sort(function(a,b){return (a.j-b.j)||(a.pid<b.pid?-1:1);});return L;}
function qnRecv(t,ev,d){
  if(t==='lobby'){if(ev==='hb'&&typeof d.pid==='string'&&d.pid!==QN.pid){QN.all[d.pid]=Object.assign(d,{seen:Date.now()});if(!QM.on)qnLobbyDraw();}
    else if(ev==='go'&&d.s===QN.salle&&!QM.on){if((d.R||[]).some(function(r){return r.pid===QN.pid;}))qnGo(d,false);else{QN.ready=false;QN.kick='La partie de la salle '+d.s+' a démarré sans toi (tu n\'étais pas prêt).';qnLobbyDraw();}}
    return;}
  if(!QM.on||!QM.mp||t!=='s'+QN.salle)return;
  if(QN.host){qnHostRecv(ev,d);return;}
  qnClientRecv(ev,d);}
function qnLobbyTick(){if(!QN.salle||QM.on)return;const M=qnMembers(QN.salle,'w');if(!M.length)return;const hostP=M[0];
  const ing=qnMembers(QN.salle,'g').length;if(ing)return;
  if(hostP.pid!==QN.pid){QN.dl=0;return;}
  const n=M.length,rd=M.filter(function(p){return p.rd;}).length;
  if(n>=2&&rd===n){if(!QN.goT)QN.goT=Date.now()+3000;}else QN.goT=0;
  if(n>=2&&rd>=Math.ceil(n/2)&&rd<n){if(!QN.dl)QN.dl=Date.now()+60000;}else if(rd===n)QN.dl=0;else QN.dl=0;
  const now=Date.now();
  if((QN.goT&&now>=QN.goT)||(QN.dl&&now>=QN.dl&&rd>=2)){const H=M.filter(function(p){return p.rd;}).slice(0,QNMAX).map(function(p){return {pid:p.pid,n:p.n,lk:p.lk,cl:p.cl||''};});
    const R=qmMakeRoster(H);const d={s:QN.salle,R:R,h:QN.pid,map:qmPickMap()};QN.goT=0;QN.dl=0;qnSend('lobby','go',d);qnGo(d,true);}
  qnLobbyDraw();}
function qnLobby(i){QN.ch=i;QN.quit=false;QN.kick='';try{accLoadChar(i);}catch(_){}
  qnOpen();qnLobbyDraw();}
function qnEnter(k){if(QN.salle&&QN.salle!==k)qnLeave('s'+QN.salle);QN.salle=k;QN.ready=false;QN.joined=Date.now();QN.kick='';QN.dl=0;QN.goT=0;qnJoin('s'+k);qnBeat();qnLobbyDraw();}
function qnExit(){if(QN.salle)qnLeave('s'+QN.salle);QN.salle=0;QN.ready=false;QN.dl=0;QN.goT=0;qnBeat();qnLobbyDraw();}
function qnLobbyDraw(){if(QM.on)return;const a=$('acc');if(!a||ACCST!=='rdf')return;a.hidden=false;a.className='menu';
  const now=Date.now();let h='<div class="accw rdfl"><h2 class="ttl" style="text-align:center;margin:6px 0">⚡ Opération Rideau de fer</h2>';
  if(QN.err)h+='<div class="rdferr">⚠️ '+esc(QN.err)+'</div>';
  if(QN.kick)h+='<div class="rdferr">'+esc(QN.kick)+'</div>';
  if(!QN.salle){
    h+='<p class="rdfp">Choisis une salle pour jouer avec tes amis. Les places vides sont prises par des PNJ.</p>';
    for(let k=1;k<=3;k++){const W=qnMembers(k,'w'),G=qnMembers(k,'g');const full=W.length>=QNMAX;const tl=G.length?Math.max.apply(null,G.map(function(p){return p.tl||0;})):0;
      h+='<div class="rdfs"><div class="rdfh"><b>Salle '+k+'</b><span>'+(G.length?'🎮 En cours · encore '+Math.floor(tl/60)+':'+String(tl%60).padStart(2,'0'):full?'Complète':(W.length+'/'+QNMAX))+'</span></div>'
        +'<div class="rdfn">'+((G.length?G:W).map(function(p){return '<span>'+esc(p.n)+'</span>';}).join('')||'<i>Personne pour l\'instant</i>')+'</div>'
        +'<button class="abtn" data-k="'+k+'"'+((G.length||full||!QN.ok.lobby)?' disabled':'')+'>Rejoindre la salle '+k+'</button></div>';}
    h+='<button class="abtn2 full" id="rdfSolo">🤖 Partie solo avec des PNJ</button><button class="abtn2 full" id="rdfBack" style="margin-top:8px">⬅ Retour</button>';
    if(!QN.ok.lobby&&!QN.err)h+='<p class="rdfp">Connexion au serveur…</p>';}
  else{const W=qnMembers(QN.salle,'w'),rd=W.filter(function(p){return p.rd;}).length,host=W[0];const hb=host&&!host.me?QN.all[host.pid]:null;const dl=host&&host.me?(QN.dl?Math.ceil((QN.dl-now)/1000):0):(hb&&hb.dl)||0;
    h+='<div class="rdfs on"><div class="rdfh"><b>Salle '+QN.salle+'</b><span>'+W.length+'/'+QNMAX+' · '+rd+' prêt'+(rd>1?'s':'')+'</span></div><div class="rdfl2">'
      +W.map(function(p){return '<div class="rdfm">'+(p.rd?'✅':'⏳')+' '+esc(p.n)+(p.me?' (toi)':'')+(QCL[p.cl]?' · '+QCL[p.cl].ic+' '+QCL[p.cl].n:'')+(p===host?' <small>· hôte</small>':'')+'</div>';}).join('')+'</div>';
    {const tk={};W.forEach(function(p){if(!p.me&&QCL[p.cl]&&!tk[p.cl]&&p.j<=QN.joined)tk[p.cl]=p.n;});if(QN.cls&&tk[QN.cls])QN.cls='';W.forEach(function(p){if(!p.me&&QCL[p.cl]&&!tk[p.cl])tk[p.cl]=p.n;});
      h+='<p class="rdfp"><b>Choisis ta classe</b> (une seule fois par équipe) :</p>'+qmClsGrid(QN.cls,tk)+(QN.cls?qmClsInfo(QN.cls):'<p class="rdfp">Sans choix, une classe libre te sera donnée au lancement.</p>');}
    let st='';if(QN.goT||(W.length>=2&&rd===W.length))st='🚀 Tout le monde est prêt : lancement !';else if(dl>0)st='⏱️ Lancement dans '+dl+' s (ceux qui ne sont pas prêts restent dehors)';else if(W.length<2)st='En attente d\'au moins un autre joueur…';else st='En attente que tout le monde soit prêt…';
    h+='<p class="rdfp"><b>'+st+'</b></p><button class="abtn full" id="rdfReady">'+(QN.ready?'❌ Finalement pas prêt':'✅ Je suis prêt')+'</button><button class="abtn2 full" id="rdfLeave" style="margin-top:8px">Quitter la salle</button></div>';}
  h+='</div>';a.innerHTML=h;
  Array.prototype.forEach.call(a.querySelectorAll('[data-k]'),function(b){b.onclick=function(){qnEnter(+b.dataset.k);};});
  const so=$('rdfSolo');if(so)so.onclick=function(){qnCloseAll();qmLaunchGo(QN.ch,null);};
  const bk=$('rdfBack');if(bk)bk.onclick=function(){qnCloseAll();accShow('list','');};
  const rb=$('rdfReady');if(rb)rb.onclick=function(){QN.ready=!QN.ready;qnBeat();qnLobbyDraw();};
  const lv=$('rdfLeave');if(lv)lv.onclick=qnExit;
  Array.prototype.forEach.call(a.querySelectorAll('.qmcl'),function(b){b.onclick=function(){QN.cls=b.dataset.c;qnBeat();qnLobbyDraw();};});}
function qnGo(d,amHost){QN.host=amHost;QN.client=!amHost;QN.hostPid=d.h;QN.lastSnap=Date.now();QN.R=d.R;
  const a=$('acc');a.innerHTML='<div class="accw"><h2 class="ttl" style="text-align:center">🚀 La partie commence !</h2><p class="rdfp" style="text-align:center">'+d.R.filter(function(r){return r.pid;}).map(function(r){return esc(r.n);}).join(', ')+'</p></div>';
