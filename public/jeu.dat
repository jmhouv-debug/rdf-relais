 else if(k===1&&idle.length&&!MX.seat){const c=idle[(Math.random()*idle.length)|0],e=c.userData.e;empS(e);e.im=Math.max(0,e.im-6);c.userData.busy=true;MX.seat={d:c,ch:c.userData.seat,t:0,hit:0};h.pt=2;say(d,'Oups, un siège défectueux…');if(rank===0)toast('💺 '+m.name+' déclenche le siège éjectable de '+e.name+' !');}
 else if(k===2&&idle.length>1&&!MX.corner){const c=idle[(Math.random()*idle.length)|0],e=c.userData.e;e.corner=1;empS(e);e.sw=Math.max(0,e.sw-3);c.userData.busy=true;standOne(c);MX.corner={d:c,ph:'go',s:12};h.pt=2;say(d,e.name+', au coin !');if(rank===0)toast('🧱 '+m.name+' envoie '+e.name+' au coin.');}
 else if(k===3&&!MX.slide){MX.slide={t:0,dur:12,n:4};scrMode('slide');h.pt=3;say(d,'Voici mon diaporama…');}
 else{say(d,HLINES[(Math.random()*HLINES.length)|0]);h.pt=1.5;}
 if(rank===0&&!PSEAT&&k>=1&&h.nag<2){h.nag++;toast('🪑 '+m.name+' te regarde : « Assieds-toi ! » (approche d\'une chaise libre).');}}
