let PLAN=(readJ('edm_plan')||[]).filter(function(k){return typeof k==='string';}).slice(0,3),GH=readJ('edm_ghost');
let CLS='e',CLSI=0,CLSON=0;
function SVK(r){return CK('edm_save')+((r||CLS)==='e'?'':'_'+(r||CLS));}
function SVOK(){return !!readJ(SVK());}
var REALC=null;
function saveGame(){if(!STARTED)return;try{localStorage.setItem(SVK(SEC?'v':rank>=1?'m':'e'),JSON.stringify({GR:GRADE,GX:VGXP,SB:SB,SW:SW,coins:(LK.sim&&REALC!==null?REALC:coins),lives:lives,blames:blames,pd:PDAY,image:image,mins:mins,INV:INV}));localStorage.setItem(CK('edm_lv'),JSON.stringify({e:LVL,m:LVM,t:LT}));proSave();}catch(_){}}
/* ---------- comptes locaux : e-mail + mot de passe (enregistrés sur cet appareil uniquement), liste de persos ---------- */
const ACCK='edm_acc2',SESK='edm_ses',LKF=['g','name','build','tall','hs','hc','beard','cap','skin','role','sim','ic','top','pant'];
let CONFD=-1,ACCD={},ACC=null,CUR_CH=0,PLAY_CH=-1,ACCST='login',ACCMSG='',ACCBUSY=false,CRNEW=false,CONFR=-1,ACCMAIL='',SU={fn:'',ln:'',age:''};
function accLoad(){ACCD=readJ(ACCK)||{};}
function accSave(){try{localStorage.setItem(ACCK,JSON.stringify(ACCD));}catch(_){}}
function CK(k){return ACC?k+':'+ACC.id+':'+CUR_CH:k;}
function lkSet(c){const d={g:'h',name:'',build:1,tall:1,hs:'court',hc:0x4a2c1a,beard:0,cap:0x2f6fd0,skin:0xf1c9a5,role:'e',sim:0,ic:'⭐',top:null,pant:null};LKF.forEach(function(k){LK[k]=(c&&c[k]!==undefined)?c[k]:d[k];});}
function lkSnap(){const o={};LKF.forEach(function(k){o[k]=LK[k];});return o;}
function h53(str){let h1=0xdeadbeef,h2=0x41c6ce57;for(let i=0;i<str.length;i++){const ch=str.charCodeAt(i);h1=Math.imul(h1^ch,2654435761);h2=Math.imul(h2^ch,1597334677);}h1=Math.imul(h1^(h1>>>16),2246822507)^Math.imul(h2^(h2>>>13),3266489909);h2=Math.imul(h2^(h2>>>16),2246822507)^Math.imul(h1^(h1>>>13),3266489909);return (4294967296*(2097151&h2)+(h1>>>0)).toString(16);}
async function pwHash(salt,pw){try{if(window.crypto&&crypto.subtle&&window.TextEncoder){const k=await crypto.subtle.importKey('raw',new TextEncoder().encode(pw),'PBKDF2',false,['deriveBits']);const b=await crypto.subtle.deriveBits({name:'PBKDF2',salt:new TextEncoder().encode(salt),iterations:60000,hash:'SHA-256'},k,256);return Array.from(new Uint8Array(b)).map(function(x){return x.toString(16).padStart(2,'0');}).join('');}}catch(_){}return 'f'+h53(salt+':'+pw)+h53(pw+':'+salt);}
function esc(t){return String(t==null?'':t).replace(/[<>&"]/g,'');}
function accDraw(){const r=Math.random()*100;return r<78?'e':'v';}
let DRAWN=null;
function accRoleOf(i){const L=accChars(),c=L[i]||{};let r=c.rl,forced=null;try{const q=(location.search||'').match(/[?&]role=([emv])/);if(q)forced=q[1];}catch(_){}
  if(forced)r=forced;
  if(!r){const id=ACC&&ACC.id,has=function(x){try{return !!readJ('edm_save:'+id+':'+i+x);}catch(_){return false;}};r=has('')?'e':has('_m')?'m':has('_v')?'v':accDraw();if(!has('')&&!has('_m')&&!has('_v'))DRAWN=r;}
  if(r==='m'&&!forced&&!(c&&c.pm))r='e';if(L[i]&&L[i].rl!==r){L[i].rl=r;accSave();}return r;}
function chRole(r,pm){try{const c=accChars()[PLAY_CH];if(c){c.rl=r;c.pm=pm?1:0;accSave();}}catch(_){}}
function pmF(){try{const c=accChars()[PLAY_CH];return !!(c&&c.pm);}catch(_){return false;}}
function accDelChar(i){const id=ACC.id,L=accChars(),n=L.length,suf=['','_m','_v'];
  try{const keys=function(j){return suf.map(function(x){return 'edm_save:'+id+':'+j+x;}).concat(['edm_lv:'+id+':'+j,'edm_ghost:'+id+':'+j,'edm_plan:'+id+':'+j]);};
    for(let j=i;j<n;j++){const cu=keys(j),nx=j+1<n?keys(j+1):null;cu.forEach(function(k,q){if(nx){const v=localStorage.getItem(nx[q]);if(v===null)localStorage.removeItem(k);else localStorage.setItem(k,v);}else localStorage.removeItem(k);});}}catch(_){}
  L.splice(i,1);if(PLAY_CH>i)PLAY_CH--;accSave();try{if(typeof cPush==='function')cPush(true);}catch(_){}}
function accChars(){return (ACC&&ACCD[ACC.id]&&ACCD[ACC.id].ch)||[];}
function accShow(st,msg){ACCST=st;if(msg!==undefined)ACCMSG=msg;const a=$('acc');a.hidden=false;$('creator').hidden=true;$('crTitle').hidden=true;accRender();}
const ARTSRC=(function(){var b=document.getElementById('bootArt');return b?b.src:'';})();try{document.getElementById('acc').style.setProperty('--art','url('+ARTSRC+')');}catch(_){}
function accRender(){if(ACCST==='game'){qmGameScreen();return;}if(ACCST==='rdf'){qnLobbyDraw();return;}const a=$('acc'),roleN={e:'Employé',m:'Manager',v:'Vigile'};a.className=ACCST==='title'?'':'menu';const LC=ACCST==='list'||ACCST==='class';let h=ACCST==='title'?'<div class="accw tw"><div class="tart"><div class="artw"><img alt="" src="'+ARTSRC+'"><button class="pbtn" data-a="play" aria-label="Jouer"></button></div></div>':LC?'<div class="accw lst">':'<div class="accw"><h2>Employé du Mois</h2>';
  const fld=function(id,lab,type,val,ph,ac){return '<label>'+lab+'</label><input id="'+id+'" type="'+type+'" autocomplete="'+(ac||'off')+'" placeholder="'+(ph||'')+'" value="'+esc(val)+'"'+(type==='email'?' inputmode="email" autocapitalize="off"':'')+'>';};
  if(ACCST==='title'){}
  else if(ACCST==='login'){h+='<p class="accn">Connecte-toi pour retrouver tes persos, sur n\'importe quel téléphone et après chaque mise à jour du jeu.</p>'
    +fld('accMail','E-mail','email',ACCMAIL,'toi@exemple.fr','email')+fld('accPw','Mot de passe','password','','','current-password')
    +'<div class="accrow"><button class="abtn" data-a="login"'+(ACCBUSY?' disabled':'')+'>Se connecter</button></div>'
    +'<p class="accm" id="accMsg">'+esc(ACCMSG)+'</p>'
    +'<p class="accn">Pas encore de compte ? <button class="alink" data-a="tosignup">Créer un compte</button></p>'
    +'<p class="accn"><button class="alink" data-a="guest">Jouer sans compte</button> (sauvegarde sur cet appareil seulement)</p>';}
  else if(ACCST==='signup'){h+='<p class="accn">Crée ton compte avec une adresse e-mail et un mot de passe : tes personnages et ta progression seront sauvegardés en ligne.</p>'
    +fld('accMail','E-mail','email',ACCMAIL,'toi@exemple.fr','email')+fld('accPw','Mot de passe (6 caractères minimum)','password','','','new-password')+fld('accPw2','Confirmer le mot de passe','password','','','new-password')
    +'<div class="accrow"><button class="abtn" data-a="create"'+(ACCBUSY?' disabled':'')+'>Créer mon compte</button><button class="abtn2" data-a="tologin">Retour</button></div>'
    +'<p class="accm" id="accMsg">'+esc(ACCMSG)+'</p>'
    +'<p class="accn">Ton mot de passe est géré par le serveur de connexion : le jeu ne le stocke jamais. Garde-le bien, il ne peut pas être récupéré ici.</p>';}
  else if(ACCST==='class'){const c=accChars()[CLSI]||{},id=ACC.id,lv=readJ('edm_lv:'+id+':'+CLSI)||{},v0=readJ('edm_save:'+id+':'+CLSI)||{},sv=function(r){return readJ('edm_save:'+id+':'+CLSI+(r==='e'?'':'_'+r));};
    const cur=function(r){return STARTED&&CLSI===PLAY_CH&&CLS===r;};
    const card=function(r,ic,nm,desc,info){const s=sv(r);const por={e:'bemp',m:'bman',v:'bvig'}[r],ico={e:'bice',m:'bicm',v:'bicv'}[r];return '<div class="ccard'+(cur(r)?' cur':'')+'"><div class="por" style="background-image:var(--i-'+por+')"></div><div><div class="ct"><i style="background-image:var(--i-'+ico+')"></i><b>'+nm+'</b></div><span class="lvp">'+info+(s?' • '+Math.floor(s.coins||0)+' pièces':' • nouvelle partie')+(cur(r)?' • en jeu':'')+'</span><p>'+desc+'</p><button class="abtn" data-a="cls" data-r="'+r+'">▶ '+(cur(r)?'Reprendre':s?'Continuer':'Commencer')+'</button></div></div>';};
    h+='<div class="hd" style="background-image:var(--i-bhead);aspect-ratio:941/268"></div><div class="pill"><i></i>'+esc(c.name||'Sans nom')+' – '+(CLSON?'en ligne':'solo')+'</div><h3 class="qq">Quelle classe choisis-tu ?</h3><p class="accn">Chaque classe a sa propre progression : tu retrouves ton niveau d\'employé en revenant employé, même après avoir joué manager ou vigile.</p>'
      +card('e','👷','Employé','Tu piéges les managers, tu glandes malin et tu montes de niveau pour débloquer des objets.','Niveau '+(lv.e||v0.LV||1))
      +(c.pm?card('m','👔','Manager','Tu mets la pression aux employés, tu gères la réputation du magasin et tu accèdes au bureau de la directrice.','Niveau '+(lv.m||v0.LM||1)):'')
      +card('v','🛡️','Vigile','Tu surveilles, tu fouilles et tu fais tomber les voleurs, sans pouvoir être piégé par les managers.',GN[(sv('v')||{}).GR||0]||'Agent')
      +'<div class="accrow"><button class="abtn2" data-a="clsback">Retour</button></div><div class="foot" style="background-image:var(--i-afoot)"></div>';}
  else{const L=accChars(),GS=qmSel();h+='<div class="gcur"><span>'+(GS==='fm'?'⚡ Opération Rideau de fer':'🏬 Employé du Mois')+'</span><button data-a="gpick">🎮 Changer de jeu</button></div>';if(ACC&&ACC.id&&!ACC.guest)h+='<div class="gacc"><span>👤 '+esc(ACC.id)+'</span><button data-a="acclogout">Se déconnecter</button></div>';if(GS==='fm')h+='<div class="fmi"><b>⚡ Opération Rideau de fer</b> · partie rapide de 10 min. Une équipe de 8 employés, dont 2 traîtres : faites tomber le rideau de fer avant la fin du chrono, et démasquez les traîtres en réunion d\'urgence.<br><small>Version provisoire : les places sans joueur sont tenues par des PNJ.</small></div>';h+='<div class="sais">🏆 SAISON '+SEASON.n+' · Employé de la semaine</div><div class="hd" style="background-image:var(--i-ahead);aspect-ratio:941/510"></div><div class="lab" style="background-image:var(--i-alabel);aspect-ratio:425/88"></div>';
    if(!L.length)h+='<p class="accn">Aucun personnage pour l\'instant : crée le tien !</p>';
    L.forEach(function(c,i){const cur=STARTED&&i===PLAY_CH;let sv=null;try{sv=readJ('edm_save:'+ACC.id+':'+i)||readJ('edm_save:'+ACC.id+':'+i+'_m')||readJ('edm_save:'+ACC.id+':'+i+'_v');}catch(_){}
      const ib=function(a,k,lab,extra){return '<button class="ib" data-a="'+a+'" data-i="'+i+'" style="background-image:var(--i-'+k+')" aria-label="'+lab+'"'+(extra||'')+'></button>';};
      h+='<div class="lcard'+(cur?' cur':'')+'"><div class="lrow"><div class="lav" style="background-image:var(--i-aavatar)"></div><div class="lnm">'+esc(c.name||'Sans nom')+'<small>Employé • Manager • Vigile'+(c.sim?' • simulation':'')+(sv?' • partie en cours':'')+(cur?' • en jeu ('+roleN[CLS]+')':'')+'</small></div></div><div class="g2">'
        +(GS==='fm'?'<button class="abtn" data-a="qmplay" data-i="'+i+'" style="grid-column:1/3">⚡ Jouer une partie rapide</button>':(cur?'<button class="abtn" data-a="resume">Reprendre la partie</button>':ib('solo','asolo','Jouer solo')+ib('online','aonline','En ligne')))
        +ib('edit','aedit','Modifier')+(cur?'':(CONFD===i?'<button class="abtn2" data-a="del" data-i="'+i+'" style="grid-column:1/3;background:#b3261e;color:#fff">Confirmer : supprimer « '+esc(c.name||'Sans nom')+' » ?</button>':'<button class="abtn2" data-a="del" data-i="'+i+'" style="grid-column:1/3">🗑️ Supprimer ce personnage</button>'))+(sv&&!cur?(CONFR===i?'<button class="abtn2" data-a="reset" data-i="'+i+'">Confirmer : tout effacer ?</button>':ib('reset','areset','Recommencer à zéro')):'')+'</div></div>';});
    h+='<button class="ib wide" data-a="new" style="background-image:var(--i-anew)" aria-label="Créer un personnage"></button>'
      +'<p class="accm" id="accMsg">'+esc(ACCMSG)+'</p>'
      +'<div class="info" style="background-image:var(--i-ainfo)"></div><div class="foot" style="background-image:var(--i-afoot)"></div>';}
  a.innerHTML=h+'</div>';}
function accSession(email){try{if(email)localStorage.setItem(SESK,email);else localStorage.removeItem(SESK);}catch(_){}}
function accOpenCreator(idx,isNew){CUR_CH=idx;CRNEW=isNew;if(isNew)lkSet(null);else lkSet(accChars()[idx]);$('acc').hidden=true;$('creator').hidden=false;$('crTitle').hidden=false;CREATING=true;document.body.dataset.mode='create';crRender();pvRebuild();}
/* ---- compte en ligne (Supabase Auth) : les persos suivent le compte, meme apres une mise a jour du jeu ---- */
const CLOUD={tok:null,rt:null,exp:0,last:'',busy:0};
function cOn(){try{return !!(SB_URL&&SB_KEY);}catch(_){return false;}}
async function cReq(method,path,body,tok){try{const r=await fetch(SB_URL+path,{method:method,headers:{'apikey':SB_KEY,'Content-Type':'application/json','Authorization':'Bearer '+(tok||SB_KEY)},body:body?JSON.stringify(body):undefined,keepalive:method==='PUT'});let j=null;try{j=await r.json();}catch(_){}return {ok:r.ok,st:r.status,j:j||{}};}catch(e){return {ok:false,st:0,j:{},net:true};}}
/* ---- base partagee (saisons, roles, classement) : tout est optionnel, repli local si le serveur ne repond pas ---- */
const SRV={on:0,beatT:0,lastR:0,lastC:0,act:0,board:null,bt:0};
async function sRpc(fn,args){try{if(!cOn()||!(CLOUD.tok||CLOUD.rt))return null;if(!(await cFresh()))return null;const r=await cReq('POST','/rest/v1/rpc/'+fn,args||{},CLOUD.tok);return r.ok?r.j:null;}catch(_){return null;}}
async function sRegister(i){const c=accChars()[i];if(!c)return null;const fresh=!c.rl;SRV.nw=0;const j=await sRpc('edm_register',{p_slot:i,p_name:c.n||c.name||'Employé'});
  if(!j||!j.role)return null;SRV.on=1;SRV.role=j.role;SRV.pm=!!j.promoted;if(j.season)SEASON.n=j.season;SEASON.wk=wkNow();
  const nwk=!!(c.se&&j.season&&c.se!==j.season);if(j.season)c.se=j.season;
  if(fresh||nwk){c.rl=j.role;c.pm=j.promoted?1:0;DRAWN=j.role;}if(nwk&&!fresh)c.srs=j.season;accSave();
  try{await sHall(i);}catch(_){}return j;}
/* ---- saison hebdomadaire : semaine de Paris, compte a rebours, palmares, chapeau du gagnant ---- */
function pariz(){try{const g={};new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Paris',year:'numeric',month:'2-digit',day:'2-digit',weekday:'short',hour:'2-digit',minute:'2-digit',second:'2-digit',hourCycle:'h23'}).formatToParts(new Date()).forEach(function(x){g[x.type]=x.value;});
  g.wd=['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].indexOf(g.weekday);return g.wd<0?null:g;}catch(_){return null;}}
function wkNow(){const g=pariz();if(!g)return '';return new Date(Date.UTC(+g.year,+g.month-1,+g.day-g.wd)).toISOString().slice(0,10);}
function wkLeft(){const g=pariz();if(!g)return -1;return (7-g.wd)*86400-(+g.hour*3600+ +g.minute*60+ +g.second);}
function fmtLeft(){const t=wkLeft();if(t<0)return '?';const d=Math.floor(t/86400),h=Math.floor(t%86400/3600),m=Math.floor(t%3600/60);return d>0?d+' j '+h+' h':h>0?h+' h '+m+' min':m+' min';}
function sUid(){try{return JSON.parse(atob(CLOUD.tok.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))).sub||'';}catch(_){return '';}}
function crownSet(b){b=!!b;if(!!LK.crown===b)return;LK.crown=b;if(STARTED){try{applyLook(lookOpts(),PNAME);}catch(_){}}}
async function sHall(slot){try{if(!cOn()||!CLOUD.tok||!(await cFresh()))return;const r=await cReq('GET','/rest/v1/edm_hall?select=season,user_id,slot,name,actions,salary&order=season.desc&limit=6',null,CLOUD.tok);
  if(!r.ok||!Array.isArray(r.j))return;SRV.hall=r.j;const w=r.j.find(function(h){return h.season===SEASON.n-1;}),me=sUid(),mine=!!(w&&me&&w.user_id===me&&w.slot===(slot===undefined?PLAY_CH:slot));
  crownSet(mine);if(mine&&!SRV.crownMsg){SRV.crownMsg=1;setTimeout(function(){try{toast('👑 Tu es l\'Employé de la semaine ! Chapeau doré jusqu\'à lundi.');}catch(_){}},4000);}
  try{if(PAN==='rank')renderPan();}catch(_){}}catch(_){}}
function sNewWeek(){if(SRV.nw)return;SRV.nw=1;SRV.claimed=0;SRV.crownMsg=0;const ch=PLAY_CH,on=LK.online;
  sRegister(ch).then(function(j){if(!j){SRV.nw=0;SRV.wkTry=(SRV.wkTry||0)+1;return;}
    try{toast('🗓 Nouvelle saison '+SEASON.n+' ! Tirage au sort de ton poste…');}catch(_){}
    if(DRAWN)setTimeout(function(){try{saveGame();}catch(_){}accPlay(ch,on,accChars()[ch].rl||'e');},2600);else SRV.nw=0;});}
async function sClaim(){const j=await sRpc('edm_claim_bonus',{});if(j&&j.season){coins+=60;let gift='';try{const P=ITEMS.filter(function(i){return i.t==='b'&&!i.passive&&!i.pc&&!(INV[i.id]>0)&&itemReq(i)<=1;});if(P.length){const it=P[(Math.random()*P.length)|0];INV[it.id]=(INV[it.id]||0)+1;gift=', '+it.ic+' '+it.n;renderQI();}}catch(_){}
  try{const c=accChars()[PLAY_CH];if(c&&c.hb!==SEASON.n){c.hb=SEASON.n;accSave();if(lives<4)lives=4;}}catch(_){}
  pop('👑 Tu as gagné la saison '+j.season+' !','good');toast('🏆 Récompense du gagnant : couronne, +60 pièces'+gift+' et un 4e cœur pour toute la saison.',1);return true;}return false;}
function sBeatTick(force){try{if(!STARTED||(document.hidden&&force!==true)||PLAY_CH<0||!ACC||ACC.guest)return;if(SRV.on&&SEASON.wk&&wkNow()&&wkNow()!==SEASON.wk&&(SRV.wkTry||0)<5){sNewWeek();return;}if(!SRV.on){if(!SRV.tryReg){SRV.tryReg=1;sRegister(PLAY_CH).then(function(){SRV.tryReg=0;SRV.lastC=coins;});}return;}{const c=accChars()[PLAY_CH];if(c&&c.rl&&(c.rl!==SRV.role||!!c.pm!==!!SRV.pm)){SRV.role=c.rl;SRV.pm=!!c.pm;SRV.rlT=Date.now();sRpc('edm_set_role',{p_slot:PLAY_CH,p_role:c.rl,p_promoted:!!c.pm});}}if(!SRV.claimed){SRV.claimed=1;sClaim();}if(!SRV.lastC)SRV.lastC=coins;
  if(rank>=1&&!VIGI){const d=RESULT-SRV.lastR;if(d>0)SRV.act+=d/4;}SRV.lastR=RESULT;
  const dc=Math.max(0,coins-SRV.lastC);SRV.lastC=coins;const act=Math.min(5,Math.floor(SRV.act));SRV.act-=act;
  sRpc('edm_beat',{p_slot:PLAY_CH,p_rep:rank>=1?COMP:100,p_actions:act,p_salary:Math.min(50,Math.round(dc)),p_ps:proMine(),p_sl:PRO.sl,p_lv:Math.max(LVL,LVM),p_sb:Math.round(SB),p_npc:npcBars()}).then(sBeatRes);sMgrs();}catch(_){}}
async function sBoard(){const j=await sRpc('edm_board',{});if(Array.isArray(j)){SRV.board=j;SRV.bt=Date.now();try{if(PAN==='rank')renderPan();}catch(_){}}}
setInterval(function(){sBeatTick();},30000);try{document.addEventListener('visibilitychange',function(){sBeatTick(true);});window.addEventListener('pagehide',function(){sBeatTick(true);});}catch(_){}
function cSess(j){CLOUD.tok=j.access_token;CLOUD.rt=j.refresh_token||CLOUD.rt;CLOUD.exp=Date.now()+((j.expires_in||3600)-90)*1000;try{localStorage.setItem('edm_cloud',JSON.stringify({rt:CLOUD.rt}));}catch(_){}}
function cErr(r){const c=String((r.j&&(r.j.error_code||r.j.code||r.j.error))||''),m=String((r.j&&(r.j.msg||r.j.message||r.j.error_description))||'');
  if(r.net||r.st===0)return {s:'net'};if(/already|exists/i.test(c+m))return {s:'exists'};if(/not_confirmed|not confirmed/i.test(c+m))return {s:'confirm'};
  if(/weak_password|at least/i.test(c+m))return {s:'weak',m:'Mot de passe trop faible : 6 caractères minimum.'};if(/rate|too_many|limit/i.test(c+m)||r.st===429)return {s:'rate',m:'Trop d\'essais : attends quelques minutes puis réessaie.'};
  if(/invalid|credentials/i.test(c+m)||r.st===400)return {s:'bad'};return {s:'err',m:'Erreur du serveur ('+r.st+').'};}
async function cSignup(email,pw){if(!cOn())return {s:'net'};const r=await cReq('POST','/auth/v1/signup',{email:email,password:pw});
  if(r.ok&&r.j.access_token){cSess(r.j);return {s:'ok'};}
  if(r.ok&&r.j&&(r.j.id||r.j.user)){const u=r.j.user||r.j;if(u.identities&&u.identities.length===0)return {s:'exists'};return {s:'confirm'};}
  return cErr(r);}
async function cLogin(email,pw){if(!cOn())return {s:'net'};const r=await cReq('POST','/auth/v1/token?grant_type=password',{email:email,password:pw});
  if(r.ok&&r.j.access_token){cSess(r.j);return {s:'ok'};}return cErr(r);}
async function cFresh(){if(!CLOUD.tok&&!CLOUD.rt)return false;if(CLOUD.tok&&Date.now()<CLOUD.exp)return true;if(!CLOUD.rt)return false;
  const r=await cReq('POST','/auth/v1/token?grant_type=refresh_token',{refresh_token:CLOUD.rt});if(r.ok&&r.j.access_token){cSess(r.j);return true;}if(!r.net){CLOUD.tok=null;CLOUD.rt=null;try{localStorage.removeItem('edm_cloud');}catch(_){}}return false;}
function cBlob(){if(!ACC||!ACCD[ACC.id])return null;const em=ACC.id,ls={};try{for(let i=0;i<localStorage.length;i++){const k=localStorage.key(i);if(/^edm_/.test(k)&&k.indexOf(':'+em+':')>0&&k.indexOf('edm_ghost')!==0)ls[k]=localStorage.getItem(k);}}catch(_){}
  return {v:1,ch:ACCD[ACC.id].ch||[],ls:ls};}
async function cPush(force){try{if(!cOn()||!ACC||!ACCD[ACC.id]||!ACCD[ACC.id].cloud||CLOUD.busy)return false;const b=cBlob();if(!b)return false;const str=JSON.stringify(b);if(!force&&str===CLOUD.last)return true;
  CLOUD.busy=1;try{if(!(await cFresh()))return false;b.ts=Date.now();const r=await cReq('PUT','/auth/v1/user',{data:{edm:b}},CLOUD.tok);if(r.ok){CLOUD.last=str;ACCD[ACC.id].ts=b.ts;accSave();return true;}return false;}finally{CLOUD.busy=0;}}catch(_){CLOUD.busy=0;return false;}}
async function cApply(email){try{const r=await cReq('GET','/auth/v1/user',null,CLOUD.tok);const bl=r.ok&&r.j&&r.j.user_metadata&&r.j.user_metadata.edm,loc=ACCD[email];
  if(bl&&Array.isArray(bl.ch)&&(!loc||!(loc.ch||[]).length||(bl.ts||0)>=(loc.ts||0))){ACCD[email]={s:'',h:'',fn:'',ln:'',age:0,ch:bl.ch.slice(0,12),cloud:1,ts:bl.ts||0};
    try{Object.keys(bl.ls||{}).forEach(function(k){if(/^edm_/.test(k)&&k.indexOf(':'+email+':')>0&&typeof bl.ls[k]==='string')localStorage.setItem(k,bl.ls[k]);});}catch(_){}}
  else ACCD[email]=Object.assign({s:'',h:'',fn:'',ln:'',age:0,ch:[]},loc||{},{cloud:1});
  accSave();CLOUD.last='';}catch(_){ACCD[email]=Object.assign({s:'',h:'',fn:'',ln:'',age:0,ch:[]},ACCD[email]||{},{cloud:1});accSave();}}
async function cMigrate(email,pw){try{const r=await cSignup(email,pw);if(r.s==='ok'){ACCD[email].cloud=1;accSave();cPush(true);}}catch(_){}}
async function cRestore(){try{const o=JSON.parse(localStorage.getItem('edm_cloud')||'null');if(o&&o.rt){CLOUD.rt=o.rt;if(await cFresh()&&ACC&&ACCD[ACC.id])ACCD[ACC.id].cloud=1;else if(!CLOUD.rt&&ACC&&ACC.id)cRelog(ACC.id);}else if(ACC&&ACC.id&&ACCD[ACC.id]&&ACCD[ACC.id].cloud&&!CLOUD.tok)cRelog(ACC.id);}catch(_){}}
function cRelog(em){setTimeout(function(){try{if(STARTED||(ACC&&ACC.id&&ACC.id!==em)||CLOUD.tok)return;ACC=null;accSession(null);CLOUD.tok=null;CLOUD.rt=null;CLOUD.exp=0;try{localStorage.removeItem('edm_cloud');}catch(_){}ACCMAIL=em||'';accShow('signup','Le jeu a changé de serveur de comptes : recrée ton compte avec le même e-mail, tes persos de ce téléphone seront gardés. (Déjà recréé sur un autre téléphone ? Appuie sur « Retour » et connecte-toi.)');}catch(_){}},60);}
function accLogout(){try{const em=ACC&&ACC.id||'';try{cPush(true);}catch(_){}ACC=null;accSession(null);CLOUD.tok=null;CLOUD.rt=null;CLOUD.exp=0;CLOUD.last='';try{localStorage.removeItem('edm_cloud');}catch(_){}ACCMAIL=em;accShow('login','Tu es déconnecté.');}catch(_){}}
setInterval(function(){cPush(false);},20000);
try{document.addEventListener('visibilitychange',function(){if(document.visibilityState==='hidden')cPush(false);});}catch(_){}
function adoptLocal(email){try{const L=ACCD.local;if(!L||!(L.ch||[]).length||email==='local'||(ACCD[email]&&(ACCD[email].ch||[]).length))return false;
  ACCD[email]=Object.assign(ACCD[email]||{s:'',h:'',fn:'',ln:'',age:0},{ch:L.ch.slice()});
  const ks=[];for(let i=0;i<localStorage.length;i++){const k=localStorage.key(i);if(/^edm_/.test(k)&&k.indexOf(':local:')>0)ks.push(k);}
  ks.forEach(function(k){localStorage.setItem(k.replace(':local:',':'+email+':'),localStorage.getItem(k));});accSave();return true;}catch(_){return false;}}
function accEnter(email){ACC={id:email};accSession(email);CONFR=-1;ACCMSG='';accShow('list');}
function accGuest(){accLoad();let em=null;try{em=localStorage.getItem(SESK);}catch(_){}if(!(em&&ACCD[em])){const k=Object.keys(ACCD).filter(function(x){return (ACCD[x].ch||[]).length;});em=k.length?k[0]:'local';}
  if(!ACCD[em]){ACCD[em]={s:'',h:'',fn:'',ln:'',age:0,ch:[]};const old=readJ('edm_look');if(old){ACCD[em].ch.push(LKF.reduce(function(o,k){if(old[k]!==undefined)o[k]=old[k];return o;},{}));['edm_save','edm_plan','edm_ghost'].forEach(function(k){try{const v=localStorage.getItem(k);if(v!==null){localStorage.setItem(k+':'+em+':0',v);localStorage.removeItem(k);}}catch(_){}});try{localStorage.removeItem('edm_look');}catch(_){}}accSave();}
  accEnter(em);}
async function accAuth(create){if(ACCBUSY)return;const g=function(id){return (($(id)||{}).value||'').toString();};
  const m=g('accMail'),pw=g('accPw'),email=m.trim().toLowerCase();ACCMAIL=m.trim();
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)){accShow(ACCST,'Adresse e-mail invalide.');return;}
  if(create){const pw2=g('accPw2');
    if(pw.length<6){accShow('signup','Mot de passe : 6 caractères minimum.');return;}
    if(pw!==pw2){accShow('signup','Les deux mots de passe sont différents.');return;}
    ACCBUSY=true;accShow('signup','Un instant…');
    const r=await cSignup(email,pw);ACCBUSY=false;
    if(r.s==='ok'){ACCD[email]=Object.assign({s:'',h:'',fn:'',ln:'',age:0,ch:[]},ACCD[email]||{},{cloud:1,ts:0});adoptLocal(email);accSave();accEnter(email);cPush(true);}
    else if(r.s==='confirm')accShow('login','Compte créé ! Clique sur le lien reçu par e-mail pour le confirmer, puis connecte-toi ici.');
    else if(r.s==='exists')accShow('signup','Ce compte existe déjà : clique sur Retour et connecte-toi.');
    else if(r.s==='net')accShow('signup','Serveur injoignable : vérifie ta connexion et réessaie.');
    else accShow('signup',r.m||'Impossible de créer le compte.');
    return;}
  if(!pw){accShow('login','Entre ton mot de passe.');return;}
  ACCBUSY=true;accShow('login','Un instant…');
  const r=await cLogin(email,pw);
  if(r.s==='ok'){await cApply(email);adoptLocal(email);ACCBUSY=false;accEnter(email);return;}
  if(r.s==='confirm'){ACCBUSY=false;accShow('login','E-mail pas encore confirmé : clique sur le lien reçu par e-mail.');return;}
  try{const u=ACCD[email];if(u&&u.h){const h=await pwHash(u.s,pw);if(h===u.h){ACCBUSY=false;accEnter(email);if(r.s==='bad')cMigrate(email,pw);return;}}}catch(_){}
  ACCBUSY=false;accShow('login',r.s==='net'?'Serveur injoignable : vérifie ta connexion et réessaie.':(r.m||'E-mail ou mot de passe incorrect.'));}
function accLoadChar(i){CUR_CH=i;lkSet(accChars()[i]);PLAN.length=0;(readJ(CK('edm_plan'))||[]).filter(function(k){return typeof k==='string';}).slice(0,3).forEach(function(k){PLAN.push(k);});GH=readJ(CK('edm_ghost'));}
function accPlay(i,online,cls){cls=cls||'e';if(STARTED){try{sessionStorage.setItem('edm_auto',JSON.stringify({ch:i,online:online,cls:cls,fresh:DRAWN?1:0}));location.reload();}catch(_){accShow('list','Recharge la page pour changer de perso.');}return;}
  accLoadChar(i);LK.online=online;CLS=cls;LK.role=cls;PLAY_CH=i;$('acc').hidden=true;launch();}
function accAuto(){try{accLoad();const em=localStorage.getItem(SESK);if(em&&ACCD[em]&&(ACCD[em].cloud||sessionStorage.getItem('edm_auto'))){ACC={id:em};cRestore();const au=JSON.parse(sessionStorage.getItem('edm_auto')||'null');sessionStorage.removeItem('edm_auto');
    if(au&&au.tolist){accShow('game','');return;}if(au&&au.qm&&accChars()[au.ch]){if(au.solo){qmLaunchGo(au.ch,null);return;}QN.autoSalle=au.salle||0;qmLaunch(au.ch);return;}if(au&&accChars()[au.ch]){if(au.fresh)DRAWN=au.cls||'e';accPlay(au.ch,au.online?1:0,au.cls||'e');return;}}}catch(_){}ACC=null;accShow('title');}
$('acc').addEventListener('click',function(e){const b=e.target.closest('button');if(!b||b.disabled)return;const a=b.dataset.a,i=+b.dataset.i;if(a!=='del')CONFD=-1;
  if(a==='play'){accShow('game','');}
  else if(a==='gplay'){qmSelSet(b.dataset.g);let em=null;try{accLoad();em=localStorage.getItem(SESK);}catch(_){}if(ACC&&ACC.id&&ACCD[ACC.id]){accShow('list','');return;}try{accLoad();em=localStorage.getItem(SESK);}catch(_){}if(em&&ACCD[em]&&ACCD[em].cloud){ACC={id:em};cRestore();accEnter(em);}else accShow('login','');}else if(a==='guest')accGuest();else if(a==='login')accAuth(false);else if(a==='create')accAuth(true);else if(a==='tosignup'){accShow('signup','');}else if(a==='tologin'){accShow('login','');}
  else if(a==='logout'){accShow('list');}
  else if(a==='solo'||a==='online'){CLSI=i;CLSON=a==='online'?1:0;const go=function(){accPlay(i,CLSON,accRoleOf(i));};if(!cOn()||!(CLOUD.tok||CLOUD.rt))go();else{let done=0;const fin=function(){if(!done){done=1;go();}};setTimeout(fin,4000);sRegister(i).then(fin,fin);}}
  else if(a==='gpick'){accShow('game','');}
  else if(a==='qmplay'){qmLaunch(i);}
  else if(a==='acclogout'){accLogout();}
  else if(a==='cls'){if(STARTED&&CLSI===PLAY_CH&&b.dataset.r===CLS){lkSet(accChars()[PLAY_CH]);LK.role=CLS;launch();}else accPlay(CLSI,CLSON,b.dataset.r);}
  else if(a==='clsback')accShow('list','');
  else if(a==='resume'){lkSet(accChars()[PLAY_CH]);LK.online=LK.online||0;launch();}
  else if(a==='edit'){accOpenCreator(i,false);}
  else if(a==='new'){accOpenCreator(accChars().length,true);}
  else if(a==='del'){if(CONFD===i){const nm=(accChars()[i]||{}).name||'Sans nom';accDelChar(i);CONFD=-1;CONFR=-1;ACCMSG='Personnage « '+nm+' » supprimé.';}else{CONFD=i;CONFR=-1;ACCMSG='Appuie encore pour confirmer : cela efface le personnage et ses parties.';}accRender();}
  else if(a==='reset'){if(CONFR===i){try{['','_m','_v'].forEach(function(x){localStorage.removeItem('edm_save:'+ACC.id+':'+i+x);});localStorage.removeItem('edm_lv:'+ACC.id+':'+i);localStorage.removeItem('edm_ghost:'+ACC.id+':'+i);}catch(_){}CONFR=-1;ACCMSG='Parties effacées : le perso repart de zéro dans les trois classes.';}else{CONFR=i;ACCMSG='';}accRender();}});
$('acc').addEventListener('keydown',function(e){if(e.key==='Enter'&&e.target&&/^acc(Mail|Pw|Pw2|Fn|Ln|Age)$/.test(e.target.id)){e.preventDefault();accAuth(ACCST==='signup');}});
$('acc').addEventListener('pointerdown',function(e){e.stopPropagation();});

function ghostReport(){if(!GH)return null;const mn=(Date.now()-GH.t)/60000;if(mn<1)return null;const plan=GH.plan||[],has=plan.length>0,days=Math.max(0,Math.floor(mn/1440)-(GH.leave?1:0)),pen=mn>(GH.leave?48:24)*60,loss=has?0:Math.min(Math.floor(coins),days),n=Math.max(1,Math.min(5,Math.round(mn/12)));
  const folly=['a fait la roue dans le rayon frais','a essayé de vendre des chariots aux clients','a fait une sieste dans le frigo','a dansé sur la musique du magasin','a renversé une pyramide de conserves','a piqué un paquet de chocolats','a dénoncé un collègue à la directrice','a mis du ketchup partout','a pris le micro pour une annonce bidon'];
  const work=plan.map(function(k){const t=TASKS.find(function(x){return x[0]===k;});return t?t[1].toLowerCase():k;});
  const ev=[];let caught=null;for(let i=0;i<n;i++){const wk=has&&Math.random()<.6,t=wk?'a fait : '+work[(Math.random()*work.length)|0]:folly[(Math.random()*folly.length)|0];ev.push(t);if(!caught&&Math.random()<(has?.08:.3))caught=t.replace(/^a /,'').replace(/^fait : /,'en train de ');}
  return {mins:Math.round(mn),days:days,pen:pen,loss:loss,events:ev,caught:caught};}
function startRole(r){mobClear();v117Reset();MOOD.t=0;salEnd();SAL.cam=false;SAL.camM.visible=false;SAL.projGone=0;PROJM.forEach(function(b){b.visible=true;});cafeGroupEnd();COF.next=clk+60;dropCup();if(MEET.on){MEET.on=false;MEETCH.forEach(function(c){c.visible=false;});EMP.forEach(function(e){e.g.visible=true;});}REV=null;PRI=null;PRT=3;resetRank();VIGI=false;SEC=false;ROLE=r;rdReset();if(r==='m'){rank=1;image=Math.max(image,50);unlockOffice();}else if(r==='v'){rank=0;SEC=true;}mgrReset();renderQI();}
function pvFrame(dt){if(pvChar)pvChar.rotation.y+=dt*.7;const w=canvas.clientWidth||innerWidth,h=canvas.clientHeight||innerHeight;pvCam.aspect=w/h;
  const por=w<h;pvCam.position.set(0,1.7,por?14.5:9.5);pvCam.lookAt(0,1.2,0);if(!por)pvCam.setViewOffset(w,h,w*.23,0,w,h);else pvCam.setViewOffset(w,h,0,h*.3,w,h);pvCam.updateProjectionMatrix();renderer.render(pvScene,pvCam);}
document.body.dataset.mode='create';$('creator').hidden=true;$('crTitle').hidden=true;
/* ===================== OPÉRATION RIDEAU DE FER : partie rapide (v2 provisoire) =====================
   Jeu separe qui partage uniquement la map d'Employe du Mois. Rien du mode classique n'est mis a jour
   pendant une partie rapide (pas de sauvegarde, pas de blames, pas de salaire). */
